tion\": \"unknown\" | \"low\" | \"medium\" | \"high\",\n  \"outcome\": \"allow\" | \"deny\",\n  \"rationale\": string\n}\n"},"history_mode":"paginated","subagent_history_start_ordinal":64,"multi_agent_version":"disabled","context_window":{"window_id":"019f760f-da3c-7be1-9b76-8a082794e5b2"},"git":{"commit_hash":"4f62d729adf7821f7da062db804c0fb8371773d8","branch":"main","repository_url":"https://github.com/matthieuhuguet/Memory.git"}}}
