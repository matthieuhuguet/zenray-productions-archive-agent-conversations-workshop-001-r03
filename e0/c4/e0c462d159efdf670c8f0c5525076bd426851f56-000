7, -1.0);\n      vec4 p = mix(vec4(color.bg, k.wz), vec4(color.gb, k.xy), step(color.b, color.g));\n      vec4 q = mix(vec4(p.xyw, color.r), vec4(color.r, p.yzx), step(p.x, color.r));\n      float d = q.x - min(q.w, q.y);\n      float e = 1.0e-10;\n      return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);\n    }\n\n    vec3 hsvToRgb(vec3 color) {\n      vec3 p = abs(fract(color.xxx + vec3(0.0, 0.6666666667, 0.3333333333)) * 6.0 - 3.0);\n      return color.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), color.y);\n    }\n\n    float hueDistance(float a, float b) {\n      float difference = abs(a - b);\n      return min(difference, 1.0 - difference);\n    }\n\n    vec3 applySelective(vec3 color) {\n      vec3 hsv = rgbToHsv(color);\n      float centers[6] = float[6](0.0, 0.1666667, 0.3333333, 0.5, 0.6666667, 0.8333333);\n      for (int index = 0; index < 6; index++) {\n        float weight = smoothstep(0.19, 0.0, hueDistance(hsv.x, centers[index])) * smoothstep(0.05, 0.25, hsv.y);\n        hsv.x = fract(hsv.x + u_selective[index].x * weight * 0.12 + 1.0);\n        hsv.y = clamp(hsv.y + u_selective[index].y * weight * 0.55, 0.0, 1.0);\n        hsv.z = clamp(hsv.z + u_selective[index].z * weight * 0.38, 0.0, 1.0);\n      }\n      return hsvToRgb(hsv);\n    }\n\n    vec3 adjustSaturation(vec3 color, float amount) {\n      float gray = luma(color);\n      return mix(vec3(gray), color, max(0.0, 1.0 + amount));\n    }\n\n    vec3 preset(vec3 color, int filterId) {\n      float gray = luma(color);\n      if (filterId == 1) return adjustSaturation((color - 0.5) * 1.08 + 0.5, 0.20);\n      if (filterId == 2) return adjustSaturation((color - 0.5) * 1.07 + 0.5 + vec3(0.035, 0.012, -0.025), 0.18);\n      if (filterId == 3) return adjustSaturation((color - 0.5) * 1.07 + 0.5 + vec3(-0.025, 0.005, 0.035), 0.18);\n      if (filterId == 4) return adjustSaturation((color - 0.5) * 1.22 + 0.5, -0.08);\n      if (filterId == 5) return adjustSaturation((color - 0.5) * 1.21 + 0.5 + vec3(0.045, 0.012, -0.035), -0.05);\n      if (filterId == 6) return adjustSaturation((color - 0.5) * 1.21 + 0.5 + vec3(-0.035, 0.004, 0.045), -0.05);\n      if (filterId == 7) return vec3(gray);\n      if (filterId == 8) return vec3(gray) * vec3(1.06, 1.02, 0.92) + vec3(0.015, 0.01, 0.0);\n      if (filterId == 9) {\n        float noir = smoothstep(0.18, 0.82, gray);\n        return vec3(noir);\n      }\n      return color;\n    }\n\n    void main() {\n      vec2 textureUv = vec2(v_uv.x, 1.0 - v_uv.y);\n      vec3 source = texture(u_image, textureUv).rgb;\n      vec3 color = source;\n\n      float inputBlack = u_levels.x;\n      float midtone = u_levels.y;\n      float inputWhite = max(inputBlack + 0.001, u_levels.z);\n      float outputBlack = u_levels.w;\n      color = clamp((color - inputBlack) / (inputWhite - inputBlack), 0.0, 1.0);\n      float gamma = exp2((0.5 - midtone) * 3.0);\n      color = pow(max(color, vec3(0.00001)), vec3(gamma));\n      color = mix(vec3(outputBlack), vec3(u_outputWhite), color);\n\n      color = applySelective(color);\n\n      float brilliance = u_lightA.x;\n      float exposure = u_lightA.y;\n      float highlights = u_lightA.z;\n      float shadows = u_lightA.w;\n      float brightness = u_lightB.x;\n      float contrast = u_lightB.y;\n      float blackPoint = u_lightB.z;\n      float luminosity = luma(color);\n\n      color *= exp2(exposure * 2.0);\n      color += brilliance * (0.25 - pow(luminosity - 0.5, 2.0)) * 0.55;\n      color += highlights * smoothstep(0.45, 1.0, luminosity) * 0.32;\n      color += shadows * (1.0 - smoothstep(0.0, 0.55, luminosity)) * 0.32;\n      color += brightness * 0.30;\n      color = (color - 0.5) * (1.0 + contrast * 0.90) + 0.5;\n      color -= blackPoint * (1.0 - smoothstep(0.0, 0.55, luminosity)) * 0.35;\n\n      color = adjustSaturation(color, u_saturation * 0.85);\n      vec3 hsv = rgbToHsv(clamp(color, 0.0, 1.0));\n      float vibranceMask = 1.0 - hsv.y;\n      hsv.y = clamp(hsv.y + u_