 \"\";\n      layerReadouts = [];\n      img.textLayers.forEach(function (layer, index) {\n        var block = document.createElement(\"div\");\n        block.className = \"layer-block\";\n\n        var head = document.createElement(\"div\");\n        head.className = \"layer-head\";\n        var idx = document.createElement(\"span\");\n        idx.className = \"idx\";\n        idx.textContent = \"T\" + (index + 1);\n        var title = document.createElement(\"span\");\n        title.textContent = \"Texte\";\n        var remove = document.createElement(\"button\");\n        remove.type = \"button\";\n        remove.textContent = \"Supprimer\";\n        remove.addEventListener(\"click\", function () {\n          img.textLayers.splice(index, 1);\n          buildLayerPanel();\n          refreshOverlay();\n        });\n        head.appendChild(idx); head.appendChild(title); head.appendChild(remove);\n        block.appendChild(head);\n\n        var textInput = document.createElement(\"input\");\n        textInput.type = \"text\";\n        textInput.placeholder = \"Texte à poser sur la photo…\";\n        textInput.value = layer.value;\n        textInput.addEventListener(\"input\", function () {\n          layer.value = textInput.value; refreshOverlay();\n        });\n        block.appendChild(textInput);\n\n        var row2 = document.createElement(\"div\");\n        row2.className = \"row2\";\n        var fontSelect = document.createElement(\"select\");\n        [\"serif\", \"sans\"].forEach(function (v) {\n          var o = document.createElement(\"option\"); o.value = v;\n          o.textContent = v === \"serif\" ? \"Serif\" : \"Sans\";\n          fontSelect.appendChild(o);\n        });\n        fontSelect.value = layer.font;\n        fontSelect.addEventListener(\"change\", function () {\n          layer.font = fontSelect.value; refreshOverlay();\n        });\n        var weightSelect = document.createElement(\"select\");\n        WEIGHTS.forEach(function (w) {\n     