 \"source\" ? \"source (sans recadrage)\" : key;\n    if (key === state.format) opt.selected = true;\n    fmtSelect.appendChild(opt);\n  });\n  function applyFormat() {\n    var fmt = FORMATS[state.format];\n    var out = outputSize();\n    document.getElementById(\"resLabel\").textContent = fmt\n      ? fmt.w + \"×\" + fmt.h + \" ×\" + fmt.factor + \" → sortie \" + out.w + \"×\" + out.h\n      : \"format d'origine conservé\";\n    var p = previewSize();\n    frame.style.setProperty(\"--img-ratio\", p.w + \" / \" + p.h);\n    // Une ancre laterale n'a de sens qu'en format horizontal.\n    order.forEach(function (id) {\n      layers[id].forEach(function (l) {\n        if (!isLandscape() && l.anchor.indexOf(\"-center\") === -1) l.anchor = clampAnchorToCenter(l.anchor);\n      });\n    });\n    buildLayerPanel();\n    scheduleRender();\n  }\n  fmtSelect.addEventListener(\"change\", function () {\n    state.format = fmtSelect.value;\n    applyFormat();\n  });\n\n  buildPhotoControls();\n  renderStrip();\n  select(order[0]);\n  applyFormat();\n})();\n</script>\n\n</body>\n</html>\n    var img = byId[selectedId];\n    return { w: Math.min(1400, img && img.w ? img.w : 1080),\n             h: img && img.w ? Math.round(Math.min(1400, img.w) * img.h / img.w) : 1350 };\n  }\n\n  // Facteur anti-coin-transparent : agrandit la couverture pour qu'une rotation\n  // ne laisse jamais voir le fond. Meme formule que le cook Python, a ne jamais\n  // faire diverger.\n  function safeScale(angleDeg, fw, fh) {\n    var rad = angleDeg * Math.PI / 180;\n    var ratio = Math.max(fh / fw, fw / fh);\n    return Math.abs(Math.cos(rad)) + ratio * Math.abs(Math.sin(rad));\n  }\n\n  // CADRAGE : la source est dessinee dans une toile 2D a la taille du format,\n  // avec zoom, position et rotation, et c'est CETTE toile qui devient la\n  // texture du module photo. Le cadrage n'est donc plus une etape separee, mais\n  // le premier maillon du meme pipeline : source -> crop 2D -> photo WebGL ->\n  //