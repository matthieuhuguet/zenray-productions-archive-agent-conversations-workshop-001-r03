erlay.anchor-v-middle { top: 50%; transform: translateY(-50%); }\n  .text-overlay.anchor-v-bottom { bottom: 6%; }\n  .text-overlay.anchor-h-left   { text-align: left; }\n  .text-overlay.anchor-h-center { text-align: center; }\n  .text-overlay.anchor-h-right  { text-align: right; }\n\n  .controls { padding: 12px 14px 14px; }\n  .slider-row { margin-bottom: 9px; }\n  .slider-row:last-of-type { margin-bottom: 12px; }\n  .slider-row .row-label {\n    display: flex; justify-content: space-between; margin-bottom: 3px;\n    font-size: 11px; color: var(--muted);\n  }\n  .slider-row .row-label b { color: var(--text); font-weight: 600; font-variant-numeric: tabular-nums; }\n  input[type=range] {\n    width: 100%; accent-color: var(--accent);\n  }\n\n  /* Crans de pourcentage et propagation au lot */\n  .control-extra { display: flex; align-items: center; gap: 4px; margin-top: 4px; }\n  .control-extra .step {\n    min-width: 22px; padding: 1px 5px; border-radius: 5px;\n    border: 1px solid rgba(255,255,255,.14); background: #2b2c2f;\n    color: var(--muted); font: 600 10px ui-monospace, monospace; cursor: pointer;\n  }\n  .control-extra .step.minor { min-width: 18px; padding: 0 4px; font-size: 8.5px; opacity: .62; }\n  .control-extra .step:hover { color: var(--text); border-color: rgba(255,255,255,.3); }\n  .apply-all {\n    margin-left: auto; padding: 2px 8px; border-radius: 5px;\n    border: 1px solid rgba(243,138,92,.45); background: transparent;\n    color: var(--accent); font: 600 9.5px inherit; cursor: pointer; white-space: nowrap;\n  }\n  .apply-all.done { background: var(--accent); color: #17140f; }\n  button.apply-everything {\n    width: 100%; min-height: 30px; margin-bottom: 10px;\n    border: 1px solid rgba(243,138,92,.5); border-radius: 8px;\n    background: transparent; color: var(--accent);\n    font: 600 11px inherit; cursor: pointer;\n  }\n  button.apply-everything.done { background: var(--accent); color: #17140f; }\n\n  /* Calques de texte, aucun par defaut,