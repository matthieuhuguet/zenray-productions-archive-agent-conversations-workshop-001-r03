position et rotation, et c'est CETTE toile qui devient la\n  // texture du module photo. Le cadrage n'est donc plus une etape separee, mais\n  // le premier maillon du meme pipeline : source -> crop 2D -> photo WebGL ->\n  // texte. Le cook Python rejoue exactement la meme chaine.\n  var cropCanvas = document.createElement(\"canvas\");\n  var cropCtx = cropCanvas.getContext(\"2d\");\n\n  function buildCrop() {\n    if (!source.naturalWidth) return null;\n    var p = previewSize();\n    cropCanvas.width = p.w; cropCanvas.height = p.h;\n    var nw = source.naturalWidth, nh = source.naturalHeight;\n    var c = crops[selectedId];\n    var s = Math.max(p.w / nw, p.h / nh);\n    var x0 = (nw - p.w / s) * (c.px / 100);\n    var y0 = (nh - p.h / s) * (c.py / 100);\n    var k = s * c.zoom * safeScale(c.rotate, p.w, p.h) * 1.002;\n    cropCtx.setTransform(1, 0, 0, 1, 0, 0);\n    cropCtx.clearRect(0, 0, p.w, p.h);\n    cropCtx.translate(p.w / 2, p.h / 2);\n    cropCtx.rotate(c.rotate * Math.PI / 180);\n    cropCtx.scale(k, k);\n    cropCtx.translate(-(x0 + p.w / (2 * s)), -(y0 + p.h / (2 * s)));\n    cropCtx.drawImage(source, 0, 0);\n    return cropCanvas;\n  }\n  function canvasWidth() { return outputSize().w; }\n\n  function isLandscape() { var s = outputSize(); return s.w > s.h; }\n\n  function clampAnchorToCenter(anchor) { return anchor.split(\"-\")[0] + \"-center\"; }\n\n  function paint() {\n    var cropped = buildCrop();\n    if (cropped) processor.setImage(cropped);   // recadre, puis retouche\n    processor.set(current());\n    renderTextLayers();\n    refreshTileFlags();\n  }\n\n  function scheduleRender() {\n    // Le rendu ne doit JAMAIS pouvoir se bloquer : c'est l'outil d'edition de\n    // Matthieu, un aperçu fige lui fait perdre tout controle. Or\n    // requestAnimationFrame ne tire pas toujours (onglet en arriere-plan,\n    // fenetre masquee, contexte sans compositeur). Sans filet, `framePending`\n    // restait vrai pour toujours apres un rAF qui n'a jamais