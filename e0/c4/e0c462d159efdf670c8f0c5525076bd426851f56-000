mplates/hda-heavy/index.html-1093-    settings[selectedId] = ZRPhotoAdjustments.defaults();\n/Users/zenray/.claude/skills/zenray-html-photoshop-pdf-hda/templates/hda-heavy/index.html-1094-    layers[selectedId] = [];\n","exit_code":0,"duration":{"secs":0,"nanos":5083},"formatted_output":"Warning: truncated output (original token count: 10793)\nTotal output lines: 788\n\n#!/usr/bin/env python3\n# 2026-09-01, cook zenray-html-hda mode HEAVY : _index.json + _params.json -> JPEG finaux dans out/\n#\n# PORTAGE FIDELE du shader WebGL de `zr-photo-adjustments.js` en numpy. Le meme\n# ordre d'operations, les memes constantes et les memes formules, sinon l'apercu\n# du navigateur et le fichier livre divergent, ce qui viderait de son sens le\n# reglage a l'oeil. Ordre du shader, a ne jamais reordonner :\n#   levels -> selective color -> light -> saturation -> vibrance\n#   -> black and white -> filtre -> vignette -> grain -> clamp\n#\n# Le texte suit la meme chaine que `crop-apply.py` : police Serif/Sans, sept\n# graisses reelles, taille en px avec auto-fit qui ne depasse JAMAIS le cadre,\n# ancre haut/milieu/bas x gauche/centre/droite, jusqu'a trois calques par image.\n#\n# Les images sont ecrites sous `NN.jpg`, NN etant la position zero-completee de\n# 01 a 99 dans l'ordre choisi par glisser-deposer. Finder les trie automatiquement.\nimport json\nimport math\nimport sys\nfrom pathlib import Path\n\nimport numpy as np\nfrom PIL import Image, ImageDraw, ImageFilter, ImageFont, ImageOps\n\nHERE = Path(__file__).resolve().parent\nSOURCE_DIR = HERE.parent\nOUT_DIR = HERE / \"out\"\n\nSERIF_FONT_FILES = {\n    300: \"/Users/zenray/Library/Fonts/AnthropicSerif-Light.ttf\",\n    400: \"/Users/zenray/Library/Fonts/AnthropicSerif-Regular.ttf\",\n    500: \"/Users/zenray/Library/Fonts/AnthropicSerif-Medium.ttf\",\n    600: \"/Users/zenray/Library/Fonts/AnthropicSerif-SemiBold.ttf\",\n    700: \"/Users/zenray/Library/Fonts/AnthropicSerif-Bold.ttf\",\n    800: \"/Users/zenray/Library/Fonts/AnthropicSerif-ExtraBold.ttf\",\n    900: \"/Users/zenray/Library/Fonts/AnthropicSerif-Black.ttf\",\n}\nSANS_FONT_FILE = \"/Users/zenray/Library/Fonts/InterVariable.ttf\"\nMIN_FONT_SIZE_PX = 6\n\nFILTERS = [\n    \"Original\", \"Vivid\", \"Vivid Warm\", \"Vivid Cool\", \"Dramatic\",\n    \"Dramatic Warm\", \"Dramatic Cool\", \"Mono\", \"Silvertone\", \"Noir\",\n]\nLUMA = np.array([0.2126, 0.7152, 0.0722], dtype=np.float32)\nSELECTIVE_CENTERS = [0.0, 0.1666667, 0.3333333, 0.5, 0.6666667, 0.8333333]\n\n\n# ---------------------------------------------------------------- helpers GLSL\n\ndef smoothstep(edge0, edge1, x):\n    \"\"\"Equivalent exact de smoothstep GLSL, y compris quand edge0 > edge1.\"\"\"\n    t = np.clip((x - edge0) / (edge1 - edge0), 0.0, 1.0)\n    return t * t * (3.0 - 2.0 * t)\n\n\ndef luma(color):\n    # Somme explicite plutot que `color @ LUMA` : sur macOS, le matmul BLAS leve\n    # des RuntimeWarning (divide by zero, overflow, invalid value) meme sur des\n    # donnees parfaitement finies, faux positif verifie le 2026-09-01. Les deux\n    # ecritures donnent le meme resultat au bit pres, celle-ci ne ment pas.\n    return color[..., 0] * LUMA[0] + color[..., 1] * LUMA[1] + color[..., 2] * LUMA[2]\n\n\ndef rgb_to_hsv(color):\n    r, g, b = color[..., 0], color[..., 1], color[..., 2]\n    maximum = np.max(color, axis=-1)\n    minimum = np.min(color, axis=-1)\n    delta = maximum - minimum\n    epsilon = 1.0e-10\n\n    hue = np.zeros_like(maximum)\n    mask = delta > epsilon\n    with np.errstate(invalid=\"ignore\", divide=\"ignore\"):\n        red_max = mask & (maximum == r)\n        green_max = mask & (maximum == g) & ~red_max\n        blue_max = mask & ~red_max & ~green_max\n        hue[red_max] = ((g - b)[red_max] / delta[red_max]) % 6.0\n        hue[green_max] = ((b - r)[green_max] / delta[green_max]) + 2.0\n        hue[blue_max] = ((r - g)[blue_max] / delta[blue_max]) + 4.0\n    hue = hue / 6.0\n    saturation = np.where(maximum > epsilon, delta / (maximum + epsilon), 0.0)\n    return np.stack([hue, saturation, maximum], axis=-1)\n\n\ndef hsv_to_rgb(color):\n    h, s, v = color[..., 0], color[..., 1], color[..., 2]\n    p = np.abs(((h[..., None] + np.array([0.0, 0.6666667, 0.3333333], dtype=np.float32)) % 1.0) * 6.0 - 3.0)\n    return (v[..., None] * (1.0 + s[..., None] * (np.clip(p - 1.0, 0.0, 1.0) - 1.0))).astype(np.float32)\n\n\ndef hue_distance(a, b):\n    difference = np.abs(a - b)\n    return np.minimum(difference, 1.0 - difference)\n\n\ndef adjust_saturation(color, amount):\n    gray = luma(color)[..., None]\n    factor = max(0.0, 1.0 + amount)\n    return gray + (color - gray) * factor\n\n\ndef apply_preset(color, filter_id):\n    gray = luma(color)[..., None]\n    if filter_id == 1:\n        return adjust_saturation((color - 0.5) * 1.08 + 0.5, 0.20)\n    if filter_id == 2:\n        return adjust_saturation((color - 0.5) * 1.07 + 0.5 + np.array([0.035, 0.012, -0.025], dtype=np.float32), 0.18)\n    if filter_id == 3:\n        return adjust_saturation((color - 0.5) * 1.07 + 0.5 + np.array([-0.025, 0.005, 0.035], dtype=np.float32), 0.18)\n    if filter_id == 4:\n        return adjust_saturation((color - 0.5) * 1.22 + 0.5, -0.08)\n    if filter_id == 5:\n        return adjust_saturation((color - 0.5) * 1.21 + 0.5 + np.array([0.045, 0.012, -0.035], dtype=np.float32), -0.05)\n    if filter_id == 6:\n        return adjust_saturation((color - 0.5) * 1.21 + 0.5 + np.array([-0.035, 0.004, 0.045], dtype=np.float32), -0.05)\n    if filter_id == 7:\n        return np.repeat(gray, 3, axis=-1)\n    if filter_id == 8:\n        return np.repeat(gray, 3, axis=-1) * np.array([1.06, 1.02, 0.92], dtype=np.float32) \\\n            + np.array([0.015, 0.01, 0.0], dtype=np.float32)\n    if filter_id == 9:\n        return np.repeat(smoothstep(0.18, 0.82, gray), 3, axis=-1)\n    return color\n\n\n# ------------------------------------------------------------- chaine photo\n\ndef apply_photo(image, photo):\n    \"\"\"Rejoue la chaine du shader sur un tableau HxWx3 en float32 (0..1).\"\"\"\n    if photo is None:\n        return image\n\n    def pct(key, default=0.0):\n        return float(photo.get(key, default)) / 100.0\n\n    levels = photo.get(\"levels\") or {}\n    color = image\n\n    # 1. Levels\n    input_black = float(levels.get(\"inputBlack\", 0)) / 100.0\n    midtone = float(levels.get(\"midtone\", 50)) / 100.0\n    input_white = max(input_black + 0.001, float(levels.get(\"inputWhite\", 100)) / 100.0)\n    output_black = float(levels.get(\"outputBlack\", 0)) / 100.0\n    output_white = float(levels.get(\"outputWhite\", 100)) / 100.0\n    color = np.clip((color - input_black) / (input_white - input_black), 0.0, 1.0)\n    gamma = 2.0 ** ((0.5 - midtone) * 3.0)\n    color = np.power(np.maximum(color, 1e-5), gamma)\n    color = output_black + (output_white - output_black) * color\n\n    # 2. Selective Color\n    selective = photo.get(\"selective\") or []\n    if any(any(float(channel.get(k, 0)) for k in (\"hue\", \"saturation\", \"luminance\")) for channel in selective):\n        hsv = rgb_to_hsv(color)\n        for index, center in enumerate(SELECTIVE_CENTERS):\n            channel = selective[index] if index < len(selective) else {}\n            hue_amount = float(channel.get(\"hue\", 0)) / 100.0\n            sat_amount = float(channel.get(\"saturation\", 0)) / 100.0\n            lum_amount = float(channel.get(\"luminance\", 0)) / 100.0\n            if not (hue_amount or sat_amount or lum_amount):\n                continue\n            weight = smoothstep(0.19, 0.0, hue_distance(hsv[..., 0], center)) \\\n                * smoothstep(0.05, 0.25, hsv[..., 1])\n            hsv[..., 0] = (hsv[..., 0] + hue_amount * weight * 0.12 + 1.0) % 1.0\n            hsv[..., 1] = np.clip(hsv[..., 1] + sat_amount * weight * 0.55, 0.0, 1.0)\n            hsv[..., 2] = np.clip(hsv[..., 2] + lum_amount * weight * 0.38, 0.0, 1.0)\n        color = hsv_to_rgb(hsv)\n\n    # 3. Light. `luminosity` est mesuree UNE fois, avant les operations, comme\n    #    dans le shader : la recalculer entre deux etapes changerait le rendu.\n    brilliance = pct(\"brilliance\")\n    exposure = pct(\"exposure\")\n    highlights = pct(\"highlights\")\n    shadows = pct(\"shadows\")\n    brightness = pct(\"brightness\")\n    contrast = pct(\"contrast\")\n    black_point = pct(\"blackPoint\")\n    luminosity = luma(color)[..., None]\n\n    color = color * (2.0 ** (exposure * 2.0))\n    color = color + brilliance * (0.25 - np.power(luminosity - 0.5, 2.0)) * 0.55\n    color = color + highlights * smoothstep(0.45, 1.0, luminosity) * 0.32\n    color = color + shadows * (1.0 - smoothstep(0.0, 0.55, luminosity)) * 0.32\n    color = color + brightness * 0.30\n    color = (color - 0.5) * (1.0 + contrast * 0.90) + 0.5\n    color = color - black_point * (1.0 - smoothstep(0.0, 0.55, luminosity)) * 0.35\n\n    # 4. Saturation, puis Vibrance\n    color = adjust_saturation(color, pct(\"saturation\") * 0.85)\n    vibrance = pct(\"vibrance\")\n    if vibrance:\n        hsv = rgb_to_hsv(np.clip(color, 0.0, 1.0))\n        hsv[..., 1] = np.clip(hsv[..., 1] + vibrance * (1.0 - hsv[..., 1]) * 0.75, 0.0, 1.0)\n        color = hsv_to_rgb(hsv)\n\n    # 5. Black and White\n    black_and_white = pct(\"blackAndWhite\")\n    if black_and_white:\n        gray = np.repeat(luma(color)[..., None], 3, axis=-1)\n        color = color + (gray - color) * black_and_white\n\n    # 6. Filtre\n    filter_name = photo.get(\"filter\", \"Original\")\n    if filter_name not in FILTERS:\n        raise SystemExit(f\"filtre inconnu : {filter_name}\")\n    filter_id = FILTERS.index(filter_name)\n    filter_strength = float(photo.get(\"filterStrength\", 100)) / 100.0\n    if filter_id and filter_strength:\n        color = color + (apply_preset(color, filter_id) - color) * filter_strength\n\n    # 7. Vignette, en coordonnees normalisees du cadre\n    vignette = pct(\"vignette\")\n    if vignette:\n        height, width = color.shape[0], color.shape[1]\n        ys = (np.arange(height, dtype=np.float32) + 0.5) / height\n        xs = (np.arange(width, dtype=np.float32) + 0.5) / width\n        radius = np.sqrt((xs[None, :] - 0.5) ** 2 + (ys[:, None] - 0.5) ** 2) / 0.70710678\n        color = color * (1.0 - (smoothstep(0.34, 1.0, radius) * vignette * 0.78))[..., None]\n\n    # 8. Grain deterministe, dans le meme repere normalise que le shader.\n    grain = pct(\"grain\")\n    if grain:\n        height, width = color.shape[0], color.shape[1]\n        ys = (np.arange(height, dtype=np.float32) + 0.5) / height\n        xs = (np.arange(width, dtype=np.float32) + 0.5) / width\n        cells = np.floor(xs[None, :] * 4096.0) * 127.1 + np.floor(ys[:, None] * 4096.0) * 311.7\n        noise = np.mod(np.sin(cells) * 43758.5453123, 1.0)\n        color = color + ((noise - 0.5) * grain * 0.16)[..., None]\n\n    return np.clip(color, 0.0, 1.0)\n\n\n# ---------------------------------------------------------------- texte\n\ndef affine_coeffs(nw, nh, canvas_w, canvas_h, px, py, zoom, angle_deg):\n    \"\"\"Coefficients (a,b,c,d,e,f) pour Image.transform(AFFINE) : pour chaque\n    pixel de sortie (bx,by), le pixel source lu est (a*bx+b*by+c, d*bx+e*by+f).\n    Derive directement de la meme chaine que le CSS : object-fit:cover +\n    object-position(px,py) puis transform: scale(zoom*safescale) rotate(angle)\n    autour du centre. `safescale` regonfle la couverture pour qu'aucune\n    rotation ne laisse un coin transparent (meme formule que le JS du picker,\n    a ne jamais faire diverger) :\n        safescale = |cos angle| + max(H/W, W/H) * |sin angle|\n    Angle positif = sens CSS (horaire), coherent avec `rotate(Xdeg)`.\n    \"\"\"\n    s = max(canvas_w / nw, canvas_h / nh)\n    x0 = (nw - canvas_w / s) * (px / 100)\n    y0 = (nh - canvas_h / s) * (py / 100)\n\n    ratio = max(canvas_h / canvas_w, canvas_w / canvas_h)\n    theta = math.radians(angle_deg)\n    safescale = abs(math.cos(theta)) + ratio * abs(math.sin(theta))\n    safescale *= 1.002  # marge anti-arrondi\n\n    z = zoom * safescale\n    cx, cy = canvas_w / 2, canvas_h / 2\n    cos_t, sin_t = math.cos(theta), math.sin(theta)\n\n    a = cos_t / (z * s)\n    b = sin_t / (z * s)\n    c = x0 + cx / s - (cos_t * cx + sin_t * cy) / (z * s)\n    d = -sin_t / (z * s)\n    e = cos_t / (z * s)\n    f = y0 + cy / s + (sin_t * cx - cos_t * cy) / (z * s)\n    return (a, b, c, d, e, f)\n\n\ndef load_font(font_key, weight, size):\n    size = max(1, round(size))\n    if font_key == \"sans\":\n        font = ImageFont.truetype(SANS_FONT_FILE, size)\n        try:\n            font.set_variation_by_axes([weight])\n        except Exception:\n            pass\n        return font\n    nearest = min(SERIF_FONT_FILES, key=lambda w: abs(w - weight))\n    return ImageFont.truetype(SERIF_FONT_FILES[nearest], size)\n\n\ndef position_for(bbox, h_anchor, v_anchor, canvas_w, canvas_h, margin_x, margin_y):\n    text_w, text_h = bbox[2] - bbox[0], bbox[3] - bbox[1]\n    if h_anchor == \"left\":\n        x = margin_x - bbox[0]\n    elif h_anchor == \"right\":\n        x = canvas_w - margin_x - text_w - bbox[0]\n    else:\n        x = (canvas_w - text_w) / 2 - bbox[0]\n    if v_anchor == \"top\":\n        y = margin_y - bbox[1]\n    elif v_anchor == \"middle\":\n        y = (canvas_h - text_h) / 2 - bbox[1]\n    else:\n        y = canvas_h - margin_y - text_h - bbox[1]\n    return x, y\n\n\ndef draw_caption(canvas, cfg, canvas_w, canvas_h):\n    value = (cfg.get(\"value\") or \"\").strip()\n    if not value:\n        return canvas\n    font_key = cfg.get(\"font\", \"serif\")\n    weight = int(cfg.get(\"weight\", 400))\n    color = cfg.get(\"color\", \"#f6cf47\")\n    v_anchor, h_anchor = (cfg.get(\"anchor\") or \"bottom-center\").split(\"-\")\n    margin_x, margin_y = canvas_w * 0.06, canvas_h * 0.06\n    max_width = canvas_w * 0.88\n\n    # La taille venue du navigateur est un point de depart : on refait l'ajustement\n    # cote Python, dont les metriques different legerement, pour garantir que le\n    # texte ne sorte JAMAIS du cadre dans le fichier livre.\n    font_size = round(cfg.get(\"size_px\") or cfg.get(\"requested_size_px\") or 200)\n    probe = ImageDraw.Draw(canvas)\n\n    def fits(bbox):\n        if (bbox[2] - bbox[0]) > max_width:\n            return False\n        x, y = position_for(bbox, h_anchor, v_anchor, canvas_w, canvas_h, margin_x, margin_y)\n        return (x + bbox[0] >= 0 and y + bbox[1] >= 0\n                and x + bbox[2] <= canvas_w and y + bbox[3] <= canvas_h)\n\n    font = load_font(font_key, weight, font_size)\n    bbox = probe.textbbox((0, 0), value, font=font)\n    while not fits(bbox) and font_size > MIN_FONT_SIZE_PX:\n        font_size -= 2\n        font = load_font(font_key, weight, font_size)\n        bbox = probe.textbbox((0, 0), value, font=font)\n\n    x, y = position_for(bbox, h_anchor, v_anchor, canvas_w, canvas_h, margin_x, margin_y)\n\n    canvas = canvas.convert(\"RGBA\")\n    shadow = Image.new(\"RGBA\", canvas.size, (0, 0, 0, 0))\n    ImageDraw.Draw(shadow).text((x, y), value, font=font, fill=(0, 0, 0, 200))\n    shadow = shadow.filter(ImageFilter.GaussianBlur(canvas_w * 0.004))\n    canvas = Image.alpha_composite(canvas, shadow)\n    ImageDraw.Draw(canvas).text((x, y), value, font=font, fill=color)\n    return canvas.convert(\"RGB\")\n\n\n# ---------------------------------------------------------------- cook\n<!doctype html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"utf-8\">\n<title>zenray-html-hda heavy</title>\n<link rel=\"stylesheet\" href=\"assets/photo-controls/zr-photo-adjustments.css\">\n<style>\n  /* Sept graisses reelles AnthropicSerif, une seule famille CSS : le navigateur\n     choisit le fichier via font-weight. InterVariable couvre nativement 100-900. */\n  @font-face { font-family: AnthropicSerif; font-weight: 300; src: url(\"file:///Users/zenray/Library/Fonts/AnthropicSerif-Light.ttf\"); }\n  @font-face { font-family: AnthropicSerif; font-w