 = adjusted\n        ? (\"affiché \" + layer.effectiveSizePx + \"px (ajusté pour tenir dans le cadre)\")\n        : \"\";\n      entry.node.classList.toggle(\"adjusted\", adjusted);\n    });\n  }\n\n  function buildLayerPanel() {\n    layerList.innerHTML = \"\";\n    layerReadouts = [];\n    currentLayers().forEach(function (layer, index) {\n      var block = document.createElement(\"div\");\n      block.className = \"layer-block\";\n<!doctype html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"utf-8\">\n<title>zenray-html-hda</title>\n<style>\n  /* Sept graisses reelles AnthropicSerif (memes fichiers statiques que le\n     trio typographique global), une seule famille CSS : le navigateur\n     choisit le fichier via font-weight. */\n  @font-face { font-family: 'AnthropicSerif'; font-weight: 300; src: url('file:///Users/zenray/Library/Fonts/AnthropicSerif-Light.ttf') format('truetype'); }\n  @font-face { font-family: 'AnthropicSerif'; font-weight: 400; src: url('file:///Users/zenray/Library/Fonts/AnthropicSerif-Regular.ttf') format('truetype'); }\n  @font-face { font-family: 'AnthropicSerif'; font-weight: 500; src: url('file:///Users/zenray/Library/Fonts/AnthropicSerif-Medium.ttf') format('truetype'); }\n  @font-face { font-family: 'AnthropicSerif'; font-weight: 600; src: url('file:///Users/zenray/Library/Fonts/AnthropicSerif-SemiBold.ttf') format('truetype'); }\n  @font-face { font-family: 'AnthropicSerif'; font-weight: 700; src: url('file:///Users/zenray/Library/Fonts/AnthropicSerif-Bold.ttf') format('truetype'); }\n  @font-face { font-family: 'AnthropicSerif'; font-weight: 800; src: url('file:///Users/zenray/Library/Fonts/AnthropicSerif-ExtraBold.ttf') format('truetype'); }\n  @font-face { font-family: 'AnthropicSerif'; font-weight: 900; src: url('file:///Users/zenray/Library/Fonts/AnthropicSerif-Black.ttf') format('truetype'); }\n  /* InterVariable couvre nativement tout l'axe wght 100-900, une seule face. */\n  @font-face { font-family: 'InterLocal'; font-weight