eElement(\"div\");\n      extra.className = \"control-extra\";\n      STEP_MARKS.forEach(function (percent) {\n        var mark = document.createElement(\"button\");\n        mark.type = \"button\";\n        mark.className = \"step\" + (percent === 25 || percent === 75 ? \" minor\" : \"\");\n        mark.textContent = percent;\n        mark.title = percent + \" % de la plage\";\n        mark.addEventListener(\"click\", function () { commit(steppedValue(min, max, percent)); });\n        extra.appendChild(mark);\n      });\n      var toAll = document.createElement(\"button\");\n      toAll.type = \"button\";\n      toAll.className = \"apply-all\";\n      toAll.textContent = \"à toutes\";\n      toAll.title = \"Appliquer CE réglage à toutes les photos, maintenant. Les images restent indépendantes ensuite.\";\n      toAll.addEventListener(\"click\", function () {\n        applyKeyToAll(key, parseFloat(input.value));\n        flash(toAll);\n      });\n      extra.appendChild(toAll);\n      row.appendChild(extra);\n\n      registerControl(key, commit);\n      return row;\n    }\n\n    controls.appendChild(sliderRow(\"zoom\", \"Zoom\", 1, 3, 0.01, img.zoom, 2, function (v) {\n      img.zoom = v; el.style.setProperty(\"--zoom\", v);\n    }));\n    controls.appendChild(sliderRow(\"px\", \"Position X\", 0, 100, 1, img.px, 0, function (v) {\n      img.px = v; el.style.setProperty(\"--px\", v + \"%\");\n    }));\n    controls.appendChild(sliderRow(\"py\", \"Position Y\", 0, 100, 1, img.py, 0, function (v) {\n      img.py = v; el.style.setProperty(\"--py\", v + \"%\");\n    }));\n    controls.appendChild(sliderRow(\"rotate\", \"Rotation °\", -45, 45, 0.5, img.rotate, 1, function (v) {\n      img.rotate = v;\n      el.style.setProperty(\"--angle\", v + \"deg\");\n      el.style.setProperty(\"--safescale\", safeScale(v, FORMATS[state.format].w, FORMATS[state.format].h));\n    }));\n\n    // Copie INTEGRALE de cette carte vers toutes les autres : cadrage et\n    // calques de texte