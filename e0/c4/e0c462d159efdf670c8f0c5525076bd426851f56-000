/Users/zenray/Library/Fonts/InterVariable.ttf\"\nMIN_FONT_SIZE_PX = 6\n\n\ndef affine_coeffs(nw, nh, canvas_w, canvas_h, px, py, zoom, angle_deg):\n    \"\"\"Coefficients (a,b,c,d,e,f) pour Image.transform(AFFINE) : pour chaque\n    pixel de sortie (bx,by), le pixel source lu est (a*bx+b*by+c, d*bx+e*by+f).\n    Derive directement de la meme chaine que le CSS : object-fit:cover +\n    object-position(px,py) puis transform: scale(zoom*safescale) rotate(angle)\n    autour du centre. `safescale` regonfle la couverture pour qu'aucune\n    rotation ne laisse un coin transparent (meme formule que le JS du picker,\n    a ne jamais faire diverger) :\n        safescale = |cos angle| + max(H/W, W/H) * |sin angle|\n    Angle positif = sens CSS (horaire), coherent avec `rotate(Xdeg)`.\n    \"\"\"\n    s = max(canvas_w / nw, canvas_h / nh)\n    x0 = (nw - canvas_w / s) * (px / 100)\n    y0 = (nh - canvas_h / s) * (py / 100)\n\n    ratio = max(canvas_h / canvas_w, canvas_w / canvas_h)\n    theta = math.radians(angle_deg)\n    safescale = abs(math.cos(theta)) + ratio * abs(math.sin(theta))\n    safescale *= 1.002  # marge anti-arrondi\n\n    z = zoom * safescale\n    cx, cy = canvas_w / 2, canvas_h / 2\n    cos_t, sin_t = math.cos(theta), math.sin(theta)\n\n    a = cos_t / (z * s)\n    b = sin_t / (z * s)\n    c = x0 + cx / s - (cos_t * cx + sin_t * cy) / (z * s)\n    d = -sin_t / (z * s)\n    e = cos_t / (z * s)\n    f = y0 + cy / s + (sin_t * cx - cos_t * cy) / (z * s)\n    return (a, b, c, d, e, f)\n\n\ndef load_font(font_key, weight, size):\n    size = max(1, round(size))\n    if font_key == \"sans\":\n        font = ImageFont.truetype(SANS_FONT_FILE, size)\n        try:\n            font.set_variation_by_axes([weight])  # InterVariable, axe wght natif\n        except Exception:\n            pass\n        return font\n    nearest = min(SERIF_FONT_FILES, key=lambda w: abs(w - weight))\n    return ImageFont.truetype(SERIF_FONT_FILES[nearest], size)\n\n\ndef position_for(bbox, h_anchor, v_anchor, canvas_w, canvas_h, margin_x, margin_y):\n    \"\"\"Coin haut-gauche (x,y) du texte pour dessiner `bbox` a l'ancre donnee.\n    Meme convention que le CSS (text-align + top/middle/bottom + marge 6%).\"\"\"\n    text_w, text_h = bbox[2] - bbox[0], bbox[3] - bbox[1]\n    if h_anchor == \"left\":\n        x = margin_x - bbox[0]\n    elif h_anchor == \"right\":\n        x = canvas_w - margin_x - text_w - bbox[0]\n    else:\n        x = (canvas_w - text_w) / 2 - bbox[0]\n    if v_anchor == \"top\":\n        y = margin_y - bbox[1]\n    elif v_anchor == \"middle\":\n        y = (canvas_h - text_h) / 2 - bbox[1]\n    else:\n        y = canvas_h - margin_y - text_h - bbox[1]\n    return x, y\n\n\ndef draw_captions(canvas, text_cfgs, canvas_w, canvas_h):\n    \"\"\"Dessine 0 a N calques de texte, dans l'ordre donne (T1 puis T2 puis T3).\n    Accepte aussi l'ancien format mono-calque (un dict au lieu d'une liste).\"\"\"\n    if not text_cfgs:\n        return canvas\n    if isinstance(text_cfgs, dict):\n        text_cfgs = [text_cfgs]\n    for text_cfg in text_cfgs:\n        canvas = draw_caption(canvas, text_cfg, canvas_w, canvas_h)\n    return canvas\n\n\ndef draw_caption(canvas, text_cfg, canvas_w, canvas_h):\n    if not text_cfg or not text_cfg.get(\"value\", \"\").strip():\n        return canvas\n    if \"enabled\" in text_cfg and not text_cfg.get(\"enabled\"):\n        return canvas\n    value = text_cfg[\"value\"].strip()\n    font_key = text_cfg.get(\"font\", \"serif\")\n    weight = int(text_cfg.get(\"weight\", 400))\n    color = text_cfg.get(\"color\", \"#f6cf47\")\n    v_anchor, h_anchor = (text_cfg.get(\"anchor\") or \"bottom-center\").split(\"-\")\n    margin_x, margin_y = canvas_w * 0.06, canvas_h * 0.06\n    max_width = canvas_w * 0.88\n\n    # Auto-fit : jamais l'inverse. Part de la taille demandee (px, dans\n    # l'espace du canevas de sortie, meme convention que le curseur JS) et la\n    # retrecit tant que la boite de texte deborde la largeur padee OU les\n    # bords memes du cadre (0..canvas_w, 0..canvas_h). La police ne sort\n    # jamais du cadre pour \"cropper\" le texte, elle s'adapte a la taille\n    # maximale qui tient.\n    font_size = round(text_cfg.get(\"size_px\", 200))\n    probe = ImageDraw.Draw(canvas)\n\n    def fits(bbox):\n        text_w = bbox[2] - bbox[0]\n        if text_w > max_width:\n            return False\n        x, y = position_for(bbox, h_anchor, v_anchor, canvas_w, canvas_h, margin_x, margin_y)\n        left, top = x + bbox[0], y + bbox[1]\n        right, bottom = x + bbox[2], y + bbox[3]\n        return left >= 0 and top >= 0 and right <= canvas_w and bottom <= canvas_h\n\n    font = load_font(font_key, weight, font_size)\n    bbox = probe.textbbox((0, 0), value, font=font)\n    while not fits(bbox) and font_size > MIN_FONT_SIZE_PX:\n        font_size -= 2\n        font = load_font(font_key, weight, font_size)\n        bbox = probe.textbbox((0, 0), value, font=font)\n\n    x, y = position_for(bbox, h_anchor, v_anchor, canvas_w, canvas_h, margin_x, margin_y)\n\n    canvas = canvas.convert(\"RGBA\")\n    shadow = Image.new(\"RGBA\", canvas.size, (0, 0, 0, 0))\n    ImageDraw.Draw(shadow).text((x, y), value, font=font, fill=(0, 0, 0, 200))\n    shadow = shadow.filter(ImageFilter.GaussianBlur(canvas_w * 0.004))\n    canvas = Image.alpha_composite(canvas, shadow)\n    ImageDraw.Draw(canvas).text((x, y), value, font=font, fill=color)\n    return canvas.convert(\"RGB\")\n\n\ndef main():\n    index = json.loads((HERE / \"_index.json\").read_text())\n    params = json.loads((HERE / \"_crop_params.json\").read_text())\n    by_id = {img[\"id\"]: img for img in index[\"images\"]}\n\n    fmt = params[\"format\"]\n    canvas_w = fmt[\"w\"] * fmt[\"factor\"]\n    canvas_h = fmt[\"h\"] * fmt[\"factor\"]\n\n    OUT_DIR.mkdir(exist_ok=True)\n    written = []\n    for p in params[\"images\"]:\n        entry = by_id.get(p[\"id\"])\n        if entry is None:\n            raise SystemExit(f\"id {p['id']} absent de _index.json\")\n        src_path = Path(entry[\"path\"])\n        if not src_path.exists():\n            src_path = SOURCE_DIR / entry[\"file\"]\n        assert src_path.exists(), f\"source introuvable : {src_path}\"\n\n        im = Image.open(src_path)\n        im = ImageOps.exif_transpose(im)  # aligne sur ce qu'affiche un navigateur (EXIF)\n        im = im.convert(\"RGB\")\n        nw, nh = im.size\n\n        coeffs = affine_coeffs(nw, nh, canvas_w, canvas_h, p[\"x\"], p[\"y\"], p[\"zoom\"], p.get(\"rotate\", 0))\n        out = im.transform((canvas_w, canvas_h), Image.AFFINE, data=coeffs, resample=Image.BICUBIC)\n        out = draw_captions(out, p.get(\"text\"), canvas_w, canvas_h)\n\n        out_path = OUT_DIR / f'{p[\"id\"]}-{Path(entry[\"file\"]).stem}.jpg'\n        quality = 95\n        out.save(out_path, \"JPEG\", quality=quality, optimize=True)\n        size_mb = out_path.stat().st_size / 1_048_576\n        while size_mb > 8 and quality > 60:\n            quality -= 5\n            out.save(out_path, \"JPEG\", quality=quality, optimize=True)\n            size_mb = out_path.stat().st_size / 1_048_576\n\n        written.append(out_path)\n        print(f\"{out_path.name}: {out.size[0]}x{out.size[1]}  q{quality}  {size_mb:.2f} Mo\")\n\n    print(f\"\\n{len(written)} images ecrites dans {OUT_DIR}\")\n\n\nif __name__ == \"__main__\":\n    main()\n    for image in images:\n        with Image.open(image[\"path\"]) as raw:\n            preview = ImageOps.exif_transpose(raw).convert(\"RGB\")\n        if preview.width > max_width:\n            height = round(preview.height * max_width / preview.width)\n            preview = preview.resize((max_width, height), Image.LANCZOS)\n        buffer = BytesIO()\n        preview.save(buffer, \"JPEG\", quality=quality, optimize=True)\n        payload = b64encode(buffer.getvalue()).decode(\"ascii\")\n        total += len(payload)\n        entries.append(f'  \"{image[\"id\"]}\": \"data:image/jpeg;base64,{payload}\"')\n\n    body = \",\\n\".join(entries)\n    (dest / \"_previews.js\").write_text(\n        \"// Apercus embarques, generes par zr-hda-instance.py.\\n\"\n        \"// Une data URI est same-origin : WebGL l'accepte meme en file://, ce qu'il\\n\"\n        \"// refuse pour un fichier local. C'est ce qui rend l'instance autonome.\\n\"\n        \"// Le rendu FINAL n'utilise jamais ces apercus : le cook lit les originaux.\\n\"\n        f\"window.ZR_PREVIEWS = {{\\n{body}\\n}};\\n\"\n    )\n    return total\n\n\ndef collect_images(source_dir):\n    files = sorted(\n        (p for p in source_dir.iterdir()\n         if p.is_file() and p.suffix in IMAGE_SUFFIXES and not p.name.startswith(\".\")),\n        key=lambda p: p.name.lower(),\n    )\n    images = []\n    for position, path in enumerate(files, start=1):\n        width, height = measure(path)\n        images.append({\n            \"id\": f\"{position:02d}\",\n            \"file\": path.name,\n            \"path\": str(path),\n            \"width\": width,\n            \"height\": height,\n        })\n    return images\n\n\ndef render_template(mode, dest, project, source_dir, images, target_format):\n    template_dir = TEMPLATES / f\"hda-{mode}\"\n    if not template_dir.is_dir():\n        raise SystemExit(f\"gabarit introuvable : {template_dir}\")\n\n    dest.mkdir(parents=True, exist_ok=True)\n    for item in template_dir.iterdir():\n        target = dest / item.name\n        if item.is_dir():\n            shutil.copytree(item, target, dirs_exist_ok=True)\n        else:\n            shutil.copy2(item, target)\n\n    html_path = dest / \"index.html\"\n    html = html_path.read_text()\n\n    # Le JS porte l'id, le nom ET les dimensions REELLES de l'original : ce sont\n    # elles qui servent a l'auto-fit du texte et au choix du nombre d'ancres,\n    # jamais celles de l'apercu reduit, sans quoi une taille en px annoncee ne\n    # correspondrait pas au JPEG final.\n    light_images = [\n        {\"id\": i[\"id\"], \"file\": i[\"file\"], \"w\": i[\"width\"], \"h\": i[\"height\"]}\n        for i in images\n    ]\n    payload = json.dumps(light_images, indent=4, ensure_ascii=False)\n    payload = payload.replace(\"\\n\", \"\\n  \")\n\n    # Chemin RELATIF, jamais `file://` absolu. Deux raisons, la seconde est\n    # bloquante : un chemin relatif marche aussi bien en file:// qu'en http, et\n    # surtout WebGL REFUSE une texture issue d'une origine opaque, ce qu'est\n    # tout fichier ouvert en file://. Avec `file://`, le canvas du mode heavy\n    # restait vide alors que les vignettes s'affichaient (elles, ne passent pas\n    # par texImage2D). En relatif plus service local, tout est same-origin.\n    relative = os.path.relpath(source_dir, dest)\n    substitutions = {\n        \"__ZR_PROJECT__\": project,\n        \"__ZR_SOURCE_DIR__\": relative.rstrip(\"/\") + \"/\",\n        \"__ZR_IMAGES__\": payload,\n        \"__ZR_DEFAULT_FORMAT__\": target_format,\n    }\n    for key, value in substitutions.items():\n        html = html.replace(key, value)\n\n    leftover = sorted(set(re.findall(r\"__ZR_[A-Z_]+__\", html)))\n    if leftover:\n        raise SystemExit(f\"parametres non substitues : {leftover}\")\n    html_path.write_text(html)\n\n    (dest / \"_index.json\").write_text(json.dumps(\n        {\"dossier_source\": str(source_dir), \"images\": images}, indent=2, ensure_ascii=False) + \"\\n\")\n\n    # Le mode heavy lit des pixels (WebGL), donc il lui faut des apercus\n    # same-origin pour fonctionner en file://. Le light n'affiche que des\n    # `<img>`, qui n'ont pas cette restriction : inutile de l'alourdir.\n    if mode == \"heavy\":\n        weight = build_previews(images, dest)\n        if weight:\n            print(f\"apercus embarques : {weight / 1_048_576:.1f} Mo en data URI, \"\n                  f\"l'instance fonctionne sans serveur\")\n    return html_path\n\n\ndef register(dest, mode, project, count, source_dir):\n    INSTANCES_INDEX.parent.mkdir(parents=True, exist_ok=True)\n    if not INSTANCES_INDEX.exists():\n        INSTANCES_INDEX.write_text(\n            \"# Instances zenray-html-hda\\n\\n\"\n            \"Registre append-only des outils crees depuis `templates/`. Une ligne par\\n\"\n            \"instance : la relire coute quelques dizaines de tokens, la recreer a la main\\n\"\n            \"en coutait plus de trente mille.\\n\\n\"\n            \"| Date | Mode | Projet | Images | Dossier |\\n\"\n            \"|---|---|---|---|---|\\n\"\n        )\n    stamp = datetime.now().strftime(\"%Y-%m-%d %H:%M\")\n    line = f\"| {stamp} | {mode} | {project} | {count} | `{dest}` |\\n\"\n    with INSTANCES_INDEX.open(\"a\") as handle:\n        handle.write(line)\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"Cree une instance d'outil zenray-html-hda.\")\n    parser.add_argument(\"source\", type=Path, help=\"dossier contenant les images\")\n    parser.add_argument(\"--mode\", choices=(\"light\", \"heavy\"), default=\"light\",\n                        help=\"light = cadrage et texte ; heavy = reorder, photo et texte\")\n    parser.add_argument(\"--project\", default=None, help=\"nom parlant (defaut : nom du dossier source)\")\n    parser.add_argument(\"--format\", dest=\"target_format\", default=\"4:5\", choices=sorted(FORMATS),\n                        help=\"format cible du mode light (defaut 4:5)\")\n    parser.add_argument(\"--dest\", type=Path, default=None, help=\"dossier de l'instance\")\n    parser.add_argument(\"--open\", action=\"store_true\", help=\"ouvrir dans Chrome une fois cree\")\n    parser.add_argument(\"--serve\", action=\"store_true\",\n                        help=\"forcer le service local (automatique en mode heavy, que WebGL impose)\")\n    parser.add_argument(\"--force\", action=\"store_true\", help=\"ecraser une instance existante\")\n    args = parser.parse_args()\n    args.format_given = any(a.startswith(\"--format\") for a in sys.argv[1:])\n\n    source_dir = args.source.expanduser().resolve()\n    if not source_dir.is_dir():\n        raise SystemExit(f\"dossier source introuvable : {source_dir}\")\n\n    project = args.project or source_dir.name\n    dest = (args.dest.expanduser().resolve() if args.dest\n            else source_dir / f\"zenray-html-hda-{project}\")\n    if args.mode == \"heavy\" and not args.dest:\n        dest = source_dir / f\"zenray-html-hda-{project}-heavy\"\n\n    if dest.exists() and not args.force:\n        raise SystemExit(f\"l'instance existe deja : {dest}\\nrelancer avec --force pour l'ecraser\")\n\n    images = collect_images(source_dir)\n    if not images:\n        raise SystemExit(f\"aucune image trouvee dans {source_dir}\")\n\n    # Le cadrage se met en route TOUT SEUL quand il est utile, et reste neutre\n    # sinon. Un lot deja passe par une etape de cadrage a toutes ses images au\n    # meme rapport : le recadrer une seconde fois n'aurait pas de sens, donc le\n    # format demarre sur « source ». Un lot brut, aux rapports melanges ou\n    # differents de la cible, demarre sur le format demande.\n    target_format = args.target_format\n    if args.mode == \"heavy\" and not args.format_given:\n        ratios = {round(i[\"width\"] / i[\"height\"], 4) for i in images if i[\"height\"]}\n        wanted = FORMAT_RATIOS.get(args.target_format)\n        already = len(ratios) == 1 and wanted and abs(ratios.pop() - wanted) < 0.01\n        target_format = \"source\" if already else args.target_format\n\n    html_path = render_template(args.mode, dest, project, source_dir, images, target_format)\n    register(dest, args.mode, project, len(images), dest)\n\n    print(f\"instance {args.mode} creee : {dest}\")\n    print(f\"{len(images)} images indexees, format {args.target_format}\")\n    for image in images[:3]:\n        print(f\"  {image['id']}  {image['file']}  {image['width']}x{image['height']}\")\n    if len(images) > 3:\n        print(f\"  ... et {len(images) - 3} autres\")\n    cook = \"photo-apply.py\" if args.mode == \"heavy\" else \"crop-apply.py\"\n    print(f\"\\nregler dans le navigateur, copier, coller dans \"\n          f\"{dest.name}/{'_params.json' if args.mode == 'heavy' else '_crop_params.json'}, \"\n          f\"puis : python3 {cook}\")\n\n    if args.open:\n        # Le mode heavy EXIGE http : WebGL refuse une texture file:// (origine\n        # opaque), le canvas resterait vide. Le mode light se contente de\n        # file://, mais http ne lui nuit pas et unifie la marche a suivre.\n        if args.mode == \"heavy\" or args.serve:\n            serve(dest, source_dir, html_path)\n        else:\n            subprocess.run([\"open\", \"-a\", \"Google Chrome\", str(html_path)], check=False)\n\n\ndef serve(dest, source_dir, html_path):\n---\nname: zenray-html-photoshop-pdf-hda\ndescription: >\n  Créer les visuels ZenRay dans un HTML à calques. La section design-sliders est\n  intégrée : ses curseurs de mise en page, d’image et de texte ne s’activent que\n  sur demande explicite de Matthieu. Utiliser pour un flyer, un post, une slide,\n  un carrousel, une vignette, une couverture, une story, une animation ou une\n  image de référence à recomposer, ou corriger un PDF avec audit de style et\n  vérification par rendu. Le mode Template Creator mesure une référence,\n  identifie ses calques et produit un gabarit JSON, Markdown et PNG réutilisable.\n  Chaque asset PNG reste séparé, numéroté,\n  déplaçable, redimensionnable et remplaçable sans refaire le visuel entier.\n  Les outils hda ne se regénèrent JAMAIS à la main : `scripts/zr-hda-instance.py`\n  instancie un gabarit de `templates/` en une commande et moins d'une seconde,\n  registre dans `instances/INDEX.md`.\n  Depuis le 2026-09-01 le mode heavy fait TOUT en un seul HTML et une seule\n  copie : cadrage, ordre, retouche photo et texte, le cadrage etant un groupe\n  de reglages parmi les autres et s'activant tout seul quand les images ne sont\n  pas deja au bon format.\n  L'outil `zenray-html-hda-<projet>/` choisit rapidement le cadrage d'une ou\n  plusieurs photos vers un format cible (4:5 par défaut) avec des curseurs\n  zoom/pan/rotation, jusqu'à trois calques de texte au bouton + (7 graisses\n  réelles, taille en px avec auto-fit qui ne dépasse jamais le cadre, ancre 3\n  ou 9 positions selon le format) et un id de photo toujours affiché. Son mode\n  heavy ajoute, dans le MÊME HTML, le reorder par glisser-déposer et le module\n  photo complet (vignette, selective color, levels, noir et blanc, saturation,\n  vibrance, lumière, filtres), son cook portant fidèlement le shader en numpy.\n  En lot, toujours demander avant de tout batcher dans un seul HTML.\n---\n\n# ZenRay HTML Photoshop PDF\n\nPhotoshop, mais le document est un fichier HTML et les calques sont des `<img>`.\n\nLe but n'est pas de dessiner joli du premier coup. Le but est de **garder la\nmain sur chaque morceau** pour itérer en secondes plutôt qu'en minutes, et de\npouvoir produire une identité de marque cohérente sur Instagram et ailleurs sans\nouvrir un seul logiciel.\n\n## Index de navigation\n\n- **AVANT DE FABRIQUER QUOI QUE CE SOIT** : lire « LE WORKFLOW COMPLET » puis\n  « RÈGLE D'ARGENT ». Un outil hda s'INSTANCIE depuis `templates/` en une\n  commande, il ne se réécrit jamais à la main. Un travail fait n'est jamais\n  perdu, il est la source du suivant.\n- **Lot de photos à traiter** : `scripts/zr-hda-instance.py <dossier> --open`\n  pour le cadrage, puis le même script en `--mode heavy` sur le `out/` obtenu.\n- **Section `design-sliders` intégrée** : l’annexe intégrale se trouve en fin de skill.\n- **Curseurs seulement sur demande** : voir « Règle d’activation explicite, 2026-08-27 ».\n- **Mode `Template Creator`** : lire `references/template-creator.md` en entier dès qu’une référence doit devenir un gabarit réutilisable.\n\n## La loi fondamentale : un visuel n'est jamais une image\n\nUn visuel est **un dossier d'assets** plus **un fichier HTML qui les assemble**.\n\n"}],"internal_chat_message_metadata