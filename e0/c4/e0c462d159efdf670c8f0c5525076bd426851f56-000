ard = 0;\n    var m = measureText(layer, size);\n    while (guard++ < 200 && size > MIN_SIZE_PX && (m.width > maxW || m.height > maxH)) {\n      size = Math.max(MIN_SIZE_PX, size - 2);\n      m = measureText(layer, size);\n    }\n    return Math.round(size);\n  }\n\n  function renderTextLayers() {\n    textLayersEl.innerHTML = \"\";\n    var cw = canvasWidth();\n    currentLayers().forEach(function (layer) {\n      var effective = fitSize(layer);\n      layer.effectiveSizePx = effective;\n      if (!layer.value.trim()) return;\n      var parts = layer.anchor.split(\"-\");\n      var el = document.createElement(\"div\");\n      el.className = \"text-layer font-\" + layer.font +\n        \" anchor-v-\" + parts[0] + \" anchor-h-\" + parts[1];\n      el.style.fontWeight = layer.weight;\n      el.style.color = layer.color;\n      el.style.fontSize = (effective / cw * 100) + \"cqw\";\n      el.textContent = layer.value;\n      textLayersEl.append(el);\n    });\n    refreshLayerReadouts();\n  }\n\n  // ---------- panneau photo ----------\n\n  var controlRegistry = [];\n\n  // Crans de pourcentage : 0, 25, 50, 75 et 100 pour cent de la PLAGE du\n  // parametre, pas une valeur absolue. Un reglage qui va de -100 a 100 donne\n  // donc -100, -50, 0, 50 et 100 : le cran du milieu est toujours le neutre,\n  // quel que soit le parametre, ce qui rend les crans lisibles d'une ligne a\n  // l'autre. Les crans 25 et 75 sont dessines plus petits que 0, 50 et 100,\n  // qui sont les trois reperes principaux.\n  var STEP_MARKS = [0, 25, 50, 75, 100];\n\n  function steppedValue(min, max, percent) {\n    return Number(min) + (Number(max) - Number(min)) * (percent / 100);\n  }\n---\nname: agent-continuity-prompt-stacking\ndescription: Préserve les tâches non terminées d'une session entre les prompts utilisateur. Utiliser pour chaque demande conséquente et toute tâche de code, y compris après une interruption ou un changement de sujet.\n---\n\n# Continuité des tâches\n\n**Un nouveau prompt change le focus, pas l'historique des obligations.**\n\n**Une tâche ne disparaît que par `DONE` ou `CANCEL`.**\n\n## État unique par session\n\nRésoudre le dossier depuis l'identifiant opaque fourni par l'hôte, jamais depuis le texte littéral\n`<CurrentSessionName>` ni depuis une date, un nom de projet ou une valeur aléatoire :\n\n- Claude Code : `/Users/zenray/.claude/$CLAUDE_SESSION_ID/agent-continuity-prompt-stacking.md`\n- Codex : `/Users/zenray/.codex/$CODEX_SESSION_ID/agent-continuity-prompt-stacking.md`\n\nLe dossier est global à l'hôte, hors de l'espace de travail et ne se versionne pas. Si l'identifiant standard manque,\nutiliser seulement l'identifiant de conversation exposé par l'hôte. Ne jamais créer de repli partagé.\n\nCréer automatiquement le dossier et le fichier s'ils n'existent pas. Ce fichier est le seul état de\ntâches : ne pas créer de dashboard, JSON, base de données, rapport, journal d'événements ou second\nfichier de suivi.\n\n```md\n# OPEN\n\n- [>] T1 Tâche actuelle\n- [ ] T0 Tâche interrompue\n\n# DONE\n\n- [x] T-1 Tâche vérifiée\n\n# CANCELED\n\n- [!] T-2 Tâche explicitement annulée\n```\n\n`[>]` signifie active, `[ ]` en attente, `[x]` terminée et `[!]` annulée. Les descriptions tiennent\nsur une ligne. Les tâches les plus récentes viennent en premier dans chaque section.\n\n## À chaque prompt\n\nPour chaque demande conséquente et toute tâche de code, avant le travail :\n\n1. Lire seulement `OPEN`.\n2. Classer l'intention : `CONTINUE`, `NEW` ou `CANCEL`.\n3. Mettre l'état à jour avant l'exécution.\n\n`CONTINUE` conserve l'unique tâche active et affine sa description si nécessaire. Une précision ou une\nsuite logique reste un `CONTINUE`.\n\n`NEW` commence par déplacer l'ancienne tâche active, si elle n'est pas finie, vers `OPEN` en attente,\npuis place la nouvelle tâche active en tête. Ne créer aucune tâche à partir d'un détail accessoire.\n\n`CANCEL` exige une annulation, un remplacement ou une obsolescence explicite de la part de l'utilisateur.\nDéplacer alors la tâche dans `CANCELED`, avec le motif sur la même ligne. Ne jamais l'appeler `DONE`.\n\nLorsque le résultat est réellement complet et vérifié, déplacer la tâche dans `DONE`. Une tentative,\nune tâche partielle, un blocage ou un résultat non vérifié reste dans `OPEN`.\n\nL'état est lossless, plutôt que littéralement append-only : aucune tâche n'est supprimée. Comme chaque\nsection doit garder les tâches les plus récentes en tête et refléter leur statut courant, une ligne peut\nchanger de section ou de marqueur. N'ajouter aucun historique parallèle pour simuler un append-only.\n\nUn seul élément peut être `[>]`. Toute tâche non terminée reste dans `OPEN`. Ne lire `DONE` ou `CANCELED`\nque lorsqu'un contexte historique précis est nécessaire. Le suivi reste silencieux et ne doit ni\ninterrompre ni alourdir la réponse réelle.\n"},"started_at_ms":1788283166243,"completed_at_ms":1788283166243}}
{"timestamp":"2026-09-01T17:19:26.247Z","ordinal":307,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a05dfb-9e27-7ad2-92c9-40786fc47bad","call_id":"call_hq3IGQtV5UcavT5aF82xVzoB","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"      <button class=\"primary\" id=\"outCopyBtn\">Copier</button>\n      <button class=\"ghost\" id=\"outCloseBtn\">Fermer</button>\n    </div>\n  </div>\n</div>\n\n<script src=\"_previews.js\"></script>\n<script src=\"assets/photo-controls/zr-photo-adjustments.js\"></script>\n<script>\n(function () {\n  \"use strict\";\n  // 2026-09-01, outil zenray-html-hda mode HEAVY du skill zenray-html-photoshop-pdf-hda.\n  // Un seul HTML : reorder par glisser-deposer DANS l'outil, module photo complet du\n  // skill (Vignette, Selective Color, Levels, Black and White, Color, Light, Filters),\n  // et jusqu'a trois calques de texte par image, ajoutes au bouton +.\n  // Chaque image garde ses propres reglages photo ET ses propres calques de texte.\n\n  /* @zr-instance:start */\n  // BLOC D'INSTANCE : ecrit par scripts/zr-hda-instance.py, jamais a la main.\n  // C'est le SEUL endroit du gabarit qui depend du projet ; tout le reste est\n  // identique d'une instance a l'autre, ce qui permet de creer un nouvel outil\n  // sans regenerer une ligne de HTML.\n  var PROJECT = \"__ZR_PROJECT__\";\n  var SOURCE_DIR = \"__ZR_SOURCE_DIR__\";\n  var IMAGES = __ZR_IMAGES__;\n  var DEFAULT_FORMAT_KEY = \"__ZR_DEFAULT_FORMAT__\";\n  /* @zr-instance:end */\n\n  // Loi de format et de resolution du skill : facteur = plus petit entier qui\n  // atteint 3840 px sur le grand cote, plafonne a quatre.\n  var FORMATS = {\n    \"4:5\":  { w: 1080, h: 1350, factor: 3 },\n    \"1:1\":  { w: 1080, h: 1080, factor: 4 },\n    \"9:16\": { w: 1080, h: 1920, factor: 2 },\n    \"16:9\": { w: 1920, h: 1080, factor: 2 },\n    \"1:2\":  { w: 1080, h: 2160, factor: 2 },\n    \"3:4\":  { w: 1080, h: 1440, factor: 3 },\n    \"2:3\":  { w: 1080, h: 1620, factor: 3 },\n    \"4:3\":  { w: 1440, h: 1080, factor: 3 },\n    \"source\": null\n  };\n\n  var MAX_LAYERS = 3;\n  var MIN_SIZE_PX = 6;\n  var DEFAULT_SIZE_PX = 200;\n  var WEIGHTS = [\n    [300, \"Light\"], [400, \"Regular\"], [500, \"Medium\"], [600, \"SemiBold\"],\n    [700, \"Bold\"], [800, \"ExtraBold\"], [900, \"Black\"]\n  ];\n  var ANCHORS = [\n    \"top-left\", \"top-center\", \"top-right\",\n    \"middle-left\", \"middle-center\", \"middle-right\",\n    \"bottom-left\", \"bottom-center\", \"bottom-right\"\n  ];\n  var DEFAULT_ANCHOR_BY_INDEX = [\"bottom-center\", \"top-center\", \"middle-center\"];\n\n  var byId = {};\n  IMAGES.forEach(function (img) { byId[img.id] = img; });\n\n  var order = IMAGES.map(function (i) { return i.id; });\n  var initialOrder = order.slice();\n\n  var settings = {};   // reglages photo par image\n  var layers = {};     // calques de texte par image, 0 a 3\n  var crops = {};      // cadrage par image : zoom, position, rotation\n  IMAGES.forEach(function (img) {\n    settings[img.id] = ZRPhotoAdjustments.defaults();\n    layers[img.id] = [];\n    crops[img.id] = { zoom: 1, px: 50, py: 50, rotate: 0 };\n  });\n  var state = { format: DEFAULT_FORMAT_KEY };\n\n  var selectedId = order[0];\n  var selectedChannel = 0;\n  var CHANNELS = [\"Rouge\", \"Jaune\", \"Vert\", \"Cyan\", \"Bleu\", \"Magenta\"];\n  var FILTERS = ZRPhotoAdjustments.filters();\n\n  var canvas = document.getElementById(\"photo\");\n  var frame = document.getElementById(\"frame\");\n  var textLayersEl = document.getElementById(\"text-layers\");\n  var source = document.getElementById(\"source\");\n  var strip = document.getElementById(\"strip\");\n  var status = document.getElementById(\"status\");\n  var currentLabel = document.getElementById(\"currentLabel\");\n  var layerList = document.getElementById(\"layer-list\");\n  var addLayerBtn = document.getElementById(\"addLayerBtn\");\n  var processor = new ZRPhotoAdjustments(canvas);\n  var framePending = false;\n\n  document.title = \"zenray-html-hda heavy · \" + PROJECT;\n  document.getElementById(\"projectLabel\").textContent = PROJECT;\n  document.getElementById(\"countLabel\").textContent = IMAGES.length + \" images\";\n\n  function current() { return settings[selectedId]; }\n  function currentLayers() { return layers[selectedId]; }\n\n  function newLayer(index) {\n    return {\n      value: \"\", font: \"serif\", weight: 400,\n      sizePx: DEFAULT_SIZE_PX, effectiveSizePx: DEFAULT_SIZE_PX,\n      color: \"#f6cf47\", anchor: DEFAULT_ANCHOR_BY_INDEX[index] || \"bottom-center\"\n    };\n  }\n\n  function isNeutralPhoto(values) {\n    return JSON.stringify(values) === JSON.stringify(ZRPhotoAdjustments.defaults());\n  }\n  function isNeutralCrop(c) {\n    return c.zoom === 1 && c.px === 50 && c.py === 50 && c.rotate === 0;\n  }\n  function hasEdits(id) {\n    return !isNeutralPhoto(settings[id]) || !isNeutralCrop(crops[id]) ||\n      layers[id].some(function (l) { return l.value.trim(); });\n  }\n\n  function srcUrl(file, id) {\n    // L'apercu embarque est une data URI : same-origin, donc WebGL l'accepte\n    // en file:// comme en http. Le chemin relatif ne sert que de repli, et il\n    // ne fonctionne alors qu'a travers un service local.\n    if (id && window.ZR_PREVIEWS && window.ZR_PREVIEWS[id]) return window.ZR_PREVIEWS[id];\n    return SOURCE_DIR + encodeURIComponent(file).replace(/%2F/g, \"/\");\n  }\n\n  // Dimensions du FICHIER FINAL, jamais celles de l'apercu reduit : une taille\n  // de texte annoncee en px doit valoir ces pixels-la sur le JPEG livre. Quand\n  // un format cible est choisi, c'est lui qui commande ; en mode « source », ce\n  // sont les dimensions de l'image d'origine.\n  function outputSize() {\n    var fmt = FORMATS[state.format];\n    if (fmt) return { w: fmt.w * fmt.factor, h: fmt.h * fmt.factor };\n    var img = byId[selectedId];\n    if (img && img.w && img.h) return { w: img.w, h: img.h };\n    return { w: canvas.width || 1080, h: canvas.height || 1350 };\n  }\n\n  // Taille de la toile d'APERCU : le format cible en unites de composition,\n  // suffisant a l'ecran, et sans rapport avec la resolution livree.\n  function previewSize() {\n    var fmt = FORMATS[state.format];\n    if (fmt) return { w: fmt.w, h: fmt.h };\n    var img = byId[selectedId];\n    return { w: Math.min(1400, img && img.w ? img.w : 1080),\n             h: img && img.w ? Math.round(Math.min(1400, img.w) * img.h / img.w) : 1350 };\n  }\n\n  // Facteur anti-coin-transparent : agrandit la couverture pour qu'une rotation\n  // ne laisse jamais voir le fond. Meme formule que le cook Python, a ne jamais\n  // faire diverger.\n  function safeScale(angleDeg, fw, fh) {\n    var rad = angleDeg * Math.PI / 180;\n    var ratio = Math.max(fh / fw, fw / fh);\n    return Math.abs(Math.cos(rad)) + ratio * Math.abs(Math.sin(rad));\n  }\n\n  // CADRAGE : la source est dessinee dans une toile 2D a la taille du format,\n  // avec zoom, position et rotation, et c'est CETTE toile qui devient la\n  // texture du module photo. Le cadrage n'est donc plus une etape separee, mais\n  // le premier maillon du meme pipeline : source -> crop 2D -> photo WebGL ->\n  // texte. Le cook Python rejoue exactement la meme chaine.\n  var cropCanvas = document.createElement(\"canvas\");\n  var cropCtx = cropCanvas.getContext(\"2d\");\n\n  function buildCrop() {\n    if (!source.naturalWidth) return null;\n    var p = previewSize();\n    cropCanvas.width = p.w; cropCanvas.height = p.h;\n    var nw = source.naturalWidth, nh = source.naturalHeight;\n    var c = crops[selectedId];\n    var s = Math.max(p.w / nw, p.h / nh);\n    var x0 = (nw - p.w / s) * (c.px / 100);\n    var y0 = (nh - p.h / s) * (c.py / 100);\n    var k = s * c.zoom * safeScale(c.rotate, p.w, p.h) * 1.002;\n    cropCtx.setTransform(1, 0, 0, 1, 0, 0);\n    cropCtx.clearRect(0, 0, p.w, p.h);\n    cropCtx.translate(p.w / 2, p.h / 2);\n    cropCtx.rotate(c.rotate * Math.PI / 180);\n    cropCtx.scale(k, k);\n    cropCtx.translate(-(x0 + p.w / (2 * s)), -(y0 + p.h / (2 * s)));\n    cropCtx.drawImage(source, 0, 0);\n    return cropCanvas;\n  }\n  function canvasWidth() { return outputSize().w; }\n\n  function isLandscape() { var s = outputSize(); return s.w > s.h; }\n\n  function clampAnchorToCenter(anchor) { return anchor.split(\"-\")[0] + \"-center\"; }\n\n  function paint() {\n    var cropped = buildCrop();\n    if (cropped) processor.setImage(cropped);   // recadre, puis retouche\n    processor.set(current());\n    renderTextLayers();\n    refreshTileFlags();\n  }\n\n  function scheduleRender() {\n    // Le rendu ne doit JAMAIS pouvoir se bloquer : c'est l'outil d'edition de\n    // Matthieu, un aperçu fige lui fait perdre tout controle. Or\n    // requestAnimationFrame ne tire pas toujours (onglet en arriere-plan,\n    // fenetre masquee, contexte sans compositeur). Sans filet, `framePending`\n    // restait vrai pour toujours apres un rAF qui n'a jamais tire, et PLUS\n    // AUCUN rendu n'avait lieu ensuite, curseurs comme texte.\n    // Le filet en setTimeout garantit le rendu ; `done` garde la coalescence,\n    // pour que le rAF et le repli ne peignent jamais deux fois.\n    if (framePending) return;\n    framePending = true;\n    var done = false;\n    var run = function () {\n      if (done) return;\n      done = true;\n      framePending = false;\n      paint();\n    };\n    requestAnimationFrame(run);\n    setTimeout(run, 60);\n  }\n\n  // ---------- mesure du texte, jamais la boite DOM etiree ----------\n  // Leçon deja payee cote picker light : mesurer le CONTENU (Canvas 2D), pas la\n  // boite `left:0;right:0` qui vaut toujours la largeur du cadre. Meme algorithme\n  // que ImageDraw.textbbox() cote Python.\n  var measureContext = document.createElement(\"canvas\").getContext(\"2d\");\n\n  function measureText(layer, fontSizePx) {\n    var family = layer.font === \"serif\"\n      ? '\"AnthropicSerif\", serif'\n      : '\"InterLocal\", sans-serif';\n    measureContext.font = layer.weight + \" \" + fontSizePx + \"px \" + family;\n    var metrics = measureContext.measureText(layer.value);\n    var width = metrics.actualBoundingBoxLeft !== undefined\n      ? metrics.actualBoundingBoxLeft + metrics.actualBoundingBoxRight\n      : metrics.width;\n    var height = (metrics.actualBoundingBoxAscent || fontSizePx * 0.8) +\n                 (metrics.actualBoundingBoxDescent || fontSizePx * 0.2);\n    return { width: width, height: height };\n  }\n\n  // Auto-fit : la taille demandee est un POINT DE DEPART, jamais une valeur\n  // imposee. On la reduit jusqu'a ce que le texte tienne entierement dans le\n  // cadre (88 % de large, 88 % de haut), et c'est cette valeur reelle qui part\n  // dans le presse-papier, jamais celle demandee.\n  function fitSize(layer) {\n    var out = outputSize();\n    var cw = out.w, ch = out.h;\n    var size = layer.sizePx;\n    var maxW = cw * 0.88;\n    var maxH = ch * 0.88;\n    var guard = 0;\n    var m = measureText(layer, size);\n    while (guard++ < 200 && size > MIN_SIZE_PX && (m.width > maxW || m.height > maxH)) {\n      size = Math.max(MIN_SIZE_PX, size - 2);\n      m = measureText(layer, size);\n    }\n    return Math.round(size);\n  }\n\n  function renderTextLayers() {\n    textLayersEl.innerHTML = \"\";\n    var cw = canvasWidth();\n    currentLayers().forEach(function (layer) {\n      var effective = fitSize(layer);\n      layer.effectiveSizePx = effective;\n      if (!layer.value.trim()) return;\n      var parts = layer.anchor.split(\"-\");\n      var el = document.createElement(\"div\");\n      el.className = \"text-layer font-\" + layer.font +\n        \" anchor-v-\" + parts[0] + \" anchor-h-\" + parts[1];\n      el.style.fontWeight = layer.weight;\n      el.style.color = layer.color;\n      el.style.fontSize = (effective / cw * 100) + \"cqw\";\n      el.textContent = layer.value;\n      textLayersEl.append(el);\n    });\n    refreshLayerReadouts();\n  }\n\n  // ---------- panneau photo ----------\n\n  var controlRegistry = [];\n\n  // Crans de pourcentage : 0, 25, 50, 75 et 100 pour cent de la PLAGE du\n  // parametre, pas une valeur absolue. Un reglage qui va de -100 a 100 donne\n  // donc -100, -50, 0, 50 et 100 : le cran du milieu est toujours le neutre,\n  // quel que soit le parametre, ce qui rend les crans lisibles d'une ligne a\n  // l'autre. Les crans 25 et 75 sont dessines plus petits que 0, 50 et 100,\n  // qui sont les trois reperes principaux.\n  var STEP_MARKS = [0, 25, 50, 75, 100];\n\n  function steppedValue(min, max, percent) {\n    return Number(min) + (Number(max) - Number(min)) * (percent / 100);\n  }\n\n  function slider(parent, label, path, min, max, value, step) {\n    var block = document.createElement(\"div\");\n    block.className = \"control-block\";\n\n    var row = document.createElement(\"label\");\n    row.className = \"zr-photo-control\";\n    var name = document.createElement(\"span\");\n    name.textContent = label;\n    var input = document.createElement(\"input\");\n    input.type = \"range\";\n    input.min = min; input.max = max; input.step = step || 1; input.value = value;\n    var output = document.createElement(\"output\");\n    output.value = Math.round(Number(value));\n\n    function commit(v) {\n      input.value = v;\n      output.value = Math.round(Number(v));\n      writePath(path, Number(v));\n      scheduleRender();\n    }\n\n    input.addEventListener(\"input\", function () { commit(Number(input.value)); });\n    row.append(name, input, output);\n    block.append(row);\n\n    var extra = document.createElement(\"div\");\n    extra.className = \"control-extra\";\n    STEP_MARKS.forEach(function (percent) {\n      var mark = document.createElement(\"button\");\n      mark.type = \"button\";\n      mark.className = \"step\" + (percent === 25 || percent === 75 ? \" minor\" : \"\");\n      mark.textContent = percent;\n      mark.title = percent + \" % de la plage\";\n      mark.addEventListener(\"click\", function () {\n        commit(steppedValue(min, max, percent));\n      });\n      extra.append(mark);\n    });\n\n    // Propagation PONCTUELLE : la valeur est recopiee dans toutes les images au\n    // moment du clic, et rien n'est lie ensuite. Chaque image reste modifiable\n    // seule, sans que les autres bougent.\n    var toAll = document.createElement(\"button\");\n    toAll.type = \"button\";\n    toAll.className = \"apply-all\";\n    toAll.textContent = \"à toutes\";\n    toAll.title = \"Appliquer CE réglage à toutes les photos, maintenant. Les images restent indépendantes ensuite.\";\n    toAll.addEventListener(\"click\", function () {\n      applyPathToAll(path, Number(input.value));\n      flash(toAll);\n    });\n    extra.append(toAll);\n\n    block.append(extra);\n    parent.append(block);\n    controlRegistry.push({ input: input, output: output, path: path });\n    return input;\n  }\n\n  function flash(button) {\n    button.classList.add(\"done\");\n    setTimeout(function () { button.classList.remove(\"done\"); }, 700);\n  }\n\n  // Ecrit une valeur au meme chemin dans TOUTES les images. Le chemin est\n  // resolu une fois (le canal Selective Color courant vaut pour tout le lot),\n  // puis chaque jeu de reglages recoit sa propre copie.\n  function applyPathToAll(path, value) {\n    order.forEach(function (id) { writePath(path, value, id); });\n    refreshTileFlags();\n  }\n\n  // Copie INTEGRALE des reglages de l'image courante vers toutes les autres,\n  // photo et calques de texte compris. Copie profonde, jamais une reference\n  // partagee : modifier une image ensuite ne doit toucher qu'elle.\n  function applyEverythingToAll() {\n    var photo = JSON.parse(JSON.stringify(settings[selectedId]));\n    var text = JSON.parse(JSON.stringify(layers[selectedId]));\n    var crop = JSON.parse(JSON.stringify(crops[selectedId]));\n    order.forEach(function (id) {\n      if (id === selectedId) return;\n      settings[id] = JSON.parse(JSON.stringify(photo));\n      layers[id] = JSON.parse(JSON.stringify(text));\n      crops[id] = JSON.parse(JSON.stringify(crop));\n    });\n    refreshTileFlags();\n  }\n\n  // `path` designe un chemin dans l'objet de reglages : \"saturation\",\n  // \"levels.midtone\", ou \"selective.ACTIVE.hue\" (ACTIVE = canal courant).\n  function resolvePath(path) {\n    return path.replace(\"ACTIVE\", String(selectedChannel)).split(\".\");\n  }\n  // Un chemin prefixe par `crop.` designe le CADRAGE, tout le reste designe les\n  // reglages photo. C'est ce routage qui permet au cadrage d'etre un groupe de\n  // reglages comme un autre, avec ses crans et sa propagation, sans dupliquer\n  // une ligne de code d'interface.\n  function rootFor(parts, id) {\n    return parts[0] === \"crop\" ? crops[id || selectedId] : settings[id || selectedId];\n  }\n  function writePath(path, value, id) {\n    var parts = resolvePath(path);\n    var node = rootFor(parts, id);\n    var start = parts[0] === \"crop\" ? 1 : 0;\n    for (var i = start; i < parts.length - 1; i++) node = node[parts[i]];\n    node[parts[parts.length - 1]] = value;\n  }\n  function readPath(path) {\n    var parts = resolvePath(path);\n    var node = rootFor(parts);\n    var start = parts[0] === \"crop\" ? 1 : 0;\n    for (var i = start; i < parts.length - 1; i++) node = node[parts[i]];\n    return node[parts[parts.length - 1]];\n  }\n\n  function syncPhotoControls() {\n    controlRegistry.forEach(function (control) {\n      var value = readPath(control.path);\n      control.input.value = value;\n      control.output.value = Math.round(Number(value));\n    });\n    document.querySelectorAll(\"#filter-buttons button\").forEach(function (button) {\n      button.setAttribute(\"aria-pressed\", button.dataset.filter === current().filter ? \"true\" : \"false\");\n    });\n  }\n\n  function buildPhotoControls() {\n    var crop = document.getElementById(\"crop-controls\");\n    slider(crop, \"Zoom\", \"crop.zoom\", 1, 3, 1, 0.01);\n    slider(crop, \"Position X\", \"crop.px\", 0, 100, 50);\n    slider(crop, \"Position Y\", \"crop.py\", 0, 100, 50);\n    slider(crop, \"Rotation °\", \"crop.rotate\", -45, 45, 0, 0.5);\n\n    slider(document.getElementById(\"vignette-controls\"), \"Strength\", \"vignette\", 0, 100, 0);\n    slider(document.getElementById(\"grain-controls\"), \"Strength\", \"grain\", 0, 100, 0);\n\n    var tabs = document.getElementById(\"selective-tabs\");\n    CHANNELS.forEach(function (name, index) {\n      var button = document.createElement(\"button\");\n        scheduleRender();\n      });\n      swatches.append(yellow, white);\n\n      var widget = document.createElement(\"div\");\n      widget.className = \"anchor-widget\";\n      widget.dataset.mode = isLandscape() ? \"9\" : \"3\";\n      var buttons = ANCHORS.map(function (anchor) {\n        var b = document.createElement(\"button\");\n        b.type = \"button\";\n        b.dataset.anchor = anchor;\n        b.title = anchor;\n        if (anchor === layer.anchor) b.classList.add(\"active\");\n        b.addEventListener(\"click\", function () {\n          layer.anchor = anchor;\n          buttons.forEach(function (other) {\n            other.classList.toggle(\"active\", other.dataset.anchor === anchor);\n          });\n          scheduleRender();\n        });\n        widget.append(b);\n        return b;\n      });\n      // Un format portrait ou carre n'expose que la colonne du centre : une ancre\n      // laterale devenue invalide est ramenee sur son equivalent centre.\n      if (!isLandscape() && layer.anchor.indexOf(\"-center\") === -1) {\n        layer.anchor = clampAnchorToCenter(layer.anchor);\n        buttons.forEach(function (b) {\n          b.classList.toggle(\"active\", b.dataset.anchor === layer.anchor);\n        });\n      }\n\n      bottom.append(swatches, widget);\n      block.append(bottom);\n      layerList.append(block);\n    });\n\n    addLayerBtn.disabled = currentLayers().length >= MAX_LAYERS;\n    addLayerBtn.textContent = currentLayers().length >= MAX_LAYERS\n      ? \"+ Ajouter un texte (3 maximum)\"\n      : \"+ Ajouter un texte\";\n    refreshLayerReadouts();\n  }\n\n  addLayerBtn.addEventListener(\"click\", function () {\n    if (currentLayers().length >= MAX_LAYERS) return;\n    currentLayers().push(newLayer(currentLayers().length));\n    buildLayerPanel();\n    scheduleRender();\n  });\n\n  // ---------- bande de vignettes, selection et reorder ----------\n\n  var dragSrcId = null;\n\n  function refreshTileFlags() {\n    strip.querySelectorAll(\".tile\").forEach(function (tile) {\n      tile.classList.toggle(\"has-edits\", hasEdits(tile.dataset.id));\n      tile.classList.toggle(\"selected\", tile.dataset.id === selectedId);\n    });\n  }\n\n  function renderStrip() {\n    strip.innerHTML = \"\";\n    order.forEach(function (id, index) {\n      var img = byId[id];\n      var tile = document.createElement(\"div\");\n      tile.className = \"tile\";\n      tile.draggable = true;\n      tile.dataset.id = id;\n\n      var thumb = document.createElement(\"div\");\n      thumb.className = \"thumb\";\n      var el = document.createElement(\"img\");\n      el.src = srcUrl(img.file, img.id);\n      el.alt = img.file;\n      thumb.append(el);\n\n      var meta = document.createElement(\"div\");\n      meta.className = \"meta\";\n      var pos = document.createElement(\"span\");\n      pos.className = \"pos\";\n      pos.textContent = String(index + 1).padStart(2, \"0\");\n      var nm = document.createElement(\"span\");\n      nm.className = \"nm\";\n      nm.textContent = img.file;\n      meta.append(pos, nm);\n\n      var dot = document.createElement(\"span\");\n      dot.className = \"edited\";\n\n      tile.append(thumb, meta, dot);\n\n      tile.addEventListener(\"click\", function () { select(id); });\n      tile.addEventListener(\"dragstart\", function () { dragSrcId = id; tile.classList.add(\"dragging\"); });\n      tile.addEventListener(\"dragend\", function () { tile.classList.remove(\"dragging\"); });\n      tile.addEventListener(\"dragover\", function (e) { e.preventDefault(); tile.classList.add(\"drop-target\"); });\n      tile.addEventListener(\"dragleave\", function () { tile.classList.remove(\"drop-target\"); });\n      tile.addEventListener(\"drop\", function (e) {\n        e.preventDefault();\n        tile.classList.remove(\"drop-target\");\n        if (!dragSrcId || dragSrcId === id) return;\n        var from = order.indexOf(dragSrcId);\n        var to = order.indexOf(id);\n        order.splice(from, 1);\n        order.splice(to, 0, dragSrcId);\n        dragSrcId = null;\n        renderStrip();\n        updateCurrentLabel();\n      });\n\n      strip.append(tile);\n    });\n    refreshTileFlags();\n  }\n\n  function updateCurrentLabel() {\n    var img = byId[selectedId];\n    currentLabel.innerHTML = \"position <b>\" + String(order.indexOf(selectedId) + 1).padStart(2, \"0\") +\n      \"</b> · id \" + selectedId + \" · \" + img.file;\n  }\n\n  function select(id) {\n    selectedId = id;\n    updateCurrentLabel();\n    source.src = srcUrl(byId[id].file, id);\n    refreshTileFlags();\n    syncPhotoControls();\n    buildLayerPanel();\n  }\n\n  source.addEventListener(\"load\", function () {\n    var cropped = buildCrop();\n    processor.setImage(cropped || source);\n    processor.set(current());\n    var p = previewSize();\n    frame.style.setProperty(\"--img-ratio\", p.w + \" / \" + p.h);\n    status.textContent = source.naturalWidth + \" × \" + source.naturalHeight + \" px\";\n    buildLayerPanel();\n    renderTextLayers();\n  });\n  source.addEventListener(\"error\", function () {\n    status.textContent = \"image introuvable : \" + source.src;\n  });\n\n  // ---------- actions ----------\n\n  document.getElementById(\"applyAllBtn\").addEventListener(\"click\", function () {\n    applyEverythingToAll();\n    flash(document.getElementById(\"applyAllBtn\"));\n  });\n\n  document.getElementById(\"resetImageBtn\").addEventListener(\"click\", function () {\n    settings[selectedId] = ZRPhotoAdjustments.defaults();\n    layers[selectedId] = [];\n    crops[selectedId] = { zoom: 1, px: 50, py: 50, rotate: 0 };\n    syncPhotoControls();\n    syncPhotoControls();\n    buildLayerPanel();\n    scheduleRender();\n  });\n\n  document.getElementById(\"resetOrderBtn\").addEventListener(\"click\", function () {\n    order = initialOrder.slice();\n    renderStrip();\n    updateCurrentLabel();\n  });\n\n  function payload() {\n    var images = {};\n    order.forEach(function (id, index) {\n      var img = byId[id];\n      images[id] = {\n        position: index + 1,\n        file: img.file,\n        output: String(index + 1).padStart(2, \"0\") + \".jpg\",\n        crop: crops[id],\n        photo: settings[id],\n        text: layers[id]\n          .filter(function (l) { return l.value.trim(); })\n          .map(function (l) {\n            return {\n              value: l.value.trim(), font: l.font, weight: l.weight,\n              size_px: l.effectiveSizePx, requested_size_px: l.sizePx,\n              color: l.color, anchor: l.anchor\n            };\n          })\n      };\n    });\n    var fmt = FORMATS[state.format];\n    return {\n      project: PROJECT,\n      format: fmt ? { key: state.format, w: fmt.w, h: fmt.h, factor: fmt.factor } : null,\n      order: order,\n      images: images\n    };\n  }\n\n  function copyText(text) {\n    var ta = document.createElement(\"textarea\");\n    ta.value = text;\n    ta.style.position = \"fixed\";\n    ta.style.opacity = \"0\";\n    document.body.appendChild(ta);\n    ta.select();\n    var ok = false;\n    try { ok = document.execCommand(\"copy\"); } catch (e) {}\n    ta.remove();\n    return ok;\n  }\n\n  function outputText() {\n    var data = payload();\n    var f = data.format;\n    var head = \"ZENRAY-HTML-HDA STUDIO · \" + PROJECT + \" · \" +\n      (f ? \"format \" + f.key + \"(\" + f.w + 