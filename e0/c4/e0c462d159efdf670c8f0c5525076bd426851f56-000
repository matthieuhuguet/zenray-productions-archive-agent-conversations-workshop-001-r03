idden; background: #000;\n    aspect-ratio: var(--fmt-ratio);\n    container-type: inline-size;\n  }\n  .crop-frame img {\n    position: absolute; inset: 0; width: 100%; height: 100%;\n    object-fit: cover;\n    object-position: var(--px, 50%) var(--py, 50%);\n    transform: scale(calc(var(--zoom, 1) * var(--safescale, 1))) rotate(var(--angle, 0deg));\n    transform-origin: center;\n    user-select: none; -webkit-user-drag: none;\n  }\n  .text-overlays { position: absolute; inset: 0; pointer-events: none; }\n  .text-overlay {\n    position: absolute; left: 0; right: 0;\n    padding: 0 6%;\n    pointer-events: none; display: none;\n    text-shadow: 0 2px 10px rgba(0,0,0,.55), 0 1px 3px rgba(0,0,0,.65);\n    line-height: 1.15; white-space: nowrap;\n  }\n  .text-overlay.shown { display: block; }\n  .text-overlay.font-serif { font-family: 'AnthropicSerif', 'Hiragino Mincho ProN W3', serif; }\n  .text-overlay.font-sans { font-family: 'InterLocal', 'Hiragino Sans W4', sans-serif; }\n  .text-overlay.anchor-v-top    { top: 6%; }\n  .text-overlay.anchor-v-middle { top: 50%; transform: translateY(-50%); }\n  .text-overlay.anchor-v-bottom { bottom: 6%; }\n  .text-overlay.anchor-h-left   { text-align: left; }\n  .text-overlay.anchor-h-center { text-align: center; }\n  .text-overlay.anchor-h-right  { text-align: right; }\n\n  .controls { padding: 12px 14px 14px; }\n  .slider-row { margin-bottom: 9px; }\n  .slider-row:last-of-type { margin-bottom: 12px; }\n  .slider-row .row-label {\n    display: flex; justify-content: space-between; margin-bottom: 3px;\n    font-size: 11px; color: var(--muted);\n  }\n  .slider-row .row-label b { color: var(--text); font-weight: 600; font-variant-numeric: tabular-nums; }\n  input[type=range] {\n    width: 100%; accent-color: var(--accent);\n  }\n\n  /* Crans de pourcentage et propagation au lot */\n  .control-extra { display: flex; align-items: center; gap: 4px; margin-top: 4px; }\n  .control-extra .step {\n    min-width: 22px; padding: 1px 5px;