getElementById(\"filter-controls\"), \"Strength\", \"filterStrength\", 0, 100, 100);\n  }\n\n  // ---------- calques de texte ----------\n\n  var layerReadouts = [];\n\n  function refreshLayerReadouts() {\n    layerReadouts.forEach(function (entry) {\n      var layer = currentLayers()[entry.index];\n      if (!layer) return;\n      var adjusted = layer.effectiveSizePx !== layer.sizePx;\n      entry.node.textContent = adjusted\n        ? (\"affiché \" + layer.effectiveSizePx + \"px (ajusté pour tenir dans le cadre)\")\n        : \"\";\n      entry.node.classList.toggle(\"adjusted\", adjusted);\n    });\n  }\n\n  function buildLayerPanel() {\n    layerList.innerHTML = \"\";\n    layerReadouts = [];\n    currentLayers().forEach(function (layer, index) {\n      var block = document.createElement(\"div\");\n      block.className = \"layer-block\";\n\n      var head = document.createElement(\"div\");\n      head.className = \"layer-head\";\n      var idx = document.createElement(\"span\");\n      idx.className = \"idx\";\n    setupTexture() {\n      const gl = this.gl;\n      gl.activeTexture(gl.TEXTURE0);\n      gl.bindTexture(gl.TEXTURE_2D, this.texture);\n      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);\n      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);\n      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.NEAREST);\n      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.NEAREST);\n      gl.pixelStorei(gl.UNPACK_COLORSPACE_CONVERSION_WEBGL, gl.NONE);\n      gl.pixelStorei(gl.UNPACK_PREMULTIPLY_ALPHA_WEBGL, false);\n      gl.uniform1i(this.location(\"u_image\"), 0);\n    }\n\n    location(name) {\n      if (!(name in this.locations)) {\n        const location = this.gl.getUniformLocation(this.program, name);\n        if (location === null) throw new Error(`Uniforme photo introuvable : ${name}`);\n        this.locations[name] = location;\n      }\n      return this.locations[name];\n    }\n\n    set