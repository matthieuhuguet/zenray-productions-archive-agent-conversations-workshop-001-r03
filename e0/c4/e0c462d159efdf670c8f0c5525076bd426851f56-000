lign-items: center; gap: 6px; }\n  .field label { color: var(--muted); font-size: 11.5px; }\n  .field select {\n    background: #0f0f11; color: var(--text); border: 1px solid rgba(255,255,255,.14);\n    border-radius: 6px; padding: 4px 7px; font: inherit;\n  }\n  .spacer { flex: 1; }\n  button.primary, button.ghost {\n    border: none; border-radius: 8px; padding: 9px 15px;\n    font: 600 12.5px InterLocal, sans-serif; cursor: pointer; white-space: nowrap;\n  }\n  button.primary { background: var(--accent); color: #17140f; }\n  button.ghost { background: transparent; color: var(--accent); border: 1px solid rgba(243,138,92,.55); }\n  button.primary:active, button.ghost:active { transform: translateY(1px); }\n\n  .stage {\n    position: fixed; top: 56px; left: 0; right: var(--panel-gutter); bottom: var(--strip-height);\n    display: grid; place-items: center; padding: 18px; overflow: hidden;\n    min-width: 0; min-height: 0;\n  }\n  /* Le cadre porte le RATIO de l'image et se borne au viewport ; le canvas le\n     remplit. Un `max-width:100%` sur le canvas seul creait une circularite avec\n     un parent inline-block dont la largeur venait du canvas : les deux tombaient\n     a zero et l'image, pourtant bien chargee en texture, restait invisible. */\n  .frame {\n    position: relative; display: block; line-height: 0;\n    container-type: inline-size;\n    aspect-ratio: var(--img-ratio, 4 / 5);\n    height: 100%; width: auto;\n    max-width: 100%; max-height: 100%;\n    border-radius: 10px; overflow: hidden;\n    box-shadow: 0 18px 50px rgba(0,0,0,.5); background: #000;\n  }\n  .frame canvas { display: block; width: 100%; height: 100%; }\n  #source { display: none; }\n\n  #text-layers { position: absolute; inset: 0; pointer-events: none; }\n  .text-layer {\n    position: absolute; left: 0; right: 0; padding: 0 6%;\n    line-height: 1.15; white-space: nowrap;\n    text-shadow: 0 2px 10px rgba(0,0,0,.55), 0 1px 3px rgba(0,0,0,.65);\n  }\n  .text-layer.font-serif { font-family: AnthropicSerif, \"Hiragino Mincho ProN W3\", serif; }\n  .text-layer.font-sans { font-family: InterLocal, \"Hiragino Sans W4\", sans-serif; }\n  .text-layer.anchor-v-top { top: 6%; }\n  .text-layer.anchor-v-middle { top: 50%; transform: translateY(-50%); }\n  .text-layer.anchor-v-bottom { bottom: 6%; }\n  .text-layer.anchor-h-left { text-align: left; }\n  .text-layer.anchor-h-center { text-align: center; }\n  .text-layer.anchor-h-right { text-align: right; }\n\n  .strip {\n    position: fixed; left: 0; right: var(--panel-gutter); bottom: 0; height: var(--strip-height);\n    z-index: 30; display: flex; gap: 12px; align-items: flex-start;\n    padding: 12px 20px; overflow-x: auto; overflow-y: hidden;\n    background: var(--panel); border-top: 1px solid rgba(255,255,255,.08);\n  }\n  .tile {\n    position: relative; flex: 0 0 auto; width: 104px;\n    background: var(--card); border-radius: 10px; overflow: hidden;\n    border: 2px solid transparent; cursor: grab; user-select: none;\n    transition: opacity .12s, border-color .12s;\n  }\n …793 tokens truncated…erif; color: var(--muted);\n  }\n  .layer-head .idx {\n    background: var(--accent); color: #17140f; border-radius: 4px; padding: 1px 6px;\n    font: 700 10px ui-monospace, monospace;\n  }\n  .layer-head button {\n    margin-left: auto; background: transparent; border: 1px solid rgba(255,255,255,.2);\n    color: var(--muted); border-radius: 6px; padding: 3px 8px;\n    font: 600 10.5px InterLocal, sans-serif; cursor: pointer;\n  }\n  .layer-block input[type=text] {\n    width: 100%; margin-bottom: 7px; min-height: 32px; padding: 6px 8px;\n    border: 0; border-radius: 8px; background: #3a3a3a; color: #fff;\n    font: 12px InterLocal, sans-serif;\n  }\n  .layer-block .row2 { display: flex; gap: 7px; margin-bottom: 7px; }\n  .layer-block .row2 select {\n    flex: 1; min-width: 0; min-height: 30px; padding: 4px 7px;\n    border: 0; border-radius: 7px; background: #3a3a3a; color: #fff;\n    font: 11.5px InterLoc