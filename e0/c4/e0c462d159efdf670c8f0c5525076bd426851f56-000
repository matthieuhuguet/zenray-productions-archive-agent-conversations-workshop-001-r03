r y = vAnchor === \"top\" ? marginY : vAnchor === \"middle\" ? (canvasH - m.height) / 2 : canvasH - marginY - m.height;\n    return x >= 0 && y >= 0 && x + m.width <= canvasW && y + m.height <= canvasH;\n  }\n\n  // Auto-fit : jamais l'inverse. Part de la taille demandée (px, dans\n  // l'espace du canevas de sortie) et la rétrécit tant qu'elle déborde la\n  // largeur padée OU les bords mêmes du cadre, jusqu'à la plus grande taille\n  // qui tient. La police ne sort jamais du cadre pour « cropper » le texte.\n  function fitTextSize(value, fontKey, weight, anchor, desiredPx, canvasW, canvasH) {\n    var parts = anchor.split(\"-\");\n    var vAnchor = parts[0], hAnchor = parts[1];\n    var marginX = canvasW * 0.06, marginY = canvasH * 0.06;\n    var px = desiredPx;\n    var m = measureAt(value, fontKey, weight, px);\n    var guard = 0;\n    while (guard++ < 200 && px > MIN_SIZE_PX && !textFits(m, hAnchor, vAnchor, canvasW, canvasH, marginX, marginY)) {\n      px = Math.max(MIN_SIZE_PX, px - Math.max(1, px * 0.03));\n      m = measureAt(value, fontKey, weight, px);\n    }\n    return Math.max(MIN_SIZE_PX, Math.round(px));\n  }\n\n  function applyFormat() {\n    var f = FORMATS[state.format];\n    var parts = state.format.split(\":\");\n    root.style.setProperty(\"--fmt-ratio\", parts[0] + \" / \" + parts[1]);\n    var outW = f.w * f.factor, outH = f.h * f.factor;\n    resLabel.textContent = f.w + \"×\" + f.h + \" ×\" + f.factor + \" → sortie \" + outW + \"×\" + outH;\n    IMAGES.forEach(function (img) {\n      if (!img._els.imgEl) return;\n      img._els.imgEl.style.setProperty(\"--safescale\", safeScale(img.rotate, f.w, f.h));\n      if (img._els.setAnchorMode) img._els.setAnchorMode();\n      if (img._els.refreshOverlay) img._els.refreshOverlay();\n    });\n  }\n  fmtSelect.addEventListener(\"change\", function () {\n    state.format = fmtSelect.value;\n    applyFormat();\n  });\n\n  document.title = \"zenray-html-hda · \" + PROJECT;\n  document.getElementById(\"projectLabel\").textContent = PROJECT;\n  countLabel.textContent = IMAGES.length + \" photos\";\n\n  function lineFor(img) {\n    var f = FORMATS[state.format];\n    var line = \"[\" + img.id + \"] \" + img.file + \" · zoom=\" + img.zoom.toFixed(2) +\n      \" rotate=\" + img.rotate.toFixed(1) + \"deg\" +\n      \" x=\" + Math.round(img.px) + \"% y=\" + Math.round(img.py) + \"% format=\" +\n      state.format + \"(\" + f.w + \"x\" + f.h + \")\";\n    img.textLayers.forEach(function (layer, index) {\n      if (!layer.value.trim()) return;\n      line += \"\\n    T\" + (index + 1) +\n        ' text=\"' + layer.value.trim().replace(/\"/g, \"'\") + '\"' +\n        \" font=\" + layer.font + \" weight=\" + layer.weight +\n        \" size=\" + layer.effectiveSizePx + \"px\" +\n        \" color=\" + layer.color + \" anchor=\" + layer.anchor;\n    });\n    return line;\n  }\n\n  function copyText(text) {\n    var ta = document.createElement(\"textarea\");\n    ta.value = text;\n    ta.style.position = \"fixed\";\n    ta.style.opacity = \"0\";\n    document.body.appendChild(ta);\n    ta.select();\n    var ok = false;\n    try { ok = document.execCommand(\"copy\"); } catch (e) {}\n    ta.remove();\n    return ok;\n  }\n\n  IMAGES.forEach(function (img) {\n    var card = document.createElement(\"div\");\n    card.className = \"card\";\n\n    var badge = document.createElement(\"div\");\n    badge.className = \"badge\";\n    badge.innerHTML =\n      '<span class=\"id\">' + img.id + '</span>' +\n      '<span class=\"name\">' + img.file + '</span>' +\n      '<span class=\"dims\">' + img.w + '×' + img.h + '</span>';\n    card.appendChild(badge);\n\n    var frame = document.createElement(\"div\");\n    frame.className = \"crop-frame\";\n    var el = document.createElement(\"img\");\n    el.src = SOURCE_DIR + encodeURIComponent(img.file).replace(/%2F/g, \"/\");\n    el.alt = img.file;\n    el.style.setProperty(\"--zoom\", img.zoom);\n    el.style.setProperty(\"--px\", img.px + \"%\");\n    el.style.setProperty(\"--py\", img.py + \"%\");\n    el.style.setProperty(\"--angle\", img.rotate + \"deg\");\n    el.style.setProperty(\"--safescale\", safeScale(img.rotate, FORMATS[state.format].w, FORMATS[state.format].h));\n    frame.appendChild(el);\n    img._els.imgEl = el;\n\n    var overlayHost = document.createElement(\"div\");\n    overlayHost.className = \"text-overlays\";\n    frame.appendChild(overlayHost);\n    img._els.overlayHost = overlayHost;\n\n    card.appendChild(frame);\n\n    var controls = document.createElement(\"div\");\n    controls.className = \"controls\";\n\n    function sliderRow(key, labelText, min, max, step, value, decimals, onInput) {\n      var row = document.createElement(\"div\");\n      row.className = \"slider-row\";\n      var lbl = document.createElement(\"div\");\n      lbl.className = \"row-label\";\n      var valSpan = document.createElement(\"b\");\n      valSpan.textContent = value.toFixed(decimals);\n      lbl.innerHTML = \"<span>\" + labelText + \"</span>\";\n      lbl.appendChild(valSpan);\n      row.appendChild(lbl);\n      var input = document.createElement(\"input\");\n      input.type = \"range\";\n      input.min = min; input.max = max; input.step = step; input.value = value;\n\n      function commit(v) {\n        input.value = v;\n        valSpan.textContent = Number(v).toFixed(decimals);\n        onInput(Number(v));\n      }\n      input.addEventListener(\"input\", function () { commit(parseFloat(input.value)); });\n      row.appendChild(input);\n\n      var extra = document.createElement(\"div\");\n      extra.className = \"control-extra\";\n      STEP_MARKS.forEach(function (percent) {\n        var mark = document.createElement(\"button\");\n        mark.type = \"button\";\n        mark.className = \"step\" + (percent === 25 || percent === 75 ? \" minor\" : \"\");\n        mark.textContent = percent;\n        mark.title = percent + \" % de la plage\";\n        mark.addEventListener(\"click\", function () { commit(steppedValue(min, max, percent)); });\n        extra.appendChild(mark);\n      });\n      var toAll = document.createElement(\"button\");\n      toAll.type = \"button\";\n      toAll.className = \"apply-all\";\n      toAll.textContent = \"à toutes\";\n      toAll.title = \"Appliquer CE réglage à toutes les photos, maintenant. Les images restent indépendantes ensuite.\";\n      toAll.addEventListener(\"click\", function () {\n        applyKeyToAll(key, parseFloat(input.value));\n        flash(toAll);\n      });\n      extra.appendChild(toAll);\n      row.appendChild(extra);\n\n      registerControl(key, commit);\n      return row;\n    }\n\n    controls.appendChild(sliderRow(\"zoom\", \"Zoom\", 1, 3, 0.01, img.zoom, 2, function (v) {\n      img.zoom = v; el.style.setProperty(\"--zoom\", v);\n    }));\n    controls.appendChild(sliderRow(\"px\", \"Position X\", 0, 100, 1, img.px, 0, function (v) {\n      img.px = v; el.style.setProperty(\"--px\", v + \"%\");\n    }));\n    controls.appendChild(sliderRow(\"py\", \"Position Y\", 0, 100, 1, img.py, 0, function (v) {\n      img.py = v; el.style.setProperty(\"--py\", v + \"%\");\n    }));\n    controls.appendChild(sliderRow(\"rotate\", \"Rotation °\", -45, 45, 0.5, img.rotate, 1, function (v) {\n      img.rotate = v;\n      el.style.setProperty(\"--angle\", v + \"deg\");\n      el.style.setProperty(\"--safescale\", safeScale(v, FORMATS[state.format].w, FORMATS[state.format].h));\n    }));\n\n    // Copie INTEGRALE de cette carte vers toutes les autres : cadrage et\n    // calques de texte. Copie profonde, jamais une reference partagee, donc\n    // chaque image reste modifiable seule apres le clic.\n    var applyEverything = document.createElement(\"button\");\n    applyEverything.type = \"button\";\n    applyEverything.className = \"apply-everything\";\n    applyEverything.textContent = \"Appliquer TOUT ce réglage à toutes\";\n    applyEverything.title = \"Cadrage et textes de cette photo recopiés sur toutes, maintenant. Les images restent indépendantes ensuite.\";\n    applyEverything.addEventListener(\"click\", function () {\n      var textCopy = JSON.parse(JSON.stringify(img.textLayers));\n      IMAGES.forEach(function (other) {\n        if (other.id === img.id) return;\n        other.zoom = img.zoom; other.px = img.px; other.py = img.py; other.rotate = img.rotate;\n        other.textLayers = JSON.parse(JSON.stringify(textCopy));\n        if (other._els.imgEl) {\n          other._els.imgEl.style.setProperty(\"--zoom\", other.zoom);\n          other._els.imgEl.style.setProperty(\"--px\", other.px + \"%\");\n          other._els.imgEl.style.setProperty(\"--py\", other.py + \"%\");\n          other._els.imgEl.style.setProperty(\"--angle\", other.rotate + \"deg\");\n          other._els.imgEl.style.setProperty(\"--safescale\",\n            safeScale(other.rotate, FORMATS[state.format].w, FORMATS[state.format].h));\n        }\n        if (other._els.rebuildLayers) other._els.rebuildLayers();\n        if (other._els.refreshOverlay) other._els.refreshOverlay();\n      });\n      // Les curseurs des autres cartes doivent afficher la nouvelle valeur.\n      applyKeyToAll(\"zoom\", img.zoom); applyKeyToAll(\"px\", img.px);\n      applyKeyToAll(\"py\", img.py); applyKeyToAll(\"rotate\", img.rotate);\n      flash(applyEverything);\n    });\n    controls.appendChild(applyEverything);\n\n    // Calques de texte, aucun par defaut, jusqu'a trois par image (2026-09-01).\n    var layerList = document.createElement(\"div\");\n    layerList.className = \"layer-list\";\n    controls.appendChild(layerList);\n\n    var addLayerBtn = document.createElement(\"button\");\n    addLayerBtn.type = \"button\";\n    addLayerBtn.className = \"add-layer\";\n    controls.appendChild(addLayerBtn);\n\n    var layerReadouts = [];\n\n    function refreshOverlay() {\n      // Redessine TOUS les calques de l'image, et met a jour les mentions de\n      // taille ajustee. La taille demandee reste un point de depart : c'est la\n      // taille effective, celle qui tient dans le cadre, qui est affichee et\n      // copiee.\n      var canvas = canvasSize();\n      overlayHost.innerHTML = \"\";\n      img.textLayers.forEach(function (layer) {\n        var effective = layer.value\n          ? fitTextSize(layer.value, layer.font, layer.weight, layer.anchor, layer.sizePx, canvas.w, canvas.h)\n          : layer.sizePx;\n        layer.effectiveSizePx = effective;\n        if (!layer.value.trim()) return;\n        var parts = layer.anchor.split(\"-\");\n        var el = document.createElement(\"div\");\n        el.className = \"text-overlay shown font-\" + layer.font +\n          \" anchor-v-\" + parts[0] + \" anchor-h-\" + parts[1];\n        el.style.color = layer.color;\n        el.style.fontWeight = layer.weight;\n        el.style.fontSize = (effective / canvas.w * 100) + \"cqw\";\n        el.textContent = layer.value;\n        overlayHost.appendChild(el);\n      });\n      layerReadouts.forEach(function (entry) {\n        var layer = img.textLayers[entry.index];\n        if (!layer) return;\n        var adjusted = layer.effectiveSizePx !== layer.sizePx;\n        entry.node.textContent = adjusted\n          ? (\"affiché \" + layer.effectiveSizePx + \"px (ajusté pour tenir dans le cadre)\")\n          : \"\";\n        entry.node.classList.toggle(\"adjusted\", adjusted);\n      });\n    }\n\n    function buildLayerPanel() {\n      layerList.innerHTML = \"\";\n      layerReadouts = [];\n      img.textLayers.forEach(function (layer, index) {\n        var block = document.createElement(\"div\");\n        block.className = \"layer-block\";\n\n        var head = document.createElement(\"div\");\n        head.className = \"layer-head\";\n        var idx = document.createElement(\"span\");\n        idx.className = \"idx\";\n        idx.textContent = \"T\" + (index + 1);\n        var title = document.createElement(\"span\");\n        title.textContent = \"Texte\";\n        var remove = document.createElement(\"button\");\n        remove.type = \"button\";\n        remove.textContent = \"Supprimer\";\n        remove.addEventListener(\"click\", function () {\n          img.textLayers.splice(index, 1);\n          buildLayerPanel();\n          refreshOverlay();\n        });\n        head.appendChild(idx); head.appendChild(title); head.appendChild(remove);\n        block.appendChild(head);\n\n        var textInput = document.createElement(\"input\");\n        textInput.type = \"text\";\n        textInput.placeholder = \"Texte à poser sur la photo…\";\n        textInput.value = layer.value;\n        textInput.addEventListener(\"input\", function () {\n          layer.value = textInput.value; refreshOverlay();\n        });\n        block.appendChild(textInput);\n\n        var row2 = document.createElement(\"div\");\n        row2.className = \"row2\";\n        var fontSelect = document.createElement(\"select\");\n        [\"serif\", \"sans\"].forEach(function (v) {\n          var o = document.createElement(\"option\"); o.value = v;\n          o.textContent = v === \"serif\" ? \"Serif\" : \"Sans\";\n          fontSelect.appendChild(o);\n        });\n        fontSelect.value = layer.font;\n        fontSelect.addEventListener(\"change\", function () {\n          layer.font = fontSelect.value; refreshOverlay();\n        });\n        var weightSelect = document.createElement(\"select\");\n        WEIGHTS.forEach(function (w) {\n          var o = document.createElement(\"option\"); o.value = w[0]; o.textContent = w[1];\n          weightSelect.appendChild(o);\n        });\n        weightSelect.value = String(layer.weight);\n        weightSelect.addEventListener(\"change\", function () {\n          layer.weight = parseInt(weightSelect.value, 10); refreshOverlay();\n        });\n        row2.appendChild(fontSelect); row2.appendChild(weightSelect);\n        block.appendChild(row2);\n\n        var sizeRow = document.createElement(\"div\");\n        sizeRow.className = \"size-row\";\n        var sizeInput = document.createElement(\"input\");\n        sizeInput.type = \"number\";\n        sizeInput.min = String(MIN_SIZE_PX);\n        sizeInput.max = \"4000\";\n        sizeInput.step = \"2\";\n        sizeInput.value = String(layer.sizePx);\n        sizeInput.addEventListener(\"input\", function () {\n          var v = parseFloat(sizeInput.value);\n          if (!isFinite(v) || v <= 0) return;\n          layer.sizePx = v; refreshOverlay();\n        });\n        var sizeUnit = document.createElement(\"span\");\n        sizeUnit.textContent = \"px\";\n        sizeUnit.style.color = \"var(--muted)\";\n        sizeUnit.style.fontSize = \"11px\";\n        var sizeEffective = document.createElement(\"span\");\n        sizeEffective.className = \"size-effective\";\n        layerReadouts.push({ index: index, node: sizeEffective });\n        sizeRow.appendChild(sizeInput); sizeRow.appendChild(sizeUnit); sizeRow.appendChild(sizeEffective);\n        block.appendChild(sizeRow);\n\n        var swatches = document.createElement(\"div\");\n        swatches.className = \"swatches\";\n        var yellowSwatch = document.createElement(\"div\");\n        yellowSwatch.className = \"swatch yellow\" + (layer.color === \"#f6cf47\" ? \" active\" : \"\");\n        yellowSwatch.title = \"Jaune #f6cf47\";\n        var whiteSwatch = document.createElement(\"div\");\n        whiteSwatch.className = \"swatch white\" + (layer.color === \"#ffffff\" ? \" active\" : \"\");\n        whiteSwatch.title = \"Blanc #ffffff\";\n        yellowSwatch.addEventListener(\"click\", function () {\n          layer.color = \"#f6cf47\";\n          yellowSwatch.classList.add(\"active\"); whiteSwatch.classList.remove(\"active\");\n          refreshOverlay();\n        });\n        whiteSwatch.addEventListener(\"click\", function () {\n    if font_key == \"sans\":\n        font = ImageFont.truetype(SANS_FONT_FILE, size)\n        try:\n            font.set_variation_by_axes([weight])\n        except Exception:\n            pass\n        return font\n    nearest = min(SERIF_FONT_FILES, key=lambda w: abs(w - weight))\n    return ImageFont.truetype(SERIF_FONT_FILES[nearest], size)\n\n\ndef position_for(bbox, h_anchor, v_anchor, canvas_w, canvas_h, margin_x, margin_y):\n    text_w, text_h = bbox[2] - bbox[0], bbox[3] - bbox[1]\n    if h_anchor == \"left\":\n        x = margin_x - bbox[0]\n    elif h_anchor == \"right\":\n        x = canvas_w - margin_x - text_w - bbox[0]\n    else:\n        x = (canvas_w - text_w) / 2 - bbox[0]\n    if v_anchor == \"top\":\n        y = margin_y - bbox[1]\n    elif v_anchor == \"middle\":\n        y = (canvas_h - text_h) / 2 - bbox[1]\n    else:\n        y = canvas_h - margin_y - text_h - bbox[1]\n    return x, y\n\n\ndef draw_caption(canvas, cfg, canvas_w, canvas_h):\n    value = (cfg.get(\"value\") or \"\").strip()\n    if not value:\n        return canvas\n    font_key = cfg.get(\"font\", \"serif\")\n    weight = int(cfg.get(\"weight\", 400))\n    color = cfg.get(\"color\", \"#f6cf47\")\n    v_anchor, h_anchor = (cfg.get(\"anchor\") or \"bottom-center\").split(\"-\")\n    margin_x, margin_y = canvas_w * 0.06, canvas_h * 0.06\n    max_width = canvas_w * 0.88\n\n    # La taille venue du navigateur est un point de depart : on refait l'ajustement\n    # cote Python, dont les metriques different legerement, pour garantir que le\n    # texte ne sorte JAMAIS du cadre dans le fichier livre.\n    font_size = round(cfg.get(\"size_px\") or cfg.get(\"requested_size_px\") or 200)\n    probe = ImageDraw.Draw(canvas)\n\n    def fits(bbox):\n        if (bbox[2] - bbox[0]) > max_width:\n            return False\n        x, y = position_for(bbox, h_anchor, v_anchor, canvas_w, canvas_h, margin_x, margin_y)\n        return (x + bbox[0] >= 0 and y + bbox[1] >= 0\n                and x + bbox[2] <= canvas_w and y + bbox[3] <= canvas_h)\n\n    font = load_font(font_key, weight, font_size)\n    bbox = probe.textbbox((0, 0), value, font=font)\n    while not fits(bbox) and font_size > MIN_FONT_SIZE_PX:\n        font_size -= 2\n        font = load_font(font_key, weight, font_size)\n        bbox = probe.textbbox((0, 0), value, font=font)\n\n    x, y = position_for(bbox, h_anchor, v_anchor, canvas_w, canvas_h, margin_x, margin_y)\n\n    canvas = canvas.convert(\"RGBA\")\n    shadow = Image.new(\"RGBA\", canvas.size, (0, 0, 0, 0))\n    ImageDraw.Draw(shadow).text((x, y), value, font=font, fill=(0, 0, 0, 200))\n    shadow = shadow.filter(ImageFilter.GaussianBlur(canvas_w * 0.004))\n    canvas = Image.alpha_composite(canvas, shadow)\n    ImageDraw.Draw(canvas).text((x, y), value, font=font, fill=color)\n    return canvas.convert(\"RGB\")\n\n\n# ---------------------------------------------------------------- cook\n\ndef main():\n    index = json.loads((HERE / \"_index.json\").read_text())\n    params_path = HERE / \"_params.json\"\n    if not params_path.exists():\n        raise SystemExit(\n            \"_params.json manquant : coller ici le JSON rendu par le bouton \"\n            \"« Copier TOUT (ordre + réglages) » de index.html\"\n        )\n    params = json.loads(params_path.read_text())\n    by_id = {img[\"id\"]: img for img in index[\"images\"]}\n\n    order = params[\"order\"]\n    images = params[\"images\"]\n    known, given = set(by_id), set(order)\n    assert given == known, (\n        f\"l'ordre doit citer exactement les {len(known)} id de _index.json ; \"\n        f\"manquants={sorted(known - given)} en trop={sorted(given - known)}\"\n    )\n\n    OUT_DIR.mkdir(exist_ok=True)\n    written = []\n    for position, image_id in enumerate(order, start=1):\n        entry = by_id[image_id]\n        spec = images[image_id]\n        src_path = Path(entry[\"path\"])\n        if not src_path.exists():\n            src_path = SOURCE_DIR / entry[\"file\"]\n        assert src_path.exists(), f\"source introuvable : {src_path}\"\n\n        image = ImageOps.exif_transpose(Image.open(src_path)).convert(\"RGB\")\n\n        # CADRAGE d'abord, exactement la meme chaine que l'apercu : une seule\n        # transformation affine source -> canevas cible. Sans format demande, ou\n        # avec un cadrage neutre, l'image passe telle quelle.\n        crop = spec.get(\"crop\") or {}\n        fmt = params.get(\"format\")\n        if fmt:\n            canvas_w = fmt[\"w\"] * fmt[\"factor\"]\n            canvas_h = fmt[\"h\"] * fmt[\"factor\"]\n            coeffs = affine_coeffs(\n                image.width, image.height, canvas_w, canvas_h,\n                crop.get(\"px\", 50), crop.get(\"py\", 50),\n                crop.get(\"zoom\", 1), crop.get(\"rotate\", 0),\n            )\n            image = image.transform((canvas_w, canvas_h), Image.AFFINE,\n                                    data=coeffs, resample=Image.BICUBIC)\n        canvas_w, canvas_h = image.size\n\n        array = np.asarray(image, dtype=np.float32) / 255.0\n        array = apply_photo(array, spec.get(\"photo\"))\n        out = Image.fromarray(np.rint(array * 255.0).astype(np.uint8))\n\n        texts = spec.get(\"text\") or []\n        for cfg in texts:\n            out = draw_caption(out, cfg, canvas_w, canvas_h)\n\n        if position > 99:\n            raise SystemExit(\"le mode heavy numérote les sorties de 01 à 99\")\n        out_path = OUT_DIR / f\"{position:02d}.jpg\"\n      var layer = currentLayers()[entry.index];\n      if (!layer) return;\n      var adjusted = layer.effectiveSizePx !== layer.sizePx;\n      entry.node.textContent = adjusted\n        ? (\"affiché \" + layer.effectiveSizePx + \"px (ajusté pour tenir dans le cadre)\")\n        : \"\";\n      entry.node.classList.toggle(\"adjusted\", adjusted);\n    });\n  }\n\n  function buildLayerPanel() {\n    layerList.innerHTML = \"\";\n    layerReadouts = [];\n    currentLayers().forEach(function (layer, index) {\n      var block = document.createElement(\"div\");\n      block.className = \"layer-block\";\n\n      var head = document.createElement(\"div\");\n      head.className = \"layer-head\";\n      var idx = document.createElement(\"span\");\n      idx.className = \"idx\";\n      idx.textContent = \"T\" + (index + 1);\n      var title = document.createElement(\"span\");\n      title.textContent = \"Calque de texte\";\n      var remove = document.createElement(\"button\");\n      remove.type = \"button\";\n      remove.textContent = \"Supprimer\";\n      remove.addEventListener(\"click\", function () {\n        currentLayers().splice(index, 1);\n        buildLayerPanel();\n        scheduleRender();\n      });\n      head.append(idx, title, remove);\n      block.append(head);\n\n      var input = document.createElement(\"input\");\n      input.type = \"text\";\n      input.placeholder = \"Texte à poser sur la photo…\";\n      input.value = layer.value;\n      input.addEventListener(\"input\", function () {\n        layer.value = input.value;\n        scheduleRender();\n      });\n      block.append(input);\n\n      var row2 = document.createElement(\"div\");\n      row2.className = \"row2\";\n      var fontSelect = document.createElement(\"select\");\n      [[\"serif\", \"Serif\"], [\"sans\", \"Sans\"]].forEach(function (pair) {\n        var o = document.createElement(\"option\");\n        o.value = pair[0]; o.textContent = pair[1];\n        fontSelect.append(o);\n      });\n      fontSelect.value = layer.font;\n      fontSelect.addEventListener(\"change\", function () {\n        layer.font = fontSelect.value;\n        scheduleRender();\n      });\n      var weightSelect = document.createElement(\"select\");\n      WEIGHTS.forEach(function (pair) {\n        var o = document.createElement(\"option\");\n        o.value = pair[0]; o.textContent = pair[1];\n        weightSelect.append(o);\n      });\n      weightSelect.value = String(layer.weight);\n      weightSelect.addEventListener(\"change\", function () {\n        layer.weight = parseInt(weightSelect.value, 10);\n        scheduleRender();\n      });\n      row2.append(fontSelect, weightSelect);\n      block.append(row2);\n\n      var sizeRow = document.createElement(\"div\");\n      sizeRow.className = \"size-row\";\n      var sizeInput = document.createElement(\"input\");\n      sizeInput.type = \"number\";\n      sizeInput.min = String(MIN_SIZE_PX);\n      sizeInput.max = \"4000\";\n      sizeInput.step = \"2\";\n      sizeInput.value = String(layer.sizePx);\n      sizeInput.addEventListener(\"input\", function () {\n        var v = parseFloat(sizeInput.value);\n        if (!isFinite(v) || v <= 0) return;\n        layer.sizePx = v;\n        scheduleRender();\n      });\n      var unit = document.createElement(\"span\");\n      unit.textContent = \"px\";\n      unit.style.color = \"var(--muted)\";\n      unit.style.fontSize = \"11px\";\n      var effective = document.createElement(\"span\");\n      effective.className = \"size-effective\";\n      layerReadouts.push({ index: index, node: effective });\n      sizeRow.append(sizeInput, unit, effective);\n      block.append(sizeRow);\n\n      var bottom = document.createElement(\"div\");\n      bottom.className = \"bottom\";\n\n      var swatches = document.createElement(\"div\");\n      swatches.className = \"swatches\";\n      var yellow = document.createElement(\"div\");\n      yellow.className = \"swatch yellow\" + (layer.color === \"#f6cf47\" ? \" active\" : \"\");\n      yellow.title = \"Jaune #f6cf47\";\n      var white = document.createElement(\"div\");\n      white.className = \"swatch white\" + (layer.color === \"#ffffff\" ? \" active\" : \"\");\n      white.title = \"Blanc #ffffff\";\n      yellow.addEventListener(\"click\", function () {\n        layer.color = \"#f6cf47\";\n        yellow.classList.add(\"active\"); white.classList.remove(\"active\");\n        scheduleRender();\n      });\n      white.addEventListener(\"click\", function () {\n        layer.color = \"#ffffff\";\n        white.classList.add(\"active\"); yellow.classList.remove(\"active\");\n        scheduleRender();\n      });\n      swatches.append(yellow, white);\n\n      var widget = document.createElement(\"div\");\n      widget.className = \"anchor-widget\";\n      widget.dataset.mode = isLandscape() ? \"9\" : \"3\";\n      var buttons = ANCHORS.map(function (anchor) {\n        var b = document.createElement(\"button\");\n        b.type = \"button\";\n        b.dataset.anchor = anchor;\n        b.title = anchor;\n        if (anchor === layer.anchor) b.classList.add(\"active\");\n        b.addEventListener(\"click\", function () {\n          layer.anchor = anchor;\n          buttons.forEach(function (other) {\n            other.classList.toggle(\"active\", other.dataset.anchor === anchor);\n          });\n          scheduleRender();\n        });\n        widget.append(b);\n        return b;\n      });\n      // Un format portrait ou carre n'expose que la colonne du centre : une ancre\n      // laterale devenue invalide est ramenee sur son equivalent centre.\n      if (!isLandscape() && layer.anchor.indexOf(\"-center\") === -1) {\n        layer.anchor = clampAnchorToCenter(layer.anchor);\n        buttons.forEach(function (b) {\n          b.classList.toggle(\"active\", b.dataset.anchor === layer.anchor);\n        });\n      }\n\n      bottom.append(swatches, widget);\n      block.append(bottom);\n      layerList.append(block);\n    });\n\n    addLayerBtn.disabled = currentLayers().length >= MAX_LAYERS;\n    addLayerBtn.textContent = currentLayers().length >= MAX_LAYERS\n      ? \"+ Ajouter un texte (3 maximum)\"\n      : \"+ Ajouter un texte\";\n    refreshLayerReadouts();\n  }\n\n  addLayerBtn.addEventListener(\"click\", function () {\n    if (currentLayers().length >= MAX_LAYERS) return;\n    currentLayers().push(newLayer(currentLayers().length));\n    buildLayerPanel();\n    scheduleRender();\n  });\n\n  // ---------- bande de vignettes, selection et reorder ----------\n\n  var dragSrcId = null;\n\n  function refreshTileFlags() {\n    strip.querySelectorAll(\".tile\").forEach(function (tile) {\n      tile.classList.toggle(\"has-edits\", hasEdits(tile.dataset.id));\n      tile.classList.toggle(\"selected\", tile.dataset.id === selectedId);\n    });\n  }\n\n  function renderStrip() {\n    strip.innerHTML = \"\";\n    order.forEach(function (id, index) {\n      var img = byId[id];\n      var tile = document.createElement(\"div\");\n      tile.className = \"tile\";\n      tile.draggable = true;\n      tile.dataset.id = id;\n\n      var thumb = document.createElement(\"div\");\n      thumb.className = \"thumb\";\n      var el = document.createElement(\"img\");\n      el.src = srcUrl(img.file, img.id);\n      el.alt = img.file;\n      thumb.append(el);\n\n      var meta = document.createElement(\"div\");\n      meta.className = \"meta\";\n      var pos = document.createElement(\"span\");\n      pos.className = \"pos\";\n      pos.textContent = String(index + 1).padStart(2, \"0\");\n      var nm = document.createElement(\"span\");\n      nm.className = \"nm\";\n      nm.textContent = img.file;\n      meta.append(pos, nm);\n\n      var dot = document.createElement(\"span\");\n      dot.className = \"edited\";\n\n      tile.append(thumb, meta, dot);\n\n      tile.addEventListener(\"click\", function () { select(id); });\n      tile.addEventListener(\"dragstart\", function () { dragSrcId = id; tile.classList.add(\"dragging\"); });\n      tile.addEventListener(\"dragend\", function () { tile.classList.remove(\"dragging\"); });\n      tile.addEventListener(\"dragover\", function (e) { e.preventDefault(); tile.classList.add(\"drop-target\"); });\n      tile.addEventListener(\"dragleave\", function () { tile.classList.remove(\"drop-target\"); });\n      tile.addEventListener(\"drop\", function (e) {\n        e.preventDefault();\n        tile.classList.remove(\"drop-target\");\n        if (!dragSrcId || dragSrcId === id) return;\n        var from = order.indexOf(dragSrcId);\n        var to = order.indexOf(id);\n        order.splice(from, 1);\n        order.splice(to, 0, dragSrcId);\n        dragSrcId = null;\n        renderStrip();\n        updateCurrentLabel();\n      });\n\n      strip.append(tile);\n    });\n    refreshTileFlags();\n  }\n\n  function updateCurrentLabel() {\n    var img = byId[selectedId];\n    currentLabel.innerHTML = \"position <b>\" + String(order.indexOf(selectedId) + 1).padStart(2, \"0\") +\n      \"</b> · id \" + selectedId + \" · \" + img.file;\n  }\n\n  function select(id) {\n    selectedId = id;\n    updateCurrentLabel();\n    source.src = srcUrl(byId[id].file, id);\n    refreshTileFlags();\n    syncPhotoControls();\n    buildLayerPanel();\n  }\n\n  source.addEventListener(\"load\", function () {\n    var cropped = buildCrop();\n    processor.setImage(cropped || source);\n    processor.set(current());\n    var p = previewSize();\n    frame.style.setProperty(\"--img-ratio\", p.w + \" / \" + p.h);\n    status.textContent = source.naturalWidth + \" × \" + source.naturalHeight + \" px\";\n    buildLayerPanel();\n    renderTextLayers();\n  });\n  source.addEventListener(\"error\", function () {\n    status.textContent = \"image introuvable : \" + source.src;\n  });\n\n  // ---------- actions ----------\n\n  document.getElementById(\"applyAllBtn\").addEventListener(\"click\", function () {\n    applyEverythingToAll();\n    flash(document.getElementById(\"applyAllBtn\"));\n  });\n\n  document.getElementById(\"resetImageBtn\").addEventListener(\"click\", function () {\n    settings[selectedId] = ZRPhotoAdjustments.defaults();\n    layers[selectedId] = [];\n    crops[selectedId] = { zoom: 1, px: 50, py: 50, rotate: 0 };\n    syncPhotoControls();\n    syncPhotoControls();\n    buildLayerPanel();\n    scheduleRender();\n  });\n\n  document.getElementById(\"resetOrderBtn\").addEventListener(\"click\", function () {\n    order = initialOrder.slice();\n    renderStrip();\n    updateCurrentLabel();\n  });\n\n  function payload() {\n    var images = {};\n    order.forEach(function (id, index) {\n      var img = byId[id];\n      images[id] = {\n        position: index + 1,\n        file: img.file,\n        output: String(index + 1).padStart(2, \"0\") + \".jpg\",\n        crop: crops[id],\n        photo: settings[id],\n        text: layers[id]\n          .filter(function (l) { return l.value.trim(); })\n          .map(function (l) {\n            return {\n              value: l.value.trim(), font: l.font, weight: l.weight,\n              size_px: l.effectiveSizePx, requested_size_px: l.sizePx,\n              color: l.color, anchor: l.anchor\n            };\n          })\n      };\n    });\n    var fmt = FORMATS[state.format];\n    return {\n      project: PROJECT,\n      format: fmt ? { key: state.format, w: fmt.w, h: fmt.h, factor: fmt.factor } : null,\n      order: order,\n      images: images\n    };\n  }\n\n  function copyText(text) {\n    var ta = document.createElement(\"textarea\");\n    ta.value = text;\n    ta.style.position = \"fixed\";\n    ta.style.opacity = \"0\";\n    document.body.appendChild(ta);\n    ta.select();\n    var ok = false;\n    try { ok = document.execCommand(\"copy\"); } catch (e) {}\n    ta.remove();\n    return ok;\n  }\n\n  function outputText() {\n    var data = payload();\n    var f = data.format;\n    var head = \"ZENRAY-HTML-HDA STUDIO · \" + PROJECT + \" · \" +\n      (f ? \"format \" + f.key + \"(\" + f.w + \"x\" + f.h + \") ×\" + f.factor +\n           \" → \" + (f.w * f.factor) + \"x\" + (f.h * f.factor)\n         : \"format d'origine conservé\");\n    var lines = order.map(function (id) {\n      var entry = data.images[id];\n      var c = entry.crop;\n      var marks = [];\n      if (!isNeutralPhoto(entry.photo)) marks.push(\"photo retouchée\");\n      if (entry.text.length) marks.push(entry.text.length + \" texte\" + (entry.text.length > 1 ? \"s\" : \"\"));\n      return String(entry.position).padStart(2, \"0\") + \": \" + entry.file + \" -> \" + entry.output +\n        \"  zoom=\" + Number(c.zoom).toFixed(2) + \" rotate=\" + Number(c.rotate).toFixed(1) + \"deg\" +\n        \" x=\" + Math.round(c.px) + \"% y=\" + Math.round(c.py) + \"%\" +\n        (marks.length ? \"  (\" + marks.join(\", \") + \")\" : \"\");\n    });\n    return head + \"\\n\\n\" + lines.join(\"\\n\") + \"\\n\\n\" + JSON.stringify(data, null, 2);\n  }\n\n  var outBox = document.getElementById(\"outBox\");\n  var outText = document.getElementById(\"outText\");\n\n  document.getElementById(\"copyAllBtn\").addEventListener(\"click\", function () {\n    var text = outputText();\n    outText.value = text;\n    outBox.classList.add(\"shown\");\n    outText.focus();\n    outText.select();\n    copyText(text);\n  });\n  document.getElementById(\"outCopyBtn\").addEventListener(\"click\", function () {\n    var ok = copyText(outText.value);\n    document.getElementById(\"outCopyBtn\").textContent = ok ? \"Copié\" : \"Sélectionne et copie à la main\";\n","exit_code":0,"duration":{"secs":0,"nanos":5416},"formatted_output":"91:  .crop-frame {\n96:  .crop-frame img {\n264:  outil choisit le cadrage, `crop-apply.py` produit le JPEG final.\n379:  // sur lui-même. Même formule côté crop-apply.py, à ne jamais faire diverger.\n392:  // ImageDraw.textbbox côté crop-apply.py. Ne JAMAIS mesurer la boîte\n409:  // Même géométrie que crop-apply.py : marge 6% des deux côtés, ancre\n422:  // qui tient. La police ne sort jamais du cadre pour « cropper » le texte.\n476:  function copyText(text) {\n502:    frame.className = \"crop-frame\";\n524:    function sliderRow(key, labelText, min, max, step, value, decimals, onInput) {\n666:    function buildLayerPanel() {\n\n  // Crans de pourcentage : 0, 25, 50, 75 et 100 pour cent de la PLAGE du\n  // parametre, jamais une valeur absolue. Le cran du milieu est donc toujours\n  // le neutre (0 pour une rotation de -45 a 45), ce qui rend les crans\n  // lisibles d'une ligne a l'autre. 25 et 75 sont dessines plus petits.\n  var STEP_MARKS = [0, 25, 50, 75, 100];\n  function steppedValue(min, max, percent) {\n    return Number(min) + (Number(max) - Number(min)) * (percent / 100);\n  }\n\n  // Registre des curseurs par cle de parametre, pour qu'un clic « à toutes »\n  // recopie la valeur dans toutes les cartes. La copie est PONCTUELLE : rien\n  // n'est lie ensuite, chaque image reste modifiable seule.\n  var CONTROLS = {};\n  function registerControl(key, setter) {\n    (CONTROLS[key] = CONTROLS[key] || []).push(setter);\n  }\n  function applyKeyToAll(key, value) {\n    (CONTROLS[key] || []).forEach(function (setter) { setter(value); });\n  }\n  function flash(button) {\n    button.classList.add(\"done\");\n    setTimeout(function () { button.classList.remove(\"done\"); }, 700);\n  }\n\n  var state = { format: DEFAULT_FORMAT };\n  IMAGES.forEach(function (img) {\n    img.zoom = 1; img.px = 50; img.py = 50; img.rotate = 0;\n    img.textLayers = [];\n    img._els = {};\n  });\n\n  var root = document.documentElement;\n  var grid = document.getElementById(\"grid\");\n  var fmtSelect = document.getElementById(\"fmtSelect\");\n  var resLabel = document.getElementById(\"resLabel\");\n  var countLabel = document.getElementById(\"countLabel\");\n\n  Object.keys(FORMATS).forEach(function (key) {\n    var opt = document.createElement(\"option\");\n    opt.value = key;\n    opt.textContent = key;\n    if (key === DEFAULT_FORMAT) opt.selected = true;\n    fmtSelect.appendChild(opt);\n  });\n\n  // Facteur anti-coin-transparent : agrandit la couverture pour qu'une\n  // rotation de `angle` degrés ne laisse jamais voir le fond du cadre.\n  // k = |cos| + max(H/W, W/H) * |sin|, exact pour un cadre W x H tourné\n  // sur lui-même. Même formule côté crop-apply.py, à ne jamais faire diverger.\n  function safeScale(angleDeg, fw, fh) {\n    var rad = angleDeg * Math.PI / 180;\n    var ratio = Math.max(fh / fw, fw / fh);\n    return Math.abs(Math.cos(rad)) + ratio * Math.abs(Math.sin(rad));\n  }\n\n  function canvasSize() {\n    var f = FORMATS[state.format];\n    return { w: f.w * f.factor, h: f.h * f.factor };\n  }\n\n  // Mesure hors-DOM (Canvas 2D), une seule ligne, exactement comme\n  // ImageDraw.textbbox côté crop-apply.py. Ne JAMAIS mesurer la boîte\n  // `.text-overlay` elle-même : `left:0;right:0` l'étire à toute la largeur\n  // du cadre quel que soit le texte, donc son scrollWidth ne dit rien de la\n  // largeur réelle du texte (bug constaté et corrigé le 2026-09-01).\n  var FONT_FAMILY_CSS = {\n    serif: \"'AnthropicSerif', 'Hiragino Mincho ProN W3', serif\",\n    sans: \"'InterLocal', 'Hiragino Sans W4', sans-serif\"\n  };\n  var measureCtx = document.createElement(\"canvas\").getContext(\"2d\");\n  function measureAt(value, fontKey, weight, px) {\n    measureCtx.font = weight + \" \" + px + \"px \" + FONT_FAMILY_CSS[fontKey];\n    var m = measureCtx.measureText(value);\n    var ascent = m.actualBoundingBoxAscent || px * 0.8;\n    var descent = m.actualBoundingBoxDescent || px * 0.2;\n    return { width: m.width, height: ascent + descent };\n  }\n\n  // Même géométrie que crop-apply.py : marge 6% des deux côtés, ancre\n  // haut/milieu/bas x gauche/centre/droite, jamais hors du cadre\n  // 0..canvasW / 0..canvasH (le cadre lui-même, pas seulement la marge).\n  function textFits(m, hAnchor, vAnchor, canvasW, canvasH, marginX, marginY) {\n    if (m.width > canvasW * 0.88) return false;\n    var x = hAnchor === \"left\" ? marginX : hAnchor === \"right\" ? canvasW - marginX - m.width : (canvasW - m.width) / 2;\n    var y = vAnchor === \"top\" ? marginY : vAnchor === \"middle\" ? (canvasH - m.height) / 2 : canvasH - marginY - m.height;\n    return x >= 0 && y >= 0 && x + m.width <= canvasW && y + m.height <= canvasH;\n  }\n\n  // Auto-fit : jamais l'inverse. Part de la taille demandée (px, dans\n  // l'espace du canevas de sortie) et la rétrécit tant qu'elle déborde la\n  // largeur padée OU les bords mêmes du cadre, jusqu'à la plus grande taille\n  // qui tient. La police ne sort jamais du cadre pour « cropper » le texte.\n  function fitTextSize(value, fontKey, weight, anchor, desiredPx, canvasW, canvasH) {\n    var parts = anchor.split(\"-\");\n    var vAnchor = parts[0], hAnchor = parts[1];\n    var marginX = canvasW * 0.06, marginY = canvasH * 0.06;\n    var px = desiredPx;\n    var m = measureAt(value, fontKey, weight, px);\n    var guard = 0;\n    while (guard++ < 200 && px > MIN_SIZE_PX && !textFits(m, hAnchor, vAnchor, canvasW, canvasH, marginX, marginY)) {\n      px = Math.max(MIN_SIZE_PX, px - Math.max(1, px * 0.03));\n      m = measureAt(value, fontKey, weight, px);\n    }\n    return Math.max(MIN_SIZE_PX, Math.round(px));\n  }\n\n  function applyFormat() {\n    var f = FORMATS[state.format];\n    var parts = state.format.split(\":\");\n    root.style.setProperty(\"--fmt-ratio\", parts[0] + \" / \" + parts[1]);\n    var outW = f.w * f.factor, outH = f.h * f.factor;\n    resLabel.textContent = f.w + \"×\" + f.h + \" ×\" + f.factor + \" → sortie \" + outW + \"×\" + outH;\n    IMAGES.forEach(function (img) {\n      if (!img._els.imgEl) return;\n      img._els.imgEl.style.setProperty(\"--safescale\", safeScale(img.rotate, f.w, f.h));\n      if (img._els.setAnchorMode) img._els.setAnchorMode();\n      if (img._els.refreshOverlay) img._els.refreshOverlay();\n    });\n  }\n  fmtSelect.addEventListener(\"change\", function () {\n    state.format = fmtSelect.value;\n    applyFormat();\n  });\n\n  document.title = \"zenray-html-hda · \" + PROJECT;\n  document.getElementById(\"projectLabel\").textContent = PROJECT;\n  countLabel.textContent = IMAGES.length + \" photos\";\n\n  function lineFor(img) {\n    var f = FORMATS[state.format];\n    var line = \"[\" + img.id + \"] \" + img.file + \" · zoom=\" + img.zoom.toFixed(2) +\n      \" rotate=\" + img.rotate.toFixed(1) + \"deg\" +\n      \" x=\" + Math.round(img.px) + \"% y=\" + Math.round(img.py) + \"% format=\" +\n      state.format + \"(\" + f.w + \"x\" + f.h + \")\";\n    img.textLayers.forEach(function (layer, index) {\n      if (!layer.value.trim()) return;\n      line += \"\\n    T\" + (index + 1) +\n        ' text=\"' + layer.value.trim().replace(/\"/g, \"'\") + '\"' +\n        \" font=\" + layer.font + \" weight=\" + layer.weight +\n        \" size=\" + layer.effectiveSizePx + \"px\" +\n        \" color=\" + layer.color + \" anchor=\" + layer.anchor;\n    });\n    return line;\n  }\n\n  function copyText(text) {\n    var ta = document.createElement(\"textarea\");\n    ta.value = text;\n    ta.style.position = \"fixed\";\n    ta.style.opacity = \"0\";\n    document.body.appendChild(ta);\n    ta.select();\n    var ok = false;\n    try { ok = document.execCommand(\"copy\"); } catch (e) {}\n    ta.remove();\n    return ok;\n  }\n\n  IMAGES.forEach(function (img) {\n    var card = document.createElement(\"div\");\n    card.className = \"card\";\n\n    var badge = document.createElement(\"div\");\n    badge.className = \"badge\";\n    badge.innerHTML =\n      '<span class=\"id\">' + img.id + '</span>' +\n      '<span class=\"name\">' + img.file + '</span>' +\n      '<span class=\"dims\">' + img.w + '×' + img.h + '</span>';\n    card.appendChild(badge);\n\n    var frame = document.createElement(\"div\");\n    frame.className = \"crop-frame\";\n    var el = document.createElement(\"img\");\n    el.src = SOURCE_DIR + encodeURIComponent(img.file).replace(/%2F/g, \"/\");\n    el.alt = img.file;\n    el.style.setProperty(\"--zoom\", img.zoom);\n    el.style.setProperty(\"--px\", img.px + \"%\");\n    el.style.setProperty(\"--py\", img.py + \"%\");\n    el.style.setProperty(\"--angle\", img.rotate + \"deg\");\n    el.style.setProperty(\"--safescale\", safeScale(img.rotate, FORMATS[state.format].w, FORMATS[state.format].h));\n    frame.appendChild(el);\n    img._els.imgEl = el;\n\n    var overlayHost = document.createElement(\"div\");\n    overlayHost.className = \"text-overlays\";\n    frame.appendChild(overlayHost);\n    img._els.overlayHost = overlayHost;\n\n    card.appendChild(frame);\n\n    var controls = document.createElement(\"div\");\n    controls.className = \"controls\";\n\n    function sliderRow(key, labelText, min, max, step, value, decimals, onInput) {\n      var row = document.createElement(\"div\");\n      row.className = \"slider-row\";\n      var lbl = document.createElement(\"div\");\n      lbl.className = \"row-label\";\n      var valSpan = document.createElement(\"b\");\n      valSpan.textContent = value.toFixed(decimals);\n      lbl.innerHTML = \"<span>\" + labelText + \"</span>\";\n      lbl.appendChild(valSpan);\n      row.appendChild(lbl);\n      var input = document.createElement(\"input\");\n      input.type = \"range\";\n      input.min = min; input.max = max; input.step = step; input.value = value;\n\n      function commit(v) {\n        input.value = v;\n        valSpan.textContent = Number(v).toFixed(decimals);\n        onInput(Number(v));\n      }\n      input.addEventListener(\"input\", function () { commit(parseFloat(input.value)); });\n      row.appendChild(input);\n\n      var extra = document.createElement(\"div\");\n      extra.className = \"control-extra\";\n      STEP_MARKS.forEach(function (percent) {\n        var mark = document.createElement(\"button\");\n        mark.type = \"button\";\n        mark.className = \"step\" + (percent === 25 || percent === 75 ? \" minor\" : \"\");\n        mark.textContent = percent;\n        mark.title = percent + \" % de la plage\";\n        mark.addEventListener(\"click\", function () { commit(steppedValue(min, max, percent)); });\n        extra.appendChild(mark);\n      });\n      var toAll = document.createElement(\"button\");\n      toAll.type = \"button\";\n      toAll.className = \"apply-all\";\n      toAll.textContent = \"à toutes\";\n      toAll.title = \"Appliquer CE réglage à toutes les photos, maintenant. Les images restent indépendantes ensuite.\";\n      toAll.addEventListener(\"click\", function () {\n        applyKeyToAll(key, parseFloat(input.value));\n        flash(toAll);\n      });\n      extra.appendChild(toAll);\n      row.appendChild(extra);\n\n      registerControl(key, commit);\n      return row;\n    }\n\n    controls.appendChild(sliderRow(\"zoom\", \"Zoom\", 1, 3, 0.01, img.zoom, 2, function (v) {\n      img.zoom = v; el.style.setProperty(\"--zoom\", v);\n    }));\n    controls.appendChild(sliderRow(\"px\", \"Position X\", 0, 100, 1, img.px, 0, function (v) {\n      img.px = v; el.style.setProperty(\"--px\", v + \"%\");\n    }));\n    controls.appendChild(sliderRow(\"py\", \"Position Y\", 0, 100, 1, img.py, 0, function (v) {\n      img.py = v; el.style.setProperty(\"--py\", v + \"%\");\n    }));\n    controls.appendChild(sliderRow(\"rotate\", \"Rotation °\", -45, 45, 0.5, img.rotate, 1, function (v) {\n      img.rotate = v;\n      el.style.setProperty(\"--angle\", v + \"deg\");\n      el.style.setProperty(\"--safescale\", safeScale(v, FORMATS[state.format].w, FORMATS[state.format].h));\n    }));\n\n    // Copie INTEGRALE de cette carte vers toutes les autres : cadrage et\n    // calques de texte. Copie profonde, jamais une reference partagee, donc\n    // chaque image reste modifiable seule apres le clic.\n    var applyEverything = document.createElement(\"button\");\n    applyEverything.type = \"button\";\n    applyEverything.className = \"apply-everything\";\n    applyEverything.textContent = \"Appliquer TOUT ce réglage à toutes\";\n    applyEverything.title = \"Cadrage et textes de cette photo recopiés sur toutes, maintenant. Les images restent indépendantes ensuite.\";\n    applyEverything.addEventListener(\"click\", function () {\n      var textCopy = JSON.parse(JSON.stringify(img.textLayers));\n      IMAGES.forEach(function (other) {\n        if (other.id === img.id) return;\n        other.zoom = img.zoom; other.px = img.px; other.py = img.py; other.rotate = img.rotate;\n        other.textLayers = JSON.parse(JSON.stringify(textCopy));\n        if (other._els.imgEl) {\n          other._els.imgEl.style.setProperty(\"--zoom\", other.zoom);\n          other._els.imgEl.style.setProperty(\"--px\", other.px + \"%\");\n          other._els.imgEl.style.setProperty(\"--py\", other.py + \"%\");\n          other._els.imgEl.style.setProperty(\"--angle\", other.rotate + \"deg\");\n          other._els.imgEl.style.setProperty(\"--safescale\",\n            safeScale(other.rotate, FORMATS[state.format].w, FORMATS[state.format].h));\n        }\n        if (other._els.rebuildLayers) other._els.rebuildLayers();\n        if (other._els.refreshOverlay) other._els.refreshOverlay();\n      });\n      // Les curseurs des autres cartes doivent afficher la nouvelle valeur.\n      applyKeyToAll(\"zoom\", img.zoom); applyKeyToAll(\"px\", img.px);\n      applyKeyToAll(\"py\", img.py); applyKeyToAll(\"rotate\", img.rotate);\n      flash(applyEverything);\n    });\n    controls.appendChild(applyEverything);\n\n    // Calques de texte, aucun par defaut, jusqu'a trois par image (2026-09-01).\n    var layerList = document.createElement(\"div\");\n    layerList.className = \"layer-list\";\n    controls.appendChild(layerList);\n\n    var addLayerBtn = document.createElement(\"button\");\n    addLayerBtn.type = \"button\";\n    addLayerBtn.className = \"add-layer\";\n    controls.appendChild(addLayerBtn);\n\n    var layerReadouts = [];\n\n    function refreshOverlay() {\n      // Redessine TOUS les calques de l'image, et met a jour les mentions de\n      // taille ajustee. La taille demandee reste un point de depart : c'est la\n      // taille effective, celle qui tient dans le cadre, qui est affichee et\n      // copiee.\n      var canvas = canvasSize();\n      overlayHost.innerHTML = \"\";\n      img.textLayers.forEach(function (layer) {\n        var effective = layer.value\n          ? fitTextSize(layer.value, layer.font, layer.weight, layer.anchor, layer.sizePx, canvas.w, canvas.h)\n          : layer.sizePx;\n        layer.effectiveSizePx = effective;\n        if (!layer.value.trim()) return;\n        var parts = layer.anchor.split(\"-\");\n        var el = document.createElement(\"div\");\n        el.className = \"text-overlay shown font-\" + layer.font +\n          \" anchor-v-\" + parts[0] + \" anchor-h-\" + parts[1];\n        el.style.color = layer.color;\n        el.style.fontWeight = layer.weight;\n        el.style.fontSize = (effective / canvas.w * 100) + \"cqw\";\n        el.textContent = layer.value;\n        overlayHost.appendChild(el);\n      });\n      layerReadouts.forEach(function (entry) {\n        var layer = img.textLayers[entry.index];\n        if (!layer) return;\n        var adjusted = layer.effectiveSizePx !== layer.sizePx;\n        entry.node.textContent = adjusted\n          ? (\"affiché \" + layer.effectiveSizePx + \"px (ajusté pour tenir dans le cadre)\")\n          : \"\";\n        entry.node.classList.toggle(\"adjusted\", adjusted);\n      });\n    }\n\n    function buildLayerPanel() {\n      layerList.innerHTML = \"\";\n      layerReadouts = [];\n      img.textLayers.forEach(function (layer, index) {\n        var block = document.createElement(\"div\");\n        block.className = \"layer-block\";\n\n        var head = document.createElement(\"div\");\n        head.className = \"layer-head\";\n        var idx = document.createElement(\"span\");\n        idx.className = \"idx\";\n        idx.textContent = \"T\" + (index + 1);\n        var title = document.createElement(\"span\");\n        title.textContent = \"Texte\";\n        var remove = document.createElement(\"button\");\n        remove.type = \"button\";\n        remove.textContent = \"Supprimer\";\n        remove.addEventListener(\"click\", function () {\n          img.textLayers.splice(index, 1);\n          buildLayerPanel();\n          refreshOverlay();\n        });\n        head.appendChild(idx); head.appendChild(title); head.appendChild(remove);\n        block.appendChild(head);\n\n        var textInput = document.createElement(\"input\");\n        textInput.type = \"text\";\n        textInput.placeholder = \"Texte à poser sur la photo…\";\n        textInput.value = layer.value;\n        textInput.addEventListener(\"input\", function () {\n          layer.value = textInput.value; refreshOverlay();\n        });\n        block.appendChild(textInput);\n\n        var row2 = document.createElement(\"div\");\n        row2.className = \"row2\";\n        var fontSelect = document.createElement(\"select\");\n        [\"serif\", \"sans\"].forEach(function (v) {\n          var o = document.createElement(\"option\"); o.value = v;\n          o.textContent = v === \"serif\" ? \"Serif\" : \"Sans\";\n          fontSelect.appendChild(o);\n        });\n        fontSelect.value = layer.font;\n        fontSelect.addEventListener(\"change\", function () {\n          layer.font = fontSelect.value; refreshOverlay();\n        });\n        var weightSelect = document.createElement(\"select\");\n        WEIGHTS.forEach(function (w) {\n          var o = document.createElement(\"option\"); o.value = w[0]; o.textContent = w[1];\n          weightSelect.appendChild(o);\n        });\n        weightSelect.value = String(layer.weight);\n        weightSelect.addEventListener(\"change\", function () {\n          layer.weight = parseInt(weightSelect.value, 10); refreshOverlay();\n        });\n        row2.appendChild(fontSelect); row2.appendChild(weightSelect);\n        block.appendChild(row2);\n\n        var sizeRow = document.createElement(\"div\");\n        sizeRow.className = \"size-row\";\n        var sizeInput = document.createElement(\"input\");\n        sizeInput.type = \"number\";\n        sizeInput.min = String(MIN_SIZE_PX);\n        sizeInput.max = \"4000\";\n        sizeInput.step = \"2\";\n        sizeInput.value = String(layer.sizePx);\n        sizeInput.addEventListener(\"input\", function () {\n          var v = parseFloat(sizeInput.value);\n          if (!isFinite(v) || v <= 0) return;\n          layer.sizePx = v; refreshOverlay();\n        });\n        var sizeUnit = document.createElement(\"span\");\n        sizeUnit.textContent = \"px\";\n        sizeUnit.style.color = \"var(--muted)\";\n        sizeUnit.style.fontSize = \"11px\";\n        var sizeEffective = document.createElement(\"span\");\n        sizeEffective.className = \"size-effective\";\n        layerReadouts.push({ index: index, node: sizeEffective });\n        sizeRow.appendChild(sizeInput); sizeRow.appendChild(sizeUnit); sizeRow.appendChild(sizeEffective);\n        block.appendChild(sizeRow);\n\n        var swatches = document.createElement(\"div\");\n        swatches.className = \"swatches\";\n        var yellowSwatch = document.createElement(\"div\");\n        yellowSwatch.className = \"swatch yellow\" + (layer.color === \"#f6cf47\" ? \" active\" : \"\");\n        yellowSwatch.title = \"Jaune #f6cf47\";\n        var whiteSwatch = document.createElement(\"div\");\n        whiteSwatch.className = \"swatch white\" + (layer.color === \"#ffffff\" ? \" active\" : \"\");\n        whiteSwatch.title = \"Blanc #ffffff\";\n        yellowSwatch.addEventListener(\"click\", function () {\n          layer.color = \"#f6cf47\";\n          yellowSwatch.classList.add(\"active\"); whiteSwatch.classList.remove(\"active\");\n          refreshOverlay();\n        });\n        whiteSwatch.addEventListener(\"click\", function () {\n    if font_key == \"sans\":\n        font = ImageFont.truetype(SANS_FONT_FILE, size)\n        try:\n            font.set_variation_by_axes([weight])\n        except Exception:\n            pass\n        return font\n    nearest = min(SERIF_FONT_FILES, key=lambda w: abs(w - weight))\n    return ImageFont.truetype(SERIF_FONT_FILES[nearest], size)\n\n\ndef position_for(bbox, h_anchor, v_anchor, canvas_w, canvas_h, margin_x, margin_y):\n    text_w, text_h = bbox[2] - bbox[0], bbox[3] - bbox[1]\n    if h_anchor == \"left\":\n        x = margin_x - bbox[0]\n    elif h_anchor == \"right\":\n        x = canvas_w - margin_x - text_w - bbox[0]\n    else:\n        x = (canvas_w - text_w) / 2 - bbox[0]\n    if v_anchor == \"top\":\n        y = margin_y - bbox[1]\n    elif v_anchor == \"middle\":\n        y = (canvas_h - text_h) / 2 - bbox[1]\n    else:\n        y = canvas_h - margin_y - text_h - bbox[1]\n    return x, y\n\n\ndef draw_caption(canvas, cfg, canvas_w, canvas_h):\n    value = (cfg.get(\"value\") or \"\").strip()\n    if not value:\n        return canvas\n    font_key = cfg.get(\"font\", \"serif\")\n    weight = int(cfg.get(\"weight\", 400))\n    color = cfg.get(\"color\", \"#f6cf47\")\n    v_anchor, h_anchor = (cfg.get(\"anchor\") or \"bottom-center\").split(\"-\")\n    margin_x, margin_y = canvas_w * 0.06, canvas_h * 0.06\n    max_width = canvas_w * 0.88\n\n    # La taille venue du navigateur est un point de depart : on refait l'ajustement\n    # cote Python, dont les metriques different legerement, pour garantir que le\n    # texte ne sorte JAMAIS du cadre dans le fichier livre.\n    font_size = round(cfg.get(\"size_px\") or cfg.get(\"requested_size_px\") or 200)\n    probe = ImageDraw.Draw(canvas)\n\n    def fits(bbox):\n        if (bbox[2] - bbox[0]) > max_width:\n            return False\n        x, y = position_for(bbox, h_anchor, v_anchor, canvas_w, canvas_h, margin_x, margin_y)\n        return (x + bbox[0] >= 0 and y + bbox[1] >= 0\n                and x + bbox[2] <= canvas_w and y + bbox[3] <= canvas_h)\n\n    font = load_font(font_key, weight, font_size)\n    bbox = probe.textbbox((0, 0), value, font=font)\n    while not fits(bbox) and font_size > MIN_FONT_SIZE_PX:\n        font_size -= 2\n        font = load_font(font_key, weight, font_size)\n        bbox = probe.textbbox((0, 0), value, font=font)\n\n    x, y = position_for(bbox, h_anchor, v_anchor, canvas_w, canvas_h, margin_x, margin_y)\n\n    canvas = canvas.convert(\"RGBA\")\n    shadow = Image.new(\"RGBA\", canvas.size, (0, 0, 0, 0))\n    ImageDraw.Draw(shadow).text((x, y), value, font=font, fill=(0, 0, 0, 200))\n    shadow = shadow.filter(ImageFilter.GaussianBlur(canvas_w * 0.004))\n    canvas = Image.alpha_composite(canvas, shadow)\n    ImageDraw.Draw(canvas).text((x, y), value, font=font, fill=color)\n    return canvas.convert(\"RGB\")\n\n\n# ---------------------------------------------------------------- cook\n\ndef main():\n    index = json.loads((HERE / \"_index.json\").read_text())\n    params_path = HERE / \"_params.json\"\n    if not params_path.exists():\n        raise SystemExit(\n            \"_params.json manquant : coller ici le JSON rendu par le bouton \"\n            \"« Copier TOUT (ordre + réglages) » de index.html\"\n        )\n    params = json.loads(params_path.read_text())\n    by_id = {img[\"id\"]: img for img in index[\"images\"]}\n\n    order = params[\"order\"]\n    images = params[\"images\"]\n    known, given = set(by_id), set(order)\n    assert given == known, (\n        f\"l'ordre doit citer exactement les {len(known)} id de _index.json ; \"\n        f\"manquants={sorted(known - given)} en trop={sorted(given - known)}\"\n    )\n\n    OUT_DIR.mkdir(exist_ok=True)\n    written = []\n    for position, image_id in enumerate(order, start=1):\n        entry = by_id[image_id]\n        spec = images[image_id]\n        src_path = Path(entry[\"path\"])\n        if not src_path.exists():\n            src_path = SOURCE_DIR / entry[\"file\"]\n        assert src_path.exists(), f\"source introuvable : {src_path}\"\n\n        image = ImageOps.exif_transpose(Image.open(src_path)).convert(\"RGB\")\n\n        # CADRAGE d'abord, exactement la meme chaine que l'apercu : une seule\n        # transformation affine source -> canevas cible. Sans format demande, ou\n        # avec un cadrage neutre, l'image passe telle quelle.\n        crop = spec.get(\"crop\") or {}\n        fmt = params.get(\"format\")\n        if fmt:\n            canvas_w = fmt[\"w\"] * fmt[\"factor\"]\n            canvas_h = fmt[\"h\"] * fmt[\"factor\"]\n            coeffs = affine_coeffs(\n                image.width, image.