axis=-1)\n    minimum = np.min(color, axis=-1)\n    delta = maximum - minimum\n    epsilon = 1.0e-10\n\n    hue = np.zeros_like(maximum)\n    mask = delta > epsilon\n    with np.errstate(invalid=\"ignore\", divide=\"ignore\"):\n        red_max = mask & (maximum == r)\n        green_max = mask & (maximum == g) & ~red_max\n        blue_max = mask & ~red_max & ~green_max\n        hue[red_max] = ((g - b)[red_max] / delta[red_max]) % 6.0\n        hue[green_max] = ((b - r)[green_max] / delta[green_max]) + 2.0\n        hue[blue_max] = ((r - g)[blue_max] / delta[blue_max]) + 4.0\n    hue = hue / 6.0\n    saturation = np.where(maximum > epsilon, delta / (maximum + epsilon), 0.0)\n    return np.stack([hue, saturation, maximum], axis=-1)\n\n\ndef hsv_to_rgb(color):\n    h, s, v = color[..., 0], color[..., 1], color[..., 2]\n    p = np.abs(((h[..., None] + np.array([0.0, 0.6666667, 0.3333333], dtype=np.float32)) % 1.0) * 6.0 - 3.0)\n    return (v[..., None] * (1.0 + s[..., None] * (np.clip(p - 1.0, 0.0, 1.0) - 1.0))).astype(np.float32)\n\n\ndef hue_distance(a, b):\n    difference = np.abs(a - b)\n    return np.minimum(difference, 1.0 - difference)\n\n\ndef adjust_saturation(color, amount):\n    gray = luma(color)[..., None]\n    factor = max(0.0, 1.0 + amount)\n    return gray + (color - gray) * factor\n\n\ndef apply_preset(color, filter_id):\n    gray = luma(color)[..., None]\n    if filter_id == 1:\n        return adjust_saturation((color - 0.5) * 1.08 + 0.5, 0.20)\n    if filter_id == 2:\n        return adjust_saturation((color - 0.5) * 1.07 + 0.5 + np.array([0.035, 0.012, -0.025], dtype=np.float32), 0.18)\n    if filter_id == 3:\n        return adjust_saturation((color - 0.5) * 1.07 + 0.5 + np.array([-0.025, 0.005, 0.035], dtype=np.float32), 0.18)\n    if filter_id == 4:\n        return adjust_saturation((color - 0.5) * 1.22 + 0.5, -0.08)\n    if filter_id == 5:\n        return adjust_saturation((color - 0.5) * 1.21 + 0.5 + np.array([0.045, 0.012, -0.035], dtype=np.float32), -0.05)\n    if filter_id == 6:\n        return adjust_saturation((color - 0.5) * 1.21 + 0.5 + np.array([-0.035, 0.004, 0.045], dtype=np.float32), -0.05)\n    if filter_id == 7:\n        return np.repeat(gray, 3, axis=-1)\n    if filter_id == 8:\n        return np.repeat(gray, 3, axis=-1) * np.array([1.06, 1.02, 0.92], dtype=np.float32) \\\n            + np.array([0.015, 0.01, 0.0], dtype=np.float32)\n    if filter_id == 9:\n        return np.repeat(smoothstep(0.18, 0.82, gray), 3, axis=-1)\n    return color\n\n\n# ------------------------------------------------------------- chaine photo\n\ndef apply_photo(image, photo):\n    \"\"\"Rejoue la chaine du shader sur un tableau HxWx3 en float32 (0..1).\"\"\"\n    if photo is None:\n        return image\n\n    def pct(key, default=0.0):\n        return float(photo.get(key, default)) / 100.0\n\n    levels = photo.get(\"levels\") or {}\n    color = image\n\n    # 1. Levels\n    input_black = float(levels.get(\"inputBlack\", 0)) / 100.0\n    midtone = float(levels.get(\"midtone\", 50)) / 100.0\n    input_white = max(input_black + 0.001, float(levels.get(\"inputWhite\", 100)) / 100.0)\n    output_black = float(levels.get(\"outputBlack\", 0)) / 100.0\n    output_white = float(levels.get(\"outputWhite\", 100)) / 100.0\n    color = np.clip((color - input_black) / (input_white - input_black), 0.0, 1.0)\n    gamma = 2.0 ** ((0.5 - midtone) * 3.0)\n    color = np.power(np.maximum(color, 1e-5), gamma)\n    color = output_black + (output_white - output_black) * color\n\n    # 2. Selective Color\n    selective = photo.get(\"selective\") or []\n    if any(any(float(channel.get(k, 0)) for k in (\"hue\", \"saturation\", \"luminance\")) for channel in selective):\n        hsv = rgb_to_hsv(color)\n        for index, center in enumerate(SELECTIVE_CENTERS):\n            channel = selective[index] if index < len(selective) else {}\n            hue_amount = float(channel.get(\"hue\", 0)) / 100.0\n            sat_amount = float(channel.get(\"