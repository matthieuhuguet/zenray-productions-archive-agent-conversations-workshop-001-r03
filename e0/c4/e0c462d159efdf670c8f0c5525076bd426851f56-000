m: 5px; }\n  .anchor-widget {\n    display: grid; grid-template-columns: repeat(3, 18px); grid-template-rows: repeat(3, 18px);\n    gap: 3px;\n  }\n  .anchor-widget[data-mode=\"3\"] { grid-template-columns: 18px; }\n  .anchor-widget[data-mode=\"3\"] button[data-anchor$=\"-left\"],\n  .anchor-widget[data-mode=\"3\"] button[data-anchor$=\"-right\"] { display: none; }\n  .anchor-widget button {\n    width: 18px; height: 18px; padding: 0; border-radius: 4px;\n    border: 1px solid rgba(255,255,255,.16); background: #0f0f11; cursor: pointer;\n  }\n  .anchor-widget button.active { background: var(--accent); border-color: var(--accent); }\n\n  .card-actions { display: flex; align-items: center; gap: 8px; }\n  button.copy {\n    flex: 0 0 auto; background: transparent; color: var(--accent);\n    border: 1px solid var(--accent); border-radius: 7px; padding: 7px 12px;\n    font: 600 11.5px inherit; cursor: pointer;\n  }\n  button.copy:active { transform: translateY(1px); }\n  .copy-echo {\n    flex: 1; min-width: 0; font: 500 10.5px ui-monospace, \"AnthropicMono\", monospace;\n    color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;\n  }\n  .copy-echo.done { color: var(--accent); }\n\n  footer {\n    padding: 10px 22px 34px; color: var(--muted); font-size: 11px;\n  }\n</style>\n</head>\n<body>\n\n<header class=\"top\">\n  <h1>zenray-html-hda · <span id=\"projectLabel\"></span></h1>\n  <span class=\"sub\" id=\"countLabel\">9 photos</span>\n\n  <div class=\"field\">\n    <label for=\"fmtSelect\">Format</label>\n    <select id=\"fmtSelect\"></select>\n  </div>\n  <span class=\"sub\" id=\"resLabel\"></span>\n\n  <div class=\"spacer\"></div>\n  <button class=\"primary\" id=\"copyAllBtn\">Copier TOUT (9 photos)</button>\n\n  <div class=\"batch-out\" id=\"batchOut\">\n    <textarea id=\"batchText\" readonly></textarea>\n  </div>\n</header>\n\n<main id=\"grid\"></main>\n\n<footer>\n  Cadre = format cible (object-fit: cover). Zoom &gt; 1 grossit au-delà de la\n  couverture minimale ; X et Y déplacent la zone gardée ; Rotation redresse\n  l'horizon (comme Straighten dans Photos), le cadre se regonfle tout seul\n  pour ne jamais laisser un coin transparent. Texte optionnel, désactivé par\n  défaut, avec sa propre ancre (3 positions en portrait ou carré, 9 en\n  horizontal), 7 graisses réelles de Light à Black, et une taille demandée en\n  px : si le texte ne tient pas dans le cadre à cette taille, il rétrécit\n#!/usr/bin/env python3\n\"\"\"Cree une instance d'outil zenray-html-hda depuis un gabarit, sans regenerer\nune seule ligne de HTML.\n\nPourquoi ce script existe. Les premieres instances ont ete ecrites a la main,\nliste d'images comprise, ce qui coutait plus de 30 000 tokens et plusieurs\nminutes par projet. C'etait une faute HDA : la definition (le gabarit) doit\netre unique, et le projet ne doit etre qu'un jeu de parametres. Ici, le seul\nbloc qui depend du projet est `@zr-instance` dans le HTML, et ce script l'ecrit.\n\nUsage\n    zr-hda-instance.py <dossier-images> [--mode light|heavy] [--project NOM]\n                       [--format 4:5] [--dest DOSSIER] [--open] [--force]\n\nExemples\n    # Cadrage d'un lot de photos, format 4:5, ouverture dans Chrome\n    zr-hda-instance.py ~/Downloads/mon-post --open\n\n    # Retouche + reorder d'un out/ deja cadre (poupee russe)\n    zr-hda-instance.py ~/Downloads/mon-post/zenray-html-hda-mon-post/out \\\\\n        --mode heavy --open\n\"\"\"\nimport argparse\nimport json\nimport os\nimport re\nimport shutil\nimport subprocess\nimport sys\nfrom datetime import datetime\nfrom pathlib import Path\n\nSKILL = Path(__file__).resolve().parent.parent\nTEMPLATES = SKILL / \"templates\"\nINSTANCES_INDEX = SKILL / \"instances\" / \"INDEX.md\"\n\nIMAGE_SUFFIXES = {\".jpg\", \".jpeg\", \".png\", \".webp\", \".tif\", \".tiff\", \".heic\", \".JPG\", \".JPEG\", \".PNG\"}\nFORMATS = {\"4:5\", \"1:1\", \"9:16\", \"16:9\", \"1:2\", \"3:4\", \"2:3\", \"4:3\", \"source\"}\nFORMAT_RATIOS = {\n    \"4:5\": 0.8, \"1:1\": 1.0, \"9:16\": 0.5625, \"16:9\": 1.7778,\n    \"1:2\": 0.5, \"3:4\": 0.75, \"2:3\": 0.6667, \"4:3\": 1.3333,\n}\n\n\ndef measure(path):\n    \"\"\"Dimensions en pixels. Pillow si dispo, sinon `sips`, natif macOS.\"\"\"\n    try:\n        from PIL import Image\n        with Image.open(path) as im:\n            return im.size\n    except Exception:\n        try:\n            out = subprocess.run([\"sips\", \"-g\", \"pixelWidth\", \"-g\", \"pixelHeight\", str(path)],\n                                 capture_output=True, text=True, check=True).stdout\n            w = int(re.search(r\"pixelWidth:\\s*(\\d+)\", out).group(1))\n            h = int(re.search(r\"pixelHeight:\\s*(\\d+)\", out).group(1))\n            return w, h\n        except Exception:\n            return 0, 0\n\n\ndef build_previews(images, dest, max_width=1400, quality=82):\n    \"\"\"Ecrit `_previews.js`, un dictionnaire id -> data URI JPEG reduite.\n\n    Pourquoi c'est indispensable et pas un confort. WebGL REFUSE une texture\n    issue d'une origine opaque, ce qu'est tout fichier ouvert en `file://` : le\n    cadre central du mode heavy restait noir alors que les vignettes (de\n    simples `<img>`, qui n'ont pas cette restriction) s'affichaient. Servir en\n    localhost reglait le probleme mais ajoutait une dependance fragile, un\n    process qui doit tourner ; des qu'il s'arrete, l'outil redevient noir. Une\n    data URI, elle, est TOUJOURS same-origin : l'instance fonctionne alors en\n    double-cliquant le fichier, sans serveur, sans reseau, definitivement.\n\n    L'apercu est reduit a `max_width` : l'ecran n'affiche jamais plus de\n    quelques centaines de pixels, et le cook Python travaille de toute facon\n    sur les ORIGINAUX pleine resolution lus depuis `_index.json`. La qualite\n    finale n'est donc pas affectee, seul le poids du HTML l'est.\n    \"\"\"\n    from base64 import b64encode\n    from io import BytesIO\n\n    try:\n        from PIL import Image, ImageOps\n    except ImportError:\n        print(\"Pillow absent : previews non embarquees, le mode heavy exigera un service local\")\n        return None\n\n    entries = []\n    total = 0\n    for image in images:\n        with Image.open(image[\"path\"]) as raw:\n            preview = ImageOps.exif_transpose(raw).convert(\"RGB\")\n        if preview.width > max_width:\n            height = round(preview.height * max_width / preview.width)\n            preview = preview.resize((max_width, height), Image.LANCZOS)\n        buffer = BytesIO()\n        preview.save(buffer, \"JPEG\", quality=quality, optimize=True)\n        payload = b64encode(buffer.getvalue()).decode(\"ascii\")\n        total += len(payload)\n        entries.append(f'  \"{image[\"id\"]}\": \"data:image/jpeg;base64,{payload}\"')\n\n    body = \",\\n\".join(entries)\n    (dest / \"_previews.js\").write_text(\n        \"// Apercus embarques, generes par zr-hda-instance.py.\\n\"\n        \"// Une data URI est same-origin : WebGL l'accepte meme en file://, ce qu'il\\n\"\n        \"// refuse pour un fichier local. C'est ce qui rend l'instance autonome.\\n\"\n        \"// Le rendu FINAL n'utilise jamais ces apercus : le cook lit les originaux.\\n\"\n        f\"window.ZR_PREVIEWS = {{\\n{body}\\n}};\\n\"\n    )\n    return total\n\n\ndef collect_images(source_dir):\n    files = sorted(\n        (p for p in source_dir.iterdir()\n         if p.is_file() and p.suffix in IMAGE_SUFFIXES and not p.name.startswith(\".\")),\n        key=lambda p: p.name.lower(),\n    )\n    images = []\n    for position, path in enumerate(files, start=1):\n        width, height = measure(path)\n        images.append({\n            \"id\": f\"{position:02d}\",\n            \"file\": path.name,\n            \"path\": str(path),\n            \"width\": width,\n            \"height\": height,\n        })\n    return images\n\n\ndef render_template(mode, dest, project, source_dir, images, target_format):\n    template_dir = TEMPLATES / f\"hda-{mode}\"\n    if not template_dir.is_dir():\n        raise SystemExit(f\"gabarit introuvable : {template_dir}\")\n\n    dest.mkdir(parents=True, exist_ok=True)\n    for item in template_dir.iterdir():\n        target = dest / item.name\n        if item.is_dir():\n            shutil.copytree(item, target, dirs_exist_ok=True)\n        else:\n            shutil.copy2(item, target)\n\n    html_path = dest / \"index.html\"\n    html = html_path.read_text()\n\n    # Le JS porte l'id, le nom ET les dimensions REELLES de l'original : ce sont\n    # elles qui servent a l'auto-fit du texte et au choix du nombre d'ancres,\n    # jamais celles de l'apercu reduit, sans quoi une taille en px annoncee ne\n    # correspondrait pas au JPEG final.\n    light_images = [\n        {\"id\": i[\"id\"], \"file\": i[\"file\"], \"w\": i[\"width\"], \"h\": i[\"height\"]}\n        for i in images\n    ]\n    payload = json.dumps(light_images, indent=4, ensure_ascii=False)\n    payload = payload.replace(\"\\n\", \"\\n  \")\n\n    # Chemin RELATIF, jamais `file://` absolu. Deux raisons, la seconde est\n    # bloquante : un chemin relatif marche aussi bien en file:// qu'en http, et\n    # surtout WebGL REFUSE une texture issue d'une origine opaque, ce qu'est\n    # tout fichier ouvert en file://. Avec `file://`, le canvas du mode heavy\n    # restait vide alors que les vignettes s'affichaient (elles, ne passent pas\n    # par texImage2D). En relatif plus service local, tout est same-origin.\n    relative = os.path.relpath(source_dir, dest)\n    substitutions = {\n        \"__ZR_PROJECT__\": project,\n        \"__ZR_SOURCE_DIR__\": relative.rstrip(\"/\") + \"/\",\n        \"__ZR_IMAGES__\": payload,\n        \"__ZR_DEFAULT_FORMAT__\": target_format,\n    }\n    for key, value in substitutions.items():\n        html = html.replace(key, value)\n\n    leftover = sorted(set(re.findall(r\"__ZR_[A-Z_]+__\", html)))\n    if leftover:\n        raise SystemExit(f\"parametres non substitues : {leftover}\")\n    html_path.write_text(html)\n\n    (dest / \"_index.json\").write_text(json.dumps(\n        {\"dossier_source\": str(source_dir), \"images\": images}, indent=2, ensure_ascii=False) + \"\\n\")\n\n    # Le mode heavy lit des pixels (WebGL), donc il lui faut des apercus\n    # same-origin pour fonctionner en file://. Le light n'affiche que des\n    # `<img>`, qui n'ont pas cette restriction : inutile de l'alourdir.\n    if mode == \"heavy\":\n        weight = build_previews(images, dest)\n        if weight:\n            print(f\"apercus embarques : {weight / 1_048_576:.1f} Mo en data URI, \"\n                  f\"l'instance fonctionne sans serveur\")\n    return html_path\n\n\ndef register(dest, mode, project, count, source_dir):\n    INSTANCES_INDEX.parent.mkdir(parents=True, exist_ok=True)\n    if not INSTANCES_INDEX.exists():\n        INSTANCES_INDEX.write_text(\n            \"# Instances zenray-html-hda\\n\\n\"\n            \"Registre append-only des outils crees depuis `templates/`. Une ligne par\\n\"\n            \"instance : la relire coute quelques dizaines de tokens, la recreer a la main\\n\"\n            \"en coutait plus de trente mille.\\n\\n\"\n            \"| Date | Mode | Projet | Images | Dossier |\\n\"\n            \"|---|---|---|---|---|\\n\"\n        )\n    stamp = datetime.now().strftime(\"%Y-%m-%d %H:%M\")\n    line = f\"| {stamp} | {mode} | {project} | {count} | `{dest}` |\\n\"\n    with INSTANCES_INDEX.open(\"a\") as handle:\n        handle.write(line)\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"Cree une instance d'outil zenray-html-hda.\")\n    parser.add_argument(\"source\", type=Path, help=\"dossier contenant les images\")\n    parser.add_argument(\"--mode\", choices=(\"light\", \"heavy\"), default=\"light\",\n                        help=\"light = cadrage et texte ; heavy = reorder, photo et texte\")\n    parser.add_argument(\"--project\", default=None, help=\"nom parlant (defaut : nom du dossier source)\")\n    parser.add_argument(\"--format\", dest=\"target_format\", default=\"4:5\", choices=sorted(FORMATS),\n                        help=\"format cible du mode light (defaut 4:5)\")\n    parser.add_argument(\"--dest\", type=Path, default=None, help=\"dossier de l'instance\")\n    parser.add_argument(\"--open\", action=\"store_true\", help=\"ouvrir dans Chrome une fois cree\")\n    parser.add_argument(\"--serve\", action=\"store_true\",\n                        help=\"forcer le service local (automatique en mode heavy, que WebGL impose)\")\n    parser.add_argument(\"--force\", action=\"store_true\", help=\"ecraser une instance existante\")\n    args = parser.parse_args()\n    args.format_given = any(a.startswith(\"--format\") for a in sys.argv[1:])\n\n    source_dir = args.source.expanduser().resolve()\n    if not source_dir.is_dir():\n        raise SystemExit(f\"dossier source introuvable : {source_dir}\")\n\n    project = args.project or source_dir.name\n    dest = (args.dest.expanduser().resolve() if args.dest\n            else source_dir / f\"zenray-html-hda-{project}\")\n    if args.mode == \"heavy\" and not args.dest:\n        dest = source_dir / f\"zenray-html-hda-{project}-heavy\"\n\n    if dest.exists() and not args.force:\n        raise SystemExit(f\"l'instance existe deja : {dest}\\nrelancer avec --force pour l'ecraser\")\n\n    images = collect_images(source_dir)\n","stderr":"","aggregated_output":"(function () {\n  \"use strict\";\n\n  const DEFAULTS = Object.freeze({\n    vignette: 0,\n    selective: [\n      { hue: 0, saturation: 0, luminance: 0 },\n      { hue: 0, saturation: 0, luminance: 0 },\n      { hue: 0, saturation: 0, luminance: 0 },\n      { hue: 0, saturation: 0, luminance: 0 },\n      { hue: 0, saturation: 0, luminance: 0 },\n      { hue: 0, saturation: 0, luminance: 0 }\n    ],\n    levels: { inputBlack: 0, midtone: 50, inputWhite: 100, outputBlack: 0, outputWhite: 100 },\n    blackAndWhite: 0,\n    saturation: 0,\n    vibrance: 0,\n    brilliance: 0,\n    exposure: 0,\n    highlights: 0,\n    shadows: 0,\n    brightness: 0,\n    contrast: 0,\n    blackPoint: 0,\n    filter: \"Original\",\n    filterStrength: 100\n  });\n\n  const FILTERS = Object.freeze([\n    \"Original\",\n    \"Vivid\",\n    \"Vivid Warm\",\n    \"Vivid Cool\",\n    \"Dramatic\",\n    \"Dramatic Warm\",\n    \"Dramatic Cool\",\n    \"Mono\",\n    \"Silvertone\",\n    \"Noir\"\n  ]);\n\n  const VERTEX_SHADER = `#version 300 es\n    in vec2 a_position;\n    out vec2 v_uv;\n    void main() {\n      v_uv = a_position * 0.5 + 0.5;\n      gl_Position = vec4(a_position, 0.0, 1.0);\n    }\n  `;\n\n  const FRAGMENT_SHADER = `#version 300 es\n    precision highp float;\n    uniform sampler2D u_image;\n    uniform float u_vignette;\n    uniform vec3 u_selective[6];\n    uniform vec4 u_levels;\n    uniform float u_outputWhite;\n    uniform float u_blackAndWhite;\n    uniform float u_saturation;\n    uniform float u_vibrance;\n    uniform vec4 u_lightA;\n    uniform vec3 u_lightB;\n    uniform int u_filter;\n    uniform float u_filterStrength;\n    in vec2 v_uv;\n    out vec4 outColor;\n\n    float luma(vec3 color) {\n      return dot(color, vec3(0.2126, 0.7152, 0.0722));\n    }\n\n    vec3 rgbToHsv(vec3 color) {\n      vec4 k = vec4(0.0, -0.3333333333, 0.6666666667, -1.0);\n      vec4 p = mix(vec4(color.bg, k.wz), vec4(color.gb, k.xy), step(color.b, color.g));\n      vec4 q = mix(vec4(p.xyw, color.r), vec4(color.r, p.yzx), step(p.x, color.r));\n      float d = q.x - min(q.w, q.y);\n      float e = 1.0e-10;\n      return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);\n    }\n\n    vec3 hsvToRgb(vec3 color) {\n      vec3 p = abs(fract(color.xxx + vec3(0.0, 0.6666666667, 0.3333333333)) * 6.0 - 3.0);\n      return color.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), color.y);\n    }\n\n    float hueDistance(float a, float b) {\n      float difference = abs(a - b);\n      return min(difference, 1.0 - difference);\n    }\n\n    vec3 applySelective(vec3 color) {\n      vec3 hsv = rgbToHsv(color);\n      float centers[6] = float[6](0.0, 0.1666667, 0.3333333, 0.5, 0.6666667, 0.8333333);\n      for (int index = 0; index < 6; index++) {\n        float weight = smoothstep(0.19, 0.0, hueDistance(hsv.x, centers[index])) * smoothstep(0.05, 0.25, hsv.y);\n        hsv.x = fract(hsv.x + u_selective[index].x * weight * 0.12 + 1.0);\n        hsv.y = clamp(hsv.y + u_selective[index].y * weight * 0.55, 0.0, 1.0);\n        hsv.z = clamp(hsv.z + u_selective[index].z * weight * 0.38, 0.0, 1.0);\n      }\n      return hsvToRgb(hsv);\n    }\n\n    vec3 adjustSaturation(vec3 color, float amount) {\n      float gray = luma(color);\n      return mix(vec3(gray), color, max(0.0, 1.0 + amount));\n    }\n\n    vec3 preset(vec3 color, int filterId) {\n      float gray = luma(color);\n      if (filterId == 1) return adjustSaturation((color - 0.5) * 1.08 + 0.5, 0.20);\n      if (filterId == 2) return adjustSaturation((color - 0.5) * 1.07 + 0.5 + vec3(0.035, 0.012, -0.025), 0.18);\n      if (filterId == 3) return adjustSaturation((color - 0.5) * 1.07 + 0.5 + vec3(-0.025, 0.005, 0.035), 0.18);\n      if (filterId == 4) return adjustSaturation((color - 0.5) * 1.22 + 0.5, -0.08);\n      if (filterId == 5) return adjustSaturation((color - 0.5) * 1.21 + 0.5 + vec3(0.045, 0.012, -0.035), -0.05);\n      if (filterId == 6) return adjustSaturation((color - 0.5) * 1.21 + 0.5 + vec3(-0.035, 0.004, 0.045), -0.05);\n      if (filterId == 7) return vec3(gray);\n      if (filterId == 8) return vec3(gray) * vec3(1.06, 1.02, 0.92) + vec3(0.015, 0.01, 0.0);\n      if (filterId == 9) {\n        float noir = smoothstep(0.18, 0.82, gray);\n        return vec3(noir);\n      }\n      return color;\n    }\n\n    void main() {\n      vec2 textureUv = vec2(v_uv.x, 1.0 - v_uv.y);\n      vec3 source = texture(u_image, textureUv).rgb;\n      vec3 color = source;\n\n      float inputBlack = u_levels.x;\n      float midtone = u_levels.y;\n      float inputWhite = max(inputBlack + 0.001, u_levels.z);\n      float outputBlack = u_levels.w;\n      color = clamp((color - inputBlack) / (inputWhite - inputBlack), 0.0, 1.0);\n      float gamma = exp2((0.5 - midtone) * 3.0);\n      color = pow(max(color, vec3(0.00001)), vec3(gamma));\n      color = mix(vec3(outputBlack), vec3(u_outputWhite), color);\n\n      color = applySelective(color);\n\n      float brilliance = u_lightA.x;\n      float exposure = u_lightA.y;\n      float highlights = u_lightA.z;\n      float shadows = u_lightA.w;\n      float brightness = u_lightB.x;\n      float contrast = u_lightB.y;\n      float blackPoint = u_lightB.z;\n      float luminosity = luma(color);\n\n      color *= exp2(exposure * 2.0);\n      color += brilliance * (0.25 - pow(luminosity - 0.5, 2.0)) * 0.55;\n      color += highlights * smoothstep(0.45, 1.0, luminosity) * 0.32;\n      color += shadows * (1.0 - smoothstep(0.0, 0.55, luminosity)) * 0.32;\n      color += brightness * 0.30;\n      color = (color - 0.5) * (1.0 + contrast * 0.90) + 0.5;\n      color -= blackPoint * (1.0 - smoothstep(0.0, 0.55, luminosity)) * 0.35;\n\n      color = adjustSaturation(color, u_saturation * 0.85);\n      vec3 hsv = rgbToHsv(clamp(color, 0.0, 1.0));\n      float vibranceMask = 1.0 - hsv.y;\n      hsv.y = clamp(hsv.y + u_vibrance * vibranceMask * 0.75, 0.0, 1.0);\n      color = hsvToRgb(hsv);\n\n      color = mix(color, vec3(luma(color)), u_blackAndWhite);\n      color = mix(color, preset(color, u_filter), u_filterStrength);\n\n      float radius = distance(v_uv, vec2(0.5)) / 0.70710678;\n      float vignetteMask = smoothstep(0.34, 1.0, radius);\n      color *= 1.0 - vignetteMask * u_vignette * 0.78;\n      outColor = vec4(clamp(color, 0.0, 1.0), 1.0);\n    }\n  `;\n\n  function cloneDefaults() {\n    return JSON.parse(JSON.stringify(DEFAULTS));\n  }\n\n  function compile(gl, type, source) {\n    const shader = gl.createShader(type);\n    gl.shaderSource(shader, source);\n    gl.compileShader(shader);\n    if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {\n      const message = gl.getShaderInfoLog(shader);\n      gl.deleteShader(shader);\n      throw new Error(`Shader photo invalide : ${message}`);\n    }\n    return shader;\n  }\n\n  function program(gl) {\n    const result = gl.createProgram();\n    gl.attachShader(result, compile(gl, gl.VERTEX_SHADER, VERTEX_SHADER));\n    gl.attachShader(result, compile(gl, gl.FRAGMENT_SHADER, FRAGMENT_SHADER));\n    gl.linkProgram(result);\n    if (!gl.getProgramParameter(result, gl.LINK_STATUS)) {\n      const message = gl.getProgramInfoLog(result);\n      gl.deleteProgram(result);\n      throw new Error(`Pipeline photo invalide : ${message}`);\n    }\n    return result;\n  }\n\n  function percentage(value) {\n    return Number(value) / 100;\n  }\n\n  class ZRPhotoAdjustments {\n    constructor(canvas) {\n      if (!(canvas instanceof HTMLCanvasElement)) throw new TypeError(\"Un canvas HTML est requis\");\n      this.canvas = canvas;\n      this.gl = canvas.getContext(\"webgl2\", {\n        alpha: false,\n        antialias: false,\n        depth: false,\n        preserveDrawingBuffer: true,\n        premultipliedAlpha: false\n      });\n      if (!this.gl) throw new Error(\"WebGL 2 est requis pour les réglages photo\");\n      this.program = program(this.gl);\n      this.values = cloneDefaults();\n      this.texture = this.gl.createTexture();\n      this.ready = false;\n      this.locations = {};\n      this.setupGeometry();\n      this.setupTexture();\n    }\n\n    setupGeometry() {\n      const gl = this.gl;\n      gl.useProgram(this.program);\n#!/usr/bin/env python3\n# 2026-09-01, cook zenray-html-hda mode HEAVY : _index.json + _params.json -> JPEG finaux dans out/\n#\n# PORTAGE FIDELE du shader WebGL de `zr-photo-adjustments.js` en numpy. Le meme\n# ordre d'operations, les memes constantes et les memes formules, sinon l'apercu\n# du navigateur et le fichier livre divergent, ce qui viderait de son sens le\n# reglage a l'oeil. Ordre du shader, a ne jamais reordonner :\n#   levels -> selective color -> light -> saturation -> vibrance\n#   -> black and white -> filtre -> vignette -> clamp\n#\n# Le texte suit la meme chaine que `crop-apply.py` : police Serif/Sans, sept\n# graisses reelles, taille en px avec auto-fit qui ne depasse JAMAIS le cadre,\n# ancre haut/milieu/bas x gauche/centre/droite, jusqu'a trois calques par image.\n#\n# Les images sont ecrites sous `NN.jpg`, NN etant la position zero-completee de\n# 01 a 99 dans l'ordre choisi par glisser-deposer. Finder les trie automatiquement.\nimport json\nimport math\nimport sys\nfrom pathlib import Path\n\nimport numpy as np\nfrom PIL import Image, ImageDraw, ImageFilter, ImageFont, ImageOps\n\nHERE = Path(__file__).resolve().parent\nSOURCE_DIR = HERE.parent\nOUT_DIR = HERE / \"out\"\n\nSERIF_FONT_FILES = {\n    300: \"/Users/zenray/Library/Fonts/AnthropicSerif-Light.ttf\",\n    400: \"/Users/zenray/Library/Fonts/AnthropicSerif-Regular.ttf\",\n    500: \"/Users/zenray/Library/Fonts/AnthropicSerif-Medium.ttf\",\n    600: \"/Users/zenray/Library/Fonts/AnthropicSerif-SemiBold.ttf\",\n    700: \"/Users/zenray/Library/Fonts/AnthropicSerif-Bold.ttf\",\n    800: \"/Users/zenray/Library/Fonts/AnthropicSerif-ExtraBold.ttf\",\n    900: \"/Users/zenray/Library/Fonts/AnthropicSerif-Black.ttf\",\n}\nSANS_FONT_FILE = \"/Users/zenray/Library/Fonts/InterVariable.ttf\"\nMIN_FONT_SIZE_PX = 6\n\nFILTERS = [\n    \"Original\", \"Vivid\", \"Vivid Warm\", \"Vivid Cool\", \"Dramatic\",\n    \"Dramatic Warm\", \"Dramatic Cool\", \"Mono\", \"Silvertone\", \"Noir\",\n]\nLUMA = np.array([0.2126, 0.7152, 0.0722], dtype=np.float32)\nSELECTIVE_CENTERS = [0.0, 0.1666667, 0.3333333, 0.5, 0.6666667, 0.8333333]\n\n\n# ---------------------------------------------------------------- helpers GLSL\n\ndef smoothstep(edge0, edge1, x):\n    \"\"\"Equivalent exact de smoothstep GLSL, y compris quand edge0 > edge1.\"\"\"\n    t = np.clip((x - edge0) / (edge1 - edge0