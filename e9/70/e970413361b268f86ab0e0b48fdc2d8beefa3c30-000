\n        raise SystemExit(__doc__)\n    cmd = sys.argv[1]\n    try:\n        if cmd == \"ping\":\n            connexion(); print(\"VERT — l'éditeur Unreal répond sur\", URL); sys.exit(0)\n        if cmd == \"list\":\n            outils = appeler(\"tools/list\").get(\"tools\", [])\n            print(f\"{len(outils)} outils exposés\\n\")\n            for o in outils:\n                print(f\"  {o['name']:<38} {(o.get('description') or '').splitlines()[0][:96]}\")\n            sys.exit(0)\n        if cmd == \"toolsets\":\n            r = appeler(\"tools/call\", {\"name\": \"list_toolsets\", \"arguments\": {}})\n            print(\"\\n\".join(b.get(\"text\", \"\") for b in r.get(\"content\", []))); sys.exit(0)\n        if cmd == \"tools\":\n            # VUE COMPACTE, et c'est la raison d'être de cette commande : `describe_toolset` rend le\n            # schéma COMPLET de chaque outil, soit des dizaines de milliers de caractères pour un\n            # toolset ordinaire. Lire ça pour trouver un nom d'outil coûte un budget entier.\n            r = appeler(\"tools/call\", {\"name\": \"describe_toolset\",\n                                       \"arguments\": {\"toolset_name\": sys.argv[2]}})\n            d = json.loads(\"\".join(b.get(\"text\", \"\") for b in r.get(\"content\", [])))\n            outils = d.get(\"tools\", [])\n            print(f\"{len(outils)} outils dans {sys.argv[2]}\\n\")\n            for o in outils:\n                court = o[\"name\"].rsplit(\".\", 1)[-1]\n                prems = (o.get(\"description\") or \"\").strip().splitlines()\n                req = \", \".join((o.get(\"inputSchema\") or {}).get(\"required\", []))\n                print(f\"  {court:<32} ({req})\")\n                if prems:\n                    print(f\"      {prems[0][:100]}\")\n            sys.exit(0)\n        if cmd == \"toolschema\":\n            # Le schéma d'UN SEUL outil d'un toolset, quand on a besoin du détail des arguments.\n            r = appeler(\"tools/call\", {\"name\": \"describe_toolset\",\n                                       \"arguments\": {\"toolset_name\": sys.argv[2]}})\n            d = json.loads(\"\".join(b.get(\"text\", \"\") for b in r.get(\"content\", [])))\n            for o in d.get(\"tools\", []):\n                if o[\"name\"].rsplit(\".\", 1)[-1] == sys.argv[3] or o[\"name\"] == sys.argv[3]:\n                    print(json.dumps(o, indent=2, ensure_ascii=False)); sys.exit(0)\n            raise SystemExit(f\"ÉCHEC — outil introuvable dans {sys.argv[2]} : {sys.argv[3]}\")\n        if cmd == \"t\":\n            # Raccourci : appeler un outil DE TOOLSET sans retaper le nom complet du toolset.\n            args = json.loads(sys.argv[4]) if len(sys.argv) > 4 else {}\n            r = appeler(\"tools/call\", {\"name\": \"call_tool\", \"arguments\": {\n                \"toolset_name\": sys.argv[2], \"tool_name\": sys.argv[3], \"arguments\": args}})\n            for bloc in r.get(\"content\", []):\n                print(bloc.get(\"text\", json.dumps(bloc, ensure_ascii=False)))\n            sys.exit(1 if r.get(\"isError\") else 0)\n        if cmd == \"schema\":\n            for o in appeler(\"tools/list\").get(\"tools\", []):\n                if o[\"name\"] == sys.argv[2]:\n                    print(json.dumps(o, indent=2, ensure_ascii=False)); sys.exit(0)\n            raise SystemExit(f\"ÉCHEC — outil inconnu : {sys.argv[2]}\")\n        if cmd == \"call\":\n            args = json.loads(sys.argv[3]) if len(sys.argv) > 3 else {}\n            r = appeler(\"tools/call\", {\"name\": sys.argv[2], \"arguments\": args})\n            for bloc in r.get(\"content\", []):\n                print(bloc.get(\"text\", json.dumps(bloc, ensure_ascii=False)))\n            sys.exit(1 if r.get(\"isError\") else 0)\n        raise SystemExit(f\"ÉCHEC — commande inconnue : {cmd}\")\n    except urllib.error.URLError as e:\n        raise SystemExit(f\"ÉCHEC — serveur MCP injoignable sur {URL} ({e.reason}). Éditeur fermé ?\")\n","stderr"