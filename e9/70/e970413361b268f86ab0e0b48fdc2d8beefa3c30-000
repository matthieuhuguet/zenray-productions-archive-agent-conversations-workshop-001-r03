m_size', 0.11, 0.17)\n]\n\ntotal_frames = 360\nstep_frames = total_frames // len(parms_spec)\n\nfor idx, (pname, default_val, peak_val) in enumerate(parms_spec):\n    p = node.parm(pname)\n    if p is None:\n        continue\n    p.deleteAllKeyframes()\n    start_f = idx * step_frames + 1\n    mid_f = start_f + step_frames // 2\n    end_f = (idx + 1) * step_frames\n\n    if start_f > 1:\n        kf_first = hou.Keyframe()\n        kf_first.setFrame(1)\n        kf_first.setValue(default_val)\n        p.setKeyframe(kf_first)\n\n        kf_pre = hou.Keyframe()\n        kf_pre.setFrame(start_f)\n        kf_pre.setValue(default_val)\n        p.setKeyframe(kf_pre)\n    else:\n        kf_start = hou.Keyframe()\n        kf_start.setFrame(1)\n        kf_start.setValue(default_val)\n        p.setKeyframe(kf_start)\n\n    kf_mid = hou.Keyframe()\n    kf_mid.setFrame(mid_f)\n    kf_mid.setValue(peak_val)\n    p.setKeyframe(kf_mid)\n\n    kf_end = hou.Keyframe()\n    kf_end.setFrame(end_f)\n    kf_end.setValue(default_val)\n    p.setKeyframe(kf_end)\n\n    if end_f < total_frames:\n        kf_last = hou.Keyframe()\n        kf_last.setFrame(total_frames)\n        kf_last.setValue(default_val)\n        p.setKeyframe(kf_last)\n\nhou.setFrame(1)\n```\n\n### 2. Protocole de capture en premier plan (evitement de mise en veille GPU par macOS)\n\nSur macOS, le gestionnaire de fenetres (WindowServer) ainsi que les mecanismes d economie\nd energie du systeme (App Nap, occlusion de fenetre) coupent ou ralentissent severement le\nrafraichissement OpenGL, Metal et Qt des applications qui ne sont pas actives au premier plan.\nSi Houdini perd le focus pendant un enregistrement video ou un script d automatisation (par\nexemple au profit d OBS ou du terminal), le viewport 3D cesse d evaluer les images ou saute des\nframes, produisant une capture video gelee ou saccadee.\n\nPour garantir un enregistrement fluide a plein debit :\n\n1. Forcer Houdini au premier plan par AppleScript avant le demarrage du playback :\n```python\nimport subprocess, time\n\ndef focus_houdini():\n    cmd = 'tell application \"System Events\" to tell process \"houdinifx\" to set frontmost to true'\n    subprocess.run(['osascript', '-e', cmd], capture_output=True, text=True)\n\nfocus_houdini()\ntime.sleep(0.5)\n```\n\n2. En cas d animation procedurale pilotee pas a pas directement en HOM sans playbar :\nForcer l interface Qt de Houdini a traiter sa file d attente d evenements graphiques a chaque pas :\n```python\nfrom PySide6.QtCore import QCoreApplication\nimport time\n\n# A l interieur de la boucle de variation des parametres :\nQCoreApplication.processEvents()\ntime.sleep(0.04)\n```\n\n### 3. Configuration de la playbar (bornes, synchronisation temps reel et controle)\n\nLe module HOM `hou.playbar` controle l execution temporelle de la scene. Pour une capture\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0ba64-4e92-7f30-842c-330d1dcfb95a","create_time":1789833585.983058}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
