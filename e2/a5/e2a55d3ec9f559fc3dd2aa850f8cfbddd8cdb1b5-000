  if (cible) patchComposition((c) => setActiveSlide(c, cible.id))\n        }\n      }\n    }\n    const haut = (e) => { if (e.code === 'Space') espaceRef.current = false }\n    window.addEventListener('keydown', bas)\n    window.addEventListener('keyup', haut)\n    return () => { window.removeEventListener('keydown', bas); window.removeEventListener('keyup', haut) }\n    // `menuContextuel` et `cadrerLaSelection` DOIVENT être dans ce tableau : un effet à dépendances\n    // vides capture sa fermeture au premier rendu, où `menuContextuel` valait `null` et\n    // `calqueSelectionne` (dont dépend `cadrerLaSelection`) valait aussi `null`. Sans eux, Échap\n    // n'aurait jamais fermé le menu contextuel et Maj+F n'aurait jamais cadré aucune sélection —\n    // un bogue de fermeture périmée découvert en écrivant le test de la carte S4, pas en le devinant.\n  }, [menuContextuel, cadrerLaSelection, naviguerHierarchie, ordreHierarchie, selection, composition, patchComposition, annuler, retablir, copierSelection, couperSelection, collerSelection])\n\n  if (!project) return <div style={{ padding: 24 }}>Aucun brief.</div>\n\n  const rt = cut ? readingTimeOf(cut) : { words: 0, minutes: 0 }\n\n  // ZONE 7 · LA MESURE DE LA BANDE. Deux régimes, et l'unité change avec le format plutôt que de\n  // faire passer des minutes de lecture pour des secondes de vidéo. Sur un format temporel, la\n  // durée déclarée de chaque bloc ; ailleurs, sa part du temps de LECTURE, à deux cents mots la\n  // minute, ce qui est la convention déjà retenue par `readingTimeOf`.\n  const tlUnit = isTemporal(format) ? 's' : ' min'\n  const tlParts = (cut?.beats || []).map((beat) => isTemporal(format)\n    ? beatDuration(beat)\n    : Math.max(0.05, (beat.text || '').trim().split(/\\s+/).filter(Boolean).length / 200))\n  const tlTotal = tlParts.reduce((sum, part) => sum + part, 0)\n  const tlOffsets = tlParts.reduce((acc, part, i) => { acc.push(i === 0 ? 0 : acc[i - 1] + tlParts[i - 1]); return acc }, [])\n 