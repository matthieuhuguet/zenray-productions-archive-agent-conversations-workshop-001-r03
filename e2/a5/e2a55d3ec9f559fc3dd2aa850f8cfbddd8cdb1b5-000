{"timestamp":"2026-08-05T18:05:45.094Z","ordinal":2339,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd31a-5106-7a93-9670-ab1ae3d7f06c","call_id":"call_BoOgZh8r3bsZI6HA8gne2RPe","output":[{"type":"input_text","text":"Script completed\nWall time 0.0 seconds\nOutput:\n"},{"type":"input_text","text":"  })\n})\n\n// RÉGRESSION (bug réel signalé par Matthieu le 2026-07-25) : le format A4 était inutilisable —\n// le compilateur ignorait le `dpi`, donc un corps de 19 px atterrissait sur un canevas de\n// 2480 px de large. Ce bloc vérifie TOUS les formats, pas seulement celui qu'on a sous les yeux.\ndescribe('L5/L6 — tout format produit un rendu lisible', () => {\n  const bodySizeOf = (html) => {\n    const body = /body\\{[^}]*?font-size:([\\d.]+)px/.exec(html)\n    return body ? Number(body[1]) : null\n  }\n\n  for (const format of FORMATS) {\n    it(`${format.label} : corps proportionné au canevas`, () => {\n      const { brief, cut } = fixture()\n      const { html } = compile({ brief, cut, theme, format, seed: 1 })\n      const size = bodySizeOf(html)\n      expect(size).toBeGreaterThan(0)\n      if (format.canvas.h > 0) {\n        // Plancher de lisibilité : sous ~1,2 % de la largeur du canevas, le texte devient un\n        // timbre-poste. C'est exactement ce que produisait A4 avant le correctif (0,77 %).\n        expect(size / format.canvas.w).toBeGreaterThan(0.012)\n        // LE PLAFOND DÉPEND DE LA LARGEUR, et ce n'est pas une concession (2026-08-04).\n        //\n        // Six pour cent était calibré sur des canevas de mille pixels et plus. Sur un pavé\n        // publicitaire de 320 px, un corps de 20 px pèse 6,4 % de la largeur et reste parfaitement\n        // juste : c'est la taille qu'on lit sur une bannière mobile. Un rapport n'est pas une\n        // constante universelle, il dépend de la distance de lecture, laquelle dépend de la taille\n        // de la boîte. Le plafond s'assouplit donc sous 600 px, et nulle part ailleurs.\n        const plafond = format.canvas.w < 600 ? 0.11 : 0.06\n        expect(size / format.canvas.w).toBeLessThan(plafond) // ni l'inverse : pas d'affiche de 2 mots\n      } else {\n        expect(size).toBeGreaterThanOrEqual(16) // confort de lecture à l'écran\n      }\n    })\n\n    it(`${format.label} : bloc centré, texte ferré à gauche, mesure bornée`, () => {\n      const { brief, cut } = fixture()\n      const { html } = compile({ brief, cut, theme, format, seed: 1 })\n      expect(html).toContain('class=\"zrm-frame\"')\n      expect(html).toContain('class=\"zrm-page\"')\n      expect(/\\.zrm-page\\{[^}]*margin:0 auto/.test(html)).toBe(true)   // bloc centré\n      expect(/\\.zrm-page\\{[^}]*text-align:left/.test(html)).toBe(true) // texte à gauche\n      const maxWidth = /\\.zrm-page\\{[^}]*max-width:([^;]+);/.exec(html)\n      expect(maxWidth).toBeTruthy()\n      if (format.canvas.h > 0) expect(maxWidth[1]).toContain('ch') // mesure de lecture réelle\n    })\n  }\n\n  it('A4 rend un corps d’environ 14 points réels à 300 dpi', () => {\n    const { brief, cut } = fixture()\n    const a4 = getFormat('F-print-a4')\n    const { html } = compile({ brief, cut, theme, format: a4, seed: 1 })\n    const px = bodySizeOf(html)\n    const points = (px / a4.canvas.dpi) * 72\n    expect(points).toBeGreaterThan(10)\n    expect(points).toBeLessThan(20)\n  })\n})\n\n// RÉGRESSION (2026-07-25) : « énormément de bugs sur tous les formats crop ». La cause n'était\n// pas le rendu mais la doctrine — on tentait de faire rentrer un article de 5 blocs sur un carré\n// 1080. Un format décide désormais de ce qu'il montre, et l'échelle se MESURE au lieu de se deviner.\n    expect(normalizeComposition({ themeId: 'autre', rows: [], poison: 1 }, theme.id).poison).toBeUndefined()\n    expect(normalizeComposition({ themeId: theme.id, rows: 'pas-un-tableau', poison: 1 }, theme.id).poison).toBeUndefined()\n    // Et les clefs structurelles restent imposées, quoi que porte l'entrée.\n    const c = normalizeComposition({ themeId: theme.id, rows: [], v: 99, serial: 'x' }, theme.id)\n    expect(c.v).not.toBe(99)\n    expect(c.serial).toBe(0)\n  })\n})\n\ndescribe('voie Lego — le cadre de sortie (étape 1)', () => {\n  // AVANT le 2026-08-01, cette voie ne connaissait du format que `max-width:1180px` ou `none` :\n  // un carré 1080, un 9:16 et un A4 rendaient la même colonne qui coule. Six des sept formats\n  // déclarés sont bornés, et aucun n'était servi. Ces tests sont le critère de fini de l'étape 1.\n  const posee = () => addComponent(emptyComposition(theme.id), { id: 'titre' })\n\n  it('chacun des sept formats déclarés rend le canevas qu’il annonce', () => {\n    for (const f of FORMATS) {\n      const { html } = compileLego(posee(), { format: f })\n      if (f.canvas.h > 0) {\n        expect(html, f.id).toContain(`width:${f.canvas.w}px;height:${f.canvas.h}px;overflow:hidden;`)\n      } else {\n        // Le format fluide garde sa mesure de lecture au lieu d'un plafond arbitraire : c'est sa\n        // largeur DÉCLARÉE qui borne la ligne, non les 1180 px qui traînaient en dur.\n        expect(html, f.id).toContain(`max-width:${f.canvas.w}px`)\n        expect(html, f.id).not.toMatch(/height:\\d+px;overflow:hidden/)\n      }\n    }\n  })\n\n  it('un format borné applique ses zones de sécurité, au pixel déclaré', () => {\n    for (const f of FORMATS.filter((x) => x.canvas.h > 0)) {\n      const { html } = compileLego(posee(), { format: f })\n      expect(html, f.id).toContain(`padding:${f.safe.top}px ${f.safe.sides}px ${f.safe.bottom}px`)\n    }\n  })\n\n  it('un format borné porte sa densité, sans quoi un A4 rendrait un timbre-poste', () => {\n    // Densités réelles : 1,6 pour la vidéo, 1,7 pour les stills, 3,125 pour l'A4. Sur la voie à\n    // jetons elles multiplient chaque valeur typographique ; ici elles passent par la taille de\n    // police RACINE, seule prise disponible quand les composants apportent leur propre feuille.\n    const a4 = getFormat('F-print-a4')\n    expect(a4.density).toBeGreaterThan(3)\n    expect(compileLego(posee(), { format: a4 }).html).toContain(`font-size:${Math.round(a4.density * 100)}%`)\n  })\n\n  it('la requête mobile n’écrase pas un canevas borné', () => {\n    // Un canevas de 1080 px de large déclencherait la requête à 620 px dans un aperçu réduit, et\n    // reformaterait la page qu'on est justement en train de cadrer.\n    expect(compileLego(posee(), { format: getFormat('F-still-1080x1920') }).html).not.toContain('@media(max-width:620px)')\n    expect(compileLego(posee(), { format: webFormat }).html).toContain('@media(max-width:620px)')\n  })\n})\n\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"255bb7e6-b68d-4c5c-b91b-c6a1965e3c1d"}}}
