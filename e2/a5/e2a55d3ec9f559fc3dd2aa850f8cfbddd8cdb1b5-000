    expect(pathD([{ x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 }], false)).toBe('')\n+    expect(pathD([], false)).toBe('')\n+  })\n+\n+  it('createPathLayer calcule la boîte englobante EN INCLUANT les poignées, jamais seulement les ancres', () => {\n+    // Ancres à (0,0) et (100,0), mais une poignée déborde jusqu'à y=-50 : la boîte doit la contenir.\n+    const points = [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 20, outY: -50 },\n+      { x: 100, y: 0, inX: 80, inY: -50, outX: 100, outY: 0 },\n+    ]\n+    let c = createPathLayer(vide(), points, false)\n+    const l = readLayers(c).find((x) => x.name === 'Tracé')\n+    expect(l.y).toBe(-50)\n+    expect(l.h).toBe(50)\n+  })\n+\n+  it('createPathLayer normalise les points en POURCENTAGE 0-100 de la boîte calculée', () => {\n+    const points = [{ x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 }, { x: 200, y: 100, inX: 200, inY: 100, outX: 200, outY: 100 }]\n+    let c = createPathLayer(vide(), points, false)\n+    const l = readLayers(c).find((x) => x.name === 'Tracé')\n+    expect(l.pathPoints[0]).toEqual({ x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 })\n+    expect(l.pathPoints[1]).toEqual({ x: 100, y: 100, inX: 100, inY: 100, outX: 100, outY: 100 })\n+  })\n+\n+  it('createPathLayer refuse un tracé de moins de deux points', () => {\n+    const c = vide()\n+    expect(createPathLayer(c, [{ x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 }], false)).toBe(c)\n+    expect(createPathLayer(c, [], false)).toBe(c)\n+  })\n+\n+  it('movePathAnchor déplace l’ancre ET ses deux poignées PAR LA MÊME TRANSLATION', () => {\n+    const points = [{ x: 10, y: 10, inX: 0, inY: 0, outX: 20, outY: 20 }]\n+    const suivant = movePathAnchor(points, 0, 15, 25)\n+    // Delta : +5 en x, +15 en y. Les poignées suivent exactement ce même déplacement.\n+    expect(suivant[0]).toEqual({ x: 15, y: 25, inX: 5, inY: 15, outX: 25, outY: 35 })\n+  })\n+\n+  it('movePathHandle déplace UNE SEULE poignée, sans toucher à l’autre ni à l’ancre', () => {\n+    const points = [{ x: 10, y: 10, inX: 0, inY: 0, outX: 20, outY: 20 }]\n+    const suivant = movePathHandle(points, 0, 'out', 50, 60)\n+    expect(suivant[0]).toEqual({ x: 10, y: 10, inX: 0, inY: 0, outX: 50, outY: 60 })\n+  })\n+\n+  it('removePathPoint retire un point, mais jamais sous deux points restants', () => {\n+    const points = [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n+      { x: 50, y: 50, inX: 50, inY: 50, outX: 50, outY: 50 },\n+      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },\n+    ]\n+    const deuxPoints = removePathPoint(points, 1)\n+    expect(deuxPoints).toHaveLength(2)\n+    const plancher = removePathPoint(deuxPoints, 0)\n+    expect(plancher).toBe(deuxPoints)   // refuse de descendre sous deux points\n+  })\n+\n+  it('insertPathPoint ajoute un point d’ANGLE (poignées confondues) juste après l’index donné', () => {\n+    const points = [{ x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 }, { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 }]\n+    const suivant = insertPathPoint(points, 0, 50, 30)\n+    expect(suivant).toHaveLength(3)\n+    expect(suivant[1]).toEqual({ x: 50, y: 30, inX: 50, inY: 30, outX: 50, outY: 30 })\n+  })\n+\n+  it('un point hors 0-100 est ramené dans les bornes à la relecture, jamais laissé libre', () => {\n+    let c = addLayer(vide(), 'shape', { pathPoints: [{ x: -10, y: 150, inX: 0, inY: 0, outX: 0, outY: 0 }, { x: 50, y: 50, inX: 50, inY: 50, outX: 50, outY: 50 }] })\n+    const l = readLayers(c)[0]\n+    expect(l.pathPoints[0].x).toBe(0)\n+    expect(l.pathPoints[0].y).toBe(100)\n+  })\n+\n+  it('le tracé compile en <svg><path> réel, avec le fond et le contour du calque', () => {\n+    let c = createPathLayer(vide(), [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n+      { x: 100, y: 100, inX: 100, inY: 100, outX: 100, outY: 100 },\n+    ], false)\n+    const tracé = readLayers(c).find((l) => l.name === 'Tracé')\n+    c = patchLayer(c, tracé.id, { style: { backgroundColor: '#ffcc00' } })\n+    const { html } = compiler(c)\n+    expect(html).toContain('<svg')\n+    expect(html).toContain('fill=\"#ffcc00\"')\n+    expect(html).toContain('stroke=\"#151515\"')\n+  })\n+\n+  it('un tracé SANS fond réglé ne peint aucune surface (fill=\"none\"), seulement son contour', () => {\n+    let c = createPathLayer(vide(), [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n+      { x: 100, y: 100, inX: 100, inY: 100, outX: 100, outY: 100 },\n+    ], false)\n+    const { html } = compiler(c)\n+    expect(html).toContain('fill=\"none\"')\n+  })\n+\n+  it('un tracé ne porte JAMAIS l’attribut data-shape : sa géométrie n’est pas une forme paramétrique', () => {\n+    let c = createPathLayer(vide(), [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n+      { x: 100, y: 100, inX: 100, inY: 100, outX: 100, outY: 100 },\n+    ], false)\n+    const tracé = readLayers(c).find((l) => l.name === 'Tracé')\n+    const { html } = compiler(c)\n+    const doc = new DOMParser().parseFromString(html, 'text/html')\n+    const el = doc.querySelector(`[data-zrm-layer=\"${tracé.id}\"]`)\n+    expect(el.hasAttribute('data-shape')).toBe(false)\n+  })\n+})\n+\n+// Carte I2 (suite) — édition d'un tracé DÉJÀ posé : convertir un point, ajouter un point sur un\n+// segment existant. La Sélection directe d'Illustrator, plutôt qu'un second outil séparé — ici un\n+// seul et même calque de tracé, sélectionné, expose ses points à l'édition.\n+import { toggleAnchorSmoothness, nearestPointOnTrace } from './layers.js'\n+\n+describe('Illustrator I2 — convertir et insérer un point sur un tracé existant', () => {\n+  it('convertit un point d’ANGLE en point LISSE : les poignées sortent le long de la tangente aux voisins', () => {\n+    const points = [\n+      { x: 0, y: 50, inX: 0, inY: 50, outX: 0, outY: 50 },\n+      { x: 50, y: 50, inX: 50, inY: 50, outX: 50, outY: 50 },   // point d'angle, au milieu\n+      { x: 100, y: 50, inX: 100, inY: 50, outX: 100, outY: 50 },\n+    ]\n+    const suivant = toggleAnchorSmoothness(points, 1, false)\n+    // Voisins alignés sur l'axe x : la tangente est horizontale, les poignées s'écartent en x, pas en y.\n+    expect(suivant[1].outX).toBeGreaterThan(50)\n+    expect(suivant[1].inX).toBeLessThan(50)\n+    expect(suivant[1].outY).toBe(50)\n+    expect(suivant[1].inY).toBe(50)\n+  })\n+\n+  it('convertit un point LISSE en point d’ANGLE : les deux poignées reviennent exactement sur l’ancre', () => {\n+    const points = [{ x: 50, y: 50, inX: 30, inY: 40, outX: 70, outY: 60 }]\n+    const suivant = toggleAnchorSmoothness(points, 0, false)\n+    expect(suivant[0]).toEqual({ x: 50, y: 50, inX: 50, inY: 50, outX: 50, outY: 50 })\n+  })\n+\n+  it('convertir le SEUL point d’un bout de tracé ouvert utilise son unique voisin, sans jamais planter', () => {\n+    const points = [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n+      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },\n+    ]\n+    const suivant = toggleAnchorSmoothness(points, 0, false)\n+    expect(suivant[0].outX).toBeGreaterThan(0)   // tiré vers l'unique voisin, à droite\n+  })\n+\n+  it('nearestPointOnTrace trouve un point EXACTEMENT sur la courbe, près d’un clic à côté d’elle', () => {\n+    const points = [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n+      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },\n+    ]\n+    // Segment plat sur y=0 : cliquer à (50, 6) doit accrocher un échantillon proche de (50, 0).\n+    const trouve = nearestPointOnTrace(points, false, 50, 6)\n+    expect(trouve.afterIndex).toBe(0)\n+    expect(trouve.x).toBeCloseTo(50, 0)\n+    expect(trouve.y).toBeCloseTo(0, 0)\n+  })\n+\n+  it('nearestPointOnTrace identifie le bon SEGMENT parmi plusieurs, jamais le premier par défaut', () => {\n+    const points = [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n+      { x: 50, y: 0, inX: 50, inY: 0, outX: 50, outY: 0 },\n+      { x: 100, y: 0, inX: 100,