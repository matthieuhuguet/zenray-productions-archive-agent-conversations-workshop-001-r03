{"timestamp":"2026-08-05T17:25:20.200Z","ordinal":1424,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd2f5-50c8-7c51-a1b8-91331a23851c","call_id":"call_5KAyFYNQMCKKzKGa54wxJnM6","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"// ZenRayMedia — L0 : les six contrats de données.\n// Doc de référence : docs/zenraymedia/01-PLAN.md §5, docs/zenraymedia/04-WBS-COMPOSANTS.md L0.\n//\n// RÈGLE DURE (01-PLAN §5.5) : tout Job porte une `seed`. Aucun aléa non graine n'est autorisé\n// dans le produit -- sinon deux rendus du même contenu diffèrent et le pipeline n'est plus\n// réparable (risque R3 de 02-RISQUES). `Math.random()` est donc INTERDIT dans ce dossier :\n// on passe toujours par `rng(seed)` ci-dessous.\n\nexport const REGISTERS = ['presse', 'créateur', 'institutionnel', 'luxe', 'technique', 'divertissement', 'pédagogique', 'promotionnel']\nexport const INTENTS = ['informer', 'convaincre', 'vendre', 'émouvoir', 'enseigner', 'annoncer', 'documenter']\nexport const BEAT_ROLES = ['hook', 'context', 'proof', 'demo', 'turn', 'payoff', 'cta']\nexport const BEAT_TEMPOS = ['still', 'calm', 'drive', 'snap']\n\nexport const ROLE_LABELS = {\n  hook: 'Accroche', context: 'Contexte', proof: 'Preuve', demo: 'Démonstration',\n  turn: 'Bascule', payoff: 'Chute', cta: 'Appel',\n}\n\n// --- Générateur déterministe (L0-10) -------------------------------------------------------\n// mulberry32 : même graine -> même suite, sur toutes les machines. Utilisé pour le grain, les\n// micro-décalages et tout choix \"aléatoire\" d'un thème.\nexport function rng(seed) {\n  let a = (typeof seed === 'number' ? seed : hashString(String(seed ?? 'zenraymedia'))) >>> 0\n  return function next() {\n    a |= 0; a = (a + 0x6D2B79F5) | 0\n    let t = Math.imul(a ^ (a >>> 15), 1 | a)\n    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t\n    return ((t ^ (t >>> 14)) >>> 0) / 4294967296\n  }\n}\n\nexport function hashString(str) {\n  let h = 2166136261 >>> 0\n  for (let i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = Math.imul(h, 16777619) }\n  return h >>> 0\n}\n\n// Identifiant stable et lisible, dérivé du contenu + d'un compteur fourni par l'appelant.\n// Volontairement SANS Date.now() : un id ne doit pas dépendre de l'heure de fabrication.\nexport function makeId(prefix, seedText, counter = 0) {\n  return `${prefix}-${hashString(`${seedText}#${counter}`).toString(36).padStart(7, '0')}`\n}\n\n// --- Helpers de validation ------------------------------------------------------------------\nconst isStr = (v) => typeof v === 'string'\nconst nonEmpty = (v) => isStr(v) && v.trim().length > 0\nconst isArr = Array.isArray\n\n// Compte les phrases d'un texte. Sert la contrainte du message unique (WBS ZM-L2-02).\n// Les abréviations courantes ne comptent pas comme fin de phrase.\nexport function sentenceCount(text) {\n  if (!nonEmpty(text)) return 0\n  const cleaned = String(text)\n    .replace(/\\b(M|Mme|Dr|etc|cf|ex|p|vs|Mr|St|n°|art)\\./gi, '$1')\n    .replace(/\\d+\\.\\d+/g, '0')\n  const parts = cleaned.split(/[.!?…]+(?:\\s|$)/).map((s) => s.trim()).filter(Boolean)\n  return parts.length\n}\n\n// --- 5.1 Brief --------------------------------------------------------------------------------\nexport function emptyBrief() {\n  return {\n    id: '', title: '', message: '', audience: '', register: 'créateur', intent: 'informer',\n    evidence: [], constraints: { languages: ['fr'], maxDuration: null, mentions: [] }, sources: [],\n  }\n}\n\nexport function validateBrief(brief) {\n  const errors = []\n  if (!brief || typeof brief !== 'object') return [{ field: 'brief', code: 'shape', message: 'Brief absent.' }]\n  if (!nonEmpty(brief.title)) errors.push({ field: 'title', code: 'required', message: 'Le titre de travail est obligatoire.' })\n  if (!nonEmpty(brief.message)) errors.push({ field: 'message', code: 'required', message: 'Le message est obligatoire : une phrase, celle que le public doit retenir.' })\n  // ZM-L2-02 : REFUS explicite, pas un avertissement.\n  else if (sentenceCount(brief.message) > 1) errors.push({ field: 'message', code: 'single-sentence', message: `Le message doit tenir en UNE phrase (${sentenceCount(brief.message)} détectées). Choisis celle qui compte.` })\n  if (!nonEmpty(brief.audience)) errors.push({ field: 'audience', code: 'required', message: 'Le public est obligatoire : à qui parles-tu, en clair ?' })\n  if (!REGISTERS.includes(brief.register)) errors.push({ field: 'register', code: 'enum', message: 'Registre inconnu.' })\n  if (!INTENTS.includes(brief.intent)) errors.push({ field: 'intent', code: 'enum', message: 'Intention inconnue.' })\n  if (brief.evidence && !isArr(brief.evidence)) errors.push({ field: 'evidence', code: 'shape', message: 'Les preuves doivent former une liste.' })\n  return errors\n}\n\n// --- 5.2 Cut ----------------------------------------------------------------------------------\nexport function validateCut(cut) {\n  const errors = []\n  if (!cut || typeof cut !== 'object') return [{ field: 'cut', code: 'shape', message: 'Cut absent.' }]\n  if (!nonEmpty(cut.briefId)) errors.push({ field: 'briefId', code: 'required', message: 'Le cut doit référencer un brief.' })\n  if (!isArr(cut.beats) || cut.beats.length === 0) {\n    errors.push({ field: 'beats', code: 'required', message: 'Un cut contient au moins un beat.' })\n    return errors\n  }\n  cut.beats.forEach((beat, i) => {\n    if (!BEAT_ROLES.includes(beat?.role)) errors.push({ field: `beats[${i}].role`, code: 'enum', message: `Beat ${i + 1} : rôle manquant ou inconnu.` })\n    if (!nonEmpty(beat?.text)) errors.push({ field: `beats[${i}].text`, code: 'required', message: `Beat ${i + 1} : texte vide.` })\n    if (beat?.weight != null && (typeof beat.weight !== 'number' || beat.weight < 0 || beat.weight > 1)) errors.push({ field: `beats[${i}].weight`, code: 'range', message: `Beat ${i + 1} : le poids doit être compris entre 0 et 1.` })\n    if (beat?.tempo && !BEAT_TEMPOS.includes(beat.tempo)) errors.push({ field: `beats[${i}].tempo`, code: 'enum', message: `Beat ${i + 1} : tempo inconnu.` })\n    if (beat?.slots && !isArr(beat.slots)) errors.push({ field: `beats[${i}].slots`, code: 'shape', message: `Beat ${i + 1} : les emplacements doivent former une liste.` })\n    if (isArr(beat?.slots) && beat.slots.length > 4) errors.push({ field: `beats[${i}].slots`, code: 'range', message: `Beat ${i + 1} : 4 emplacements média au maximum.` })\n  })\n  return errors\n}\n\n// --- 5.3 Theme --------------------------------------------------------------------------------\n// Les 7 groupes de décisions (01-PLAN §10.2). `surface`, `palette`, `typography`, `grid` sont\n// obligatoires ; `motion`, `chrome`, `sound` ont des valeurs par défaut (un thème d'article n'a\n// pas besoin de mouvement ni de son pour être valide).\nexport const THEME_GROUPS = ['surface', 'palette', 'typography', 'grid', 'motion', 'chrome', 'sound']\n\nexport function validateTheme(theme) {\n  const errors = []\n  if (!theme || typeof theme !== 'object') return [{ field: 'theme', code: 'shape', message: 'Thème absent.' }]\n  if (!/^T-\\d{2}-\\d-\\d$/.test(theme.id || '')) errors.push({ field: 'id', code: 'format', message: 'Identifiant attendu : T-FF-S-V (ex. T-01-3-2).' })\n  if (!nonEmpty(theme.name)) errors.push({ field: 'name', code: 'required', message: 'Le nom public du thème est obligatoire.' })\n  for (const group of ['surface', 'palette', 'typography', 'grid']) {\n    if (!theme[group] || typeof theme[group] !== 'object') errors.push({ field: group, code: 'required', message: `Groupe « ${group} » manquant.` })\n  }\n  if (theme.typography && !theme.typography.scale) errors.push({ field: 'typography.scale', code: 'required', message: 'Le thème doit poser son échelle typographique.' })\n  if (!isArr(theme.formats) || theme.formats.length === 0) errors.push({ field: 'formats', code: 'required', message: 'Le thème doit déclarer au moins un format natif.' })\n  // ZM-L4-16 : le calibrage est PRIVÉ. Un thème qui l'expose dans un champ public est refusé.\n  const publicText = `${theme.name || ''} ${theme.description || ''}`.toLowerCase()\n  const marks = ['bfm', 'carrefour', 'squeezie', 'playstation', 'weta', 'le monde', 'netflix', 'vogue', 'lidl']\n  const leaked = marks.filter((m) => publicText.includes(m))\n  if (leaked.length) errors.push({ field: 'name', code: 'trademark', message: `Marque déposée dans un champ public : ${leaked.join(', ')}. Le calibrage vit dans calibration.ref, jamais dans le nom.` })\n  return errors\n}\n\n// --- 5.4 Format --------------------------------------------------------------------------------\nexport const FORMAT_KINDS = ['web', 'still', 'print', 'video', 'overlay']\n\nexport function validateFormat(format) {\n  const errors = []\n  if (!format || typeof format !== 'object') return [{ field: 'format', code: 'shape', message: 'Format absent.' }]\n  if (!nonEmpty(format.id)) errors.push({ field: 'id', code: 'required', message: 'Identifiant de format manquant.' })\n  if (!FORMAT_KINDS.includes(format.kind)) errors.push({ field: 'kind', code: 'enum', message: 'Type de format inconnu.' })\n  const c = format.canvas\n  // Une page web n'a PAS de hauteur : le contenu coule. `h:0` y est donc légal et volontaire.\n  // Tout autre type de format (image, print, vidéo) doit poser ses deux dimensions.\n  if (!c || !(c.w > 0)) errors.push({ field: 'canvas', code: 'required', message: 'Largeur de sortie manquante.' })\n  else if (format.kind !== 'web' && !(c.h > 0)) errors.push({ field: 'canvas', code: 'required', message: `Hauteur de sortie manquante (obligatoire pour un format « ${format.kind} »).` })\n  if (['video', 'overlay'].includes(format.kind) && !(format.time?.fps > 0)) errors.push({ field: 'time.fps', code: 'required', message: 'Un format temporel doit poser ses images par seconde.' })\n  return errors\n}\n\n// --- 5.5 Job -----------------------------------------------------------------------------------\nexport function validateJob(job) {\n  const errors = []\n  if (!job || typeof job !== 'object') return [{ field: 'job', code: 'shape', message: 'Job absent.' }]\n  if (!nonEmpty(job.cutId)) errors.push({ field: 'cutId', code: 'required', message: 'Job sans cut.' })\n  if (!nonEmpty(job.themeId)) errors.push({ field: 'themeId', code: 'required', message: 'Job sans thème.' })\n  if (!nonEmpty(job.formatId)) errors.push({ field: 'formatId', code: 'required', message: 'Job sans format.' })\n  // RÈGLE DURE : pas de seed, pas de job. C'est ce qui rend un rendu rejouable.\n  if (job.seed == null || job.seed === '') errors.push({ field: 'seed', code: 'required', message: 'Job sans graine : le rendu ne serait pas reproductible.' })\n  return errors\n}\n\n// --- 5.6 Deliverable ----------------------------------------------------------------------------\nexport function validateDeliverable(deliverable) {\n  const errors = []\n  if (!deliverable || typeof deliverable !== 'object') return [{ field: 'deliverable', code: 'shape', message: 'Livrable absent.' }]\n  if (!nonEmpty(deliverable.jobId)) errors.push({ field: 'jobId', code: 'required', message: 'Livrable orphelin.' })\n  if (!(deliverable.bytes > 0)) errors.push({ field: 'bytes', code: 'required', message: 'Livrable vide.' })\n  // Un livrable sans empreinte ni sonde est « non vérifié » : il ne peut pas être déclaré fini.\n  if (!nonEmpty(deliverable.checksum)) errors.push({ field: 'checksum', code: 'required', message: 'Livrable sans empreinte : non vérifiable.' })\n  if (!deliverable.probe) errors.push({ field: 'probe', code: 'required', message: 'Livrable sans sonde : non vérifié.' })\n  return errors\n}\n\n// --- L0-07 : validateur unique ---------------------------------------------------------------\n// Un SEUL point d'entrée. Aucune validation ne doit être dupliquée ailleurs dans le produit.\nconst VALIDATORS = {\n  brief: validateBrief, cut: validateCut, theme: validateTheme,\n  format: validateFormat, job: validateJob, deliverable: validateDeliverable,\n}\n\nexport function validate(kind, value) {\n  const fn = VALIDATORS[kind]\n  if (!fn) throw new Error(`validate: contrat inconnu « ${kind} »`)\n  return fn(value)\n}\n\nexport function isValid(kind, value) { return validate(kind, value).length === 0 }\n\n// Empreinte de contenu, pour les livrables produits côté navigateur (pas de crypto asynchrone\n// nécessaire, on veut une signature stable et rapide, pas une garantie cryptographique).\nexport function checksumOf(text) {\n  const s = String(text)\n  return `zrm1-${hashString(s).toString(16)}-${s.length.toString(16)}`\n}\n// ZenRayMedia — modèle de composition Lego.\n// Une ligne empile verticalement ; ses éléments partagent l'espace horizontal et se replient\n// automatiquement au rendu. Le modèle ne dépend ni du DOM ni de l'horloge : il reste testable,\n// sérialisable dans .zmedia.json et strictement reproductible.\n\nimport { makeId } from './contracts.js'\n\nexport const COMPOSITION_VERSION = 1\nexport const PLACEMENTS = ['above', 'below', 'left', 'right']\n\nexport function emptyComposition(themeId) {\n  return { v: COMPOSITION_VERSION, themeId, serial: 0, rows: [] }\n}\n\nexport function normalizeComposition(value, themeId) {\n  if (!value || value.themeId !== themeId || !Array.isArray(value.rows)) return emptyComposition(themeId)\n  // ON CONSERVE L'INCONNU AU LIEU DE LE RECONSTRUIRE (inversion de doctrine, 2026-08-01, carte C1).\n  //\n  // Cette fonction rendait un littéral à quatre clefs, et elle est appelée en tête de `insertItem`,\n  // `addComponent`, `addImage`, `removeItem`, `moveItem`, `patchItem`, `duplicateItem`, plus deux\n  // fois dans `MediaApp.jsx`. Toute clef qu'elle ne connaissait pas mourait donc au premier GESTE,\n  // en mémoire, sans qu'aucun rechargement soit en cause : un champ `timeline` ou une propriété de\n  // disposition posée sur une ligne ne survivait pas à un simple déplacement d'élément.\n  //\n  // Le contrat s'ouvre ICI, UNE seule fois, et plus jamais en V1. L'ouvrir une seconde fois pour\n  // une carte ultérieure serait un coût inutile et un second risque de régression sur des documents\n  // déjà enregistrés.\n  //\n  // La permissivité a son revers, et il est gardé par des tests dans les DEUX sens : ce qui est\n  // légitime survit, et une composition dont le thème ou les rangées sont invalides repart vide.\n  return {\n    ...value,\n    v: COMPOSITION_VERSION,\n    themeId,\n    serial: Number.isFinite(value.serial) ? value.serial : 0,\n    rows: value.rows\n      .filter((row) => row && Array.isArray(row.items))\n      .map((row, ri) => ({\n        ...row,\n        id: row.id || makeId('row', themeId, ri),\n        items: row.items.filter(Boolean).map((item) => ({\n          hidden: false,\n          locked: false,\n          props: {},\n          ...item,\n        })),\n      }))\n      .filter((row) => row.items.length),\n  }\n}\n\nfunction allocate(composition, prefix, salt) {\n  const serial = composition.serial + 1\n  return { id: makeId(prefix, `${composition.themeId}:${salt}`, serial), serial }\n}\n\nexport function componentInstance(composition, component) {\n  const next = allocate(composition, 'cmp', component.id)\n  return {\n    serial: next.serial,\n    item: {\n      id: next.id,\n      kind: 'component',\n      themeId: composition.themeId,\n      componentId: component.id,\n      name: component.name,\n      group: component.group,\n      hidden: false,\n      locked: false,\n      props: {},\n    },\n  }\n}\n\nexport function imageInstance(composition, image) {\n  const next = allocate(composition, 'img', image.path || image.name)\n  return {\n    serial: next.serial,\n    item: {\n      id: next.id,\n      kind: 'image',\n      name: image.name || 'Image',\n      refPath: image.path || null,\n      url: image.url || '',\n      hidden: false,\n      locked: false,\n      props: { fit: 'cover', radius: 18, ratio: '16 / 9' },\n    },\n  }\n}\n\nfunction locate(rows, itemId) {\n  for (let rowIndex = 0; rowIndex < rows.length; rowIndex += 1) {\n    const itemIndex = rows[rowIndex].items.findIndex((item) => item.id === itemId)\n    if (itemIndex >= 0) return { rowIndex, itemIndex }\n  }\n  return null\n}\n\nfunction newRow(composition, item, serial) {\n  return { id: makeId('row', `${composition.themeId}:${item.id}`, serial), items: [item] }\n}\n\nexport function insertItem(value, item, targetId = null, placement = 'below', serial = value.serial) {\n  const composition = normalizeComposition(value, value.themeId)\n  const rows = composition.rows.map((row) => ({ ...row, items: [...row.items] }))\n  const target = targetId ? locate(rows, targetId) : null\n\n  if (!target) {\n    rows.push(newRow(composition, item, serial))\n  } else if (placement === 'left' || placement === 'right') {\n    rows[target.rowIndex].items.splice(target.itemIndex + (placement === 'right' ? 1 : 0), 0, item)\n  } else {\n    rows.splice(target.rowIndex + (placement === 'below' ? 1 : 0), 0, newRow(composition, item, serial))\n  }\n  return { ...composition, serial: Math.max(composition.serial, serial), rows }\n}\n\nexport function addComponent(value, component, targetId = null, placement = 'below') {\n  const composition = normalizeComposition(value, value.themeId)\n  const created = componentInstance(composition, component)\n  return insertItem(composition, created.item, targetId, placement, created.serial)\n}\n\nexport function addImage(value, image, targetId = null, placement = 'below') {\n  const composition = normalizeComposition(value, value.themeId)\n  const created = imageInstance(composition, image)\n  return insertItem(composition, created.item, targetId, placement, created.serial)\n}\n\nexport function removeItem(value, itemId) {\n  const composition = normalizeComposition(value, value.themeId)\n  return {\n    ...composition,\n    rows: composition.rows\n      .map((row) => ({ ...row, items: row.items.filter((item) => item.id !== itemId) }))\n      .filter((row) => row.items.length),\n  }\n}\n\nexport function moveItem(value, itemId, targetId, placement) {\n  if (!PLACEMENTS.includes(placement) || itemId === targetId) return value\n  const composition = normalizeComposition(value, value.themeId)\n  const source = locate(composition.rows, itemId)\n  if (!source) return composition\n  const item = composition.rows[source.rowIndex].items[source.itemIndex]\n  return insertItem(removeItem(composition, itemId), item, targetId, placement, composition.serial)\n}\n\nexport function patchItem(value, itemId, patch) {\n  const composition = normalizeComposition(value, value.themeId)\n  return {\n    ...composition,\n    rows: composition.rows.map((row) => ({\n      ...row,\n      items: row.items.map((item) => (item.id === itemId ? { ...item, ...patch } : item)),\n    })),\n  }\n}\n\nexport function duplicateItem(value, itemId) {\n  const composition = normalizeComposition(value, value.themeId)\n  const source = locate(composition.rows, itemId)\n  if (!source) return composition\n  const original = composition.rows[source.rowIndex].items[source.itemIndex]\n  const next = allocate(composition, original.kind === 'image' ? 'img' : 'cmp', original.id)\n  return insertItem(composition, { ...original, id: next.id }, itemId, 'below', next.serial)\n}\n\nexport function countItems(value) {\n  return (value?.rows || []).reduce((sum, row) => sum + (row.items?.length || 0), 0)\n}\n// ZenRayMedia — L8 : le document `.zmedia.json` dans Create.\n//\n// DEUX CHOSES DIFFÉRENTES, souvent confondues (retour Matthieu 2026-07-25) :\n//\n//   1. ENREGISTRER  = ranger le document dans MON index, à un endroit que je choisis, pour le\n//      rouvrir et continuer à travailler. C'est ce fichier-ci. Le contenu est la SOURCE\n//      (brief + blocs + thème + format), pas le rendu.\n//   2. PUBLIER      = produire une page figée et partageable. C'est `exporters.js`.\n//\n// Même hiérarchie de dossiers, deux affichages et deux intentions distinctes. On peut enregistrer\n// sans jamais publier, et republier sans réenregistrer.\n//\n// Le fichier reste volontairement LISIBLE et MINUSCULE : aucun HTML compilé n'y est stocké, il se\n// recompile en quelques millisecondes. Stocker le rendu créerait deux vérités qui divergeraient.\n\nimport { readJson, saveJson, listChildren } from '../ref/content.js'\nimport { emptyBrief, makeId, validate } from './contracts.js'\nimport { DEFAULT_THEME_ID } from './themes/registry.js'\n\nexport const ZMEDIA_EXT = '.zmedia.json'\nexport const ZMEDIA_VERSION = 2\nexport const DEFAULT_MEDIA_DIR = 'pages/Media'\n\nexport function isZMediaPath(path) { return typeof path === 'string' && path.endsWith(ZMEDIA_EXT) }\n\nexport function slugify(text) {\n  return String(text || '')\n    .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-+|-+$/g, '')\n    .toLowerCase().slice(0, 60) || 'media'\n}\n\n// Chemin proposé pour un projet dans un dossier donné. Le suffixe court évite d'écraser un\n// homonyme sans avoir à interroger le serveur avant d'afficher une proposition.\nexport function suggestPath(dir, title, salt = 0) {\n  // Normaliser D'ABORD, se servir de la valeur normalisée PARTOUT ensuite.\n  // Bug réel (2026-07-25) : l'empreinte était calculée sur `dir` brut alors que le chemin final\n  // utilisait `dir` nettoyé -> « pages/Media » et « pages/Media/ » désignent le même dossier mais\n  // produisaient deux noms de fichier différents. Un même document enregistré deux fois depuis\n  // deux points d'entrée aurait créé deux fichiers au lieu d'un.\n  const folder = String(dir || DEFAULT_MEDIA_DIR).replace(/\\/+$/, '')\n  const base = slugify(title)\n  const suffix = makeId('', `${folder}/${base}`, salt).replace(/^-/, '').slice(-4)\n  return `${folder}/${base}-${suffix}${ZMEDIA_EXT}`\n}\n\n// --- Sérialisation ------------------------------------------------------------------------------\nexport function toDocument(project, { themeId, formatId, path }) {\n  return {\n    type: 'zenraymedia',\n    v: ZMEDIA_VERSION,\n    title: project.brief?.title || 'Sans titre',\n    path: path || null,\n    brief: project.brief,\n    notes: project.notes || '',\n    cut: project.cut || null,\n    compositions: project.compositions || {},\n    themeId: themeId || DEFAULT_THEME_ID,\n    formatId: formatId || 'F-web-article',\n    seed: project.seed ?? 1,\n  }\n}\n\n// Tolérant en LECTURE, strict en écriture : un document écrit par une version future ne doit pas\n// faire planter l'application, juste perdre ce qu'elle ne comprend pas.\nexport function fromDocument(doc, path) {\n  if (!doc || doc.type !== 'zenraymedia') return null\n  const brief = { ...emptyBrief(), ...(doc.brief || {}) }\n  if (!brief.id) brief.id = makeId('brief', path || doc.title || 'zmedia', 0)\n  return {\n    project: {\n      id: makeId('project', path || doc.title || 'zmedia', 0),\n      brief,\n      notes: typeof doc.notes === 'string' ? doc.notes : '',\n      cut: doc.cut && Array.isArray(doc.cut.beats) && doc.cut.beats.length ? doc.cut : null,\n      // Une composition par thème : essayer une autre famille ne détruit jamais le montage Lego.\n      // `composition` garde la lecture tolérante d'une courte version de développement.\n      compositions: doc.compositions && typeof doc.compositions === 'object'\n        ? doc.compositions\n        : (doc.composition?.themeId ? { [doc.composition.themeId]: doc.composition } : {}),\n      seed: Number.isFinite(doc.seed) ? doc.seed : 1,\n      path: path || doc.path || null,\n    },\n    themeId: doc.themeId || DEFAULT_THEME_ID,\n    formatId: doc.formatId || 'F-web-article',\n  }\n}\n\n// --- Entrées / sorties ---------------------------------------------------------------------------\n/** Lit un document. `{ ok, project, themeId, formatId, sha, error }` — ne lève jamais. */\nexport async function loadDocument(path) {\n  if (!isZMediaPath(path)) return { ok: false, error: 'Chemin qui n’est pas un document ZenRayMedia.' }\n  const { data, sha, missing, error } = await readJson(path)\n  if (missing) return { ok: false, error: 'Document introuvable.' }\n  if (error) return { ok: false, error: error === 'parse' ? 'Document illisible (JSON invalide).' : 'Lecture impossible (réseau).' }\n  const parsed = fromDocument(data, path)\n  if (!parsed) return { ok: false, error: 'Ce fichier n’est pas un document ZenRayMedia.' }\n  return { ok: true, ...parsed, sha }\n}\n\n/**\n * Écrit un document. `sha` est celui lu précédemment : c'est lui qui permet à GitHub de refuser\n * une écriture concurrente plutôt que d'écraser le travail d'un autre onglet.\n */\nexport async function saveDocument(path, project, { themeId, formatId, sha } = {}) {\n  const errors = validate('brief', project?.brief || null)\n  if (errors.length) return { ok: false, error: `Document incomplet : ${errors[0].message}` }\n  const doc = toDocument(project, { themeId, formatId, path })\n  const res = await saveJson(path, doc, sha)\n  if (res.conflict) return { ok: false, conflict: true, error: 'Ce document a été modifié ailleurs. Recharge-le avant d’enregistrer.' }\n  if (!res.ok) return { ok: false, error: res.error === 'network' ? 'Enregistrement impossible (réseau).' : `Enregistrement refusé (${res.error || 'inconnu'}).` }\n  return { ok: true, sha: res.sha }\n}\n\n// --- Navigation de dossiers (le fil d'Ariane) -------------------------------------------------\n/** Sous-dossiers directs d'un dossier, triés. `listChildren` passe par l'API `children`. */\nexport async function listFolders(dir) {\n  const entries = await listChildren(dir)\n  return entries\n    .filter((e) => e && e.type === 'dir')\n    .map((e) => ({ name: e.name, path: e.path }))\n    .sort((a, b) => a.name.localeCompare(b.name, 'fr'))\n}\n\n/** Documents ZenRayMedia directement dans un dossier. */\nexport async function listDocuments(dir) {\n  const entries = await listChildren(dir)\n  return entries\n    .filter((e) => e && e.type !== 'dir' && isZMediaPath(e.path || e.name))\n    .map((e) => ({ name: String(e.name).replace(ZMEDIA_EXT, ''), path: e.path }))\n    .sort((a, b) => a.name.localeCompare(b.name, 'fr'))\n}\n\n/** Segments d'un chemin de dossier, pour l'affichage du fil d'Ariane. */\nexport function crumbsOf(dir) {\n  const parts = String(dir || '').split('/').filter(Boolean)\n  return parts.map((name, i) => ({ name, path: parts.slice(0, i + 1).join('/') }))\n}\n\nexport function parentOf(dir) {\n  const parts = String(dir || '').split('/').filter(Boolean)\n  return parts.length > 1 ? parts.slice(0, -1).join('/') : parts[0] || 'pages'\n}\n\nexport function dirOf(path) {\n  const i = String(path || '').lastIndexOf('/')\n  return i > 0 ? path.slice(0, i) : DEFAULT_MEDIA_DIR\n}\n// ZenRayMedia — persistance et journal.\n//\n// Choix assumé pour la V0 : localStorage. Zéro appel réseau, zéro quota GitHub, zéro dépendance\n// serveur -> zéro classe de bug entière. La publication vers Create reste une action EXPLICITE\n// (bouton), pas un enregistrement implicite : un brouillon raté n'a rien à faire dans le drive.\n\nimport { emptyBrief, makeId } from './contracts.js'\n\nconst KEY_PROJECTS = 'zrm:projects:v1'\nconst KEY_CURRENT = 'zrm:current:v1'\nconst KEY_LOG = 'zrm:log:v1'\nconst LOG_MAX = 60\n\nfunction read(key, fallback) {\n  try {\n    const raw = localStorage.getItem(key)\n    if (!raw) return fallback\n    const parsed = JSON.parse(raw)\n    return parsed ?? fallback\n  } catch { return fallback }\n}\n\nfunction write(key, value) {\n  try { localStorage.setItem(key, JSON.stringify(value)); return true } catch { return false }\n}\n\n// --- Projet de démonstration ---------------------------------------------------------------\n// Présent au premier lancement pour que l'application ne s'ouvre JAMAIS sur un écran vide :\n// une démonstration client commence par quelque chose à regarder, pas par un formulaire.\nexport const SEED_NOTES = `On croit que le goulot d'étranglement de la création, c'est l'idée. C'est faux : une idée s'écrit en dix minutes.\n\nCe qui prend des jours, c'est le trajet entre la note et l'objet publiable. Habillage, rythme, typographie, format, export. Ce trajet-là n'est presque jamais fait, et c'est précisément celui qu'une machine sait faire.\n\nUne identité visuelle n'est pas un mystère : c'est un ensemble fini de décisions. Palette, échelle typographique, grille, courbes, texture, rythme de coupe. Un ensemble fini de décisions, c'est un fichier de données.\n\nDonc on ne construit pas un éditeur de plus. On construit une machine à appliquer des directions artistiques à du contenu, et on la nourrit d'un catalogue.\n\nLe résultat tient en une ligne : un brief, mille formes. Change le thème, l'article devient une double page de magazine. Change le format, il devient un vertical de trente secondes.`\n\nexport function seedProject() {\n  const brief = {\n    ...emptyBrief(),\n    id: makeId('brief', 'seed-zenraymedia', 0),\n    title: 'Un brief, mille formes',\n    message: \"Le goulot d'étranglement de la création n'est pas l'idée, c'est la mise en forme.\",\n    audience: 'Créateurs et studios qui publient trop peu par rapport à ce qu’ils produisent',\n    register: 'créateur',\n    intent: 'convaincre',\n    constraints: { languages: ['fr'], maxDuration: null, mentions: [] },\n    evidence: [],\n    sources: [],\n  }\n  return { id: makeId('project', 'seed-zenraymedia', 0), brief, notes: SEED_NOTES, cut: null, themeId: null, formatId: null, seed: 1 }\n}\n\nexport function loadProjects() {\n  const list = read(KEY_PROJECTS, null)\n  if (Array.isArray(list) && list.length) return list\n  const seeded = [seedProject()]\n  write(KEY_PROJECTS, seeded)\n  return seeded\n}\n\nexport function saveProjects(projects) { return write(KEY_PROJECTS, projects) }\n\nexport function loadCurrentId() { return read(KEY_CURRENT, null) }\nexport function saveCurrentId(id) { return write(KEY_C