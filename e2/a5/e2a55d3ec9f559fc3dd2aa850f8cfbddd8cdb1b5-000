0p',\n    canvas: { w: 3840, h: 2160, dpi: 72 }, color: 'sRGB', measure: 56, safe: { top: 108, bottom: 108, sides: 192 },\n    delivery: { container: 'png', maxBytes: 16_000_000 }, overflow: 'shrink' },\n  { id: 'F-social-1200', fit: { mode: 'poster', maxBeats: 1 }, density: 1.8, kind: 'still', label: '1:1 · 1200', short: '1:1+',…13265 tokens truncated… groupId, patch) {\n  const groups = readGroups(composition).map((g) => (g.id === groupId ? { ...g, ...patch } : g))\n  return ecrireGroupes(composition, groups)\n}\n\n/** Retire un groupe ET tout ce qu'il contient — distinct de `ungroupLayers`, qui les libère. */\nexport function removeGroup(composition, groupId) {\n  const layers = readLayers(composition).filter((l) => l.groupId !== groupId)\n  const groups = readGroups(composition).filter((g) => g.id !== groupId)\n  return ecrireGroupes({ ...composition, layers }, groups)\n}\n\n// ═══════════════════════════════════════════════════════════════════════════════════════════════\n// FAMILLE POWERPOINT 1 · STRUCTURE, DIAPOSITIVES ET SYSTÈME DE CONCEPTION (carte P1, 2026-08-06)\n//\n// « Ajouter, supprimer, réordonner, appliquer des dispositions » — mais ZenRayMedia n'a jamais eu\n// qu'UN SEUL canevas par thème (`project.compositions[themeId]`), jamais une SÉQUENCE de canevas.\n// Rouvrir cette forme (en faire un TABLEAU de compositions) referait ce que la carte C1 a réglé\n// une fois pour toutes le 2026-08-01 : un contrat qui s'ouvre une deuxième fois coûte des jours.\n//\n// LA DIAPOSITIVE EST DONC UN GROUPE DÉDIÉ (carte P5), pas un second modèle de canevas. Chaque\n// diapositive porte un `groupId` qui lui est propre ; ses membres ne s'affichent QUE si elle est\n// ACTIVE (`composition.activeSlideId`). Un calque SANS diapositive — libre, ou dans un groupe\n// ordinaire qui n'en est pas une — reste visible sur TOUTES les diapositives : c'est très\n// exactement le rôle du MASQUE des diapositives, obtenu sans aucun concept neuf. Traduit dans\n// l'usage réel de VISION.md, une diapositive EST un panneau de carrousel Instagram.\n//\n// Portée assumée, hors périmètre pour cette carte : les DISPOSITIONS (layouts pré-remplis à\n// l'ajout) et les SECTIONS (regroupement de plusieurs diapositives) n'ont pas d'équivalent minimal\n// ici ; une diapositive neuve part vide, l'utilisateur y pose ses calques comme sur n'importe quel\n// canevas. La vue Trieuse se limite à une LISTE (pas des vignettes visuelles rendues), un rendu\n// miniature de chaque diapositive coûterait une recompilation par ligne pour un gain marginal.\n\n/** Les diapositives d'une composition, chacune adossée à un groupe qui doit encore exister. */\nexport function readSlides(composition) {\n  const brut = composition?.slides\n  if (!Array.isArray(brut)) return []\n  const groupes = new Set(readGroups(composition).map((g) => g.id))\n  return brut\n    .filter((s) => s && typeof s.id === 'string' && typeof s.groupId === 'string' && groupes.has(s.groupId))\n    .map((s) => ({ id: s.id, name: typeof s.name === 'string' && s.name ? s.name : 'Diapositive', groupId: s.groupId }))\n}\n\n/** Crée une diapositive neuve (groupe dédié vide) et l'active. */\nexport function addSlide(composition, name) {\n  const serial = (composition?.serial || 0) + 1\n  const seed = `${composition?.themeId || 'sans-theme'}:diapositive`\n  const groupId = makeId('grp', seed, serial)\n  const slideId = makeId('sld', seed, serial)\n  const libelle = name || `Diapositive ${readSlides(composition).length + 1}`\n  const groups = [...readGroups(composition), { id: groupId, name: libelle, hidden: false, locked: false }]\n  const slides = [...readSlides(composition), { id: slideId, name: libelle, groupId }]\n  return { ...composition, serial, groups, slides, activeSlideId: slideId }\n}\n\n/** Retire une diapositive ET son contenu ; active une voisine s'il en reste. */\nexport function removeSlide(composition, slideId) {\n  const slides = readSlides(composition)\n  const index = slides.findIndex((s) => s.id === slideId)\n  if (index < 0) return composition\n  const suivant = removeGroup(composition, slides[index].groupId)\n  const restantes = slides.filter((s) => s.id !== slideId)\n  const activeSlideId = composition.activeSlideId === slideId\n    ? (restantes[index] || restantes[index - 1] || null)?.id ?? null\n    : composition.activeSlideId\n  return { ...suivant, slides: restantes, activeSlideId }\n}\n\n/** Duplique une diapositive et tout son contenu, dans un groupe neuf, et l'active. */\nexport function duplicateSlide(composition, slideId) {\n  const slides = readSlides(composition)\n  const slide = slides.find((s) => s.id === slideId)\n  if (!slide) return composition\n  const membres = readLayers(composition).filter((l) => l.groupId === slide.groupId)\n  const seed = `${composition?.themeId || 'sans-theme'}:diapositive`\n  let serial = composition?.serial || 0\n  let z = nextZ(composition)\n  serial += 1\n  const groupId = makeId('grp', seed, serial)\n  const slideIdCopie = makeId('sld', `${seed}:copie`, serial)\n  const nom = `${slide.name} copie`\n  const nouveauxCalques = membres.map((m) => {\n    serial += 1\n    z += 1\n    return { ...m, id: makeId('lay', `${seed}:calque`, serial), serial, z, groupId }\n  })\n  const groups = [...readGroups(composition), { id: groupId, name: nom, hidden: false, locked: false }]\n  return {\n    ...composition,\n    serial,\n    layers: [...readLayers(composition), ...nouveauxCalques],\n    groups,\n    slides: [...slides, { id: slideIdCopie, name: nom, groupId }],\n    activeSlideId: slideIdCopie,\n  }\n}\n\n/** Déplace une diapositive d'un rang dans l'ordre de la Trieuse — jamais hors bornes. */\nexport function reorderSlide(composition, slideId, direction) {\n  const slides = readSlides(composition)\n  const i = slides.findIndex((s) => s.id === slideId)\n  if (i < 0) return composition\n  const j = direction === 'up' ? i - 1 : i + 1\n  if (j < 0 || j >= slides.length) return composition\n  const suivant = [...slides]\n  ;[suivant[i], suivant[j]] = [suivant[j], suivant[i]]\n  return { ...composition, slides: suivant }\n}\n\n/** Change la diapositive active, celle que l'aperçu affiche seule. */\nexport function setActiveSlide(composition, slideId) {\n  if (!readSlides(composition).some((s) => s.id === slideId)) return composition\n  return { ...composition, activeSlideId: slideId }\n}\n\n/** Un calque est effectivement masqué s'il l'est lui-même, si son groupe l'est, OU s'il appartient\n * à une diapositive qui n'est pas l'active — un calque sans diapositive reste un masque visible\n * sur toutes les diapositives. */\nexport function isEffectivelyHidden(composition, layer) {\n  if (layer.hidden) return true\n  if (!layer.groupId) return false\n  if (readGroups(composition).find((g) => g.id === layer.groupId)?.hidden) return true\n  const slides = readSlides(composition)\n  if (composition?.activeSlideId && slides.some((s) => s.id === composition.activeSlideId)) {\n    const slide = slides.find((s) => s.groupId === layer.groupId)\n    if (slide && slide.id !== composition.activeSlideId) return true\n  }\n  return false\n}\n\nexport function isEffectivelyLocked(composition, layer) {\n  if (layer.locked) return true\n  if (!layer.groupId) return false\n  return !!readGroups(composition).find((g) => g.id === layer.groupId)?.locked\n}\n\n// ═══════════════════════════════════════════════════════════════════════════════════════════════\n// FAMILLE FIGMA 3 · CONTRAINTES (carte F3, 2026-08-04)\n//\n// « Lorsque la frame est redimensionnée, l'enfant reste attaché, centré, étiré ou mis à l'échelle\n// selon le réglage. » Le canevas de ZenRayMedia change de taille chaque fois qu'on change de\n// FORMAT (carré, 9:16, A4…) : sans contrainte, un logo posé en haut à gauche d'un carré 1080\n// resterait à la même position en pixels dans un A4 de 2480 px de large, donc visuellement\n// rétréci dans un coin, jamais là où l'auteur l'avait posé PAR RAPPORT au cadre.\n// ═══════════════════════════════════════════════════════════════════════════════════════════════\n\n/**\n * La géométrie d'un calque après un changement des dimensions du canevas.\n * Fonction PURE : mêmes entrées, même sortie, aucune dépendance à React ni au DOM.\n */\nexport function applyConstraints(layer, oldCanvas, newCanvas) {\n  const dW = newCanvas.w - oldCanvas.w\n  const dH = (newCanvas.h || oldCanvas.h) - oldCanvas.h\n  let { x, y, w, h } = layer\n\n  if (layer.constrainH === 'right') x = layer.x + dW\n  else if (layer.constrainH === 'center') x = layer.x + dW / 2\n  else if (layer.constrainH === 'scale' && oldCanvas.w > 0) {\n    const echelle = newCanvas.w / oldCanvas.w\n    x = layer.x * echelle; w = layer.w * echelle\n  }\n  // 'left' : x et w ne bougent pas, la distance au bord gauche est ce qui reste fixe.\n\n  if (oldCanvas.h > 0 && newCanvas.h > 0) {\n    if (layer.constrainV === 'bottom') y = layer.y + dH\n    else if (layer.constrainV === 'center') y = layer.y + dH / 2\n    else if (layer.constrainV === 'scale') {\n      const echelleV = newCanvas.h / oldCanvas.h\n      y = layer.y * echelleV; h = layer.h * echelleV\n    }\n  }\n  // Un canevas à hauteur LIBRE (format web, sans oldCanvas.h/newCanvas.h) n'a pas de bord bas à\n  // mesurer : la contrainte verticale ne peut alors s'appliquer, et 'top' reste le seul sens.\n\n  return { x: Math.round(x), y: Math.round(y), w: Math.max(1, Math.round(w)), h: Math.max(1, Math.round(h)) }\n}\n\n    const cible = idPourPanneau\n    if (!cible || !chemin) return\n    patchComposition((current) => {\n      const trouve = trouverPieceOuCalque(current, cible)\n      if (!trouve) return current\n      const nodes = { ...(trouve.props?.__nodes || {}) }\n      const avant = nodes[chemin] || {}\n      nodes[chemin] = {\n        ...avant,\n        ...patch,\n        // Le style se fusionne champ par champ : régler la couleur ne doit pas effacer le corps.\n        style: patch.style ? { ...(avant.style || {}), ...patch.style } : avant.style,\n   