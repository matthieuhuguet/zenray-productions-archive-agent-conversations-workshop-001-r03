{"timestamp":"2026-08-05T16:24:40.469Z","ordinal":355,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd2bd-c715-7790-ad41-00ffade46b9f","call_id":"call_OorcsIbPoWvfaz0lDdziYI1o","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"===== src/zenraymedia/componentCatalog.js =====\n     1\t// ZenRayMedia — catalogue de composants construit depuis les registres déjà présents.\n     2\t// Vite produit un chunk par registre/partie : ouvrir Media ne télécharge que le thème actif,\n     3\t// jamais les 162 composants d'un coup.\n     4\t\n     5\timport tokens0111 from './themes/T-01-1-1--une-nationale-du-matin/tokens.css?raw'\n     6\timport tokens0112 from './themes/T-01-1-2--une-de-rupture/tokens.css?raw'\n     7\timport tokens0113 from './themes/T-01-1-3--quotidien-de-reference-sobre/tokens.css?raw'\n     8\timport tokens0114 from './themes/T-01-1-4--quotidien-economique-saumon/tokens.css?raw'\n     9\timport tokens0115 from './themes/T-01-1-5--tabloid-daccroche/tokens.css?raw'\n    10\timport tokens0411 from './themes/T-04-1-1--revelation-cinematique/tokens.css?raw'\n    11\t\n    12\tconst registries = import.meta.glob('./themes/*/component-registry.json', { import: 'default' })\n    13\tconst parts = import.meta.glob('./themes/*/parts/*.html', { query: '?raw', import: 'default' })\n    14\tconst tokenSheets = {\n    15\t  'T-01-1-1': tokens0111,\n    16\t  'T-01-1-2': tokens0112,\n    17\t  'T-01-1-3': tokens0113,\n    18\t  'T-01-1-4': tokens0114,\n    19\t  'T-01-1-5': tokens0115,\n    20\t  'T-04-1-1': tokens0411,\n    21\t}\n    22\t\n    23\tfunction themeDirectory(themeId) {\n    24\t  const prefix = `./themes/${themeId}--`\n    25\t  const key = Object.keys(registries).find((path) => path.startsWith(prefix))\n    26\t  return key ? key.slice('./themes/'.length, key.indexOf('/component-registry.json')) : null\n    27\t}\n    28\t\n    29\texport async function loadThemeComponents(themeId) {\n    30\t  const directory = themeDirectory(themeId)\n    31\t  if (!directory) return { themeId, directory: null, components: [], tokensCss: '', definitionsHtml: '' }\n    32\t\n    33\t  const registryKey = `./themes/${directory}/component-registry.json`\n    34\t  const registry = await registries[registryKey]()\n    35\t  const tokensCss = tokenSheets[themeId] || ''\n    36\t\n    37\t  const entries = Array.isArray(registry) ? registry : (registry.components || [])\n    38\t  const components = await Promise.all(entries.map(async (entry) => {\n    39\t    // Le registre pointe vers les pages de documentation autonomes `components/`. L'éditeur\n    40\t    // charge leurs homologues légers `parts/`, faits pour être assemblés dans une même page.\n    41\t    const key = `./themes/${directory}/parts/${String(entry.file).split('/').pop()}`\n    42\t    const html = parts[key] ? await parts[key]() : ''\n    43\t    return { ...entry, html }\n    44\t  }))\n    45\t  const definitionsHtml = components.find((entry) => entry.id === '00-icons')?.html || ''\n    46\t  return { themeId, directory, components, tokensCss, definitionsHtml }\n    47\t}\n    48\t\n    49\texport function groupComponents(components) {\n    50\t  return (components || []).reduce((groups, component) => {\n    51\t    const key = component.group || 'Autres'\n    52\t    ;(groups[key] = groups[key] || []).push(component)\n    53\t    return groups\n    54\t  }, {})\n    55\t}\n"},{"type":"input_text","text":"===== src/zenraymedia/themes/registry.js =====\n     1\t// ZenRayMedia — L4 : le registre de thèmes.\n     2\t//\n     3\t// C'EST LA PIÈCE D'EXTENSIBILITÉ. Elle répond à la contrainte : « je vais t'ajouter des thèmes\n     4\t// au compte-goutte, à terme au moins 1024 HTML interchangeables ».\n     5\t//\n     6\t// Deux formes de thème, découvertes AUTOMATIQUEMENT par Vite, sans jamais toucher au code :\n     7\t//\n     8\t//   1. `T-FF-S-V.theme.js`            -> thème à tokens (les 7 groupes de 01-PLAN §10.2).\n     9\t//   2. `T-FF-S-V--mon-slug.html`      -> gabarit HTML brut (celui que tu produis à la main).\n    10\t//\n    11\t// Déposer un fichier dans ce dossier SUFFIT : il apparaît dans le Deck au prochain build.\n    12\t//\n    13\t// COÛT À L'ÉCHELLE (décision d'architecture, pas une optimisation) : les métadonnées d'un\n    14\t// thème HTML sont dérivées de son NOM DE FICHIER, jamais de son contenu. Lire 1024 fichiers\n    15\t// HTML pour construire la liste ferait entrer des mégaoctets dans le bundle. Ici, lister\n    16\t// 1024 thèmes coûte 1024 chaînes de caractères ; seul le thème RÉELLEMENT choisi est chargé.\n    17\t\n    18\timport { parseThemeFileName, parseThemeId, FAMILIES } from '../taxonomy.js'\n    19\timport { validate } from '../contracts.js'\n    20\timport { defaultFontFor } from '../themeFonts.js'\n    21\t\n    22\t// Thèmes à tokens : peu nombreux, curatés, chargés d'emblée (quelques kilo-octets).\n    23\tconst JS_THEMES = import.meta.glob('./*.theme.js', { eager: true })\n    24\t// Gabarits HTML : potentiellement des centaines. Chargement PARESSEUX, un par un.\n    25\tconst HTML_THEMES = import.meta.glob('./*.html', { query: '?raw', import: 'default' })\n    26\t\n    27\tfunction entriesFromJs() {\n    28\t  const out = []\n    29\t  for (const [path, mod] of Object.entries(JS_THEMES)) {\n    30\t    const theme = mod?.default\n    31\t    if (!theme?.id) continue\n    32\t    const parsed = parseThemeId(theme.id)\n    33\t    if (!parsed) continue\n    34\t    out.push({\n    35\t      id: theme.id,\n    36\t      name: theme.name || parsed.id,\n    37\t      description: theme.description || '',\n    38\t      family: parsed.family,\n    39\t      familyLabel: parsed.familyLabel,\n    40\t      sub: parsed.sub,\n    41\t      variant: parsed.variant,\n    42\t      formats: Array.isArray(theme.formats) ? theme.formats : ['F-web-article'],\n    43\t      source: 'js',\n    44\t      path,\n    45\t    })\n    46\t  }\n    47\t  return out\n    48\t}\n    49\t\n    50\tfunction entriesFromHtml() {\n    51\t  const out = []\n    52\t  for (const path of Object.keys(HTML_THEMES)) {\n    53\t    const parsed = parseThemeFileName(path)\n    54\t    if (!parsed) {\n    55\t      // Nom de fichier hors contrat : on l'ignore SILENCIEUSEMENT côté produit, mais on le\n    56\t      // signale en console pour que l'auteur du gabarit comprenne pourquoi il n'apparaît pas.\n    57\t      if (typeof console !== 'undefined') console.warn(`[zenraymedia] gabarit ignoré (nom attendu : T-FF-S-V--slug.html) : ${path}`)\n    58\t      continue\n    59\t    }\n    60\t    out.push({\n    61\t      id: parsed.id,\n    62\t      name: parsed.name,\n    63\t      description: `Gabarit HTML — ${parsed.familyLabel}.`,\n    64\t      family: parsed.family,\n    65\t      familyLabel: parsed.familyLabel,\n    66\t      sub: parsed.sub,\n    67\t      variant: parsed.variant,\n    68\t      formats: ['F-web-article'],\n    69\t      source: 'html',\n    70\t      path,\n    71\t    })\n    72\t  }\n    73\t  return out\n    74\t}\n    75\t\n    76\t// Liste complète, triée par identifiant. Les thèmes à tokens gagnent en cas de doublon d'id :\n    77\t// un gabarit HTML ne doit pas pouvoir masquer un thème curaté.\n    78\texport function listThemes() {\n    79\t  const js = entriesFromJs()\n    80\t  const taken = new Set(js.map((e) => e.id))\n    81\t  const html = entriesFromHtml().filter((e) => !taken.has(e.id))\n    82\t  return [...js, ...html].sort((a, b) => a.id.localeCompare(b.id))\n    83\t}\n    84\t\n    85\texport function listFamilies() {\n    86\t  const present = new Set(listThemes().map((e) => e.family))\n    87\t  return Object.entries(FAMILIES)\n    88\t    .filter(([code]) => present.has(code))\n    89\t    .map(([code, label]) => ({ code, label, count: listThemes().filter((e) => e.family === code).length }))\n    90\t}\n    91\t\n    92\texport function findEntry(id) { return listThemes().find((e) => e.id === id) || null }\n    93\t\n    94\t// En-tête déclaratif OPTIONNEL d'un gabarit HTML, en tête de fichier :\n    95\t//\n    96\t//   <!--zr-theme { \"description\": \"...\", \"formats\": [\"F-web-article\",\"F-print-a4\"],\n    97\t//                  \"beatCount\": { \"min\": 3, \"max\": 12 }, \"measure\": 64 } -->\n    98\t//\n    99\t// Sans lui, le gabarit reste parfaitement valide et prend les valeurs neutres ci-dessous :\n   100\t// c'est le chemin le plus court pour déposer un fichier. Avec lui, un gabarit reconstruit à\n   101\t// partir de captures d'écran déclare les formats qu'il sait VRAIMENT servir au lieu d'être\n   102\t// cantonné au web. L'en-tête est lu APRÈS chargement du fichier : il ne coûte donc rien au\n   103\t// listing du catalogue, qui ne lit que les noms de fichiers -- c'est ce qui tient à 1024.\n   104\texport function readThemeHeader(html) {\n   105\t  const match = /<!--\\s*zr-theme\\s*([\\s\\S]*?)-->/i.exec(String(html || ''))\n   106\t  if (!match) return {}\n   107\t  try {\n   108\t    const parsed = JSON.parse(match[1].trim())\n   109\t    return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {}\n   110\t  } catch {\n   111\t    // Un en-tête malformé ne doit JAMAIS empêcher le gabarit de fonctionner : on le signale\n   112\t    // à l'auteur et on repart des valeurs neutres.\n   113\t    if (typeof console !== 'undefined') console.warn('[zenraymedia] en-tête <!--zr-theme …--> illisible (JSON invalide) : valeurs par défaut appliquées.')\n   114\t    return {}\n   115\t  }\n   116\t}\n   117\t\n   118\t// Groupes par défaut d'un gabarit HTML : il apporte sa mise en page, pas ses tokens.\n   119\t// Ces valeurs neutres existent pour que `validateTheme` passe et que le Critique ait des\n   120\t// seuils à vérifier, jamais pour imposer un style au gabarit.\n   121\tfunction htmlThemeShell(entry, html) {\n   122\t  return {\n   123\t    id: entry.id,\n   124\t    name: entry.name,\n   125\t    description: entry.description,\n   126\t    calibration: { ref: '', notes: '' },\n   127\t    formats: entry.formats,\n   128\t    beatCount: { min: 1, max: 24 },\n   129\t    surface: { background: '#ffffff', backgroundDark: '#0f1012', grain: 0, vignette: 0, texture: 'none', shadow: 'none' },\n   130\t    palette: { ink: 'rgba(20,22,26,.92)', inkDark: 'rgba(244,245,247,.92)', muted: 'rgba(20,22,26,.60)', mutedDark: 'rgba(244,245,247,.54)', rule: 'rgba(20,22,26,.12)', ruleDark: 'rgba(244,245,247,.14)', accent: '#1a1a1a', accentDark: '#f4f5f7', minContrast: 4.5 },\n   131\t    typography: { body: \"'AnthropicSans', system-ui, sans-serif\", display: \"'AnthropicSans', system-ui, sans-serif\", mono: \"'AnthropicMono', ui-monospace, monospace\", scale: { base: 17, ratio: 1.25, steps: { h1: 3, h2: 2, h3: 1, body: 0, small: -1 } }, lineHeight: { body: 1.55, display: 1.15 }, tracking: { display: '-0.02em', body: '0em', mono: '0.06em' }, measure: 66, weights: { body: 400, display: 500, emphasis: 500 }, case: { display: 'none', label: 'none' } },\n   132\t    grid: { columns: 1, gutter: 0, margin: { top: 72, bottom: 96, sides: 24 }, rhythm: 8, align: 'left', maxWidth: 760 },\n   133\t    motion: { enabled: false, ease: 'cubic-bezier(.16,1,.3,1)', enter: 0, stagger: 0, cut: 'none' },\n   134\t    chrome: { kicker: true, byline: true, readingTime: true, rules: false, dropCap: false, footer: true, numbering: false },\n   135\t    sound: { bed: null, bedLufs: null, cues: [], allowed: [] },\n   136\t    html,\n   137\t  }\n   138\t}\n   139\t\n   140\tconst cache = new Map()\n   141\t\n   142\t// Charge un thème et le VALIDE avant de le rendre. Un thème invalide ne doit jamais atteindre\n   143\t// le compilateur : il produirait une page cassée sans dire pourquoi.\n   144\texport async function loadTheme(id) {\n   145\t  if (cache.has(id)) return cache.get(id)\n   146\t  const entry = findEntry(id)\n   147\t  if (!entry) throw new Error(`Thème introuvable : ${id}`)\n   148\t\n   149\t  let theme\n   150\t  if (entry.source === 'js') {\n   151\t    theme = JS_THEMES[entry.path]?.default\n   152\t  } else {\n   153\t    const loader = HTML_THEMES[entry.path]\n   154\t    if (!loader) throw new Error(`Gabarit introuvable : ${entry.path}`)\n   155\t    const raw = await loader()\n   156\t    const html = String(raw || '')\n   157\t    theme = htmlThemeShell(entry, html)\n   158\t    // L'en-tête n'a AUCUN droit sur l'identité : ni sur l'id (il vient du nom de fichier, seule\n   159\t    // source de vérité du catalogue), ni sur le nom public (règle anti-marque, 02-RISQUES R5).\n   160\t    // Il n'enrichit que ce que le gabarit sait de lui-même.\n   161\t    const header = readThemeHeader(html)\n   162\t    if (typeof header.description === 'string') theme.description = header.description\n   163\t    if (Array.isArray(header.formats) && header.formats.length) theme.formats = header.formats\n   164\t    if (header.beatCount && Number.isFinite(header.beatCount.min) && Number.isFinite(header.beatCount.max)) {\n   165\t      theme.beatCount = { min: header.beatCount.min, max: header.beatCount.max }\n   166\t    }\n   167\t    if (Number.isFinite(header.measure)) theme.typography = { ...theme.typography, measure: header.measure }\n   168\t    if (header.calibration && typeof header.calibration === 'object') theme.calibration = header.calibration\n   169\t    // Polices déclarées par le gabarit. Elles sont servies pour l'aperçu et embarquées à l'export ;\n   170\t    // celles qui ne sont pas installées retombent proprement sur leur pile système (fonts.js).\n   171\t    if (Array.isArray(header.fonts) && header.fonts.length) theme.fonts = header.fonts\n   172\t    // Sans déclaration, le gabarit hérite de la police de SA SOUS-FAMILLE (themeFonts.js).\n   173\t    // Un thème de presse quotidienne reçoit ainsi un serif de labeur et un thème de chaîne\n   174\t    // d'info un condensé, sans que l'auteur ait à y penser — et il garde le droit de choisir.\n   175\t    else { const fallback = defaultFontFor(entry.id); if (fallback) theme.fonts = [fallback] }\n   176\t    if (header.typography && typeof header.typography === 'object') theme.typography = { ...theme.typography, ...header.typography }\n   177\t  }\n   178\t\n   179\t  const errors = validate('theme', theme)\n   180\t  if (errors.length) throw new Error(`Thème ${id} invalide : ${errors.map((e) => e.message).join(' · ')}`)\n   181\t  cache.set(id, theme)\n   182\t  return theme\n   183\t}\n   184\t\n   185\t// Le quotidien de référence est le premier thème doté du contrat complet\n   186\t// thème → groupes → composants : l'atelier Lego ne doit jamais s'ouvrir vide.\n   187\texport const DEFAULT_THEME_ID = 'T-01-1-3'\n"},{"type":"input_text","text":"===== src/zenraymedia/htmlTemplate.js =====\n     1\t// ZenRayMedia — moteur de gabarit pour les thèmes HTML déposés à la main.\n     2\t//\n     3\t// Contrat volontairement MINUSCULE (4 constructions, pas une de plus). Un moteur de gabarit\n     4\t// riche est une source de bugs sans fin ; ici tout ce qui n'est pas listé est laissé tel quel.\n     5\t//\n     6\t//   {{champ}}                 — valeur échappée\n     7\t//   {{{champ}}}               — valeur brute (HTML déjà sûr, produit par nous)\n     8\t//   {{#beats}} … {{/beats}}   — répétition sur la liste des beats\n     9\t//   {{^beats}} … {{/beats}}   — bloc affiché si la liste est vide\n    10\t//\n    11\t// Dans un bloc `beats`, les champs disponibles sont : index, number, role, roleLabel, text,\n    12\t// html, duration, weight, tempo, isFirst, isLast.\n    13\t\n    14\texport function escapeHtml(value) {\n    15\t  return String(value ?? '')\n    16\t    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')\n    17\t    .replace(/\"/g, '&quot;').replace(/'/g, '&#39;')\n    18\t}\n    19\t\n    20\tfunction lookup(scope, path) {\n    21\t  if (path === '.') return scope\n    22\t  let cur = scope\n    23\t  for (const key of path.split('.')) {\n    24\t    if (cur == null) return ''\n    25\t    cur = cur[key]\n    26\t  }\n    27\t  return cur == null ? '' : cur\n    28\t}\n    29\t\n    30\t// Analyseur à PASSE UNIQUE.\n    31\t//\n    32\t// Bug réel corrigé le 2026-07-25, trouvé par le test : une première version résolvait les\n    33\t// sections d'abord, puis les champs à la toute fin, contre la portée RACINE. Résultat, `{{role}}`\n    34\t// et `{{text}}` à l'intérieur d'un bloc `{{#beats}}` sortaient vides : la portée du beat courant\n    35\t// n'existait plus au moment de la substitution. Une passe unique qui descend avec sa portée est\n    36\t// la seule forme correcte -- et elle interdit du même coup la double interprétation d'une valeur\n    37\t// qui contiendrait elle-même des accolades.\n    38\tconst TAG = /\\{\\{(\\{)?\\s*([#^/]?)\\s*([\\w.]+)\\s*(\\})?\\}\\}/g\n    39\t\n    40\tfunction renderScope(template, scope, depth = 0) {\n    41\t  if (depth > 16) return '' // gabarit pathologiquement imbriqué : on s'arrête proprement\n    42\t  const tpl = String(template)\n    43\t  let out = ''\n    44\t  let cursor = 0\n    45\t  TAG.lastIndex = 0\n    46\t  let match\n    47\t\n    48\t  while ((match = TAG.exec(tpl)) !== null) {\n    49\t    const [raw, openBrace, kind, name, closeBrace] = match\n    50\t    out += tpl.slice(cursor, match.index)\n    51\t    cursor = match.index + raw.length\n    52\t\n    53\t    if (kind === '#' || kind === '^') {\n    54\t      // Cherche la balise de fermeture correspondante, en comptant les imbrications de MÊME nom.\n    55\t      const close = `{{/${name}}}`\n    56\t      const open = kind === '#' ? `{{#${name}}}` : `{{^${name}}}`\n    57\t      let level = 1\n    58\t      let scan = cursor\n    59\t      let bodyEnd = -1\n    60\t      while (scan < tpl.length) {\n    61\t        const nextClose = tpl.indexOf(close, scan)\n    62\t        if (nextClose === -1) break\n    63\t        const nextOpenHash = tpl.indexOf(`{{#${name}}}`, scan)\n    64\t        const nextOpenCaret = tpl.indexOf(`{{^${name}}}`, scan)\n    65\t        const candidates = [nextOpenHash, nextOpenCaret].filter((i) => i !== -1 && i < nextClose)\n    66\t        if (candidates.length) { level++; scan = Math.min(...candidates) + open.length; continue }\n    67\t        level--\n    68\t        if (level === 0) { bodyEnd = nextClose; break }\n    69\t        scan = nextClose + close.length\n    70\t      }\n    71\t      // Section jamais fermée : on ignore la balise et on continue. Jamais d'exception, jamais\n    72\t      // de boucle -- un gabarit déposé à la main a le droit d'être imparfait.\n    73\t      if (bodyEnd === -1) continue\n    74\t\n    75\t      const body = tpl.slice(cursor, bodyEnd)\n    76\t      cursor = bodyEnd + close.length\n    77\t\n    78\t      const value = lookup(scope, name)\n    79\t      const list = Array.isArray(value) ? value : (value ? [value] : [])\n    80\t      if (kind === '^') {\n    81\t        out += list.length === 0 ? renderScope(body, scope, depth + 1) : ''\n    82\t      } else {\n    83\t        out += list.map((item, i) => {\n    84\t          const child = (item && typeof item === 'object')\n    85\t            ? { ...scope, ...item, index: i, number: i + 1, isFirst: i === 0, isLast: i === list.length - 1 }\n    86\t            : { ...scope, value: item, index: i, number: i + 1, isFirst: i === 0, isLast: i === list.length - 1 }\n    87\t          return renderScope(body, child, depth + 1)\n    88\t        }).join('')\n    89\t      }\n    90\t      TAG.lastIndex = cursor\n    91\t      continue\n    92\t    }\n    93\t\n    94\t    if (kind === '/') continue // fermeture orpheline : ignorée\n    95\t\n    96\t    const value = lookup(scope, name)\n    97\t    out += (openBrace && closeBrace) ? String(value) : escapeHtml(value)\n    98\t  }\n    99\t\n   100\t  return out + tpl.slice(cursor)\n   101\t}\n   102\t\n   103\texport function renderTemplate(template, data) {\n   104\t  if (typeof template !== 'string') throw new TypeError('renderTemplate : gabarit attendu sous forme de chaîne.')\n   105\t  return renderScope(template, data || {})\n   106\t}\n   107\t\n   108\t// Un gabarit HTML doit consommer au moins le titre et les beats, sinon le contenu du brief\n   109\t// n'apparaît nulle part et le thème est muet. Contrôle appliqué au chargement, pas au rendu.\n   110\texport function inspectTemplate(template) {\n   111\t  const tpl = String(template || '')\n   112\t  return {\n   113\t    usesTitle: /\\{\\{\\{?\\s*title\\s*\\}?\\}\\}/.test(tpl),\n   114\t    usesBeats: /\\{\\{#\\s*beats\\s*\\}\\}/.test(tpl),\n   115\t    hasHtmlSkeleton: /<html[\\s>]/i.test(tpl),\n   116\t  }\n   117\t}\n"},{"type":"input_text","text":"===== src/zenraymedia/taxonomy.js =====\n     1\t// ZenRayMedia — taxonomie du catalogue (docs/zenraymedia/05-THEMES-1024-A..D.md).\n     2\t// Sert à résoudre un identifiant `T-FF-S-V` en libellés lisibles SANS charger le thème :\n     3\t// c'est ce qui permet d'afficher 1024 entrées dans le Deck à coût nul.\n     4\t\n     5\texport const FAMILIES = {\n     6\t  '01': 'Presse & éditorial',\n     7\t  '02': 'Télévision & broadcast',\n     8\t  '03': 'Cinéma & trailer',\n     9\t  '04': 'Jeu vidéo',\n    10\t  '05': 'Publicité & retail',\n    11\t  '06': 'Luxe & mode',\n    12\t  '07': 'Social vertical',\n    13\t  '08': 'Créateur & YouTube',\n    14\t  '09': 'Musique & sound',\n    15\t  '10': 'Tech & produit',\n    16\t  '11': 'Corporate & institution',\n    17\t  '12': 'Science & pédagogie',\n    18\t  '13': 'Sport & compétition',\n    19\t  '14': 'Événement & affiche',\n    20\t  '15': 'Architecture, design & art',\n    21\t  '16': 'Japon & Asie',\n    22\t}\n    23\t\n    24\t// Registre dominant par famille — pilote la suggestion de thèmes depuis le brief (ZM-L2-11).\n    25\texport const FAMILY_REGISTER = {\n    26\t  '01': 'presse', '02': 'presse', '03': 'divertissement', '04': 'divertissement',\n    27\t  '05': 'promotionnel', '06': 'luxe', '07': 'créateur', '08': 'créateur',\n    28\t  '09': 'divertissement', '10': 'technique', '11': 'institutionnel', '12': 'pédagogique',\n    29\t  '13': 'divertissement', '14': 'promotionnel', '15': 'luxe', '16': 'divertissement',\n    30\t}\n    31\t\n    32\texport const THEME_ID_RE = /^T-(\\d{2})-([1-8])-([1-8])$/\n    33\t\n    34\texport function parseThemeId(id) {\n    35\t  const m = THEME_ID_RE.exec(String(id || ''))\n    36\t  if (!m) return null\n    37\t  return { id, family: m[1], sub: Number(m[2]), variant: Number(m[3]), familyLabel: FAMILIES[m[1]] || 'Famille inconnue' }\n    38\t}\n    39\t\n    40\texport function isThemeId(id) { return THEME_ID_RE.test(String(id || '')) }\n    41\t\n    42\t// `T-01-3-2--lecture-pure` -> { id, slug: 'lecture-pure', name: 'Lecture pure' }\n    43\texport function parseThemeFileName(fileName) {\n    44\t  const base = String(fileName).replace(/^.*\\//, '').replace(/\\.(html|theme\\.js)$/i, '')\n    45\t  const [rawId, ...rest] = base.split('--')\n    46\t  const parsed = parseThemeId(rawId)\n    47\t  if (!parsed) return null\n    48\t  const slug = rest.join('--')\n    49\t  const name = slug ? slug.replace(/[-_]+/g, ' ').replace(/^./, (c) => c.toUpperCase()) : `Thème ${rawId}`\n    50\t  return { ...parsed, slug, name }\n    51\t}\n"},{"type":"input_text","text":"===== src/zenraymedia/themeFonts.js =====\n     1\t// ZenRayMedia — police par défaut de chacune des 128 sous-familles. GÉNÉRÉ, ne pas éditer.\n     2\t// Regénérer : node scripts/zrm-map-fonts.mjs\n     3\t//\n     4\t// 16 familles x 8 sous-familles = 128 sous-familles. Les huit variantes d'une sous-famille\n     5\t// partagent leur police : elles se distinguent par la graisse, l'échelle, la casse et\n     6\t// l'interlettrage, jamais par la famille typographique. 128 polices = une par sous-famille.\n     7\t//\n     8\t// L'affectation suit l'affinité d'archétype (presse -> labeur, télévision -> condensé,\n     9\t// luxe -> didone, jeu video -> technique), pas le goût. Un gabarit reste libre de déclarer une\n    10\t// autre police dans son en-tête zr-theme : cette table est un point de départ, pas une prison.\n    11\t\n    12\texport const SUBFAMILY_FONTS = {\n    13\t  \"01-1\": { font: \"Source Serif 4\", label: \"Quotidien national\", family: \"Presse & éditorial\" },\n    14\t  \"01-2\": { font: \"Spectral\", label: \"Magazine d'actualité hebdomadaire\", family: \"Presse & éditorial\" },\n    15\t  \"01-3\": { font: \"Lora\", label: \"Longform web & récit\", family: \"Presse & éditorial\" },\n    16\t  \"01-4\": { font: \"Merriweather\", label: \"Newsletter & infolettre\", family: \"Presse & éditorial\" },\n    17\t  \"01-5\": { font: \"PT Serif\", label: \"Presse spécialisée & technique\", family: \"Presse & éditorial\" },\n    18\t  \"01-6\": { font: \"Noto Serif\", label: \"Presse people & divertissement\", family: \"Presse & éditorial\" },\n    19\t  \"01-7\": { font: \"Crimson Text\", label: \"Presse gratuite & locale\", family: \"Presse & éditorial\" },\n    20\t  \"01-8\": { font: \"Cardo\", label: \"Presse d'opinion & tribune\", family: \"Presse & éditorial\" },\n    21\t  \"02-1\": { font: \"Archivo Narrow\", label: \"Info continue\", family: \"Télévision & broadcast\" },\n    22\t  \"02-2\": { font: \"Oswald\", label: \"Journal télévisé\", family: \"Télévision & broadcast\" },\n    23\t  \"02-3\": { font: \"Barlow Condensed\", label: \"Plateau & talk\", family: \"Télévision & broadcast\" },\n    24\t  \"02-4\": { font: \"Roboto Condensed\", label: \"Magazine documentaire TV\", family: \"Télévision & broadcast\" },\n    25\t  \"02-5\": { font: \"Fjalla One\", label: \"Météo & service\", family: \"Télévision & broadcast\" },\n    26\t  \"02-6\": { font: \"Anton\", label: \"Télé-achat & promotion\", family: \"Télévision & broadcast\" },\n    27\t  \"02-7\": { font: \"Bebas Neue\", label: \"Habillage de chaîne\", family: \"Télévision & broadcast\" },\n    28\t  \"02-8\": { font: \"Saira Condensed\", label: \"Direct événementiel\", family: \"Télévision & broadcast\" },\n    29\t  \"03-1\": { font: \"Playfair Display\", label: \"Teaser d'annonce\", family: \"Cinéma & trailer\" },\n    30\t  \"03-2\": { font: \"Bodoni Moda\", label: \"Bande-annonce principale\", family: \"Cinéma & trailer\" },\n    31\t  \"03-3\": { font: \"Prata\", label: \"Générique de début\", family: \"Cinéma & trailer\" },\n    32\t  \"03-4\": { font: \"DM Serif Display\", label: \"Générique de fin\", family: \"Cinéma & trailer\" },\n    33\t  \"03-5\": { font: \"Abril Fatface\", label: \"Film d'auteur & festival\", family: \"Cinéma & trailer\" },\n    34\t  \"03-6\": { font: \"Cormorant\", label: \"Blockbuster & franchise\", family: \"Cinéma & trailer\" },\n    35\t  \"03-7\": { font: \"Marcellus\", label: \"Horreur & thriller\", family: \"Cinéma & trailer\" },\n    36\t  \"03-8\": { font: \"Italiana\", label: \"Animation & famille\", family: \"Cinéma & trailer\" },\n    37\t  \"04-1\": { font: \"Orbitron\", label: \"Trailer d'annonce\", family: \"Jeu vidéo\" },\n    38\t  \"04-2\": { font: \"Rajdhani\", label: \"Trailer de gameplay\", family: \"Jeu vidéo\" },\n    39\t  \"04-3\": { font: \"Chakra Petch\", label: \"Trailer de lancement\", family: \"Jeu vidéo\" },\n    40\t  \"04-4\": { font: \"Michroma\", label: \"Habillage HUD & interface\", family: \"Jeu vidéo\" },\n    41\t  \"04-5\": { font: \"Audiowide\", label: \"Esport & compétition\", family: \"Jeu vidéo\" },\n    42\t  \"04-6\": { font: \"Saira\", label: \"Indépendant & pixel\", family: \"Jeu vidéo\" },\n    43\t  \"04-7\": { font: \"JetBrains Mono\", label: \"Mise à jour & saison\", family: \"Jeu vidéo\" },\n    44\t  \"04-8\": { font: \"IBM Plex Mono\", label: \"Édition collector & précommande\", family: \"Jeu vidéo\" },\n    45\t  \"05-1\": { font: \"Alfa Slab One\", label: \"Grande distribution & prospectus\", family: \"Publicité & retail\" },\n    46\t  \"05-2\": { font: \"Righteous\", label: \"Promotion & prix choc\", family: \"Publicité & retail\" },\n    47\t  \"05-3\": { font: \"Bungee\", label: \"Alimentaire & food\", family: \"Publicité & retail\" },\n    48\t  \"05-4\": { font: \"Titan One\", label: \"Automobile\", family: \"Publicité & retail\" },\n    49\t  \"05-5\": { font: \"Passion One\", label: \"Santé & pharmacie\", family: \"Publicité & retail\" },\n    50\t  \"05-6\": { font: \"Staatliches\", label: \"Télécom & énergie\", family: \"Publicité & retail\" },\n    51\t  \"05-7\": { font: \"Bowlby One\", label: \"Banque & assurance grand public\", family: \"Publicité & retail\" },\n    52\t  \"05-8\": { font: \"Ultra\", label: \"Immobilier & habitat\", family: \"Publicité & retail\" },\n    53\t  \"06-1\": { font: \"Gilda Display\", label: \"Défilé & collection\", family: \"Luxe & mode\" },\n    54\t  \"06-2\": { font: \"Tenor Sans\", label: \"Campagne de marque\", family: \"Luxe & mode\" },\n    55\t  \"06-3\": { font: \"Antic Didone\", label: \"Joaillerie & horlogerie\", family: \"Luxe & mode\" },\n    56\t  \"06-4\": { font: \"Yeseva One\", label: \"Parfum & beauté\", family: \"Luxe & mode\" },\n    57\t  \"06-5\": { font: \"Rozha One\", label: \"Éditorial de mode\", family: \"Luxe & mode\" },\n    58\t  \"06-6\": { font: \"Bellefair\", label: \"Maroquinerie & artisanat\", family: \"Luxe & mode\" },\n    59\t  \"06-7\": { font: \"Forum\", label: \"Hôtellerie & art de vivre\", family: \"Luxe & mode\" },\n    60\t  \"06-8\": { font: \"Cinzel\", label: \"Vente aux enchères & patrimoine\", family: \"Luxe & mode\" },\n    61\t  \"07-1\": { font: \"Public Sans\", label: \"Accroche courte\", family: \"Social vertical\" },\n    62\t  \"07-2\": { font: \"Archivo\", label: \"Tutoriel pas à pas\", family: \"Social vertical\" },\n    63\t  \"07-3\": { font: \"Manrope\", label: \"Avant / après\", family: \"Social vertical\" },\n    64\t  \"07-4\": { font: \"Inter\", label: \"Carrousel informatif\", family: \"