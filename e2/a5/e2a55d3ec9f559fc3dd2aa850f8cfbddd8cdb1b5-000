{"timestamp":"2026-08-05T17:28:34.935Z","ordinal":1511,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd2f8-4977-7b32-a3ab-7abfa03e62f7","call_id":"call_ENfI1Ls25IPDNy7efpcAQ846","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"// ZenRayMedia — L6 : le compilateur de page.\n// Cut + Theme + Format -> UNE page HTML autonome (styles inclus, aucun appel réseau).\n//\n// RÈGLE (01-PLAN §6.1) : la page produite ici est EXACTEMENT celle que le Stage affiche et que\n// la Forge capturerait. Il n'existe pas de « rendu d'aperçu » séparé — sinon ce qu'on voit\n// n'est pas ce qui sort, et tout le produit ment.\n//\n// RÈGLE (01-PLAN §5.5) : aucun aléa hors `rng(seed)`. Deux compilations du même job donnent la\n// même chaîne, octet pour octet. C'est vérifié par le test `compile.test.js`.\n\nimport { rng, ROLE_LABELS } from './contracts.js'\nimport { isTemporal, beatDuration, durationOf } from './formats.js'\nimport { renderTemplate, escapeHtml } from './htmlTemplate.js'\nimport { fontFaceCss, fontStack } from './fonts.js'\nimport { paintOrder, filterOf, styleOf, transformOf, isEffectivelyHidden, shapeClipPath, fillOf, safeHref, animationOf } from './layers.js'\nimport { applyOverrides } from './nodes.js'\n\nconst WORDS_PER_MINUTE = 220\n\n// Les polices du projet, déclarées DANS la page compilée.\n// Sans ce bloc, l'aperçu (iframe srcDoc, même origine) n'héritait d'aucune @font-face et\n// retombait sur Georgia, alors que l'export, lui, embarque la vraie police en base64 :\n// l'aperçu ne montrait donc PAS ce qui sort. Bug corrigé le 2026-07-25.\n// À l'export, `embedFonts()` ajoute les mêmes familles en base64 APRÈS ce bloc : la version\n// autonome gagne, et la page reste identique hors ligne.\nconst FONT_FACES = `\n@font-face{font-family:'AnthropicSerif';src:url('/fonts/AnthropicSerif-Romans.woff2') format('woff2');font-weight:100 900;font-style:normal;font-display:block;}\n@font-face{font-family:'AnthropicSerif';src:url('/fonts/AnthropicSerif-Italics.woff2') format('woff2');font-weight:100 900;font-style:italic;font-display:block;}\n@font-face{font-family:'AnthropicSans';src:url('/fonts/AnthropicSans-Romans.woff2') format('woff2');font-weight:100 900;font-style:normal;font-display:block;}\n@font-face{font-family:'AnthropicMono';src:url('/fonts/AnthropicMono.woff2') format('woff2');font-weight:100 900;font-style:normal;font-display:block;}\n`.trim()\n\nexport function readingTimeOf(cut) {\n  const words = (cut?.beats || []).reduce((n, b) => n + String(b.text || '').trim().split(/\\s+/).filter(Boolean).length, 0)\n  return { words, minutes: Math.max(1, Math.round(words / WORDS_PER_MINUTE)) }\n}\n\nfunction step(typography, name) {\n  const s = typography.scale\n  const exp = s.steps?.[name] ?? 0\n  return Math.round(s.base * Math.pow(s.ratio, exp) * 100) / 100\n}\n\n// Facteur d'échelle pour les formats à hauteur fixe : plus il y a de texte, plus on réduit.\n// Échelle DISCRÈTE (paliers) et non continue : un palier est reproductible et lisible dans le\n// Critique (« palier 0.82 »), une formule continue produit des tailles impossibles à débattre.\nconst SHRINK_LADDER = [1, 0.92, 0.84, 0.76, 0.68, 0.6, 0.54]\n\nexport function shrinkFactor(cut, format) {\n  if (!format?.canvas?.h || format.overflow !== 'shrink') return 1\n  const chars = visibleBeats(cut, format).reduce((n, b) => n + String(b.text || '').length, 0)\n  const area = format.canvas.w * format.canvas.h\n  // ~1 signe pour 950 px² tient confortablement à l'échelle 1 sur ces formats.\n  const load = chars / (area / 950)\n  const index = Math.min(SHRINK_LADDER.length - 1, Math.max(0, Math.round((load - 0.6) * 3)))\n  return SHRINK_LADDER[index]\n}\n\n// Palier suivant de l'échelle, utilisé par l'ajustement MESURÉ (voir MediaApp) : on descend d'un\n// cran tant que la page déborde réellement dans le document, au lieu de deviner d'avance.\n// Une estimation qui se trompe produit exactement ce que Matthieu a vu : « dépasse de 886 px ».\nexport function nextShrink(current) {\n  const i = SHRINK_LADDER.findIndex((v) => v <= current + 1e-6)\n  const next = SHRINK_LADDER[Math.min(SHRINK_LADDER.length - 1, (i < 0 ? 0 : i) + 1)]\n  return next\n}\n\nexport const MIN_SHRINK = SHRINK_LADDER[SHRINK_LADDER.length - 1]\n\n/**\n * Les blocs qu'un format affiche réellement.\n * 'full'   -> tout (article, A4)\n * 'poster' -> les `maxBeats` premiers, choisis par POIDS d'accent décroissant à position égale\n *             d'ouverture : une image sociale montre l'accroche, pas le troisième paragraphe.\n */\nexport function visibleBeats(cut, format) {\n  const beats = cut?.beats || []\n  const fit = format?.fit || { mode: 'full', maxBeats: Infinity }\n  if (fit.mode === 'full' || !Number.isFinite(fit.maxBeats)) return beats\n  if (fit.maxBeats <= 0) return []\n  return beats.slice(0, fit.maxBeats)\n}\n\nexport function omittedCount(cut, format) {\n  return Math.max(0, (cut?.beats || []).length - visibleBeats(cut, format).length)\n}\n\nfunction themeCss(theme, format, { dark, scale }) {\n  const t = theme.typography\n  const p = theme.palette\n  const g = theme.grid\n  const s = theme.surface\n  // DENSITÉ (correctif 2026-07-25, bug A4 signalé par Matthieu) : un thème décrit des PROPORTIONS\n  // (base 19, ratio 1.333), le format décide de l'échelle PHYSIQUE. Sans ce facteur, le corps de\n  // 19 px atterrissait tel quel sur un canevas A4 de 2480 px : un timbre-poste illisible.\n  const density = format.density || 1\n  const px = (v) => `${Math.round(v * scale * density * 100) / 100}px`\n  const ink = dark ? p.inkDark : p.ink\n  const muted = dark ? p.mutedDark : p.muted\n  const rule = dark ? p.ruleDark : p.rule\n  const accent = dark ? p.accentDark : p.accent\n  const bg = dark ? s.backgroundDark : s.background\n  const fixed = format.canvas.h > 0\n  const safe = format.safe || { top: 0, bottom: 0, sides: 0 }\n  // Une affiche n'est pas un article rétré