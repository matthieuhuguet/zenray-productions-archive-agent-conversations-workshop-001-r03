{"timestamp":"2026-08-05T16:24:35.136Z","ordinal":351,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd2bd-b240-7d73-b2aa-54b682a61b86","call_id":"call_dkmcMKiot7HkgjcdvmTsSqsW","output":[{"type":"input_text","text":"Script completed\nWall time 0.0 seconds\nOutput:\n"},{"type":"input_text","text":"     1\t// ZenRayMedia — L11 : le Critique.\n     2\t//\n     3\t// 01-PLAN §9 : « Le Critique est le poste qui fait la différence entre premium et amateur. Sans\n     4\t// lui, la machine produit mille médias moyens. » C'est le SEUL poste obligatoire du cycle :\n     5\t// aucun livrable ne sort sans son passage, et un défaut bloquant interdit la publication.\n     6\t//\n     7\t// Deux familles de contrôles :\n     8\t//   - STATIQUES : sur les données (brief, cut, thème, format). Aucun rendu nécessaire.\n     9\t//   - MESURÉS   : sur la page réellement rendue (débordement, zones de sécurité, taille de\n    10\t//                 texte). Mesurés dans le document, jamais estimés — une estimation qui se\n    11\t//                 trompe est pire que pas de contrôle du tout.\n    12\t\n    13\timport { validate, sentenceCount } from './contracts.js'\n    14\timport { isTemporal, durationOf } from './formats.js'\n    15\timport { omittedCount, visibleBeats } from './compile.js'\n    16\timport { slotsWeight, countSlots, MAX_SLOTS } from './cut.js'\n    17\timport { missingFamilies, fontsWeight } from './fonts.js'\n    18\t\n    19\texport const SEVERITY = { blocking: 'blocking', warning: 'warning', info: 'info' }\n    20\t\n    21\tconst issue = (severity, code, message, fix = null) => ({ severity, code, message, fix })\n    22\t\n    23\t// --- Couleur et contraste ---------------------------------------------------------------------\n    24\texport function parseColor(input) {\n    25\t  const s = String(input || '').trim()\n    26\t  let m = /^#([0-9a-f]{3,8})$/i.exec(s)\n    27\t  if (m) {\n    28\t    const h = m[1]\n    29\t    if (h.length === 3 || h.length === 4) {\n    30\t      const [r, g, b, a = 'f'] = h.split('')\n    31\t      return { r: parseInt(r + r, 16), g: parseInt(g + g, 16), b: parseInt(b + b, 16), a: parseInt(a + a, 16) / 255 }\n    32\t    }\n    33\t    if (h.length === 6 || h.length === 8) {\n    34\t      return { r: parseInt(h.slice(0, 2), 16), g: parseInt(h.slice(2, 4), 16), b: parseInt(h.slice(4, 6), 16), a: h.length === 8 ? parseInt(h.slice(6, 8), 16) / 255 : 1 }\n    35\t    }\n    36\t  }\n    37\t  m = /^rgba?\\(([^)]+)\\)$/i.exec(s)\n    38\t  if (m) {\n    39\t    const parts = m[1].split(/[,\\s/]+/).filter(Boolean).map(Number)\n    40\t    if (parts.length >= 3 && parts.slice(0, 3).every((n) => Number.isFinite(n))) {\n    41\t      return { r: parts[0], g: parts[1], b: parts[2], a: Number.isFinite(parts[3]) ? parts[3] : 1 }\n    42\t    }\n    43\t  }\n    44\t  return null\n    45\t}\n    46\t\n    47\tfunction channelLuminance(c) {\n    48\t  const v = c / 255\n    49\t  return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4)\n    50\t}\n    51\t\n    52\texport function relativeLuminance(color) {\n    53\t  return 0.2126 * channelLuminance(color.r) + 0.7152 * channelLuminance(color.g) + 0.0722 * channelLuminance(color.b)\n    54\t}\n    55\t\n    56\t// Compose une couleur semi-transparente sur son fond : sans ça, un `rgba(20,22,26,.56)` sur blanc\n    57\t// serait mesuré comme du quasi-noir et le contraste serait faux.\n    58\texport function composite(fg, bg) {\n    59\t  const a = fg.a ?? 1\n    60\t  return { r: fg.r * a + bg.r * (1 - a), g: fg.g * a + bg.g * (1 - a), b: fg.b * a + bg.b * (1 - a), a: 1 }\n    61\t}\n    62\t\n    63\texport function contrastRatio(foreground, background) {\n    64\t  const fg = parseColor(foreground)\n    65\t  const bg = parseColor(background)\n    66\t  if (!fg || !bg) return null\n    67\t  const composed = composite(fg, { ...bg, a: 1 })\n    68\t  const l1 = relativeLuminance(composed)\n    69\t  const l2 = relativeLuminance(bg)\n    70\t  const [hi, lo] = l1 > l2 ? [l1, l2] : [l2, l1]\n    71\t  return Math.round(((hi + 0.05) / (lo + 0.05)) * 100) / 100\n    72\t}\n    73\t\n    74\t// --- Contrôles statiques -----------------------------------------------------------------------\n    75\texport function inspectStatic({ brief, cut, theme, format, dark = false, composed = false }) {\n    76\t  const issues = []\n    77\t\n    78\t  for (const [kind, value] of [['brief', brief], ['cut', cut], ['theme', theme], ['format', format]]) {\n    79\t    for (const err of validate(kind, value)) {\n    80\t      issues.push(issue(SEVERITY.blocking, `${kind}.${err.code}`, err.message))\n    81\t    }\n    82\t  }\n    83\t  if (issues.length) return issues // inutile de mesurer une structure invalide\n    84\t\n    85\t  // ZM-L2-02 — message unique.\n    86\t  if (sentenceCount(brief.message) > 1) {\n    87\t    issues.push(issue(SEVERITY.blocking, 'message.multi', 'Le message tient en une seule phrase.'))\n    88\t  }\n    89\t\n    90\t  // ZM-L11-02 — contraste réel de l'encre sur le fond, au seuil posé par le thème.\n    91\t  const ink = dark ? theme.palette.inkDark : theme.palette.ink\n    92\t  const bg = dark ? theme.surface.backgroundDark : theme.surface.background\n    93\t  const ratio = contrastRatio(ink, bg)\n    94\t  const minContrast = theme.palette.minContrast || 4.5\n    95\t  if (ratio == null) {\n    96\t    issues.push(issue(SEVERITY.warning, 'contrast.unreadable', 'Couleurs du thème non analysables : contraste non vérifié.'))\n    97\t  } else if (ratio < minContrast) {\n    98\t    issues.push(issue(SEVERITY.blocking, 'contrast.low', `Contraste ${ratio}:1 sous le seuil ${minContrast}:1 du thème (mode ${dark ? 'sombre' : 'clair'}).`))\n    99\t  }\n   100\t  const muted = dark ? theme.palette.mutedDark : theme.palette.muted\n   101\t  const mutedRatio = contrastRatio(muted, bg)\n   102\t  if (mutedRatio != null && mutedRatio < 4.5) {\n   103\t    issues.push(issue(SEVERITY.warning, 'contrast.muted', `Texte secondaire à ${mutedRatio}:1 : sous 4,5:1, il devient pénible à lire.`))\n   104\t  }\n   105\t\n   106\t  // ZM-L4 — le thème déclare-t-il ce format ?\n   107\t  if (Array.isArray(theme.formats) && !theme.formats.includes(format.id)) {\n   108\t    issues.push(issue(SEVERITY.warning, 'theme.format', `« ${theme.name} » ne déclare pas le format ${format.label} : le rendu peut être approximatif.`))\n   109\t  }\n   110\t\n   111\t  // ZM-L3-03 — nombre de beats imposé par le thème.\n   112\t  const count = cut.beats.length\n   113\t  const { min, max } = theme.beatCount || { min: 1, max: 99 }\n   114\t  if (count < min) issues.push(issue(SEVERITY.warning, 'cut.tooFew', `${count} beat(s) pour un thème qui en attend ${min} au minimum.`, 'refit'))\n   115\t  if (count > max) issues.push(issue(SEVERITY.warning, 'cut.tooMany', `${count} beats pour un thème qui en accepte ${max} au maximum.`, 'refit'))\n   116\t\n   117\t  // ZM-L11-04 — durée dans les bornes du format.\n   118\t  if (isTemporal(format)) {\n   119\t    const d = durationOf(cut, format)\n   120\t    if (d <= format.time.min) issues.push(issue(SEVERITY.warning, 'duration.short', `Durée ${d}s au plancher du format (${format.time.min}s) : le contenu a été comprimé.`))\n   121\t    if (d >= format.time.max) issues.push(issue(SEVERITY.blocking, 'duration.long', `Durée ${d}s au plafond du format (${format.time.max}s) : retire ou raccourcis un beat.`))\n   122\t  }\n   123\t\n   124\t  // ZM-L2-08 — les mentions obligatoires apparaissent dans le contenu.\n   125\t  const haystack = `${brief.title} ${brief.message} ${cut.beats.map((b) => b.text).join(' ')}`.toLowerCase()\n   126\t  for (const mention of brief.constraints?.mentions || []) {\n   127\t    if (mention && !haystack.includes(String(mention).toLowerCase())) {\n   128\t      issues.push(issue(SEVERITY.blocking, 'mention.missing', `Mention obligatoire absente du contenu : « ${mention} ».`))\n   129\t    }\n   130\t  }\n   131\t\n   132\t  // Politique de contenu du format : ce qui n'est pas affiché doit être DIT. Un bloc qui\n   133\t  // disparaît sans un mot est la pire des interfaces -- on croit avoir publié son texte entier.\n   134\t  // ... SAUF sur la voie composée, où les blocs ne sont plus la source de la page : celle-ci est\n   135\t  // faite des pièces posées, et compter des blocs « omis » y raconte une histoire fausse. C'est le\n   136\t  // second point où le Critique parlait de l'ancien modèle en regardant le nouveau.\n   137\t  const omitted = composed ? 0 : omittedCount(cut, format)\n   138\t  if (omitted > 0) {\n   139\t    issues.push(issue(SEVERITY.info, 'fit.omitted',\n   140\t      `Ce format montre ${visibleBeats(cut, format).length} bloc(s) sur ${cut.beats.length} : ${omitted} restent réservés aux formats de lecture (Web, A4). C'est voulu — une image ne porte pas un article.`))\n   141\t  }\n   142\t\n   143\t  // Poids des médias encodés. Un document de plusieurs mégaoctets alourdit chaque enregistrement\n   144\t  // dans le drive et chaque relecture : on le dit AVANT que ça devienne pénible, pas après.\n   145\t  const mediaBytes = slotsWeight(cut)\n   146\t  if (mediaBytes > 6_000_000) {\n   147\t    issues.push(issue(SEVERITY.warning, 'doc.heavy', `${Math.round(mediaBytes / 1e6)} Mo d'images encodées dans le document : au-delà de 6 Mo, chaque enregistrement devient lent. Retire une image ou attends le stockage en shards.`))\n   148\t  }\n   149\t  const slots = countSlots(cut)\n   150\t  if (slots > 0 && format.kind === 'web' && slots > cut.beats.length * MAX_SLOTS) {\n   151\t    issues.push(issue(SEVERITY.warning, 'slots.many', `${slots} images pour ${cut.beats.length} blocs : la page devient lourde à charger.`))\n   152\t  }\n   153\t\n   154\t  // ZM-L4-11 — polices du thème. Une famille absente du disque n'est pas une erreur : la page\n   155\t  // retombe sur sa pile système. Mais le rendu ne sera PAS celui mesuré sur les captures, et\n   156\t  // c'est exactement le genre d'écart qu'on ne voit pas et qu'on livre quand même.\n   157\t  const missing = missingFamilies(theme.fonts || [])\n   158\t  if (missing.length) {\n   159\t    issues.push(issue(SEVERITY.warning, 'font.missing',\n   160\t      `Police non installée : ${missing.join(', ')}. Le rendu utilise un repli système, donc pas la typographie mesurée. Installer avec « node scripts/zrm-fonts.mjs --cjk » si c'est une famille japonaise.`))\n   161\t  }\n   162\t  const fontBytes = fontsWeight(theme.fonts || [])\n   163\t  if (fontBytes > 1_500_000) {\n   164\t    issues.push(issue(SEVERITY.warning, 'font.heavy',\n   165\t      `${Math.round(fontBytes / 1e6 * 10) / 10} Mo de polices embarquées à l'export : la page devient lente à ouvrir. Retire une graisse ou une famille.`))\n   166\t  }\n   167\t\n   168\t  // ZM-L11-06 — un beat d'un seul mot n'est pas un beat.\n   169\t  cut.beats.forEach((beat, i) => {\n   170\t    const words = String(beat.text).trim().split(/\\s+/).filter(Boolean).length\n   171\t    if (words < 3) issues.push(issue(SEVERITY.warning, 'beat.thin', `Beat ${i + 1} (${beat.role}) : ${words} mot(s). Trop court pour porter quoi que ce soit.`))\n   172\t  })\n   173\t\n   174\t  // Un cut sans appel final quand l'intention est de vendre ou convaincre.\n   175\t  if (['vendre', 'convaincre'].includes(brief.intent) && !cut.beats.some((b) => b.role === 'cta')) {\n   176\t    issues.push(issue(SEVERITY.warning, 'cut.noCta', `Intention « ${brief.intent} » sans beat d'appel : le lecteur ne saura pas quoi faire.`))\n   177\t  }\n   178\t\n   179\t  return issues\n   180\t}\n   181\t\n   182\t// --- Contrôles mesurés sur la page rendue -------------------------------------------------------\n   183\t// `doc` est le document de l'iframe d'aperçu. On MESURE, on n'estime pas.\n   184\texport function inspectRendered(doc, format) {\n   185\t  const issues = []\n   186\t  if (!doc || !doc.body) return issues\n   187\t  const view = doc.defaultView\n   188\t  if (!view) return issues\n   189\t\n   190\t  // LE CRITIQUE ÉTAIT AVEUGLE À LA VOIE LEGO, et cela produisait un faux positif systématique.\n   191\t  //\n   192\t  // Il cherchait `.zrm-page`, que seule la voie à jetons produit ; la voie composée écrit\n   193\t  // `.zrm-lego-page`. Faute de la trouver, il mesurait le `body`, lequel fait exactement la taille\n   194\t  // du canevas, et le comparait à l'espace utile, c'est-à-dire au canevas MOINS les zones de\n   195\t  // sécurité. Le verdict tombait donc toujours, et toujours du même chiffre : la somme des zones\n   196\t  // de sécurité. En Carré 1080, quarante-huit en haut plus quarante-huit en bas, soit les 96 px\n   197\t  // annoncés sur les deux axes à la fois. Un débordement identique en hauteur et en largeur n'est\n   198\t  // jamais du contenu, c'est une constante ; c'est ce qui a mis sur la piste.\n   199\t  const legoPage = doc.querySelector('.zrm-lego-page')\n   200\t  const page = legoPage || doc.querySelector('.zrm-page') || doc.body\n   201\t  const fixed = format?.canvas?.h > 0\n   202\t  const safe = format?.safe || { top: 0, bottom: 0, sides: 0 }\n   203\t\n   204\t  // ZM-L11-03 — débordement réel.\n   205\t  // On mesure la page CONTRE L'ESPACE UTILE (canevas moins zones de sécurité), pas contre le\n   206\t  // body. Le cadre centre son contenu en flex avec `overflow:hidden` : un contenu trop haut y\n   207\t  // déborde SYMÉTRIQUEMENT et se fait rogner en haut ET en bas, sans que `scrollHeight` du body\n   208\t  // ne bouge. Mesurer le body laisserait donc passer une coupe franche sans rien signaler.\n   209\t  if (fixed) {\n   210\t    const usableH = format.canvas.h - safe.top - safe.bottom\n   211\t    const usableW = format.canvas.w - safe.sides * 2\n   212\t    // La page composée RÉSERVE elle-même ses zones de sécurité, sous forme de remplissage. Son\n   213\t    // débordement se lit donc dans sa propre boîte, et non contre une largeur utile qu'elle a déjà\n   214\t    // déduite : la mesurer comme l'autre voie reviendrait à retrancher deux fois la même marge.\n   215\t    const overflowY = legoPage\n   216\t      ? Math.round(legoPage.scrollHeight - legoPage.clientHeight)\n   217\t      : Math.round(page.getBoundingClientRect().height - usableH)\n   218\t    if (overflowY > 2) {\n   219\t      issues.push(issue(SEVERITY.blocking, 'overflow.vertical', `Le contenu dépasse de ${overflowY} px la hauteur utile du format : il sera rogné en haut et en bas.`, 'shrink'))\n   220\t    }\n   221\t    const overflowX = legoPage\n   222\t      ? Math.round(legoPage.scrollWidth - legoPage.clientWidth)\n   223\t      : Math.round(page.scrollWidth - usableW)\n   224\t    if (overflowX > 2) {\n   225\t      issues.push(issue(SEVERITY.blocking, 'overflow.horizontal', `Le contenu dépasse de ${overflowX} px la largeur utile du format.`, 'shrink'))\n   226\t    }\n   227\t  }\n   228\t\n   229\t  // ZM-L11-01 — zones de sécurité des plateformes.\n   230\t  if (fixed && format?.safe) {\n   231\t    const H = format.canvas.h\n   232\t    const W = format.canvas.w\n   233\t    for (const el of doc.querySelectorAll('.zrm-title, .zrm-beat-text, .zrm-standfirst, .zrm-byline, .zrm-kicker')) {\n   234\t      const r = el.getBoundingClientRect()\n   235\t      if (r.width === 0 && r.height === 0) continue\n   236\t      if (r.top < safe.top - 1) { issues.push(issue(SEVERITY.blocking, 'safe.top', `Du texte entre dans la zone haute réservée à l'interface (${Math.round(safe.top - r.top)} px trop haut).`, 'shrink')); break }\n   237\t      if (r.bottom > H - safe.bottom + 1) { issues.push(issue(SEVERITY.blocking, 'safe.bottom', `Du texte entre dans la zone basse réservée à l'interface (${Math.round(r.bottom - (H - safe.bottom))} px trop bas).`, 'shrink')); break }\n   238\t      if (r.left < safe.sides - 1 || r.right > W - safe.sides + 1) { issues.push(issue(SEVERITY.blocking, 'safe.sides', 'Du texte sort des marges latérales de sécurité.', 'shrink')); break }\n   239\t    }\n   240\t  }\n   241\t\n   242\t  // ZM-L11-05 — plancher de lisibilité. 12 px est la règle du projet sur poste fixe ; sur un\n   243\t  // format à canevas fixe, le plancher est relatif au canevas (1,1 % de la hauteur).\n   244\t  const floor = fixed ? Math.max(12, Math.round(format.canvas.h * 0.011)) : 12\n   245\t  for (const el of doc.querySelectorAll('.zrm-beat-text, .zrm-standfirst')) {\n   246\t    const size = parseFloat(view.getComputedStyle(el).fontSize)\n   247\t    if (Number.isFinite(size) && size < floor) {\n   248\t      issues.push(issue(SEVERITY.warning, 'type.tooSmall', `Texte à ${Math.round(size)} px, sous le plancher de ${floor} px : illisible à l'échelle de diffusion.`))\n   249\t      break\n   250\t    }\n   251\t  }\n   252\t\n   253\t  // ZM-L11-06 — ligne isolée en fin de bloc (veuve).\n   254\t  for (const el of doc.querySelectorAll('.zrm-beat-text')) {\n   255\t    const words = String(el.textContent || '').trim().split(/\\s+/).filter(Boolean)\n   256\t    if (words.length < 8) continue\n   257\t    const lineHeight = parseFloat(view.getComputedStyle(el).lineHeight)\n   258\t    const lines = Number.isFinite(lineHeight) && lineHeight > 0 ? Math.round(el.getBoundingClientRect().height / lineHeight) : 1\n   259\t    if (lines > 1 && words[words.length - 1].length <= 3) {\n   260\t      issues.push(issue(SEVERITY.info, 'type.widow', 'Un mot très court finit seul une ligne : insécable recommandé.'))\n   261\t      break\n   262\t    }\n   263\t  }\n   264\t\n   265\t  return issues\n   266\t}\n   267\t\n   268\texport function summarize(issues) {\n   269\t  const blocking = issues.filter((i) => i.severity === SEVERITY.blocking)\n   270\t  const warnings = issues.filter((i) => i.severity === SEVERITY.warning)\n   271\t  const infos = issues.filter((i) => i.severity === SEVERITY.info)\n   272\t  return { blocking, warnings, infos, canPublish: blocking.length === 0, total: issues.length }\n   273\t}\n"}],"internal_chat_