  const next = list.map((p) => (p.id === currentId ? { ...p, ...(typeof patch === 'function' ? patch(p) : patch) } : p))\n      saveProjects(next)\n      return next\n    })\n  }, [currentId])\n\n  const patchBrief = React.useCallback((patch) => {\n    patchProject((p) => ({ brief: { ...p.brief, ...patch } }))\n  }, [patchProject])\n\n  React.useEffect(() => { saveCurrentId(currentId) }, [currentId])\n\n  // Demander « enregistrer » ou « ouvrir » amène le fil d'Ariane sous les yeux : une seule\n  // surface, pas de fenêtre superposée (règle : aucune modale).\n  React.useEffect(() => { if (browser) setDeckTab('create') }, [browser])\n\n  // --- Chargement du thème (asynchrone : un gabarit HTML est un fichier à part) --------------\n  React.useEffect(() => {\n    let cancelled = false\n    setThemeError('')\n    loadTheme(themeId)\n      .then((loaded) => { if (!cancelled) setTheme(loaded) })\n      .catch((err) => { if (!cancelled) { setTheme(null); setThemeError(err.message) } })\n    return () => { cancelled = true }\n  }, [themeId])\n\n  React.useEffect(() => { setSelectedComponent(null); setDropTarget(null) }, [themeId])\n\n  React.useEffect(() => {\n    let cancelled = false\n    setComponentBundle(null)\n    loadThemeComponents(themeId)\n  }, [])\n\n  const runExport = React.useCallback(async (kind) => {\n    if (!compiled?.html || !project) return\n    // ZM-L11-09 : un défaut bloquant bloque TOUT livrable, sans exception. Une version\n    // antérieure exemptait l'export HTML -- c'est-à-dire précisément le livrable principal :\n    // la règle était inversée et le Critique ne protégeait rien.\n    if (!verdict.canPublish) {\n      notify(`${verdict.blocking.length} défaut(s) bloquant(s) : le Critique refuse le livrable. Onglet Critique.`, 'error')\n      return\n    }\n    setBusy(kind)\n    try {\n      const base = safeFileName(project.brief.title, '')\n      if (kind === 'html') {\n        const res = await exportHtml(compiled.html, `${base}html`)\n       