omposition(value, value.themeId)\n  return {\n    ...composition,\n    rows: composition.rows\n      .map((row) => ({ ...row, items: row.items.filter((item) => item.id !== itemId) }))\n      .filter((row) => row.items.length),\n  }\n}\n\nexport function moveItem(value, itemId, targetId, placement) {\n  if (!PLACEMENTS.includes(placement) || itemId === targetId) return value\n  const composition = normalizeComposition(value, value.themeId)\n  const source = locate(composition.rows, itemId)\n  if (!source) return composition\n  const item = composition.rows[source.rowIndex].items[source.itemIndex]\n  return insertItem(removeItem(composition, itemId), item, targetId, placement, composition.serial)\n}\n\nexport function patchItem(value, itemId, patch) {\n  const composition = normalizeComposition(value, value.themeId)\n  return {\n    ...composition,\n    rows: composition.rows.map((row) => ({\n      ...row,\n      items: row.items.map((item) => (item.id === itemId ? { ...item, ...patch } : item)),\n    })),\n  }\n}\n\nexport function duplicateItem(value, itemId) {\n  const composition = normalizeComposition(value, value.themeId)\n  const source = locate(composition.rows, itemId)\n  if (!source) return composition\n  const original = composition.rows[source.rowIndex].items[source.itemIndex]\n  const next = allocate(composition, original.kind === 'image' ? 'img' : 'cmp', original.id)\n  return insertItem(composition, { ...original, id: next.id }, itemId, 'below', next.serial)\n}\n\nexport function countItems(value) {\n  return (value?.rows || []).reduce((sum, row) => sum + (row.items?.length || 0), 0)\n}\n\n(exit 0)\n### document\n// ZenRayMedia — L8 : le document `.zmedia.json` dans Create.\n//\n// DEUX CHOSES DIFFÉRENTES, souvent confondues (retour Matthieu 2026-07-25) :\n//\n//   1. ENREGISTRER  = ranger le document dans MON index, à un endroit que je choisis, pour le\n//      rouvrir et continuer à travailler. C'est ce fichier-ci. Le contenu est la SOURCE\n//      (brief + blocs + thème + format), pas le rendu.\n//   2. PUBLIER      = produire une page figée et partageable. C'est `exporters.js`.\n//\n// Même hiérarchie de dossiers, deux affichages et deux intentions distinctes. On peut enregistrer\n// sans jamais publier, et republier sans réenregistrer.\n//\n// Le fichier reste volontairement LISIBLE et MINUSCULE : aucun HTML compilé n'y est stocké, il se\n// recompile en quelques millisecondes. Stocker le rendu créerait deux vérités qui divergeraient.\n\nimport { readJson, saveJson, listChildren } from '../ref/content.js'\nimport { emptyBrief, makeId, validate } from './contracts.js'\nimport { DEFAULT_THEME_ID } from './themes/registry.js'\n\nexport const ZMEDIA_EXT = '.zmedia.json'\nexport const ZMEDIA_VERSION = 2\nexport const DEFAULT_MEDIA_DIR = 'pages/Media'\n\nexport function isZMediaPath(path) { return typeof path === 'string' && path.endsWith(ZMEDIA_EXT) }\n\nexport function slugify(text) {\n  return String(text || '')\n    .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-+|-+$/g, '')\n    .toLowerCase().slice(0, 60) || 'media'\n}\n\n// Chemin proposé pour un projet dans un dossier donné. Le suffixe court évite d'écraser un\n// homonyme sans avoir à interroger le serveur avant d'afficher une proposition.\nexport function suggestPath(dir, title, salt = 0) {\n  // Normaliser D'ABORD, se servir de la valeur normalisée PARTOUT ensuite.\n  // Bug réel (2026-07-25) : l'empreinte était calculée sur `dir` brut alors que le chemin final\n  // utilisait `dir` nettoyé -> « pages/Media » et « pages/Media/ » désignent le même dossier mais\n  // produisaient deux noms de fichier différents. Un même document enregistré deux fois depuis\n  // deux points d'entrée aurait créé deux fichiers au lieu d'un.\n  const folder = String(dir || DEFAULT_MEDIA_DIR).replace(/\\/+$/, '')\n  const base = slugify(title)\n  const suffix = makeId('', `${folder}/${base}`, salt).replace(/^-/, '').slice(-4)\n  return `${folder}/${base}-${suffix}${ZMEDIA_EXT}`\n}\n\n// --- Sérialisation ------------------------------------------------------------------------------\nexport function toDocument(project, { themeId, formatId, path }) {\n  return {\n    type: 'zenraymedia',\n    v: ZMEDIA_VERSION,\n    title: project.brief?.title || 'Sans titre',\n    path: path || null,\n    brief: project.brief,\n    notes: project.notes || '',\n    cut: project.cut || null,\n    compositions: project.compositions || {},\n    themeId: themeId || DEFAULT_THEME_ID,\n    formatId: formatId || 'F-web-article',\n    seed: project.seed ?? 1,\n  }\n}\n\n// Tolérant en LECTURE, strict en écriture : un document écrit par une version future ne doit pas\n// faire planter l'application, juste perdre ce qu'elle ne comprend pas.\nexport function fromDocument(doc, path) {\n  if (!doc || doc.type !== 'zenraymedia') return null\n  const brief = { ...emptyBrief(), ...(doc.brief || {}) }\n  if (!brief.id) brief.id = makeId('brief', path || doc.title || 'zmedia', 0)\n  return {\n    project: {\n      id: makeId('project', path || doc.title || 'zmedia', 0),\n      brief,\n      notes: typeof doc.notes === 'string' ? doc.notes : '',\n      cut: doc.cut && Array.isArray(doc.cut.beats) && doc.cut.beats.length ? doc.cut : null,\n      // Une composition par thème : essayer une autre famille ne détruit jamais le montage Lego.\n      // `composition` garde la lecture tolérante d'une courte version de développement.\n      compositions: doc.compositions && typeof doc.compositions === 'object'\n        ? doc.compositions\n        : (doc.composition?.themeId ? { [doc.composition.themeId]: doc.composition } : {}),\n      seed: Number.isFinite(doc.seed) ? doc.seed : 1,\n      path: path || doc.path || null,\n    },\n    themeId: doc.themeId || DEFAULT_THEME_ID,\n    formatId: doc.formatId || 'F-web-article',\n  }\n}\n\n// --- Entrées / sorties ---------------------------------------------------------------------------\n/** Lit un document. `{ ok, project, themeId, formatId, sha, error }` — ne lève jamais. */\nexport async function loadDocument(path) {\n  if (!isZMediaPath(path)) return { ok: false, error: 'Chemin qui n’est pas un document ZenRayMedia.' }\n  const { data, sha, missing, error } = await readJson(path)\n  if (missing) return { ok: false, error: 'Document introuvable.' }\n  if (error) return { ok: false, error: error === 'parse' ? 'Document illisible (JSON invalide).' : 'Lecture impossible (réseau).' }\n  const parsed = fromDocument(data, path)\n  if (!parsed) return { ok: false, error: 'Ce fichier n’est pas un document ZenRayMedia.' }\n  return { ok: true, ...parsed, sha }\n}\n\n/**\n * Écrit un document. `sha` est celui lu précédemment : c'est lui qui permet à GitHub de refuser\n * une écriture concurrente plutôt que d'écraser le travail d'un autre onglet.\n */\nexport async function saveDocument(path, project, { themeId, formatId, sha } = {}) {\n  const errors = validate('brief', project?.brief || null)\n  if (errors.length) return { ok: false, error: `Document incomplet : ${errors[0].message}` }\n  const doc = toDocument(project, { themeId, formatId, path })\n  const res = await saveJson(path, doc, sha)\n  if (res.conflict) return { ok: false, conflict: true, error: 'Ce document a été modifié ailleurs. Recharge-le avant d’enregistrer.' }\n  if (!res.ok) return { ok: false, error: res.error === 'network' ? 'Enregistrement impossible (réseau).' : `Enregistrement refusé (${res.error || 'inconnu'}).` }\n  return { ok: true, sha: res.sha }\n}\n\n// --- Navigation de dossiers (le fil d'Ariane) -------------------------------------------------\n/** Sous-dossiers directs d'un dossier, triés. `listChildren` passe par l'API `children`. */\nexport async function listFolders(dir) {\n  const entries = await listChildren(dir)\n  return entries\n    .filter((e) => e && e.type === 'dir')\n    .map((e) => ({ name: e.name, path: e.path }))\n    .sort((a, b) => a.name.localeCompare(b.name, 'fr'))\n}\n\n/** Documents ZenRayMedia directement dans un dossier. */\nexport async function listDocuments(dir) {\n  const entries = await listChildren(dir)\n  return entries\n    .filter((e) => e && e.type !== 'dir' && isZMediaPath(e.path || e.name))\n    .map((e) => ({ name: String(e.name).replace(ZMEDIA_EXT, ''), path: e.path }))\n    .sort((a, b) => a.name.localeCompare(b.name, 'fr'))\n}\n\n/** Segments d'un chemin de dossier, pour l'affichage du fil d'Ariane. */\nexport function crumbsOf(dir) {\n  const parts = String(dir || '').split('/').filter(Boolean)\n  return parts.map((name, i) => ({ name, path: parts.slice(0, i + 1).join('/') }))\n}\n\nexport function parentOf(dir) {\n  const parts = String(dir || '').split('/').filter(Boolean)\n  return parts.length > 1 ? parts.slice(0, -1).join('/') : parts[0] || 'pages'\n}\n\nexport function dirOf(path) {\n  const i = String(path || '').lastIndexOf('/')\n  return i > 0 ? path.slice(0, i) : DEFAULT_MEDIA_DIR\n}\n\n(exit 0)\n### formats\n// ZenRayMedia — L5 : les contrats de sortie.\n// Doc : 01-PLAN.md §5.4 + §7. Un format ne décrit JAMAIS un style : uniquement la boîte\n// (dimensions, densité, durée, zones de sécurité, spécification de livraison).\n\n// `fit` : ce qu'un format AFFICHE du cut.\n//   mode 'full'   -> titre + message + TOUS les blocs. Pour ce qui se lit (article, A4).\n//   mode 'poster' -> titre + message + `maxBeats` blocs au maximum. Pour ce qui se REGARDE.\n// Raison (bug signalé par Matthieu le 2026-07-25, « énormément de bugs sur tous les formats ») :\n// un article de 5 blocs ne rentre PAS sur un carré 1080 à taille lisible, et aucun réglage ne\n// l'y fera rentrer. Ce n'était pas un défaut de rendu, c'était un défaut de doctrine : personne\n// ne met 900 mots sur une image sociale. Le format décide de ce qu'il montre ; le Critique\n// signale ce qui a été laissé de côté, pour que rien ne disparaisse en silence.\n//\n// `density` : multiplicateur appliqué à TOUTE valeur typographique et d'espacement du thème.\n// Sans lui, un corps de 19 px posé sur un canevas A4 de 2480 px de large donnait un texte\n// illisible (bug réel signalé par Matthieu le 2026-07-25) : le compilateur ignorait le `dpi`.\n// Un thème décrit des proportions ; c'est le FORMAT qui décide de l'échelle physique.\nexport const FORMATS = [\n  {\n    id: 'F-web-article', fit: { mode: 'full', maxBeats: Infinity }, density: 1 /* l'écran est la référence : 1 px CSS = 1 px */, kind: 'web', label: 'libre · 820', short: '820',\n    canvas: { w: 820, h: 0, dpi: 72 }, // h:0 = hauteur libre (le contenu décide)\n    color: 'sRGB', measure: 68,\n    delivery: { container: 'html', maxBytes: 2_000_000 },\n    overflow: 'flow', // le texte coule, il ne peut pas déborder\n  },\n  {\n    id: 'F-still-1080-square', fit: { mode: 'poster', maxBeats: 1 }, density: 1.7 /* lisible en vignette de fil social */, kind: 'still', label: '1:1 · 1080', short: '1:1',\n    canvas: { w: 1080, h: 1080, dpi: 72 }, color: 'sRGB', measure: 34,\n    safe: { top: 48, bottom: 48, sides: 48 },\n    delivery: { container: 'png', maxBytes: 8_000_000 },\n    overflow: 'shrink',\n  },\n  {\n    id: 'F-still-1080x1350', fit: { mode: 'poster', maxBeats: 2 }, density: 1.7 /* lisible en vignette de fil social */, kind: 'still', label: '4:5 · 1080×1350', short: '4:5',\n    canvas: { w: 1080, h: 1350, dpi: 72 }, color: 'sRGB', measure: 34,\n    safe: { top: 60, bottom: 60, sides: 54 },\n    delivery: { container: 'png', maxBytes: 8_000_000 },\n    overflow: 'shrink',\n  },\n  {\n    id: 'F-still-1080x1920', fit: { mode: 'poster', maxBeats: 2 }, density: 1.7 /* lisible sur un écran de téléphone tenu à bout de bras */, kind: 'still', label: '9:16 · 1080×1920', short: '9:16',\n    canvas: { w: 1080, h: 1920, dpi: 72 }, color: 'sRGB', measure: 30,\n    // Zones d'interface réelles des plateformes verticales : haut (profil/son),\n    // bas (légende, boutons). Le Critique refuse tout texte qui entre dedans.\n    safe: { top: 220, bottom: 320, sides: 64 },\n    delivery: { container: 'png', maxBytes: 8_000_000 },\n    overflow: 'shrink',\n  },\n  {\n    id: 'F-print-a4', fit: { mode: 'full', maxBeats: Infinity }, density: 3.125 /* 300 dpi / 96 dpi de référence CSS -> corps ~14 pt réels */, kind: 'print', label: 'A4 · 2480×3508', short: 'A4',\n    canvas: { w: 2480, h: 3508, dpi: 300 }, color: 'sRGB', measure: 66,\n    bleedMm: 3, safe: { top: 118, bottom: 118, sides: 118 },\n    delivery: { container: 'pdf', maxBytes: 30_000_000 },\n    overflow: 'paginate',\n  },\n  {\n    id: 'F-video-1920x1080', fit: { mode: 'poster', maxBeats: 1 }, density: 1.6 /* lisible à 2 m d'un téléviseur */, kind: 'video', label: '16:9 · 1920×1080', short: '16:9',\n    canvas: { w: 1920, h: 1080, dpi: 72 }, color: 'sRGB', measure: 40,\n    time: { fps: 30, target: 30, min: 10, max: 90 },\n    safe: { top: 54, bottom: 54, sides: 96 },\n    // hvc1 : règle dure du projet (registre d'erreurs 2026-07-05, HEVC illisible sur iPhone sans ce tag).\n    delivery: { container: 'mp4', codec: 'hevc_videotoolbox', tag: 'hvc1', pixfmt: 'yuv420p', maxBytes: 200_000_000 },\n    overflow: 'shrink',\n  },\n  {\n    id: 'F-overlay-1920x1080', fit: { mode: 'poster', maxBeats: 1 }, density: 1.6 /* même échelle que la vidéo qu'il habille */, kind: 'overlay', label: '16:9 α · 1920×1080', short: 'α',\n    canvas: { w: 1920, h: 1080, dpi: 72 }, color: 'sRGB', measure: 40,\n    time: { fps: 30, target: 10, min: 2, max: 60 },\n    safe: { top: 54, bottom: 54, sides: 96 },\n    // prores_ks + yuva444p10le : VÉRIFIÉ disponible sur cette machine (ffmpeg 8.1.1).\n    // prores_videotoolbox n'est PAS utilisé ici : son support alpha n'a pas été mesuré (01-PLAN Q4).\n    delivery: { container: 'mov', codec: 'prores_ks', profile: 4, pixfmt: 'yuva444p10le', maxBytes: 4_000_000_000 },\n    overflow: 'shrink',\n    transparent: true,\n  },\n  // ═══ LES FORMATS DU WEB, AJOUTÉS LE 2026-08-04 ════════════════════════════════════════════════\n  //\n  // « Il faut qu'il y ait tous les formats du web possibles. » La liste s'arrêtait à sept, dont\n  // deux d'impression et de vidéo : elle couvrait ce que le produit savait faire, pas ce qu'on lui\n  // demande. Les vingt suivants sont ceux qui reviennent réellement, du partage social aux pavés\n  // publicitaires normalisés par l'IAB.\n  //\n  // TROIS RÈGLES tenues pour tous, afin qu'aucun ne soit posé au jugé.\n  //   `density` suit la largeur : une bannière de 320 px doit porter un corps de texte lisible à\n  //   la même distance qu'un 1920, donc son…3676 tokens truncated…rfaces -- on croit avoir publié son texte entier.\n  // ... SAUF sur la voie composée, où les blocs ne sont plus la source de la page : celle-ci est\n  // faite des pièces posées, et compter des blocs « omis » y raconte une histoire fausse. C'est le\n  // second point où le Critique parlait de l'ancien modèle en regardant le nouveau.\n  const omitted = composed ? 0 : omittedCount(cut, format)\n  if (omitted > 0) {\n    issues.push(issue(SEVERITY.info, 'fit.omitted',\n      `Ce format montre ${visibleBeats(cut, format).length} bloc(s) sur ${cut.beats.length} : ${omitted} restent réservés aux formats de lecture (Web, A4). C'est voulu — une image ne porte pas un article.`))\n  }\n\n  // Poids des médias encodés. Un document de plusieurs mégaoctets alourdit chaque enregistrement\n  // dans le drive et chaque relecture : on le dit AVANT que ça devienne pénible, pas après.\n  const mediaBytes = slotsWeight(cut)\n  if (mediaBytes > 6_000_000) {\n    issues.push(issue(SEVERITY.warning, 'doc.heavy', `${Math.round(mediaBytes / 1e6)} Mo d'images encodées dans le document : au-delà de 6 Mo, chaque enregistrement devient lent. Retire une image ou attends le stockage en shards.`))\n  }\n  const slots = countSlots(cut)\n  if (slots > 0 && format.kind === 'web' && slots > cut.beats.length * MAX_SLOTS) {\n    issues.push(issue(SEVERITY.warning, 'slots.many', `${slots} images pour ${cut.beats.length} blocs : la page devient lourde à charger.`))\n  }\n\n  // ZM-L4-11 — polices du thème. Une famille absente du disque n'est pas une erreur : la page\n  // retombe sur sa pile système. Mais le rendu ne sera PAS celui mesuré sur les captures, et\n  // c'est exactement le genre d'écart qu'on ne voit pas et qu'on livre quand même.\n  const missing = missingFamilies(theme.fonts || [])\n  if (missing.length) {\n    issues.push(issue(SEVERITY.warning, 'font.missing',\n      `Police non installée : ${missing.join(', ')}. Le rendu utilise un repli système, donc pas la typographie mesurée. Installer avec « node scripts/zrm-fonts.mjs --cjk » si c'est une famille japonaise.`))\n  }\n  const fontBytes = fontsWeight(theme.fonts || [])\n  if (fontBytes > 1_500_000) {\n    issues.push(issue(SEVERITY.warning, 'font.heavy',\n      `${Math.round(fontBytes / 1e6 * 10) / 10} Mo de polices embarquées à l'export : la page devient lente à ouvrir. Retire une graisse ou une famille.`))\n  }\n\n  // ZM-L11-06 — un beat d'un seul mot n'est pas un beat.\n  cut.beats.forEach((beat, i) => {\n    const words = String(beat.text).trim().split(/\\s+/).filter(Boolean).length\n    if (words < 3) issues.push(issue(SEVERITY.warning, 'beat.thin', `Beat ${i + 1} (${beat.role}) : ${words} mot(s). Trop court pour porter quoi que ce soit.`))\n  })\n\n  // Un cut sans appel final quand l'intention est de vendre ou convaincre.\n  if (['vendre', 'convaincre'].includes(brief.intent) && !cut.beats.some((b) => b.role === 'cta')) {\n    issues.push(issue(SEVERITY.warning, 'cut.noCta', `Intention « ${brief.intent} » sans beat d'appel : le lecteur ne saura pas quoi faire.`))\n  }\n\n  return issues\n}\n\n// --- Contrôles mesurés sur la page rendue -------------------------------------------------------\n// `doc` est le document de l'iframe d'aperçu. On MESURE, on n'estime pas.\nexport function inspectRendered(doc, format) {\n  const issues = []\n  if (!doc || !doc.body) return issues\n  const view = doc.defaultView\n  if (!view) return issues\n\n  // LE CRITIQUE ÉTAIT AVEUGLE À LA VOIE LEGO, et cela produisait un faux positif systématique.\n  //\n  // Il cherchait `.zrm-page`, que seule la voie à jetons produit ; la voie composée écrit\n  // `.zrm-lego-page`. Faute de la trouver, il mesurait le `body`, lequel fait exactement la taille\n  // du canevas, et le comparait à l'espace utile, c'est-à-dire au canevas MOINS les zones de\n  // sécurité. Le verdict tombait donc toujours, et toujours du même chiffre : la somme des zones\n  // de sécurité. En Carré 1080, quarante-huit en haut plus quarante-huit en bas, soit les 96 px\n  // annoncés sur les deux axes à la fois. Un débordement identique en hauteur et en largeur n'est\n  // jamais du contenu, c'est une constante ; c'est ce qui a mis sur la piste.\n  const legoPage = doc.querySelector('.zrm-lego-page')\n  const page = legoPage || doc.querySelector('.zrm-page') || doc.body\n  const fixed = format?.canvas?.h > 0\n  const safe = format?.safe || { top: 0, bottom: 0, sides: 0 }\n\n  // ZM-L11-03 — débordement réel.\n  // On mesure la page CONTRE L'ESPACE UTILE (canevas moins zones de sécurité), pas contre le\n  // body. Le cadre centre son contenu en flex avec `overflow:hidden` : un contenu trop haut y\n  // déborde SYMÉTRIQUEMENT et se fait rogner en haut ET en bas, sans que `scrollHeight` du body\n  // ne bouge. Mesurer le body laisserait donc passer une coupe franche sans rien signaler.\n  if (fixed) {\n    const usableH = format.canvas.h - safe.top - safe.bottom\n    const usableW = format.canvas.w - safe.sides * 2\n    // La page composée RÉSERVE elle-même ses zones de sécurité, sous forme de remplissage. Son\n    // débordement se lit donc dans sa propre boîte, et non contre une largeur utile qu'elle a déjà\n    // déduite : la mesurer comme l'autre voie reviendrait à retrancher deux fois la même marge.\n    const overflowY = legoPage\n      ? Math.round(legoPage.scrollHeight - legoPage.clientHeight)\n      : Math.round(page.getBoundingClientRect().height - usableH)\n    if (overflowY > 2) {\n      issues.push(issue(SEVERITY.blocking, 'overflow.vertical', `Le contenu dépasse de ${overflowY} px la hauteur utile du format : il sera rogné en haut et en bas.`, 'shrink'))\n    }\n    const overflowX = legoPage\n      ? Math.round(legoPage.scrollWidth - legoPage.clientWidth)\n      : Math.round(page.scrollWidth - usableW)\n    if (overflowX > 2) {\n      issues.push(issue(SEVERITY.blocking, 'overflow.horizontal', `Le contenu dépasse de ${overflowX} px la largeur utile du format.`, 'shrink'))\n    }\n  }\n\n  // ZM-L11-01 — zones de sécurité des plateformes.\n  if (fixed && format?.safe) {\n    const H = format.canvas.h\n    const W = format.canvas.w\n    for (const el of doc.querySelectorAll('.zrm-title, .zrm-beat-text, .zrm-standfirst, .zrm-byline, .zrm-kicker')) {\n      const r = el.getBoundingClientRect()\n      if (r.width === 0 && r.height === 0) continue\n      if (r.top < safe.top - 1) { issues.push(issue(SEVERITY.blocking, 'safe.top', `Du texte entre dans la zone haute réservée à l'interface (${Math.round(safe.top - r.top)} px trop haut).`, 'shrink')); break }\n      if (r.bottom > H - safe.bottom + 1) { issues.push(issue(SEVERITY.blocking, 'safe.bottom', `Du texte entre dans la zone basse réservée à l'interface (${Math.round(r.bottom - (H - safe.bottom))} px trop bas).`, 'shrink')); break }\n      if (r.left < safe.sides - 1 || r.right > W - safe.sides + 1) { issues.push(issue(SEVERITY.blocking, 'safe.sides', 'Du texte sort des marges latérales de sécurité.', 'shrink')); break }\n    }\n  }\n\n  // ZM-L11-05 — plancher de lisibilité. 12 px est la règle du projet sur poste fixe ; sur un\n  // format à canevas fixe, le plancher est relatif au canevas (1,1 % de la hauteur).\n  const floor = fixed ? Math.max(12, Math.round(format.canvas.h * 0.011)) : 12\n  for (const el of doc.querySelectorAll('.zrm-beat-text, .zrm-standfirst')) {\n    const size = parseFloat(view.getComputedStyle(el).fontSize)\n    if (Number.isFinite(size) && size < floor) {\n      issues.push(issue(SEVERITY.warning, 'type.tooSmall', `Texte à ${Math.round(size)} px, sous le plancher de ${floor} px : illisible à l'échelle de diffusion.`))\n      break\n    }\n  }\n\n  // ZM-L11-06 — ligne isolée en fin de bloc (veuve).\n  for (const el of doc.querySelectorAll('.zrm-beat-text')) {\n    const words = String(el.textContent || '').trim().split(/\\s+/).filter(Boolean)\n    if (words.length < 8) continue\n    const lineHeight = parseFloat(view.getComputedStyle(el).lineHeight)\n    const lines = Number.isFinite(lineHeight) && lineHeight > 0 ? Math.round(el.getBoundingClientRect().height / lineHeight) : 1\n    if (lines > 1 && words[words.length - 1].length <= 3) {\n      issues.push(issue(SEVERITY.info, 'type.widow', 'Un mot très court finit seul une ligne : insécable recommandé.'))\n      break\n    }\n  }\n\n  return issues\n}\n\nexport function summarize(issues) {\n  const blocking = issues.filter((i) => i.severity === SEVERITY.blocking)\n  const warnings = issues.filter((i) => i.severity === SEVERITY.warning)\n  const infos = issues.filter((i) => i.severity === SEVERITY.info)\n  return { blocking, warnings, infos, canPublish: blocking.length === 0, total: issues.length }\n}\n\n(exit 0)\n### exporters\n// ZenRayMedia — sorties navigateur (pipelines P1, P2, P3, P7 de 01-PLAN §7).\n//\n// Ce que le navigateur SAIT faire de façon fiable : page HTML autonome, image fixe, PDF via\n// l'impression, texte au presse-papiers. C'est fait ici, réellement.\n// Ce qu'il ne sait PAS faire de façon fiable : encoder du ProRes 4444 alpha. C'est la Forge\n// locale (`forge.js`), et le produit le dit au lieu de faire semblant.\n\nimport { FONTS, essentialFaces } from './fonts.js'\n\nconst FONT_FILES = {\n  AnthropicSerif: '/fonts/AnthropicSerif-Romans.woff2',\n  AnthropicSans: '/fonts/AnthropicSans-Romans.woff2',\n  AnthropicMono: '/fonts/AnthropicMono.woff2',\n}\n\n// Les familles Google Fonts installées, indexées par nom -> liste de fichiers WOFF2.\n// Elles sont sous licence libre (OFL/Apache) : les EMBARQUER dans un fichier livré à un client\n// est autorisé, ce qui est précisément ce dont une page autonome a besoin.\nconst THEME_FONT_FILES = Object.fromEntries(FONTS.map((f) => [f.family, f.faces]))\n\nconst fontCache = new Map()\n\n/** Lit un fichier de police servi par le site et le rend en data URI. Mis en cache. */\nasync function fileDataUrl(url) {\n  if (fontCache.has(url)) return fontCache.get(url)\n  const promise = (async () => {\n    try {\n      const res = await fetch(url)\n      if (!res.ok) return null\n      const bytes = new Uint8Array(await res.arrayBuffer())\n      let binary = ''\n      const CHUNK = 0x8000\n      for (let i = 0; i < bytes.length; i += CHUNK) binary += String.fromCharCode(...bytes.subarray(i, i + CHUNK))\n      return `data:font/woff2;base64,${btoa(binary)}`\n    } catch { return null }\n  })()\n  fontCache.set(url, promise)\n  return promise\n}\n\nasync function fontDataUrl(family) {\n  if (fontCache.has(family)) return fontCache.get(family)\n  const url = FONT_FILES[family]\n  if (!url) return null\n  const promise = (async () => {\n    try {\n      const res = await fetch(url)\n      if (!res.ok) return null\n      const buf = await res.arrayBuffer()\n      let binary = ''\n      const bytes = new Uint8Array(buf)\n      const CHUNK = 0x8000\n      for (let i = 0; i < bytes.length; i += CHUNK) binary += String.fromCharCode(...bytes.subarray(i, i + CHUNK))\n      return `data:font/woff2;base64,${btoa(binary)}`\n    } catch { return null }\n  })()\n  fontCache.set(family, promise)\n  return promise\n}\n\n// ZM-L6-02 : polices EN BASE64 dans la page. Une page exportée qui va chercher sa police sur le\n// réseau n'est pas autonome — ouverte hors ligne ou chez un client, elle change d'apparence.\nexport async function embedFonts(html) {\n  const faces = []\n\n  // 1. Les trois familles Anthropic (chrome et thèmes maison).\n  for (const family of Object.keys(FONT_FILES).filter((f) => html.includes(f))) {\n    const data = await fontDataUrl(family)\n    if (data) faces.push(`@font-face{font-family:'${family}';src:url(${data}) format('woff2');font-weight:100 900;font-style:normal;font-display:block;}`)\n  }\n\n  // 2. Les familles Google Fonts que la page utilise réellement. On embarque CHAQUE coupe\n  //    (romain, italique, sous-ensembles) avec son unicode-range : sans lui, le navigateur\n  //    chargerait la première coupe pour tous les alphabets et l'accentuation casserait.\n  for (const [family, entryFaces] of Object.entries(THEME_FONT_FILES)) {\n    if (!html.includes(family)) continue\n    // On n'embarque que les coupes utiles, cf. `essentialFaces` : trente-six fichiers par famille\n    // dont six servaient, c'est ce qui produisait les 3,8 Mo signalés par le Critique.\n    for (const face of essentialFaces(family).length ? essentialFaces(family) : entryFaces) {\n      const data = await fileDataUrl(face.file)\n      if (!data) continue\n      faces.push(`@font-face{font-family:'${family}';font-style:${face.style};font-weight:${face.weight};font-display:block;src:url(${data}) format('woff2');${face.unicodeRange ? `unicode-range:${face.unicodeRange};` : ''}}`)\n    }\n  }\n\n  if (!faces.length) return html\n  const block = `<style data-zrm-fonts>${faces.join('')}</style>`\n  return html.includes('</head>') ? html.replace('</head>', `${block}</head>`) : `${block}${html}`\n}\n\nconst imageCache = new Map()\n\n/** Lit une image (locale ou distante) et la rend en data URI. Le type MIME vient de l'en-tête HTTP\n * réel (`Content-Type`), jamais deviné depuis l'extension du nom de fichier, qui ment parfois (un\n * CDN sert souvent du WebP sous une adresse sans extension). Mis en cache. */\nasync function imageDataUrl(url) {\n  if (imageCache.has(url)) return imageCache.get(url)\n  const promise = (async () => {\n    try {\n      const res = await fetch(url)\n      if (!res.ok) return null\n      const mime = res.headers.get('content-type') || 'image/png'\n      const bytes = new Uint8Array(await res.arrayBuffer())\n      let binary = ''\n      const CHUNK = 0x8000\n      for (let i = 0; i < bytes.length; i += CHUNK) binary += String.fromCharCode(...bytes.subarray(i, i + CHUNK))\n      return `data:${mime};base64,${btoa(binary)}`\n    } catch { return null }\n  })()\n  imageCache.set(url, promise)\n  return promise\n}\n\n// FAMILLE ILLUSTRATOR I7 · IMAGES INCORPORÉES. Une image de calque reste une simple ADRESSE\n// (voie LIÉE, `<img src=\"…\">`) tant qu'on prévisualise ou édite. À l'export, la page doit pouvoir\n// vivre hors ligne ou chez un client sans que l'image disparaisse si la source bouge : elle est\n// alors INCORPORÉE en base64, exactement comme `embedFonts` le fait déjà pour les polices. Corrige\n// au passage un échec déjà nommé plus bas dans l'erreur d'`exportPng` : une image distante non\n// incorporée peut « tainter » le canvas et faire échouer l'export PNG entièrement.\nexport async function embedImages(html) {\n  const srcs = [...new Set([...html.matchAll(/<img[^>]+src=\"([^\"]+)\"/g)].map((m) => m[1]).filter((src) => src && !src.startsWith('data:')))]\n  if (!srcs.length) return html\n  let next = html\n  for (const src of srcs) {\n    const data = await imageDataUrl(src)\n    if (data) next = next.split(`src=\"${src}\"`).join(`src=\"${data}\"`)\n  }\n  return next\n}\n\nexport function downloadBlob(blob, filename) {\n  const url = URL.createObjectURL(blob)\n  const a = document.createElement('a')\n  a.href = url\n  a.download = filename\n  document.body.appendChild(a)\n  a.click()\n  a.remove()\n  // Révocation différée : Safari lit l'URL après le clic, une révocation immédiate annule le\n  // téléchargement sans erreur visible.\n  setTimeout(() => URL.revokeObjectURL(url), 10_000)\n}\n\nexport async function exportHtml(html, filename) {\n  const withFonts = await embedFonts(html)\n  const withImages = await embedImages(withFonts)\n  downloadBlob(new Blob([withImages], { type: 'text/html;charset=utf-8' }), filename)\n  return { bytes: new Blob([withImages]).size, container: 'html' }\n}\n\n// Image fixe : SVG foreignObject -> canvas -> PNG.\n// Sérialisation via XMLSerializer sur un DOM parsé : c'est ce qui garantit un XHTML bien formé\n// (`<br/>`, `<img/>`…). Une concaténation de chaînes casserait au premier élément vide.\nexport async function exportPng(html, format, filename, { scale = 1 } = {}) {\n  const width = format.canvas.w\n  const height = format.canvas.h || 1200\n  const withFonts = await embedFonts(html)\n  // Une image DISTANTE non incorporée peut tainter le canvas (message d'erreur juste plus bas) :\n  // l'incorporer ICI, avant le rendu SVG->canvas, est ce qui rend cet export fiable.\n  const withImages = await embedImages(withFonts)\n\n  const parsed = new DOMParser().parseFromString(withImages, 'text/html')\n  const svgNS = 'http://www.w3.org/2000/svg'\n  const xhtmlNS = 'http://www.w3.org/1999/xhtml'\n  const svg = document.createElementNS(svgNS, 'svg')\n  svg.setAttribute('xmlns', svgNS)\n  svg.setAttribute('width', String(width))\n  svg.setAttribute('height', String(height))\n  svg.setAttribute('viewBox', `0 0 ${width} ${height}`)\n  const fo = document.createElementNS(svgNS, 'foreignObject')\n  fo.setAttribute('x', '0'); fo.setAttribute('y', '0')\n  fo.setAttribute('width', String(width)); fo.setAttribute('height', String(height))\n  const wrapper = document.createElementNS(xhtmlNS, 'div')\n  wrapper.setAttribute('style', `width:${width}px;height:${height}px;overflow:hidden;`)\n  for (const style of parsed.querySelectorAll('style')) wrapper.appendChild(document.importNode(style, true))\n  for (const child of Array.from(parsed.body.childNodes)) wrapper.appendChild(document.importNode(child, true))\n  fo.appendChild(wrapper)\n  svg.appendChild(fo)\n\n  const serialized = new XMLSerializer().serializeToString(svg)\n  const svgUrl = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(serialized