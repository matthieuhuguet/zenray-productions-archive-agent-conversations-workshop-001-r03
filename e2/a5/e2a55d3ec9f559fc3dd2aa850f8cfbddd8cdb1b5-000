},\n    delivery: { container: 'png', maxBytes: 8_000_000 },\n    overflow: 'shrink',\n  },\n  {\n    id: 'F-print-a4', fit: { mode: 'full', maxBeats: Infinity }, density: 3.125 /* 300 dpi / 96 dpi de référence CSS -> corps ~14 pt réels */, kind: 'print', label: 'A4 · 2480×3508', short: 'A4',\n    canvas: { w: 2480, h: 3508, dpi: 300 }, color: 'sRGB', measure: 66,\n    bleedMm: 3, safe: { top: 118, bottom: 118, sides: 118 },\n    delivery: { container: 'pdf', maxBytes: 30_000_000 },\n    overflow: 'paginate',\n  },\n  {\n    id: 'F-video-1920x1080', fit: { mode: 'poster', maxBeats: 1 }, density: 1.6 /* lisible à 2 m d'un téléviseur */, kind: 'video', label: '16:9 · 1920×1080', short: '16:9',\n    canvas: { w: 1920, h: 1080, dpi: 72 }, color: 'sRGB', measure: 40,\n    time: { fps: 30, target: 30, min: 10, max: 90 },\n    safe: { top: 54, bottom: 54, sides: 96 },\n    // hvc1 : règle dure du projet (registre d'erreurs 2026-07-05, HEVC illisible sur iPhone sans ce tag).\n    delivery: { container: 'mp4', codec: 'hevc_videotoolbox', tag: 'hvc1', pixfmt: 'yuv420p', maxBytes: 200_000_000 },\n    overflow: 'shrink',\n  },\n  {\n    id: 'F-overlay-1920x1080', fit: { mode: 'poster', maxBeats: 1 }, density: 1.6 /* même échelle que la vidéo qu'il habille */, kind: 'overlay', label: '16:9 α · 1920×1080', short: 'α',\n    canvas: { w: 1920, h: 1080, dpi: 72 }, color: 'sRGB', measure: 40,\n    time: { fps: 30, target: 10, min: 2, max: 60 },\n    safe: { top: 54, bottom: 54, sides: 96 },\n    // prores_ks + yuva444p10le : VÉRIFIÉ disponible sur cette machine (ffmpeg 8.1.1).\n    // prores_videotoolbox n'est PAS utilisé ici : son support alpha n'a pas été mesuré (01-PLAN Q4).\n    delivery: { container: 'mov', codec: 'prores_ks', profile: 4, pixfmt: 'yuva444p10le', maxBytes: 4_000_000_000 },\n    overflow: 'shrink',\n    transparent: true,\n  },\n  // ═══ LES FORMATS DU WEB, AJOUTÉS LE 2026-08-04 ════════════════════════════════════════════════\n  //\n  // « Il faut qu'il y ait tou