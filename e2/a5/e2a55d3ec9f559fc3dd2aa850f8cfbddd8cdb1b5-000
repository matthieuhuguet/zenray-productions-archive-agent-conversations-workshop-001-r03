{"timestamp":"2026-08-05T17:07:32.677Z","ordinal":1074,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd2e5-06c5-76b2-bcf9-2da715f4fb07","call_id":"call_jQL7l5KuCNqgSDEpKxgF0hw6","output":[{"type":"input_text","text":"Script completed\nWall time 0.0 seconds\nOutput:\n"},{"type":"input_text","text":"// ZenRayMedia — L9 : la surface unique.\n//\n// Contrat d'interface (03-UI-CONTRAT §6, version A) : trois zones — Brief, Stage, Deck — plus\n// une barre de commande et une barre de rendu. AUCUNE modale, AUCUNE page de réglages, AUCUN\n// assistant en plusieurs étapes. Design soustractif : si retirer un élément ne casse aucune\n// tâche, il ne doit pas être là.\n//\n// RÈGLE DES TROIS ACTIONS : note -> thème -> rendre. Le compteur en bas à droite affiche le\n// nombre d'actions réellement nécessaires ; il est là pour empêcher la dérive, pas pour décorer.\n\nimport React from 'react'\nimport { UI } from '../config/colors.js'\nimport './media.css'\nimport Icon from '../components/Icon.jsx'\nimport { validate, ROLE_LABELS, BEAT_ROLES, makeId, checksumOf, emptyBrief } from './contracts.js'\nimport { FORMATS, getFormat, isTemporal, durationOf, beatDuration } from './formats.js'\nimport { listThemes, loadTheme, DEFAULT_THEME_ID } from './themes/registry.js'\nimport { FAMILIES } from './taxonomy.js'\nimport { buildCut, refitCut, moveBeat, mergeBeats, splitBeat, addBeat, removeBeat, updateBeat, addSlot, removeSlot, slotsWeight, MAX_SLOTS } from './cut.js'\nimport { compile, readingTimeOf, nextShrink, MIN_SHRINK } from './compile.js'\nimport { inspectStatic, inspectRendered, summarize } from './critic.js'\nimport { forgePlan, formatBytes } from './forge.js'\nimport { declensionTree, declensionSummary, trimAdvice } from './declensions.js'\nimport { publishArticle, publishPathFor } from './publish.js'\nimport { fileToWebp } from '../api.js'\nimport { exportHtml, exportPng, exportPdf, copyText, safeFileName } from './exporters.js'\nimport { loadProjects, saveProjects, loadCurrentId, saveCurrentId, appendLog, loadLog, clearLog, seedProject, SEED_NOTES } from './store.js'\nimport CreateBrowser from './CreateBrowser.jsx'\nimport { loadDocument, saveDocument, dirOf, slugify, DEFAULT_MEDIA_DIR } from './document.js'\nimport { loadThemeComponents, groupComponents } from './componentCatalog.js'\nimport { emptyComposition, normalizeComposition, addComponent, addImage, moveItem, removeItem, patchItem, duplicateItem, countItems } from './composition.js'\nimport { getIndexPaths, getNodeThumb, loadSearchIndex } from '../search/searchIndexClient.js'\nimport { thumbUrlOf, resolveThumbUrl, resolveFullImageUrl } from '../search/thumbUrl.js'\nimport { parseTree, findNode, countNodes, collectTexts, allPaths, NODE_STYLES } from './nodes.js'\nimport { addLayer, patchLayer, removeLayer, duplicateLayer, reorderLayer, stackOrder, findLayer, countLayers, applyHandle, snapMove, frameBox, resizedColumn, layersInRect, readLayers, alignPatch, distributePatch, readGroups, groupLayers, ungroupLayers, patchGroup, removeGroup, isEffectivelyHidden, isEffectivelyLocked, applyConstraintsToAll, applyAutoLayout, toggleAutoLayout, setAutoLayoutProp, readSlides, addSlide, removeSlide, duplicateSlide, reorderSlide, setActiveSlide, bringToFront, sendToBack, resizeTableCells, BLEND_MODES, LAYER_STYLES, SHAPE_TYPES, CONSTRAINTS_H, CONSTRAINTS_V } from './layers.js'\n\nconst DECK_TABS = [\n  { key: 'details', label: 'Détails', icon: 'gearshape' },\n  { key: 'contenu', label: 'Contenu', icon: 'textformat' },\n  { key: 'sorties', label: 'Sorties', icon: 'square.grid.2x2' },\n  { key: 'critic', label: 'Critique', icon: 'checkmark' },\n  { key: 'forge', label: 'Forge', icon: 'film' },\n  { key: 'create', label: 'Fichiers', icon: 'folder' },   // « Enregistrer » nommait déjà un bouton de la barre d'outils : deux commandes distinctes ne peuvent pas porter le même nom.\n  { key: 'log', label: 'Journal', icon: 'list.bullet' },\n]\n\nfunction useDebounced(value, delay) {\n  const [debounced, setDebounced] = React.useState(value)\n  React.useEffect(() => {\n    const id = setTimeout(() => setDebounced(value), delay)\n    return () => clearTimeout(id)\n  }, [value, delay])\n  return debounced\n}\n\n// Mise à l'échelle du Stage : le canevas garde sa taille RÉELLE (les mesures du Critique se font\n// dedans, en pixels de sortie) et c'est l'affichage qui est réduit par transform. Redimensionner\n// l'iframe fausserait toutes les mesures.\nfunction useFitScale(ref, canvasW, canvasH) {\n  const [fit, setFit] = React.useState({ scale: 1, availH: 900 })\n  React.useEffect(() => {\n    const el = ref.current\n    if (!el || !canvasW) return undefined\n    const measure = () => {\n      const box = el.getBoundingClientRect()\n      const availW = Math.max(120, box.width - 32)\n      const availH = Math.max(240, box.height - 32)\n      const next = canvasH > 0 ? Math.min(availW / canvasW, availH / canvasH, 1) : Math.min(availW / canvasW, 1)\n      setFit({ scale: Math.max(0.08, Math.round(next * 1000) / 1000), availH })\n    }\n    measure()\n    const observer = new ResizeObserver(measure)\n    observer.observe(el)\n    return () => observer.disconnect()\n  }, [ref, canvasW, canvasH])\n  return fit\n}\n\nexport default function MediaApp() {\n  // --- État ---------------------------------------------------------------------------------\n  const [projects, setProjects] = React.useState(() => loadProjects())\n  const [currentId, setCurrentId] = React.useState(() => loadCurrentId() || loadProjects()[0]?.id)\n  const [themeId, setThemeId] = React.useState(DEFAULT_THEME_ID)\n  const [formatId, setFormatId] = React.useState('F-web-article')\n  const [renderDark, setRenderDark] = React.useState(false)\n  const [theme, setTheme] = React.useState(null)\n  const [themeError, setThemeError] = React.useState('')\n  // L'onglet d'ouverture devient « Détails » : c'est le geste central d'un éditeur type UMG, on\n  // sélectionne une pièce et on lit ses propriétés. Ouvrir sur « Thèmes » plaçait le catalogue au\n  // premier plan, or le catalogue est un choix qu'on fait UNE fois par document.\n  const [deckTab, setDeckTab] = React.useState('details')\n  const [menuOpen, setMenuOpen] = React.useState(null)   // zone 1 · menu déroulant ouvert\n  // Le SOUS-COMPOSANT sélectionné, distinct de la pièce : on sélectionne une pièce, puis un nœud\n  // dans cette pièce. Deux niveaux, comme dans Unreal où l'on choisit un widget puis un slot.\n  const [selectedNode, setSelectedNode] = React.useState(null)   // chemin d'indices, ou null\n  const [openNodes, setOpenNodes] = React.useState({})       // les PIÈCES dépliées\n  const [ouverts, setOuverts] = React.useState({})           // les NŒUDS dépliés, clef « inst:chemin »\n  // LES GROUPES DE LA HIÉRARCHIE, replies par leur clef : la racine, la pile de calques, chaque\n  // rangée. Ils n'avaient AUCUN état, ce qui explique que « le repli ne fonctionne toujours pas » :\n  // leurs triangles étaient décoratifs et le bouton « tout replier » n'avait rien à replier.\n  const [groupesReplies, setGroupesReplies] = React.useState({})\n  const replier = React.useCallback((clef) => setGroupesReplies((g) => ({ ...g, [clef]: !g[clef] })), [])\n\n  // LA SÉLECTION MULTIPLE. `selectedComponent` reste la sélection PRINCIPALE, celle que le panneau\n  // de droite affiche, parce qu'on ne règle pas quinze objets à la fois. `selection` porte\n  // l'ensemble, sur lequel agissent masquer, verrouiller et retirer.\n  const [selection, setSelection] = React.useState([])\n  const ancreRef = React.useRef(null)\n\n  // LE VERROU DU PANNEAU DE DÉTAILS (famille 1, doc Slate §« Details Panel Locking »).\n  //\n  // Verrouiller ROMPT la synchronisation automatique : l'utilisateur continue de sélectionner\n  // d'autres pièces dans la hiérarchie ou dans l'aperçu, mais le panneau de droite garde celles\n  // du premier objet. Cela sert à comparer deux pièces, ou à lire les réglages de l'une pendant\n  // qu'on en pose une autre. `panelLockedId` porte l'objet gelé ; `null` signifie « non verrouillé,\n  // le panneau suit ».\n  const [panelLockedId, setPanelLockedId] = React.useState(null)\n\n\n\n  const [animOpen, setAnimOpen] = React.useState(false)\n  const [hierQuery, setHierQuery] = React.useState('')   // zone 6 · filtre de l'arbre\n  const [detSections, setDetSections] = React.useState({}) // zone 5 · sections repliées\n  const [openFamilies, setOpenFamilies] = React.useState({})\n  const [paletteOpen, setPaletteOpen] = React.useState(false)\n  const [query, setQuery] = React.useState('')\n  const [paletteIndex, setPaletteIndex] = React.useState(0)\n  const [toast, setToast] = React.useState(null)\n  const [busy, setBusy] = React.useState(null)\n  const [renderedIssues, setRenderedIssues] = React.useState([])\n  const [log, setLog] = React.useState(() => loadLog())\n  const [showSafe, setShowSafe] = React.useState(false)\n  const [selectedBeat, setSelectedBeat] = React.useState(0)\n  const [actionCount, setActionCount] = React.useState(0)\n  const [componentBundle, setComponentBundle] = React.useState(null)\n  // LE REPLI DES PANNEAUX EXISTAIT DEJA, PERSONNE NE L'APPELAIT (remis en service le 2026-08-01).\n  //\n  // `media.css` porte `[data-panes=\"two\"]` et `[data-panes=\"one\"]` depuis l'origine, et cette ligne\n  // ecrivait `data-panes=\"three\"` EN DUR, sans etat ni condition. Le manque de place dont Matthieu\n  // se plaint tenait donc pour une part a un mecanisme deja ecrit : le remettre en service coute un\n  // etat et un attribut, pas une refonte.\n  //\n  // On MASQUE au lieu de demonter, et c'est deliberé. Demonter le panneau Details ferait perdre une\n  // edition en cours, exactement le bug de double montage paye le 2026-07-30 sur la vue Plan : un\n  // composant qui se demonte ecrit son etat au passage. Masque, il garde tout et revient intact.\n  const [panes, setPanes] = React.useState('three')\n  // LES LARGEURS DE COLONNES (famille 3, docking). En mémoire pour cette session : une disposition\n  // enregistrée entre deux ouvertures aurait été une fonctionnalité de plus, non demandée par cette\n  // carte, qui porte sur le GESTE de redimensionnement et non sur sa persistance.\n  const [colWidths, setColWidths] = React.useState({ left: 212, right: 244 })\n  // LE MENU CONTEXTUEL DE LA HIÉRARCHIE (famille 4, doc Slate « menus contextuels »). Toutes ses\n  // actions existaient déjà en icônes sur chaque rangée ; ce qui manquait est le CLIC DROIT lui-\n  // même, geste que la doc Unreal décrit comme le second point d'entrée après la barre d'outils.\n  // `{x, y, id, estCalque}` ou `null` : une seule instance à la fois, comme les menus de la barre.\n  const [menuContextuel, setMenuContextuel] = React.useState(null)\n  const ouvrirMenuContextuel = (event, id, estCalque) => {\n    event.preventDefault()\n    // Le clic droit sur un objet HORS de la sélection la remplace par cet objet seul — c'est le\n    // comportement du Finder et d'Unreal : on ne veut pas agir « en groupe » sur un clic droit\n    // qui visait un seul élément par accident.\n    if (!selection.includes(id)) choisir(id, {})\n    setMenuContextuel({ x: event.clientX, y: event.clientY, id, estCalque })\n  }\n\n  // ═══ NAVIGATION CLAVIER DANS LA HIÉRARCHIE (famille 8, doc Slate « focus, navigation clavier ») ═\n  // Flèche bas et flèche haut déplacent la sélection dans l'ordre VISIBLE, le même que celui du\n  // magnétisme (S2) et du clic étendu (choisir). Elles n'agissent que si le focus n'est PAS dans un\n  // champ de saisie, sinon flèche bas déplacerait la sélection en même temps qu'on tape un texte.\n  const splitRef = React.useRef(null)\n  const onSplitDown = (event, cote) => {\n    event.preventDefault()\n    event.currentTarget.setPointerCapture?.(event.pointerId)\n    splitRef.current = { cote, sx: event.clientX, depart: colWidths[cote] }\n  }\n  const onSplitMove = (event) => {\n    const g = splitRef.current\n    if (!g) return\n    const delta = event.clientX - g.sx\n    // Tirer la poignée GAUCHE vers la droite agrandit la colonne gauche ; tirer la poignée DROITE\n    // vers la gauche agrandit la colonne droite : chaque poignée grandit sa colonne en s'éloignant\n    // du centre, comme n'importe quel séparateur de panneaux. `resizedColumn` est PURE et testée\n    // à part : jsdom simule mal PointerEvent.clientX, un test de glisser réel n'y prouverait rien.\n    setColWidths((w) => ({ ...w, [g.cote]: resizedColumn(g.cote, g.depart, delta) }))\n  }\n  const onSplitUp = () => { splitRef.current = null }\n\n  const [libraryTab, setLibraryTab] = React.useState('components')\n  const [libraryQuery, setLibraryQuery] = React.useState('')\n  const [openComponentGroups, setOpenComponentGroups] = React.useState({})\n  const [selectedComponent, setSelectedComponent] = React.useState(null)\n  // L'identifiant que le PANNEAU affiche, distinct de celui que la hiérarchie surligne. C'est ce\n  // découplage qui permet au verrou d'exister : la sélection continue de bouger normalement,\n  // déclaré ICI, juste après `selectedComponent`, dont il dépend.\n  const idPourPanneau = panelLockedId || selectedComponent\n  const [dropTarget, setDropTarget] = React.useState(null)\n  const [imageIndexReady, setImageIndexReady] = React.useState(false)\n  // Document Create courant. `sha` est l'empreinte GitHub lue au dernier accès : c'est elle qui\n  // permet au serveur de REFUSER une écriture concurrente au lieu d'écraser un autre onglet.\n  const [docPath, setDocPath] = React.useState(null)\n  const [docSha, setDocSha] = React.useState(null)\n  const [browser, setBrowser] = React.useState(null) // null | 'save' | 'open'\n  // DEUX échelles distinctes, à ne jamais confondre (la confusion a été attrapée par le build) :\n  //   `fitScale`      = ZOOM D'AFFICHAGE de l'aperçu dans le panneau (cosmétique, plus bas).\n  //   `contentScale`  = ÉCHELLE DU CONTENU imposée par la mesure, pour que le texte rentre\n  //                     dans le canevas de sortie. Elle part dans le fichier exporté.\n  const [contentScale, setContentScale] = React.useState(null)\n\n  const stageRef = React.useRef(null)\n  const frameRef = React.useRef(null)\n  const queryRef = React.useRef(null)\n\n  const project = projects.find((p) => p.id === currentId) || projects[0]\n  const format = getFormat(formatId)\n  const themes = React.useMemo(() => listThemes(), [])\n  // Mémoïsé sur la liste : à 1024 thèmes, regrouper à chaque frappe coûterait 1024 itérations\n  // par caractère tapé dans le brief.\n  const grouped = React.useMemo(() => themes.reduce((acc, entry) => {\n    (acc[entry.family] = acc[entry.family] || []).push(entry)\n    return acc\n  }, {}), [themes])\n\n  const notify = React.useCallback((message, kind = 'info') => {\n    setToast({ message, kind })\n    setTimeout(() => setToast((t) => (t && t.message === message ? null : t)), 4200)\n  }, [])\n\n  const patchProject = React.useCallback((patch) => {\n    setProjects((list) => {\n      const next = list.map((p) => (p.id === currentId ? { ...p, ...(typeof patch === 'function' ? patch(p) : patch) } : p))\n      saveProjects(next)\n      return next\n    })\n  }, [currentId])\n\n  const patchBrief = React.useCallback((patch) => {\n    patchProject((p) => ({ brief: { ...p.brief, ...patch } }))\n  }, [patchProject])\n\n  React.useEffect(() => { saveCurrentId(currentId) }, [currentId])\n\n  // Demander « enregistrer » ou « ouvrir » amène le fil d'Ariane sous les yeux : une seule\n  // surface, pas de fenêtre superposée (règle : aucune modale).\n  React.useEffect(() => { if (browser) setDeckTab('create') }, [browser])\n\n  // --- Chargement du thème (asynchrone : un gabarit HTML est un fichier à part) --------------\n  React.useEffect(() => {\n    let cancelled = false\n    setThemeError('')\n    loadTheme(themeId)\n      .then((loaded) => { if (!cancelled) setTheme(loaded) })\n      .catch((err) => { if (!cancelled) { setTheme(null); setThemeError(err.message) } })\n    return () => { cancelled = true }\n  }, [themeId])\n\n  React.useEffect(() => { setSelectedComponent(null); setDropTarget(null) }, [themeId])\n\n  React.useEffect(() => {\n    let cancelled = false\n    setComponentBundle(null)\n    loadThemeComponents(themeId)\n      .then((loaded) => { if (!cancelled) setComponentBundle(loaded) })\n      .catch(() => { if (!cancelled) setComponentBundle({ themeId, components: [], tokensCss: '', definitionsHtml: '' }) })\n    return () => { cancelled = true }\n  }, [themeId])\n\n  React.useEffect(() => {\n    if (libraryTab !== 'images' || imageIndexReady) return undefined\n    let live = true\n    loadSearchIndex().then(() => { if (live) setImageIndexReady(true) }).catch(() => { if (live) setImageIndexReady(true) })\n    return () => { live = false }\n  }, [libraryTab, imageIndexReady])\n\n  // --- Cut : construit à la demande, jamais écrasé en silence --------------------------------\n  const cut = project?.cut\n  const composition = React.useMemo(\n    () => normalizeComposition(project?.compositions?.[themeId], themeId),\n    [project?.compositions, themeId],\n  )\n  // Le verrou se libère tout seul si l'objet auquel il tient a disparu (retiré, undo) : sinon le\n  // panneau resterait vide sans qu'aucun signe explique pourquoi, ce qui se lit comme un bug\n  // plutôt que comme l'état voulu.\n  React.useEffect(() => {\n    if (!panelLockedId) return\n    const existe = findLayer(composition, panelLockedId)\n      || (composition.rows || []).some((r) => (r.items || []).some((it) => it.id === panelLockedId))\n    if (!existe) setPanelLockedId(null)\n  }, [composition, panelLockedId])\n\n  // ═══ FAMILLE PHOTOSHOP 8 · HISTORIQUE — ANNULER ET RÉTABLIR ═══════════════════════════════════\n  //\n  // « L'historique est le filet sous le trapèze. Sans lui, l'utilisateur hésite, travaille plus\n  // lentement et évite les expérimentations. » C'est le point que la doc Photoshop range dans le\n  // noyau indispensable de la famille, et c'était la carte L7, déjà notée et déjà différée depuis\n  // le tableau du 2026-08-04.\n  //\n  // `patchComposition` est l'UNIQUE point d'entrée de toute modification de la composition — pièces\n  // Lego et calques confondus — depuis la carte C1. C'est ce qui rend l'historique possible sans\n  // instrumenter chaque geste séparément : il suffit d'empiler l'état PRÉCÉDENT à cet unique\n  // endroit, et tout ce qui transite déjà par lui (déplacer, redimensionner, régler un style,\n  // grouper, retirer) devient annulable sans une ligne de plus ailleurs.\n  //\n  // BORNÉ À CINQUANTE ÉTATS : Photoshop borne aussi son historique par défaut. Un historique\n  // infini fuirait la mémoire sur une session longue, et personne ne remonte cinquante gestes en\n  // arrière — la doc elle-même dit que les états les plus anciens s'effacent d'eux-mêmes.\n  const HISTORIQUE_MAX = 50\n  const [pileAnnuler, setPileAnnuler] = React.useState([])\n  const [pileRetablir, setPileRetablir] = React.useState([])\n\n  // Un changement de DOCUMENT ou de THÈME ouvre un historique NEUF : annuler ne doit jamais faire\n  // remonter un geste posé sur un autre brief, ce qui serait aussi déroutant qu'un Ctrl+Z de\n  // traitement de texte qui modifierait soudain un autre fichier.\n  React.useEffect(() => { setPileAnnuler([]); setPileRetablir([]) }, [currentId, themeId])\n\n  const patchComposition = React.useCallback((nextOrFactory) => {\n    const avant = normalizeComposition(project?.compositions?.[themeId], themeId)\n    patchProject((p) => {\n      const current = normalizeComposition(p.compositions?.[themeId], themeId)\n      const brut = typeof nextOrFactory === 'function' ? nextOrFactory(current) : nextOrFactory\n      // Un groupe en Auto Layout (carte Figma F4) n'est jamais qu'un alignement figé : c'est une\n      // CONTRAINTE, réappliquée après CHAQUE mutation, pas seulement au moment où elle s'active.\n      const next = applyAutoLayout(brut)\n      return { compositions: { ...(p.compositions || {}), [themeId]: next } }\n    })\n    setPileAnnuler((pile) => [...pile.slice(-(HISTORIQUE_MAX - 1)), avant])\n    setPileRetablir([])   // toute action neuve efface le « futur » qu'annuler aurait pu rouvrir\n    setActionCount((n) => n + 1)\n  }, [patchProject, themeId, currentId, project])\n\n  const annuler = React.useCallback(() => {\n    if (!pileAnnuler.length) return\n    const precedent = pileAnnuler[pileAnnuler.length - 1]\n    const actuel = normalizeComposition(project?.compositions?.[themeId], themeId)\n    setPileAnnuler((pile) => pile.slice(0, -1))\n    setPileRetablir((pile) => [...pile, actuel])\n    patchProject((p) => ({ compositions: { ...(p.compositions || {}), [themeId]: precedent } }))\n  }, [pileAnnuler, patchProject, themeId, currentId, project])\n\n  const retablir = React.useCallback(() => {\n    if (!pileRetablir.length) return\n    const suivant = pileRetablir[pileRetablir.length - 1]\n    const actuel = normalizeComposition(project?.compositions?.[themeId], themeId)\n    setPileRetablir((pile) => pile.slice(0, -1))\n    setPileAnnuler((pile) => [...pile, actuel])\n    patchProject((p) => ({ compositions: { ...(p.compositions || {}), [themeId]: suivant } }))\n  }, [pileRetablir, patchProject, themeId, currentId, project])\n\n  // ═══ FAMILLE FIGMA 3 · LES CONTRAINTES S'APPLIQUENT AU CHANGEMENT DE FORMAT ═══════════════════\n  //\n  // Le canevas change de taille à chaque format choisi — carré, 9:16, A4 — et c'est le SEUL\n  // moment où « la frame est redimensionnée » a un sens dans ce produit. `canevasPrecedentRef`\n  // porte les dimensions d'AVANT le changement, pour que `applyConstraintsToAll` sache de combien\n  // le cadre a bougé. Elle se réinitialise sur un changement de document ou de thème, pour la même\n  // raison que l'historique juste au-dessus : un format qui change de sens sur un autre document\n  // ne doit jamais faire bouger les calques de celui qu'on regarde maintenant.\n  const canevasPrecedentRef = React.useRef({ w: format.canvas.w, h: format.canvas.h })\n  React.useEffect(() => { canevasPrecedentRef.current = { w: format.canvas.w, h: format.canvas.h } }, [currentId, themeId])\n  React.useEffect(() => {\n    const avant = canevasPrecedentRef.current\n    const apres = { w: format.canvas.w, h: format.canvas.h }\n    if (avant.w === apres.w && avant.h === apres.h) return\n    patchComposition((c) => applyConstraintsToAll(c, avant, apres))\n    canevasPrecedentRef.current = apres\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [format.canvas.w, format.canvas.h])\n\n  const buildCutNow = React.useCallback(() => {\n    if (!project) return\n    const next = buildCut(project.brief, project.notes, theme)\n    patchProject({ cut: next })\n    setSelectedBeat(0)\n    setActionCount((n) => n + 1)\n    notify(`Partition montée : ${next.beats.length} beats.`, 'ok')\n  }, [project, theme, patchProject, notify])\n\n  // Premier montage automatique : l'application ne s'ouvre jamais sur un écran vide.\n  React.useEffect(() => {\n    if (project && !project.cut && theme) {\n      patchProject({ cut: buildCut(project.brief, project.notes, theme) })\n    }\n  }, [project, theme, patchProject])\n\n  // --- Compilation ----------------------------------------------------------------------------\n  const compiled = React.useMemo(() => {\n    if (!project || !cut || !theme) return null\n    if (validate('brief', project.brief).length || validate('cut', cut).length) return null\n    try {\n      return compile({ brief: project.brief, cut, theme, format, dark: renderDark, seed: project.seed ?? 1, fitScale: contentScale, composition, componentBundle })\n    } catch (err) {\n      return { html: '', meta: {}, error: err.message }\n    }\n  }, [project, cut, theme, format, renderDark, contentScale, composition, componentBundle])\n\n  // DEUX RENDUS, ET C'EST DELIBERE. `compiled` sert AUSSI a l'export (HTML et PNG), qui doit rester\n  // sans script : le pont de selection n'y a donc pas sa place. L'apercu recoit un second rendu, le\n  // meme au pont pres. Le cout est un assemblage de chaine, pas un travail reseau.\n  const previewHtml = React.useMemo(() => {\n    if (!project || !cut || !theme) return ''\n    try {\n      return compile({ brief: project.brief, cut, theme, format, dark: renderDark, seed: project.seed ?? 1, fitScale: contentScale, composition, componentBundle, interactive: true }).html\n    } catch { return compiled?.html || '' }\n  }, [project, cut, theme, format, renderDark, contentScale, composition, componentBundle, compiled])\n\n  const debouncedHtml = useDebounced(previewHtml, 220)\n  // LA PIÈCE SÉLECTIONNÉE ET SES CHAMPS DÉCLARÉS (carte C1, volet interface).\n  //\n  // Le compilateur sait lire `item.props` depuis l'étape 2, mais rien ne permettait d'en SAISIR une\n  // valeur : C1 existait sans surface. C'est ici qu'elle en reçoit une, et c'est le geste\n  // fondamental d'un éditeur de widgets — sélectionner une pièce, éditer ses propriétés.\n  // LES TROIS SÉLECTEURS DE PANNEAU LISENT `idPourPanneau`, PAS `selectedComponent` DIRECTEMENT.\n  // C'est tout ce que demande le verrou : le reste de l'interface (surlignage dans la hiérarchie,\n  // pont de sélection depuis l'aperçu) continue de suivre `selectedComponent` sans changement.\n  const pieceSelectionnee = React.useMemo(() => {\n    if (!idPourPanneau) return null\n    for (const row of composition?.rows || []) for (const item of row.items || []) if (item.id === idPourPanneau) return item\n    return null\n  }, [composition, idPourPanneau])\n\n  // L'ARBRE DES SOUS-COMPOSANTS, lu sur la page réellement compilée et non sur le gabarit source.\n  // C'est ce qui le rend juste : ce que l'arbre montre est ce que la page contient, pas ce que\n  // l'auteur du fragment avait prévu. On le recalcule sur le HTML DÉBOUNCÉ, celui de l'aperçu,\n  // afin qu'il ne se reconstruise pas à chaque frappe.\n  const arbreNoeuds = React.useMemo(() => parseTree(debouncedHtml), [debouncedHtml])\n\n  // Le geste d'Unreal, et celui de Photoshop : un clic ouvre le nœud, un shift-clic ouvre ou ferme\n  // toute sa descendance d'un coup. Le sens du basculement est décidé par l'état du nœud cliqué,\n  // sans quoi une descendance à moitié ouverte se replierait par moitiés à chaque clic.\n  const basculerNoeud = React.useCallback((instanceId, chemin, avecDescendance) => {\n    setOuverts((etat) => {\n      const clef = `${instanceId}:${chemin}`\n      const ouvrir = !etat[clef]\n      if (!avecDescendance) return { ...etat, [clef]: ouvrir }\n      const racine = findNode(arbreNoeuds, instanceId, chemin)\n      const suite = { ...etat, [clef]: ouvrir }\n      for (const p of allPaths(racine ? [racine] : [])) suite[`${instanceId}:${p}`] = ouvrir\n      return suite\n    })\n  }, [arbreNoeuds])\n\n  // Tout replier, y compris les pièces : le bouton que Matthieu cherchait dans la hiérarchie.\n  const toutReplier = React.useCallback(() => {\n    setOuverts({}); setOpenNodes({})\n    const g = { calques: true }\n    for (const row of composition.rows || []) g[`row:${row.id}`] = true\n    setGroupesReplies(g)\n  }, [composition])\n  const toutDeplier = React.useCallback(() => {\n    const suite = {}\n    const pieces = {}\n    for (const [instanceId, liste] of Object.entries(arbreNoeuds)) {\n      pieces[instanceId] = true\n      for (const p of allPaths(liste)) suite[`${instanceId}:${p}`] = true\n    }\n    setOuverts(suite); setOpenNodes(pieces); setGroupesReplies({})\n  }, [arbreNoeuds])\n\n  // L'ordre visible de la hiérarchie : les calques du premier plan vers le fond, puis les pièces\n  // rangée par rangée. Maj-clic sélectionne « de l'ancre jusqu'ici » DANS CET ORDRE, sans quoi la\n  // plage choisie ne correspondrait pas à ce que l'œil voit.\n  const ordreHierarchie = React.useMemo(() => [\n    ...stackOrder(composition).map((l) => l.id),\n    ...(composition.rows || []).flatMap((r) => (r.items || []).map((it) => it.id)),\n  ], [composition])\n\n  const choisir = React.useCallback((id, event) => {\n    const multiple = event?.metaKey || event?.ctrlKey\n    const plage = event?.shiftKey\n    setSelection((avant) => {\n      if (plage && ancreRef.current) {\n        const a = ordreHierarchie.indexOf(ancreRef.current)\n        const b = ordreHierarchie.indexOf(id)\n        if (a >= 0 && b >= 0) return ordreHierarchie.slice(Math.min(a, b), Math.max(a, b) + 1)\n      }\n      if (multiple) return avant.includes(id) ? avant.filter((x) => x !== id) : [...avant, id]\n      return [id]\n    })\n    if (!plage) ancreRef.current = id\n    setSelectedComponent(id)\n    setSelectedNode(null)\n    setDeckTab('details')\n  }, [ordreHierarchie])\n\n  const naviguerHierarchie = React.useCallback((direction) => {\n    if (!ordreHierarchie.length) return\n    const i = ordreHierarchie.indexOf(selectedComponent)\n    const suivant = i < 0 ? 0 : Math.max(0, Math.min(ordreHierarchie.length - 1, i + direction))\n    choisir(ordreHierarchie[suivant], {})\n  }, [ordreHierarchie, selectedComponent, choisir])\n\n\n  // Une action de groupe s'applique à TOUTE la sélection, jamais au seul objet cliqué : c'est le\n  // seul comportement qui rende la sélection multiple utile.\n  // Agir sur une rangée QUI N'EST PAS dans la sélection n'agit que sur elle : c'est le\n  // comportement du Finder comme de Photoshop, et l'inverse serait dangereux, puisqu'on\n  // supprimerait quinze objets en croyant en supprimer un.\n  const surLaSelection = React.useCallback((agir, idClique) => {\n    const cibles = idClique && !selection.includes(idClique)\n      ? [idClique]\n      : (selection.length ? selection : (idClique ? [idClique] : []))\n    patchComposition((c) => cibles.reduce((etat, id) => agir(etat, id), c))\n  }, [selection])\n\n  // ═══ FAMILLE PHOTOSHOP 8 · COPIER, COUPER, COLLER ═══════════════════════════════════════════\n  //\n  // Bornées aux CALQUES, comme l'alignement (P2) et les groupes (P5) : les pièces Lego déclarent\n  // des propriétés propres au thème, un copier-coller générique entre deux familles de composants\n  // produirait des pièces à moitié vides plutôt qu'un vrai duplicata.\n  //\n  // LE PRESSE-PAPIERS EST INTERNE, une simple réf, pas le presse-papiers du SYSTÈME : Photoshop\n  // lui-même distingue le presse-papiers applicatif du presse-papiers système, et un calque n'a\n  // aucun format d'échange universel à offrir à une autre application.\n  const pressePapiersRef = React.useRef([])\n  const decalageCollageRef = React.useRef(0)\n\n  const copierSelection = React.useCallback(() => {\n    const calques = readLayers(composition).filter((l) => selection.includes(l.id) || l.id === selectedComponent)\n    if (!calques.length) return false\n    // Clonage par aller-retour JSON : un calque ne porte que des données sérialisables (nombres,\n    // chaînes, booléens, objets plats), donc ce tour suffit à en garantir une copie INDÉPENDANTE,\n    // que des modifications ultérieures du document ne pourront plus jamais atteindre.\n    pressePapiersRef.current = JSON.parse(JSON.stringify(calques))\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"6b8c71a4-bf2e-4775-bb32-5a852d61030b"}}}
