{"timestamp":"2026-08-05T17:09:01.632Z","ordinal":1111,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd2e6-6240-72b2-b60c-ca6e7aa70ad1","call_id":"call_aKoAfkziO8ECCTsp6beEQCpk","output":[{"type":"input_text","text":"Script completed\nWall time 0.0 seconds\nOutput:\n"},{"type":"input_text","text":"// ZenRayMedia — le fil d'Ariane de Create.\n//\n// UN SEUL composant pour les deux gestes, parce que c'est le même geste : parcourir la même\n// arborescence.\n//   mode=\"save\" -> choisir le dossier de destination et le nom du fichier\n//   mode=\"open\" -> parcourir et ouvrir un document existant\n//\n// Il ne charge QUE le dossier affiché (`action=children`, non récursif) : parcourir un drive de\n// plusieurs milliers de nœuds ne coûte jamais plus qu'un seul appel par dossier ouvert.\n\nimport React from 'react'\nimport Icon from '../components/Icon.jsx'\nimport { listFolders, listDocuments, crumbsOf, parentOf, slugify, ZMEDIA_EXT, DEFAULT_MEDIA_DIR } from './document.js'\n\nexport default function CreateBrowser({ mode = 'save', startDir = DEFAULT_MEDIA_DIR, defaultName = '', onCancel, onConfirm, onOpen, busy = false }) {\n  const [dir, setDir] = React.useState(startDir)\n  const [folders, setFolders] = React.useState([])\n  const [documents, setDocuments] = React.useState([])\n  const [loading, setLoading] = React.useState(true)\n  const [name, setName] = React.useState(slugify(defaultName))\n  const [newFolder, setNewFolder] = React.useState('')\n\n  React.useEffect(() => {\n    let cancelled = false\n    setLoading(true)\n    Promise.all([listFolders(dir), mode === 'open' ? listDocuments(dir) : Promise.resolve([])])\n      .then(([f, d]) => { if (!cancelled) { setFolders(f); setDocuments(d) } })\n      .catch(() => { if (!cancelled) { setFolders([]); setDocuments([]) } })\n      .finally(() => { if (!cancelled) setLoading(false) })\n    return () => { cancelled = true }\n  }, [dir, mode])\n\n  const crumbs = crumbsOf(dir)\n  const atRoot = crumbs.length <= 1\n  const finalPath = `${dir.replace(/\\/+$/, '')}/${slugify(name) || 'media'}${ZMEDIA_EXT}`\n\n  // Un dossier n'existe pas tant qu'il ne contient rien : on ne crée donc rien tout de suite,\n  // on descend simplement dedans. Le dossier naîtra avec le premier fichier écrit — c'est déjà\n  // le comportement de Git, inutile d'inventer une étape de création qui pourrait échouer.\n  const enterNewFolder = () => {\n    const slug = slugify(newFolder)\n    if (!slug) return\n    setDir(`${dir.replace(/\\/+$/, '')}/${slug}`)\n    setNewFolder('')\n  }\n\n  return (\n    <div className=\"zrm-browser\">\n      <div className=\"zrm-crumbs\">\n        <button className=\"zrm-btn zrm-btn-sm zrm-btn-icon\" title=\"Dossier parent\" onClick={() => setDir(parentOf(dir))} disabled={atRoot}>\n          <Icon name=\"chevron.left\" size={12} />\n        </button>\n        {crumbs.map((crumb, i) => (\n          <React.Fragment key={crumb.path}>\n            {i > 0 && <span className=\"zrm-crumb-sep\">/</span>}\n            <button className=\"zrm-crumb\" data-on={i === crumbs.length - 1} onClick={() => setDir(crumb.path)}>{crumb.name}</button>\n          </React.Fragment>\n        ))}\n      </div>\n\n      <div className=\"zrm-browser-list\">\n        {loading && <p className=\"zrm-note\">Lecture du dossier…</p>}\n        {!loading && folders.length === 0 && documents.length === 0 && <p className=\"zrm-note\">Dossier vide.</p>}\n        {folders.map((folder) => (\n          <button key={folder.path} className=\"zrm-browser-row\" onClick={() => setDir(folder.path)}>\n            <Icon name=\"folder\" size={14} />\n            <span className=\"zrm-browser-name\">{folder.name}</span>\n            <Icon name=\"chevron.right\" size={11} />\n          </button>\n        ))}\n        {documents.map((doc) => (\n          <button key={doc.path} className=\"zrm-browser-row\" data-doc=\"true\" onClick={() => onOpen?.(doc.path)}>\n            <Icon name=\"doc.text\" size={14} />\n            <span className=\"zrm-browser-name\">{doc.name}</span>\n          </button>\n        ))}\n      </div>\n\n      {mode === 'save' ? (\n        <div className=\"zrm-browser-foot\">\n          <div className=\"zrm-row\">\n            <input className=\"zrm-input\" aria-label=\"Nom du fichier\" value={name} placeholder=\"nom-du-document\"\n              onChange={(e) => setName(e.target.value)} onKeyDown={(e) => { if (e.key === 'Enter') onConfirm?.(finalPath) }} />\n            <input className=\"zrm-input\" aria-label=\"Nouveau sous-dossier\" value={newFolder} placeholder=\"+ sous-dossier\"\n              onChange={(e) => setNewFolder(e.target.value)} onKeyDown={(e) => { if (e.key === 'Enter') enterNewFolder() }} />\n          </div>\n          <p className=\"zrm-mono zrm-browser-path\" title={finalPath}>{finalPath}</p>\n          <div className=\"zrm-row\">\n            <button className=\"zrm-btn\" onClick={onCancel} disabled={busy}>Annuler</button>\n            <button className=\"zrm-btn zrm-btn-primary\" onClick={() => onConfirm?.(finalPath)} disabled={busy || !slugify(name)}>\n              {busy ? 'Enregistrement…' : 'Enregistrer ici'}\n            </button>\n          </div>\n        </div>\n      ) : (\n        <div className=\"zrm-browser-foot\">\n          <button className=\"zrm-btn\" onClick={onCancel}>Fermer</button>\n        </div>\n      )}\n    </div>\n  )\n}\n              <div className=\"zrm-beat-actions\">\n                <label className=\"zrm-btn zrm-btn-sm\" title={`Ajouter une image (${(beat.slots || []).length}/${MAX_SLOTS})`} style={{ cursor: (beat.slots || []).length >= MAX_SLOTS ? 'not-allowed' : 'pointer' }}>\n                  <Icon name=\"photo\" size={12} />\n                  <input type=\"file\" accept=\"image/*\" multiple aria-label={`Images du bloc ${i + 1}`} style={{ display: 'none' }}\n                    disabled={(beat.slots || []).length >= MAX_SLOTS || busy === 'image'}\n                    onChange={(e) => { attachImages(i, e.target.files); e.target.value = '' }} />\n                </label>\n                <button className=\"zrm-btn zrm-btn-sm\" title=\"Monter\" onClick={() => withCut((c) => moveBeat(c, i, Math.max(0, i - 1)))} disabled={i === 0}>↑</button>\n                <button className=\"zrm-btn zrm-btn-sm\" title=\"Descendre\" onClick={() => withCut((c) => moveBeat(c, i, Math.min(cut.beats.length - 1, i + 1)))} disabled={i === cut.beats.length - 1}>↓</button>\n                <button className=\"zrm-btn zrm-btn-sm\" onClick={() => withCut((c) => mergeBeats(c, i))} disabled={i >= cut.beats.length - 1}>Fusionner</button>\n                <button className=\"zrm-btn zrm-btn-sm\" onClick={() => withCut((c) => splitBeat(c, i))}>Scinder</button>\n                <button className=\"zrm-btn zrm-btn-sm\" title=\"Insérer un bloc après\" onClick={() => withCut((c) => addBeat(c, i))}>+</button>\n                <button className=\"zrm-btn zrm-btn-sm\" onClick={() => withCut((c) => removeBeat(c, i))} disabled={cut.beats.length <= 1}>Retirer</button>\n              </div>\n            </div>\n          ))}\n\n          <details style={{ marginTop: 14 }}>\n            <summary className=\"zrm-label\" style={{ cursor: 'pointer', marginBottom: 8 }}>Notes source</summary>\n            <textarea className=\"zrm-textarea\" aria-label=\"Notes\" style={{ minHeight: 130 }} value={project.notes} onChange={(e) => patchProject({ notes: e.target.value })} />\n            <div className=\"zrm-row\" style={{ marginTop: 8 }}>\n              <button className=\"zrm-btn zrm-btn-sm\" onClick={buildCutNow} disabled={!theme}>Monter l’article</button>\n              <button className=\"zrm-btn zrm-btn-sm\" onClick={() => patchProject({ notes: SEED_NOTES })}>Notes d’exemple</button>\n            </div>\n            <p className=\"zrm-note\" style={{ marginTop: 6 }}>Une ligne vide sépare deux blocs. Remonter l’article écrase les blocs modifiés à la main.</p>\n          </details>\n            </>\n          )}\n\n          {deckTab === 'create' && (\n            <>\n              {published && (\n                <div className=\"zrm-verdict\" data-ok=\"true\" style={{ display: 'block' }}>\n                  <div style={{ marginBottom: 6 }}>Publié · {published.indexed ? 'indexé' : 'indexation en attente'} · {formatBytes(published.bytes)}</div>\n                  <div className=\"zrm-mono\" style={{ wordBreak: 'break-all', marginBottom: 8 }}>{published.url}</div>\n                  <div className=\"zrm-row\">\n                    <button className=\"zrm-btn zrm-btn-sm\" onClick={async () => notify(await copyText(published.url) ? 'Adresse copiée.' : 'Copie refusée.', 'ok')}>Copier l’adresse</button>\n                    <button className=\"zrm-btn zrm-btn-sm\" onClick={() => window.dispatchEvent(new CustomEvent('zr:open-page', { detail: { path: published.path } }))}>Ouvrir la page</button>\n                  </div>\n                </div>\n              )}\n              <p className=\"zrm-note\" style={{ marginBottom: 10 }}>\n                <strong style={{ fontWeight: 500 }}>Enregistrer</strong> range la source dans ton index Create, à l’endroit que tu choisis, pour la rouvrir et continuer.\n                {' '}<strong style={{ fontWeight: 500 }}>Rendre</strong> produit une page figée et partageable. Même arborescence, deux gestes différents.\n              </p>\n              <CreateBrowser\n                mode={browser === 'open' ? 'open' : 'save'}\n                startDir={docPath ? dirOf(docPath) : DEFAULT_MEDIA_DIR}\n                defaultName={docPath ? docPath.split('/').pop().replace('.zmedia.json', '') : slugify(project.brief.title)}\n                busy={busy === 'save' || busy === 'open'}\n                onCancel={() => setBrowser(null)}\n                onConfirm={persist}\n                onOpen={openDocument}\n              />\n              <div className=\"zrm-row\" style={{ marginTop: 10 }}>\n                <button className=\"zrm-btn zrm-btn-sm\" data-on={browser !== 'open'} onClick={() => setBrowser('save')}>Enregistrer</button>\n                <button className=\"zrm-btn zrm-btn-sm\" data-on={browser === 'open'} onClick={() => setBrowser('open')}>Ouvrir</button>\n              </div>\n            </>\n          )}\n\n          {deckTab === 'sorties' && (\n            <>\n              <div className=\"zrm-verdict\" data-ok={treeSummary.blocking === 0}>\n                <Icon name={treeSummary.blocking === 0 ? 'checkmark' : 'hand.raised'} size={15} />\n                {treeSummary.ready}/{treeSummary.total} sorties prêtes\n                {treeSummary.blocking > 0 ? ` · ${treeSummary.blocking} défaut(s) bloquant(s)` : ''}\n              </div>\n              <p className=\"zrm-note\" style={{ marginBottom: 10 }}>\n                Le même article, décliné. Chaque branche porte son état réel : ce qu'elle montre, ce qu'elle laisse de côté, et le verdict du Critique — avant d'avoir cliqué.\n              </p>\n              {tree.map((group) => (\n                <div key={group.id} className=\"zrm-family\" data-open=\"true\">\n                  <div className=\"zrm-family-head\" style={{ cursor: 'default' }}>\n                    {group.label}<span className=\"zrm-family-count\">{group.ready}/{group.total}</span>\n                  </div>\n// ZenRayMedia — L11 : le Critique.\n//\n// 01-PLAN §9 : « Le Critique est le poste qui fait la différence entre premium et amateur. Sans\n// lui, la machine produit mille médias moyens. » C'est le SEUL poste obligatoire du cycle :\n// aucun livrable ne sort sans son passage, et un défaut bloquant interdit la publication.\n//\n// Deux familles de contrôles :\n//   - STATIQUES : sur les données (brief, cut, thème, format). Aucun rendu nécessaire.\n//   - MESURÉS   : sur la page réellement rendue (débordement, zones de sécurité, taille de\n//                 texte). Mesurés dans le document, jamais estimés — une estimation qui se\n//                 trompe est pire que pas de contrôle du tout.\n\nimport { validate, sentenceCount } from './contracts.js'\nimport { isTemporal, durationOf } from './formats.js'\nimport { omittedCount, visibleBeats } from './compile.js'\nimport { slotsWeight, countSlots, MAX_SLOTS } from './cut.js'\nimport { missingFamilies, fontsWeight } from './fonts.js'\n\nexport const SEVERITY = { blocking: 'blocking', warning: 'warning', info: 'info' }\n\nconst issue = (severity, code, message, fix = null) => ({ severity, code, message, fix })\n\n// --- Couleur et contraste ---------------------------------------------------------------------\nexport function parseColor(input) {\n  const s = String(input || '').trim()\n  let m = /^#([0-9a-f]{3,8})$/i.exec(s)\n  if (m) {\n    const h = m[1]\n    if (h.length === 3 || h.length === 4) {\n      const [r, g, b, a = 'f'] = h.split('')\n      return { r: parseInt(r + r, 16), g: parseInt(g + g, 16), b: parseInt(b + b, 16), a: parseInt(a + a, 16) / 255 }\n    }\n    if (h.length === 6 || h.length === 8) {\n      return { r: parseInt(h.slice(0, 2), 16), g: parseInt(h.slice(2, 4), 16), b: parseInt(h.slice(4, 6), 16), a: h.length === 8 ? parseInt(h.slice(6, 8), 16) / 255 : 1 }\n    }\n  }\n  m = /^rgba?\\(([^)]+)\\)$/i.exec(s)\n  if (m) {\n    const parts = m[1].split(/[,\\s/]+/).filter(Boolean).map(Number)\n    if (parts.length >= 3 && parts.slice(0, 3).every((n) => Number.isFinite(n))) {\n      return { r: parts[0], g: parts[1], b: parts[2], a: Number.isFinite(parts[3]) ? parts[3] : 1 }\n    }\n  }\n  return null\n}\n\nfunction channelLuminance(c) {\n  const v = c / 255\n  return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4)\n}\n\nexport function relativeLuminance(color) {\n  return 0.2126 * channelLuminance(color.r) + 0.7152 * channelLuminance(color.g) + 0.0722 * channelLuminance(color.b)\n}\n\n// Compose une couleur semi-transparente sur son fond : sans ça, un `rgba(20,22,26,.56)` sur blanc\n// serait mesuré comme du quasi-noir et le contraste serait faux.\nexport function composite(fg, bg) {\n  const a = fg.a ?? 1\n  return { r: fg.r * a + bg.r * (1 - a), g: fg.g * a + bg.g * (1 - a), b: fg.b * a + bg.b * (1 - a), a: 1 }\n}\n\nexport function contrastRatio(foreground, background) {\n  const fg = parseColor(foreground)\n  const bg = parseColor(background)\n  if (!fg || !bg) return null\n  const composed = composite(fg, { ...bg, a: 1 })\n  const l1 = relativeLuminance(composed)\n  const l2 = relativeLuminance(bg)\n  const [hi, lo] = l1 > l2 ? [l1, l2] : [l2, l1]\n  return Math.round(((hi + 0.05) / (lo + 0.05)) * 100) / 100\n}\n\n// --- Contrôles statiques -----------------------------------------------------------------------\nexport function inspectStatic({ brief, cut, theme, format, dark = false, composed = false }) {\n  const issues = []\n\n  for (const [kind, value] of [['brief', brief], ['cut', cut], ['theme', theme], ['format', format]]) {\n    for (const err of validate(kind, value)) {\n      issues.push(issue(SEVERITY.blocking, `${kind}.${err.code}`, err.message))\n    }\n  }\n  if (issues.length) return issues // inutile de mesurer une structure invalide\n\n  // ZM-L2-02 — message unique.\n  if (sentenceCount(brief.message) > 1) {\n    issues.push(issue(SEVERITY.blocking, 'message.multi', 'Le message tient en une seule phrase.'))\n  }\n\n  // ZM-L11-02 — contraste réel de l'encre sur le fond, au seuil posé par le thème.\n  const ink = dark ? theme.palette.inkDark : theme.palette.ink\n  const bg = dark ? theme.surface.backgroundDark : theme.surface.background\n  const ratio = contrastRatio(ink, bg)\n  const minContrast = theme.palette.minContrast || 4.5\n  if (ratio == null) {\n    issues.push(issue(SEVERITY.warning, 'contrast.unreadable', 'Couleurs du thème non analysables : contraste non vérifié.'))\n  } else if (ratio < minContrast) {\n    issues.push(issue(SEVERITY.blocking, 'contrast.low', `Contraste ${ratio}:1 sous le seuil ${minContrast}:1 du thème (mode ${dark ? 'sombre' : 'clair'}).`))\n  }\n  const muted = dark ? theme.palette.mutedDark : theme.palette.muted\n  const mutedRatio = contrastRatio(muted, bg)\n  if (mutedRatio != null && mutedRatio < 4.5) {\n    issues.push(issue(SEVERITY.warning, 'contrast.muted', `Texte secondaire à ${mutedRatio}:1 : sous 4,5:1, il devient pénible à lire.`))\n  }\n\n  // ZM-L4 — le thème déclare-t-il ce format ?\n  if (Array.isArray(theme.formats) && !theme.formats.includes(format.id)) {\n    issues.push(issue(SEVERITY.warning, 'theme.format', `« ${theme.name} » ne déclare pas le format ${format.label} : le rendu peut être approximatif.`))\n  }\n\n  // ZM-L3-03 — nombre de beats imposé par le thème.\n  const count = cut.beats.length\n  const { min, max } = theme.beatCount || { min: 1, max: 99 }\n  if (count < min) issues.push(issue(SEVERITY.warning, 'cut.tooFew', `${count} beat(s) pour un thème qui en attend ${min} au minimum.`, 'refit'))\n  if (count > max) issues.push(issue(SEVERITY.warning, 'cut.tooMany', `${count} beats pour un thème qui en accepte ${max} au maximum.`, 'refit'))\n\n  // ZM-L11-04 — durée dans les bornes du format.\n  if (isTemporal(format)) {\n    const d = durationOf(cut, format)\n    if (d <= format.time.min) issues.push(issue(SEVERITY.warning, 'duration.short', `Durée ${d}s au plancher du format (${format.time.min}s) : le contenu a été comprimé.`))\n    if (d >= format.time.max) issues.push(issue(SEVERITY.blocking, 'duration.long', `Durée ${d}s au plafond du format (${format.time.max}s) : retire ou raccourcis un beat.`))\n  }\n\n  // ZM-L2-08 — les mentions obligatoires apparaissent dans le contenu.\n  const haystack = `${brief.title} ${brief.message} ${cut.beats.map((b) => b.text).join(' ')}`.toLowerCase()\n  for (const mention of brief.constraints?.mentions || []) {\n    if (mention && !haystack.includes(String(mention).toLowerCase())) {\n      issues.push(issue(SEVERITY.blocking, 'mention.missing', `Mention obligatoire absente du contenu : « ${mention} ».`))\n    }\n  }\n\n  // Politique de contenu du format : ce qui n'est pas affiché doit être DIT. Un bloc qui\n  // disparaît sans un mot est la pire des interfaces -- on croit avoir publié son texte entier.\n  // ... SAUF sur la voie composée, où les blocs ne sont plus la source de la page : celle-ci est\n  // faite des pièces posées, et compter des blocs « omis » y raconte une histoire fausse. C'est le\n  // second point où le Critique parlait de l'ancien modèle en regardant le nouveau.\n  const omitted = composed ? 0 : omittedCount(cut, format)\n  if (omitted > 0) {\n    issues.push(issue(SEVERITY.info, 'fit.omitted',\n      `Ce format montre ${visibleBeats(cut, format).length} bloc(s) sur ${cut.beats.length} : ${omitted} restent réservés aux formats de lecture (Web, A4). C'est voulu — une image ne porte pas un article.`))\n  }\n\n  // Poids des médias encodés. Un document de plusieurs mégaoctets alourdit chaque enregistrement\n  // dans le drive et chaque relecture : on le dit AVANT que ça devienne pénible, pas après.\n  const mediaBytes = slotsWeight(cut)\n  if (mediaBytes > 6_000_000) {\n    issues.push(issue(SEVERITY.warning, 'doc.heavy', `${Math.round(mediaBytes / 1e6)} Mo d'images encodées dans le document : au-delà de 6 Mo, chaque enregistrement devient lent. Retire une image ou attends le stockage en shards.`))\n  }\n  const slots = countSlots(cut)\n  if (slots > 0 && format.kind === 'web' && slots > cut.beats.length * MAX_SLOTS) {\n    issues.push(issue(SEVERITY.warning, 'slots.many', `${slots} images pour ${cut.beats.length} blocs : la page devient lourde à charger.`))\n  }\n\n  // ZM-L4-11 — polices du thème. Une famille absente du disque n'est pas une erreur : la page\n  // retombe sur sa pile système. Mais le rendu ne sera PAS celui mesuré sur les captures, et\n  // c'est exactement le genre d'écart qu'on ne voit pas et qu'on livre quand même.\n  const missing = missingFamilies(theme.fonts || [])\n  if (missing.length) {\n    issues.push(issue(SEVERITY.warning, 'font.missing',\n      `Police non installée : ${missing.join(', ')}. Le rendu utilise un repli système, donc pas la typographie mesurée. Installer avec « node scripts/zrm-fonts.mjs --cjk » si c'est une famille japonaise.`))\n  }\n  const fontBytes = fontsWeight(theme.fonts || [])\n  if (fontBytes > 1_500_000) {\n    issues.push(issue(SEVERITY.warning, 'font.heavy',\n      `${Math.round(fontBytes / 1e6 * 10) / 10} Mo de polices embarquées à l'export : la page devient lente à ouvrir. Retire une graisse ou une famille.`))\n  }\n\n  // ZM-L11-06 — un beat d'un seul mot n'est pas un beat.\n  cut.beats.forEach((beat, i) => {\n    const words = String(beat.text).trim().split(/\\s+/).filter(Boolean).length\n    if (words < 3) issues.push(issue(SEVERITY.warning, 'beat.thin', `Beat ${i + 1} (${beat.role}) : ${words} mot(s). Trop court pour porter quoi que ce soit.`))\n  })\n\n  // Un cut sans appel final quand l'intention est de vendre ou convaincre.\n  if (['vendre', 'convaincre'].includes(brief.intent) && !cut.beats.some((b) => b.role === 'cta')) {\n    issues.push(issue(SEVERITY.warning, 'cut.noCta', `Intention « ${brief.intent} » sans beat d'appel : le lecteur ne saura pas quoi faire.`))\n  }\n\n  return issues\n}\n\n// --- Contrôles mesurés sur la page rendue -------------------------------------------------------\n// `doc` est le document de l'iframe d'aperçu. On MESURE, on n'estime pas.\nexport function inspectRendered(doc, format) {\n  const issues = []\n  if (!doc || !doc.body) return issues\n  const view = doc.defaultView\n  if (!view) return issues\n\n  // LE CRITIQUE ÉTAIT AVEUGLE À LA VOIE LEGO, et cela produisait un faux positif systématique.\n  //\n  // Il cherchait `.zrm-page`, que seule la voie à jetons produit ; la voie composée écrit\n  // `.zrm-lego-page`. Faute de la trouver, il mesurait le `body`, lequel fait exactement la taille\n  // du canevas, et le comparait à l'espace utile, c'est-à-dire au canevas MOINS les zones de\n  // sécurité. Le verdict tombait donc toujours, et toujours du même chiffre : la somme des zones\n  // de sécurité. En Carré 1080, quarante-huit en haut plus quarante-huit en bas, soit les 96 px\n  // annoncés sur les deux axes à la fois. Un débordement identique en hauteur et en largeur n'est\n  // jamais du contenu, c'est une constante ; c'est ce qui a mis sur la piste.\n  const legoPage = doc.querySelector('.zrm-lego-page')\n  const page = legoPage || doc.querySelector('.zrm-page') || doc.body\n  const fixed = format?.canvas?.h > 0\n  const safe = format?.safe || { top: 0, bottom: 0, sides: 0 }\n\n  // ZM-L11-03 — débordement réel.\n  // On mesure la page CONTRE L'ESPACE UTILE (canevas moins zones de sécurité), pas contre le\n  // body. Le cadre centre son contenu en flex avec `overflow:hidden` : un contenu trop haut y\n  // déborde SYMÉTRIQUEMENT et se fait rogner en haut ET en bas, sans que `scrollHeight` du body\n  // ne bouge. Mesurer le body laisserait donc passer une coupe franche sans rien signaler.\n  if (fixed) {\n    const usableH = format.canvas.h - safe.top - safe.bottom\n    const usableW = format.canvas.w - safe.sides * 2\n    // La page composée RÉSERVE elle-même ses zones de sécurité, sous forme de remplissage. Son\n    // débordement se lit donc dans sa propre boîte, et non contre une largeur utile qu'elle a déjà\n    // déduite : la mesurer comme l'autre voie reviendrait à retrancher deux fois la même marge.\n    const overflowY = legoPage\n      ? Math.round(legoPage.scrollHeight - legoPage.clientHeight)\n      : Math.round(page.getBoundingClientRect().height - usableH)\n    if (overflowY > 2) {\n      issues.push(issue(SEVERITY.blocking, 'overflow.vertical', `Le contenu dépasse de ${overflowY} px la hauteur utile du format : il sera rogné en haut et en bas.`, 'shrink'))\n    }\n    const overflowX = legoPage\n      ? Math.round(legoPage.scrollWidth - legoPage.clientWidth)\n      : Math.round(page.scrollWidth - usableW)\n    if (overflowX > 2) {\n      issues.push(issue(SEVERITY.blocking, 'overflow.horizontal', `Le contenu dépasse de ${overflowX} px la largeur utile du format.`, 'shrink'))\n    }\n  }\n\n  // ZM-L11-01 — zones de sécurité des plateformes.\n  if (fixed && format?.safe) {\n    const H = format.canvas.h\n    const W = format.canvas.w\n    for (const el of doc.querySelectorAll('.zrm-title, .zrm-beat-text, .zrm-standfirst, .zrm-byline, .zrm-kicker')) {\n      const r = el.getBoundingClientRect()\n      if (r.width === 0 && r.height === 0) continue\n      if (r.top < safe.top - 1) { issues.push(issue(SEVERITY.blocking, 'safe.top', `Du texte entre dans la zone haute réservée à l'interface (${Math.round(safe.top - r.top)} px trop haut).`, 'shrink')); break }\n      if (r.bottom > H - safe.bottom + 1) { issues.push(issue(SEVERITY.blocking, 'safe.bottom', `Du texte entre dans la zone basse réservée à l'interface (${Math.round(r.bottom - (H - safe.bottom))} px trop bas).`, 'shrink')); break }\n      if (r.left < safe.sides - 1 || r.right > W - safe.sides + 1) { issues.push(issue(SEVERITY.blocking, 'safe.sides', 'Du texte sort des marges latérales de sécurité.', 'shrink')); break }\n    }\n  }\n\n  // ZM-L11-05 — plancher de lisibilité. 12 px est la règle du projet sur poste fixe ; sur un\n  // format à canevas fixe, le plancher est relatif au canevas (1,1 % de la hauteur).\n  const floor = fixed ? Math.max(12, Math.round(format.canvas.h * 0.011)) : 12\n  for (const el of doc.querySelectorAll('.zrm-beat-text, .zrm-standfirst')) {\n    const size = parseFloat(view.getComputedStyle(el).fontSize)\n    if (Number.isFinite(size) && size < floor) {\n      issues.push(issue(SEVERITY.warning, 'type.tooSmall', `Texte à ${Math.round(size)} px, sous le plancher de ${floor} px : illisible à l'échelle de diffusion.`))\n      break\n    }\n  }\n\n  // ZM-L11-06 — ligne isolée en fin de bloc (veuve).\n  for (const el of doc.querySelectorAll('.zrm-beat-text')) {\n    const words = String(el.textContent || '').trim().split(/\\s+/).filter(Boolean)\n    if (words.length < 8) continue\n    const lineHeight = parseFloat(view.getComputedStyle(el).lineHeight)\n    const lines = Number.isFinite(lineHeight) && lineHeight > 0 ? Math.round(el.getBoundingClientRect().height / lineHeight) : 1\n    if (lines > 1 && words[words.length - 1].length <= 3) {\n      issues.push(issue(SEVERITY.info, 'type.widow', 'Un mot très court finit seul une ligne : insécable recommandé.'))\n      break\n    }\n  }\n\n  return issues\n}\n\nexport function summarize(issues) {\n  const blocking = issues.filter((i) => i.severity === SEVERITY.blocking)\n  const warnings = issues.filter((i) => i.severity === SEVERITY.warning)\n  const infos = issues.filter((i) => i.severity === SEVERITY.info)\n  return { blocking, warnings, infos, canPublish: blocking.length === 0, total: issues.length }\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"6b8c71a4-bf2e-4775-bb32-5a852d61030b"}}}
