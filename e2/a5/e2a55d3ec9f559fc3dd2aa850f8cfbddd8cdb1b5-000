{"timestamp":"2026-08-05T16:24:30.044Z","ordinal":347,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd2bd-9e5c-7ce1-8851-14c97a801cd6","call_id":"call_DmqcBPtJaOhnE0B97n8k9Ycx","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"===== src/zenraymedia/publish.js =====\n     1\t// ZenRayMedia — L8 : PUBLIER.\n     2\t//\n     3\t// Publier n'est pas enregistrer (cf. `document.js`) :\n     4\t//   enregistrer -> `.zmedia.json`, la SOURCE, pour rouvrir et continuer ;\n     5\t//   publier     -> une PAGE `.md` dans Create, figée, lisible, cherchable, adressable par URL.\n     6\t//\n     7\t// Le format de sortie est du Markdown, pas du HTML compilé. Raison : une page `.md` est un\n     8\t// citoyen de première classe de Create — elle s'ouvre dans l'éditeur, se cherche, se déplace,\n     9\t// se partage, se modifie. Une page HTML serait un corps étranger qu'aucun outil du projet ne\n    10\t// saurait relire. Le rendu stylé, lui, reste l'export (`exporters.js`).\n    11\t\n    12\timport { saveText } from '../ref/content.js'\n    13\timport { ROLE_LABELS } from './contracts.js'\n    14\timport { visibleBeats } from './compile.js'\n    15\timport { slugify } from './document.js'\n    16\t\n    17\t/** Markdown d'un article. Déterministe : mêmes entrées, même texte, à l'octet près. */\n    18\texport function toMarkdown({ brief, cut, theme, format }) {\n    19\t  const lines = []\n    20\t  lines.push(`# ${brief.title}`)\n    21\t  lines.push('')\n    22\t  if (brief.message) { lines.push(`> ${brief.message}`); lines.push('') }\n    23\t  if (brief.audience) { lines.push(`*Pour ${brief.audience}.*`); lines.push('') }\n    24\t\n    25\t  for (const beat of visibleBeats(cut, format)) {\n    26\t    // Le rôle devient un intertitre seulement quand il porte du sens à la lecture. Une accroche\n    27\t    // et une chute n'ont pas besoin d'être annoncées : elles se reconnaissent à leur place.\n    28\t    if (!['hook', 'payoff'].includes(beat.role)) {\n    29\t      lines.push(`### ${ROLE_LABELS[beat.role] || beat.role}`)\n    30\t      lines.push('')\n    31\t    }\n    32\t    lines.push(String(beat.text).trim())\n    33\t    lines.push('')\n    34\t    for (const slot of beat.slots || []) {\n    35\t      const src = slot.dataUrl || slot.url\n    36\t      if (src) { lines.push(`![${(slot.label || '').replace(/[[\\]]/g, '')}](${src})`); lines.push('') }\n    37\t    }\n    38\t  }\n    39\t\n    40\t  lines.push('---')\n    41\t  lines.push('')\n    42\t  lines.push(`*Composé avec ZenRayMedia · thème « ${theme.name} » · format ${format.label}.*`)\n    43\t  lines.push('')\n    44\t  return lines.join('\\n')\n    45\t}\n    46\t\n    47\texport function publishPathFor(dir, title) {\n    48\t  return `${String(dir).replace(/\\/+$/, '')}/${slugify(title)}.md`\n    49\t}\n    50\t\n    51\t/** URL de l'application qui ouvre directement cette page. */\n    52\texport function pageUrlFor(path, origin) {\n    53\t  const base = origin || (typeof window !== 'undefined' ? window.location.origin : '')\n    54\t  return `${base}/?page=${encodeURIComponent(path)}`\n    55\t}\n    56\t\n    57\t/**\n    58\t * Publie l'article et rend son adresse.\n    59\t *\n    60\t * Trois étapes, dans cet ordre, parce que l'ordre compte :\n    61\t *   1. écrire la page (si ça échoue, rien d'autre ne doit se produire) ;\n    62\t *   2. l'ajouter à l'index de recherche (sinon elle existe mais reste introuvable) ;\n    63\t *   3. rendre l'URL — ET SEULEMENT SI les deux premières ont réussi.\n    64\t *\n    65\t * L'indexation est volontairement NON bloquante : une page écrite mais pas encore indexée est\n    66\t * un défaut mineur et réparable (elle sera reprise au prochain build d'index), alors qu'une\n    67\t * publication annulée parce que l'index a hoqueté serait une perte pour rien.\n    68\t */\n    69\texport async function publishArticle({ dir, brief, cut, theme, format, sha, origin }) {\n    70\t  const path = publishPathFor(dir, brief.title)\n    71\t  const markdown = toMarkdown({ brief, cut, theme, format })\n    72\t\n    73\t  const written = await saveText(path, markdown, sha)\n    74\t  if (written.conflict) return { ok: false, conflict: true, path, error: 'Une page porte déjà ce nom et a changé depuis. Renomme l’article ou recharge.' }\n    75\t  if (!written.ok) return { ok: false, path, error: written.error === 'network' ? 'Publication impossible (réseau).' : `Publication refusée (${written.error || 'inconnu'}).` }\n    76\t\n    77\t  let indexed = true\n    78\t  try {\n    79\t    const res = await fetch('/api/page', {\n    80\t      method: 'POST', headers: { 'content-type': 'application/json' },\n    81\t      body: JSON.stringify({ action: 'index-add', paths: [path] }),\n    82\t    }).then((r) => r.json()).catch(() => null)\n    83\t    indexed = !!(res && !res.error)\n    84\t  } catch { indexed = false }\n    85\t\n    86\t  return { ok: true, path, sha: written.sha, indexed, url: pageUrlFor(path, origin), bytes: new Blob([markdown]).size }\n    87\t}\n"},{"type":"input_text","text":"===== src/zenraymedia/declensions.js =====\n     1\t// ZenRayMedia — L5/L9 : l'ARBRE DE DÉCLINAISONS.\n     2\t//\n     3\t// C'est la thèse du produit rendue visible : `Livrable = Rendu(Brief × Thème × Format)`.\n     4\t// Jusqu'ici l'application n'affichait qu'UN format à la fois — on devait cliquer une pastille\n     5\t// pour découvrir qu'un texte ne tenait pas en 1:1. L'arbre montre les sorties SIMULTANÉMENT,\n     6\t// avec le verdict du Critique sur chacune, avant d'avoir cliqué quoi que ce soit.\n     7\t//\n     8\t// Inspiré de l'éditeur de référence de Matthieu (`zenraymediav1-editor.html`), qui présente\n     9\t// « YouTube 16:9 · Reel 9:16 · Carrousel 4:5 · Infolettre · Images » comme un arbre sous une\n    10\t// source unique. La différence ici : chaque branche porte son état RÉEL, pas une décoration.\n    11\t\n    12\timport { FORMATS, getFormat, isTemporal, durationOf } from './formats.js'\n    13\timport { visibleBeats, omittedCount, readingTimeOf } from './compile.js'\n    14\timport { inspectStatic, summarize } from './critic.js'\n    15\t\n    16\t/**\n    17\t * Les groupes de déclinaisons proposés par défaut.\n    18\t * Un groupe n'est PAS un format : c'est une intention de diffusion, qui se traduit en un ou\n    19\t * plusieurs formats. « Réseaux » veut dire trois sorties, pas une.\n    20\t */\n    21\texport const DECLENSION_GROUPS = [\n    22\t  { id: 'lecture', label: 'Lecture', formats: ['F-web-article', 'F-print-a4'] },\n    23\t  { id: 'reseaux', label: 'Réseaux', formats: ['F-still-1080-square', 'F-still-1080x1350', 'F-still-1080x1920'] },\n    24\t  { id: 'ecran', label: 'Écran', formats: ['F-video-1920x1080', 'F-overlay-1920x1080'] },\n    25\t]\n    26\t\n    27\t/**\n    28\t * État d'une déclinaison, calculé sans rien rendre : ce que le format montre, ce qu'il laisse\n    29\t * de côté, sa durée s'il est temporel, et le verdict du Critique.\n    30\t */\n    31\texport function declensionState({ brief, cut, theme, format, dark = false }) {\n    32\t  const shown = visibleBeats(cut, format).length\n    33\t  const omitted = omittedCount(cut, format)\n    34\t  const issues = inspectStatic({ brief, cut, theme, format, dark })\n    35\t  const verdict = summarize(issues)\n    36\t  return {\n    37\t    formatId: format.id,\n    38\t    label: format.label,\n    39\t    short: format.short,\n    40\t    kind: format.kind,\n    41\t    canvas: format.canvas,\n    42\t    ratio: format.canvas.h > 0 ? format.canvas.w / format.canvas.h : null,\n    43\t    shown,\n    44\t    omitted,\n    45\t    total: shown + omitted,\n    46\t    duration: isTemporal(format) ? durationOf(cut, format) : 0,\n    47\t    declared: Array.isArray(theme?.formats) ? theme.formats.includes(format.id) : true,\n    48\t    blocking: verdict.blocking.length,\n    49\t    warnings: verdict.warnings.length,\n    50\t    ready: verdict.canPublish,\n    51\t    issues,\n    52\t  }\n    53\t}\n    54\t\n    55\t/** L'arbre complet, groupé par intention de diffusion. */\n    56\texport function declensionTree({ brief, cut, theme, dark = false, groups = DECLENSION_GROUPS }) {\n    57\t  if (!brief || !cut || !theme) return []\n    58\t  return groups.map((group) => {\n    59\t    const branches = group.formats\n    60\t      .map((id) => getFormat(id))\n    61\t      .filter(Boolean)\n    62\t      .map((format) => declensionState({ brief, cut, theme, format, dark }))\n    63\t    return {\n    64\t      ...group,\n    65\t      branches,\n    66\t      ready: branches.filter((b) => b.ready).length,\n    67\t      total: branches.length,\n    68\t      // Un groupe est en défaut dès qu'UNE de ses branches l'est : on ne moyenne pas un blocage.\n    69\t      blocking: branches.reduce((n, b) => n + b.blocking, 0),\n    70\t    }\n    71\t  })\n    72\t}\n    73\t\n    74\t/** Résumé d'une passe complète, pour l'en-tête de l'arbre. */\n    75\texport function declensionSummary(tree) {\n    76\t  const branches = tree.flatMap((g) => g.branches)\n    77\t  return {\n    78\t    total: branches.length,\n    79\t    ready: branches.filter((b) => b.ready).length,\n    80\t    blocking: branches.reduce((n, b) => n + b.blocking, 0),\n    81\t    // Formats que le thème ne déclare pas : ils rendront quand même, mais approximativement.\n    82\t    undeclared: branches.filter((b) => !b.declared).map((b) => b.formatId),\n    83\t  }\n    84\t}\n    85\t\n    86\t/**\n    87\t * Estimation du travail restant, en mots, pour qu'un format cesse de tronquer.\n    88\t * Sert à dire « il te manque de la place », pas seulement « ça déborde ».\n    89\t */\n    90\texport function trimAdvice(cut, format) {\n    91\t  const omitted = omittedCount(cut, format)\n    92\t  if (omitted <= 0) return null\n    93\t  const hidden = (cut?.beats || []).slice(visibleBeats(cut, format).length)\n    94\t  const words = hidden.reduce((n, b) => n + String(b.text || '').trim().split(/\\s+/).filter(Boolean).length, 0)\n    95\t  return { omitted, words, minutes: readingTimeOf({ beats: hidden }).minutes }\n    96\t}\n"},{"type":"input_text","text":"===== src/zenraymedia/forge.js =====\n     1\t// ZenRayMedia — L7 : la Forge.\n     2\t//\n     3\t// DÉCISION ASSUMÉE (01-PLAN §8). Le rendu vidéo ne tourne PAS dans le navigateur ni sur Vercel :\n     4\t//   - les fonctions serverless du projet plafonnent la réponse à ~4,5 Mo (incident 2026-07-21,\n     5\t//     fichiers tronqués à 4,2 Mo) ;\n     6\t//   - une séquence RGBA 4K pèse 33,18 Mo PAR IMAGE, soit ~29,9 Go pour 30 s à 30 i/s.\n     7\t// La Forge est donc un processus LOCAL. C'est ce que veut dire « auto-hébergé ».\n     8\t//\n     9\t// Ce module ne simule rien : il produit le pipeline EXACT, reproductible, à exécuter sur le Mac.\n    10\t// Les réglages viennent du Format, jamais d'une valeur magique.\n    11\t\n    12\timport { durationOf, isTemporal } from './formats.js'\n    13\timport { checksumOf } from './contracts.js'\n    14\t\n    15\tconst shellQuote = (s) => `'${String(s).replace(/'/g, `'\\\\''`)}'`\n    16\t\n    17\t// Commande d'encodage, dérivée de `format.delivery`.\n    18\texport function ffmpegCommand(format, { input = 'frames (flux)', output } = {}) {\n    19\t  const d = format.delivery\n    20\t  const fps = format.time?.fps || 30\n    21\t  const out = output || `zenraymedia.${d.container}`\n    22\t  const common = `-f image2pipe -framerate ${fps} -i -`\n    23\t  if (format.kind === 'overlay') {\n    24\t    // prores_ks + yuva444p10le : couche alpha réelle. VÉRIFIÉ disponible (ffmpeg 8.1.1).\n    25\t    // prores_videotoolbox est volontairement écarté : son support alpha n'est pas mesuré.\n    26\t    return `ffmpeg -y ${common} -c:v prores_ks -profile:v 4444 -pix_fmt yuva444p10le -alpha_bits 16 -vendor apl0 ${shellQuote(out)}`\n    27\t  }\n    28\t  if (format.kind === 'video') {\n    29\t    // `-tag:v hvc1` : règle dure du projet. Sans elle, Apple refuse le fichier (bug payé 2026-07-05).\n    30\t    return `ffmpeg -y ${common} -c:v ${d.codec} -tag:v ${d.tag} -pix_fmt ${d.pixfmt} -b:v 12M -movflags +faststart ${shellQuote(out)}`\n    31\t  }\n    32\t  return `ffmpeg -y -i ${shellQuote(input)} ${shellQuote(out)}`\n    33\t}\n    34\t\n    35\texport function probeCommand(output) {\n    36\t  return `ffprobe -v error -count_frames -select_streams v:0 -show_entries stream=nb_read_frames,codec_name,pix_fmt,width,height -show_entries format=duration ${shellQuote(output)}`\n    37\t}\n    38\t\n    39\t/**\n    40\t * Script de rendu déterministe, prêt à coller dans `Scripts/`.\n    41\t * Le point dur est l'HORLOGE VIRTUELLE : chaque image est posée à `t = n/fps` en déplaçant\n    42\t * `currentTime` de toutes les animations. Aucune capture ne dépend de l'horloge réelle, donc\n    43\t * deux exécutions produisent le même fichier (règle d'or, 01-PLAN §6.1).\n    44\t */\n    45\texport function renderScript({ format, durationSeconds, htmlFileName = 'page.html', output }) {\n    46\t  const fps = format.time?.fps || 30\n    47\t  const frames = Math.round(durationSeconds * fps)\n    48\t  const out = output || `zenraymedia.${format.delivery.container}`\n    49\t  const transparent = format.kind === 'overlay'\n    50\t\n    51\t  return `#!/usr/bin/env node\n    52\t// ZenRayMedia — rendu déterministe. Généré par la Forge, à exécuter localement.\n    53\t//   npm i -D playwright        (chromium déjà présent dans ~/Library/Caches/ms-playwright)\n    54\t//   node zrm-render.mjs\n    55\t//\n    56\t// GARANTIE : même page + même graine => même fichier, octet pour octet.\n    57\t// Vérification obligatoire avant d'aller plus loin (ZM-L6-05) :\n    58\t//   node zrm-render.mjs && shasum -a 256 ${out} && node zrm-render.mjs && shasum -a 256 ${out}\n    59\t//   -> les deux empreintes DOIVENT être identiques.\n    60\t\n    61\timport { chromium } from 'playwright'\n    62\timport { spawn } from 'node:child_process'\n    63\timport { readFileSync } from 'node:fs'\n    64\timport { pathToFileURL } from 'node:url'\n    65\t\n    66\tconst FPS = ${fps}\n    67\tconst FRAMES = ${frames}\n    68\tconst WIDTH = ${format.canvas.w}\n    69\tconst HEIGHT = ${format.canvas.h}\n    70\tconst OUTPUT = ${JSON.stringify(out)}\n    71\t\n    72\tconst ffmpeg = spawn('ffmpeg', ${JSON.stringify(ffmpegCommand(format, { output: out }).split(' ').slice(1).map((a) => a.replace(/^'|'$/g, '')))}, { stdio: ['pipe', 'inherit', 'inherit'] })\n    73\t\n    74\tconst browser = await chromium.launch()\n    75\tconst page = await browser.newPage({ viewport: { width: WIDTH, height: HEIGHT }, deviceScaleFactor: 1 })\n    76\tawait page.setContent(readFileSync(${JSON.stringify(htmlFileName)}, 'utf8'), { waitUntil: 'load' })\n    77\t\n    78\t// Préchauffage (ZM-L6-03) : polices posées ET images décodées avant la première image.\n    79\tawait page.evaluate(async () => { await document.fonts.ready; await Promise.all([...document.images].map((i) => i.decode().catch(() => {}))) })\n    80\t\n    81\t// Horloge virtuelle (ZM-L6-04/06) : on met en pause toutes les animations et on les POSITIONNE.\n    82\tawait page.evaluate(() => { for (const a of document.getAnimations()) { a.pause() } })\n    83\t\n    84\tfor (let n = 0; n < FRAMES; n++) {\n    85\t  const t = (n / FPS) * 1000\n    86\t  await page.evaluate((ms) => { for (const a of document.getAnimations()) { a.currentTime = ms } }, t)\n    87\t  const buffer = await page.screenshot({ type: 'png', omitBackground: ${transparent} })\n    88\t  // Flux DIRECT vers l'encodeur : aucune image n'atteint le disque (ZM-L6-11).\n    89\t  if (!ffmpeg.stdin.write(buffer)) await new Promise((r) => ffmpeg.stdin.once('drain', r))\n    90\t}\n    91\t\n    92\tffmpeg.stdin.end()\n    93\tawait new Promise((resolve, reject) => ffmpeg.on('close', (code) => (code === 0 ? resolve() : reject(new Error('ffmpeg code ' + code)))))\n    94\tawait browser.close()\n    95\tconsole.log('OK', OUTPUT, FRAMES, 'images @', FPS, 'i/s')\n    96\t`\n    97\t}\n    98\t\n    99\t// Plan complet d'un job temporel : ce qu'il faut faire, dans l'ordre, avec les chiffres réels.\n   100\texport function forgePlan({ brief, cut, theme, format, html, seed }) {\n   101\t  const duration = isTemporal(format) ? durationOf(cut, format) : 0\n   102\t  const fps = format.time?.fps || 30\n   103\t  const frames = Math.round(duration * fps)\n   104\t  const bytesPerFrame = format.canvas.w * format.canvas.h * 4\n   105\t  return {\n   106\t    duration,\n   107\t    fps,\n   108\t    frames,\n   109\t    // Ce chiffre est la raison pour laquelle rien n'est écrit sur le disque.\n   110\t    rawBytesIfWrittenToDisk: bytesPerFrame * frames,\n   111\t    bytesPerFrame,\n   112\t    command: ffmpegCommand(format),\n   113\t    probe: probeCommand(`zenraymedia.${format.delivery.container}`),\n   114\t    script: renderScript({ format, durationSeconds: duration }),\n   115\t    htmlChecksum: checksumOf(html || ''),\n   116\t    seed,\n   117\t    steps: [\n   118\t      'Exporter la page compilée (bouton « Page HTML ») à côté du script.',\n   119\t      'Coller le script dans Scripts/zrm-render.mjs.',\n   120\t      'Lancer le rendu, puis la sonde ffprobe.',\n   121\t      `Vérifier que la sonde annonce exactement ${frames} images.`,\n   122\t      'Rejouer le rendu et comparer les empreintes sha256 : elles doivent être identiques.',\n   123\t    ],\n   124\t  }\n   125\t}\n   126\t\n   127\texport function formatBytes(bytes) {\n   128\t  if (!Number.isFinite(bytes) || bytes <= 0) return '0 o'\n   129\t  const units = ['o', 'ko', 'Mo', 'Go', 'To']\n   130\t  const i = Math.min(units.length - 1, Math.floor(Math.log(bytes) / Math.log(1024)))\n   131\t  const value = bytes / Math.pow(1024, i)\n   132\t  return `${value >= 100 ? Math.round(value) : Math.round(value * 10) / 10} ${units[i]}`\n   133\t}\n"},{"type":"input_text","text":"===== src/zenraymedia/exporters.js =====\n     1\t// ZenRayMedia — sorties navigateur (pipelines P1, P2, P3, P7 de 01-PLAN §7).\n     2\t//\n     3\t// Ce que le navigateur SAIT faire de façon fiable : page HTML autonome, image fixe, PDF via\n     4\t// l'impression, texte au presse-papiers. C'est fait ici, réellement.\n     5\t// Ce qu'il ne sait PAS faire de façon fiable : encoder du ProRes 4444 alpha. C'est la Forge\n     6\t// locale (`forge.js`), et le produit le dit au lieu de faire semblant.\n     7\t\n     8\timport { FONTS, essentialFaces } from './fonts.js'\n     9\t\n    10\tconst FONT_FILES = {\n    11\t  AnthropicSerif: '/fonts/AnthropicSerif-Romans.woff2',\n    12\t  AnthropicSans: '/fonts/AnthropicSans-Romans.woff2',\n    13\t  AnthropicMono: '/fonts/AnthropicMono.woff2',\n    14\t}\n    15\t\n    16\t// Les familles Google Fonts installées, indexées par nom -> liste de fichiers WOFF2.\n    17\t// Elles sont sous licence libre (OFL/Apache) : les EMBARQUER dans un fichier livré à un client\n    18\t// est autorisé, ce qui est précisément ce dont une page autonome a besoin.\n    19\tconst THEME_FONT_FILES = Object.fromEntries(FONTS.map((f) => [f.family, f.faces]))\n    20\t\n    21\tconst fontCache = new Map()\n    22\t\n    23\t/** Lit un fichier de police servi par le site et le rend en data URI. Mis en cache. */\n    24\tasync function fileDataUrl(url) {\n    25\t  if (fontCache.has(url)) return fontCache.get(url)\n    26\t  const promise = (async () => {\n    27\t    try {\n    28\t      const res = await fetch(url)\n    29\t      if (!res.ok) return null\n    30\t      const bytes = new Uint8Array(await res.arrayBuffer())\n    31\t      let binary = ''\n    32\t      const CHUNK = 0x8000\n    33\t      for (let i = 0; i < bytes.length; i += CHUNK) binary += String.fromCharCode(...bytes.subarray(i, i + CHUNK))\n    34\t      return `data:font/woff2;base64,${btoa(binary)}`\n    35\t    } catch { return null }\n    36\t  })()\n    37\t  fontCache.set(url, promise)\n    38\t  return promise\n    39\t}\n    40\t\n    41\tasync function fontDataUrl(family) {\n    42\t  if (fontCache.has(family)) return fontCache.get(family)\n    43\t  const url = FONT_FILES[family]\n    44\t  if (!url) return null\n    45\t  const promise = (async () => {\n    46\t    try {\n    47\t      const res = await fetch(url)\n    48\t      if (!res.ok) return null\n    49\t      const buf = await res.arrayBuffer()\n    50\t      let binary = ''\n    51\t      const bytes = new Uint8Array(buf)\n    52\t      const CHUNK = 0x8000\n    53\t      for (let i = 0; i < bytes.length; i += CHUNK) binary += String.fromCharCode(...bytes.subarray(i, i + CHUNK))\n    54\t      return `data:font/woff2;base64,${btoa(binary)}`\n    55\t    } catch { return null }\n    56\t  })()\n    57\t  fontCache.set(family, promise)\n    58\t  return promise\n    59\t}\n    60\t\n    61\t// ZM-L6-02 : polices EN BASE64 dans la page. Une page exportée qui va chercher sa police sur le\n    62\t// réseau n'est pas autonome — ouverte hors ligne ou chez un client, elle change d'apparence.\n    63\texport async function embedFonts(html) {\n    64\t  const faces = []\n    65\t\n    66\t  // 1. Les trois familles Anthropic (chrome et thèmes maison).\n    67\t  for (const family of Object.keys(FONT_FILES).filter((f) => html.includes(f))) {\n    68\t    const data = await fontDataUrl(family)\n    69\t    if (data) faces.push(`@font-face{font-family:'${family}';src:url(${data}) format('woff2');font-weight:100 900;font-style:normal;font-display:block;}`)\n    70\t  }\n    71\t\n    72\t  // 2. Les familles Google Fonts que la page utilise réellement. On embarque CHAQUE coupe\n    73\t  //    (romain, italique, sous-ensembles) avec son unicode-range : sans lui, le navigateur\n    74\t  //    chargerait la première coupe pour tous les alphabets et l'accentuation casserait.\n    75\t  for (const [family, entryFaces] of Object.entries(THEME_FONT_FILES)) {\n    76\t    if (!html.includes(family)) continue\n    77\t    // On n'embarque que les coupes utiles, cf. `essentialFaces` : trente-six fichiers par famille\n    78\t    // dont six servaient, c'est ce qui produisait les 3,8 Mo signalés par le Critique.\n    79\t    for (const face of essentialFaces(family).length ? essentialFaces(family) : entryFaces) {\n    80\t      const data = await fileDataUrl(face.file)\n    81\t      if (!data) continue\n    82\t      faces.push(`@font-face{font-family:'${family}';font-style:${face.style};font-weight:${face.weight};font-display:block;src:url(${data}) format('woff2');${face.unicodeRange ? `unicode-range:${face.unicodeRange};` : ''}}`)\n    83\t    }\n    84\t  }\n    85\t\n    86\t  if (!faces.length) return html\n    87\t  const block = `<style data-zrm-fonts>${faces.join('')}</style>`\n    88\t  return html.includes('</head>') ? html.replace('</head>', `${block}</head>`) : `${block}${html}`\n    89\t}\n    90\t\n    91\texport function downloadBlob(blob, filename) {\n    92\t  const url = URL.createObjectURL(blob)\n    93\t  const a = document.createElement('a')\n    94\t  a.href = url\n    95\t  a.download = filename\n    96\t  document.body.appendChild(a)\n    97\t  a.click()\n    98\t  a.remove()\n    99\t  // Révocation différée : Safari lit l'URL après le clic, une révocation immédiate annule le\n   100\t  // téléchargement sans erreur visible.\n   101\t  setTimeout(() => URL.revokeObjectURL(url), 10_000)\n   102\t}\n   103\t\n   104\texport async function exportHtml(html, filename) {\n   105\t  const withFonts = await embedFonts(html)\n   106\t  downloadBlob(new Blob([withFonts], { type: 'text/html;charset=utf-8' }), filename)\n   107\t  return { bytes: new Blob([withFonts]).size, container: 'html' }\n   108\t}\n   109\t\n   110\t// Image fixe : SVG foreignObject -> canvas -> PNG.\n   111\t// Sérialisation via XMLSerializer sur un DOM parsé : c'est ce qui garantit un XHTML bien formé\n   112\t// (`<br/>`, `<img/>`…). Une concaténation de chaînes casserait au premier élément vide.\n   113\texport async function exportPng(html, format, filename, { scale = 1 } = {}) {\n   114\t  const width = format.canvas.w\n   115\t  const height = format.canvas.h || 1200\n   116\t  const withFonts = await embedFonts(html)\n   117\t\n   118\t  const parsed = new DOMParser().parseFromString(withFonts, 'text/html')\n   119\t  const svgNS = 'http://www.w3.org/2000/svg'\n   120\t  const xhtmlNS = 'http://www.w3.org/1999/xhtml'\n   121\t  const svg = document.createElementNS(svgNS, 'svg')\n   122\t  svg.setAttribute('xmlns', svgNS)\n   123\t  svg.setAttribute('width', String(width))\n   124\t  svg.setAttribute('height', String(height))\n   125\t  svg.setAttribute('viewBox', `0 0 ${width} ${height}`)\n   126\t  const fo = document.createElementNS(svgNS, 'foreignObject')\n   127\t  fo.setAttribute('x', '0'); fo.setAttribute('y', '0')\n   128\t  fo.setAttribute('width', String(width)); fo.setAttribute('height', String(height))\n   129\t  const wrapper = document.createElementNS(xhtmlNS, 'div')\n   130\t  wrapper.setAttribute('style', `width:${width}px;height:${height}px;overflow:hidden;`)\n   131\t  for (const style of parsed.querySelectorAll('style')) wrapper.appendChild(document.importNode(style, true))\n   132\t  for (const child of Array.from(parsed.body.childNodes)) wrapper.appendChild(document.importNode(child, true))\n   133\t  fo.appendChild(wrapper)\n   134\t  svg.appendChild(fo)\n   135\t\n   136\t  const serialized = new XMLSerializer().serializeToString(svg)\n   137\t  const svgUrl = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(serialized)}`\n   138\t\n   139\t  const image = await new Promise((resolve, reject) => {\n   140\t    const img = new Image()\n   141\t    img.onload = () => resolve(img)\n   142\t    img.onerror = () => reject(new Error(\"Image non rendue. Cause la plus fréquente : un média distant dans un emplacement. Utilise un fichier déposé (encodé dans la page) plutôt qu'une adresse externe.\"))\n   143\t    img.src = svgUrl\n   144\t  })\n   145\t\n   146\t  const canvas = document.createElement('canvas')\n   147\t  canvas.width = Math.round(width * scale)\n   148\t  canvas.height = Math.round(height * scale)\n   149\t  const ctx = canvas.getContext('2d')\n   150\t  ctx.fillStyle = '#ffffff'\n   151\t  ctx.fillRect(0, 0, canvas.width, canvas.height)\n   152\t  ctx.drawImage(image, 0, 0, canvas.width, canvas.height)\n   153\t\n   154\t  const blob = await new Promise((resolve, reject) => {\n   155\t    canvas.toBlob((b) => (b ? resolve(b) : reject(new Error('Encodage PNG refusé par le navigateur.'))), 'image/png')\n   156\t  })\n   157\t  downloadBlob(blob, filename)\n   158\t  return { bytes: blob.size, container: 'png', width: canvas.width, height: canvas.height }\n   159\t}\n   160\t\n   161\t// PDF : on passe par l'impression du navigateur, seul chemin qui produit un vrai PDF vectoriel\n   162\t// (texte sélectionnable, 300 dpi réels) sans embarquer de bibliothèque.\n   163\texport async function exportPdf(html) {\n   164\t  const withFonts = await embedFonts(html)\n   165\t  const frame = document.createElement('iframe')\n   166\t  frame.style.cssText = 'position:fixed;right:0;bottom:0;width:0;height:0;border:0;opacity:0;'\n   167\t  document.body.appendChild(frame)\n   168\t  await new Promise((resolve) => {\n   169\t    frame.onload = resolve\n   170\t    frame.srcdoc = withFonts\n   171\t  })\n   172\t  // Laisse au moteur le temps de poser les polices avant d'ouvrir la boîte d'impression.\n   173\t  try { await frame.contentDocument?.fonts?.ready } catch { /* fonts API absente : sans effet */ }\n   174\t  await new Promise((r) => setTimeout(r, 120))\n   175\t  frame.contentWindow?.focus()\n   176\t  frame.contentWindow?.print()\n   177\t  setTimeout(() => frame.remove(), 60_000)\n   178\t  return { container: 'pdf' }\n   179\t}\n   180\t\n   181\texport async function copyText(text) {\n   182\t  try {\n   183\t    await navigator.clipboard.writeText(text)\n   184\t    return true\n   185\t  } catch {\n   186\t    // Repli sans API presse-papiers (contexte non sécurisé, permission refusée).\n   187\t    const ta = document.createElement('textarea')\n   188\t    ta.value = text\n   189\t    ta.style.cssText = 'position:fixed;opacity:0;'\n   190\t    document.body.appendChild(ta)\n   191\t    ta.select()\n   192\t    let ok = false\n   193\t    try { ok = document.execCommand('copy') } catch { ok = false }\n   194\t    ta.remove()\n   195\t    return ok\n   196\t  }\n   197\t}\n   198\t\n   199\texport function safeFileName(text, extension) {\n   200\t  const base = String(text || 'zenraymedia')\n   201\t    .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n   202\t    .replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-+|-+$/g, '').toLowerCase().slice(0, 60) || 'zenraymedia'\n   203\t  return `${base}.${extension}`\n   204\t}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"6b8c71a4-bf2e-4775-bb32-5a852d61030b"}}}
