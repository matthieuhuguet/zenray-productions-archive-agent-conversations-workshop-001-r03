eState({}, '', window.location.pathname) } catch { /* sans effet */ }\n    return () => clearTimeout(timer)\n  }, [])\n  useEffect(() => { // bascule sur Create quand une page est demandée en cours de session\n    const h = () => setView('pages')\n    window.addEventListener('zr:open-page', h); return () => window.removeEventListener('zr:open-page', h)\n  }, [])\n  useEffect(() => { // ZenRayMedia (2026-07-25) : ouvrir un .zmedia.json depuis Create bascule sur la vue\n    // Media. MediaApp écoute le MÊME événement pour charger le document -- un seul signal, deux\n    // auditeurs, aucun couplage direct entre les deux composants (patron de `zr:create-music`).\n    const h = () => setView('media')\n    window.addEventListener('zr:media-open', h); return () => window.removeEventListener('zr:media-open', h)\n  }, [])\n  useEffect(() => { // DEEP LINK Shelf (extension Chrome / bookmarklet) : ?shelfAdd=<imgUrl>&shelfName=&shelfCat=\n    if (typeof window === 'undefined') return // -> bascule sur Shelf et ouvre la modale Ajouter pré-remplie (l'app,\n    const p = new URLSearchParams(window.location.search) //    déjà déverrouillée, fait l'ingestion publique).\n    const img = p.get('shelfAdd')\n    if (!img) return\n    try { localStorage.setItem('zr:shelf:add', JSON.stringify({ image: img, name: p.get('shelfName') || '', cat: p.get('shelfCat') || '' })) } catch {}\n    window.history.replaceState({}, '', '/'); setView('shelf')\n  }, [])\n\n  useEffect(() => { loadState().then(({ state, store }) => { setState({ ...EMPTY, ...state }); setStore(store); setLoaded(true) }) }, [])\n  const pendingStateRef = useRef(state)\n  useEffect(() => { pendingStateRef.current = state }, [state])\n  useEffect(() => {\n    if (!loaded) return undefined\n    const timer = setTimeout(() => saveState(state), 700)\n    return () => clearTimeout(timer)\n  }, [state, loaded])\n      {/* pointerEvents:none : idem tuile \"page\" ci-dessus, évite le scintillement dragover/dragleave au survol\n          des enfants (miniature/badges/label) pendant un drag. L'input de renommage reste interactif (auto). */}\n      <div style={{ pointerEvents: 'none', position: 'relative', width: '100%', height: thumb, display: 'flex', alignItems: 'center', justifyContent: 'center' }}>\n        {(e.hasKids || !e.contentPath) ? <FolderIcon s={Math.round(thumb * 0.9)} empty={isEmpty} /> : isImg ? <ImgNodeThumb path={e.contentPath} thumbUrl={e.thumbUrl || copiedThumb} thumbIv={e.thumbIv} size={thumb} onProvenance={setProv} /> : e.isMedia ? <MediaIcon s={Math.round(thumb * 0.84)} path={e.contentPath} /> : (e.contentPath && e.contentPath.endsWith('.file.json')) ? <FileNodeThumb s={thumb} path={e.contentPath} /> : e.isDb ? <DbIcon s={Math.round(thumb * 0.84)} /> : eagleSrc\n          ? <img src={eagleSrc} alt=\"\" loading=\"lazy\" decoding=\"async\" style={{ width: thumb, height: thumb, objectFit: 'cover', borderRadius: 8, background: 'rgba(128,128,128,0.12)' }} />\n          : <PageThumb path={e.contentPath} size={thumb} fallback={<DocIcon s={Math.round(thumb * 0.84)} />} />}\n        {/* ON NE MARQUE QUE L'EXCEPTION (inversé le 2026-07-31, retour Matthieu « c'est redondant »).\n            Ce badge montrait un globe sur les dossiers PUBLICS. Ce n'était pas un bug : le 2026-07-21,\n            `folderVisibility.js` a basculé le défaut de « privé » à « public », et `pages/.zrvis.json`\n            vaut désormais {vis:'public'}. Comme aucun dossier ne porte de marqueur propre, TOUS\n            héritaient de public et TOUS affichaient le globe. Un signal que portent 100 % des éléments\n            n'est plus un signal, c'est du bruit qui coûte un coup d'œil à chaque tuile.\n            Désormais seul le dossier PRIVÉ est marqué, d'un cadenas : c'est lui qui s'écarte du défaut,\n            et c'est lui dont les médias traverseront la fonction au lieu du CDN. Même orange que la\n            pastille de provenance, qui dit exactement la même chose à l'échelle du fichier. */}\n        {isPrivate && <span title=\"Dossier privé — ses médias passent par la fonction, pas par le CDN\" style={{ position: 'absolute', top: 2, left: 6, display: 'inline-flex', alignItems: 'center', justifyContent: 'center', width: 17, height: 17, borderRadius: 99, background: UI.orange, border: `2px solid ${t.cardBg}` }}><Icon name=\"lock.icloud\" size={11} color=\"#fff\" /></span>}\n      </div>\n      {renamingThis\n        ? <input autoFocus value={renameVal} onFocus={(ev) => ev.target.select()} onMouseDown={(ev) => ev.stopPropagation()} onClick={(ev) => ev.stopPropagation()} onChange={(ev) => h.renameChange(ev.target.value)} onBlur={() => h.renameBlur(e, renameVal)} onKeyDown={(ev) => { if (ev.key === 'Enter') { ev.preventDefault(); ev.currentTarget.blur() } else if (ev.key === 'Escape') { h.renameEsc() } }} style={{ pointerEvents: 'auto', width: Math.min(zoom - 12, 150), textAlign: 'center', fontSize: 12.5, border: `1px solid ${PALETTE.primary}`, borderRadius: 5, padding: '1px 3px', outline: 'none', fontFamily: FONTS.sans }} />\n        : <div title={pgPretty(e.name)} style={{ pointerEvents: 'none', fontFamily: FONTS.sans, fontSize: 12, fontWeight: 400, textAlign: 'center', lineHeight: 1.3, marginTop: 6, maxWidth: zoom - 12, color: t.textPrimary, display: '-webkit-box', WebkitLineClamp: 2, WebkitBoxOrient: 'vertical', overflow: 'hidden', wordBreak: 'break-word', padding: '0 0.3em' }}>{tagKey && <Dot color={tagHex(tagKey)} selected={selOn} title={`Étiquette ${tagKey}`} />}{prov?.known && <Dot color={prov.onCdn ? UI.green : UI.orange} selected={selOn} title={prov.onCdn ? 'jsDelivr, CDN public' : 'Proxy privé, via notre fonction'} />}{e.contentPath && e.contentPath.endsWith('.md') ? <PageLabel path={e.contentPath} name={e.name} /> : pgPretty(e.name)}</div>}\n    </button>\n  )\n}, areEqualTile)\n\n// Carte d'un document ZenRayMedia (.zmedia.json) affichée dans Create.\n// Elle n'édite rien : elle nomme le document et renvoie vers la vue Media, seule propriétaire de\n// l'éditeur. Le renvoi est EXPLICITE (un bouton), jamais automatique : une redirection au montage\n// piégerait la navigation -- revenir en arrière dans Create rebasculerait aussitôt sur Media.\nfunction ZMediaNodeCard({ t, path }) {\n  const name = pgPretty(baseName(path).replace(/\\.zmedia\\.json$/, ''))\n  const open = () => window.dispatchEvent(new CustomEvent('zr:media-open', { detail: { path } }))\n  return (\n    <div style={{ maxWidth: 560, margin: '0 auto', padding: '28px 26px', borderRadius: 18, border: `1px solid ${t.border}`, background: t.cardBg }}>\n      <div style={{ display: 'flex', alignItems: 'center', gap: 12, marginBottom: 10 }}>\n        <Icon name=\"doc.richtext\" size={20} />\n        <div style={{ fontFamily: FONTS.serif, fontSize: 22, fontWeight: 400 }}>{name}</div>\n      </div>\n      <p style={{ color: t.textSecondary, fontSize: 13, lineHeight: 1.5, margin: '0 0 18px' }}>\n        Document ZenRayMedia. Il contient la source (brief, blocs, thème, format), pas le rendu :\n        la page se recompile à l'ouverture.\n      </p>\n      <button onClick={open} style={{ display: 'inline-flex', alignItems: 'center', gap: 7, border: 0, borderRadius: 999, padding: '9px 17px', cursor: 'pointer', background: PALETTE.primary, color: '#fff', fontFamily: FONTS.sans, fontSize: 13, fontWeight: 500 }}>\n        <Icon name=\"arrow.up.right\" size={14} />Ouvrir dans Media\n      </button>\n    </div>\n  )\n}\n\n// Carte \"Skills\" : capsule arrondie liquid glass, icône SF Symbol fixe + titre + description 2 lignes.\n// Frontmatter minimal (description) d'un SKILL.md, lu EN DIRECT depuis Memory (2026-07-16) -- plus de\n// copie intermédiaire ni de script d'ingestion à relancer, la fraîcheur suit celle du repo Memory lui-même.\nfunction parseSkillFrontmatter(text) {\n  const m = /^---\\n([\\s\\S]*?)\\n---/.exec(text || '')\n  if (!m) return null\n  return { description: /^description:\\s*\"?(.*?)\"?\\s*$/m.exec(m[1])?.[1] || '' }\n}\n  const slugify = (s) => s.replace(/[/\\\\]+/g, '-').replace(/[^\\p{L}\\p{N} ._-]+/gu, '').replace(/\\s+/g, ' ').trim().replace(/^[-.\\s]+|[-.\\s]+$/g, '')\n  // newPage / addChild / newDatabase : au lieu du window.prompt moche, on OUVRE le widget NamePrompt (liquid glass).\n  // Sa callback reçoit le titre saisi et exécute la création (logique inchangée).\n  const newPage = () => setNamePrompt({ icon: 'doc.text', label: 'Nouvelle page', placeholder: 'Titre de la page', value: '', cta: 'Créer', onOk: (title) => createPage('pages', title, 'créée ✓') })\n  const addChild = (folderPath) => setNamePrompt({ icon: 'doc.text', label: 'Nouvelle sous-page', placeholder: 'Titre de la sous-page', value: '', cta: 'Créer', onOk: (title) => createPage(folderPath, title, 'sous-page créée ✓') })\n  const newDatabase = (folderPath) => setNamePrompt({ icon: 'tablecells', label: 'Nouvelle table', placeholder: 'Nom de la table', value: '', cta: 'Créer', onOk: (title) => {\n    const slug = slugify(title) || 'base'\n    const path = `${folderPath}/${slug}-${Date.now().toString(36).slice(-4)}.db.json`\n    const seed = { name: title, columns: [{ id: 'c' + Date.now().toString(36), name: 'Nom', type: 'text', w: 220 }], rows: [], views: [] }\n    apiPost('save', { path, markdown: JSON.stringify(seed) })\n      .then((j) => { if (j.ok) { setCur({ path }); setStatus('table créée ✓'); loadTree() } else setStatus('erreur ' + (j.error || '')) })\n  } })\n  // Board ZenRay Ref (2026-07-19) : créé directement dans le dossier courant (pas de sous-arborescence\n  // pages/Ref/<projet>/Boards/ imposée), ouvert aussitôt comme n'importe quel nœud Create (double-clic\n  // futur = même route, typeOfPath('.ref.json') === 'canvas' -> CanvasNodeViewer/RefBoard).\n  const newRefBoard = (folderPath) => setNamePrompt({ icon: 'square.grid.2x2', label: 'Nouveau board Ref', placeholder: 'Nom du board', value: '', cta: 'Créer', onOk: (title) => {\n    const slug = slugify(title) || 'board'\n    const path = `${folderPath}/${slug}-${Date.now().toString(36).slice(-4)}.ref.json`\n    const seed = makeCanvas({ projectPath: path, title })\n    apiPost('save', { path, markdown: JSON.stringify(seed) })\n      .then((j) => { if (j.ok) { setCur({ path }); setStatus('board Ref créé ✓'); loadTree() } else setStatus('erreur ' + (j.error || '')) })\n  } })\n  // Document ZenRayMedia (2026-07-25) : créé dans le dossier courant, comme un board Ref. On écrit\n  // une source MINIMALE valide (aucun rendu stocké : il se recompile) puis on bascule sur la vue\n  // Media, qui devient propriétaire de l'édition.\n  const newMediaDoc = (folderPath) => setNamePrompt({ icon: 'doc.richtext', label: 'Nouveau document Media', placeholder: 'Titre du document', value: '', cta: 'Créer', onOk: (title) => {\n    const slug = slugify(title) || 'media'\n    const path = `${folderPath}/${slug}-${Date.now().toString(36).slice(-4)}.zmedia.json`\n    const seed = {\n      type: 'zenraymedia', v: 1, title: title || 'Nouveau document', path,\n      brief: { id: '', title: title || 'Nouveau document', message: '', audience: '', register: 'créateur', intent: 'informer', evidence: [], constraints: { languages: ['fr'], maxDuration: null, mentions: [] }, sources: [] },\n      notes: '', cut: null, themeId: 'T-01-3-2', formatId: 'F-web-article', seed: 1,\n    }\n    apiPost('save', { path, markdown: JSON.stringify(seed, null, 2) })\n      .then((j) => { if (j.ok) { setStatus('document Media créé ✓'); loadTree(); window.dispatchEvent(new CustomEvent('zr:media-open', { detail: { path } })) } else setStatus('erreur ' + (j.error || '')) })\n  } })\n  // Nouvelle playlist ZenRay VIDE (2026-07-19, feature miniplayer) : demande explicite de Matthieu (\"aucun\n  // moyen de créer une playlist depuis Create\") -- même manifeste que celui écrit par appendTracksToPlaylist\n  // (type:'playlist'), juste avec `items` vide au départ. Ouvre immédiatement le nœud créé, comme newRefBoard.\n  const newPlaylist = (folderPath) => setNamePrompt({ icon: 'music.note.list', label: 'Nouvelle playlist', placeholder: 'Nom de la playlist', value: '', cta: 'Créer', onOk: (title) => {\n    const slug = slugify(title) || 'playlist'\n    const path = `${folderPath}/${slug}-${Date.now().toString(36).slice(-4)}.media.json`\n    const seed = { type: 'playlist', v: 1, mime: 'audio/x-zenray-playlist', name: title, cover: '', items: [], createdAt: new Date().toISOString() }\n    apiPost('save', { path, markdown: JSON.stringify(seed) })\n      .then((j) => { if (j.ok) { setCur({ path }); setStatus('playlist créée ✓'); loadTree() } else setStatus('erreur ' + (j.error || '')) })\n  } })\n  // Nouveau plan ZenRay Plan (2026-07-20) : un calendrier complet vide (titre + tasks:[]), même patron\n  // que newPlaylist/newRefBoard. 3 points d'entrée : menu \"New\" du haut, clic droit espace vide (mêmes 2\n  // que Playlist), et le bouton \"+\" de la vue Plan de la sidebar (folderPath fixé à Create/Calendar là).\n  const newPlanBoard = (folderPath) => setNamePrompt({ icon: 'calendar', label: 'Nouveau plan', placeholder: 'Nom du plan', value: '', cta: 'Créer', onOk: (title) => {\n    const slug = slugify(title) || 'plan'\n// C210a — Modèle de nœud unifié (Phase 1 OS). Le TYPE est DÉRIVÉ du chemin : jamais stocké en double,\n// donc jamais de désynchronisation. L'identité d'un nœud = son chemin de base (id === dir), comme dans un Finder.\n// Suffixes du plus spécifique au moins spécifique.\nconst LEAF_EXT_RE = /\\.(db|media|img|canvas|ref|embed|file|plan|zmedia)\\.json$/\n\nexport function typeOfPath(path) {\n  if (typeof path !== 'string') return 'folder'\n  if (path.endsWith('.db.json')) return 'db'\n  if (path.endsWith('.media.json')) return 'media'\n  if (path.endsWith('.img.json')) return 'image'\n  if (path.endsWith('.canvas.json')) return 'canvas'\n  // .ref.json (ZenRay Ref, 2026-07-19) : ALIAS du type 'canvas' — même schéma de board, même viewer\n  // (CanvasNodeViewer/RefBoard). Les nouveaux boards se créent en .ref.json ; les .canvas.json restent lus.\n  if (path.endsWith('.ref.json')) return 'canvas'\n  if (path.endsWith('.embed.json')) return 'embed'\n  if (path.endsWith('.file.json')) return 'file' // archive universelle (zenray-productions-archive) : fichier brut/chunké\n  // .plan.json (ZenRay Plan, 2026-07-20) : un calendrier complet (titre + liste de tâches), au même\n  // niveau qu'un board Ref ou une table -- son propre type, son propre viewer (PlanBoard.jsx).\n  if (path.endsWith('.plan.json')) return 'plan'\n  // .zmedia.json (ZenRayMedia, 2026-07-25) : un document de studio média (brief + article + thème\n  // + format). Son propre type et sa propre vue -- exactement comme .ref.json a la sienne. Le\n  // nom n'est PAS `.media.json` : cette extension est déjà prise par les manifestes vidéo/audio,\n  // et deux schémas différents derrière une même extension est la garantie d'un bug plus tard.\n  if (path.endsWith('.zmedia.json')) return 'zmedia'\n  if (path.endsWith('.md')) return 'page'\n  return 'folder'\n}\n\n// Retire l'extension feuille pour obtenir l'identité du nœud (le \"dir\"). pages/x.db.json -> pages/x ; pages/x.md -> pages/x\nexport function stripLeafExt(path) {\n  return path.replace(LEAF_EXT_RE, '').replace(/\\.md$/, '')\n}\n\n// Extension canonique d'une feuille, dérivée de la même table que typeOfPath/stripLeafExt.\n// Aucun appelant ne doit recopier sa propre regex : c'est ainsi que .file.json avait été oublié.\nexport function leafExtension(path) {\n  if (typeof path !== 'string') return ''\n  const base = stripLeafExt(path)\n  return base === path ? '' : path.slice(base.length)\n}\n\n// Drapeaux legacy dérivés du type (sur-ensemble : le code existant qui lit isDb/isMedia continue de marcher).\n// Ajout Ref : isCanvas/isEmbed permettent au routeur d'ouverture (lot B) d'aiguiller un .canvas.json vers\n// CanvasNodeViewer et un .embed.json vers EmbedNodeViewer, JAMAIS vers l'éditeur Markdown (plan §13 P0).\nexport function legacyFlags(type) {\n  return { isDb: type === 'db', isMedia: type === 'media', isImage: type === 'image', isCanvas: type === 'canvas', isEmbed: type === 'embed' }\n}\n\n// Une entrée Finder typée à partir d'un chemin feuille + son dossier parent.\nexport function nodeOf(prefix, seg, contentPath) {\n  const type = contentPath ? typeOfPath(contentPath) : 'folder'\n  return { name: seg, contentPath: contentPath || null, hasKids: false, dir: prefix + seg, type, ...legacyFlags(type) }\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"255bb7e6-b68d-4c5c-b91b-c6a1965e3c1d"}}}
