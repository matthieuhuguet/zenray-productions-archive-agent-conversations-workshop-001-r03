{"timestamp":"2026-08-05T19:23:25.163Z","ordinal":3880,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd361-6c6b-73b2-bf36-e7a1f2fa9f57","call_id":"call_GqyhEBtJBcMMBaI3dVTAH55d","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"// ZenRayMedia — persistance et journal.\n//\n// Choix assumé pour la V0 : localStorage. Zéro appel réseau, zéro quota GitHub, zéro dépendance\n// serveur -> zéro classe de bug entière. La publication vers Create reste une action EXPLICITE\n// (bouton), pas un enregistrement implicite : un brouillon raté n'a rien à faire dans le drive.\n\nimport { emptyBrief, makeId } from './contracts.js'\n\nconst KEY_PROJECTS = 'zrm:projects:v1'\nconst KEY_CURRENT = 'zrm:current:v1'\nconst KEY_LOG = 'zrm:log:v1'\nconst LOG_MAX = 60\n\nfunction read(key, fallback) {\n  try {\n    const raw = localStorage.getItem(key)\n    if (!raw) return fallback\n    const parsed = JSON.parse(raw)\n    return parsed ?? fallback\n  } catch { return fallback }\n}\n\nfunction write(key, value) {\n  try { localStorage.setItem(key, JSON.stringify(value)); return true } catch { return false }\n}\n\n// --- Projet de démonstration ---------------------------------------------------------------\n// Présent au premier lancement pour que l'application ne s'ouvre JAMAIS sur un écran vide :\n// une démonstration client commence par quelque chose à regarder, pas par un formulaire.\nexport const SEED_NOTES = `On croit que le goulot d'étranglement de la création, c'est l'idée. C'est faux : une idée s'écrit en dix minutes.\n\nCe qui prend des jours, c'est le trajet entre la note et l'objet publiable. Habillage, rythme, typographie, format, export. Ce trajet-là n'est presque jamais fait, et c'est précisément celui qu'une machine sait faire.\n\nUne identité visuelle n'est pas un mystère : c'est un ensemble fini de décisions. Palette, échelle typographique, grille, courbes, texture, rythme de coupe. Un ensemble fini de décisions, c'est un fichier de données.\n\nDonc on ne construit pas un éditeur de plus. On construit une machine à appliquer des directions artistiques à du contenu, et on la nourrit d'un catalogue.\n\nLe résultat tient en une ligne : un brief, mille formes. Change le thème, l'article devient une double page de magazine. Change le format, il devient un vertical de trente secondes.`\n\nexport function seedProject() {\n  const brief = {\n    ...emptyBrief(),\n    id: makeId('brief', 'seed-zenraymedia', 0),\n    title: 'Un brief, mille formes',\n    message: \"Le goulot d'étranglement de la création n'est pas l'idée, c'est la mise en forme.\",\n    audience: 'Créateurs et studios qui publient trop peu par rapport à ce qu’ils produisent',\n    register: 'créateur',\n    intent: 'convaincre',\n    constraints: { languages: ['fr'], maxDuration: null, mentions: [] },\n    evidence: [],\n    sources: [],\n  }\n  return { id: makeId('project', 'seed-zenraymedia', 0), brief, notes: SEED_NOTES, cut: null, themeId: null, formatId: null, seed: 1 }\n}\n\nexport function loadProjects() {\n  const list = read(KEY_PROJECTS, null)\n  if (Array.isArray(list) && list.length) return list\n  const seeded = [seedProject()]\n  write(KEY_PROJECTS, seeded)\n  return seeded\n}\n\nexport function saveProjects(projects) { return write(KEY_PROJECTS, projects) }\n\nexport function loadCurrentId() { return read(KEY_CURRENT, null) }\nexport function saveCurrentId(id) { return write(KEY_CURRENT, id) }\n\n// --- Journal de fabrication (ZM-L0-11 / ZM-L12-04) --------------------------------------------\n// Une ligne par action réelle. Sert la preuve : « ce livrable a été produit, avec ce thème, ce\n// format, cette graine ». Le `at` est fourni par l'appelant : ce module ne lit jamais l'horloge\n// lui-même, pour rester testable.\nexport function appendLog(entry) {\n  const log = read(KEY_LOG, [])\n  const next = [{ ...entry }, ...log].slice(0, LOG_MAX)\n  write(KEY_LOG, next)\n  return next\n}\n\nexport function loadLog() { return read(KEY_LOG, []) }\nexport function clearLog() { write(KEY_LOG, []); return [] }\n// ZenRayMedia — modèle de composition Lego.\n// Une ligne empile verticalement ; ses éléments partagent l'espace horizontal et se replient\n// automatiquement au rendu. Le modèle ne dépend ni du DOM ni de l'horloge : il reste testable,\n// sérialisable dans .zmedia.json et strictement reproductible.\n\nimport { makeId } from './contracts.js'\n\nexport const COMPOSITION_VERSION = 1\nexport const PLACEMENTS = ['above', 'below', 'left', 'right']\n\nexport function emptyComposition(themeId) {\n  return { v: COMPOSITION_VERSION, themeId, serial: 0, rows: [] }\n}\n\nexport function normalizeComposition(value, themeId) {\n  if (!value || value.themeId !== themeId || !Array.isArray(value.rows)) return emptyComposition(themeId)\n  // ON CONSERVE L'INCONNU AU LIEU DE LE RECONSTRUIRE (inversion de doctrine, 2026-08-01, carte C1).\n  //\n  // Cette fonction rendait un littéral à quatre clefs, et elle est appelée en tête de `insertItem`,\n  // `addComponent`, `addImage`, `removeItem`, `moveItem`, `patchItem`, `duplicateItem`, plus deux\n  // fois dans `MediaApp.jsx`. Toute clef qu'elle ne connaissait pas mourait donc au premier GESTE,\n  // en mémoire, sans qu'aucun rechargement soit en cause : un champ `timeline` ou une propriété de\n  // disposition posée sur une ligne ne survivait pas à un simple déplacement d'élément.\n  //\n  // Le contrat s'ouvre ICI, UNE seule fois, et plus jamais en V1. L'ouvrir une seconde fois pour\n  // une carte ultérieure serait un coût inutile et un second risque de régression sur des documents\n  // déjà enregistrés.\n  //\n  // La permissivité a son revers, et il est gardé par des tests dans les DEUX sens : ce qui est\n  // légitime survit, et une composition dont le thème ou les rangées sont invalides repart vide.\n  return {\n    ...value,\n    v: COMPOSITION_VERSION,\n    themeId,\n    serial: Number.isFinite(value.serial) ? value.serial : 0,\n    rows: value.rows\n      .filter((row) => row && Array.isArray(row.items))\n      .map((row, ri) => ({\n        ...row,\n        id: row.id || makeId('row', themeId, ri),\n        items: row.items.filter(Boolean).map((item) => ({\n          hidden: false,\n          locked: false,\n          props: {},\n          ...item,\n        })),\n      }))\n      .filter((row) => row.items.length),\n  }\n}\n\nfunction allocate(composition, prefix, salt) {\n  const serial = composition.serial + 1\n  return { id: makeId(prefix, `${composition.themeId}:${salt}`, serial), serial }\n}\n\nexport function componentInstance(composition, component) {\n  const next = allocate(composition, 'cmp', component.id)\n  return {\n    serial: next.serial,\n    item: {\n      id: next.id,\n      kind: 'component',\n      themeId: composition.themeId,\n      componentId: component.id,\n      name: component.name,\n      group: component.group,\n      hidden: false,\n      locked: false,\n      props: {},\n    },\n  }\n}\n\nexport function imageInstance(composition, image) {\n  const next = allocate(composition, 'img', image.path || image.name)\n  return {\n    serial: next.serial,\n    item: {\n      id: next.id,\n      kind: 'image',\n      name: image.name || 'Image',\n      refPath: image.path || null,\n      url: image.url || '',\n      hidden: false,\n      locked: false,\n      props: { fit: 'cover', radius: 18, ratio: '16 / 9' },\n    },\n  }\n}\n\nfunction locate(rows, itemId) {\n  for (let rowIndex = 0; rowIndex < rows.length; rowIndex += 1) {\n    const itemIndex = rows[rowIndex].items.findIndex((item) => item.id === itemId)\n    if (itemIndex >= 0) return { rowIndex, itemIndex }\n  }\n  return null\n}\n\nfunction newRow(composition, item, serial) {\n  return { id: makeId('row', `${composition.themeId}:${item.id}`, serial), items: [item] }\n}\n\nexport function insertItem(value, item, targetId = null, placement = 'below', serial = value.serial) {\n  const composition = normalizeComposition(value, value.themeId)\n  const rows = composition.rows.map((row) => ({ ...row, items: [...row.items] }))\n  const target = targetId ? locate(rows, targetId) : null\n\n  if (!target) {\n    rows.push(newRow(composition, item, serial))\n  } else if (placement === 'left' || placement === 'right') {\n    rows[target.rowIndex].items.splice(target.itemIndex + (placement === 'right' ? 1 : 0), 0, item)\n  } else {\n    rows.splice(target.rowIndex + (placement === 'below' ? 1 : 0), 0, newRow(composition, item, serial))\n  }\n  return { ...composition, serial: Math.max(composition.serial, serial), rows }\n}\n\nexport function addComponent(value, component, targetId = null, placement = 'below') {\n  const composition = normalizeComposition(value, value.themeId)\n  const created = componentInstance(composition, component)\n  return insertItem(composition, created.item, targetId, placement, created.serial)\n}\n\nexport function addImage(value, image, targetId = null, placement = 'below') {\n  const composition = normalizeComposition(value, value.themeId)\n  const created = imageInstance(composition, image)\n  return insertItem(composition, created.item, targetId, placement, created.serial)\n}\n\nexport function removeItem(value, itemId) {\n  const composition = normalizeComposition(value, value.themeId)\n  return {\n    ...composition,\n    rows: composition.rows\n      .map((row) => ({ ...row, items: row.items.filter((item) => item.id !== itemId) }))\n      .filter((row) => row.items.length),\n  }\n}\n\nexport function moveItem(value, itemId, targetId, placement) {\n  if (!PLACEMENTS.includes(placement) || itemId === targetId) return value\n  const composition = normalizeComposition(value, value.themeId)\n  const source = locate(composition.rows, itemId)\n  if (!source) return composition\n  const item = composition.rows[source.rowIndex].items[source.itemIndex]\n  return insertItem(removeItem(composition, itemId), item, targetId, placement, composition.serial)\n}\n\nexport function patchItem(value, itemId, patch) {\n  const composition = normalizeComposition(value, value.themeId)\n  return {\n    ...composition,\n    rows: composition.rows.map((row) => ({\n      ...row,\n      items: row.items.map((item) => (item.id === itemId ? { ...item, ...patch } : item)),\n    })),\n  }\n}\n\nexport function duplicateItem(value, itemId) {\n  const composition = normalizeComposition(value, value.themeId)\n  const source = locate(composition.rows, itemId)\n  if (!source) return composition\n  const original = composition.rows[source.rowIndex].items[source.itemIndex]\n  const next = allocate(composition, original.kind === 'image' ? 'img' : 'cmp', original.id)\n  return insertItem(composition, { ...original, id: next.id }, itemId, 'below', next.serial)\n}\n\nexport function countItems(value) {\n  return (value?.rows || []).reduce((sum, row) => sum + (row.items?.length || 0), 0)\n}\n// ZenRayMedia — L3 : le Cut (la partition).\n//\n// Le poste « Le Monteur » de 01-PLAN §9 tourne ICI, en local et sans appel réseau : il découpe\n// une note en beats et leur attribue un rôle. C'est déterministe, gratuit, instantané, et chaque\n// beat reste éditable à la main — un modèle distant pourra le remplacer plus tard sans rien\n// changer au contrat (entrée : Brief + notes ; sortie : Cut valide).\n//\n// Le nombre de beats est imposé par le THÈME (`theme.beatCount`), pas par l'humeur du texte :\n// c'est la règle ZM-L3-03. Changer de thème change le découpage, jamais le contenu.\n\nimport { BEAT_ROLES, makeId, ROLE_LABELS } from './contracts.js'\n\n// Ordre de dévoilement d'un récit court. Les rôles centraux se répètent quand il y a plus de\n// blocs que de rôles : c'est la structure « accroche · développement · chute · appel ».\nconst OPENING = ['hook', 'context']\nconst MIDDLE = ['proof', 'demo', 'turn']\nconst CLOSING = ['payoff', 'cta']\n\nexport function splitIntoBlocks(text) {\n  return String(text || '')\n    .replace(/\\r\\n?/g, '\\n')\n    .split(/\\n{2,}/)\n    .map((b) => b.trim())\n    .filter(Boolean)\n}\n\n// Regroupe ou éclate les blocs pour atteindre exactement `target` beats, sans jamais perdre un\n// mot : on fusionne les plus courts, on scinde les plus longs sur une frontière de phrase.\nfunction fitBlocks(blocks, target) {\n  let out = blocks.slice()\n  if (out.length === 0) return []\n\n  while (out.length > target) {\n    let shortest = 0\n    for (let i = 1; i < out.length; i++) if (out[i].length < out[shortest].length) shortest = i\n    const neighbour = shortest === out.length - 1 ? shortest - 1 : shortest + 1\n    const [a, b] = shortest < neighbour ? [shortest, neighbour] : [neighbour, shortest]\n    out.splice(a, 2, `${out[a]}\\n\\n${out[b]}`)\n  }\n\n  while (out.length < target) {\n    let longest = 0\n    for (let i = 1; i < out.length; i++) if (out[i].length > out[longest].length) longest = i\n    const piece = out[longest]\n    const sentences = piece.split(/(?<=[.!?…])\\s+/).filter(Boolean)\n    if (sentences.length < 2) break // insécable : on s'arrête plutôt que de couper un mot\n    const half = Math.ceil(sentences.length / 2)\n    out.splice(longest, 1, sentences.slice(0, half).join(' '), sentences.slice(half).join(' '))\n  }\n  return out\n}\n\nexport function roleForPosition(index, total) {\n  if (total <= 1) return 'hook'\n  if (index === 0) return 'hook'\n  if (index === total - 1) return total >= 4 ? 'cta' : 'payoff'\n  if (index === total - 2 && total >= 4) return 'payoff'\n  if (index === 1 && total >= 4) return 'context'\n  const middleIndex = index - (total >= 4 ? 2 : 1)\n  return MIDDLE[middleIndex % MIDDLE.length]\n}\n\n// Poids d'accent : l'ouverture et la chute portent, le corps soutient. Modulé par la longueur\n// relative du bloc — un bloc deux fois plus long pèse plus lourd, sans jamais sortir de [0,1].\nfunction weightFor(role, length, maxLength) {\n  const base = { hook: 0.9, context: 0.45, proof: 0.55, demo: 0.6, turn: 0.7, payoff: 0.85, cta: 0.8 }[role] ?? 0.5\n  const ratio = maxLength > 0 ? length / maxLength : 0.5\n  return Math.round(Math.min(1, Math.max(0.1, base * 0.75 + ratio * 0.25)) * 100) / 100\n}\n\nconst TEMPO_FOR_ROLE = { hook: 'snap', context: 'calm', proof: 'calm', demo: 'drive', turn: 'drive', payoff: 'still', cta: 'snap' }\n\n/**\n * Construit un Cut à partir d'un Brief et de ses notes.\n * @param {object} brief\n * @param {string} notes  texte brut (les blocs séparés par une ligne vide deviennent des beats)\n * @param {object} theme  fournit beatCount ; facultatif\n */\nexport function buildCut(brief, notes, theme) {\n  const blocks = splitIntoBlocks(notes)\n  const min = theme?.beatCount?.min ?? 3\n  const max = theme?.beatCount?.max ?? 7\n  const target = Math.min(max, Math.max(min, blocks.length || min))\n  const fitted = fitBlocks(blocks.length ? blocks : [brief?.message || ''], target)\n  const maxLength = fitted.reduce((m, b) => Math.max(m, b.length), 0)\n\n  const beats = fitted.map((text, i) => {\n    const role = roleForPosition(i, fitted.length)\n    return {\n      id: makeId('beat', text, i),\n      role,\n      text,\n      slots: [],\n      weight: weightFor(role, text.length, maxLength),\n      tempo: TEMPO_FOR_ROLE[role] || 'calm',\n    }\n  })\n\n  return {\n    id: makeId('cut', `${brief?.id || ''}${notes || ''}`, beats.length),\n    briefId: brief?.id || '',\n    beats,\n    audio: { bed: null, cues: [] },\n    locked: false,\n  }\n}\n\n// Ré-applique le nombre de beats imposé par un NOUVEAU thème, sans perdre les textes édités\n// à la main (ZM-L3-03 + ZM-L3-13 : un cut verrouillé ne bouge plus).\nexport function refitCut(cut, theme) {\n  if (!cut || cut.locked) return cut\n  const min = theme?.beatCount?.min ?? 3\n  const max = theme?.beatCount?.max ?? 7\n  const count = cut.beats.length\n  if (count >= min && count <= max) return cut\n  const texts = fitBlocks(cut.beats.map((b) => b.text), Math.min(max, Math.max(min, count)))\n  const maxLength = texts.reduce((m, b) => Math.max(m, b.length), 0)\n  return {\n    ...cut,\n    beats: texts.map((text, i) => {\n      const previous = cut.beats[i]\n      const role = roleForPosition(i, texts.length)\n      return {\n        id: previous?.id || makeId('beat', text, i),\n        role, text,\n        slots: previous?.slots || [],\n        weight: weightFor(role, text.length, maxLength),\n        tempo: TEMPO_FOR_ROLE[role] || 'calm',\n      }\n    }),\n  }\n}\n\nexport function moveBeat(cut, from, to) {\n  if (!cut || from === to) return cut\n  const beats = cut.beats.slice()\n  if (from < 0 || from >= beats.length || to < 0 || to >= beats.length) return cut\n  const [moved] = beats.splice(from, 1)\n  beats.splice(to, 0, moved)\n  return { ...cut, beats }\n}\n\nexport function mergeBeats(cut, index) {\n  if (!cut || index < 0 || index >= cut.beats.length - 1) return cut\n  const beats = cut.beats.slice()\n  const a = beats[index]\n  const b = beats[index + 1]\n  beats.splice(index, 2, { ...a, text: `${a.text}\\n\\n${b.text}`, slots: [...(a.slots || []), ...(b.slots || [])].slice(0, 4) })\n  return { ...cut, beats }\n}\n\nexport function splitBeat(cut, index) {\n  if (!cut || index < 0 || index >= cut.beats.length) return cut\n  const beat = cut.beats[index]\n  const sentences = String(beat.text).split(/(?<=[.!?…])\\s+/).filter(Boolean)\n  if (sentences.length < 2) return cut\n  const half = Math.ceil(sentences.length / 2)\n  const beats = cut.beats.slice()\n  beats.splice(index, 1,\n    { ...beat, id: makeId('beat', beat.text, index), text: sentences.slice(0, half).join(' ') },\n    { ...beat, id: makeId('beat', beat.text, index + 1000), text: sentences.slice(half).join(' '), slots: [] })\n  return { ...cut, beats }\n}\n\nexport function updateBeat(cut, index, patch) {\n  if (!cut || index < 0 || index >= cut.beats.length) return cut\n  const beats = cut.beats.slice()\n  beats[index] = { ...beats[index], ...patch }\n  return { ...cut, beats }\n}\n\nexport function removeBeat(cut, index) {\n  if (!cut || cut.beats.length <= 1) return cut\n  return { ...cut, beats: cut.beats.filter((_, i) => i !== index) }\n}\n\nexport function addBeat(cut, afterIndex) {\n  if (!cut) return cut\n  const beats = cut.beats.slice()\n  const at = Math.min(beats.length, Math.max(0, afterIndex + 1))\n  beats.splice(at, 0, { id: makeId('beat', 'nouveau', at + beats.length), role: 'proof', text: 'Nouveau bloc.', slots: [], weight: 0.5, tempo: 'calm' })\n  return { ...cut, beats }\n}\n\n// --- Emplacements média (ZM-L3-06) ------------------------------------------------------------\n// Un bloc porte au plus 4 emplacements (contrat L0). Les images sont stockées en `dataUrl` :\n// la page compilée reste AUTONOME, l'export PNG ne se heurte à aucune image distante (qui\n// souillerait le canevas et ferait échouer l'encodage), et le document se rouvre hors ligne.\n// Contrepartie assumée : le document grossit. Le Critique le surveille (`doc.heavy`).\nexport const MAX_SLOTS = 4\n\nexport function addSlot(cut, index, slot) {\n  if (!cut || index < 0 || index >= cut.beats.length || !slot) return cut\n  const beat = cut.beats[index]\n  const slots = [...(beat.slots || [])]\n  if (slots.length >= MAX_SLOTS) return cut\n  slots.push({ kind: slot.kind || 'image', ...slot })\n  return updateBeat(cut, index, { slots })\n}\n\nexport function removeSlot(cut, index, slotIndex) {\n  if (!cut || index < 0 || index >= cut.beats.length) return cut\n  const slots = (cut.beats[index].slots || []).filter((_, i) => i !== slotIndex)\n  return updateBeat(cut, index, { slots })\n}\n\nexport function moveSlot(cut, index, from, to) {\n  if (!cut || index < 0 || index >= cut.beats.length) return cut\n  const slots = [...(cut.beats[index].slots || [])]\n  if (from < 0 || from >= slots.length || to < 0 || to >= slots.length) return cut\n  const [moved] = slots.splice(from, 1)\n  slots.splice(to, 0, moved)\n  return updateBeat(cut, index, { slots })\n}\n\n/** Poids total des médias encodés dans le cut, en octets approximatifs. */\nexport function slotsWeight(cut) {\n  return (cut?.beats || []).reduce((total, beat) => total + (beat.slots || []).reduce((n, slot) => {\n    const data = slot.dataUrl || ''\n    // base64 : 4 caractères pour 3 octets.\n    return n + Math.round((data.length - (data.indexOf(',') + 1)) * 0.75)\n  }, 0), 0)\n}\n\nexport function countSlots(cut) {\n  return (cut?.beats || []).reduce((n, beat) => n + (beat.slots || []).length, 0)\n}\n\nexport const ROLE_OPTIONS = BEAT_ROLES.map((r) => ({ value: r, label: ROLE_LABELS[r] }))\nexport { OPENING, MIDDLE, CLOSING }\n// ZenRayMedia — L5 : les contrats de sortie.\n// Doc : 01-PLAN.md §5.4 + §7. Un format ne décrit JAMAIS un style : uniquement la boîte\n// (dimensions, densité, durée, zones de sécurité, spécification de livraison).\n\n// `fit` : ce qu'un format AFFICHE du cut.\n//   mode 'full'   -> titre + message + TOUS les blocs. Pour ce qui se lit (article, A4).\n//   mode 'poster' -> titre + message + `maxBeats` blocs au maximum. Pour ce qui se REGARDE.\n// Raison (bug signalé par Matthieu le 2026-07-25, « énormément de bugs sur tous les formats ») :\n// un article de 5 blocs ne rentre PAS sur un carré 1080 à taille lisible, et aucun réglage ne\n// l'y fera rentrer. Ce n'était pas un défaut de rendu, c'était un défaut de doctrine : personne\n// ne met 900 mots sur une image sociale. Le format décide de ce qu'il montre ; le Critique\n// signale ce qui a été laissé de côté, pour que rien ne disparaisse en silence.\n//\n// `density` : multiplicateur appliqué à TOUTE valeur typographique et d'espacement du thème.\n// Sans lui, un corps de 19 px posé sur un canevas A4 de 2480 px de large donnait un texte\n// illisible (bug réel signalé par Matthieu le 2026-07-25) : le compilateur ignorait le `dpi`.\n// Un thème décrit des proportions ; c'est le FORMAT qui décide de l'échelle physique.\nexport const FORMATS = [\n  {\n    id: 'F-web-article', fit: { mode: 'full', maxBeats: Infinity }, density: 1 /* l'écran est la référence : 1 px CSS = 1 px */, kind: 'web', label: 'libre · 820', short: '820',\n    canvas: { w: 820, h: 0, dpi: 72 }, // h:0 = hauteur libre (le contenu décide)\n    color: 'sRGB', measure: 68,\n    delivery: { container: 'html', maxBytes: 2_000_000 },\n    overflow: 'flow', // le texte coule, il ne peut pas déborder\n  },\n  {\n    id: 'F-still-1080-square', fit: { mode: 'poster', maxBeats: 1 }, density: 1.7 /* lisible en vignette de fil social */, kind: 'still', label: '1:1 · 1080', short: '1:1',\n    canvas: { w: 1080, h: 1080, dpi: 72 }, color: 'sRGB', measure: 34,\n    safe: { top: 48, bottom: 48, sides: 48 },\n    delivery: { container: 'png', maxBytes: 8_000_000 },\n    overflow: 'shrink',\n  },\n  {\n    id: 'F-still-1080x1350', fit: { mode: 'poster', maxBeats: 2 }, density: 1.7 /* lisible en vignette de fil social */, kind: 'still', label: '4:5 · 1080×1350', short: '4:5',\n    canvas: { w: 1080, h: 1350, dpi: 72 }, color: 'sRGB', measure: 34,\n    safe: { top: 60, bottom: 60, sides: 54 },\n    delivery: { container: 'png', maxBytes: 8_000_000 },\n    overflow: 'shrink',\n  },\n  {\n    id: 'F-still-1080x1920', fit: { mode: 'poster', maxBeats: 2 }, density: 1.7 /* lisible sur un écran de téléphone tenu à bout de bras */, kind: 'still', label: '9:16 · 1080×1920', short: '9:16',\n    canvas: { w: 1080, h: 1920, dpi: 72 }, color: 'sRGB', measure: 30,\n    // Zones d'interface réelles des plateformes verticales : haut (profil/son),\n    // bas (légende, boutons). Le Critique refuse tout texte qui entre dedans.\n    safe: { top: 220, bottom: 320, sides: 64 },\n    delivery: { container: 'png', maxBytes: 8_000_000 },\n    overflow: 'shrink',\n  },\n  {\n    id: 'F-print-a4', fit: { mode: 'full', maxBeats: Infinity }, density: 3.125 /* 300 dpi / 96 dpi de référence CSS -> corps ~14 pt réels */, kind: 'print', label: 'A4 · 2480×3508', short: 'A4',\n    canvas: { w: 2480, h: 3508, dpi: 300 }, color: 'sRGB', measure: 66,\n    blee