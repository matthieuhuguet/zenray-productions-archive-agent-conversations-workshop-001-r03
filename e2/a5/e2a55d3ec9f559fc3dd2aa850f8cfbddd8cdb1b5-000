{"timestamp":"2026-08-05T17:27:18.046Z","ordinal":1471,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd2f7-1d1e-7832-b15f-129d4862b53f","call_id":"call_hzrRc0IBxVQYXamip77m5TI7","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"// ZenRayMedia — L4 : le registre de thèmes.\n//\n// C'EST LA PIÈCE D'EXTENSIBILITÉ. Elle répond à la contrainte : « je vais t'ajouter des thèmes\n// au compte-goutte, à terme au moins 1024 HTML interchangeables ».\n//\n// Deux formes de thème, découvertes AUTOMATIQUEMENT par Vite, sans jamais toucher au code :\n//\n//   1. `T-FF-S-V.theme.js`            -> thème à tokens (les 7 groupes de 01-PLAN §10.2).\n//   2. `T-FF-S-V--mon-slug.html`      -> gabarit HTML brut (celui que tu produis à la main).\n//\n// Déposer un fichier dans ce dossier SUFFIT : il apparaît dans le Deck au prochain build.\n//\n// COÛT À L'ÉCHELLE (décision d'architecture, pas une optimisation) : les métadonnées d'un\n// thème HTML sont dérivées de son NOM DE FICHIER, jamais de son contenu. Lire 1024 fichiers\n// HTML pour construire la liste ferait entrer des mégaoctets dans le bundle. Ici, lister\n// 1024 thèmes coûte 1024 chaînes de caractères ; seul le thème RÉELLEMENT choisi est chargé.\n\nimport { parseThemeFileName, parseThemeId, FAMILIES } from '../taxonomy.js'\nimport { validate } from '../contracts.js'\nimport { defaultFontFor } from '../themeFonts.js'\n\n// Thèmes à tokens : peu nombreux, curatés, chargés d'emblée (quelques kilo-octets).\nconst JS_THEMES = import.meta.glob('./*.theme.js', { eager: true })\n// Gabarits HTML : potentiellement des centaines. Chargement PARESSEUX, un par un.\nconst HTML_THEMES = import.meta.glob('./*.html', { query: '?raw', import: 'default' })\n\nfunction entriesFromJs() {\n  const out = []\n  for (const [path, mod] of Object.entries(JS_THEMES)) {\n    const theme = mod?.default\n    if (!theme?.id) continue\n    const parsed = parseThemeId(theme.id)\n    if (!parsed) continue\n    out.push({\n      id: theme.id,\n      name: theme.name || parsed.id,\n      description: theme.description || '',\n      family: parsed.family,\n      familyLabel: parsed.familyLabel,\n      sub: parsed.sub,\n      variant: parsed.variant,\n      formats: Array.isArray(theme.formats) ? theme.formats : ['F-web-article'],\n      source: 'js',\n      path,\n    })\n  }\n  return out\n}\n\nfunction entriesFromHtml() {\n  const out = []\n  for (const path of Object.keys(HTML_THEMES)) {\n    const parsed = parseThemeFileName(path)\n    if (!parsed) {\n      // Nom de fichier hors contrat : on l'ignore SILENCIEUSEMENT côté produit, mais on le\n      // signale en console pour que l'auteur du gabarit comprenne pourquoi il n'apparaît pas.\n      if (typeof console !== 'undefined') console.warn(`[zenraymedia] gabarit ignoré (nom attendu : T-FF-S-V--slug.html) : ${path}`)\n      continue\n    }\n    out.push({\n      id: parsed.id,\n      name: parsed.name,\n      description: `Gabarit HTML — ${parsed.familyLabel}.`,\n      family: parsed.family,\n      familyLabel: parsed.familyLabel,\n      sub: parsed.sub,\n      variant: parsed.variant,\n      formats: ['F-web-article'],\n      source: 'html',\n      path,\n    })\n  }\n  return out\n}\n\n// Liste complète, triée par identifiant. Les thèmes à tokens gagnent en cas de doublon d'id :\n// un gabarit HTML ne doit pas pouvoir masquer un thème curaté.\nexport function listThemes() {\n  const js = entriesFromJs()\n  const taken = new Set(js.map((e) => e.id))\n  const html = entriesFromHtml().filter((e) => !taken.has(e.id))\n  return [...js, ...html].sort((a, b) => a.id.localeCompare(b.id))\n}\n\nexport function listFamilies() {\n  const present = new Set(listThemes().map((e) => e.family))\n  return Object.entries(FAMILIES)\n    .filter(([code]) => present.has(code))\n    .map(([code, label]) => ({ code, label, count: listThemes().filter((e) => e.family === code).length }))\n}\n\nexport function findEntry(id) { return listThemes().find((e) => e.id === id) || null }\n\n// En-tête déclaratif OPTIONNEL d'un gabarit HTML, en tête de fichier :\n//\n//   <!--zr-theme { \"description\": \"...\", \"formats\": [\"F-web-article\",\"F-print-a4\"],\n//                  \"beatCount\": { \"min\": 3, \"max\": 12 }, \"measure\": 64 } -->\n//\n// Sans lui, le gabarit reste parfaitement valide et prend les valeurs neutres ci-dessous :\n// c'est le chemin le plus court pour déposer un fichier. Avec lui, un gabarit reconstruit à\n// partir de captures d'écran déclare les formats qu'il sait VRAIMENT servir au lieu d'être\n// cantonné au web. L'en-tête est lu APRÈS chargement du fichier : il ne coûte donc rien au\n// listing du catalogue, qui ne lit que les noms de fichiers -- c'est ce qui tient à 1024.\nexport function readThemeHeader(html) {\n  const match = /<!--\\s*zr-theme\\s*([\\s\\S]*?)-->/i.exec(String(html || ''))\n  if (!match) return {}\n  try {\n    const parsed = JSON.parse(match[1].trim())\n    return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {}\n  } catch {\n    // Un en-tête malformé ne doit JAMAIS empêcher le gabarit de fonctionner : on le signale\n    // à l'auteur et on repart des valeurs neutres.\n    if (typeof console !== 'undefined') console.warn('[zenraymedia] en-tête <!--zr-theme …--> illisible (JSON invalide) : valeurs par défaut appliquées.')\n    return {}\n  }\n}\n\n// Groupes par défaut d'un gabarit HTML : il apporte sa mise en page, pas ses tokens.\n// Ces valeurs neutres existent pour que `validateTheme` passe et que le Critique ait des\n// seuils à vérifier, jamais pour imposer un style au gabarit.\nfunction htmlThemeShell(entry, html) {\n  return {\n    id: entry.id,\n    name: entry.name,\n    description: entry.description,\n    calibration: { ref: '', notes: '' },\n    formats: entry.formats,\n    beatCount: { min: 1, max: 24 },\n    surface: { background: '#ffffff', backgroundDark: '#0f1012', grain: 0, vignette: 0, texture: 'none', shadow: 'none' },\n    palette: { ink: 'rgba(20,22,26,.92)', inkDark: 'rgba(244,245,247,.92)', muted: 'rgba(20,22,26,.60)', mutedDark: 'rgba(244,245,247,.54)', rule: 'rgba(20,22,26,.12)', ruleDark: 'rgba(244,245,247,.14)', accent: '#1a1a1a', accentDark: '#f4f5f7', minContrast: 4.5 },\n    typography: { body: \"'AnthropicSans', system-ui, sans-serif\", display: \"'AnthropicSans', system-ui, sans-serif\", mono: \"'AnthropicMono', ui-monospace, monospace\", scale: { base: 17, ratio: 1.25, steps: { h1: 3, h2: 2, h3: 1, body: 0, small: -1 } }, lineHeight: { body: 1.55, display: 1.15 }, tracking: { display: '-0.02em', body: '0em', mono: '0.06em' }, measure: 66, weights: { body: 400, display: 500, emphasis: 500 }, case: { display: 'none', label: 'none' } },\n    grid: { columns: 1, gutter: 0, margin: { top: 72, bottom: 96, sides: 24 }, rhythm: 8, align: 'left', maxWidth: 760 },\n    motion: { enabled: false, ease: 'cubic-bezier(.16,1,.3,1)', enter: 0, stagger: 0, cut: 'none' },\n    chrome: { kicker: true, byline: true, readingTime: true, rules: false, dropCap: false, footer: true, numbering: false },\n    sound: { bed: null, bedLufs: null, cues: [], allowed: [] },\n    html,\n  }\n}\n\nconst cache = new Map()\n\n// Charge un thème et le VALIDE avant de le rendre. Un thème invalide ne doit jamais atteindre\n// le compilateur : il produirait une page cassée sans dire pourquoi.\nexport async function loadTheme(id) {\n  if (cache.has(id)) return cache.get(id)\n  const entry = findEntry(id)\n  if (!entry) throw new Error(`Thème introuvable : ${id}`)\n\n  let theme\n  if (entry.source === 'js') {\n    theme = JS_THEMES[entry.path]?.default\n  } else {\n    const loader = HTML_THEMES[entry.path]\n    if (!loader) throw new Error(`Gabarit introuvable : ${entry.path}`)\n    const raw = await loader()\n    const html = String(raw || '')\n    theme = htmlThemeShell(entry, html)\n    // L'en-tête n'a AUCUN droit sur l'identité : ni sur l'id (il vient du nom de fichier, seule\n    // source de vérité du catalogue), ni sur le nom public (règle anti-marque, 02-RISQUES R5).\n    // Il n'enrichit que ce que le gabarit sait de lui-même.\n    const header = readThemeHeader(html)\n    if (typeof header.description === 'string') theme.description = header.description\n    if (Array.isArray(header.formats) && header.formats.length) theme.formats = header.formats\n    if (header.beatCount && Number.isFinite(header.beatCount.min) && Number.isFinite(header.beatCount.max)) {\n      theme.beatCount = { min: header.beatCount.min, max: header.beatCount.max }\n    }\n    if (Number.isFinite(header.measure)) theme.typography = { ...theme.typography, measure: header.measure }\n    if (header.calibration && typeof header.calibration === 'object') theme.calibration = header.calibration\n    // Polices déclarées par le gabarit. Elles sont servies pour l'aperçu et embarquées à l'export ;\n    // celles qui ne sont pas installées retombent proprement sur leur pile système (fonts.js).\n    if (Array.isArray(header.fonts) && header.fonts.length) theme.fonts = header.fonts\n    // Sans déclaration, le gabarit hérite de la police de SA SOUS-FAMILLE (themeFonts.js).\n    // Un thème de presse quotidienne reçoit ainsi un serif de labeur et un thème de chaîne\n    // d'info un condensé, sans que l'auteur ait à y penser — et il garde le droit de choisir.\n    else { const fallback = defaultFontFor(entry.id); if (fallback) theme.fonts = [fallback] }\n    if (header.typography && typeof header.typography === 'object') theme.typography = { ...theme.typography, ...header.typography }\n  }\n\n  const errors = validate('theme', theme)\n  if (errors.length) throw new Error(`Thème ${id} invalide : ${errors.map((e) => e.message).join(' · ')}`)\n  cache.set(id, theme)\n  return theme\n}\n\n// Le quotidien de référence est le premier thème doté du contrat complet\n// thème → groupes → composants : l'atelier Lego ne doit jamais s'ouvrir vide.\nexport const DEFAULT_THEME_ID = 'T-01-1-3'\n// ZenRayMedia — catalogue de composants construit depuis les registres déjà présents.\n// Vite produit un chunk par registre/partie : ouvrir Media ne télécharge que le thème actif,\n// jamais les 162 composants d'un coup.\n\nimport tokens0111 from './themes/T-01-1-1--une-nationale-du-matin/tokens.css?raw'\nimport tokens0112 from './themes/T-01-1-2--une-de-rupture/tokens.css?raw'\nimport tokens0113 from './themes/T-01-1-3--quotidien-de-reference-sobre/tokens.css?raw'\nimport tokens0114 from './themes/T-01-1-4--quotidien-economique-saumon/tokens.css?raw'\nimport tokens0115 from './themes/T-01-1-5--tabloid-daccroche/tokens.css?raw'\nimport tokens0411 from './themes/T-04-1-1--revelation-cinematique/tokens.css?raw'\n\nconst registries = import.meta.glob('./themes/*/component-registry.json', { import: 'default' })\nconst parts = import.meta.glob('./themes/*/parts/*.html', { query: '?raw', import: 'default' })\nconst tokenSheets = {\n  'T-01-1-1': tokens0111,\n  'T-01-1-2': tokens0112,\n  'T-01-1-3': tokens0113,\n  'T-01-1-4': tokens0114,\n  'T-01-1-5': tokens0115,\n  'T-04-1-1': tokens0411,\n}\n\nfunction themeDirectory(themeId) {\n  const prefix = `./themes/${themeId}--`\n  const key = Object.keys(registries).find((path) => path.startsWith(prefix))\n  return key ? key.slice('./themes/'.length, key.indexOf('/component-registry.json')) : null\n}\n\nexport async function loadThemeComponents(themeId) {\n  const directory = themeDirectory(themeId)\n  if (!directory) return { themeId, directory: null, components: [], tokensCss: '', definitionsHtml: '' }\n\n  const registryKey = `./themes/${directory}/component-registry.json`\n  const registry = await registries[registryKey]()\n  const tokensCss = tokenSheets[themeId] || ''\n\n  const entries = Array.isArray(registry) ? registry : (registry.components || [])\n  const components = await Promise.all(entries.map(async (entry) => {\n    // Le registre pointe vers les pages de documentation autonomes `components/`. L'éditeur\n    // charge leurs homologues légers `parts/`, faits pour être assemblés dans une même page.\n    const key = `./themes/${directory}/parts/${String(entry.file).split('/').pop()}`\n    const html = parts[key] ? await parts[key]() : ''\n    return { ...entry, html }\n  }))\n  const definitionsHtml = components.find((entry) => entry.id === '00-icons')?.html || ''\n  return { themeId, directory, components, tokensCss, definitionsHtml }\n}\n\nexport function groupComponents(components) {\n  return (components || []).reduce((groups, component) => {\n    const key = component.group || 'Autres'\n    ;(groups[key] = groups[key] || []).push(component)\n    return groups\n  }, {})\n}\n// ZenRayMedia — police par défaut de chacune des 128 sous-familles. GÉNÉRÉ, ne pas éditer.\n// Regénérer : node scripts/zrm-map-fonts.mjs\n//\n// 16 familles x 8 sous-familles = 128 sous-familles. Les huit variantes d'une sous-famille\n// partagent leur police : elles se distinguent par la graisse, l'échelle, la casse et\n// l'interlettrage, jamais par la famille typographique. 128 polices = une par sous-famille.\n//\n// L'affectation suit l'affinité d'archétype (presse -> labeur, télévision -> condensé,\n// luxe -> didone, jeu video -> technique), pas le goût. Un gabarit reste libre de déclarer une\n// autre police dans son en-tête zr-theme : cette table est un point de départ, pas une prison.\n\nexport const SUBFAMILY_FONTS = {\n  \"01-1\": { font: \"Source Serif 4\", label: \"Quotidien national\", family: \"Presse & éditorial\" },\n  \"01-2\": { font: \"Spectral\", label: \"Magazine d'actualité hebdomadaire\", family: \"Presse & éditorial\" },\n  \"01-3\": { font: \"Lora\", label: \"Longform web & récit\", family: \"Presse & éditorial\" },\n  \"01-4\": { font: \"Merriweather\", label: \"Newsletter & infolettre\", family: \"Presse & éditorial\" },\n  \"01-5\": { font: \"PT Serif\", label: \"Presse spécialisée & technique\", family: \"Presse & éditorial\"