{"timestamp":"2026-08-05T19:22:36.495Z","ordinal":3850,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd360-ae4f-7933-b0ba-9f0eb5e72cdc","call_id":"call_Ls3bRlH3Nbdza7G8WczqLLMa","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 11093)\nTotal output lines: 217\n\n// Carte Illustrator I7 — images incorporées à l'export, le pendant de `embedFonts` pour les\n// polices. `embedImages` ne touche à rien d'autre : l'aperçu et l'édition gardent la voie LIÉE\n// (une simple adresse), seule la sortie fichier devient autonome.\n\nimport { describe, it, expect, afterEach, vi } from 'vitest'\nimport { embedImages } from './exporters.js'\n\nafterEach(() => vi.unstubAllGlobals())\n\nfunction reponseImage(mime, octets) {\n  return {\n    ok: true,\n    headers: { get: (nom) => (nom === 'content-type' ? mime : null) },\n    arrayBuffer: async () => new Uint8Array(octets).buffer,\n  }\n}\n\ndescribe('Illustrator I7 — embedImages', () => {\n  it('une adresse distante devient réellement une data URI, avec le type MIME de la vraie réponse', async () => {\n    const fetchSimule = vi.fn(async () => reponseImage('image/webp', [1, 2, 3]))\n    vi.stubGlobal('fetch', fetchSimule)\n    const html = '<img src=\"https://exemple.test/photo.jpg\" alt=\"\">'\n    const suivant = await embedImages(html)\n    expect(fetchSimule).toHaveBeenCalledWith('https://exemple.test/photo.jpg')\n    expect(suivant).toContain('src=\"data:image/webp;base64,')\n    expect(suivant).not.toContain('https://exemple.test/photo.jpg')\n  })\n\n  it('une image DÉJÀ en data URI n’est jamais re-fetchée', async () => {\n    const fetchSimule = vi.fn()\n    vi.stubGlobal('fetch', fetchSimule)\n    const html = '<img src=\"data:image/png;base64,AAAA\" alt=\"\">'\n    const suivant = await embedImages(html)\n    expect(suivant).toBe(html)\n    expect(fetchSimule).not.toHaveBeenCalled()\n  })\n\n  it('sans aucune image, la page revient inchangée (même référence, aucun appel réseau)', async () => {\n    const fetchSimule = vi.fn()\n    vi.stubGlobal('fetch', fetchSimule)\n    const html = '<p>Aucune image ici.</p>'\n    const suivant = await embedImages(html)\n    expect(suivant).toBe(html)\n    expect(fetchSimule).not.toHaveBeenCalled()\n  })\n\n  it('une image qui échoue au réseau reste une adresse ordinaire, jamais une page cassée', async () => {\n    const fetchSimule = vi.fn(async () => { throw new Error('réseau coupé') })\n    vi.stubGlobal('fetch', fetchSimule)\n    const html = '<img src=\"https://exemple.test/absente.png\" alt=\"\">'\n    const suivant = await embedImages(html)\n    expect(suivant).toBe(html)\n  })\n\n  it('deux calques qui partagent la MÊME image ne la fetchent qu’UNE seule fois', async () => {\n    const fetchSimule = vi.fn(async () => reponseImage('image/png', [9]))\n    vi.stubGlobal('fetch', fetchSimule)\n    const html = '<img src=\"https://exemple.test/logo.png\"><img src=\"https://exemple.test/logo.png\">'\n    const suivant = await embedImages(html)\n    expect(fetchSimule).toHaveBeenCalledTimes(1)\n    expect((suivant.match(/data:image\\/png;base64,/g) || [])).toHaveLength(2)\n  })\n})\n| M7 | Structuration : ordre, groupes, alignement, frames, verrous | déjà couvert | Ordre (`reorderLayer` + `bringToFront`/`sendToBack`, carte P2 PowerPoint), groupement (P5 Photoshop), alignement mutuel ET sur canevas (P2 Photoshop/PowerPoint), verrouillage (`layer.locked`, P5) couvrent tout le noyau. FRAMES écartées et écrites : un frame Miro est un groupe qui possède en plus sa PROPRE géométrie visible (bordure, titre, fond) — donner une géométrie aux groupes rouvrirait un modèle volontairement laissé sans géométrie propre depuis la carte P5, et re-refusé à la carte F4 (Auto Layout) pour la même raison. La différence groupe/frame reste purement visuelle, non retenue pour ce seul gain. |\n| M8 | Collaboration, présence,