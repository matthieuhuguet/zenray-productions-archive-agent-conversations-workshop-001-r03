           <button title={groupe?.locked ? 'Déverrouiller le groupe' : 'Verrouiller le groupe'}\n                                onClick={(e) => { e.stopPropagation(); patchComposition((c) => patchGroup(c, layer.groupId, { locked: !groupe?.locked })) }}><Icon name=\"lock\" size={10} /></button>\n                              {/* FAMILLE FIGMA 4 · le parent réagit désormais tout seul au contenu : ranger les\n                                  membres en ligne ou en colonne au lieu de les déplacer un par un à la main. */}\n                              <button title={groupe?.autoLayout ? 'Désactiver Auto Layout' : 'Activer Auto Layout (colonne)'}\n                                data-on={!!groupe?.autoLayout || undefined}\n                                onClick={(e) => { e.stopPropagation(); patchComposition((c) => toggleAutoLayout(c, layer.groupId)) }}><Icon name=\"rectangle.grid.1x2\" size={10} /></button>\n                              {groupe?.autoLayout && (\n                                <button title={groupe.autoLayout.direction === 'row' ? 'Passer en colonne' : 'Passer en ligne'}\n                                  onClick={(e) => { e.stopPropagation(); patchComposition((c) => setAutoLayoutProp(c, layer.groupId, { direction: groupe.autoLayout.direction === 'row' ? 'column' : 'row' })) }}>\n                                  <Icon name=\"arrow.up.arrow.down\" size={10} /></button>\n                              )}\n                              <button title=\"Dissoudre le groupe\" onClick={(e) => { e.stopPropagation(); patchComposition((c) => ungroupLayers(c, layer.groupId)) }}><Icon name=\"doc.text\" size={10} /></button>\n                              <button title=\"Retirer le groupe et son contenu\" onClick={(e) => { e.stopPropagation(); patchComposition((c) => removeGroup(c, layer.groupId)); setSelection([]); setSelectedComponent(null) }}><Icon name=\"trash\" size={10} /></button>\n                            </span>\n                          </div>\n                          {!groupesReplies[clefRepli] && membres.map((m) => (\n                            <div key={m.id} className=\"zrm-tree-row\" style={{ '--zrm-indent': '42px' }}\n                              data-on={selection.includes(m.id) || selectedComponent === m.id} data-hidden={m.hidden}\n                              onClick={(e) => choisir(m.id, e)}\n                              onContextMenu={(e) => ouvrirMenuContextuel(e, m.id, true)}>\n                              <span className=\"zrm-tree-glyph\">{{ text: 'T', image: '▣', shape: '◼', component: '◈', table: '▦' }[m.kind]}</span>\n                              <span className=\"zrm-tree-name\">{m.name}</span>\n                              <span className=\"zrm-tree-acts\">\n                                <button title={m.hidden ? 'Afficher' : 'Masquer'} onClick={(e) => { e.stopPropagation(); const v = !m.hidden; surLaSelection((c, id) => patchLayer(c, id, { hidden: v }), m.id) }}><Icon name=\"eye\" size={10} /></button>\n                                <button title=\"Retirer\" onClick={(e) => { e.stopPropagation(); surLaSelection((c, id) => removeLayer(c, id), m.id); setSelection([]); setSelectedComponent(null) }}><Icon name=\"trash\" size={10} /></button>\n                              </span>\n                            </div>\n                          ))}\n                        </React.Fragment>\n                      )\n                    }\n                    if (!correspond(layer.name)) return null\n                    return (\n                      <React.Fragment key={layer.id}>\n                      <div className=\"zrm-tree-row\" style={{ '--zrm-indent': '28px' }}\n                        data-on={selection.includes(layer.id) || selectedComponent === layer.id} data-hidden={layer.hidden}\n                        onClick={(e) => choisir(layer.id, e)}\n                        onContextMenu={(e) => ouvrirMenuContextuel(e, layer.id, true)}>\n                        <span className=\"zrm-tree-glyph\">{{ text: 'T', image: '▣', shape: '◼', component: '◈', table: '▦' }[layer.kind]}</span>\n                        <span className=\"zrm-tree-name\">{layer.name}</span>\n                        <span className=\"zrm-tree-acts\">\n                          {/* FAMILLE FIGMA 8 · un calque composant est une INSTANCE : elle s'ouvre sur\n                              les pièces HTML qui la composent, chacune modifiable, comme le fait déjà\n                              une pièce Lego classique. Seul le composant a une vraie sous-arborescence\n                              à déplier ; texte/image/forme sont des primitives déjà réglables telles quelles. */}\n                          {layer.kind === 'component' && (\n                            <button title=\"Déplier les sous-composants\" onClick={(e) => { e.stopPropagation(); setOpenNodes((o) => ({ ...o, [layer.id]: !o[layer.id] })) }}><Icon name=\"chevron.right\" size={10} /></button>\n                          )}\n                          <button title=\"Monter d’un rang\" onClick={(e) => { e.stopPropagation(); patchComposition((c) => reorderLayer(c, layer.id, 'up')) }}>↑</button>\n                          <button title=\"Descendre d’un rang\" onClick={(e) => { e.stopPropagation(); patchComposition((c) => reorderLayer(c, layer.id, 'down')) }}>↓</button>\n                          <button title={layer.hidden ? 'Afficher' : 'Masquer'} onClick={(e) => { e.stopPropagation(); const v = !layer.hidden; surLaSelection((c, id) => patchLayer(c, id, { hidden: v }), layer.id) }}><Icon name=\"eye\" size={10} /></button>\n                          <button title=\"Dupliquer\" onClick={(e) => { e.stopPropagation(); patchComposition((c) => duplicateLayer(c, layer.id)) }}><Icon name=\"doc.text\" size={10} /></button>\n                          <button title=\"Retirer\" onClick={(e) => { e.stopPropagation(); surLaSelection((c, id) => removeLayer(c, id), layer.id); setSelection([]); setSelectedComponent(null) }}><Icon name=\"trash\" size={10} /></button>\n                        </span>\n                      </div>\n                      {layer.kind === 'component' && openNodes[layer.id] && (arbreNoeuds[layer.id] || []).map((noeud) => (\n                        <RangeeNoeud key={noeud.path} noeud={noeud} niveau={0} instanceId={layer.id}\n                          selectedComponent={selectedComponent} selectedNode={selectedNode}\n                          ouverts={ouverts} onToggle={(chemin, avec) => basculerNoeud(layer.id, chemin, avec)}\n                          onSelect={(chemin) => { setSelectedComponent(layer.id); setSelectedNode(chemin); setDeckTab('details') }} />\n                      ))}\n                      </React.Fragment>\n                    )\n                  })\n                })()}\n              </>\n            )}\n            {composition.rows.length === 0 && countLayers(composition) === 0 && (\n              <div className=\"zrm-det-empty\">Aucune pièce posée. Fais glisser un composant de la Palette, ou clique-le.</div>\n            )}\n            {!groupesReplies.racine && composition.rows.map((row, ri) => (\n              <React.Fragment key={row.id}>\n                <button className=\"zrm-tree-cat\" style={{ paddingLeft: 16 }} onClick={() => replier(`row:${row.id}`)}>\n                  <span className=\"zrm-twist\" data-open={!groupesReplies[`row:${row.id}`]}><Icon name=\"chevron.right\" size={9} /></span>\n                  <span>Rangée {ri + 1}</span><span>{row.items.length}</span>\n                </button>\n                {!groupesReplies[`row:${row.id}`] && row.items\n                  .filter((item) => !hierQuery || item.name.toLowerCase().includes(hierQuery.toLowerCase()))\n                  .map((item) => (\n                  <React.Fragment key={item.id}>\n                  <div className=\"zrm-tree-row zrm-structure-item\" style={{ '--zrm-indent': '28px' }}\n                    draggable={!item.locked}\n                    data-on={selection.includes(item.id) || selectedComponent === item.id}\n                    data-hidden={item.hidden}\n                    data-drop={dropTarget?.id === item.id ? dropTarget.placement : undefined}\n                    onClick={(e) => choisir(item.id, e)}\n                    onContextMenu={(e) => ouvrirMenuContextuel(e, item.id, false)}\n                    onDragStart={(e) => { e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData('application/x-zenray-instance', item.id) }}\n                    onDragOver={(e) => onStructureDragOver(e, item.id)}\n                    onDrop={(e) => onStructureDrop(e, item.id)}>\n                    <span className=\"zrm-tree-glyph\">{item.kind === 'image' ? '▣' : 'T'}</span>\n                    <span className=\"zrm-tree-name\">{item.name}</span>\n                    <span className=\"zrm-tree-acts\">\n                      <button title=\"Déplier les sous-composants\" onClick={(e) => { e.stopPropagation(); setOpenNodes((o) => ({ ...o, [item.id]: !o[item.id] })) }}><Icon name=\"chevron.right\" size={10} /></button>\n                      <button title={item.hidden ? 'Afficher' : 'Masquer'} onClick={(e) => { e.stopPropagation(); const v = !item.hidden; surLaSelection((c, id) => patchItem(c, id, { hidden: v }), item.id) }}><Icon name=\"eye\" size={10} /></button>\n                      <button title={item.locked ? 'Déverrouiller' : 'Verrouiller'} onClick={(e) => { e.stopPropagation(); patchComposition((current) => patchItem(current, item.id, { locked: !item.locked })) }}><Icon name=\"lock\" size={10} /></button>\n                      <button title=\"Dupliquer\" onClick={(e) => { e.stopPropagation(); patchComposition((current) => duplicateItem(current, item.id)) }}><Icon name=\"doc.text\" size={10} /></button>\n                      <button title=\"Retirer\" onClick={(e) => { e.stopPropagation(); surLaSelection((c, id) => removeItem(c, id), item.id); setSelection([]); setSelectedComponent(null) }}><Icon name=\"trash\" size={10} /></button>\n                    </span>\n                  </div>\n                  {openNodes[item.id] && (arbreNoeuds[item.id] || []).map((noeud) => (\n                    <RangeeNoeud key={noeud.path} noeud={noeud} niveau={0} instanceId={item.id}\n                      selectedComponent={selectedComponent} selectedNode={selectedNode}\n                      ouverts={ouverts} onToggle={(chemin, avec) => basculerNoeud(item.id, chemin, avec)}\n                      onSelect={(chemin) => { setSelectedComponent(item.id); setSelectedNode(chemin); setDeckTab('details') }} />\n                  ))}\n                  </React.Fragment>\n                ))}\n              </React.Fragment>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* ---- STAGE ---- */}\n      {/* ═══ ZONE 4 · APERÇU ══════════════════════════════════════════════════════════════════════\n          Le mobilier qui manquait : règles graduées sur les deux axes, barre flottante au-dessus\n          du canevas, et les trois mentions de coin qui, chez Unreal, disent l'échelle, la\n          définition et la sélection. Ce sont elles qui font qu'un aperçu se lit comme un plan de\n          travail mesuré plutôt que comme une image posée au centre d'un cadre. Elles ne coûtent\n          rien : les graduations sont un dégradé répété, donc zéro nœud dans l'arbre. */}\n      <section className=\"zrm-panel zrm-zone-viewport\">\n        <header className=\"zrm-head\">\n          <Icon name=\"square.on.circle\" size={11} />\n          <span className=\"zrm-head-title\">Aperçu</span>\n          <span className=\"zrm-head-spacer\" />\n          <span className=\"zrm-mono\" style={{ fontSize: 10, opacity: .6 }}>\n            {compiled?.meta?.omitted > 0 ? `${compiled.meta.shown}/${compiled.meta.shown + compiled.meta.omitted} blocs` : ''}\n            {isTemporal(format) && cut ? ` · ${durationOf(cut, format)}s` : ''}\n          </span>\n        </header>\n\n        <div className=\"zrm-stage-body zrm-vp\" ref={stageRef} onWheel={onStageWheel}\n          onPointerDown={onStageDown} onPointerMove={onStagePan} onPointerUp={onStageUp} onPointerLeave={onStageUp}\n          onDoubleClick={(e) => { if (e.target === e.currentTarget) replacerLaVue() }}>\n          <div className=\"zrm-ruler\" data-axis=\"x\" />\n          <div className=\"zrm-ruler\" data-axis=\"y\" />\n          <div className=\"zrm-vp-bar\">\n            <button className=\"zrm-tool\" style={{ height: 20 }} data-on={showSafe} disabled={!format.safe}\n              title=\"Zones de sécurité\" onClick={() => setShowSafe((v) => !v)}><Icon name=\"rectangle.dashed\" size={11} /></button>\n            <button className=\"zrm-tool\" style={{ height: 20 }} data-on={renderDark}\n              title={renderDark ? 'Rendu en clair' : 'Rendu en sombre'} onClick={() => setRenderDark((v) => !v)}>\n              <Icon name={renderDark ? 'sun.max' : 'moon'} size={11} /></button>\n            <span className=\"zrm-tool-sep\" />\n            <button className=\"zrm-tool\" style={{ height: 20 }} data-on={!!selectedComponent}\n              title=\"Désélectionner\" onClick={() => { setSelectedComponent(null); setSelectedNode(null) }}><Icon name=\"cursorarrow\" size={11} /></button>\n            <span className=\"zrm-tool-sep\" />\n            <button className=\"zrm-tool\" style={{ height: 20 }} title=\"Réduire\" onClick={() => setZoom((z) => Math.max(0.1, z / 1.25))}><Icon name=\"minus\" size={11} /></button>\n            <button className=\"zrm-tool\" style={{ height: 20 }} title=\"Replacer la vue (double-clic sur le fond)\" onClick={replacerLaVue}>{Math.round(zoom * 100)} %</button>\n            <button className=\"zrm-tool\" style={{ height: 20 }} title=\"Agrandir\" onClick={() => setZoom((z) => Math.min(8, z * 1.25))}><Icon name=\"plus\" size={11} /></button>\n            {calqueSelectionne && (\n              <button className=\"zrm-tool\" style={{ height: 20 }} title=\"Cadrer la sélection (Maj+F)\" onClick={cadrerLaSelection}>\n                <Icon name=\"rectangle.dashed\" size={11} />\n              </button>\n            )}\n          </div>\n          <div className=\"zrm-vp-note\" data-at=\"tl\">\n            Échelle {Math.round(fitScale * 100)} %{zoom !== 1 ? ' · vue déplacée' : ''}<br />\n            Sélection : {pieceSelectionnee ? pieceSelectionnee.name : 'aucune'}\n          </div>\n          <div className=\"zrm-vp-note\" data-at=\"bl\">\n            Densité de contenu {compiled?.meta?.scale || 1}<br />\n            {format.safe ? 'Zone de sécurité déclarée' : 'Aucune zone de sécurité'}<br />\n            {format.canvas.w}{format.canvas.h ? ` × ${format.canvas.h}` : ' × libre'} ({format.label})\n          </div>\n          <div className=\"zrm-vp-note\" data-at=\"br\">{countItems(composition)} pièce(s)</div>\n          {themeError ? (\n            <p className=\"zrm-stage-empty\">{themeError}</p>\n          ) : !compiled ? (\n            <p className=\"zrm-stage-empty\">Complète le titre, le message d’une phrase et le public. L’aperçu est la page réelle, pas une approximation.</p>\n          ) : compiled.error ? (\n            <p className=\"zrm-stage-empty\">{compiled.error}</p>\n          ) : (\n            <div className=\"zrm-canvas\" ref={canvasRef} style={{ width: format.canvas.w * fitScale, height: stageHeight * fitScale, transform: `translate(${pan.x}px, ${pan.y}px)` }}>\n              <iframe\n                ref={frameRef}\n                title=\"Aperçu ZenRayMedia\"\n                onLoad={onFrameLoad}\n                srcDoc={debouncedHtml}\n                sandbox=\"allow-same-origin\"\n                style={{ width: format.canvas.w, height: stageHeight, transform: `scale(${fitScale})`, transformOrigin: '0 0' }}\n              />\n              {/* La couche de manipulation. Elle ne capte le pointeur que sur les boîtes, si bien\n                  que le reste de l'aperçu reste cliquable par le pont de sélection. */}\n\n(exit 0)