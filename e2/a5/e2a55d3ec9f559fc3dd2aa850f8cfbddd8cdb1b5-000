      layer.blend !== 'normal' ? `mix-blend-mode:${layer.blend}` : '',\n   293\t      filtre ? `filter:${filtre}` : '',\n   294\t      // TRANSFORM-ORIGIN CENTER n'est PAS le défaut CSS (c'est 50% 50% par défaut en réalité, donc\n   295\t      // il ne coûte rien de le rappeler) : le pivot au centre est ce que Photoshop et Figma font\n   296\t      // tous deux, et c'est le seul qui ne surprenne jamais un utilisateur qui n'a rien réglé.\n   297\t      transformOf(layer) ? `transform:${transformOf(layer)};transform-origin:center` : '',\n   298\t      ombre ? `box-shadow:${escapeHtml(ombre)}` : '',\n   299\t      // FAMILLE FIGMA 6 · polygone et étoile ne sont pas des rectangles qu'on habille de coins\n   300\t      // arrondis : `clip-path` découpe RÉELLEMENT la boîte à la forme demandée.\n   301\t      layer.kind === 'shape' ? shapeClipPath(layer) && `clip-path:${shapeClipPath(layer)}` : '',\n   302\t      styleOf(layer),\n   303\t      // FAMILLE FIGMA 7 · le dégradé s'écrit APRÈS `styleOf`, donc après un éventuel\n   304\t      // `background-color` : en CSS la dernière déclaration l'emporte, le dégradé prime bien quand\n   305\t      // les deux coexistent dans le style en ligne.\n   306\t      fillOf(layer),\n   307\t    ].filter(Boolean).join(';')\n   308\t\n   309\t    let dedans = ''\n   310\t    if (layer.kind === 'text') {\n   311\t      dedans = `<div class=\"zrm-layer-text\"><span>${escapeHtml(layer.source || layer.name).replace(/\\n/g, '<br>')}</span></div>`\n   312\t    } else if (layer.kind === 'image') {\n   313\t      // FAMILLE PHOTOSHOP 6 · LE POINT FOCAL, recadrage repositionnable sans outil dédié. La boîte\n   314\t      // du calque agit déjà comme le cadre de recadrage via `object-fit:cover` ; ce qui manquait\n   315\t      // est de choisir QUELLE partie de l'image reste visible dans ce cadre. `object-position`\n   316\t      // fait exactement ça, nativement, sans retailler le fichier source.\n   317\t      dedans = layer.source ? `<img src=\