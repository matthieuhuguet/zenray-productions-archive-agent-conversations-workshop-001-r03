               title=\"Aperçu ZenRayMedia\"\n                onLoad={onFrameLoad}\n                srcDoc={debouncedHtml}\n                sandbox=\"allow-same-origin\"\n                style={{ width: format.canvas.w, height: stageHeight, transform: `scale(${fitScale})`, transformOrigin: '0 0' }}\n              />\n              {/* La couche de manipulation. Elle ne capte le pointeur que sur les boîtes, si bien\n                  que le reste de l'aperçu reste cliquable par le pont de sélection. */}\n              {countLayers(composition) > 0 && (\n                <div className=\"zrm-lay-layer\" onPointerMove={onPoigneeMove} onPointerUp={onPoigneeUp} onPointerCancel={onPoigneeUp}>\n                  {stackOrder(composition).filter((l) => !l.hidden).map((layer) => (\n                    <div key={layer.id} className=\"zrm-lay-box\" data-on={selectedComponent === layer.id} data-locked={layer.locked || undefined}\n                      style={{ left: layer.x * fitScale, top: layer.y * fitScale, width: layer.w * fitScale, height: layer.h * fitScale,\n                        // Le contour de sélection SUIT la rotation du calque, sinon les poignées ne\n                        // désignent plus les bons coins dès que le calque a tourné.\n                        transform: layer.rotation ? `rotate(${layer.rotation}deg)` : undefined }}\n                      onPointerDown={(e) => onPoigneeDown(e, layer, 'move')}\n                      onDoubleClick={(e) => { if (layer.kind === 'text' && !layer.locked) { e.stopPropagation(); setEditionTexteId(layer.id) } }}>\n                      {selectedComponent === layer.id && !layer.locked && ['nw', 'n', 'ne', 'e', 'se', 's', 'sw', 'w'].map((coin) => (\n                        <i key={coin} className=\"zrm-lay-h\" data-at={coin} onPointerDown={(e) => onPoigneeDown(e, layer, coin)} />\n                      ))}\n                      {/* LA POIGNÉE DE ROTATION, détachée au-dessus du calque comme dans Figma et\n                          Photoshop : un huitième point l'aurait confondue avec un redimensionnement. */}\n                      {selectedComponent === layer.id && !layer.locked && (\n                        <i className=\"zrm-lay-rot\" title=\"Glisser pour pivoter\" onPointerDown={(e) => onPoigneeRotation(e, layer)} />\n                      )}\n                      {/* FAMILLE FIGMA 5 · le double-clic ouvre l'édition LÀ où le texte s'affiche,\n                          au lieu de forcer un aller-retour par le panneau Détails. */}\n                      {editionTexteId === layer.id && (\n                        <textarea className=\"zrm-lay-edit\" aria-label=\"Éditer le texte sur le canevas\" autoFocus\n                          value={layer.source}\n                          onPointerDown={(e) => e.stopPropagation()}\n                          onChange={(e) => patchComposition((c) => patchLayer(c, layer.id, { source: e.target.value }))}\n                          onBlur={() => setEditionTexteId(null)}\n                          onKeyDown={(e) => { if (e.key === 'Escape') { e.currentTarget.blur() } }} />\n                      )}\n                    </div>\n                  ))}\n                </div>\n              )}\n              {/* LES GUIDES DE MAGNÉTISME, un trait par axe accroché, dans le référentiel du\n                  canevas — ils ne suivent PAS la rotation, un guide reste toujours horizontal ou\n                  vertical, c'est ce qui en fait un repère. */}\n              {guides.x !== null && <i className=\"zrm-guide zrm-guide-v\" style={{ left: guides.x * fitScale }} />}\n              {guides.y !== null && <i className=\"zrm-guide zrm-guide-h\" style={{ top: guides.y * fitScale }} />}\n              {marqueeBox && (\n                <i className=\"zrm-marquee\" style={{\n                  left: Math.min(marqueeBox.x1, marqueeBox.x2) * fitScale,\n                  top: Math.min(marqueeBox.y1, marqueeBox.y2) * fitScale,\n                  width: Math.abs(marqueeBox.x2 - marqueeBox.x1) * fitScale,\n                  height: Math.abs(marqueeBox.y2 - marqueeBox.y1) * fitScale,\n                }} />\n              )}\n              {showSafe && format.safe && (\n                <div className=\"zrm-safe-overlay\">\n                  <i style={{ left: 0, right: 0, top: 0, height: format.safe.top * fitScale }} />\n                  <i style={{ left: 0, right: 0, bottom: 0, height: format.safe.bottom * fitScale }} />\n                  <i style={{ top: 0, bottom: 0, left: 0, width: format.safe.sides * fitScale }} />\n                  <i style={{ top: 0, bottom: 0, right: 0, width: format.safe.sides * fitScale }} />\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n      </section>\n\n      {/* ---- DECK ---- */}\n      <section className=\"zrm-panel zrm-pane-details zrm-zone-details\">\n        <header className=\"zrm-head\" style={{ gap: 4 }}>\n          {DECK_TABS.map((tab) => (\n            <button key={tab.key} className=\"zrm-tool\" style={{ height: 20, padding: '0 6px' }} data-on={deckTab === tab.key}\n              title={tab.label} aria-label={tab.label} onClick={() => setDeckTab(tab.key)}>\n              <Icon name={tab.icon} size={12} />\n              {tab.key === 'critic' && issues.length ? <b style={{ fontWeight: 400, fontSize: 9 }}>{issues.length}</b> : null}\n            </button>\n          ))}\n        </header>\n        <div className=\"zrm-body\">\n          {/* DÉTAILS DE LA PIÈCE SÉLECTIONNÉE. Vider un champ le fait REVENIR au brief au lieu de\n              l'effacer : `resolveItemData` ne retient que les chaînes non vides, et c'est ce qui\n              distingue « jamais renseigné » de « renseigné puis vidé » dans une interface où le\n              modèle, lui, ne les distingue pas. */}\n          {/* ═══ ZONE 5 · LE PANNEAU DE PROPRIÉTÉS ══════════════════════════════════════════════\n              La forme d'Unreal, à la lettre : en-tête d'objet, sections repliables, rangées dont\n              les libellés s'alignent sur une colonne commune. L'ancienne version empilait des\n              champs pleine largeur, ce qui rendait vingt propriétés illisibles.\n\n              LES SECTIONS SONT DÉDUITES DU TYPE DÉCLARÉ, jamais inventées : une couleur va dans\n              « Apparence », le reste dans « Contenu ». Le thème déclare ses champs, l'interface se\n              contente de les ranger, si bien qu'un thème neuf n'oblige à toucher à rien ici. */}\n          {/* ═══ CARTE L5 · LES PROPRIÉTÉS D'UN CALQUE ══════════════════════════════════════════\n              La géométrie s'écrit ici ET se manipule au canevas : deux chemins vers la même valeur,\n              ce qui est acceptable parce qu'ils écrivent tous deux dans le modèle, contrairement au\n              format qui vivait à trois endroits sans source commune. Un champ numérique reste\n              indispensable, puisqu'aucune souris ne pose un calque exactement à 120 pixels. */}\n          {/* ═══ LES TEXTES D'ABORD, TOUJOURS ══════════════════════════════════════════════════════\n              « Le plus important, si je clique sur un élément de texte, c'est de pouvoir modifier\n              le texte à droite, ça me semble évident. » Il a raison, et le panneau ratait le cas le\n              plus fréquent : on clique rarement PILE sur le nœud qui porte le texte, on clique sur\n              la boîte qui le contient, et le panneau répondait « ce nœud n'a pas de texte propre »,\n              ce qui est exact et parfaitement inutile.\n\n              Le bloc remonte donc TOUS les textes de la sélection, du nœud choisi ou de la pièce\n              entière à défaut, à plat et dans l'ordre de lecture. Le premier champ du panneau est\n              désormais toujours un champ de texte. */}\n          {deckTab === 'details' && textesDeLaSelection.length > 0 && (\n            <>\n              <div className=\"zrm-det-sec\" style={{ marginTop: 0 }}>\n                <span style={{ width: 9 }} />Textes<span style={{ marginLeft: 'auto', opacity: .5 }}>{textesDeLaSelection.length}</span>\n              </div>\n              {textesDeLaSelection.map((t) => {\n                const pose = reglagePour(t.path).text\n                return (\n                  <div key={t.path} className=\"zrm-det-row\" data-on={selectedNode === t.path}>\n                    <span className=\"zrm-det-lab\" title={`${t.name} · ${t.tag}`}>{t.name}</span>\n                    <input className=\"zrm-det-in\" aria-label={`Texte ${t.name}`} value={pose ?? t.text}\n                      onFocus={() => setSelectedNode(t.path)}\n                      onChange={(e) => reglerChemin(t.path, { text: e.target.value })} />\n                    {pose ? (\n                      <button className=\"zrm-det-revert\" title=\"Revenir au texte du composant\" onClick={() => reglerChemin(t.path, { text: '' })}>\n                        <Icon name=\"arrow.uturn.backward\" size={10} />\n                      </button>\n                    ) : <span />}\n                  </div>\n                )\n              })}\n            </>\n          )}\n\n          {/* ═══ LES RÉGLAGES D'UN SOUS-COMPOSANT ════════════════════════════════════════════════\n              « Quand je clique sur un éditeur je n'ai pas forcément accès à modifier le texte\n              parce que ça créerait des comportements bizarres, mais dans le panel de droite je\n              devrais pouvoir modifier tout ce que je veux. » C'est exactement le partage retenu :\n              l'aperçu DÉSIGNE, il n'édite pas ; le panneau de droite édite tout.\n\n              Le texte proposé est le texte PROPRE du nœud, jamais celui de ses enfants : régler\n              le texte d'un conteneur effacerait sa descendance entière en un caractère. */}\n          {/* ═══ ÉDITION GROUPÉE ET VALEURS MIXTES (famille 1) ═══════════════════════════════════\n              Le Details Panel d'Unreal, sur une sélection multiple homogène, propose les\n              propriétés COMMUNES et affiche « Multiple Values » là où elles divergent ; modifier\n              un champ commun le propage à tous les objets sélectionnés. C'est exactement ce\n              comportement, borné aux calques puisque ce sont eux qui partagent un terrain sûr :\n              opacité, fusion, effets et typographie. Les propriétés de pièces sont déclarées par\n              le thème et hétérogènes d'une famille à l'autre — les imposer en groupe casserait\n              plus qu'il n'aiderait, donc l'édition groupée ne s'ouvre pas sur elles. */}\n          {deckTab === 'details' && modeGroupe && (\n            <>\n              <div className=\"zrm-det-obj\">\n                <span className=\"zrm-tree-glyph\">{calquesSelectionnes.length}</span>\n                <span style={{ flex: 1, opacity: .7 }}>{calquesSelectionnes.length} calques sélectionnés</span>\n                <span>édition groupée</span>\n              </div>\n\n              {/* ═══ FAMILLE PHOTOSHOP 2 · ALIGNEMENT ET DISTRIBUTION ═══════════════════════════\n                  Aligne les calques les uns SUR LES AUTRES, sur leur boîte englobante commune —\n                  jamais sur le canevas, comportement par défaut de Photoshop dès que plusieurs\n                  calques sont choisis. Une seule rangée d'icônes, six alignements puis deux\n                  distributions, cette dernière grisée sous trois calques puisqu'il n'y a alors\n                  rien « entre » deux objets à égaliser. */}\n              <div className=\"zrm-det-sec\"><span style={{ width: 9 }} />Alignement</div>\n              <div className=\"zrm-det-row\" style={{ gridTemplateColumns: 'none' }}>\n                <div className=\"zrm-align-row\">\n                  {[\n                    ['left', 'Aligner à gauche', 'view.align.left'],\n                    ['hcenter', 'Centrer horizontalement', 'view.align.left'],\n                    ['right', 'Aligner à droite', 'view.align.left'],\n                    ['top', 'Aligner en haut', 'view.align.left'],\n                    ['vcenter', 'Centrer verticalement', 'view.align.left'],\n                    ['bottom', 'Aligner en bas', 'view.align.left'],\n                  ].map(([mode, titre]) => (\n                    <button key={mode} className=\"zrm-tool\" title={titre}\n                      onClick={() => {\n                        const patches = alignPatch(calquesSelectionnes, mode)\n                        patchComposition((c) => patches.reduce((etat, p) => patchLayer(etat, p.id, p), c))\n                      }}>\n                      <AlignIcon mode={mode} />\n                    </button>\n                  ))}\n                  <span className=\"zrm-tool-sep\" />\n                  {[['x', 'Distribuer horizontalement'], ['y', 'Distribuer verticalement']].map(([axe, titre]) => (\n                    <button key={axe} className=\"zrm-tool\" title={titre} disabled={calquesSelectionnes.length < 3}\n                      onClick={() => {\n                        const patches = distributePatch(calquesSelectionnes, axe)\n                        patchComposition((c) => patches.reduce((etat, p) => patchLayer(etat, p.id, p), c))\n                      }}>\n                      <AlignIcon mode={`dist-${axe}`} />\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              <div className=\"zrm-det-sec\"><span style={{ width: 9 }} />Apparence commune</div>\n              <div className=\"zrm-det-row\">\n                <span className=\"zrm-det-lab\">Opacité</span>\n                {(() => { const { valeur, mixte } = valeurGroupee((l) => l.opacity)\n                  return <input className=\"zrm-det-in\" type=\"range\" min=\"0\" max=\"1\" step=\"0.01\" aria-label=\"Opacité\"\n                    value={mixte ? 0 : valeur} title={mixte ? 'Plusieurs valeurs' : undefined}\n                    style={{ accentColor: UI.blue, opacity: mixte ? .4 : 1 }}\n                    onChange={(e) => { const v = Number(e.target.value); surLaSelection((c, id) => patchLayer(c, id, { opacity: v })) }} /> })()}\n                <span className=\"zrm-tree-tag\">{valeurGroupee((l) => l.opacity).mixte ? '—' : `${Math.round(valeurGroupee((l) => l.opacity).valeur * 100)}%`}</span>\n              </div>\n              <div className=\"zrm-det-row\">\n                <span className=\"zrm-det-lab\">Fusion</span>\n                {(() => { const { valeur, mixte } = valeurGroupee((l) => l.blend)\n                  return <select className=\"zrm-det-in\" aria-label=\"Mode de fusion\" value={mixte ? '' : valeur}\n                    onChange={(e) => { const v = e.target.value; surLaSelection((c, id) => patchLayer(c, id, { blend: v })) }}>\n                    {mixte && <option value=\"\">— plusieurs valeurs —</option>}\n                    {BLEND_MODES.map((m) => <option key={m} value={m}>{m}</option>)}\n                  </select> })()}\n                <span />\n              </div>\n              {[['blur', 'Flou'], ['brightness', 'Luminosité'], ['contrast', 'Contraste'], ['saturate', 'Saturation']].map(([clef, libelle]) => {\n                const { valeur, mixte } = valeurGroupee((l) => l.effects?.[clef] ?? (clef === 'blur' ? 0 : 1))\n                return (\n                  <div key={clef} className=\"zrm-det-row\">\n                    <span className=\"zrm-det-lab\">{libelle}</span>\n                    <input className=\"zrm-det-in\" type=\"range\" min=\"0\" max={clef === 'blur' ? 40 : 3} step={clef === 'blur' ? 1 : 0.01}\n                      aria-label={libelle} value={mixte ? 0 : valeur} style={{ accentColor: UI.blue, opacity: mixte ? .4 : 1 }}\n                      onChange={(e) => { const v = Number(e.target.value); surLaSelection((c, id) => patchLayer(c, id, { effects: { [clef]: v } })) }} />\n                    <span className=\"zrm-tree-tag\">{mixte ? '—' : valeur}</span>\n                  </div>\n                )\n              })}\n              <div className=\"zrm-det-sec\"><span style={{ width: 9 }} />Typographie commune</div>\n              {LAYER_STYLES.map((champ) => {\n                const { valeur, mixte } = valeurGroupee((l) => l.style?.[champ.key] || '')\n                return (\n                  <div key={champ.key} className=\"zrm-det-row\">\n                    <span className=\"zrm-det-lab\">{champ.label}</span>\n                    {champ.type === 'select' ? (\n                      <select className=\"zrm-det-in\" aria-label={champ.label} value={mixte ? '' : valeur}\n                        onChange={(e) => { const v = e.target.value; surLaSelection((c, id) => patchLayer(c, id, { style: { [champ.key]: v } })) }}>\n                        {mixte && <option value=\"\">— plusieurs valeurs —</option>}\n                        {champ.options.map((o) => <option key={o} value={o}>{o || '—'}</option>)}\n                      </select>\n                    ) : (\n                      <input className=\"zrm-det-in\" type={champ.type === 'color' ? 'color' : 'text'} aria-label={champ.label}\n                        placeholder={mixte ? 'plusieurs valeurs' : (champ.hint || '')} value={mixte ? '' : valeur}\n                        onChange={(e) => { const v = e.target.value; surLaSelection((c, id) => patchLayer(c, id, { style: { [champ.key]: v } })) }} />\n                    )}\n                    <span />\n                  </div>\n                )\n              })}\n            </>\n          )}\n\n          {deckTab === 'details' && !modeGroupe && noeudSelectionne && (\n            <>\n              <div className=\"zrm-det-obj\">\n                <span className=\"zrm-tree-glyph\">{'<>'}</span>\n                <input value={noeudSelectionne.name} readOnly aria-label=\"Sous-composant\" />\n                <span>{noeudSelectionne.tag}</span>\n                <VerrouPanneau verrouille={panelLockedId === idPourPanneau} onClick={() => setPanelLockedId((v) => (v ? null : idPourPanneau))} />\n              </div>\n              <div className=\"zrm-det-row\">\n         …569 tokens truncated…patchComposition((c) => patchLayer(c, calqueSelectionne.id, { name: e.target.value }))} />\n                <span>calque · {calqueSelectionne.kind}</span>\n                <VerrouPanneau verrouille={panelLockedId === idPourPanneau} onClick={() => setPanelLockedId((v) => (v ? null : idPourPanneau))} />\n              </div>\n\n              <button className=\"zrm-det-sec\" onClick={() => setDetSections((st) => ({ ...st, geo: detSections.geo === false }))}>\n                <span className=\"zrm-twist\" data-open={detSections.geo !== false}><Icon name=\"chevron.right\" size={9} /></span>Géométrie\n              </button>\n              {detSections.geo !== false && [['x', 'Position X'], ['y', 'Position Y'], ['w', 'Taille X'], ['h', 'Taille Y'], ['rotation', 'Rotation']].map(([clef, libelle]) => (\n                <div key={clef} className=\"zrm-det-row\">\n                  <span className=\"zrm-det-lab\">{libelle}</span>\n                  <input className=\"zrm-det-in\" type=\"number\" aria-label={libelle} value={calqueSelectionne[clef]}\n                    onChange={(e) => {\n                      const v = Number(e.target.value)\n                      if (!Number.isFinite(v)) return\n                      patchComposition((c) => patchLayer(c, calqueSelectionne.id, { [clef]: (clef === 'w' || clef === 'h') ? Math.max(1, v) : v }))\n                    }} />\n                  <span className=\"zrm-tree-tag\">{clef === 'rotation' ? '°' : 'px'}</span>\n                </div>\n              ))}\n              {/* FAMILLE FIGMA 3 · CONTRAINTES. Comment ce calque réagit au changement de FORMAT,\n                  le seul redimensionnement de cadre que connaisse ce produit. */}\n              {detSections.geo !== false && (\n                <>\n                  <div className=\"zrm-det-row\">\n                    <span className=\"zrm-det-lab\">Contrainte X</span>\n                    <select className=\"zrm-det-in\" aria-label=\"Contrainte horizontale\" value={calqueSelectionne.constrainH}\n                      onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { constrainH: e.target.value }))}>\n                      <option value=\"left\">Gauche</option>\n                      <option value=\"center\">Centre</option>\n                      <option value=\"right\">Droite</option>\n                      <option value=\"scale\">Échelle</option>\n                    </select>\n                    <span />\n                  </div>\n                  <div className=\"zrm-det-row\">\n                    <span className=\"zrm-det-lab\">Contrainte Y</span>\n                    <select className=\"zrm-det-in\" aria-label=\"Contrainte verticale\" value={calqueSelectionne.constrainV}\n                      onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { constrainV: e.target.value }))}>\n                      <option value=\"top\">Haut</option>\n                      <option value=\"center\">Centre</option>\n                      <option value=\"bottom\">Bas</option>\n                      <option value=\"scale\">Échelle</option>\n                    </select>\n                    <span />\n                  </div>\n                </>\n              )}\n\n              {/* RETOURNEMENT HORIZONTAL ET VERTICAL (famille Photoshop 2). Deux bascules, pas\n                  deux boutons à effet unique : un second clic revient à l'état d'origine, comme\n                  Photoshop où le retournement est un INTERRUPTEUR et non une action à sens unique. */}\n              {detSections.geo !== false && (\n                <div className=\"zrm-det-row\">\n                  <span className=\"zrm-det-lab\">Retourner</span>\n                  <span style={{ display: 'flex', gap: 4 }}>\n                    <button className=\"zrm-tool\" style={{ height: 22 }} data-on={calqueSelectionne.flipX} title=\"Retourner horizontalement\"\n                      onClick={() => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { flipX: !calqueSelectionne.flipX }))}>\n                      <Icon name=\"arrow.up.arrow.down\" size={11} style={{ transform: 'rotate(90deg)' }} />\n                    </button>\n                    <button className=\"zrm-tool\" style={{ height: 22 }} data-on={calqueSelectionne.flipY} title=\"Retourner verticalement\"\n                      onClick={() => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { flipY: !calqueSelectionne.flipY }))}>\n                      <Icon name=\"arrow.up.arrow.down\" size={11} />\n                    </button>\n                  </span>\n                  <span />\n                </div>\n              )}\n\n              <button className=\"zrm-det-sec\" onClick={() => setDetSections((st) => ({ ...st, contenu: detSections.contenu === false }))}>\n                <span className=\"zrm-twist\" data-open={detSections.contenu !== false}><Icon name=\"chevron.right\" size={9} /></span>Contenu\n              </button>\n              {detSections.contenu !== false && (\n                <div className=\"zrm-det-row\">\n                  <span className=\"zrm-det-lab\">{calqueSelectionne.kind === 'text' ? 'Texte' : calqueSelectionne.kind === 'image' ? 'Adresse' : calqueSelectionne.kind === 'component' ? 'Composant' : 'Sans contenu'}</span>\n                  {calqueSelectionne.kind === 'component' ? (\n                    <select className=\"zrm-det-in\" aria-label=\"Composant du calque\" value={calqueSelectionne.source}\n                      onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { source: e.target.value }))}>\n                      <option value=\"\">—</option>\n                      {(componentBundle?.components || []).map((e2) => <option key={e2.id} value={e2.id}>{e2.name}</option>)}\n                    </select>\n                  ) : calqueSelectionne.kind === 'shape' ? (\n                    // FAMILLE PHOTOSHOP 4 · LE TYPE DE FORME. Rectangle, ellipse ou ligne : la\n                    // seule propriété qu'un calque de forme n'avait jamais pu régler.\n                    <select className=\"zrm-det-in\" aria-label=\"Type de forme\" value={calqueSelectionne.shapeType}\n                      onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { shapeType: e.target.value }))}>\n                      <option value=\"rectangle\">Rectangle</option>\n                      <option value=\"ellipse\">Ellipse</option>\n                      <option value=\"line\">Ligne</option>\n                      <option value=\"polygon\">Polygone</option>\n                      <option value=\"star\">Étoile</option>\n                    </select>\n                  ) : calqueSelectionne.kind === 'text' ? (\n                    // Un champ d'une ligne pour un calque de titre est une infirmité : un titre se\n                    // coupe, et la coupe fait partie du dessin. Le retour à la ligne est conservé\n                    // jusque dans la page rendue, où il devient un <br>.\n                    <textarea className=\"zrm-det-in\" aria-label=\"Contenu du calque\" rows={3}\n                      style={{ height: 'auto', minHeight: 46, resize: 'vertical', lineHeight: 1.4, padding: '4px 6px' }}\n                      value={calqueSelectionne.source}\n                      onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { source: e.target.value }))} />\n                  ) : (\n                    <input className=\"zrm-det-in\" aria-label=\"Contenu du calque\" value={calqueSelectionne.source}\n                      onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { source: e.target.value }))} />\n                  )}\n                  <span />\n                </div>\n              )}\n\n              {/* FAMILLE FIGMA 6 · POLYGONE ET ÉTOILE, les deux formes PARAMÉTRIQUES de Figma :\n                  un nombre de côtés, et pour l'étoile un ratio de rayon interne. Jamais un tracé à\n                  points qu'on déplace un par un, portée assumée et écrite au-dessus de SHAPE_TYPES. */}\n              {detSections.contenu !== false && calqueSelectionne.kind === 'shape' && (calqueSelectionne.shapeType === 'polygon' || calqueSelectionne.shapeType === 'star') && (\n                <>\n                  <div className=\"zrm-det-row\">\n                    <span className=\"zrm-det-lab\">Côtés</span>\n                    <input className=\"zrm-det-in\" type=\"range\" min=\"3\" max=\"12\" step=\"1\" aria-label=\"Nombre de côtés\"\n                      value={calqueSelectionne.shapeSides} style={{ accentColor: UI.blue }}\n                      onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { shapeSides: Number(e.target.value) }))} />\n                    <span className=\"zrm-tree-tag\">{calqueSelectionne.shapeSides}</span>\n                  </div>\n                  {calqueSelectionne.shapeType === 'star' && (\n                    <div className=\"zrm-det-row\">\n                      <span className=\"zrm-det-lab\">Ratio</span>\n                      <input className=\"zrm-det-in\" type=\"range\" min=\"0.1\" max=\"0.9\" step=\"0.05\" aria-label=\"Ratio de l’étoile\"\n                        value={calqueSelectionne.shapeStarRatio} style={{ accentColor: UI.blue }}\n                        onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { shapeStarRatio: Number(e.target.value) }))} />\n                      <span className=\"zrm-tree-tag\">{Math.round(calqueSelectionne.shapeStarRatio * 100)}%</span>\n                    </div>\n                  )}\n                </>\n              )}\n\n              {/* FAMILLE PHOTOSHOP 6 · LE POINT FOCAL. La boîte du calque agit déjà comme un\n                  cadre de recadrage (`object-fit:cover`,