  await waitFor(() => expect(screen.getByText('Diapositive 1')).toBeTruthy())\n+    fireEvent.click(screen.getByText('Ajouter une diapositive'))\n+    await waitFor(() => expect(screen.getByText('Diapositive 2')).toBeTruthy())\n+    expect(screen.getByText('Toutes les diapositives')).toBeTruthy()\n+  })\n+})\ndiff --git a/src/zenraymedia/layers.test.js b/src/zenraymedia/layers.test.js\nindex 5c81514..eb1bdcd 100644\n--- a/src/zenraymedia/layers.test.js\n+++ b/src/zenraymedia/layers.test.js\n@@ -1383,3 +1383,31 @@ describe('PowerPoint P6 — entrée animée', () => {\n     expect(boiteExterne).not.toContain('animation:')\n   })\n })\n+\n+// ═══════════════════════════════════════════════════════════════════════════════════════════════\n+// Carte P8 (PowerPoint) — famille « Collaboration, sauvegarde, diffusion » (export du carrousel).\n+// ═══════════════════════════════════════════════════════════════════════════════════════════════\n+describe('PowerPoint P8 — export de toutes les diapositives', () => {\n+  // L'export PNG lui-même passe par canvas/Image, absents de jsdom (déjà le cas pour TOUT export\n+  // de ce fichier, aucun test antérieur n'y touche). Ce qui EST vérifiable, et ce qui compte\n+  // réellement, c'est que compiler CHAQUE diapositive avec elle seule active produit des pages\n+  // ISOLÉES : c'est le mécanisme exact que la boucle d'export réutilise, déjà prouvé par les tests\n+  // PowerPoint P1 sur isEffectivelyHidden, revérifié ici au niveau de la page compilée entière.\n+  it('compiler chaque diapositive séparément isole réellement son contenu, jamais celui des autres', () => {\n+    let c = addSlide(vide(), 'Une')\n+    const groupeUne = readSlides(c)[0].groupId\n+    c = addLayer(c, 'text', { name: 'Titre 1', source: 'Contenu Un', groupId: groupeUne })\n+    c = addSlide(c, 'Deux')\n+    const groupeDeux = readSlides(c)[1].groupId\n+    c = addLayer(c, 'text', { name: 'Titre 2', source: 'Contenu Deux', groupId: groupeDeux })\n+\n+    const [une, deu