gagne sur l’estimation', () => {\n    const { brief, cut } = fixture()\n    const square = getFormat('F-still-1080-square')\n    const guessed = compile({ brief, cut, theme, format: square, seed: 1 })\n    const measured = compile({ brief, cut, theme, format: square, seed: 1, fitScale: 0.54 })\n    expect(measured.meta.scale).toBe(0.54)\n    expect(measured.meta.scale).toBeLessThanOrEqual(guessed.meta.scale)\n    // Et l'export utilisera la MÊME valeur que l'aperçu : la page compilée en porte la trace.\n    expect(measured.html).toContain('data-zrm-scale=\"0.54\"')\n  })\n\n  it('le titre domine sur une affiche, pas sur un article', () => {\n    const { brief, cut } = fixture()\n    const titleOf = (html) => Number(/\\.zrm-title\\{[^}]*?font-size:([\\d.]+)px/.exec(html)?.[1])\n    const bodyOf = (html) => Number(/body\\{[^}]*?font-size:([\\d.]+)px/.exec(html)?.[1])\n    const article = compile({ brief, cut, theme, format: getFormat('F-web-article'), seed: 1 }).html\n    const poster = compile({ brief, cut, theme, format: getFormat('F-still-1080-square'), seed: 1 }).html\n    expect(titleOf(poster) / bodyOf(poster)).toBeGreaterThan(titleOf(article) / bodyOf(article))\n  })\n})\n\ndescribe('Gabarits HTML déposés à la main', () => {\n  it('remplace les champs et répète les beats', () => {\n    const tpl = '<h1>{{title}}</h1>{{#beats}}<p data-r=\"{{role}}\">{{number}}. {{text}}</p>{{/beats}}{{^beats}}<em>vide</em>{{/beats}}'\n    const out = renderTemplate(tpl, { title: 'Titre', beats: [{ role: 'hook', text: 'Un' }, { role: 'cta', text: 'Deux' }] })\n    expect(out).toBe('<h1>Titre</h1><p data-r=\"hook\">1. Un</p><p data-r=\"cta\">2. Deux</p>')\n    expect(renderTemplate(tpl, { title: 'T', beats: [] })).toBe('<h1>T</h1><em>vide</em>')\n  })\n\n  it('échappe par défaut et laisse passer le brut sur trois accolades', () => {\n    expect(renderTemplate('{{a}}', { a: '<b>x</b>' })).toBe('&lt;b&gt;x&lt;/b&gt;')\n  it('déclare ses formats, ses polices et son calibrage privé', async () => {\n    const t = await loadTheme('T-01-1-2')\n    expect(t.formats).toContain('F-print-a4')\n    expect(t.formats).toContain('F-still-1080x1920')\n    // Anton, identifiee par Matthieu au What-The-Google-Font. Elle n'a QU'UNE graisse :\n    // un font-weight:700 sur elle produirait un faux gras qui empate ses contreformes carrees.\n    expect(t.fonts).toEqual(['Anton', 'Spectral', 'Public Sans'])\n    expect(t.calibration.ref).toBe('LIBE')          // privé, jamais rendu\n    expect(t.beatCount).toEqual({ min: 3, max: 10 })\n  })\n\n  it('compile sur les 6 formats déclarés sans champ non résolu ni marque', async () => {\n    const t = await loadTheme('T-01-1-2')\n    const { brief, notes } = seedProject()\n    const cut = buildCut(brief, notes, t)\n    for (const id of t.formats) {\n      const { html } = compile({ brief, cut, theme: t, format: getFormat(id), seed: 1 })\n      expect(html, id).toContain('Un brief, mille formes')\n      expect(html, id).not.toContain('{{')            // aucun champ oublié\n      expect(html, id).not.toMatch(/https?:\\/\\//)     // aucune ressource distante\n      expect(html, id).not.toMatch(/lib[ée]ration/i)  // aucune marque rendue\n      expect(html, id).toContain('data-role=\"hook\"')  // les rôles pilotent les composants\n      expect(html, id).toContain('zrm-title')\n    }\n  })\n\n  it('n’applique jamais de faux gras à Anton', async () => {\n    const { readFileSync, readdirSync } = await import('node:fs')\n    const dir = 'src/zenraymedia/themes/T-01-1-2--une-de-rupture'\n    // Les pages de documentation autonomes ont quitté `src/` le 2026-07-28 : elles pesaient 79 Mo\n    // sur les six thèmes, l'éditeur ne les charge jamais, et elles noyaient le livrable (600 Ko)\n"},{"type":"input_text","text":"---3---\nsrc/zenraymedia/themes/T-01-1-2--une-de-rupture.html-326-\nsrc/zenraymedia/themes/T-01-1-2--une-de-rupture.html-327-<section class=\"zrm-band\">\nsrc/zenraymedia/themes/T-01-1-2--une-de-rupture.html-328-  <p cl