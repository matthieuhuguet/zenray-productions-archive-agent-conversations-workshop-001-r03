xport function setAutoLayoutProp(composition, groupId, patch) {\n   901\t  const groupe = readGroups(composition).find((g) => g.id === groupId)\n   902\t  if (!groupe?.autoLayout) return composition\n   903\t  return patchGroup(composition, groupId, { autoLayout: { ...groupe.autoLayout, ...patch } })\n   904\t}\n   905\t\n   906\t/**\n   907\t * Réaligne les membres de CHAQUE groupe en Auto Layout, dans l'ordre d'empilement (même ordre que\n   908\t * `paintOrder`, pour que la pile visuelle et le flux de lecture ne racontent jamais deux histoires\n   909\t * différentes). Fonction PURE, appelée après CHAQUE mutation de la composition — c'est ce qui la\n   910\t * rend « vivante » plutôt que ponctuelle.\n   911\t */\n   912\texport function applyAutoLayout(composition) {\n   913\t  const groups = readGroups(composition)\n   914\t  if (!groups.some((g) => g.autoLayout)) return composition\n   915\t  let layers = readLayers(composition)\n   916\t  for (const groupe of groups) {\n   917\t    if (!groupe.autoLayout) continue\n   918\t    const membres = layers.filter((l) => l.groupId === groupe.id).sort((a, b) => a.z - b.z)\n   919\t    if (!membres.length) continue\n   920\t    const { direction, gap, padding } = groupe.autoLayout\n   921\t    const ancreX = Number.isFinite(groupe.autoX) ? groupe.autoX : membres[0].x\n   922\t    const ancreY = Number.isFinite(groupe.autoY) ? groupe.autoY : membres[0].y\n   923\t    let curseur = (direction === 'row' ? ancreX : ancreY) + padding\n   924\t    const places = new Map()\n   925\t    for (const m of membres) {\n   926\t      const x = direction === 'row' ? curseur : ancreX + padding\n   927\t      const y = direction === 'row' ? ancreY + padding : curseur\n   928\t      places.set(m.id, { x: Math.round(x), y: Math.round(y) })\n   929\t      curseur += (direction === 'row' ? m.w : m.h) + gap\n   930\t    }\n   931\t    layers = layers.map((l) => (places.has(l.id) ? { ...l, ...places.get(l.id) } : l))\n   932\t  }\n   933\t  return { ...composition, layers }\n   934\t}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"6b8c71a4-bf2e-4775-bb32-5a852d61030b"}}}
