els réels à chaque redimensionnement.\n+// Un point dont la poignée coïncide avec l'ancre (in ou out égal à x/y) ne courbe pas ce côté-là :\n+// c'est un ANGLE. Des poignées écartées de l'ancre produisent une courbe : un point LISSE.\n+function borneNombre(v, repli) {\n+  return Number.isFinite(v) ? Math.min(100, Math.max(0, v)) : repli\n+}\n+\n+function normaliserPointTrace(p) {\n+  const x = borneNombre(p?.x, 0), y = borneNombre(p?.y, 0)\n+  return {\n+    x, y,\n+    inX: borneNombre(p?.inX, x), inY: borneNombre(p?.inY, y),\n+    outX: borneNombre(p?.outX, x), outY: borneNombre(p?.outY, y),\n+  }\n+}\n+\n+function normaliserTrace(l) {\n+  const points = Array.isArray(l.pathPoints) ? l.pathPoints.filter((p) => p && typeof p === 'object').map(normaliserPointTrace) : []\n+  return {\n+    pathPoints: points,\n+    pathClosed: !!l.pathClosed,\n+    pathStrokeColor: typeof l.pathStrokeColor === 'string' && HEX_RE.test(l.pathStrokeColor) ? l.pathStrokeColor : '',\n+    pathStrokeWidth: Math.min(20, Math.max(0.5, nombre(l.pathStrokeWidth, 2))),\n+  }\n+}\n+\n /**\n  * Redimensionne une grille de cellules à `newRows × newCols`, en conservant le contenu des\n  * cellules qui existaient déjà aux mêmes coordonnées — agrandir un tableau ne doit jamais effacer\n@@ -270,6 +302,7 @@ export function readLayers(composition) {\n       connectTo: typeof l.connectTo === 'string' && l.connectTo && l.connectTo !== l.id && idsConnus.has(l.connectTo) ? l.connectTo : '',\n       connectorX1: nombre(l.connectorX1, 0), connectorY1: nombre(l.connectorY1, 0),\n       connectorX2: nombre(l.connectorX2, 0), connectorY2: nombre(l.connectorY2, 0),\n+      ...normaliserTrace(l),\n       focalX: Math.min(100, Math.max(0, nombre(l.focalX, 50))), focalY: Math.min(100, Math.max(0, nombre(l.focalY, 50))),\n       constrainH: CONSTRAINTS_H.includes(l.constrainH) ? l.constrainH : 'left',\n       constrainV: CONSTRAINTS_V.includes(l.constrainV) ? l.constrainV : 'top',\n@@ -536,6 +569,95 @@ export function shapeClipPath(layer) {\n   return `polygon(${points.join(', ')})`\n }\n \n+// ═══════════════════════════════════════════════════════════════════════════════════════════════\n+// FAMILLE ILLUSTRATOR I2 · L'OUTIL PLUME (carte I2, 2026-08-06)\n+//\n+// Matthieu craignait que la Plume soit manquante ; elle l'était réellement, la carte F6 l'ayant\n+// explicitement écartée. C'est ici qu'elle arrive : un tracé vectoriel VÉRITABLE, point par point,\n+// avec des poignées bézier indépendantes par point, pas une géométrie paramétrique de plus.\n+//\n+// LE CHOIX QUI DÉCIDE DE TOUT LE RESTE : les points se dessinent en coordonnées ABSOLUES du\n+// canevas pendant le geste (comme un vrai clic à l'écran), mais se STOCKENT en POURCENTAGE de la\n+// boîte du calque une fois le tracé achevé (`createPathLayer`). Ainsi déplacer ou redimensionner\n+// le calque déplace ou redimensionne le tracé tout seul, par le mécanisme déjà en place pour\n+// CHAQUE autre calque (position/taille en CSS) — aucun recalcul n'est nécessaire à chaque geste,\n+// contrairement au connecteur (carte M6) dont la géométrie dépend d'AUTRES calques.\n+function round2(n) { return Math.round(n * 100) / 100 }\n+\n+/** La chaîne `d` d'un tracé SVG : une courbe de Bézier cubique entre CHAQUE paire de points\n+ * consécutifs, même quand elle est plate (poignée confondue avec l'ancre = point d'ANGLE). Une\n+ * seule formule pour angle et courbe, plutôt que deux commandes SVG à choisir au cas par cas. */\n+export function pathD(points, closed) {\n+  if (!Array.isArray(points) || points.length < 2) return ''\n+  const [p0] = points\n+  let d = `M ${round2(p0.x)} ${round2(p0.y)}`\n+  for (let i = 1; i < points.length; i++) {\n+    const precedent = points[i - 1], p = points[i]\n+    d += ` C ${round2(precedent.outX)} ${round2(precedent.outY)} ${round2(p.inX)} ${round2(p.inY)} ${round2(p.x)} ${round2(p.y)}`\n+  }\n+  if (closed && points.length > 2) {\n+    const dernier = points[points.length - 1]\n+    d += ` C ${round2(dernier.outX)} ${round2(dernier.outY)} ${round2(p0.inX)} ${round2(p0.inY)} ${round2(p0.x)} ${round2(p0.y)} Z`\n+  }\n+  return d\n+}\n+\n+/** Crée le calque tracé à partir de points en coordonnées ABSOLUES du canevas (celles que le\n+ * geste de dessin accumule). La boîte englobante inclut les POIGNÉES, pas seulement les ancres :\n+ * une courbe de Bézier reste toujours À L'INTÉRIEUR de l'enveloppe convexe de ses quatre points de\n+ * contrôle, propriété mathématique qui garantit que rien ne dépasse de la boîte calculée ainsi. */\n+export function createPathLayer(composition, points, closed) {\n+  if (!Array.isArray(points) || points.length < 2) return composition\n+  const xs = points.flatMap((p) => [p.x, p.inX, p.outX])\n+  const ys = points.flatMap((p) => [p.y, p.inY, p.outY])\n+  const minX = Math.min(...xs), minY = Math.min(...ys)\n+  const w = Math.max(1, Math.max(...xs) - minX), h = Math.max(1, Math.max(...ys) - minY)\n+  const pathPoints = points.map((p) => ({\n+    x: ((p.x - minX) / w) * 100, y: ((p.y - minY) / h) * 100,\n+    inX: ((p.inX - minX) / w) * 100, inY: ((p.inY - minY) / h) * 100,\n+    outX: ((p.outX - minX) / w) * 100, outY: ((p.outY - minY) / h) * 100,\n+  }))\n+  return addLayer(composition, 'shape', {\n+    name: 'Tracé', x: Math.round(minX), y: Math.round(minY), w: Math.round(w), h: Math.round(h),\n+    pathPoints, pathClosed: !!closed, pathStrokeColor: '#151515',\n+  })\n+}\n+\n+/** Déplace l'ancre d'un point : ses DEUX poignées suivent par la même translation, pour que la\n+ * courbe garde sa forme relative — exactement le comportement de la Sélection directe d'Illustrator. */\n+export function movePathAnchor(points, index, x, y) {\n+  const point = points[index]\n+  if (!point) return points\n+  const dx = x - point.x, dy = y - point.y\n+  const suivant = [...points]\n+  suivant[index] = { x, y, inX: point.inX + dx, inY: point.inY + dy, outX: point.outX + dx, outY: point.outY + dy }\n+  return suivant\n+}\n+\n+/** Déplace UNE SEULE poignée (in ou out), indépendamment de l'autre : c'est ce qui permet de\n+ * casser la symétrie d'un point lisse et de sculpter la courbe de chaque côté séparément. */\n+export function movePathHandle(points, index, which, x, y) {\n+  const point = points[index]\n+  if (!point) return points\n+  const suivant = [...points]\n+  suivant[index] = { ...point, [`${which}X`]: x, [`${which}Y`]: y }\n+  return suivant\n+}\n+\n+/** Retire un point du tracé. En dessous de deux points restants, un tracé n'a plus de sens : la\n+ * fonction ne descend jamais sous ce plancher. */\n+export function removePathPoint(points, index) {\n+  if (points.length <= 2) return points\n+  return points.filter((_, i) => i !== index)\n+}\n+\n+/** Insère un point d'ANGLE (poignées confondues avec l'ancre) juste après `afterIndex`. */\n+export function insertPathPoint(points, afterIndex, x, y) {\n+  const suivant = [...points]\n+  suivant.splice(afterIndex + 1, 0, { x, y, inX: x, inY: y, outX: x, outY: y })\n+  return suivant\n+}\n+\n \n // LA LARGEUR D'UNE COLONNE REDIMENSIONNÉE (carte S3, famille « Docking »), sortie en fonction pure\n // pour la même raison qu'`applyHandle` : jsdom simule mal `PointerEvent.clientX` (limite connue,\ndiff --git a/src/zenraymedia/layers.test.js b/src/zenraymedia/layers.test.js\nindex a46dd4b..de95624 100644\n--- a/src/zenraymedia/layers.test.js\n+++ b/src/zenraymedia/layers.test.js\n@@ -1513,3 +1513,142 @@ describe('Miro M6 — connecteurs', () => {\n     expect(el.hasAttribute('data-shape')).toBe(false)\n   })\n })\n+\n+// ═══════════════════════════════════════════════════════════════════════════════════════════════\n+// Carte I2 (Illustrator) — famille « Création et modification de tracés vectoriels » (l'outil Plume).\n+// ═══════════════════════════════════════════════════════════════════════════════════════════════\n+import { pathD, createPathLayer, movePathAnchor, movePathHandle, removePathPoint, insertPathPoint } from './layers.js'\n+\n+describe('Illustrator I2 — tracé vectoriel (Plume)', () => {\n+  it('un calque neuf n’a aucun point : ce n’est pas un tracé', () => {\n+    const l = readLayers(addLayer(vide(), 'shape'))[0]\n+    expect(l.pathPoints).toEqual([])\n+    expect(l.pathClosed).toBe(false)\n+  })\n+\n+  it('pathD relie deux points d’ANGLE par une courbe plate (poignées confondues avec l’ancre)', () => {\n+    const points = [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n+      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },\n+    ]\n+    expect(pathD(points, false)).toBe('M 0 0 C 0 0 100 0 100 0')\n+  })\n+\n+  it('pathD ferme le tracé (Z) et relie le dernier point au premier quand closed=true', () => {\n+    const points = [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n+      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },\n+      { x: 50, y: 100, inX: 50, inY: 100, outX: 50, outY: 100 },\n+    ]\n+    expect(pathD(points, true)).toBe('M 0 0 C 0 0 100 0 100 0 C 100 0 50 100 50 100 C 50 100 0 0 0 0 Z')\n+  })\n+\n+  it('pathD ne ferme jamais un tracé de seulement deux points (rien « entre » à boucler)', () => {\n+    const points = [{ x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 }, { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 }]\n+    expect(pathD(points, true)).not.toContain('Z')\n+  })\n+\n+  it('pathD rend une chaîne vide sous deux points : rien à tracer', () => {\n+    expect(pathD([{ x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 }], false)).toBe('')\n+    expect(pathD([], false)).toBe('')\n+  })\n+\n+  it('createPathLayer calcule la boîte englobante EN INCLUANT les poignées, jamais seulement les ancres', () => {\n+    // Ancres à (0,0) et (100,0), mais une poignée déborde jusqu'à y=-50 : la boîte doit la contenir.\n+    const points = [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 20, outY: -50 },\n+      { x: 100, y: 0, inX: 80, inY: -50, outX: 100, outY: 0 },\n+    ]\n+    let c = createPathLayer(vide(), points, false)\n+    const l = readLayers(c).find((x) => x.name === 'Tracé')\n+    expect(l.y).toBe(-50)\n+    expect(l.h).toBe(50)\n+  })\n+\n+  it('createPathLayer normalise les points en POURCENTAGE 0-100 de la boîte calculée', () => {\n+    const points = [{ x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 }, { x: 200, y: 100, inX: 200, inY: 100, outX: 200, outY: 100 }]\n+    let c = createPathLayer(vide(), points, false)\n+    const l = readLayers(c).find((x) => x.name === 'Tracé')\n+    expect(l.pathPoints[0]).toEqual({ x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 })\n+    expect(l.pathPoints[1]).toEqual({ x: 100, y: 100, inX: 100, inY: 100, outX: 100, outY: 100 })\n+  })\n+\n+  it('createPathLayer refuse un tracé de moins de deux points', () => {\n+    const c = vide()\n+    expect(createPathLayer(c, [{ x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 }], false)).toBe(c)\n+    expect(createPathLayer(c, [], false)).toBe(c)\n+  })\n+\n+  it('movePathAnchor déplace l’ancre ET ses deux poignées PAR LA MÊME TRANSLATION', () => {\n+    const points = [{ x: 10, y: 10, inX: 0, inY: 0, outX: 20, outY: 20 }]\n+    const suivant = movePathAnchor(points, 0, 15, 25)\n+    // Delta : +5 en x, +15 en y. Les poignées suivent exactement ce même déplacement.\n+    expect(suivant[0]).toEqual({ x: 15, y: 25, inX: 5, inY: 15, outX: 25, outY: 35 })\n+  })\n+\n+  it('movePathHandle déplace UNE SEULE poignée, sans toucher à l’autre ni à l’ancre', () => {\n+    const points = [{ x: 10, y: 10, inX: 0, inY: 0, outX: 20, outY: 20 }]\n+    const suivant = movePathHandle(points, 0, 'out', 50, 60)\n+    expect(suivant[0]).toEqual({ x: 10, y: 10, inX: 0, inY: 0, outX: 50, outY: 60 })\n+  })\n+\n+  it('removePathPoint retire un point, mais jamais sous deux points restants', () => {\n+    const points = [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n+      { x: 50, y: 50, inX: 50, inY: 50, outX: 50, outY: 50 },\n+      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },\n+    ]\n+    const deuxPoints = removePathPoint(points, 1)\n+    expect(deuxPoints).toHaveLength(2)\n+    const plancher = removePathPoint(deuxPoints, 0)\n+    expect(plancher).toBe(deuxPoints)   // refuse de descendre sous deux points\n+  })\n+\n+  it('insertPathPoint ajoute un point d’ANGLE (poignées confondues) juste après l’index donné', () => {\n+    const points = [{ x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 }, { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 }]\n+    const suivant = insertPathPoint(points, 0, 50, 30)\n+    expect(suivant).toHaveLength(3)\n+    expect(suivant[1]).toEqual({ x: 50, y: 30, inX: 50, inY: 30, outX: 50, outY: 30 })\n+  })\n+\n+  it('un point hors 0-100 est ramené dans les bornes à la relecture, jamais laissé libre', () => {\n+    let c = addLayer(vide(), 'shape', { pathPoints: [{ x: -10, y: 150, inX: 0, inY: 0, outX: 0, outY: 0 }, { x: 50, y: 50, inX: 50, inY: 50, outX: 50, outY: 50 }] })\n+    const l = readLayers(c)[0]\n+    expect(l.pathPoints[0].x).toBe(0)\n+    expect(l.pathPoints[0].y).toBe(100)\n+  })\n+\n+  it('le tracé compile en <svg><path> réel, avec le fond et le contour du calque', () => {\n+    let c = createPathLayer(vide(), [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n+      { x: 100, y: 100, inX: 100, inY: 100, outX: 100, outY: 100 },\n+    ], false)\n+    const tracé = readLayers(c).find((l) => l.name === 'Tracé')\n+    c = patchLayer(c, tracé.id, { style: { backgroundColor: '#ffcc00' } })\n+    const { html } = compiler(c)\n+    expect(html).toContain('<svg')\n+    expect(html).toContain('fill=\"#ffcc00\"')\n+    expect(html).toContain('stroke=\"#151515\"')\n+  })\n+\n+  it('un tracé SANS fond réglé ne peint aucune surface (fill=\"none\"), seulement son contour', () => {\n+    let c = createPathLayer(vide(), [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n+      { x: 100, y: 100, inX: 100, inY: 100, outX: 100, outY: 100 },\n+    ], false)\n+    const { html } = compiler(c)\n+    expect(html).toContain('fill=\"none\"')\n+  })\n+\n+  it('un tracé ne porte JAMAIS l’attribut data-shape : sa géométrie n’est pas une forme paramétrique', () => {\n+    let c = createPathLayer(vide(), [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n+      { x: 100, y: 100, inX: 100, inY: 100, outX: 100, outY: 100 },\n+    ], false)\n+    const tracé = readLayers(c).find((l) => l.name === 'Tracé')\n+    const { html } = compiler(c)\n+    const doc = new DOMParser().parseFromString(html, 'text/html')\n+    const el = doc.querySelector(`[data-zrm-layer=\"${tracé.id}\"]`)\n+    expect(el.hasAttribute('data-shape')).toBe(false)\n+  })\n+})\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"255bb7e6-b68d-4c5c-b91b-c6a1965e3c1d"}}}
