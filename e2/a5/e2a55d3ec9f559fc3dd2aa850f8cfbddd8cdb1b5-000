{"timestamp":"2026-08-05T16:24:18.446Z","ordinal":339,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd2bd-710e-7153-8c79-a9fbecc1de41","call_id":"call_uUBaTN96mv2xDKJ4viy9lgih","output":[{"type":"input_text","text":"Script completed\nWall time 0.0 seconds\nOutput:\n"},{"type":"input_text","text":"===== src/zenraymedia/contracts.js =====\n     1\t// ZenRayMedia — L0 : les six contrats de données.\n     2\t// Doc de référence : docs/zenraymedia/01-PLAN.md §5, docs/zenraymedia/04-WBS-COMPOSANTS.md L0.\n     3\t//\n     4\t// RÈGLE DURE (01-PLAN §5.5) : tout Job porte une `seed`. Aucun aléa non graine n'est autorisé\n     5\t// dans le produit -- sinon deux rendus du même contenu diffèrent et le pipeline n'est plus\n     6\t// réparable (risque R3 de 02-RISQUES). `Math.random()` est donc INTERDIT dans ce dossier :\n     7\t// on passe toujours par `rng(seed)` ci-dessous.\n     8\t\n     9\texport const REGISTERS = ['presse', 'créateur', 'institutionnel', 'luxe', 'technique', 'divertissement', 'pédagogique', 'promotionnel']\n    10\texport const INTENTS = ['informer', 'convaincre', 'vendre', 'émouvoir', 'enseigner', 'annoncer', 'documenter']\n    11\texport const BEAT_ROLES = ['hook', 'context', 'proof', 'demo', 'turn', 'payoff', 'cta']\n    12\texport const BEAT_TEMPOS = ['still', 'calm', 'drive', 'snap']\n    13\t\n    14\texport const ROLE_LABELS = {\n    15\t  hook: 'Accroche', context: 'Contexte', proof: 'Preuve', demo: 'Démonstration',\n    16\t  turn: 'Bascule', payoff: 'Chute', cta: 'Appel',\n    17\t}\n    18\t\n    19\t// --- Générateur déterministe (L0-10) -------------------------------------------------------\n    20\t// mulberry32 : même graine -> même suite, sur toutes les machines. Utilisé pour le grain, les\n    21\t// micro-décalages et tout choix \"aléatoire\" d'un thème.\n    22\texport function rng(seed) {\n    23\t  let a = (typeof seed === 'number' ? seed : hashString(String(seed ?? 'zenraymedia'))) >>> 0\n    24\t  return function next() {\n    25\t    a |= 0; a = (a + 0x6D2B79F5) | 0\n    26\t    let t = Math.imul(a ^ (a >>> 15), 1 | a)\n    27\t    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t\n    28\t    return ((t ^ (t >>> 14)) >>> 0) / 4294967296\n    29\t  }\n    30\t}\n    31\t\n    32\texport function hashString(str) {\n    33\t  let h = 2166136261 >>> 0\n    34\t  for (let i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = Math.imul(h, 16777619) }\n    35\t  return h >>> 0\n    36\t}\n    37\t\n    38\t// Identifiant stable et lisible, dérivé du contenu + d'un compteur fourni par l'appelant.\n    39\t// Volontairement SANS Date.now() : un id ne doit pas dépendre de l'heure de fabrication.\n    40\texport function makeId(prefix, seedText, counter = 0) {\n    41\t  return `${prefix}-${hashString(`${seedText}#${counter}`).toString(36).padStart(7, '0')}`\n    42\t}\n    43\t\n    44\t// --- Helpers de validation ------------------------------------------------------------------\n    45\tconst isStr = (v) => typeof v === 'string'\n    46\tconst nonEmpty = (v) => isStr(v) && v.trim().length > 0\n    47\tconst isArr = Array.isArray\n    48\t\n    49\t// Compte les phrases d'un texte. Sert la contrainte du message unique (WBS ZM-L2-02).\n    50\t// Les abréviations courantes ne comptent pas comme fin de phrase.\n    51\texport function sentenceCount(text) {\n    52\t  if (!nonEmpty(text)) return 0\n    53\t  const cleaned = String(text)\n    54\t    .replace(/\\b(M|Mme|Dr|etc|cf|ex|p|vs|Mr|St|n°|art)\\./gi, '$1')\n    55\t    .replace(/\\d+\\.\\d+/g, '0')\n    56\t  const parts = cleaned.split(/[.!?…]+(?:\\s|$)/).map((s) => s.trim()).filter(Boolean)\n    57\t  return parts.length\n    58\t}\n    59\t\n    60\t// --- 5.1 Brief --------------------------------------------------------------------------------\n    61\texport function emptyBrief() {\n    62\t  return {\n    63\t    id: '', title: '', message: '', audience: '', register: 'créateur', intent: 'informer',\n    64\t    evidence: [], constraints: { languages: ['fr'], maxDuration: null, mentions: [] }, sources: [],\n    65\t  }\n    66\t}\n    67\t\n    68\texport function validateBrief(brief) {\n    69\t  const errors = []\n    70\t  if (!brief || typeof brief !== 'object') return [{ field: 'brief', code: 'shape', message: 'Brief absent.' }]\n    71\t  if (!nonEmpty(brief.title)) errors.push({ field: 'title', code: 'required', message: 'Le titre de travail est obligatoire.' })\n    72\t  if (!nonEmpty(brief.message)) errors.push({ field: 'message', code: 'required', message: 'Le message est obligatoire : une phrase, celle que le public doit retenir.' })\n    73\t  // ZM-L2-02 : REFUS explicite, pas un avertissement.\n    74\t  else if (sentenceCount(brief.message) > 1) errors.push({ field: 'message', code: 'single-sentence', message: `Le message doit tenir en UNE phrase (${sentenceCount(brief.message)} détectées). Choisis celle qui compte.` })\n    75\t  if (!nonEmpty(brief.audience)) errors.push({ field: 'audience', code: 'required', message: 'Le public est obligatoire : à qui parles-tu, en clair ?' })\n    76\t  if (!REGISTERS.includes(brief.register)) errors.push({ field: 'register', code: 'enum', message: 'Registre inconnu.' })\n    77\t  if (!INTENTS.includes(brief.intent)) errors.push({ field: 'intent', code: 'enum', message: 'Intention inconnue.' })\n    78\t  if (brief.evidence && !isArr(brief.evidence)) errors.push({ field: 'evidence', code: 'shape', message: 'Les preuves doivent former une liste.' })\n    79\t  return errors\n    80\t}\n    81\t\n    82\t// --- 5.2 Cut ----------------------------------------------------------------------------------\n    83\texport function validateCut(cut) {\n    84\t  const errors = []\n    85\t  if (!cut || typeof cut !== 'object') return [{ field: 'cut', code: 'shape', message: 'Cut absent.' }]\n    86\t  if (!nonEmpty(cut.briefId)) errors.push({ field: 'briefId', code: 'required', message: 'Le cut doit référencer un brief.' })\n    87\t  if (!isArr(cut.beats) || cut.beats.length === 0) {\n    88\t    errors.push({ field: 'beats', code: 'required', message: 'Un cut contient au moins un beat.' })\n    89\t    return errors\n    90\t  }\n    91\t  cut.beats.forEach((beat, i) => {\n    92\t    if (!BEAT_ROLES.includes(beat?.role)) errors.push({ field: `beats[${i}].role`, code: 'enum', message: `Beat ${i + 1} : rôle manquant ou inconnu.` })\n    93\t    if (!nonEmpty(beat?.text)) errors.push({ field: `beats[${i}].text`, code: 'required', message: `Beat ${i + 1} : texte vide.` })\n    94\t    if (beat?.weight != null && (typeof beat.weight !== 'number' || beat.weight < 0 || beat.weight > 1)) errors.push({ field: `beats[${i}].weight`, code: 'range', message: `Beat ${i + 1} : le poids doit être compris entre 0 et 1.` })\n    95\t    if (beat?.tempo && !BEAT_TEMPOS.includes(beat.tempo)) errors.push({ field: `beats[${i}].tempo`, code: 'enum', message: `Beat ${i + 1} : tempo inconnu.` })\n    96\t    if (beat?.slots && !isArr(beat.slots)) errors.push({ field: `beats[${i}].slots`, code: 'shape', message: `Beat ${i + 1} : les emplacements doivent former une liste.` })\n    97\t    if (isArr(beat?.slots) && beat.slots.length > 4) errors.push({ field: `beats[${i}].slots`, code: 'range', message: `Beat ${i + 1} : 4 emplacements média au maximum.` })\n    98\t  })\n    99\t  return errors\n   100\t}\n   101\t\n   102\t// --- 5.3 Theme --------------------------------------------------------------------------------\n   103\t// Les 7 groupes de décisions (01-PLAN §10.2). `surface`, `palette`, `typography`, `grid` sont\n   104\t// obligatoires ; `motion`, `chrome`, `sound` ont des valeurs par défaut (un thème d'article n'a\n   105\t// pas besoin de mouvement ni de son pour être valide).\n   106\texport const THEME_GROUPS = ['surface', 'palette', 'typography', 'grid', 'motion', 'chrome', 'sound']\n   107\t\n   108\texport function validateTheme(theme) {\n   109\t  const errors = []\n   110\t  if (!theme || typeof theme !== 'object') return [{ field: 'theme', code: 'shape', message: 'Thème absent.' }]\n   111\t  if (!/^T-\\d{2}-\\d-\\d$/.test(theme.id || '')) errors.push({ field: 'id', code: 'format', message: 'Identifiant attendu : T-FF-S-V (ex. T-01-3-2).' })\n   112\t  if (!nonEmpty(theme.name)) errors.push({ field: 'name', code: 'required', message: 'Le nom public du thème est obligatoire.' })\n   113\t  for (const group of ['surface', 'palette', 'typography', 'grid']) {\n   114\t    if (!theme[group] || typeof theme[group] !== 'object') errors.push({ field: group, code: 'required', message: `Groupe « ${group} » manquant.` })\n   115\t  }\n   116\t  if (theme.typography && !theme.typography.scale) errors.push({ field: 'typography.scale', code: 'required', message: 'Le thème doit poser son échelle typographique.' })\n   117\t  if (!isArr(theme.formats) || theme.formats.length === 0) errors.push({ field: 'formats', code: 'required', message: 'Le thème doit déclarer au moins un format natif.' })\n   118\t  // ZM-L4-16 : le calibrage est PRIVÉ. Un thème qui l'expose dans un champ public est refusé.\n   119\t  const publicText = `${theme.name || ''} ${theme.description || ''}`.toLowerCase()\n   120\t  const marks = ['bfm', 'carrefour', 'squeezie', 'playstation', 'weta', 'le monde', 'netflix', 'vogue', 'lidl']\n   121\t  const leaked = marks.filter((m) => publicText.includes(m))\n   122\t  if (leaked.length) errors.push({ field: 'name', code: 'trademark', message: `Marque déposée dans un champ public : ${leaked.join(', ')}. Le calibrage vit dans calibration.ref, jamais dans le nom.` })\n   123\t  return errors\n   124\t}\n   125\t\n   126\t// --- 5.4 Format --------------------------------------------------------------------------------\n   127\texport const FORMAT_KINDS = ['web', 'still', 'print', 'video', 'overlay']\n   128\t\n   129\texport function validateFormat(format) {\n   130\t  const errors = []\n   131\t  if (!format || typeof format !== 'object') return [{ field: 'format', code: 'shape', message: 'Format absent.' }]\n   132\t  if (!nonEmpty(format.id)) errors.push({ field: 'id', code: 'required', message: 'Identifiant de format manquant.' })\n   133\t  if (!FORMAT_KINDS.includes(format.kind)) errors.push({ field: 'kind', code: 'enum', message: 'Type de format inconnu.' })\n   134\t  const c = format.canvas\n   135\t  // Une page web n'a PAS de hauteur : le contenu coule. `h:0` y est donc légal et volontaire.\n   136\t  // Tout autre type de format (image, print, vidéo) doit poser ses deux dimensions.\n   137\t  if (!c || !(c.w > 0)) errors.push({ field: 'canvas', code: 'required', message: 'Largeur de sortie manquante.' })\n   138\t  else if (format.kind !== 'web' && !(c.h > 0)) errors.push({ field: 'canvas', code: 'required', message: `Hauteur de sortie manquante (obligatoire pour un format « ${format.kind} »).` })\n   139\t  if (['video', 'overlay'].includes(format.kind) && !(format.time?.fps > 0)) errors.push({ field: 'time.fps', code: 'required', message: 'Un format temporel doit poser ses images par seconde.' })\n   140\t  return errors\n   141\t}\n   142\t\n   143\t// --- 5.5 Job -----------------------------------------------------------------------------------\n   144\texport function validateJob(job) {\n   145\t  const errors = []\n   146\t  if (!job || typeof job !== 'object') return [{ field: 'job', code: 'shape', message: 'Job absent.' }]\n   147\t  if (!nonEmpty(job.cutId)) errors.push({ field: 'cutId', code: 'required', message: 'Job sans cut.' })\n   148\t  if (!nonEmpty(job.themeId)) errors.push({ field: 'themeId', code: 'required', message: 'Job sans thème.' })\n   149\t  if (!nonEmpty(job.formatId)) errors.push({ field: 'formatId', code: 'required', message: 'Job sans format.' })\n   150\t  // RÈGLE DURE : pas de seed, pas de job. C'est ce qui rend un rendu rejouable.\n   151\t  if (job.seed == null || job.seed === '') errors.push({ field: 'seed', code: 'required', message: 'Job sans graine : le rendu ne serait pas reproductible.' })\n   152\t  return errors\n   153\t}\n   154\t\n   155\t// --- 5.6 Deliverable ----------------------------------------------------------------------------\n   156\texport function validateDeliverable(deliverable) {\n   157\t  const errors = []\n   158\t  if (!deliverable || typeof deliverable !== 'object') return [{ field: 'deliverable', code: 'shape', message: 'Livrable absent.' }]\n   159\t  if (!nonEmpty(deliverable.jobId)) errors.push({ field: 'jobId', code: 'required', message: 'Livrable orphelin.' })\n   160\t  if (!(deliverable.bytes > 0)) errors.push({ field: 'bytes', code: 'required', message: 'Livrable vide.' })\n   161\t  // Un livrable sans empreinte ni sonde est « non vérifié » : il ne peut pas être déclaré fini.\n   162\t  if (!nonEmpty(deliverable.checksum)) errors.push({ field: 'checksum', code: 'required', message: 'Livrable sans empreinte : non vérifiable.' })\n   163\t  if (!deliverable.probe) errors.push({ field: 'probe', code: 'required', message: 'Livrable sans sonde : non vérifié.' })\n   164\t  return errors\n   165\t}\n   166\t\n   167\t// --- L0-07 : validateur unique ---------------------------------------------------------------\n   168\t// Un SEUL point d'entrée. Aucune validation ne doit être dupliquée ailleurs dans le produit.\n   169\tconst VALIDATORS = {\n   170\t  brief: validateBrief, cut: validateCut, theme: validateTheme,\n   171\t  format: validateFormat, job: validateJob, deliverable: validateDeliverable,\n   172\t}\n   173\t\n   174\texport function validate(kind, value) {\n   175\t  const fn = VALIDATORS[kind]\n   176\t  if (!fn) throw new Error(`validate: contrat inconnu « ${kind} »`)\n   177\t  return fn(value)\n   178\t}\n   179\t\n   180\texport function isValid(kind, value) { return validate(kind, value).length === 0 }\n   181\t\n   182\t// Empreinte de contenu, pour les livrables produits côté navigateur (pas de crypto asynchrone\n   183\t// nécessaire, on veut une signature stable et rapide, pas une garantie cryptographique).\n   184\texport function checksumOf(text) {\n   185\t  const s = String(text)\n   186\t  return `zrm1-${hashString(s).toString(16)}-${s.length.toString(16)}`\n   187\t}\n"},{"type":"input_text","text":"===== src/zenraymedia/formats.js =====\n     1\t// ZenRayMedia — L5 : les contrats de sortie.\n     2\t// Doc : 01-PLAN.md §5.4 + §7. Un format ne décrit JAMAIS un style : uniquement la boîte\n     3\t// (dimensions, densité, durée, zones de sécurité, spécification de livraison).\n     4\t\n     5\t// `fit` : ce qu'un format AFFICHE du cut.\n     6\t//   mode 'full'   -> titre + message + TOUS les blocs. Pour ce qui se lit (article, A4).\n     7\t//   mode 'poster' -> titre + message + `maxBeats` blocs au maximum. Pour ce qui se REGARDE.\n     8\t// Raison (bug signalé par Matthieu le 2026-07-25, « énormément de bugs sur tous les formats ») :\n     9\t// un article de 5 blocs ne rentre PAS sur un carré 1080 à taille lisible, et aucun réglage ne\n    10\t// l'y fera rentrer. Ce n'était pas un défaut de rendu, c'était un défaut de doctrine : personne\n    11\t// ne met 900 mots sur une image sociale. Le format décide de ce qu'il montre ; le Critique\n    12\t// signale ce qui a été laissé de côté, pour que rien ne disparaisse en silence.\n    13\t//\n    14\t// `density` : multiplicateur appliqué à TOUTE valeur typographique et d'espacement du thème.\n    15\t// Sans lui, un corps de 19 px posé sur un canevas A4 de 2480 px de large donnait un texte\n    16\t// illisible (bug réel signalé par Matthieu le 2026-07-25) : le compilateur ignorait le `dpi`.\n    17\t// Un thème décrit des proportions ; c'est le FORMAT qui décide de l'échelle physique.\n    18\texport const FORMATS = [\n    19\t  {\n    20\t    id: 'F-web-article', fit: { mode: 'full', maxBeats: Infinity }, density: 1 /* l'écran est la référence : 1 px CSS = 1 px */, kind: 'web', label: 'libre · 820', short: '820',\n    21\t    canvas: { w: 820, h: 0, dpi: 72 }, // h:0 = hauteur libre (le contenu décide)\n    22\t    color: 'sRGB', measure: 68,\n    23\t    delivery: { container: 'html', maxBytes: 2_000_000 },\n    24\t    overflow: 'flow', // le texte coule, il ne peut pas déborder\n    25\t  },\n    26\t  {\n    27\t    id: 'F-still-1080-square', fit: { mode: 'poster', maxBeats: 1 }, density: 1.7 /* lisible en vignette de fil social */, kind: 'still', label: '1:1 · 1080', short: '1:1',\n    28\t    canvas: { w: 1080, h: 1080, dpi: 72 }, color: 'sRGB', measure: 34,\n    29\t    safe: { top: 48, bottom: 48, sides: 48 },\n    30\t    delivery: { container: 'png', maxBytes: 8_000_000 },\n    31\t    overflow: 'shrink',\n    32\t  },\n    33\t  {\n    34\t    id: 'F-still-1080x1350', fit: { mode: 'poster', maxBeats: 2 }, density: 1.7 /* lisible en vignette de fil social */, kind: 'still', label: '4:5 · 1080×1350', short: '4:5',\n    35\t    canvas: { w: 1080, h: 1350, dpi: 72 }, color: 'sRGB', measure: 34,\n    36\t    safe: { top: 60, bottom: 60, sides: 54 },\n    37\t    delivery: { container: 'png', maxBytes: 8_000_000 },\n    38\t    overflow: 'shrink',\n    39\t  },\n    40\t  {\n    41\t    id: 'F-still-1080x1920', fit: { mode: 'poster', maxBeats: 2 }, density: 1.7 /* lisible sur un écran de téléphone tenu à bout de bras */, kind: 'still', label: '9:16 · 1080×1920', short: '9:16',\n    42\t    canvas: { w: 1080, h: 1920, dpi: 72 }, color: 'sRGB', measure: 30,\n    43\t    // Zones d'interface réelles des plateformes verticales : haut (profil/son),\n    44\t    // bas (légende, boutons). Le Critique refuse tout texte qui entre dedans.\n    45\t    safe: { top: 220, bottom: 320, sides: 64 },\n    46\t    delivery: { container: 'png', maxBytes: 8_000_000 },\n    47\t    overflow: 'shrink',\n    48\t  },\n    49\t  {\n    50\t    id: 'F-print-a4', fit: { mode: 'full', maxBeats: Infinity }, density: 3.125 /* 300 dpi / 96 dpi de référence CSS -> corps ~14 pt réels */, kind: 'print', label: 'A4 · 2480×3508', short: 'A4',\n    51\t    canvas: { w: 2480, h: 3508, dpi: 300 }, color: 'sRGB', measure: 66,\n    52\t    bleedMm: 3, safe: { top: 118, bottom: 118, sides: 118 },\n    53\t    delivery: { container: 'pdf', maxBytes: 30_000_000 },\n    54\t    overflow: 'paginate',\n    55\t  },\n    56\t  {\n    57\t    id: 'F-video-1920x1080', fit: { mode: 'poster', maxBeats: 1 }, density: 1.6 /* lisible à 2 m d'un téléviseur */, kind: 'video', label: '16:9 · 1920×1080', short: '16:9',\n    58\t    canvas: { w: 1920, h: 1080, dpi: 72 }, color: 'sRGB', measure: 40,\n    59\t    time: { fps: 30, target: 30, min: 10, max: 90 },\n    60\t    safe: { top: 54, bottom: 54, sides: 96 },\n    61\t    // hvc1 : règle dure du projet (registre d'erreurs 2026-07-05, HEVC illisible sur iPhone sans ce tag).\n    62\t    delivery: { container: 'mp4', codec: 'hevc_videotoolbox', tag: 'hvc1', pixfmt: 'yuv420p', maxBytes: 200_000_000 },\n    63\t    overflow: 'shrink',\n    64\t  },\n    65\t  {\n    66\t    id: 'F-overlay-1920x1080', fit: { mode: 'poster', maxBeats: 1 }, density: 1.6 /* même échelle que la vidéo qu'il habille */, kind: 'overlay', label: '16:9 α · 1920×1080', short: 'α',\n    67\t    canvas: { w: 1920, h: 1080, dpi: 72 }, color: 'sRGB', measure: 40,\n    68\t    time: { fps: 30, target: 10, min: 2, max: 60 },\n    69\t    safe: { top: 54, bottom: 54, sides: 96 },\n    70\t    // prores_ks + yuva444p10le : VÉRIFIÉ disponible sur cette machine (ffmpeg 8.1.1).\n    71\t    // prores_videotoolbox n'est PAS utilisé ici : son support alpha n'a pas été mesuré (01-PLAN Q4).\n    72\t    delivery: { container: 'mov', codec: 'prores_ks', profile: 4, pixfmt: 'yuva444p10le', maxBytes: 4_000_000_000 },\n    73\t    overflow: 'shrink',\n    74\t    transparent: true,\n    75\t  },\n    76\t  // ═══ LES FORMATS DU WEB, AJOUTÉS LE 2026-08-04 ════════════════════════════════════════════════\n    77\t  //\n    78\t  // « Il faut qu'il y ait tous les formats du web possibles. » La liste s'arrêtait à sept, dont\n    79\t  // deux d'impression et de vidéo : elle couvrait ce que le produit savait faire, pas ce qu'on lui\n    80\t  // demande. Les vingt suivants sont ceux qui reviennent réellement, du partage social aux pavés\n    81\t  // publicitaires normalisés par l'IAB.\n    82\t  //\n    83\t  // TROIS RÈGLES tenues pour tous, afin qu'aucun ne soit posé au jugé.\n    84\t  //   `density` suit la largeur : une bannière de 320 px doit porter un corps de texte lisible à\n    85\t  //   la même distance qu'un 1920, donc son échelle typographique monte quand sa boîte descend.\n    86\t  //   `measure` suit aussi la largeur, en signes par ligne, plancher à 18 : sous ce seuil un texte\n    87\t  //   ne se lit plus, il se déchiffre.\n    88\t  //   `fit` passe en 'poster' à une seule idée dès que la boîte est plus large que haute et petite :\n    89\t  //   personne ne met un article dans un pavé de 728 sur 90.\n    90\t  { id: 'F-web-og', fit: { mode: 'poster', maxBeats: 1 }, density: 1.35, kind: 'still', label: '1.91:1 · 1200×630', short: 'OG',\n    91\t    canvas: { w: 1200, h: 630, dpi: 72 }, color: 'sRGB', measure: 44, safe: { top: 40, bottom: 40, sides: 56 },\n    92\t    delivery: { container: 'png', maxBytes: 8_000_000 }, overflow: 'shrink' },\n    93\t  { id: 'F-web-720p', fit: { mode: 'poster', maxBeats: 1 }, density: 1.35, kind: 'still', label: '16:9 · 1280×720', short: '720p',\n    94\t    canvas: { w: 1280, h: 720, dpi: 72 }, color: 'sRGB', measure: 44, safe: { top: 40, bottom: 40, sides: 64 },\n    95\t    delivery: { container: 'png', maxBytes: 8_000_000 }, overflow: 'shrink' },\n    96\t  { id: 'F-web-1440p', fit: { mode: 'poster', maxBeats: 2 }, density: 1.9, kind: 'still', label: '16:9 · 2560×1440', short: '1440p',\n    97\t    canvas: { w: 2560, h: 1440, dpi: 72 }, color: 'sRGB', measure: 52, safe: { top: 72, bottom: 72, sides: 128 },\n    98\t    delivery: { container: 'png', maxBytes: 12_000_000 }, overflow: 'shrink' },\n    99\t  { id: 'F-web-2160p', fit: { mode: 'poster', maxBeats: 2 }, density: 2.6, kind: 'still', label: '16:9 · 3840×2160', short: '2160p',\n   100\t    canvas: { w: 3840, h: 2160, dpi: 72 }, color: 'sRGB', measure: 56, safe: { top: 108, bottom: 108, sides: 192 },\n   101\t    delivery: { container: 'png', maxBytes: 16_000_000 }, overflow: 'shrink' },\n   102\t  { id: 'F-social-1200', fit: { mode: 'poster', maxBeats: 1 }, density: 1.8, kind: 'still', label: '1:1 · 1200', short: '1:1+',\n   103\t    canvas: { w: 1200, h: 1200, dpi: 72 }, color: 'sRGB', measure: 34, safe: { top: 56, bottom: 56, sides: 56 },\n   104\t    delivery: { container: 'png', maxBytes: 8_000_000 }, overflow: 'shrink' },\n   105\t  { id: 'F-social-2x3', fit: { mode: 'poster', maxBeats: 2 }, density: 1.7, kind: 'still', label: '2:3 · 1000×1500', short: '2:3',\n   106\t    canvas: { w: 1000, h: 1500, dpi: 72 }, color: 'sRGB', measure: 32, safe: { top: 60, bottom: 60, sides: 50 },\n   107\t    delivery: { container: 'png', maxBytes: 8_000_000 }, overflow: 'shrink' },\n   108\t  { id: 'F-social-3x4', fit: { mode: 'poster', maxBeats: 2 }, density: 1.7, kind: 'still', label: '3:4 · 1080×1440', short: '3:4',\n   109\t    canvas: { w: 1080, h: 1440, dpi: 72 }, color: 'sRGB', measure: 32, safe: { top: 60, bottom: 60, sides: 54 },\n   110\t    delivery: { container: 'png', maxBytes: 8_000_000 }, overflow: 'shrink' },\n   111\t  { id: 'F-header-3x1', fit: { mode: 'poster', maxBeats: 1 }, density: 1.5, kind: 'still', label: '3:1 · 1500×500', short: '3:1',\n   112\t    canvas: { w: 1500, h: 500, dpi: 72 }, color: 'sRGB', measure: 44, safe: { top: 32, bottom: 32, sides: 72 },\n   113\t    delivery: { container: 'png', maxBytes: 8_000_000 }, overflow: 'shrink' },\n   114\t  { id: 'F-header-4x1', fit: { mode: 'poster', maxBeats: 1 }, density: 1.4, kind: 'still', label: '4:1 · 1584×396', short: '4:1',\n   115\t    canvas: { w: 1584, h: 396, dpi: 72 }, color: 'sRGB', measure: 46, safe: { top: 28, bottom: 28, sides: 80 },\n   116\t    delivery: { container: 'png', maxBytes: 8_000_000 }, overflow: 'shrink' },\n   117\t  { id: 'F-header-2x1', fit: { mode: 'poster', maxBeats: 1 }, density: 1.3, kind: 'still', label: '2.7:1 · 851×315', short: '2.7:1',\n   118\t    canvas: { w: 851, h: 315, dpi: 72 }, color: 'sRGB', measure: 38, safe: { top: 24, bottom: 24, sides: 40 },\n   119\t    delivery: { container: 'png', maxBytes: 8_000_000 }, overflow: 'shrink' },\n   120\t  { id: 'F-ad-mpu', fit: { mode: 'poster', maxBeats: 1 }, density: 1.05, kind: 'still', label: '6:5 · 300×250', short: 'MPU',\n   121\t    canvas: { w: 300, h: 250, dpi: 72 }, color: 'sRGB', measure: 22, safe: { top: 12, bottom: 12, sides: 14 },\n   122\t    delivery: { container: 'png', maxBytes: 200_000 }, overflow: 'shrink' },\n   123\t  { id: 'F-ad-leaderboard', fit: { mode: 'poster', maxBeats: 1 }, density: 1, kind: 'still', label: '8:1 · 728×90', short: '728',\n   124\t    canvas: { w: 728, h: 90, dpi: 72 }, color: 'sRGB', measure: 30, safe: { top: 8, bottom: 8, sides: 16 },\n   125\t    delivery: { container: 'png', maxBytes: 200_000 }, overflow: 'shrink' },\n   126\t  { id: 'F-ad-billboard', fit: { mode: 'poster', maxBeats: 1 }, density: 1.25, kind: 'still', label: '3.9:1 · 970×250', short: '970',\n   127\t    canvas: { w: 970, h: 250, dpi: 72 }, color: 'sRGB', measure: 36, safe: { top: 16, bottom: 16, sides: 28 },\n   128\t    delivery: { container: 'png', maxBytes: 300_000 }, overflow: 'shrink' },\n   129\t  { id: 'F-ad-skyscraper', fit: { mode: 'poster', maxBeats: 2 }, density: 1, kind: 'still', label: '4:15 · 160×600', short: '160',\n   130\t    canvas: { w: 160, h: 600, dpi: 72 }, color: 'sRGB', measure: 18, safe: { top: 14, bottom: 14, sides: 8 },\n   131\t    delivery: { container: 'png', maxBytes: 200_000 }, overflow: 'shrink' },\n   132\t  { id: 'F-ad-halfpage', fit: { mode: 'poster', maxBeats: 2 }, density: 1.1, kind: 'still', label: '1:2 · 300×600', short: '300',\n   133\t    canvas: { w: 300, h: 600, dpi: 72 }, color: 'sRGB', measure: 22, safe: { top: 16, bottom: 16, sides: 14 },\n   134\t    delivery: { container: 'png', maxBytes: 250_000 }, overflow: 'shrink' },\n   135\t  { id: 'F-ad-mobile', fit: { mode: 'poster', maxBeats: 1 }, density: 1, kind: 'still', label: '6.4:1 · 320×50', short: '320',\n   136\t    canvas: { w: 320, h: 50, dpi: 72 }, color: 'sRGB', measure: 20, safe: { top: 5, bottom: 5, sides: 8 },\n   137\t    delivery: { container: 'png', maxBytes: 150_000 }, overflow: 'shrink' },\n   138\t  { id: 'F-print-a5', fit: { mode: 'full', maxBeats: Infinity }, density: 3.125, kind: 'print', label: 'A5 · 1748×2480', short: 'A5',\n   139\t    canvas: { w: 1748, h: 2480, dpi: 300 }, color: 'sRGB', measure: 58, safe: { top: 150, bottom: 150, sides: 130 },\n   140\t    delivery: { container: 'pdf', maxBytes: 20_000_000 }, overflow: 'shrink' },\n   141\t  { id: 'F-print-a3', fit: { mode: 'full', maxBeats: Infinity }, density: 3.125, kind: 'print', label: 'A3 · 3508×4961', short: 'A3',\n   142\t    canvas: { w: 3508, h: 4961, dpi: 300 }, color: 'sRGB', measure: 72, safe: { top: 260, bottom: 260, sides: 220 },\n   143\t    delivery: { container: 'pdf', maxBytes: 40_000_000 }, overflow: 'shrink' },\n   144\t  { id: 'F-web-wide', fit: { mode: 'full', maxBeats: Infinity }, density: 1, kind: 'web', label: 'libre · 1280', short: '1280',\n   145\t    canvas: { w: 1280, h: 0, dpi: 72 }, color: 'sRGB', measure: 84,\n   146\t    delivery: { container: 'html', maxBytes: 2_000_000 }, overflow: 'flow' },\n   147\t  { id: 'F-web-narrow', fit: { mode: 'full', maxBeats: Infinity }, density: 1, kind: 'web', label: 'libre · 600', short: '600',\n   148\t    canvas: { w: 600, h: 0, dpi: 72 }, color: 'sRGB', measure: 52,\n   149\t    delivery: { container: 'html', maxBytes: 2_000_000 }, overflow: 'flow' },\n   150\t]\n   151\t\n   152\texport const FORMATS_BY_ID = Object.fromEntries(FORMATS.map((f) => [f.id, f]))\n   153\t\n   154\texport function getFormat(id) { return FORMATS_BY_ID[id] || FORMATS[0] }\n   155\t\n   156\texport function isTemporal(format) { return format?.kind === 'video' || format?.kind === 'overlay' }\n   157\t\n   158\t// Ratio d'affichage du Stage. Un format web n'a pas de hauteur fixe : on rend une page qui coule.\n   159\texport function aspectOf(format) {\n   160\t  if (!format?.canvas?.h) return null\n   161\t  return format.canvas.w / format.canvas.h\n   162\t}\n   163\t\n   164\t// Durée totale d'un cut pour un format temporel : somme des durées de beats, bornée par le format.\n   165\texport function durationOf(cut, format) {\n   166\t  if (!isTemporal(format)) return 0\n   167\t  const raw = (cut?.beats || []).reduce((sum, b) => sum + beatDuration(b), 0)\n   168\t  const { min, max } = format.time\n   169\t  return Math.min(max, Math.max(min, Math.round(raw * 10) / 10))\n   170\t}\n   171\t\n   172\t// Durée d'un beat : le tempo donne la base, le poids module. Déterministe, aucune part d'aléa.\n   173\tconst TEMPO_BASE = { still: 4, calm: 3, drive: 2, snap: 1.2 }\n   174\t\n   175\texport function beatDuration(beat) {\n   176\t  const base = TEMPO_BASE[beat?.tempo] ?? TEMPO_BASE.calm\n   177\t  const weight = typeof beat?.weight === 'number' ? beat.weight : 0.5\n   178\t  return Math.round(base * (0.7 + weight * 0.6) * 10) / 10\n   179\t}\n"},{"type":"input_text","text":"===== src/zenraymedia/composition.js =====\n     1\t// ZenRayMedia — modèle de composition Lego.\n     2\t// Une ligne empile verticalement ; ses éléments partagent l'espace horizontal et se replient\n     3\t// automatiquement au rendu. Le modèle ne dépend ni du DOM ni de l'horloge : il reste testable,\n     4\t// sérialisable dans .zmedia.json et strictement reproductible.\n     5\t\n     6\timport { makeId } from './contracts.js'\n     7\t\n     8\texport const COMPOSITION_VERSION = 1\n     9\texport const PLACEMENTS = ['above', 'below', 'left', 'right']\n    10\t\n    11\texport function emptyComposition(themeId) {\n    12\t  return { v: COMPOSITION_VERSION, themeId, serial: 0, rows: [] }\n    13\t}\n    14\t\n    15\texport function normalizeComposition(value, themeId) {\n    16\t  if (!value || value.themeId !== themeId || !Array.isArray(value.rows)) return emptyComposition(themeId)\n    17\t  // ON CONSERVE L'INCONNU AU LIEU DE LE RECONSTRUIRE (inversion de doctrine, 2026-08-01, carte C1).\n    18\t  //\n    19\t  // Cette fonction rendait un littéral à quatre clefs, et elle est appelée en tête de `insertItem`,\n    20\t  // `addComponent`, `addImage`, `removeItem`, `moveItem`, `patchItem`, `duplicateItem`, plus deux\n    21\t  // fois dans `MediaApp.jsx`. Toute clef qu'elle ne connaissait pas mourait donc au premier GESTE,\n    22\t  // en mémoire, sans qu'aucun rechargement soit en cause : un champ `timeline` ou une propriété de\n    23\t  // disposition posée sur une ligne ne survivait pas à un simple déplacement d'élément.\n    24\t  //\n    25\t  // Le contrat s'ouvre ICI, UNE seule fois, et plus jamais en V1. L'ouvrir une seconde fois pour\n    26\t  // une carte ultérieure serait un coût inutile et un second risque de régression sur des documents\n    27\t  // déjà enregistrés.\n    28\t  //\n    29\t  // La permissivité a son revers, et il est gardé par des tests dans les DEUX sens : ce qui est\n    30\t  // légitime survit, et une composition dont le thème ou les rangées sont invalides repart vide.\n    31\t  return {\n    32\t    ...value,\n    33\t    v: COMPOSITION_VERSION,\n    34\t    themeId,\n    35\t    serial: Number.isFinite(value.serial) ? value.serial : 0,\n    36\t    rows: value.rows\n    37\t      .filter((row) => row && Array.isArray(row.items))\n    38\t      .map((row, ri) => ({\n    39\t        ...row,\n    40\t        id: row.id || makeId('row', themeId, ri),\n    41\t        items: row.items.filter(Boolean).map((item) => ({\n    42\t          hidden: false,\n    43\t          locked: false,\n    44\t          props: {},\n    45\t          ...item,\n    46\t        })),\n    47\t      }))\n    48\t      .filter((row) => row.items.length),\n    49\t  }\n    50\t}\n    51\t\n    52\tfunction allocate(composition, prefix, salt) {\n    53\t  const serial = composition.serial + 1\n    54\t  return { id: makeId(prefix, `${composition.themeId}:${salt}`, serial), serial }\n    55\t}\n    56\t\n    57\texport function componentInstance(composition, component) {\n    58\t  const next = allocate(composition, 'cmp', component.id)\n    59\t  return {\n    60\t    serial: next.serial,\n    61\t    item: {\n    62\t      id: next.id,\n    63\t      kind: 'component',\n    64\t      themeId: composition.themeId,\n    65\t      componentId: component.id,\n    66\t      name: component.name,\n    67\t      group: component.group,\n    68\t      hidden: false,\n    69\t      locked: false,\n    70\t      props: {},\n    71\t    },\n    72\t  }\n    73\t}\n    74\t\n    75\texport function imageInstance(composition, image) {\n    76\t  const next = allocate(composition, 'img', image.path || image.name)\n    77\t  return {\n    78\t    serial: next.serial,\n    79\t    item: {\n    80\t      id: next.id,\n    81\t      kind: 'image',\n    82\t      name: image.name || 'Image',\n    83\t      refPath: image.path || null,\n    84\t      url: image.url || '',\n    85\t      hidden: false,\n    86\t      locked: false,\n    87\t      props: { fit: 'cover', radius: 18, ratio: '16 / 9' },\n    88\t    },\n    89\t  }\n    90\t}\n    91\t\n    92\tfunction locate(rows, itemId) {\n    93\t  for (let rowIndex = 0; rowIndex < rows.length; rowIndex += 1) {\n    94\t    const itemIndex = rows[rowIndex].items.findIndex((item) => item.id === itemId)\n    95\t    if (itemIndex >= 0) return { rowIndex, itemIndex }\n    96\t  }\n    97\t  return null\n    98\t}\n    99\t\n   100\tfunction newRow(composition, item, serial) {\n   101\t  return { id: makeId('row', `${composition.themeId}:${item.id}`, serial), items: [item] }\n   102\t}\n   103\t\n   104\texport function insertItem(value, item, targetId = null, placement = 'below', serial = value.serial) {\n   105\t  const composition = normalizeComposition(value, value.themeId)\n   106\t  const rows = composition.rows.map((row) => ({ ...row, items: [...row.items] }))\n   107\t  const target = targetId ? locate(rows, targetId) : null\n   108\t\n   109\t  if (!target) {\n   110\t    rows.push(newRow(composition, item, serial))\n   111\t  } else if (placement === 'left' || placement === 'right') {\n   112\t    rows[target.rowIndex].items.splice(target.itemIndex + (placement === 'right' ? 1 : 0), 0, item)\n   113\t  } else {\n   114\t    rows.splice(target.rowIndex + (placement === 'below' ? 1 : 0), 0, newRow(composition, item, serial))\n   115\t  }\n   116\t  return { ...composition, serial: Math.max(composition.serial, serial), rows }\n   117\t}\n   118\t\n   119\texport function addComponent(value, component, targetId = null, placement = 'below') {\n   120\t  const composition = normalizeComposition(value, value.themeId)\n   121\t  const created = componentInstance(composition, component)\n   122\t  return insertItem(composition, created.item, targetId, placement, created.serial)\n   123\t}\n   124\t\n   125\texport function addImage(value, image, targetId = null, placement = 'below') {\n   126\t  const composition = normalizeComposition(value, value.themeId)\n   127\t  const created = imageInstance(composition, image)\n   128\t  return insertItem(composition, created.item, targetId, placement, created.serial)\n   129\t}\n   130\t\n   131\texport function removeItem(value, itemId) {\n   132\t  const composition = normalizeComposition(value, value.themeId)\n   133\t  return {\n   134\t    ...composition,\n   135\t    rows: composition.rows\n   136\t      .map((row) => ({ ...row, items: row.items.filter((item) => item.id !== itemId) }))\n   137\t      .filter((row) => row.items.length),\n   138\t  }\n   139\t}\n   140\t\n   141\texport function moveItem(value, itemId, targetId, placement) {\n   142\t  if (!PLACEMENTS.includes(placement) || itemId === targetId) return value\n   143\t  const composition = normalizeComposition(value, value.themeId)\n   144\t  const source = locate(composition.rows, itemId)\n   145\t  if (!source) return composition\n   146\t  const item = composition.rows[source.rowIndex].items[source.itemIndex]\n   147\t  return insertItem(removeItem(composition, itemId), item, targetId, placement, composition.serial)\n   148\t}\n   149\t\n   150\texport function patchItem(value, itemId, patch) {\n   151\t  const composition = normalizeComposition(value, value.themeId)\n   152\t  return {\n   153\t    ...composition,\n   154\t    rows: composition.rows.map((row) => ({\n   155\t      ...row,\n   156\t      items: row.items.map((item) => (item.id === itemId ? { ...item, ...patch } : item)),\n   157\t    })),\n   158\t  }\n   159\t}\n   160\t\n   161\texport function duplicateItem(value, itemId) {\n   162\t  const composition = normalizeComposition(value, value.themeId)\n   163\t  const source = locate(composition.rows, itemId)\n   164\t  if (!source) return composition\n   165\t  const original = composition.rows[source.rowIndex].items[source.itemIndex]\n   166\t  const next = allocate(composition, original.kind === 'image' ? 'img' : 'cmp', original.id)\n   167\t  return insertItem(composition, { ...original, id: next.id }, itemId, 'below', next.serial)\n   168\t}\n   169\t\n   170\texport function countItems(value) {\n   171\t  return (value?.rows || []).reduce((sum, row) => sum + (row.items?.length || 0), 0)\n   172\t}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"6b8c71a4-bf2e-4775-bb32-5a852d61030b"}}}
