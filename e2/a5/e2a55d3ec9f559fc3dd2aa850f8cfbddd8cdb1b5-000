e: ((Math.round(nombre(l.gradientAngle, 135)) % 360) + 360) % 360,\n      listStyle: LIST_STYLES.includes(l.listStyle) ? l.listStyle : 'none',\n      href: typeof l.href === 'string' ? l.href : '',\n      ...normaliserTableau(l),\n      animationStyle: ANIMATION_STYLES.includes(l.animationStyle) ? l.animationStyle : 'none',\n      animationDelay: Math.min(3000, Math.max(0, Math.round(nombre(l.animationDelay, 0)))),\n      focalX: Math.min(100, Math.max(0, nombre(l.focalX, 50))), focalY: Math.min(100, Math.max(0, nombre(l.focalY, 50))),\n      constrainH: CONSTRAINTS_H.includes(l.constrainH) ? l.constrainH : 'left',\n      constrainV: CONSTRAINTS_V.includes(l.constrainV) ? l.constrainV : 'top',\n      opacity: Math.min(1, Math.max(0, nombre(l.opacity, 1))),\n      blend: BLEND_MODES.includes(l.blend) ? l.blend : 'normal',\n      hidden: !!l.hidden, locked: !!l.locked,\n      source: typeof l.source === 'string' ? l.source : '',\n      style: l.style && typeof l.style === 'object' ? l.style : {},\n      effects: { ...emptyEffects(), ...(l.effects && typeof l.effects === 'object' ? l.effects : {}) },\n      // FAMILLE PHOTOSHOP 5 · le groupe d'appartenance, `null` si absent OU si le groupe visé a\n      // depuis disparu : un calque ne doit jamais pointer vers un dossier qui n'existe plus.\n      groupId: (typeof l.groupId === 'string' && l.groupId && (composition?.groups || []).some((g) => g?.id === l.groupId)) ? l.groupId : null,\n    }))\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"6b8c71a4-bf2e-4775-bb32-5a852d61030b"}}}
