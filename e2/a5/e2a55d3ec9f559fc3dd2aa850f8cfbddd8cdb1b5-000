{"timestamp":"2026-08-05T17:09:42.609Z","ordinal":1126,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd2e7-0251-7c13-9c76-7050ff8ff31b","call_id":"call_tsWO5UC6MpKr4j5Qook20w0y","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"// ZenRayMedia — LES SOUS-COMPOSANTS (2026-08-04, demande centrale de Matthieu).\n//\n// « Tu me fais des templates, mais ces templates ne sont pas modifiables par rapport aux\n// components. Donc tu prends un seul template et tu le sous-divises en components afin que je\n// puisse vraiment dans la hiérarchie avoir accès à tous les composants. »\n//\n// LE RAISONNEMENT, parce qu'il décide de tout le reste. Un composant de thème est un fragment de\n// HTML écrit à la main : un en-tête de journal contient son logo, sa date, ses onglets, son bouton\n// d'abonnement. Jusqu'ici la hiérarchie n'en voyait qu'UNE ligne, « Masthead », et le panneau de\n// droite n'offrait que les champs que l'auteur du fragment avait pensé à déclarer. Tout le reste\n// était hors d'atteinte.\n//\n// Or ce découpage existe déjà, et il n'a pas à être réinventé : c'est l'arbre du DOM. Chaque\n// élément du fragment EST un sous-composant. Il suffit de le lire.\n//\n// CHAQUE NŒUD PORTE UN CHEMIN D'INDICES, « 0.2.1 », et non un sélecteur CSS. Un sélecteur se casse\n// dès qu'une classe change ; un chemin d'indices ne dépend que de la structure, laquelle est\n// justement ce que l'utilisateur voit dans l'arbre. Le chemin sert de clef de réglage, et il\n// survit à l'enregistrement puisqu'il n'est qu'une chaîne.\n//\n// CE MODULE NE TOUCHE JAMAIS AU DOM DE LA PAGE. Il lit une chaîne, il rend une chaîne. C'est ce\n// qui le rend testable sans navigateur et c'est ce qui garantit que l'export reste une page morte.\n\n// Les éléments qui ne sont pas des sous-composants : ils n'ont ni surface ni contenu propre, et\n// les afficher noierait l'arbre sous du bruit.\nconst IGNORES = new Set(['STYLE', 'SCRIPT', 'DEFS', 'SYMBOL', 'BR', 'HR'])\n\n// Les réglages qu'un sous-composant accepte. Volontairement COURT : douze propriétés couvrent ce\n// qu'on retouche réellement sur une maquette, et une liste fermée permet de les écrire en style en\n// ligne sans jamais construire de CSS à partir d'une saisie libre.\nexport const NODE_STYLES = [\n  { key: 'color', label: 'Couleur', type: 'color' },\n  { key: 'backgroundColor', label: 'Fond', type: 'color' },\n  { key: 'fontSize', label: 'Corps', type: 'text', hint: '18px' },\n  { key: 'fontWeight', label: 'Graisse', type: 'text', hint: '600' },\n  { key: 'letterSpacing', label: 'Interlettre', type: 'text', hint: '.02em' },\n  { key: 'lineHeight', label: 'Interligne', type: 'text', hint: '1.3' },\n  { key: 'textAlign', label: 'Alignement', type: 'select', options: ['', 'left', 'center', 'right', 'justify'] },\n  { key: 'padding', label: 'Marge int.', type: 'text', hint: '8px 12px' },\n  { key: 'margin', label: 'Marge ext.', type: 'text', hint: '0 0 12px' },\n  { key: 'borderRadius', label: 'Rayon', type: 'text', hint: '10px' },\n  { key: 'opacity', label: 'Opacité', type: 'text', hint: '1' },\n  { key: 'display', label: 'Affichage', type: 'select', options: ['', 'block', 'flex', 'inline-block', 'grid', 'none'] },\n]\n\nconst CLEFS_STYLE = new Set(NODE_STYLES.map((s) => s.key))\n\nfunction disponible() {\n  return typeof DOMParser !== 'undefined'\n}\n\n// Le nom lisible d'un nœud. On préfère TOUJOURS ce que l'auteur a écrit à ce que la machine\n// devine : un attribut `data-zrm-name`, puis une classe parlante, puis la balise. Un arbre dont\n// les vingt lignes s'appellent « div » ne sert à rien.\nfunction nommer(el) {\n  const explicite = el.getAttribute?.('data-zrm-name')\n  if (explicite) return explicite\n  const classe = (el.getAttribute?.('class') || '')\n    .split(/\\s+/)\n    .filter(Boolean)\n    .find((c) => c.startsWith('zrm-') && c.length > 6)\n  if (classe) return classe.replace(/^zrm-/, '').replace(/-/g, ' ')\n  const tag = el.tagName.toLowerCase()\n  const titres = { h1: 'Titre 1', h2: 'Titre 2', h3: 'Titre 3', h4: 'Titre 4', p: 'Paragraphe', a: 'Lien', img: 'Image', ul: 'Liste', li: 'Élément', button: 'Bouton', nav: 'Navigation', header: 'En-tête', footer: 'Pied', section: 'Section', figure: 'Figure', time: 'Date', span: 'Texte', svg: 'Icône', use: 'Icône' }\n  return titres[tag] || tag\n}\n\n// Le texte propre d'un nœud, c'est-à-dire celui qu'il porte LUI-MÊME et non celui de ses enfants.\n// La distinction est ce qui rend l'édition sûre : modifier le texte d'un conteneur effacerait\n// toute sa descendance, ce que personne n'attend en tapant dans un champ.\nfunction texteDirect(el) {\n  let out = ''\n  for (const enfant of el.childNodes) {\n    if (enfant.nodeType === 3) out += enfant.nodeValue\n  }\n  return out.trim()\n}\n\nfunction noeudsEnfants(el) {\n  return [...el.children].filter((c) => !IGNORES.has(c.tagName.toUpperCase()))\n}\n\nfunction construire(el, chemin, profondeur) {\n  // Une profondeur maximale, parce qu'un tableau SVG imbriqué produirait des centaines de nœuds\n  // pour une seule icône, et qu'un arbre qu'on ne peut pas parcourir ne vaut pas mieux qu'aucun.\n  const enfants = profondeur >= 6 ? [] : noeudsEnfants(el).map((c, i) => construire(c, chemin ? `${chemin}.${i}` : String(i), profondeur + 1))\n  return {\n    path: chemin,\n    tag: el.tagName.toLowerCase(),\n    name: nommer(el),\n    text: texteDirect(el),\n    editable: texteDirect(el).length > 0,\n    children: enfants,\n  }\n}\n\n/**\n * L'arbre des sous-composants d'une page compilée, indexé par identifiant d'instance.\n * @returns {Record<string, {path:string,tag:string,name:string,text:string,children:any[]}[]>}\n */\nexport function parseTree(html) {\n  if (!disponible() || typeof html !== 'string' || !html) return {}\n  const doc = new DOMParser().parseFromString(html, 'text/html')\n  const out = {}\n  for (const hote of doc.querySelectorAll('[data-zrm-instance]')) {\n    const id = hote.getAttribute('data-zrm-instance')\n    out[id] = noeudsEnfants(hote).map((c, i) => construire(c, String(i), 0))\n  }\n  return out\n}\n\n/** Le nœud désigné par son chemin, ou null. */\nexport function findNode(arbre, instanceId, path) {\n  let liste = arbre?.[instanceId]\n  if (!Array.isArray(liste) || !path) return null\n  const indices = String(path).split('.').map(Number)\n  let noeud = null\n  for (const i of indices) {\n    noeud = liste?.[i]\n    if (!noeud) return null\n    liste = noeud.children\n  }\n  return noeud\n}\n\n/** Le chemin d'un élément DANS son hôte, calculé exactement comme `construire` le numérote. */\nexport function pathOfElement(el, hote) {\n  const indices = []\n  let courant = el\n  while (courant && courant !== hote) {\n    const parent = courant.parentElement\n    if (!parent) return null\n    const fratrie = [...parent.children].filter((c) => !IGNORES.has(c.tagName.toUpperCase()))\n    const i = fratrie.indexOf(courant)\n    if (i < 0) return null\n    indices.unshift(i)\n    courant = parent\n  }\n  return courant === hote ? indices.join('.') : null\n}\n\nfunction styleEnLigne(reglages) {\n  return Object.entries(reglages || {})\n    .filter(([clef, valeur]) => CLEFS_STYLE.has(clef) && typeof valeur === 'string' && valeur.trim())\n    // camelCase vers tiret : `fontSize` devient `font-size`.\n    .map(([clef, valeur]) => `${clef.replace(/[A-Z]/g, (m) => `-${m.toLowerCase()}`)}:${valeur.replace(/[;<>\"']/g, '')}`)\n    .join(';')\n}\n\n/**\n * Applique les réglages de sous-composants à une page compilée.\n *\n * Les réglages arrivent sous la forme `{ [instanceId]: { [path]: { text, style } } }`, exactement\n * la forme sous laquelle ils sont enregistrés dans `item.props.__nodes`. Un chemin devenu\n * introuvable, parce que le composant a changé, est IGNORÉ sans bruit : un réglage orphelin ne doit\n * jamais empêcher une page de se rendre.\n */\nexport function applyOverrides(html, reglagesParInstance) {\n  if (!disponible() || !reglagesParInstance || !Object.keys(reglagesParInstance).length) return html\n  const doc = new DOMParser().parseFromString(html, 'text/html')\n  let touche = false\n\n  for (const [instanceId, reglages] of Object.entries(reglagesParInstance)) {\n    const hote = doc.querySelector(`[data-zrm-instance=\"${CSS.escape ? CSS.escape(instanceId) : instanceId}\"]`)\n    if (!hote) continue\n    for (const [path, reglage] of Object.entries(reglages || {})) {\n      const el = elementAuChemin(hote, path)\n      if (!el) continue\n      if (typeof reglage.text === 'string' && reglage.text !== '') {\n        // On ne remplace QUE les nœuds de texte directs, jamais les enfants : sans cela, régler le\n        // texte d'un conteneur effacerait toute sa descendance en un caractère.\n        let pose = false\n        for (const enfant of [...el.childNodes]) {\n          if (enfant.nodeType !== 3) continue\n          if (pose) { enfant.nodeValue = '' } else { enfant.nodeValue = reglage.text; pose = true }\n        }\n        if (!pose) el.textContent = reglage.text\n        touche = true\n      }\n      const style = styleEnLigne(reglage.style)\n      if (style) {\n        el.setAttribute('style', `${el.getAttribute('style') || ''};${style}`)\n        touche = true\n      }\n    }\n  }\n  if (!touche) return html\n  return `<!doctype html>${doc.documentElement.outerHTML}`\n}\n\nfunction elementAuChemin(hote, path) {\n  let courant = hote\n  for (const i of String(path).split('.').map(Number)) {\n    const enfants = noeudsEnfants(courant)\n    courant = enfants[i]\n    if (!courant) return null\n  }\n  return courant\n}\n\n/** Le nombre de sous-composants d'une instance, replié pour l'affichage. */\nexport function countNodes(liste) {\n  if (!Array.isArray(liste)) return 0\n  return liste.reduce((n, noeud) => n + 1 + countNodes(noeud.children), 0)\n}\n\n/**\n * TOUS LES TEXTES MODIFIABLES d'un sous-arbre, à plat.\n *\n * Matthieu : « le plus important, si je clique sur un élément de texte, c'est de pouvoir modifier\n * le texte à droite, ça me semble évident. » Il a raison, et le panneau ne le permettait pas dans\n * le cas le plus fréquent : on clique rarement PILE sur le nœud qui porte le texte, on clique sur\n * la boîte qui le contient. Le panneau affichait alors « ce nœud n'a pas de texte propre », ce qui\n * est exact et parfaitement inutile.\n *\n * Cette fonction remonte donc les textes de toute la descendance, à plat et dans l'ordre de\n * lecture. Le panneau les offre tous, et le premier champ est toujours un champ de texte.\n */\nexport function collectTexts(liste, max = 24) {\n  const out = []\n  const marcher = (noeuds) => {\n    for (const noeud of noeuds || []) {\n      if (out.length >= max) return\n      if (noeud.editable) out.push({ path: noeud.path, name: noeud.name, tag: noeud.tag, text: noeud.text })\n      marcher(noeud.children)\n    }\n  }\n  marcher(Array.isArray(liste) ? liste : [liste].filter(Boolean))\n  return out\n}\n\n/** Tous les chemins d'un sous-arbre, pour déplier ou replier d'un seul geste. */\nexport function allPaths(liste) {\n  const out = []\n  const marcher = (noeuds) => {\n    for (const noeud of noeuds || []) { out.push(noeud.path); marcher(noeud.children) }\n  }\n  marcher(Array.isArray(liste) ? liste : [liste].filter(Boolean))\n  return out\n}\n// ZenRayMedia — L0 : les six contrats de données.\n// Doc de référence : docs/zenraymedia/01-PLAN.md §5, docs/zenraymedia/04-WBS-COMPOSANTS.md L0.\n//\n// RÈGLE DURE (01-PLAN §5.5) : tout Job porte une `seed`. Aucun aléa non graine n'est autorisé\n// dans le produit -- sinon deux rendus du même contenu diffèrent et le pipeline n'est plus\n// réparable (risque R3 de 02-RISQUES). `Math.random()` est donc INTERDIT dans ce dossier :\n// on passe toujours par `rng(seed)` ci-dessous.\n\nexport const REGISTERS = ['presse', 'créateur', 'institutionnel', 'luxe', 'technique', 'divertissement', 'pédagogique', 'promotionnel']\nexport const INTENTS = ['informer', 'convaincre', 'vendre', 'émouvoir', 'enseigner', 'annoncer', 'documenter']\nexport const BEAT_ROLES = ['hook', 'context', 'proof', 'demo', 'turn', 'payoff', 'cta']\nexport const BEAT_TEMPOS = ['still', 'calm', 'drive', 'snap']\n\nexport const ROLE_LABELS = {\n  hook: 'Accroche', context: 'Contexte', proof: 'Preuve', demo: 'Démonstration',\n  turn: 'Bascule', payoff: 'Chute', cta: 'Appel',\n}\n\n// --- Générateur déterministe (L0-10) -------------------------------------------------------\n// mulberry32 : même graine -> même suite, sur toutes les machines. Utilisé pour le grain, les\n// micro-décalages et tout choix \"aléatoire\" d'un thème.\nexport function rng(seed) {\n  let a = (typeof seed === 'number' ? seed : hashString(String(seed ?? 'zenraymedia'))) >>> 0\n  return function next() {\n    a |= 0; a = (a + 0x6D2B79F5) | 0\n    let t = Math.imul(a ^ (a >>> 15), 1 | a)\n    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t\n    return ((t ^ (t >>> 14)) >>> 0) / 4294967296\n  }\n}\n\nexport function hashString(str) {\n  let h = 2166136261 >>> 0\n  for (let i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = Math.imul(h, 16777619) }\n  return h >>> 0\n}\n\n// Identifiant stable et lisible, dérivé du contenu + d'un compteur fourni par l'appelant.\n// Volontairement SANS Date.now() : un id ne doit pas dépendre de l'heure de fabrication.\nexport function makeId(prefix, seedText, counter = 0) {\n  return `${prefix}-${hashString(`${seedText}#${counter}`).toString(36).padStart(7, '0')}`\n}\n\n// --- Helpers de validation ------------------------------------------------------------------\nconst isStr = (v) => typeof v === 'string'\nconst nonEmpty = (v) => isStr(v) && v.trim().length > 0\nconst isArr = Array.isArray\n\n// Compte les phrases d'un texte. Sert la contrainte du message unique (WBS ZM-L2-02).\n// Les abréviations courantes ne comptent pas comme fin de phrase.\nexport function sentenceCount(text) {\n  if (!nonEmpty(text)) return 0\n  const cleaned = String(text)\n    .replace(/\\b(M|Mme|Dr|etc|cf|ex|p|vs|Mr|St|n°|art)\\./gi, '$1')\n    .replace(/\\d+\\.\\d+/g, '0')\n  const parts = cleaned.split(/[.!?…]+(?:\\s|$)/).map((s) => s.trim()).filter(Boolean)\n  return parts.length\n}\n\n// --- 5.1 Brief --------------------------------------------------------------------------------\nexport function emptyBrief() {\n  return {\n    id: '', title: '', message: '', audience: '', register: 'créateur', intent: 'informer',\n    evidence: [], constraints: { languages: ['fr'], maxDuration: null, mentions: [] }, sources: [],\n  }\n}\n\nexport function validateBrief(brief) {\n  const errors = []\n  if (!brief || typeof brief !== 'object') return [{ field: 'brief', code: 'shape', message: 'Brief absent.' }]\n  if (!nonEmpty(brief.title)) errors.push({ field: 'title', code: 'required', message: 'Le titre de travail est obligatoire.' })\n  if (!nonEmpty(brief.message)) errors.push({ field: 'message', code: 'required', message: 'Le message est obligatoire : une phrase, celle que le public doit retenir.' })\n  // ZM-L2-02 : REFUS explicite, pas un avertissement.\n  else if (sentenceCount(brief.message) > 1) errors.push({ field: 'message', code: 'single-sentence', message: `Le message doit tenir en UNE phrase (${sentenceCount(brief.message)} détectées). Choisis celle qui compte.` })\n  if (!nonEmpty(brief.audience)) errors.push({ field: 'audience', code: 'required', message: 'Le public est obligatoire : à qui parles-tu, en clair ?' })\n  if (!REGISTERS.includes(brief.register)) errors.push({ field: 'register', code: 'enum', message: 'Registre inconnu.' })\n  if (!INTENTS.includes(brief.intent)) errors.push({ field: 'intent', code: 'enum', message: 'Intention inconnue.' })\n  if (brief.evidence && !isArr(brief.evidence)) errors.push({ field: 'evidence', code: 'shape', message: 'Les preuves doivent former une liste.' })\n  return errors\n}\n\n// --- 5.2 Cut ----------------------------------------------------------------------------------\nexport function validateCut(cut) {\n  const errors = []\n  if (!cut || typeof cut !== 'object') return [{ field: 'cut', code: 'shape', message: 'Cut absent.' }]\n  if (!nonEmpty(cut.briefId)) errors.push({ field: 'briefId', code: 'required', message: 'Le cut doit référencer un brief.' })\n  if (!isArr(cut.beats) || cut.beats.length === 0) {\n    errors.push({ field: 'beats', code: 'required', message: 'Un cut contient au moins un beat.' })\n    return errors\n  }\n  cut.beats.forEach((beat, i) => {\n    if (!BEAT_ROLES.includes(beat?.role)) errors.push({ field: `beats[${i}].role`, code: 'enum', message: `Beat ${i + 1} : rôle manquant ou inconnu.` })\n    if (!nonEmpty(beat?.text)) errors.push({ field: `beats[${i}].text`, code: 'required', message: `Beat ${i + 1} : texte vide.` })\n    if (beat?.weight != null && (typeof beat.weight !== 'number' || beat.weight < 0 || beat.weight > 1)) errors.push({ field: `beats[${i}].weight`, code: 'range', message: `Beat ${i + 1} : le poids doit être compris entre 0 et 1.` })\n    if (beat?.tempo && !BEAT_TEMPOS.includes(beat.tempo)) errors.push({ field: `beats[${i}].tempo`, code: 'enum', message: `Beat ${i + 1} : tempo inconnu.` })\n    if (beat?.slots && !isArr(beat.slots)) errors.push({ field: `beats[${i}].slots`, code: 'shape', message: `Beat ${i + 1} : les emplacements doivent former une liste.` })\n    if (isArr(beat?.slots) && beat.slots.length > 4) errors.push({ field: `beats[${i}].slots`, code: 'range', message: `Beat ${i + 1} : 4 emplacements média au maximum.` })\n  })\n  return errors\n}\n\n// --- 5.3 Theme --------------------------------------------------------------------------------\n// Les 7 groupes de décisions (01-PLAN §10.2). `surface`, `palette`, `typography`, `grid` sont\n// obligatoires ; `motion`, `chrome`, `sound` ont des valeurs par défaut (un thème d'article n'a\n// pas besoin de mouvement ni de son pour être valide).\nexport const THEME_GROUPS = ['surface', 'palette', 'typography', 'grid', 'motion', 'chrome', 'sound']\n\nexport function validateTheme(theme) {\n  const errors = []\n  if (!theme || typeof theme !== 'object') return [{ field: 'theme', code: 'shape', message: 'Thème absent.' }]\n  if (!/^T-\\d{2}-\\d-\\d$/.test(theme.id || '')) errors.push({ field: 'id', code: 'format', message: 'Identifiant attendu : T-FF-S-V (ex. T-01-3-2).' })\n  if (!nonEmpty(theme.name)) errors.push({ field: 'name', code: 'required', message: 'Le nom public du thème est obligatoire.' })\n  for (const group of ['surface', 'palette', 'typography', 'grid']) {\n    if (!theme[group] || typeof theme[group] !== 'object') errors.push({ field: group, code: 'required', message: `Groupe « ${group} » manquant.` })\n  }\n  if (theme.typography && !theme.typography.scale) errors.push({ field: 'typography.scale', code: 'required', message: 'Le thème doit poser son échelle typographique.' })\n  if (!isArr(theme.formats) || theme.formats.length === 0) errors.push({ field: 'formats', code: 'required', message: 'Le thème doit déclarer au moins un format natif.' })\n  // ZM-L4-16 : le calibrage est PRIVÉ. Un thème qui l'expose dans un champ public est refusé.\n  const publicText = `${theme.name || ''} ${theme.description || ''}`.toLowerCase()\n  const marks = ['bfm', 'carrefour', 'squeezie', 'playstation', 'weta', 'le monde', 'netflix', 'vogue', 'lidl']\n  const leaked = marks.filter((m) => publicText.includes(m))\n  if (leaked.length) errors.push({ field: 'name', code: 'trademark', message: `Marque déposée dans un champ public : ${leaked.join(', ')}. Le calibrage vit dans calibration.ref, jamais dans le nom.` })\n  return errors\n}\n\n// --- 5.4 Format --------------------------------------------------------------------------------\nexport const FORMAT_KINDS = ['web', 'still', 'print', 'video', 'overlay']\n\nexport function validateFormat(format) {\n  const errors = []\n  if (!format || typeof format !== 'object') return [{ field: 'format', code: 'shape', message: 'Format absent.' }]\n  if (!nonEmpty(format.id)) errors.push({ field: 'id', code: 'required', message: 'Identifiant de format manquant.' })\n  if (!FORMAT_KINDS.includes(format.kind)) errors.push({ field: 'kind', code: 'enum', message: 'Type de format inconnu.' })\n  const c = format.canvas\n  // Une page web n'a PAS de hauteur : le contenu coule. `h:0` y est donc légal et volontaire.\n  // Tout autre type de format (image, print, vidéo) doit poser ses deux dimensions.\n  if (!c || !(c.w > 0)) errors.push({ field: 'canvas', code: 'required', message: 'Largeur de sortie manquante.' })\n  else if (format.kind !== 'web' && !(c.h > 0)) errors.push({ field: 'canvas', code: 'required', message: `Hauteur de sortie manquante (obligatoire pour un format « ${format.kind} »).` })\n  if (['video', 'overlay'].includes(format.kind) && !(format.time?.fps > 0)) errors.push({ field: 'time.fps', code: 'required', message: 'Un format temporel doit poser ses images par seconde.' })\n  return errors\n}\n\n// --- 5.5 Job -----------------------------------------------------------------------------------\nexport function validateJob(job) {\n  const errors = []\n  if (!job || typeof job !== 'object') return [{ field: 'job', code: 'shape', message: 'Job absent.' }]\n  if (!nonEmpty(job.cutId)) errors.push({ field: 'cutId', code: 'required', message: 'Job sans cut.' })\n  if (!nonEmpty(job.themeId)) errors.push({ field: 'themeId', code: 'required', message: 'Job sans thème.' })\n  if (!nonEmpty(job.formatId)) errors.push({ field: 'formatId', code: 'required', message: 'Job sans format.' })\n  // RÈGLE DURE : pas de seed, pas de job. C'est ce qui rend un rendu rejouable.\n  if (job.seed == null || job.seed === '') errors.push({ field: 'seed', code: 'required', message: 'Job sans graine : le rendu ne serait pas reproductible.' })\n  return errors\n}\n\n// --- 5.6 Deliverable ----------------------------------------------------------------------------\nexport function validateDeliverable(deliverable) {\n  const err