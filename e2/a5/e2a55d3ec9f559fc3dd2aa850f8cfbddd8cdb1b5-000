{"timestamp":"2026-08-05T17:48:32.953Z","ordinal":1934,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd30a-9139-7161-bdbb-2992f3a2fce5","call_id":"call_0OcOqbKBDav9EBAvYBicHWVB","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 42315)\nTotal output lines: 2415\n\n### MediaApp 735-1165\n  // emprunt réellement demandé, « pouvoir déplacer les trucs », tient en trente lignes. Le reste de\n  // ZenRayRef, la sélection et le redimensionnement, existe déjà ici depuis la carte L6.\n  //\n  // Les gestes retenus sont ceux que tout le monde connaît sans les apprendre : molette pour\n  // parcourir, molette avec ⌘ ou Ctrl pour zoomer, glisser avec la barre d'espace ou le bouton du\n  // milieu pour déplacer. Un double-clic sur le vide replace la vue.\n  const espaceRef = React.useRef(false)\n  const [zoom, setZoom] = React.useState(1)\n  const [pan, setPan] = React.useState({ x: 0, y: 0 })\n  const panRef = React.useRef(null)\n  const fitScale = autoScale * zoom\n\n  const onStageWheel = (event) => {\n    // La molette au-dessus du plan de travail lui appartient ENTIÈREMENT : sans ce refus, la page\n    // qui contient l'éditeur défilerait derrière, et l'aperçu partirait hors de l'écran pendant\n    // qu'on croit le déplacer. Les autres panneaux ne sont pas concernés, ils défilent chacun chez\n    // eux, ce que `overscroll-behavior: contain` empêche de propager plus haut.\n    event.preventDefault()\n    if (event.ctrlKey || event.metaKey) {\n      setZoom((z) => Math.min(8, Math.max(0.1, z * (event.deltaY < 0 ? 1.12 : 1 / 1.12))))\n    } else {\n      setPan((p) => ({ x: p.x - (event.shiftKey ? event.deltaY : event.deltaX), y: p.y - (event.shiftKey ? 0 : event.deltaY) }))\n    }\n  }\n\n  const canvasRef = React.useRef(null)\n  // ═══ FAMILLE PHOTOSHOP 1 · LA SÉLECTION RECTANGULAIRE (carte P1) ═══════════════════════════════\n  // Chez Photoshop, le rectangle de sélection isole une région de PIXELS. ZenRayMedia n'a pas de\n  // pixels à isoler, il a des calques : le même geste, glisser sur le vide, y devient une sélection\n  // de calques — c'est très exactement le second sens que la documentation Adobe donne déjà au mot\n  // « sélection ». `marqueeRef` porte le point de départ EN PIXELS DU CANEVAS, mesuré une seule\n  // fois au clic, jamais recalculé pendant le glisser (même discipline que `panRef`).\n  const marqueeRef = React.useRef(null)\n  const [marqueeBox, setMarqueeBox] = React.useState(null)\n\n  // ═══ FAMILLE FIGMA 5 · ÉDITER LE TEXTE À L'ENDROIT MÊME OÙ IL S'AFFICHE ═════════════════════\n  // Le panneau Détails permettait déjà de changer le contenu d'un calque texte, mais Figma comme\n  // Photoshop ouvrent l'édition PAR UN DOUBLE-CLIC SUR LE CALQUE LUI-MÊME : c'est le geste que la\n  // doc nomme, pas un raccourci de confort. `editionTexteId` porte l'identifiant du calque en\n  // cours d'édition, `null` sinon — un seul calque édité à la fois, jamais deux superposés.\n  const [editionTexteId, setEditionTexteId] = React.useState(null)\n\n  const onStageDown = (event) => {\n    // Bouton du milieu, ou barre d'espace enfoncée : c'est la main de Photoshop, elle DÉPLACE le\n    // plan de travail. Un clic gauche SEUL, lui, ouvre désormais une sélection rectangulaire — le\n    // clic gauche n'était détourné vers RIEN jusqu'ici, précisément pour ne pas gêner la\n    // manipulation des calques, laquelle reste intacte : une boîte de calque arrête déjà la\n    // propagation de son propre clic, donc cette poignée ne voit jamais que le VIDE du canevas.\n    if (event.button === 1 || espaceRef.current) {\n      event.preventDefault()\n      panRef.current = { sx: event.clientX, sy: event.clientY, px: pan.x, py: pan.y }\n      return\n    }\n    // jsdom perd la propriete `button` sur un PointerEvent synthetise (limite deja rencontree\n    // sur clientX en carte S3) : `undefined` est traite comme le bouton primaire, exactement le\n    // comportement reel d'un navigateur ou `button` est TOUJOURS defini, jamais un affaiblissement.\n    if ((event.button !== 0 && event.button !== undefined) || !canvasRef.current) return\n    const rect = canvasRef.current.getBoundingClientRect()\n    const echelle = fitScale || 1\n    const point = { x: (event.clientX - rect.left) / echelle, y: (event.clientY - rect.top) / echelle }\n    marqueeRef.current = { rectLeft: rect.left, rectTop: rect.top, x1: point.x, y1: point.y }\n    setMarqueeBox({ x1: point.x, y1: point.y, x2: point.x, y2: point.y })\n    // Un clic SANS modificateur sur le vide désélectionne tout, comme dans Photoshop et Figma. Un\n    // clic AVEC Maj ou ⌘/Ctrl commence un glisser qui AJOUTE à la sélection déjà posée, sans\n    // effacer ce qui l'était.\n    if (!event.shiftKey && !event.metaKey && !event.ctrlKey) { setSelection([]); setSelectedComponent(null); setSelectedNode(null) }\n  }\n  const onStagePan = (event) => {\n    if (panRef.current) {\n      setPan({ x: panRef.current.px + (event.clientX - panRef.current.sx), y: panRef.current.py + (event.clientY - panRef.current.sy) })\n      return\n    }\n    const marquee = marqueeRef.current\n    if (!marquee) return\n    const echelle = fitScale || 1\n    const point = { x: (event.clientX - marquee.rectLeft) / echelle, y: (event.clientY - marquee.rectTop) / echelle }\n    const boite = { x1: marquee.x1, y1: marquee.y1, x2: point.x, y2: point.y }\n    setMarqueeBox(boite)\n    const ids = layersInRect(readLayers(composition), boite)\n    setSelection(ids)\n    // L'objet ACTIF, celui que le panneau de droite affiche, est le plus au premier plan des\n    // calques touchés — exactement celui qu'on verrait en premier en regardant l'écran.\n    const actif = stackOrder(composition).find((l) => ids.includes(l.id))\n    setSelectedComponent(actif ? actif.id : null)\n  }\n  const onStageUp = () => { panRef.current = null; marqueeRef.current = null; setMarqueeBox(null) }\n  const replacerLaVue = () => { setZoom(1); setPan({ x: 0, y: 0 }) }\n\n  // Un format article n'a PAS de hauteur : sa page coule. L'iframe prend donc toute la hauteur\n  // disponible (divisée par l'échelle, pour que le résultat mis à l'échelle la remplisse\n  // exactement) et défile à l'intérieur. Une hauteur fixe tronquait tout article un peu long.\n  const stageHeight = format.canvas.h || Math.round(availH / Math.max(fitScale, 0.08))\n\n  // --- Actions du Cut ----------------------------------------------------------------------------\n  const withCut = (fn) => { if (cut) { patchProject({ cut: fn(cut) }); setActionCount((n) => n + 1) } }\n\n  // Pose un calque neuf et le rattache à la diapositive active s'il y en a une (famille\n  // PowerPoint 1) — sinon il deviendrait un masque visible sur toutes les diapositives, jamais ce\n  // qu'on veut en travaillant sur une diapositive précise. Partagé par le bouton générique\n  // « Poser un calque X » et par les préréglages comme le Post-it (famille Miro 5).\n  const poserCalque = React.useCallback((kind, patch) => {\n    let suivant = addLayer(composition, kind, patch)\n    const pose = stackOrder(suivant)[0]\n    const slideActive = readSlides(suivant).find((s) => s.id === suivant.activeSlideId)\n    if (slideActive && pose) suivant = patchLayer(suivant, pose.id, { groupId: slideActive.groupId })\n    patchComposition(() => suivant)\n    setSelectedComponent(pose?.id || null)\n    setDeckTab('details')\n    setActionCount((n) => n + 1)\n  }, [composition, patchComposition])\n\n  // --- Exports ------------------------------------------------------------------------------------\n  const record = React.useCallback((entry) => {\n    const next = appendLog({ ...entry, at: new Date().toISOString() })\n    setLog(next)\n  }, [])\n\n  const runExport = React.useCallback(async (kind) => {\n    if (!compiled?.html || !project) return\n    // ZM-L11-09 : un défaut bloquant bloque TOUT livrable, sans exception. Une version\n    // antérieure exemptait l'export HTML -- c'est-à-dire précisément le livrable principal :\n    // la règle était inversée et le Critique ne protégeait rien.\n    if (!verdict.canPublish) {\n      notify(`${verdict.blocking.length} défaut(s) bloquant(s) : le Critique refuse le livrable. Onglet Critique.`, 'error')\n      return\n    }\n    setBusy(kind)\n    try {\n      const base = safeFileName(project.brief.title, '')\n      if (kind === 'html') {\n        const res = await exportHtml(compiled.html, `${base}html`)\n        record({ kind: 'html', theme: theme.name, format: format.label, bytes: res.bytes, checksum: checksumOf(compiled.html), title: project.brief.title })\n        notify(`Page HTML exportée (${formatBytes(res.bytes)}), polices incluses.`, 'ok')\n      } else if (kind === 'png') {\n        const res = await exportPng(compiled.html, format, `${base}png`)\n        record({ kind: 'png', theme: theme.name, format: format.label, bytes: res.bytes, checksum: checksumOf(compiled.html), title: project.brief.title })\n        notify(`Image ${res.width}×${res.height} exportée (${formatBytes(res.bytes)}).`, 'ok')\n      } else if (kind === 'pdf') {\n        await exportPdf(compiled.html)\n        record({ kind: 'pdf', theme: theme.name, format: format.label, bytes: 0, checksum: checksumOf(compiled.html), title: project.brief.title })\n        notify('Boîte d’impression ouverte : choisis « Enregistrer au format PDF ».', 'ok')\n      } else if (kind === 'text') {\n        const text = [project.brief.title, '', project.brief.message, '', ...cut.beats.map((b) => b.text)].join('\\n\\n')\n        await copyText(text) ? notify('Texte du livrable copié.', 'ok') : notify('Copie refusée par le navigateur.', 'error')\n      } else if (kind === 'png-toutes-diapositives') {\n        // FAMILLE POWERPOINT 8 · DIFFUSION. La sauvegarde (.zmedia.json) et l'export HTML/PNG/PDF\n        // d'UNE image existaient déjà ; ce qui manquait au regard de P1 (diapositives) était\n        // d'exporter un CARROUSEL entier — la traduction directe d'un « diaporama » pour Instagram\n        // et LinkedIn (VISION.md). Chaque diapositive se recompile avec ELLE SEULE active, jamais\n        // les autres, exactement ce que montre déjà l'aperçu quand on clique dessus.\n        const diapositives = readSlides(composition)\n        if (!diapositives.length) { notify('Aucune diapositive à exporter : la Structure n’en porte aucune.', 'error'); return }\n        for (let i = 0; i < diapositives.length; i++) {\n          const page = compile({ brief: project.brief, cut, theme, format, dark: renderDark, seed: project.seed ?? 1, fitScale: contentScale, composition: setActiveSlide(composition, diapositives[i].id), componentBundle })\n          const nomFichier = safeFileName(`${project.brief.title} ${i + 1}`, 'png')\n          const res = await exportPng(page.html, format, nomFichier)\n          record({ kind: 'png', theme: theme.name, format: format.label, bytes: res.bytes, checksum: checksumOf(page.html), title: `${project.brief.title} — diapositive ${i + 1}/${diapositives.length}` })\n        }\n        notify(`${diapositives.length} diapositives exportées, une image par fichier.`, 'ok')\n      }\n    } catch (err) {\n      notify(err.message || 'Export impossible.', 'error')\n    } finally {\n      setBusy(null)\n      setActionCount((n) => n + 1)\n    }\n  }, [compiled, project, verdict, theme, format, cut, notify, record, composition, componentBundle, renderDark, contentScale])\n\n  const plan = React.useMemo(() => {\n    if (!project || !cut || !theme || !isTemporal(format)) return null\n    return forgePlan({ brief: project.brief, cut, theme, format, html: compiled?.html || '', seed: project.seed ?? 1 })\n  }, [project, cut, theme, format, compiled])\n\n  // --- Images dans les blocs (ZM-L1-04, ZM-L2-05, ZM-L3-06) ---------------------------------\n  // Réutilise `fileToWebp` (src/api.js), déjà employé par l'éditeur d'articles : redimensionne et\n  // encode en WebP côté navigateur. On stocke une dataURL, PAS une adresse distante — c'est ce qui\n  // garde la page autonome ET ce qui permet à l'export PNG de fonctionner (une image distante\n  // souillerait le canevas et ferait échouer l'encodage, message d'erreur déjà prévu).\n  const attachImages = React.useCallback(async (beatIndex, files) => {\n    const images = Array.from(files || []).filter((f) => f && f.type.startsWith('image/'))\n    if (!images.length) return\n    setBusy('image')\n    try {\n      let next = cut\n      for (const file of images) {\n        // 1400 px de côté long, qualité 0.82 : au-delà, on alourdit le document sans rien gagner\n        // à l'écran ni sur une image sociale.\n        const dataUrl = await fileToWebp(file, 0.82, 1400).catch(() => null)\n        if (!dataUrl) { notify(`Image illisible : ${file.name}`, 'error'); continue }\n        const before = next\n        next = addSlot(next, beatIndex, { kind: 'image', dataUrl, label: file.name.replace(/\\.[^.]+$/, '') })\n        if (next === before) { notify(`${MAX_SLOTS} images au maximum par bloc.`, 'error'); break }\n      }\n      if (next !== cut) { patchProject({ cut: next }); setActionCount((n) => n + 1) }\n    } finally { setBusy(null) }\n  }, [cut, patchProject, notify])\n\n  // --- Enregistrer / ouvrir dans Create ------------------------------------------------------\n  // ENREGISTRER n'est PAS PUBLIER (cf. l'en-tête de document.js). Ici on range la SOURCE dans\n  // l'index de Matthieu, à l'endroit qu'il choisit, pour rouvrir et continuer. Publier produit\n  // une page figée et partageable, c'est la barre de rendu.\n  const persist = React.useCallback(async (path) => {\n    if (!project) return\n    setBusy('save')\n    const res = await saveDocument(path, project, { themeId, formatId, sha: path === docPath ? docSha : undefined })\n    setBusy(null)\n    if (!res.ok) { notify(res.error, 'error'); return }\n    setDocPath(path); setDocSha(res.sha); setBrowser(null)\n    setActionCount((n) => n + 1)\n    record({ kind: 'zmedia', theme: theme?.name || themeId, format: format.label, bytes: 0, checksum: path, title: project.brief.title })\n    notify(`Enregistré dans Create : ${path}`, 'ok')\n  }, [project, themeId, formatId, docPath, docSha, theme, format, notify, record])\n\n  const openDocument = React.useCallback(async (path) => {\n    setBusy('open')\n    const res = await loadDocument(path)\n    setBusy(null)\n    if (!res.ok) { notify(res.error, 'error'); return }\n    setProjects((list) => {\n      const withoutSame = list.filter((p) => p.id !== res.project.id)\n      const next = [...withoutSame, res.project]\n      saveProjects(next)\n      setCurrentId(res.project.id)\n      return next\n    })\n    setThemeId(res.themeId); setFormatId(res.formatId)\n    setDocPath(path); setDocSha(res.sha); setBrowser(null); setDeckTab('contenu')\n    notify(`Ouvert : ${path}`, 'ok')\n  }, [notify])\n\n  // Ouverture depuis Create (double-clic sur un .zmedia.json) : App.jsx bascule sur la vue Media\n  // et émet cet événement. Même patron que `zr:create-music`, déjà en place dans le projet.\n  React.useEffect(() => {\n    const onOpen = (event) => { const path = event?.detail?.path; if (path) openDocument(path) }\n    window.addEventListener('zr:media-open', onOpen)\n    return () => window.removeEventListener('zr:media-open', onOpen)\n  }, [openDocument])\n\n  // ⌘S : enregistrer. Si le document a déjà un chemin, on écrit directement ; sinon on ouvre le\n  // fil d'Ariane pour choisir où le ranger.\n  React.useEffect(() => {\n    const onKey = (event) => {\n      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 's') {\n        event.preventDefault()\n        if (docPath) persist(docPath); else setBrowser('save')\n      }\n    }\n    window.addEventListener('keydown', onKey)\n    return () => window.removeEventListener('keydown', onKey)\n  }, [docPath, persist])\n\n  // --- Publier (ZM-L8-01, -02, -09) ----------------------------------------------------------\n  // Publier produit une PAGE dans Create, cherchable, et rend son ADRESSE. C'est la porte V0 :\n  // tant qu'une URL n'existe pas, rien n'a été publié — un fichier sur un disque n'est pas\n  // une publication.\n  const [published, setPublished] = React.useState(null)\n\n  const publishNow = React.useCallback(async () => {\n    if (!project || !cut || !theme) return\n    if (!verdict.canPublish) {\n      notify(`${verdict.blocking.length} défaut(s) bloquant(s) : le Critique refuse la publication.`, 'error')\n      setDeckTab('critic')\n      return\n    }\n    setBusy('publish')\n    const dir = docPath ? dirOf(docPath) : DEFAULT_MEDIA_DIR\n    // Republier LE MÊME article doit écraser sa page, pas échouer en conflit : on renvoie le sha\n    // de la dernière publication quand le chemin est inchangé (il ne dépend que du titre).\n    const target = publishPathFor(dir, project.brief.title)\n    const res = await publishArticle({ dir, brief: project.brief, cut, theme, format, sha: published?.path === target ? published.sha : undefined })\n    setBusy(null)\n    if (!res.ok) { notify(res.error, 'error'); return }\n    setPublished(res)\n    setDeckTab('create')\n    setActionCount((n) => n + 1)\n    record({ kind: 'page', theme: theme.name, format: format.label, bytes: res.bytes, checksum: res.path, title: project.brief.title })\n    await copyText(res.url)\n    notify(res.indexed\n      ? `Publié : ${res.path} — adresse copiée.`\n      : `Publié : ${res.path} — adresse copiée. L'indexation n'a pas répondu, la page sera reprise au prochain build d'index.`, 'ok')\n  }, [project, cut, theme, format, verdict, docPath, published, notify, record])\n\n\n  // --- Projets --------------------------------------------------------------------------------------\n  // TOUTES ces fonctions passent par une mise à jour FONCTIONNELLE de setProjects.\n  // Bug réel évité (2026-07-25) : elles lisaient auparavant la variable `projects` de la portée\n  // de rendu. Or la barre de commande les capture dans un useMemo qui ne dépend pas de\n  // `projects` -> lancée depuis la palette après un ajout, « Nouveau brief » repartait d'une\n  // liste PÉRIMÉE et écrasait les briefs créés entre-temps. Une perte de travail silencieuse.\n  function newProject() {\n    setProjects((list) => {\n      const n = list.length\n      const fresh = { id: makeId('project', `nouveau${n}`, n), brief: { ...emptyBrief(), id: makeId('brief', `nouveau${n}`, n), title: 'Nouveau brief', message: '', audience: '' }, notes: '', cut: null, seed: 1 }\n      const next = [...list, fresh]\n      saveProjects(next); setCurrentId(fresh.id); setActionCount(0)\n      return next\n    })\n    notify('Brief créé.', 'ok')\n  }\n\n  function duplicateProject() {\n    setProjects((list) => {\n      const source = list.find((p) => p.id === currentId) || list[0]\n      if (!source) return list\n      const n = list.length\n      const copy = { ...source, id: makeId('project', `${source.id}copie`, n), brief: { ...source.brief, id: makeId('brief', `${source.id}copie`, n), title: `${source.brief.title} (copie)` } }\n      const next = [...list, copy]\n      saveProjects(next); setCurrentId(copy.id)\n      return next\n    })\n    notify('Brief dupliqué : essaie un autre angle sans perdre l’original.', 'ok')\n  }\n\n  function deleteProject() {\n    setProjects((list) => {\n      if (list.length <= 1) { notify('Le dernier brief ne peut pas être supprimé.', 'error'); return list }\n      const next = list.filter((p) => p.id !== currentId)\n      saveProjects(next); setCurrentId(next[0].id)\n      notify('Brief supprimé.', 'ok')\n      return next\n    })\n  }\n\n  function resetSeed() {\n    setProjects((list) => {\n      const fresh = seedProject()\n      const next = [...list.filter((p) => p.id !== fresh.id), fresh]\n      saveProjects(next); setCurrentId(fresh.id); setActionCount(0)\n      return next\n    })\n    notify('Brief de démonstration rechargé.', 'ok')\n  }\n\n  // --- Correctifs proposés par le Critique --------------------------------------------------------\n  const applyFix = (issue) => {\n    if (issue.fix === 'refit') { withCut((c) => refitCut(c, theme)); notify('Partition réajustée au thème.', 'ok') }\n    else if (issue.fix === 'shrink') {\n      // Le débordement se corrige en retirant du texte, pas en rapetissa…32315 tokens truncated…ule façon qu'il soit lu le jour où l'on ajoute un gabarit. */}\n              <p className=\"zrm-det-empty\" style={{ textAlign: 'left', lineHeight: 1.5 }}>\n                {themes.length} thème{themes.length > 1 ? 's' : ''} sur les 1024 du catalogue. Dépose un fichier{' '}\n                <span className=\"zrm-mono\">T-FF-S-V--slug.html</span> dans <span className=\"zrm-mono\">src/zenraymedia/themes/</span> : il apparaît ici.\n              </p>\n            </div>\n          ) : libraryTab === 'images' ? (\n            <>\n              {!imageIndexReady && <div className=\"zrm-det-empty\">Chargement de l’index d’images…</div>}\n              {imageIndexReady && imageResults.length === 0 && <div className=\"zrm-det-empty\">Aucune image trouvée.</div>}\n              <div className=\"zrm-library-images\">\n                {imageResults.map((image) => (\n                  <button key={image.path} className=\"zrm-library-image\" title={image.path}\n                    draggable\n                    onDragStart={(e) => e.dataTransfer.setData('application/x-zenray-image', image.path)}\n                    onClick={() => addLibraryImage(image)}>\n                    <VignetteIndex image={image} />\n                    <span>{image.name}</span>\n                  </button>\n                ))}\n              </div>\n            </>\n          ) : (\n            <div className=\"zrm-tree\">\n              {/* LA RUBRIQUE QUI PORTE LE PRODUIT (carte L3). Quatre types de calques, posés d'un\n                  clic sur le canevas, empilés comme dans Photoshop. Les composants du thème\n                  restent en dessous : ils deviennent eux aussi des calques quand on les pose. */}\n              {libraryTab === 'components' && (\n                <>\n                  <div className=\"zrm-tree-cat\" style={{ cursor: 'default' }}>\n                    <span style={{ width: 13 }} />Calques<span>{countLayers(composition)}</span>\n                  </div>\n                  {[['text', 'Texte', 'T'], ['image', 'Image', '▣'], ['shape', 'Forme', '◼'], ['component', 'Composant', '◈'], ['table', 'Tableau', '▦']].map(([kind, nom, glyphe]) => (\n                    <button key={kind} className=\"zrm-tree-row\" title={`Poser un calque ${nom}`}\n                      onClick={() => poserCalque(kind, kind === 'text' ? { source: 'Nouveau texte' } : {})}>\n                      <span className=\"zrm-tree-glyph\">{glyphe}</span>\n                      <span className=\"zrm-tree-name\">{nom}</span>\n                      <span className=\"zrm-tree-tag\">+</span>\n                    </button>\n                  ))}\n                  {/* FAMILLE MIRO 5 · LE POST-IT. Une simple PRÉSÉLECTION du calque texte (fond\n                      coloré, marge intérieure, texte centré) : aucun type de calque neuf, aucune\n                      donnée neuve — juste le geste le plus fréquent de Miro rendu accessible en un\n                      clic, plutôt que fond + marge + centrage réglés à la main à chaque fois. */}\n                  <button className=\"zrm-tree-row\" title=\"Poser un Post-it\"\n                    onClick={() => poserCalque('text', {\n                      source: 'Post-it', w: 200, h: 200,\n                      style: { backgroundColor: '#fff59d', padding: '20px', textAlign: 'center', justifyContent: 'center' },\n                      effects: { shadow: '2px 6px 16px rgba(0,0,0,.18)' },\n                    })}>\n                    <span className=\"zrm-tree-glyph\">▧</span>\n                    <span className=\"zrm-tree-name\">Post-it</span>\n                    <span className=\"zrm-tree-tag\">+</span>\n                  </button>\n                </>\n              )}\n              {Object.entries(componentGroups).map(([groupe, entrees]) => {\n                const ouvert = openComponentGroups[groupe] !== false\n                return (\n                  <React.Fragment key={groupe}>\n                    <button className=\"zrm-tree-cat\" onClick={() => setOpenComponentGroups((etat) => ({ ...etat, [groupe]: !ouvert }))}>\n                      <span className=\"zrm-twist\" data-open={ouvert}><Icon name=\"chevron.right\" size={9} /></span>\n                      {groupe}<span>{entrees.length}</span>\n                    </button>\n                    {ouvert && entrees.map((entree) => (\n                      <button key={entree.id} className=\"zrm-tree-row\" draggable\n                        title={`Ajouter ${entree.name} — ${entree.id}`}\n                        onDragStart={(e) => {\n                          e.dataTransfer.effectAllowed = 'copy'\n                          e.dataTransfer.setData('application/x-zenray-component', entree.id)\n                        }}\n                        onClick={() => addLibraryComponent(entree)}>\n                        <span className=\"zrm-tree-glyph\">{libraryTab === 'icons' ? '◇' : 'T'}</span>\n                        <span className=\"zrm-tree-name\">{entree.name}</span>\n                      </button>\n                    ))}\n                  </React.Fragment>\n                )\n              })}\n\n              {/* LES CONTENEURS SONT MONTRÉS ÉTEINTS, ET C'EST UN CHOIX PLUTÔT QU'UN OUBLI. Le plan\n                  V1 les écarte par écrit : ils rouvriraient le contrat de `composition.js` que\n                  l'étape 2 vient de refermer, et le rouvrir deux fois dans la même version est la\n                  façon la plus sûre de casser les documents déjà enregistrés. Les taire aurait\n                  laissé croire à un trou dans la hiérarchie ; les afficher marqués « V2 » dit à la\n                  fois ce qui existe et ce qui vient. */}\n              {libraryTab === 'components' && (\n                <>\n                  <div className=\"zrm-tree-cat\" style={{ cursor: 'default' }}><span style={{ width: 13 }} />Conteneurs<span>V2</span></div>\n                  {['Canvas', 'Grille', 'Superposition', 'Boîte d’échelle', 'Boîte de défilement', 'Boîte de taille', 'Pile', 'Grille uniforme'].map((nom) => (\n                    <div key={nom} className=\"zrm-tree-row\" data-mute=\"true\" title=\"Conteneur imbriqué — hors V1 par décision écrite du plan\">\n                      <span className=\"zrm-tree-glyph\">⊞</span>\n                      <span className=\"zrm-tree-name\">{nom}</span>\n                      <span className=\"zrm-tree-tag\">V2</span>\n                    </div>\n                  ))}\n                </>\n              )}\n            </div>\n          )}\n        </div>\n      </section>\n\n\n\n      {/* ═══ LE MENU CONTEXTUEL (famille 4, doc Slate « menus contextuels ») ═════════════════════\n          Un clic droit sur la hiérarchie ouvre le MÊME répertoire d'actions que les icônes en\n          ligne — masquer, verrouiller, dupliquer, retirer — plus les actions propres aux calques\n          (rang, cadrage) et le geste de sélection de groupe déjà posé dans `surLaSelection`. Se\n          ferme au clic extérieur, à Échap, ou après avoir choisi une action : jamais les trois\n          modes de fermeture d'un menu de la barre du haut n'auraient de raison de différer ici. */}\n      {menuContextuel && (\n        <div className=\"zrm-ctx-voile\" onClick={() => setMenuContextuel(null)} onContextMenu={(e) => { e.preventDefault(); setMenuContextuel(null) }}>\n          <div className=\"zrm-menu-pop\" style={{ position: 'fixed', top: menuContextuel.y, left: menuContextuel.x, minWidth: 190 }} onClick={(e) => e.stopPropagation()}>\n            {selection.length > 1 && (\n              <div className=\"zrm-menu-item\" style={{ opacity: .55, cursor: 'default' }}>{selection.length} éléments sélectionnés</div>\n            )}\n            {menuContextuel.estCalque && (\n              <>\n                <button className=\"zrm-menu-item\" onClick={() => { patchComposition((c) => reorderLayer(c, menuContextuel.id, 'up')); setMenuContextuel(null) }}>Monter d’un rang</button>\n                <button className=\"zrm-menu-item\" onClick={() => { patchComposition((c) => reorderLayer(c, menuContextuel.id, 'down')); setMenuContextuel(null) }}>Descendre d’un rang</button>\n                {/* FAMILLE POWERPOINT 2 · un saut direct à l'extrême, distinct du rang unique\n                    ci-dessus — les quatre commandes que PowerPoint, Figma et Miro rangent tous\n                    dans un second niveau plutôt qu'en boutons permanents, exactement ce menu. */}\n                <button className=\"zrm-menu-item\" onClick={() => { patchComposition((c) => bringToFront(c, menuContextuel.id)); setMenuContextuel(null) }}>Mettre au premier plan</button>\n                <button className=\"zrm-menu-item\" onClick={() => { patchComposition((c) => sendToBack(c, menuContextuel.id)); setMenuContextuel(null) }}>Mettre à l’arrière-plan</button>\n                <div className=\"zrm-menu-sep\" />\n                <button className=\"zrm-menu-item\" onClick={() => { setPanelLockedId(menuContextuel.id); setDeckTab('details'); setMenuContextuel(null) }}>Verrouiller le panneau dessus<small>Famille 1</small></button>\n                <button className=\"zrm-menu-item\" onClick={() => { setSelectedComponent(menuContextuel.id); cadrerLaSelection(); setMenuContextuel(null) }}>Cadrer la sélection<small>Maj+F</small></button>\n                <div className=\"zrm-menu-sep\" />\n              </>\n            )}\n            <button className=\"zrm-menu-item\" onClick={() => { const v = !findLayer(composition, menuContextuel.id)?.hidden && !(composition.rows||[]).some(r=>r.items.some(it=>it.id===menuContextuel.id&&it.hidden)); surLaSelection((c, id) => (menuContextuel.estCalque ? patchLayer(c, id, { hidden: !v }) : patchItem(c, id, { hidden: !v })), menuContextuel.id); setMenuContextuel(null) }}>Afficher / masquer</button>\n            <button className=\"zrm-menu-item\" onClick={() => { surLaSelection((c, id) => (menuContextuel.estCalque ? duplicateLayer(c, id) : duplicateItem(c, id)), menuContextuel.id); setMenuContextuel(null) }}>Dupliquer</button>\n            <div className=\"zrm-menu-sep\" />\n            <button className=\"zrm-menu-item\" onClick={() => { surLaSelection((c, id) => (menuContextuel.estCalque ? removeLayer(c, id) : removeItem(c, id)), menuContextuel.id); setSelection([]); setSelectedComponent(null); setMenuContextuel(null) }}>Retirer<small>{selection.length > 1 ? `${selection.length}` : ''}</small></button>\n          </div>\n        </div>\n      )}\n\n      {toast && <div className=\"zrm-toast\" data-kind={toast.kind}>{toast.message}</div>}\n      {/* ZONE 8 · BARRE DU BAS. Elle dit l'état, elle ne commande rien : le document, sa\n          sauvegarde, le thème et le format. C'est la ligne qu'on lit sans la chercher. */}\n      {/* ═══ ZONE 8 · BARRE D'ÉTAT ════════════════════════════════════════════════════════════════\n          À gauche ce qu'on LIT sans le chercher, à droite ce qu'on DÉCLENCHE : c'est la répartition\n          d'Unreal, dont le coin bas-droit porte « All Saved » et « Check-in Changes ». Les boutons\n          de rendu descendent ici depuis le pied de la Palette, qu'ils encombraient : dans une\n          colonne de deux cents pixels, cinq boutons pleine largeur mangeaient le tiers de la\n          hauteur réservée aux composants.\n\n          Le sélecteur de format en pastilles disparaît, sans perte : il vit désormais dans la barre\n          d'outils, et le même réglage offert à deux endroits finit toujours par en contredire un. */}\n      <div className=\"zrm-panel zrm-zone-status\">\n        <Icon name={docPath ? 'checkmark' : 'pencil'} size={11} />\n        <span title={docPath || 'jamais enregistré'}>{docPath || 'document non enregistré'}</span>\n        <button className=\"zrm-status-btn\" data-on={deckTab === 'critic'} onClick={() => setDeckTab('critic')}\n          style={{ color: verdict.canPublish ? undefined : UI.red }}>\n          <Icon name={verdict.canPublish ? 'checkmark' : 'hand.raised'} size={11} />\n          {issues.length ? `${issues.length} remarque(s)` : 'aucune remarque'}\n        </button>\n\n        <span className=\"zrm-head-spacer\" />\n        {busy && <div className=\"zrm-progress\" style={{ width: 60 }}><i style={{ width: '65%' }} /></div>}\n        <button className=\"zrm-status-btn\" onClick={() => setDeckTab('log')}><Icon name=\"list.bullet\" size={11} />Journal</button>\n        <button className=\"zrm-status-btn\" onClick={() => runExport('text')} disabled={!compiled || !!busy}>Copier le texte</button>\n        {format.kind === 'print' && <button className=\"zrm-status-btn\" onClick={() => runExport('pdf')} disabled={!compiled || !!busy}>PDF</button>}\n        {['still', 'video', 'overlay'].includes(format.kind) && <button className=\"zrm-status-btn\" onClick={() => runExport('png')} disabled={!compiled || !!busy}>Image PNG</button>}\n        {/* FAMILLE POWERPOINT 8 · n'apparaît que si la Structure porte au moins une diapositive :\n            un bouton d'export de carrousel sans carrousel serait un bouton mort. */}\n        {readSlides(composition).length > 1 && <button className=\"zrm-status-btn\" onClick={() => runExport('png-toutes-diapositives')} disabled={!compiled || !!busy}>Toutes les diapositives</button>}\n        <button className=\"zrm-status-btn\" onClick={() => runExport('html')} disabled={!compiled || !!busy}>Fichier HTML</button>\n        <span className=\"zrm-mono\" style={{ fontSize: 10, opacity: .5 }} title=\"Règle des trois actions : note → thème → rendre\">{actionCount} action{actionCount > 1 ? 's' : ''}</span>\n        <button className=\"zrm-btn zrm-btn-primary\" style={{ minHeight: 22, padding: '0 12px', fontSize: 11 }}\n          onClick={publishNow} disabled={!compiled || !!busy} title=\"Écrit une page dans Create, l’indexe et copie son adresse\">\n          {busy === 'publish' ? 'Publication…' : 'Publier'}\n        </button>\n      </div>\n    </div>\n  )\n}\n\n// UNE RANGÉE DE SOUS-COMPOSANT, récursive.\n//\n// Elle est écrite HORS de `MediaApp` et non en ligne dans son rendu, et c'est une précaution qui a\n// déjà été payée sur ce projet : un composant défini à l'intérieur d'un autre est recréé à chaque\n// rendu, donc démonté et remonté, ce qui fait clignoter l'arbre au survol et perd le focus des\n// champs. La règle est notée dans le CLAUDE.md global depuis le 2026-07-22.\nfunction RangeeNoeud({ noeud, niveau, instanceId, selectedComponent, selectedNode, onSelect, ouverts, onToggle }) {\n  const ouvert = !!ouverts[`${instanceId}:${noeud.path}`]\n  const choisi = selectedComponent === instanceId && selectedNode === noeud.path\n  const aDesEnfants = noeud.children.length > 0\n  return (\n    <>\n      <div className=\"zrm-tree-row\" style={{ '--zrm-indent': `${42 + niveau * 11}px` }} data-on={choisi}\n        onClick={(e) => { e.stopPropagation(); onSelect(noeud.path) }} title={`<${noeud.tag}> · ${noeud.path}`}>\n        {aDesEnfants ? (\n          <span className=\"zrm-twist\" data-open={ouvert} title=\"Clic : ce nœud · Maj-clic : toute la descendance\"\n            onClick={(e) => { e.stopPropagation(); onToggle(noeud.path, e.shiftKey) }}>\n            <Icon name=\"chevron.right\" size={9} />\n          </span>\n        ) : <span style={{ width: 9, flex: '0 0 auto' }} />}\n        <span className=\"zrm-tree-name\">{noeud.name}</span>\n        {noeud.text ? <span className=\"zrm-tree-tag\" style={{ maxWidth: 54, overflow: 'hidden' }}>{noeud.text.slice(0, 12)}</span> : null}\n      </div>\n      {ouvert && noeud.children.map((enfant) => (\n        <RangeeNoeud key={enfant.path} noeud={enfant} niveau={niveau + 1} instanceId={instanceId}\n          selectedComponent={selectedComponent} selectedNode={selectedNode} onSelect={onSelect}\n          ouverts={ouverts} onToggle={onToggle} />\n      ))}\n    </>\n  )\n}\n\n// UNE VIGNETTE DE LA PALETTE, qui sait attendre son déchiffrement.\n//\n// Écrite hors de `MediaApp` pour la même raison que `RangeeNoeud` : un composant défini à\n// l'intérieur d'un autre est recréé à chaque rendu, donc démonté et remonté, et une vignette\n// remontée recommence son déchiffrement à chaque frappe dans le champ de recherche.\nfunction VignetteIndex({ image }) {\n  const [src, setSrc] = React.useState(null)\n  React.useEffect(() => {\n    let vivant = true\n    resolveThumbUrl(image.thumb || image.url).then((u) => { if (vivant) setSrc(u) })\n    return () => { vivant = false }\n  }, [image.path, image.thumb, image.url])\n  // Tant que l'adresse n'est pas résolue, on ne pose AUCUN <img> : un <img> sans source affiche\n  // l'icône d'image cassée, et l'utilisateur conclut que sa bibliothèque est vide.\n  return src ? <img src={src} alt=\"\" /> : <span style={{ opacity: .35, fontSize: 10 }}>…</span>\n}\n\n// LE BOUTON DE VERROU D'UN PANNEAU (famille 1 — sélection et propriétés).\n//\n// Écrit hors de `MediaApp` pour la même raison que `RangeeNoeud` et `VignetteIndex` : un composant\n// défini en ligne est recréé à chaque rendu et démonté à chaque frappe, ce qui aurait perdu le\n// focus du champ d'à côté.\nfunction VerrouPanneau({ verrouille, onClick }) {\n  return (\n    <button className=\"zrm-det-revert\" style={{ color: verrouille ? undefined : 'inherit' }}\n      data-on={verrouille || undefined}\n      title={verrouille ? 'Déverrouiller — le panneau suivra de nouveau la sélection' : 'Verrouiller ce panneau sur cet objet'}\n      onClick={onClick}>\n      <Icon name={verrouille ? 'lock' : 'lock.icloud'} size={11} />\n    </button>\n  )\n}\n\n// LES HUIT ICÔNES D'ALIGNEMENT (famille Photoshop 2), dessinées à la main.\n//\n// Aucune des icônes SF Symbols du projet ne couvre ces huit sens précis. Deux barres de largeurs\n// DIFFÉRENTES, posées contre un guide, sont la convention visuelle que Figma et Photoshop\n// partagent pour l'alignement : la différence de longueur est ce qui rend l'alignement lisible,\n// deux barres identiques ne montreraient rien. La distribution reprend trois carrés égaux séparés\n// de courts traits, pour signifier « des vides rendus égaux ».\nfunction AlignIcon({ mode }) {\n  if (mode === 'dist-x' || mode === 'dist-y') {\n    const x = mode === 'dist-x'\n    return (\n      <svg width=\"13\" height=\"13\" viewBox=\"0 0 14 14\" fill=\"none\" aria-hidden=\"true\">\n        {x ? <>\n          <rect x=\"1\" y=\"4\" width=\"3\" height=\"6\" rx=\"0.5\" fill=\"currentColor\" />\n          <rect x=\"5.5\" y=\"4\" width=\"3\" height=\"6\" rx=\"0.5\" fill=\"currentColor\" opacity=\".55\" />\n          <rect x=\"10\" y=\"4\" width=\"3\" height=\"6\" rx=\"0.5\" fill=\"currentColor\" />\n        </> : <>\n          <rect x=\"4\" y=\"1\" width=\"6\" height=\"3\" rx=\"0.5\" fill=\"currentColor\" />\n          <rect x=\"4\" y=\"5.5\" width=\"6\" height=\"3\" rx=\"0.5\" fill=\"currentColor\" opacity=\".55\" />\n          <rect x=\"4\" y=\"10\" width=\"6\" height=\"3\" rx=\"0.5\" fill=\"currentColor\" />\n        </>}\n      </svg>\n    )\n  }\n  const vertical = mode === 'left' || mode === 'hcenter' || mode === 'right'\n  const guide = { left: 1, hcenter: 7, right: 13 }[mode] ?? { top: 1, vcenter: 7, bottom: 13 }[mode]\n  const barre = (taille, decalage) => {\n    const debut = mode.endsWith('center') || mode === 'hcenter' || mode === 'vcenter'\n      ? guide - taille / 2\n      : (mode === 'right' || mode === 'bottom') ? guide - taille : guide\n    return vertical ? { x: debut, y: decalage, w: taille, h: 3 } : { x: decalage, y: debut, w: 3, h: taille }\n  }\n  const b1 = barre(9, 2), b2 = barre(5, 9)\n  return (\n    <svg width=\"13\" height=\"13\" viewBox=\"0 0 14 14\" fill=\"none\" aria-hidden=\"true\">\n      {vertical\n        ? <line x1={guide} y1=\"0.5\" x2={guide} y2=\"13.5\" stroke=\"currentColor\" strokeWidth=\"1.1\" opacity=\".5\" />\n        : <line x1=\"0.5\" y1={guide} x2=\"13.5\" y2={guide} stroke=\"currentColor\" strokeWidth=\"1.1\" opacity=\".5\" />}\n      <rect x={b1.x} y={b1.y} width={b1.w} height={b1.h} rx=\"0.5\" fill=\"currentColor\" />\n      <rect x={b2.x} y={b2.y} width={b2.w} height={b2.h} rx=\"0.5\" fill=\"currentColor\" opacity=\".7\" />\n    </svg>\n  )\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"6b8c71a4-bf2e-4775-bb32-5a852d61030b"}}}
