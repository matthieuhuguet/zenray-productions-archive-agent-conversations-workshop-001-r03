        viewBox={`0 0 ${format.canvas.w} ${stageHeight}`} preserveAspectRatio=\"none\">\n                    <path d={pathD(traceApercu, false)} fill=\"none\" stroke=\"var(--zrm-accent)\" strokeWidth=\"1.5\" strokeDasharray=\"4 3\" vectorEffect=\"non-scaling-stroke\" />\n                  </svg>\n                  {traceApercu.map((p, i) => (\n                    <i key={i} className=\"zrm-path-anchor\" style={{ left: p.x * fitScale, top: p.y * fitScale, pointerEvents: 'none' }} />\n                  ))}\n                </>\n              )}\n              {showSafe && format.safe && (\n                <div className=\"zrm-safe-overlay\">\n                  <i style={{ left: 0, right: 0, top: 0, height: format.safe.top * fitScale }} />\n                  <i style={{ left: 0, right: 0, bottom: 0, height: format.safe.bottom * fitScale }} />\n                  <i style={{ top: 0, bottom: 0, left: 0, width: format.safe.sides * fitScale }} />\n                  <i style={{ top: 0, bottom: 0, right: 0, width: format.safe.sides * fitScale }} />\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n      </section>\n\n      {/* ---- DECK ---- */}\n      <section className=\"zrm-panel zrm-pane-details zrm-zone-details\">\n        <header className=\"zrm-head\" style={{ gap: 4 }}>\n          {DECK_TABS.map((tab) => (\n            <button key={tab.key} className=\"zrm-tool\" style={{ height: 20, padding: '0 6px' }} data-on={deckTab === tab.key}\n              title={tab.label} aria-label={tab.label} onClick={() => setDeckTab(tab.key)}>\n              <Icon name={tab.icon} size={12} />\n              {tab.key === 'critic' && issues.length ? <b style={{ fontWeight: 400, fontSize: 9 }}>{issues.length}</b> : null}\n            </button>\n          ))}\n        </header>\n  return addLayer(composition, 'shape', {\n    name: 'Tracé', x: Math.round(minX), y: Math.round(minY), w: Math.round(w), h: Math.round(h),\n    pathPoints, pathClosed: !!closed, pathStrokeColor: '#151515',\n  })\n}\n\n/** Les points d'un tracé, convertis de POURCENTAGE (0-100 relatif à la boîte) en PIXELS DU CALQUE —\n * la conversion que la compilation SVG et la couche d'édition doivent appliquer À L'IDENTIQUE :\n * sortie ici une seule fois plutôt que réécrite à deux endroits, au risque d'un jour diverger. */\nexport function pathPointsInPixels(layer) {\n  return (layer.pathPoints || []).map((p) => ({\n    x: (p.x / 100) * layer.w, y: (p.y / 100) * layer.h,\n    inX: (p.inX / 100) * layer.w, inY: (p.inY / 100) * layer.h,\n    outX: (p.outX / 100) * layer.w, outY: (p.outY / 100) * layer.h,\n  }))\n}\n\n/** Déplace l'ancre d'un point : ses DEUX poignées suivent par la même translation, pour que la\n * courbe garde sa forme relative — exactement le comportement de la Sélection directe d'Illustrator. */\nexport function movePathAnchor(points, index, x, y) {\n  const point = points[index]\n  if (!point) return points\n  const dx = x - point.x, dy = y - point.y\n  const suivant = [...points]\n  suivant[index] = { x, y, inX: point.inX + dx, inY: point.inY + dy, outX: point.outX + dx, outY: point.outY + dy }\n  return suivant\n}\n\n/** Déplace UNE SEULE poignée (in ou out), indépendamment de l'autre : c'est ce qui permet de\n * casser la symétrie d'un point lisse et de sculpter la courbe de chaque côté séparément. */\nexport function movePathHandle(points, index, which, x, y) {\n  const point = points[index]\n  if (!point) return points\n  const suivant = [...points]\n  suivant[index] = { ...point, [`${which}X`]: x, [`${which}Y`]: y }\n  return suivant\n}\n\n/** Retire un point du tracé. En dessous de deux points restants, un tracé n'a plus de sens : la\n * fonction ne descend jamais sous ce plancher. */\nexport function removePathPoint(points, index) {\n  if (points.length <= 2) return points\n  return points.filter((_, i) => i !== index)\n}\n\n/** Insère un point d'ANGLE (poignées confondues avec l'ancre) juste après `afterIndex`. */\nexport function insertPathPoint(points, afterIndex, x, y) {\n  const suivant = [...points]\n  suivant.splice(afterIndex + 1, 0, { x, y, inX: x, inY: y, outX: x, outY: y })\n  return suivant\n}\n\n/** Convertit un point d'ANGLE (poignées confondues avec l'ancre) en point LISSE — poignées tirées\n * le long de la tangente aux deux voisins — ou inversement ramène les poignées sur l'ancre : le\n * même geste que double-cliquer une ancre avec la Plume dans Illustrator. Fonctionne aussi en bout\n * de tracé ouvert (un seul voisin) et à seulement deux points, sans branche séparée : la tangente se\n * calcule alors depuis le seul point disponible plutôt que depuis une moyenne. */\nexport function toggleAnchorSmoothness(points, index, closed) {\n  const point = points[index]\n  if (!point) return points\n  const suivant = [...points]\n  const estAngle = point.inX === point.x && point.inY === point.y && point.outX === point.x && point.outY === point.y\n  if (estAngle) {\n    const avant = points[index - 1] ?? (closed ? points[points.length - 1] : null)\n    const apres = points[index + 1] ?? (closed ? points[0] : null)\n    const gauche = avant || point, droite = apres || point\n    const dx = (droite.x - gauche.x) / 6, dy = (droite.y - gauche.y) / 6\n    suivant[index] = { ...point, inX: point.x - dx, inY: point.y - dy, outX: point.x + dx, outY: point.y + dy }\n  } else {\n    suivant[index] = { ...point, inX: point.x, inY: point.y, outX: point.x, outY: point.y }\n  }\n  return suivant\n}\n\nfunction pointSurSegment(p0, p1, p2, p3, t) {\n  const mt = 1 - t\n  const a = mt * mt * mt, b = 3 * mt * mt * t, c = 3 * mt * t * t, d = t * t * t\n  return { x: a * p0.x + b * p1.x + c * p2.x + d * p3.x, y: a * p0.y + b * p1.y + c * p2.y + d * p3.y }\n}\n\n/** Le point le plus proche de (x,y) SUR LA COURBE, échantillonnée à 24 pas par segment — une\n * méthode standard d'approximation, pas une projection exacte, mais un tracé de cette taille ne\n * distinguerait de toute façon pas mieux à l'écran. Sert à poser un nouveau point d'ancrage\n * EXACTEMENT sur le tracé (au double-clic sur un segment), plutôt qu'à l'endroit brut, un peu à\n * côté, où le clic est réellement tombé. */\nexport function nearestPointOnTrace(points, closed, x, y) {\n  if (!Array.isArray(points) || points.length < 2) return null\n  const segments = closed ? points.length : points.length - 1\n  let meilleur = null\n  for (let i = 0; i < segments; i++) {\n    const p0 = points[i], p3 = points[(i + 1) % points.length]\n    for (let pas = 0; pas <= 24; pas++) {\n      const t = pas / 24\n      const echantillon = pointSurSegment(p0, { x: p0.outX, y: p0.outY }, { x: p3.inX, y: p3.inY }, p3, t)\n      const dist = Math.hypot(echantillon.x - x, echantillon.y - y)\n      if (!meilleur || dist < meilleur.dist) meilleur = { dist, afterIndex: i, x: echantillon.x, y: echantillon.y }\n    }\n  }\n  return meilleur ? { afterIndex: meilleur.afterIndex, x: meilleur.x, y: meilleur.y } : null\n}\n\n\n// LA LARGEUR D'UNE COLONNE REDIMENSIONNÉE (carte S3, famille « Docking »), sortie en fonction pure\n// pour la même raison qu'`applyHandle` : jsdom simule mal `PointerEvent.clientX` (limite connue,\n// pas propre à ce projet), donc un glisser réel n'y prouve rien. Le calcul se vérifie ici, en une\n// ligne par cas ; le geste du composant se contente de l'appeler.\n\n  it('le tracé compile en <svg><path> réel, avec le fond et le contour du calque', () => {\n    let c = createPathLayer(vide(), [\n      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n      { x: 100, y: 100, inX: 100, inY: 100, outX: 100, outY: 100 },\n    ], false)\n    const tracé = readLayers(c).find((l) => l.name === 'Tracé')\n    c = patchLayer(c, tracé.id, { style: { backgroundColor: '#ffcc00' } })\n    const { html } = compiler(c)\n    expect(html).toContain('<svg')\n    expect(html).toContain('fill=\"#ffcc00\"')\n    expect(html).toContain('stroke=\"#151515\"')\n  })\n\n  it('un tracé SANS fond réglé ne peint aucune surface (fill=\"none\"), seulement son contour', () => {\n    let c = createPathLayer(vide(), [\n      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n      { x: 100, y: 100, inX: 100, inY: 100, outX: 100, outY: 100 },\n    ], false)\n    const { html } = compiler(c)\n    expect(html).toContain('fill=\"none\"')\n  })\n\n  it('un tracé ne porte JAMAIS l’attribut data-shape : sa géométrie n’est pas une forme paramétrique', () => {\n    let c = createPathLayer(vide(), [\n      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n      { x: 100, y: 100, inX: 100, inY: 100, outX: 100, outY: 100 },\n    ], false)\n    const tracé = readLayers(c).find((l) => l.name === 'Tracé')\n    const { html } = compiler(c)\n    const doc = new DOMParser().parseFromString(html, 'text/html')\n    const el = doc.querySelector(`[data-zrm-layer=\"${tracé.id}\"]`)\n    expect(el.hasAttribute('data-shape')).toBe(false)\n  })\n})\n\n// Carte I2 (suite) — édition d'un tracé DÉJÀ posé : convertir un point, ajouter un point sur un\n// segment existant. La Sélection directe d'Illustrator, plutôt qu'un second outil séparé — ici un\n// seul et même calque de tracé, sélectionné, expose ses points à l'édition.\nimport { toggleAnchorSmoothness, nearestPointOnTrace, pathPointsInPixels } from './layers.js'\n\ndescribe('Illustrator I2 — convertir et insérer un point sur un tracé existant', () => {\n  it('pathPointsInPixels convertit chaque coordonnée de pourcentage (0-100) en pixels réels du calque', () => {\n    const layer = { w: 200, h: 50, pathPoints: [{ x: 0, y: 0, inX: 0, inY: 0, outX: 50, outY: 100 }] }\n    expect(pathPointsInPixels(layer)).toEqual([{ x: 0, y: 0, inX: 0, inY: 0, outX: 100, outY: 50 }])\n  })\n\n  it('convertit un point d’ANGLE en point LISSE : les poignées sortent le long de la tangente aux voisins', () => {\n    const points = [\n      { x: 0, y: 50, inX: 0, inY: 50, outX: 0, outY: 50 },\n      { x: 50, y: 50, inX: 50, inY: 50, outX: 50, outY: 50 },   // point d'angle, au milieu\n      { x: 100, y: 50, inX: 100, inY: 50, outX: 100, outY: 50 },\n    ]\n    const suivant = toggleAnchorSmoothness(points, 1, false)\n    // Voisins alignés sur l'axe x : la tangente est horizontale, les poignées s'écartent en x, pas en y.\n    expect(suivant[1].outX).toBeGreaterThan(50)\n    expect(suivant[1].inX).toBeLessThan(50)\n    expect(suivant[1].outY).toBe(50)\n    expect(suivant[1].inY).toBe(50)\n  })\n\n  it('convertit un point LISSE en point d’ANGLE : les deux poignées reviennent exactement sur l’ancre', () => {\n    const points = [{ x: 50, y: 50, inX: 30, inY: 40, outX: 70, outY: 60 }]\n    const suivant = toggleAnchorSmoothness(points, 0, false)\n    expect(suivant[0]).toEqual({ x: 50, y: 50, inX: 50, inY: 50, outX: 50, outY: 50 })\n  })\n\n  it('convertir le SEUL point d’un bout de tracé ouvert utilise son unique voisin, sans jamais planter', () => {\n    const points = [\n      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },\n    ]\n    const suivant = toggleAnchorSmoothness(points, 0, false)\n    expect(suivant[0].outX).toBeGreaterThan(0)   // tiré vers l'unique voisin, à droite\n  })\n\n  it('nearestPointOnTrace trouve un point EXACTEMENT sur la courbe, près d’un clic à côté d’elle', () => {\n    const points = [\n      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },\n    ]\n    // Segment plat sur y=0 : cliquer à (50, 6) doit accrocher un échantillon proche de (50, 0).\n    const trouve = nearestPointOnTrace(points, false, 50, 6)\n    expect(trouve.afterIndex).toBe(0)\n    expect(trouve.x).toBeCloseTo(50, 0)\n    expect(trouve.y).toBeCloseTo(0, 0)\n  })\n\n  it('nearestPointOnTrace identifie le bon SEGMENT parmi plusieurs, jamais le premier par défaut', () => {\n    const points = [\n      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n      { x: 50, y: 0, inX: 50, inY: 0, outX: 50, outY: 0 },\n      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },\n    ]\n    const trouve = nearestPointOnTrace(points, false, 80, 0)\n    expect(trouve.afterIndex).toBe(1)   // le second segment, entre les points 1 et 2\n  })\n\n  it('insérer via nearestPointOnTrace place le nouveau point SUR la courbe, réellement au milieu', () => {\n    const points = [\n      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },\n    ]\n    const trouve = nearestPointOnTrace(points, false, 50, 0)\n    const suivant = insertPathPoint(points, trouve.afterIndex, trouve.x, trouve.y)\n    expect(suivant).toHaveLength(3)\n    expect(suivant[1].x).toBeCloseTo(50, 0)\n  })\n\n  it('nearestPointOnTrace couvre aussi le segment de FERMETURE d’un tracé fermé', () => {\n    const points = [\n      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },\n      { x: 50, y: 100, inX: 50, inY: 100, outX: 50, outY: 100 },\n    ]\n    // (25, 50) est sur le segment de retour du dernier point (50,100) vers le premier (0,0).\n    const trouve = nearestPointOnTrace(points, true, 25, 50)\n    expect(trouve.afterIndex).toBe(2)\n  })\n})\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"255bb7e6-b68d-4c5c-b91b-c6a1965e3c1d"}}}
