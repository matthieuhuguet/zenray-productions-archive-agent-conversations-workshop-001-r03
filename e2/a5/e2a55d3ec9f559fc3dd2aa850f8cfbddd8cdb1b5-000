ut((c) => updateBeat(c, i, { role: e.target.value }))}>\n                  {BEAT_ROLES.map((r) => <option key={r} value={r}>{ROLE_LABELS[r]}</option>)}\n                </select>\n                <span className=\"zrm-beat-meta\">\n                  {i + 1}/{cut.beats.length}\n                  {isTemporal(format) ? ` · ${beatDuration(beat)}s` : ''}\n                </span>\n              </div>\n              <textarea className=\"zrm-beat-text\" aria-label={`Texte du bloc ${i + 1}`} value={beat.text} onChange={(e) => withCut((c) => updateBeat(c, i, { text: e.target.value }))} />\n              {(beat.slots || []).length > 0 && (\n                <div className=\"zrm-slots-strip\">\n                  {beat.slots.map((slot, si) => (\n                    <div key={si} className=\"zrm-slot-thumb\" title={slot.label || 'image'}>\n                      {slot.dataUrl ? <img src={slot.dataUrl} alt={slot.label || ''} /> : <span>{slot.kind}</span>}\n                      <button className=\"zrm-slot-remove\" title=\"Retirer l’image\" onClick={() => withCut((c) => removeSlot(c, i, si))}>×</button>\n                    </div>\n                  ))}\n                </div>\n              )}\n              <div className=\"zrm-beat-actions\">\n                <label className=\"zrm-btn zrm-btn-sm\" title={`Ajouter une image (${(beat.slots || []).length}/${MAX_SLOTS})`} style={{ cursor: (beat.slots || []).length >= MAX_SLOTS ? 'not-allowed' : 'pointer' }}>\n                  <Icon name=\"photo\" size={12} />\n                  <input type=\"file\" accept=\"image/*\" multiple aria-label={`Images du bloc ${i + 1}`} style={{ display: 'none' }}\n                    disabled={(beat.slots || []).length >= MAX_SLOTS || busy === 'image'}\n                    onChange={(e) => { attachImages(i, e.target.files); e.target.value = '' }} />\n                </label>\n                <button className=\"zrm-btn zrm-btn-sm\" title=\"Monter\" onClick={() => withCut((c) => moveBeat(c, i, Math.max