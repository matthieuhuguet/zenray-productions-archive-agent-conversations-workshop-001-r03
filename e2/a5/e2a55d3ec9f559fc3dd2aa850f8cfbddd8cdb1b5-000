 'none'] },\n]\n\nconst CLEFS_STYLE = new Set(NODE_STYLES.map((s) => s.key))\n\nfunction disponible() {\n  return typeof DOMParser !== 'undefined'\n}\n\n// Le nom lisible d'un nœud. On préfère TOUJOURS ce que l'auteur a écrit à ce que la machine\n// devine : un attribut `data-zrm-name`, puis une classe parlante, puis la balise. Un arbre dont\n// les vingt lignes s'appellent « div » ne sert à rien.\nfunction nommer(el) {\n  const explicite = el.getAttribute?.('data-zrm-name')\n  if (explicite) return explicite\n  const classe = (el.getAttribute?.('class') || '')\n    .split(/\\s+/)\n    .filter(Boolean)\n    .find((c) => c.startsWith('zrm-') && c.length > 6)\n  if (classe) return classe.replace(/^zrm-/, '').replace(/-/g, ' ')\n  const tag = el.tagName.toLowerCase()\n  const titres = { h1: 'Titre 1', h2: 'Titre 2', h3: 'Titre 3', h4: 'Titre 4', p: 'Paragraphe', a: 'Lien', img: 'Image', ul: 'Liste', li: 'Élément', button: 'Bouton', nav: 'Navigation', header: 'En-tête', footer: 'Pied', section: 'Section', figure: 'Figure', time: 'Date', span: 'Texte', svg: 'Icône', use: 'Icône' }\n  return titres[tag] || tag\n}\n\n// Le texte propre d'un nœud, c'est-à-dire celui qu'il porte LUI-MÊME et non celui de ses enfants.\n// La distinction est ce qui rend l'édition sûre : modifier le texte d'un conteneur effacerait\n// toute sa descendance, ce que personne n'attend en tapant dans un champ.\nfunction texteDirect(el) {\n  let out = ''\n  for (const enfant of el.childNodes) {\n    if (enfant.nodeType === 3) out += enfant.nodeValue\n  }\n  return out.trim()\n}\n\nfunction noeudsEnfants(el) {\n  return [...el.children].filter((c) => !IGNORES.has(c.tagName.toUpperCase()))\n}\n\nfunction construire(el, chemin, profondeur) {\n  // Une profondeur maximale, parce qu'un tableau SVG imbriqué produirait des centaines de nœuds\n  // pour une seule icône, et qu'un arbre qu'on ne peut pas parcourir ne vaut pas mieux qu'aucun.\n  const enfants = profondeur >= 6 ? [] : noeudsEnfants(el).map((c, i) => construire(c, chemin ? `${chemin}.${i}` : String(i), profondeur + 1))\n  return {\n    path: chemin,\n    tag: el.tagName.toLowerCase(),\n    name: nommer(el),\n    text: texteDirect(el),\n    editable: texteDirect(el).length > 0,\n    children: enfants,\n  }\n}\n\n/**\n * L'arbre des sous-composants d'une page compilée, indexé par identifiant d'instance.\n * @returns {Record<string, {path:string,tag:string,name:string,text:string,children:any[]}[]>}\n */\nexport function parseTree(html) {\n  if (!disponible() || typeof html !== 'string' || !html) return {}\n  const doc = new DOMParser().parseFromString(html, 'text/html')\n  const out = {}\n  for (const hote of doc.querySelectorAll('[data-zrm-instance]')) {\n    const id = hote.getAttribute('data-zrm-instance')\n    out[id] = noeudsEnfants(hote).map((c, i) => construire(c, String(i), 0))\n  }\n  return out\n}\n\n/** Le nœud désigné par son chemin, ou null. */\nexport function findNode(arbre, instanceId, path) {\n  let liste = arbre?.[instanceId]\n  if (!Array.isArray(liste) || !path) return null\n  const indices = String(path).split('.').map(Number)\n  let noeud = null\n  for (const i of indices) {\n    noeud = liste?.[i]\n    if (!noeud) return null\n    liste = noeud.children\n  }\n  return noeud\n}\n\n/** Le chemin d'un élément DANS son hôte, calculé exactement comme `construire` le numérote. */\nexport function pathOfElement(el, hote) {\n  const indices = []\n  let courant = el\n  while (courant && courant !== hote) {\n    const parent = courant.parentElement\n    if (!parent) return null\n    const fratrie = [...parent.children].filter((c) => !IGNORES.has(c.tagName.toUpperCase()))\n    const i = fratrie.indexOf(courant)\n    if (i < 0) return null\n    indices.unshift(i)\n    courant = parent\n  }\n  return courant === hote ? indices.join('.') : null\n}\n\nfunction styleEnLigne(reglages) {\n  return Object.entries(reglages || {})\n    .filter(([clef, valeur]) => CLEFS_STYLE.has(clef) && typeof valeur === 'string' && valeur.trim())\n    // camelCase vers tiret : `fontSize` devient `font-size`.\n    .map(([clef, valeur]) => `${clef.replace(/[A-Z]/g, (m) => `-${m.toLowerCase()}`)}:${valeur.replace(/[;<>\"']/g, '')}`)\n    .join(';')\n}\n\n/**\n * Applique les réglages de sous-composants à une page compilée.\n *\n * Les réglages arrivent sous la forme `{ [instanceId]: { [path]: { text, style } } }`, exactement\n * la forme sous laquelle ils sont enregistrés dans `item.props.__nodes`. Un chemin devenu\n * introuvable, parce que le composant a changé, est IGNORÉ sans bruit : un réglage orphelin ne doit\n * jamais empêcher une page de se rendre.\n */\nexport function applyOverrides(html, reglagesParInstance) {\n  if (!disponible() || !reglagesParInstance || !Object.keys(reglagesParInstance).length) return html\n  const doc = new DOMParser().parseFromString(html, 'text/html')\n  let touche = false\n\n  for (const [instanceId, reglages] of Object.entries(reglagesParInstance)) {\n    const hote = doc.querySelector(`[data-zrm-instance=\"${CSS.escape ? CSS.escape(instanceId) : instanceId}\"]`)\n    if (!hote) continue\n    for (const [path, reglage] of Object.entries(reglages || {})) {\n      const el = elementAuChemin(hote, path)\n      if (!el) continue\n      if (typeof reglage.text === 'string' && reglage.text !== '') {\n        // On ne remplace QUE les nœuds de texte directs, jamais les enfants : sans cela, régler le\n        // texte d'un conteneur effacerait toute sa descendance en un caractère.\n        let pose = false\n        for (const enfant of [...el.childNodes]) {\n          if (enfant.nodeType !== 3) continue\n          if (pose) { enfant.nodeValue = '' } else { enfant.nodeValue = reglage.text; pose = true }\n        }\n        if (!pose) el.textContent = reglage.text\n        touche = true\n      }\n      const style = styleEnLigne(reglage.style)\n      if (style) {\n        el.setAttribute('style', `${el.getAttribute('style') || ''};${style}`)\n        touche = true\n      }\n    }\n  }\n  if (!touche) return html\n  return `<!doctype html>${doc.documentElement.outerHTML}`\n}\n\nfunction elementAuChemin(hote, path) {\n  let courant = hote\n  for (const i of String(path).split('.').map(Number)) {\n    const enfants = noeudsEnfants(courant)\n    courant = enfants[i]\n    if (!courant) return null\n  }\n  return courant\n}\n\n/** Le nombre de sous-composants d'une instance, replié pour l'affichage. */\nexport function countNodes(liste) {\n  if (!Array.isArray(liste)) return 0\n  return liste.reduce((n, noeud) => n + 1 + countNodes(noeud.children), 0)\n}\n\n/**\n * TOUS LES TEXTES MODIFIABLES d'un sous-arbre, à plat.\n *\n * Matthieu : « le plus important, si je clique sur un élément de texte, c'est de pouvoir modifier\n * le texte à droite, ça me semble évident. » Il a raison, et le panneau ne le permettait pas dans\n * le cas le plus fréquent : on clique rarement PILE sur le nœud qui porte le texte, on clique sur\n * la boîte qui le contient. Le panneau affichait alors « ce nœud n'a pas de texte propre », ce qui\n * est exact et parfaitement inutile.\n *\n * Cette fonction remonte donc les textes de toute la descendance, à plat et dans l'ordre de\n * lecture. Le panneau les offre tous, et le premier champ est toujours un champ de texte.\n */\nexport function collectTexts(liste, max = 24) {\n  const out = []\n  const marcher = (noeuds) => {\n    for (const noeud of noeuds || []) {\n      if (out.length >= max) return\n      if (noeud.editable) out.push({ path: noeud.path, name: noeud.name, tag: noeud.tag, text: noeud.text })\n      marcher(noeud.children)\n    }\n  }\n  marcher(Array.isArray(liste) ? liste : [liste].filter(Boolean))\n  return out\n}\n\n/** Tous les chemins d'un sous-arbre, pour déplier ou replier d'un seul geste. */\nexport function allPaths(liste) {\n  const out = []\n  const marcher = (noeuds) => {\n    for (const noeud of noeuds || []) { out.push(noeud.path); marcher(noeud.children) }\n  }\n  marcher(Array.isArray(liste) ? liste : [liste].filter(Boolean))\n  return out\n}\n# Déposer un thème ZenRayMedia\n\nDeux formes possibles. Dans les deux cas, **déposer le fichier dans ce dossier suffit** : il\napparaît dans le Deck au prochain build, sans toucher une ligne de code.\n\n---\n\n## Forme 1 — gabarit HTML (celle prévue pour tes 1024)\n\n**Nom du fichier obligatoire :** `T-FF-S-V--slug.html`\n\n- `FF` = famille sur 2 chiffres (`01` à `16`, voir `docs/zenraymedia/05-THEMES-1024-*.md`)\n- `S` = sous-famille (`1` à `8`)\n- `V` = variante (`1` à `8`)\n- `slug` = le nom public, en minuscules, tirets pour les espaces\n\nExemple : `T-02-1-1--bandeau-alerte-permanente.html` → apparaît sous « Télévision & broadcast »\navec le nom « Bandeau alerte permanente ».\n\n**Pourquoi le nom porte les métadonnées :** avec 1024 gabarits, lire chaque fichier pour\nconstruire la liste ferait entrer des mégaoctets dans le bundle. Ici, lister le catalogue coûte\n1024 chaînes de caractères ; seul le thème réellement choisi est chargé.\n\nUn fichier mal nommé est **ignoré**, avec un avertissement en console qui rappelle le format.\n\n### En-tête déclaratif (optionnel mais recommandé)\n\nEn tête de fichier, il permet au gabarit de déclarer ce qu'il sait servir :\n\n```html\n<!--zr-theme {\n  \"description\": \"Manchette 6 colonnes, filet fin, une seule photo dominante.\",\n  \"formats\": [\"F-web-article\", \"F-print-a4\", \"F-still-1080x1350\"],\n  \"beatCount\": { \"min\": 4, \"max\": 12 },\n  \"measure\": 64\n} -->\n```\n\nSans lui, le gabarit reste valide et prend les valeurs neutres (format web seul, 1 à 24 blocs).\nL'en-tête n'a **aucun droit** sur l'identité : l'`id` et le nom public viennent du nom de fichier,\nseule source de vérité du catalogue. Un en-tête au JSON invalide n'empêche jamais le gabarit de\nfonctionner : il est signalé en console et les valeurs par défaut s'appliquent.\n\n**Reconstruire un thème à partir de captures d'écran :** méthode complète dans\n`docs/zenraymedia/07-PROMPT-THEME-DEPUIS-CAPTURES.md` (mesure image par image, correspondance\nrôle → composant, QA par le Critique).\n\n### Ce que le gabarit reçoit\n\nQuatre constructions, pas une de plus (`htmlTemplate.js`) :\n\n| Écrire | Effet |\n|---|---|\n| `{{champ}}` | valeur, échappée |\n| `{{{champ}}}` | valeur brute (HTML) |\n| `{{#beats}} … {{/beats}}` | répète le bloc sur chaque beat |\n| `{{^beats}} … {{/beats}}` | affiché seulement si la liste est vide |\n\n**Champs de la page :** `title`, `message`, `audience`, `register`, `intent`, `themeName`,\n`formatLabel`, `readingMinutes`, `words`, `duration`, `dark`, `scale`.\n\n**Champs disponibles dans un bloc `beats` :** `number`, `index`, `role`, `roleLabel`, `text`,\n`html`, `weight`, `tempo`, `duration`, `isFirst`, `isLast`.\n\n### Squelette minimal\n\n```html\n<!doctype html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>{{title}}</title>\n  <style>\n    /* Tout le style vit ici. Aucune ressource externe : la page doit rester autonome. */\n    body { margin: 0; font-family: 'AnthropicSans', system-ui, sans-serif; }\n    .beat { max-width: 62ch; margin: 0 auto 2rem; }\n  </style>\n</head>\n<body>\n  <h1>{{title}}</h1>\n  <p>{{message}}</p>\n  {{#beats}}\n    <section class=\"beat\" data-role=\"{{role}}\">\n      <span>{{number}} · {{roleLabel}}</span>\n      <p>{{text}}</p>\n    </section>\n  {{/beats}}\n  {{^beats}}<p>Aucun beat.</p>{{/beats}}\n</body>\n</html>\n```\n\n### Deux règles à respecter\n\n1. **Aucune ressource externe** (police, image, feuille de style distante). La page compilée doit\n   s'ouvrir hors ligne à l'identique. Les polices du projet sont disponibles par leur nom :\n   `AnthropicSerif`, `AnthropicSans`, `AnthropicMono`.\n2. **Consommer `{{title}}` et `{{#beats}}`.** Un gabarit qui ne les utilise pas est muet : le\n   contenu du brief n'apparaît nulle part.\n\n---\n\n## Forme 2 — thème à tokens (`T-FF-S-V.theme.js`)\n\nPour un thème piloté par des décisions plutôt que par une mise en page figée. Le compilateur\nfabrique alors le CSS depuis les **sept groupes** de `docs/zenraymedia/01-PLAN.md §10.2` :\n`surface`, `palette`, `typography`, `grid`, `motion`, `chrome`, `sound`.\n\nRéférence à copier : `T-01-3-2.theme.js`.\n\nAvantage : le thème s'adapte à **tous les formats** (article, image, affiche, vidéo) sans\nréécriture. Un gabarit HTML, lui, décrit une mise en page et vise surtout l'article.\n\n---\n\n## Règle de marque, sans exception\n\nLe nom public d'un thème est un **archétype de genre** (« chaîne d'info continue »), jamais une\nmarque déposée. La référence de calibrage vit dans le champ privé `calibration.ref`, jamais rendu,\njamais poussé. Un thème dont le nom contient une marque connue est **refusé au chargement** par\n`validateTheme` (`contracts.js`).\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"255bb7e6-b68d-4c5c-b91b-c6a1965e3c1d"}}}
