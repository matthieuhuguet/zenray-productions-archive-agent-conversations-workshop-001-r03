estantes[index] || restantes[index - 1] || null)?.id ?? null\n   748\t    : composition.activeSlideId\n   749\t  return { ...suivant, slides: restantes, activeSlideId }\n   750\t}\n   751\t\n   752\t/** Duplique une diapositive et tout son contenu, dans un groupe neuf, et l'active. */\n   753\texport function duplicateSlide(composition, slideId) {\n   754\t  const slides = readSlides(composition)\n   755\t  const slide = slides.find((s) => s.id === slideId)\n   756\t  if (!slide) return composition\n   757\t  const membres = readLayers(composition).filter((l) => l.groupId === slide.groupId)\n   758\t  const seed = `${composition?.themeId || 'sans-theme'}:diapositive`\n   759\t  let serial = composition?.serial || 0\n   760\t  let z = nextZ(composition)\n   761\t  serial += 1\n   762\t  const groupId = makeId('grp', seed, serial)\n   763\t  const slideIdCopie = makeId('sld', `${seed}:copie`, serial)\n   764\t  const nom = `${slide.name} copie`\n   765\t  const nouveauxCalques = membres.map((m) => {\n   766\t    serial += 1\n   767\t    z += 1\n   768\t    return { ...m, id: makeId('lay', `${seed}:calque`, serial), serial, z, groupId }\n   769\t  })\n   770\t  const groups = [...readGroups(composition), { id: groupId, name: nom, hidden: false, locked: false }]\n   771\t  return {\n   772\t    ...composition,\n   773\t    serial,\n   774\t    layers: [...readLayers(composition), ...nouveauxCalques],\n   775\t    groups,\n   776\t    slides: [...slides, { id: slideIdCopie, name: nom, groupId }],\n   777\t    activeSlideId: slideIdCopie,\n   778\t  }\n   779\t}\n   780\t\n   781\t/** Déplace une diapositive d'un rang dans l'ordre de la Trieuse — jamais hors bornes. */\n   782\texport function reorderSlide(composition, slideId, direction) {\n   783\t  const slides = readSlides(composition)\n   784\t  const i = slides.findIndex((s) => s.id === slideId)\n   785\t  if (i < 0) return composition\n   786\t  const j = direction === 'up' ? i - 1 : i + 1\n   787\t  if (j < 0 || j >= slides.length) return composition\n   788\t  const suivant = [...slides]\n   789\t  ;[suivant[i], suivant[j]] = [suivant[j], suivant[i]]\n   790\t  return { ...composition, slides: suivant }\n   791\t}\n   792\t\n   793\t/** Change la diapositive active, celle que l'aperçu affiche seule. */\n   794\texport function setActiveSlide(composition, slideId) {\n   795\t  if (!readSlides(composition).some((s) => s.id === slideId)) return composition\n   796\t  return { ...composition, activeSlideId: slideId }\n   797\t}\n   798\t\n   799\t/** Un calque est effectivement masqué s'il l'est lui-même, si son groupe l'est, OU s'il appartient\n   800\t * à une diapositive qui n'est pas l'active — un calque sans diapositive reste un masque visible\n   801\t * sur toutes les diapositives. */\n   802\texport function isEffectivelyHidden(composition, layer) {\n   803\t  if (layer.hidden) return true\n   804\t  if (!layer.groupId) return false\n   805\t  if (readGroups(composition).find((g) => g.id === layer.groupId)?.hidden) return true\n   806\t  const slides = readSlides(composition)\n   807\t  if (composition?.activeSlideId && slides.some((s) => s.id === composition.activeSlideId)) {\n   808\t    const slide = slides.find((s) => s.groupId === layer.groupId)\n   809\t    if (slide && slide.id !== composition.activeSlideId) return true\n   810\t  }\n   811\t  return false\n   812\t}\n   813\t\n   814\texport function isEffectivelyLocked(composition, layer) {\n   815\t  if (layer.locked) return true\n   816\t  if (!layer.groupId) return false\n   817\t  return !!readGroups(composition).find((g) => g.id === layer.groupId)?.locked\n   818\t}\n   819\t\n   820\t// ═══════════════════════════════════════════════════════════════════════════════════════════════\n   821\t// FAMILLE FIGMA 3 · CONTRAINTES (carte F3, 2026-08-04)\n   822\t//\n   823\t// « Lorsque la frame est redimensionnée, l'enfant reste attaché, centré, étiré ou mis à l'échelle\n   824\t// selon le réglage. » Le canevas de ZenRayMedia change de taille chaque fois qu'on change de\n   825\t// FORMAT (carré, 9:16, A4…) : sans contrainte, un logo posé en haut à gauche d'un carré 1080\n   826\t// resterait à la même position en pixels dans un A4 de 2480 px de large, donc visuellement\n   827\t// rétréci dans un coin, jamais là où l'auteur l'avait posé PAR RAPPORT au cadre.\n   828\t// ═══════════════════════════════════════════════════════════════════════════════════════════════\n   829\t\n   830\t/**\n   831\t * La géométrie d'un calque après un changement des dimensions du canevas.\n   832\t * Fonction PURE : mêmes entrées, même sortie, aucune dépendance à React ni au DOM.\n   833\t */\n   834\texport function applyConstraints(layer, oldCanvas, newCanvas) {\n   835\t  const dW = newCanvas.w - oldCanvas.w\n   836\t  const dH = (newCanvas.h || oldCanvas.h) - oldCanvas.h\n   837\t  let { x, y, w, h } = layer\n   838\t\n   839\t  if (layer.constrainH === 'right') x = layer.x + dW\n   840\t  else if (layer.constrainH === 'center') x = layer.x + dW / 2\n   841\t  else if (layer.constrainH === 'scale' && oldCanvas.w > 0) {\n   842\t    const echelle = newCanvas.w / oldCanvas.w\n   843\t    x = layer.x * echelle; w = layer.w * echelle\n   844\t  }\n   845\t  // 'left' : x et w ne bougent pas, la distance au bord gauche est ce qui reste fixe.\n   846\t\n   847\t  if (oldCanvas.h > 0 && newCanvas.h > 0) {\n   848\t    if (layer.constrainV === 'bottom') y = layer.y + dH\n   849\t    else if (layer.constrainV === 'center') y = layer.y + dH / 2\n   850\t    else if (layer.constrainV === 'scale') {\n   851\t      const echelleV = newCanvas.h / oldCanvas.h\n   852\t      y = layer.y * echelleV; h = layer.h * echelleV\n   853\t    }\n   854\t  }\n   855\t  // Un canevas à hauteur LIBRE (format web, sans oldCanvas.h/newCanvas.h) n'a pas de bord bas à\n   856\t  // mesurer : la contrainte verticale ne peut alors s'appliquer, et 'top' reste le seul sens.\n   857\t\n   858\t  return { x: Math.round(x), y: Math.round(y), w: Math.max(1, Math.round(w)), h: Math.max(1, Math.round(h)) }\n   859\t}\n   860…5767 tokens truncated…ement inutile.\n   215\t *\n   216\t * Cette fonction remonte donc les textes de toute la descendance, à plat et dans l'ordre de\n   217\t * lecture. Le panneau les offre tous, et le premier champ est toujours un champ de texte.\n   218\t */\n   219\texport function collectTexts(liste, max = 24) {\n   220\t  const out = []\n   221\t  const marcher = (noeuds) => {\n   222\t    for (const noeud of noeuds || []) {\n   223\t      if (out.length >= max) return\n   224\t      if (noeud.editable) out.push({ path: noeud.path, name: noeud.name, tag: noeud.tag, text: noeud.text })\n   225\t      marcher(noeud.children)\n   226\t    }\n   227\t  }\n   228\t  marcher(Array.isArray(liste) ? liste : [liste].filter(Boolean))\n   229\t  return out\n   230\t}\n   231\t\n   232\t/** Tous les chemins d'un sous-arbre, pour déplier ou replier d'un seul geste. */\n   233\texport function allPaths(liste) {\n   234\t  const out = []\n   235\t  const marcher = (noeuds) => {\n   236\t    for (const noeud of noeuds || []) { out.push(noeud.path); marcher(noeud.children) }\n   237\t  }\n   238\t  marcher(Array.isArray(liste) ? liste : [liste].filter(Boolean))\n   239\t  return out\n   240\t}\n\n--- 5 ---\n     1\t// ZenRayMedia — L5/L9 : l'ARBRE DE DÉCLINAISONS.\n     2\t//\n     3\t// C'est la thèse du produit rendue visible : `Livrable = Rendu(Brief × Thème × Format)`.\n     4\t// Jusqu'ici l'application n'affichait qu'UN format à la fois — on devait cliquer une pastille\n     5\t// pour découvrir qu'un texte ne tenait pas en 1:1. L'arbre montre les sorties SIMULTANÉMENT,\n     6\t// avec le verdict du Critique sur chacune, avant d'avoir cliqué quoi que ce soit.\n     7\t//\n     8\t// Inspiré de l'éditeur de référence de Matthieu (`zenraymediav1-editor.html`), qui présente\n     9\t// « YouTube 16:9 · Reel 9:16 · Carrousel 4:5 · Infolettre · Images » comme un arbre sous une\n    10\t// source unique. La différence ici : chaque branche porte son état RÉEL, pas une décoration.\n    11\t\n    12\timport { FORMATS, getFormat, isTemporal, durationOf } from './formats.js'\n    13\timport { visibleBeats, omittedCount, readingTimeOf } from './compile.js'\n    14\timport { inspectStatic, summarize } from './critic.js'\n    15\t\n    16\t/**\n    17\t * Les groupes de déclinaisons proposés par défaut.\n    18\t * Un groupe n'est PAS un format : c'est une intention de diffusion, qui se traduit en un ou\n    19\t * plusieurs formats. « Réseaux » veut dire trois sorties, pas une.\n    20\t */\n    21\texport const DECLENSION_GROUPS = [\n    22\t  { id: 'lecture', label: 'Lecture', formats: ['F-web-article', 'F-print-a4'] },\n    23\t  { id: 'reseaux', label: 'Réseaux', formats: ['F-still-1080-square', 'F-still-1080x1350', 'F-still-1080x1920'] },\n    24\t  { id: 'ecran', label: 'Écran', formats: ['F-video-1920x1080', 'F-overlay-1920x1080'] },\n    25\t]\n    26\t\n    27\t/**\n    28\t * État d'une déclinaison, calculé sans rien rendre : ce que le format montre, ce qu'il laisse\n    29\t * de côté, sa durée s'il est temporel, et le verdict du Critique.\n    30\t */\n    31\texport function declensionState({ brief, cut, theme, format, dark = false }) {\n    32\t  const shown = visibleBeats(cut, format).length\n    33\t  const omitted = omittedCount(cut, format)\n    34\t  const issues = inspectStatic({ brief, cut, theme, format, dark })\n    35\t  const verdict = summarize(issues)\n    36\t  return {\n    37\t    formatId: format.id,\n    38\t    label: format.label,\n    39\t    short: format.short,\n    40\t    kind: format.kind,\n    41\t    canvas: format.canvas,\n    42\t    ratio: format.canvas.h > 0 ? format.canvas.w / format.canvas.h : null,\n    43\t    shown,\n    44\t    omitted,\n    45\t    total: shown + omitted,\n    46\t    duration: isTemporal(format) ? durationOf(cut, format) : 0,\n    47\t    declared: Array.isArray(theme?.formats) ? theme.formats.includes(format.id) : true,\n    48\t    blocking: verdict.blocking.length,\n    49\t    warnings: verdict.warnings.length,\n    50\t    ready: verdict.canPublish,\n    51\t    issues,\n    52\t  }\n    53\t}\n    54\t\n    55\t/** L'arbre complet, groupé par intention de diffusion. */\n    56\texport function declensionTree({ brief, cut, theme, dark = false, groups = DECLENSION_GROUPS }) {\n    57\t  if (!brief || !cut || !theme) return []\n    58\t  return groups.map((group) => {\n    59\t    const branches = group.formats\n    60\t      .map((id) => getFormat(id))\n    61\t      .filter(Boolean)\n    62\t      .map((format) => declensionState({ brief, cut, theme, format, dark }))\n    63\t    return {\n    64\t      ...group,\n    65\t      branches,\n    66\t      ready: branches.filter((b) => b.ready).length,\n    67\t      total: branches.length,\n    68\t      // Un groupe est en défaut dès qu'UNE de ses branches l'est : on ne moyenne pas un blocage.\n    69\t      blocking: branches.reduce((n, b) => n + b.blocking, 0),\n    70\t    }\n    71\t  })\n    72\t}\n    73\t\n    74\t/** Résumé d'une passe complète, pour l'en-tête de l'arbre. */\n    75\texport function declensionSummary(tree) {\n    76\t  const branches = tree.flatMap((g) => g.branches)\n    77\t  return {\n    78\t    total: branches.length,\n    79\t    ready: branches.filter((b) => b.ready).length,\n    80\t    blocking: branches.reduce((n, b) => n + b.blocking, 0),\n    81\t    // Formats que le thème ne déclare pas : ils rendront quand même, mais approximativement.\n    82\t    undeclared: branches.filter((b) => !b.declared).map((b) => b.formatId),\n    83\t  }\n    84\t}\n    85\t\n    86\t/**\n    87\t * Estimation du travail restant, en mots, pour qu'un format cesse de tronquer.\n    88\t * Sert à dire « il te manque de la place », pas seulement « ça déborde ».\n    89\t */\n    90\texport function trimAdvice(cut, format) {\n    91\t  const omitted = omittedCount(cut, format)\n    92\t  if (omitted <= 0) return null\n    93\t  const hidden = (cut?.beats || []).slice(visibleBeats(cut, format).length)\n    94\t  const words = hidden.reduce((n, b) => n + String(b.text || '').trim().split(/\\s+/).filter(Boolean).length, 0)\n    95\t  return { omitted, words, minutes: readingTimeOf({ beats: hidden }).minutes }\n    96\t}\n\n--- 6 ---\n     1\t// ZenRayMedia — catalogue de composants construit depuis les registres déjà présents.\n     2\t// Vite produit un chunk par registre/partie : ouvrir Media ne télécharge que le thème actif,\n     3\t// jamais les 162 composants d'un coup.\n     4\t\n     5\timport tokens0111 from './themes/T-01-1-1--une-nationale-du-matin/tokens.css?raw'\n     6\timport tokens0112 from './themes/T-01-1-2--une-de-rupture/tokens.css?raw'\n     7\timport tokens0113 from './themes/T-01-1-3--quotidien-de-reference-sobre/tokens.css?raw'\n     8\timport tokens0114 from './themes/T-01-1-4--quotidien-economique-saumon/tokens.css?raw'\n     9\timport tokens0115 from './themes/T-01-1-5--tabloid-daccroche/tokens.css?raw'\n    10\timport tokens0411 from './themes/T-04-1-1--revelation-cinematique/tokens.css?raw'\n    11\t\n    12\tconst registries = import.meta.glob('./themes/*/component-registry.json', { import: 'default' })\n    13\tconst parts = import.meta.glob('./themes/*/parts/*.html', { query: '?raw', import: 'default' })\n    14\tconst tokenSheets = {\n    15\t  'T-01-1-1': tokens0111,\n    16\t  'T-01-1-2': tokens0112,\n    17\t  'T-01-1-3': tokens0113,\n    18\t  'T-01-1-4': tokens0114,\n    19\t  'T-01-1-5': tokens0115,\n    20\t  'T-04-1-1': tokens0411,\n    21\t}\n    22\t\n    23\tfunction themeDirectory(themeId) {\n    24\t  const prefix = `./themes/${themeId}--`\n    25\t  const key = Object.keys(registries).find((path) => path.startsWith(prefix))\n    26\t  return key ? key.slice('./themes/'.length, key.indexOf('/component-registry.json')) : null\n    27\t}\n    28\t\n    29\texport async function loadThemeComponents(themeId) {\n    30\t  const directory = themeDirectory(themeId)\n    31\t  if (!directory) return { themeId, directory: null, components: [], tokensCss: '', definitionsHtml: '' }\n    32\t\n    33\t  const registryKey = `./themes/${directory}/component-registry.json`\n    34\t  const registry = await registries[registryKey]()\n    35\t  const tokensCss = tokenSheets[themeId] || ''\n    36\t\n    37\t  const entries = Array.isArray(registry) ? registry : (registry.components || [])\n    38\t  const components = await Promise.all(entries.map(async (entry) => {\n    39\t    // Le registre pointe vers les pages de documentation autonomes `components/`. L'éditeur\n    40\t    // charge leurs homologues légers `parts/`, faits pour être assemblés dans une même page.\n    41\t    const key = `./themes/${directory}/parts/${String(entry.file).split('/').pop()}`\n    42\t    const html = parts[key] ? await parts[key]() : ''\n    43\t    return { ...entry, html }\n    44\t  }))\n    45\t  const definitionsHtml = components.find((entry) => entry.id === '00-icons')?.html || ''\n    46\t  return { themeId, directory, components, tokensCss, definitionsHtml }\n    47\t}\n    48\t\n    49\texport function groupComponents(components) {\n    50\t  return (components || []).reduce((groups, component) => {\n    51\t    const key = component.group || 'Autres'\n    52\t    ;(groups[key] = groups[key] || []).push(component)\n    53\t    return groups\n    54\t  }, {})\n    55\t}\n     1\t// ZenRayMedia — L4 : le registre de thèmes.\n     2\t//\n     3\t// C'EST LA PIÈCE D'EXTENSIBILITÉ. Elle répond à la contrainte : « je vais t'ajouter des thèmes\n     4\t// au compte-goutte, à terme au moins 1024 HTML interchangeables ».\n     5\t//\n     6\t// Deux formes de thème, découvertes AUTOMATIQUEMENT par Vite, sans jamais toucher au code :\n     7\t//\n     8\t//   1. `T-FF-S-V.theme.js`            -> thème à tokens (les 7 groupes de 01-PLAN §10.2).\n     9\t//   2. `T-FF-S-V--mon-slug.html`      -> gabarit HTML brut (celui que tu produis à la main).\n    10\t//\n    11\t// Déposer un fichier dans ce dossier SUFFIT : il apparaît dans le Deck au prochain build.\n    12\t//\n    13\t// COÛT À L'ÉCHELLE (décision d'architecture, pas une optimisation) : les métadonnées d'un\n    14\t// thème HTML sont dérivées de son NOM DE FICHIER, jamais de son contenu. Lire 1024 fichiers\n    15\t// HTML pour construire la liste ferait entrer des mégaoctets dans le bundle. Ici, lister\n    16\t// 1024 thèmes coûte 1024 chaînes de caractères ; seul le thème RÉELLEMENT choisi est chargé.\n    17\t\n    18\timport { parseThemeFileName, parseThemeId, FAMILIES } from '../taxonomy.js'\n    19\timport { validate } from '../contracts.js'\n    20\timport { defaultFontFor } from '../themeFonts.js'\n    21\t\n    22\t// Thèmes à tokens : peu nombreux, curatés, chargés d'emblée (quelques kilo-octets).\n    23\tconst JS_THEMES = import.meta.glob('./*.theme.js', { eager: true })\n    24\t// Gabarits HTML : potentiellement des centaines. Chargement PARESSEUX, un par un.\n    25\tconst HTML_THEMES = import.meta.glob('./*.html', { query: '?raw', import: 'default' })\n    26\t\n    27\tfunction entriesFromJs() {\n    28\t  const out = []\n    29\t  for (const [path, mod] of Object.entries(JS_THEMES)) {\n    30\t    const theme = mod?.default\n    31\t    if (!theme?.id) continue\n    32\t    const parsed = parseThemeId(theme.id)\n    33\t    if (!parsed) continue\n    34\t    out.push({\n    35\t      id: theme.id,\n    36\t      name: theme.name || parsed.id,\n    37\t      description: theme.description || '',\n    38\t      family: parsed.family,\n    39\t      familyLabel: parsed.familyLabel,\n    40\t      sub: parsed.sub,\n    41\t      variant: parsed.variant,\n    42\t      formats: Array.isArray(theme.formats) ? theme.formats : ['F-web-article'],\n    43\t      source: 'js',\n    44\t      path,\n    45\t    })\n    46\t  }\n    47\t  return out\n    48\t}\n    49\t\n    50\tfunction entriesFromHtml() {\n    51\t  const out = []\n    52\t  for (const path of Object.keys(HTML_THEMES)) {\n    53\t    const parsed = parseThemeFileName(path)\n    54\t    if (!parsed) {\n    55\t      // Nom de fichier hors contrat : on l'ignore SILENCIEUSEMENT côté produit, mais on le\n    56\t      // signale en console pour que l'auteur du gabarit comprenne pourquoi il n'apparaît pas.\n    57\t      if (typeof console !== 'undefined') console.warn(`[zenraymedia] gabarit ignoré (nom attendu : T-FF-S-V--slug.html) : ${path}`)\n    58\t      continue\n    59\t    }\n    60\t    out.push({\n    61\t      id: parsed.id,\n    62\t      name: parsed.name,\n    63\t      description: `Gabarit HTML — ${parsed.familyLabel}.`,\n    64\t      family: parsed.family,\n    65\t      familyLabel: parsed.familyLabel,\n    66\t      sub: parsed.sub,\n    67\t      variant: parsed.variant,\n    68\t      formats: ['F-web-article'],\n    69\t      source: 'html',\n    70\t      path,\n    71\t    })\n    72\t  }\n    73\t  return out\n    74\t}\n    75\t\n    76\t// Liste complète, triée par identifiant. Les thèmes à tokens gagnent en cas de doublon d'id :\n    77\t// un gabarit HTML ne doit pas pouvoir masquer un thème curaté.\n    78\texport function listThemes() {\n    79\t  const js = entriesFromJs()\n    80\t  const taken = new Set(js.map((e) => e.id))\n    81\t  const html = entriesFromHtml().filter((e) => !taken.has(e.id))\n    82\t  return [...js, ...html].sort((a, b) => a.id.localeCompare(b.id))\n    83\t}\n    84\t\n    85\texport function listFamilies() {\n    86\t  const present = new Set(listThemes().map((e) => e.family))\n    87\t  return Object.entries(FAMILIES)\n    88\t    .filter(([code]) => present.has(code))\n    89\t    .map(([code, label]) => ({ code, label, count: listThemes().filter((e) => e.family === code).length }))\n    90\t}\n    91\t\n    92\texport function findEntry(id) { return listThemes().find((e) => e.id === id) || null }\n    93\t\n    94\t// En-tête déclaratif OPTIONNEL d'un gabarit HTML, en tête de fichier :\n    95\t//\n    96\t//   <!--zr-theme { \"description\": \"...\", \"formats\": [\"F-web-article\",\"F-print-a4\"],\n    97\t//                  \"beatCount\": { \"min\": 3, \"max\": 12 }, \"measure\": 64 } -->\n    98\t//\n    99\t// Sans lui, le gabarit reste parfaitement valide et prend les valeurs neutres ci-dessous :\n   100\t// c'est le chemin le plus court pour déposer un fichier. Avec lui, un gabarit reconstruit à\n   101\t// partir de captures d'écran déclare les formats qu'il sait VRAIMENT servir au lieu d'être\n   102\t// cantonné au web. L'en-tête est lu APRÈS chargement du fichier : il ne coûte donc rien au\n   103\t// listing du catalogue, qui ne lit que les noms de fichiers -- c'est ce qui tient à 1024.\n   104\texport function readThemeHeader(html) {\n   105\t  const match = /<!--\\s*zr-theme\\s*([\\s\\S]*?)-->/i.exec(String(html || ''))\n   106\t  if (!match) return {}\n   107\t  try {\n   108\t    const parsed = JSON.parse(match[1].trim())\n   109\t    return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {}\n   110\t  } catch {\n   111\t    // Un en-tête malformé ne doit JAMAIS empêcher le gabarit de fonctionner : on le signale\n   112\t    // à l'auteur et on repart des valeurs neutres.\n   113\t    if (typeof console !== 'undefined') console.warn('[zenraymedia] en-tête <!--zr-theme …--> illisible (JSON invalide) : valeurs par défaut appliquées.')\n   114\t    return {}\n   115\t  }\n   116\t}\n   117\t\n   118\t// Groupes par défaut d'un gabarit HTML : il apporte sa mise en page, pas ses tokens.\n   119\t// Ces valeurs neutres existent pour que `validateTheme` passe et que le Critique ait des\n   120\t// seuils à vérifier, jamais pour imposer un style au gabarit.\n   121\tfunction htmlThemeShell(entry, html) {\n   122\t  return {\n   123\t    id: entry.id,\n   124\t    name: entry.name,\n   125\t    description: entry.description,\n   126\t    cal