ce n'est plus un polygone) ; 12 au plus, au-delà la forme se\n      // confond visuellement avec une ellipse et le réglage ne sert plus à rien.\n      shapeSides: Math.min(12, Math.max(3, Math.round(nombre(l.shapeSides, 6)))),\n      shapeStarRatio: Math.min(0.9, Math.max(0.1, nombre(l.shapeStarRatio, 0.5))),\n      fillType: FILL_TYPES.includes(l.fillType) ? l.fillType : 'solid',\n      gradientFrom: typeof l.gradientFrom === 'string' && HEX_RE.test(l.gradientFrom) ? l.gradientFrom : '#6fb6ed',\n      gradientTo: typeof l.gradientTo === 'string' && HEX_RE.test(l.gradientTo) ? l.gradientTo : '#4371ee',\n      gradientAngle: ((Math.round(nombre(l.gradientAngle, 135)) % 360) + 360) % 360,\n      listStyle: LIST_STYLES.includes(l.listStyle) ? l.listStyle : 'none',\n      href: typeof l.href === 'string' ? l.href : '',\n      ...normaliserTableau(l),\n      animationStyle: ANIMATION_STYLES.includes(l.animationStyle) ? l.animationStyle : 'none',\n      animationDelay: Math.min(3000, Math.max(0, Math.round(nombre(l.animationDelay, 0)))),\n      connectFrom: typeof l.connectFrom === 'string' && l.connectFrom && l.connectFrom !== l.id && idsConnus.has(l.connectFrom) ? l.connectFrom : '',\n      connectTo: typeof l.connectTo === 'string' && l.connectTo && l.connectTo !== l.id && idsConnus.has(l.connectTo) ? l.connectTo : '',\n      connectorX1: nombre(l.connectorX1, 0), connectorY1: nombre(l.connectorY1, 0),\n      connectorX2: nombre(l.connectorX2, 0), connectorY2: nombre(l.connectorY2, 0),\n      ...normaliserTrace(l),\n      focalX: Math.min(100, Math.max(0, nombre(l.focalX, 50))), focalY: Math.min(100, Math.max(0, nombre(l.focalY, 50))),\n      constrainH: CONSTRAINTS_H.includes(l.constrainH) ? l.constrainH : 'left',\n      constrainV: CONSTRAINTS_V.includes(l.constrainV) ? l.constrainV : 'top',\n      opacity: Math.min(1, Math.max(0, nombre(l.opacity, 1))),\n      blend: BLEND_MODES.includes(l.blend) ? l.blend : 'normal',\n      hidden: !!l.hidden, locked: !!l.locked,\n