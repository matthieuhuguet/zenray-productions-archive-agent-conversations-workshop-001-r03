<span className=\"zrm-mono\" style={{ opacity: .5, fontSize: 10.5 }}>\n          {format.canvas.w}{format.canvas.h ? `×${format.canvas.h}` : ' · libre'} · {Math.round(fitScale * 100)} %\n        </span>\n        <span style={{ marginLeft: 'auto', opacity: .6 }}>\n          {countItems(composition)} pièce{countItems(composition) > 1 ? 's' : ''} posée{countItems(composition) > 1 ? 's' : ''}\n        </span>\n      </div>\n\n      {/* ZONE 7 · ANIMATIONS. La timeline est HORS V1 par décision écrite du plan : elle\n          réinventerait `cut.js`, qui est déjà la partition temporelle du produit, et son champ\n          serait détruit à chaque geste tant que le contrat n'a pas été ouvert pour elle. La zone\n          existe donc, vide et nommée, plutôt qu'absente : une zone manquante se redécouvre, une\n          zone vide s'explique. */}\n      <section className=\"zrm-panel zrm-zone-anim\">\n        <header className=\"zrm-head\" style={{ cursor: 'pointer' }} onClick={() => setAnimOpen((v) => !v)}\n          title={animOpen ? 'Replier la bande' : 'Déplier la bande'}>\n          <span className=\"zrm-twist\" data-open={animOpen}><Icon name=\"chevron.right\" size={9} /></span>\n          <span className=\"zrm-head-title\">Animations</span>\n          <span className=\"zrm-head-spacer\" />\n          <span className=\"zrm-mono\" style={{ fontSize: 10, opacity: .55 }}>\n            {tlTotal ? `${tlTotal}${tlUnit} · ${cut?.beats.length || 0} piste(s)` : 'aucune piste'}\n          </span>\n        </header>\n        {/* La bande est PEUPLÉE de la partition qui existe déjà, `cut.js`, au lieu d'être laissée\n            vide en attendant une timeline. Chaque bloc de l'article y devient un clip dont la\n            largeur vaut sa part réelle de la durée : on lit d'un coup d'œil quel bloc mange le\n            temps. Aucun clip ne se déplace encore, et la mention du bas le dit franchement plutôt\n            que de laisser croire à une poignée. */}\n        {!animOpen ? null : !cut || !cut.beats.length ? (\n          <div className=\"zrm-tl-empty\">Aucun bloc. La bande se peuple dès que l’article est monté.</div>\n        ) : (\n          <div className=\"zrm-tl\">\n            <div className=\"zrm-tl-side\">\n              {cut.beats.map((beat, i) => (\n                <button key={beat.id} className=\"zrm-tree-row\" style={{ '--zrm-indent': '4px' }} data-on={i === selectedBeat}\n                  onClick={() => { setSelectedBeat(i); setDeckTab('contenu') }} title={beat.text.slice(0, 90)}>\n                  <span className=\"zrm-tree-glyph\">{i + 1}</span>\n                  <span className=\"zrm-tree-name\">{ROLE_LABELS[beat.role] || beat.role}</span>\n                </button>\n              ))}\n            </div>\n            <div className=\"zrm-tl-main\">\n              <div className=\"zrm-tl-ruler\">\n                {Array.from({ length: 6 }, (_, i) => (\n                  <b key={i} style={{ left: `${(i / 6) * 100}%` }}>{Math.round((tlTotal * i) / 6 * 10) / 10}{tlUnit}</b>\n                ))}\n              </div>\n              <div className=\"zrm-tl-tracks\">\n                {cut.beats.map((beat, i) => {\n                  const part = tlParts[i] || 0\n                  return (\n                    <div key={beat.id} className=\"zrm-tl-track\">\n                      <div className=\"zrm-tl-clip\" style={{ width: `${Math.max(2, (part / (tlTotal || 1)) * 100)}%`, marginLeft: `${(tlOffsets[i] / (tlTotal || 1)) * 100}%` }}>\n                        {Math.round(part * 10) / 10}{tlUnit}\n                      </div>\n                    </div>\n                  )\n                })}\n              </div>\n              <div className=\"zrm-tl-head\" style={{ left: `${((tlOffsets[selectedBeat] || 0) / (tlTotal || 1)) * 100}%` }} />\n            </div>\n          </div>\n        )}\n      </section>\n\n      {/* ═══ ZONE 6 · HIÉRARCHIE ══════════════════════════════════════════════════════════════════\n          Cette zone portait le FORMULAIRE du brief : titre, message, public, blocs, notes. Un\n          formulaire n'est pas une hiérarchie, et c'est la raison pour laquelle l'écran ne\n          ressemblait à aucun éditeur malgré ses huit zones. Le formulaire n'est pas supprimé pour\n          autant, il descend intact dans l'onglet « Contenu » du panneau de droite, à la place que\n          la section « Content » occupe chez Unreal.\n\n          LES QUATRE CÔTÉS SONT PRÉSERVÉS, et c'est le seul acquis que Matthieu ait nommé :\n          `placementAt` mesure une proportion et non des pixels, si bien que déposer sur le bord\n          haut, bas, gauche ou droite d'une RANGÉE d'arbre marche exactement comme sur une carte. */}\n      <section className=\"zrm-panel zrm-pane-structure zrm-zone-hier\">\n        <header className=\"zrm-head\">\n          <Icon name=\"list.bullet\" size={11} />\n          <span className=\"zrm-head-title\">Hiérarchie</span>\n          <span className=\"zrm-head-spacer\" />\n          {selection.length > 1 && <span className=\"zrm-tree-tag\" style={{ marginRight: 4 }}>{selection.length} sél.</span>}\n          <button className=\"zrm-tool\" style={{ height: 17, padding: '0 5px' }} title=\"Tout déplier\" onClick={toutDeplier}><Icon name=\"plus\" size={10} /></button>\n          <button className=\"zrm-tool\" style={{ height: 17, padding: '0 5px' }} title=\"Tout replier\" onClick={toutReplier}><Icon name=\"minus\" size={10} /></button>\n        </header>\n        <div className=\"zrm-find\">\n          <Icon name=\"magnifyingglass\" size={11} />\n          <input aria-label=\"Rechercher une pièce\" value={hierQuery} placeholder=\"Rechercher une pièce ou un calque…\" onChange={(e) => setHierQuery(e.target.value)} />\n        </div>\n        <div className=\"zrm-body\" style={{ padding: '0 2px 6px' }}\n          onDragOver={(e) => { if (!composition.rows.length) e.preventDefault() }}\n          onDrop={onEmptyStructureDrop}\n          onDragLeave={(e) => { if (!e.currentTarget.contains(e.relatedTarget)) setDropTarget(null) }}>\n          <div className=\"zrm-structure\" style={{ display: 'contents' }}>\n            {/* La racine, comme le `[test]` d'Unreal : elle donne son nom au document et sert de\n                cible de désélection, sans quoi on ne peut jamais revenir à « rien de sélectionné ». */}\n            <button className=\"zrm-tree-row\" style={{ '--zrm-indent': '4px' }} data-on={!selectedComponent}\n              title=\"Clic : replier tout l’arbre\" onClick={() => replier('racine')}>\n              <span className=\"zrm-twist\" data-open={!groupesReplies.racine}><Icon name=\"chevron.right\" size={9} /></span>\n              <span className=\"zrm-tree-glyph\">◻</span>\n              <span className=\"zrm-tree-name\">[{project.brief.title || 'Sans titre'}]</span>\n              <span className=\"zrm-tree-tag\">{format.short || format.label}</span>\n            </button>\n            {/* FAMILLE POWERPOINT 1 · DIAPOSITIVES. Une diapositive est un groupe dédié (carte P5) :\n                ses membres ne s'affichent QUE si elle est active ; tout calque sans diapositive agit\n                comme un MASQUE, visible sur toutes — traduit en carrousel Instagram (VISION.md). */}\n            <button className=\"zrm-tree-cat\" style={{ paddingLeft: 16 }} onClick={() => replier('diapositives')}>\n              <span className=\"zrm-twist\" data-open={!groupesReplies.diapositives}><Icon name=\"chevron.right\" size={9} /></span>\n              <span>Diapositives</span><span>{readSlides(composition).length}</span>\n            </button>\n            {!groupesReplies.diapositives && (\n              <>\n                {readSlides(composition).map((slide, i) => (\n                  <div key={slide.id} className=\"zrm-tree-row\" style={{ '--zrm-indent': '28px' }}\n                    data-on={composition.activeSlideId === slide.id}\n                    onClick={() => patchComposition((c) => setActiveSlide(c, slide.id))}>\n                    <span className=\"zrm-tree-glyph\">{i + 1}</span>\n                    <span className=\"zrm-tree-name\">{slide.name}</span>\n                    <span className=\"zrm-tree-acts\">\n                      <button title=\"Monter d’un rang\" onClick={(e) => { e.stopPropagation(); patchComposition((c) => reorderSlide(c, slide.id, 'up')) }}>↑</button>\n                      <button title=\"Descendre d’un rang\" onClick={(e) => { e.stopPropagation(); patchComposition((c) => reorderSlide(c, slide.id, 'down')) }}>↓</button>\n                      <button title=\"Dupliquer la diapositive\" onClick={(e) => { e.stopPropagation(); patchComposition((c) => duplicateSlide(c, slide.id)) }}><Icon name=\"doc.text\" size={10} /></button>\n                      <button title=\"Supprimer la diapositive\" onClick={(e) => { e.stopPropagation(); patchComposition((c) => removeSlide(c, slide.id)) }}><Icon name=\"trash\" size={10} /></button>\n                    </span>\n                  </div>\n                ))}\n                <button className=\"zrm-tree-row\" style={{ '--zrm-indent': '28px', opacity: .65 }}\n                  onClick={() => patchComposition((c) => addSlide(c))}>\n                  <span className=\"zrm-tree-glyph\">+</span>\n                  {/* PAS `.zrm-tree-name` ICI : dans toute la suite de tests, cette classe signifie\n                      « ceci est un nom de calque ou de pièce », et un libellé d'action neuf la\n                      polluerait pour chaque test qui recense les calques par ce sélecteur. */}\n                  <span className=\"zrm-tree-add-label\">Ajouter une diapositive</span>\n                </button>\n              </>\n            )}\n            {/* LA PILE DE CALQUES (carte L4, enrichie carte P5). Elle se lit du HAUT, c'est-à-dire\n                du plus proche de l'œil, comme dans Photoshop : `stackOrder` est l'inverse de\n                l'ordre de peinture. `groupLayers` garantit que les membres d'un même dossier sont\n                CONTIGUS dans cet ordre : la boucle peut donc afficher un dossier une seule fois,\n                dès son premier membre rencontré, puis avaler les suivants sans jamais avoir à\n                fermer et rouvrir la même icône de dossier. */}\n            {!groupesReplies.racine && countLayers(composition) > 0 && (\n              <>\n                <button className=\"zrm-tree-cat\" style={{ paddingLeft: 16 }} onClick={() => replier('calques')}>\n                  <span className=\"zrm-twist\" data-open={!groupesReplies.calques}><Icon name=\"chevron.right\" size={9} /></span>\n                  <span>Calques</span><span>{countLayers(composition)}</span>\n                </button>\n                {!groupesReplies.calques && (() => {\n                  const pile = stackOrder(composition)\n                  const groupes = readGroups(composition)\n                  const dejaRendu = new Set()\n                  // FAMILLE SLATE 6 · LA RECHERCHE DE LA HIÉRARCHIE NE FILTRAIT QUE LES PIÈCES,\n                  // JAMAIS LES CALQUES : « recherche dans une collection » est une sous-fonctionnalité\n                  // documentée de cette famille, et la moitié de l'arbre y échappait entièrement.\n                  const aiguille = hierQuery.trim().toLowerCase()\n                  const correspond = (nom) => !aiguille || nom.toLowerCase().includes(aiguille)\n                  return pile.map((layer) => {\n                    if (layer.groupId) {\n                      if (dejaRendu.has(layer.groupId)) return null   // déjà rendu par le premier membre\n                      dejaRendu.add(layer.groupId)\n                      const groupe = groupes.find((g) => g.id === layer.groupId)\n                      const tousMembres = pile.filter((l) => l.groupId === layer.groupId)\n                      // Si le NOM DU DOSSIER correspond, on montre tout son contenu sans le filtrer\n                      // une deuxième fois — chercher « titre » et trouver un dossier « Titre » vide\n                      // de tout élément visible serait un résultat qui se contredit lui-même.\n                      const nomDossierCorrespond = correspond(groupe?.name || 'Groupe')\n                      const membres = nomDossierCorrespond ? tousMembres : tousMembres.filter((m) => correspond(m.name))\n                      if (aiguille && !membres.length) return null   // ni le dossier ni aucun membre ne correspond\n                      const clefRepli = `grp:${layer.groupId}`\n                      return (\n                        <React.Fragment key={layer.groupId}>\n                          <div className=\"zrm-tree-row\" style={{ '--zrm-indent': '28px' }} data-hidden={groupe?.hidden}>\n                            <span className=\"zrm-twist\" data-open={!groupesReplies[clefRepli]} onClick={() => replier(clefRepli)}>\n                              <Icon name=\"chevron.right\" size={9} />\n                            </span>\n                            <span className=\"zrm-tree-glyph\"><Icon name=\"folder\" size={10} /></span>\n                            <span className=\"zrm-tree-name\" style={{ fontWeight: 500 }}>{groupe?.name || 'Groupe'}</span>\n                            <span className=\"zrm-tree-tag\">{membres.length}</span>\n                            <span className=\"zrm-tree-acts\">\n                              <button title={groupe?.hidden ? 'Afficher le groupe' : 'Masquer le groupe'}\n                                onClick={(e) => { e.stopPropagation(); patchComposition((c) => patchGroup(c, layer.groupId, { hidden: !groupe?.hidden })) }}><Icon name=\"eye\" size={10} /></button>\n                              <button title={groupe?.locked ? 'Déverrouiller le groupe' : 'Verrouiller le groupe'}\n                                onClick={(e) => { e.stopPropagation(); patchComposition((c) => patchGroup(c, layer.groupId, { locked: !groupe?.locked })) }}><Icon name=\"lock\" size={10} /></button>\n                              {/* FAMILLE FIGMA 4 · le parent réagit désormais tout seul au contenu : ranger les\n                                  membres en ligne ou en colonne au lieu de les déplacer un par un à la main. */}\n                              <button title={groupe?.autoLayout ? 'Désactiver Auto Layout' : 'Activer Auto Layout (colonne)'}\n                                data-on={!!groupe?.autoLayout || undefined}\n                                onClick={(e) => { e.stopPropagation(); patchComposition((c) => toggleAutoLayout(c, layer.groupId)) }}><Icon name=\"rectangle.grid.1x2\" size={10} /></button>\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"6b8c71a4-bf2e-4775-bb32-5a852d61030b"}}}
