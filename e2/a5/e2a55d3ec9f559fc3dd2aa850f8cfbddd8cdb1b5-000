{"timestamp":"2026-08-05T19:09:03.764Z","ordinal":3493,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd354-4793-71e1-81f9-22a87703dde3","call_id":"call_NVdJyErl61McO9CXZRVf0VZS","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"--- 1 ---\n"},{"type":"input_text","text":"--- 2 ---\n"},{"type":"input_text","text":"--- 3 ---\n// ZenRayMedia — L8 : le document `.zmedia.json` dans Create.\n//\n// DEUX CHOSES DIFFÉRENTES, souvent confondues (retour Matthieu 2026-07-25) :\n//\n//   1. ENREGISTRER  = ranger le document dans MON index, à un endroit que je choisis, pour le\n//      rouvrir et continuer à travailler. C'est ce fichier-ci. Le contenu est la SOURCE\n//      (brief + blocs + thème + format), pas le rendu.\n//   2. PUBLIER      = produire une page figée et partageable. C'est `exporters.js`.\n//\n// Même hiérarchie de dossiers, deux affichages et deux intentions distinctes. On peut enregistrer\n// sans jamais publier, et republier sans réenregistrer.\n//\n// Le fichier reste volontairement LISIBLE et MINUSCULE : aucun HTML compilé n'y est stocké, il se\n// recompile en quelques millisecondes. Stocker le rendu créerait deux vérités qui divergeraient.\n\nimport { readJson, saveJson, listChildren } from '../ref/content.js'\nimport { emptyBrief, makeId, validate } from './contracts.js'\nimport { DEFAULT_THEME_ID } from './themes/registry.js'\n\nexport const ZMEDIA_EXT = '.zmedia.json'\nexport const ZMEDIA_VERSION = 2\nexport const DEFAULT_MEDIA_DIR = 'pages/Media'\n\nexport function isZMediaPath(path) { return typeof path === 'string' && path.endsWith(ZMEDIA_EXT) }\n\nexport function slugify(text) {\n  return String(text || '')\n    .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-+|-+$/g, '')\n    .toLowerCase().slice(0, 60) || 'media'\n}\n\n// Chemin proposé pour un projet dans un dossier donné. Le suffixe court évite d'écraser un\n// homonyme sans avoir à interroger le serveur avant d'afficher une proposition.\nexport function suggestPath(dir, title, salt = 0) {\n  // Normaliser D'ABORD, se servir de la valeur normalisée PARTOUT ensuite.\n  // Bug réel (2026-07-25) : l'empreinte était calculée sur `dir` brut alors que le chemin final\n  // utilisait `dir` nettoyé -> « pages/Media » et « pages/Media/ » désignent le même dossier mais\n  // produisaient deux noms de fichier différents. Un même document enregistré deux fois depuis\n  // deux points d'entrée aurait créé deux fichiers au lieu d'un.\n  const folder = String(dir || DEFAULT_MEDIA_DIR).replace(/\\/+$/, '')\n  const base = slugify(title)\n  const suffix = makeId('', `${folder}/${base}`, salt).replace(/^-/, '').slice(-4)\n  return `${folder}/${base}-${suffix}${ZMEDIA_EXT}`\n}\n\n// --- Sérialisation ------------------------------------------------------------------------------\nexport function toDocument(project, { themeId, formatId, path }) {\n  return {\n    type: 'zenraymedia',\n    v: ZMEDIA_VERSION,\n    title: project.brief?.title || 'Sans titre',\n    path: path || null,\n    brief: project.brief,\n    notes: project.notes || '',\n    cut: project.cut || null,\n    compositions: project.compositions || {},\n    themeId: themeId || DEFAULT_THEME_ID,\n    formatId: formatId || 'F-web-article',\n    seed: project.seed ?? 1,\n  }\n}\n\n// Tolérant en LECTURE, strict en écriture : un document écrit par une version future ne doit pas\n// faire planter l'application, juste perdre ce qu'elle ne comprend pas.\nexport function fromDocument(doc, path) {\n  if (!doc || doc.type !== 'zenraymedia') return null\n  const brief = { ...emptyBrief(), ...(doc.brief || {}) }\n  if (!brief.id) brief.id = makeId('brief', path || doc.title || 'zmedia', 0)\n  return {\n    project: {\n      id: makeId('project', path || doc.title || 'zmedia', 0),\n      brief,\n      notes: typeof doc.notes === 'string' ? doc.notes : '',\n      cut: doc.cut && Array.isArray(doc.cut.beats) && doc.cut.beats.length ? doc.cut : null,\n      // Une composition par thème : essayer une autre famille ne détruit jamais le montage Lego.\n      // `composition` garde la lecture tolérante d'une courte version de développement.\n      compositions: doc.compositions && typeof doc.compositions === 'object'\n        ? doc.compositions\n        : (doc.composition?.themeId ? { [doc.composition.themeId]: doc.composition } : {}),\n      seed: Number.isFinite(doc.seed) ? doc.seed : 1,\n      path: path || doc.path || null,\n    },\n    themeId: doc.themeId || DEFAULT_THEME_ID,\n    formatId: doc.formatId || 'F-web-article',\n  }\n}\n\n// --- Entrées / sorties ---------------------------------------------------------------------------\n/** Lit un document. `{ ok, project, themeId, formatId, sha, error }` — ne lève jamais. */\nexport async function loadDocument(path) {\n  if (!isZMediaPath(path)) return { ok: false, error: 'Chemin qui n’est pas un document ZenRayMedia.' }\n  const { data, sha, missing, error } = await readJson(path)\n  if (missing) return { ok: false, error: 'Document introuvable.' }\n  if (error) return { ok: false, error: error === 'parse' ? 'Document illisible (JSON invalide).' : 'Lecture impossible (réseau).' }\n  const parsed = fromDocument(data, path)\n  if (!parsed) return { ok: false, error: 'Ce fichier n’est pas un document ZenRayMedia.' }\n  return { ok: true, ...parsed, sha }\n}\n\n/**\n * Écrit un document. `sha` est celui lu précédemment : c'est lui qui permet à GitHub de refuser\n * une écriture concurrente plutôt que d'écraser le travail d'un autre onglet.\n */\nexport async function saveDocument(path, project, { themeId, formatId, sha } = {}) {\n  const errors = validate('brief', project?.brief || null)\n  if (errors.length) return { ok: false, error: `Document incomplet : ${errors[0].message}` }\n  const doc = toDocument(project, { themeId, formatId, path })\n  const res = await saveJson(path, doc, sha)\n  if (res.conflict) return { ok: false, conflict: true, error: 'Ce document a été modifié ailleurs. Recharge-le avant d’enregistrer.' }\n  if (!res.ok) return { ok: false, error: res.error === 'network' ? 'Enregistrement impossible (réseau).' : `Enregistrement refusé (${res.error || 'inconnu'}).` }\n  return { ok: true, sha: res.sha }\n}\n\n// --- Navigation de dossiers (le fil d'Ariane) -------------------------------------------------\n/** Sous-dossiers directs d'un dossier, triés. `listChildren` passe par l'API `children`. */\nexport async function listFolders(dir) {\n  const entries = await listChildren(dir)\n  return entries\n    .filter((e) => e && e.type === 'dir')\n    .map((e) => ({ name: e.name, path: e.path }))\n    .sort((a, b) => a.name.localeCompare(b.name, 'fr'))\n}\n\n/** Documents ZenRayMedia directement dans un dossier. */\nexport async function listDocuments(dir) {\n  const entries = await listChildren(dir)\n  return entries\n    .filter((e) => e && e.type !== 'dir' && isZMediaPath(e.path || e.name))\n    .map((e) => ({ name: String(e.name).replace(ZMEDIA_EXT, ''), path: e.path }))\n    .sort((a, b) => a.name.localeCompare(b.name, 'fr'))\n}\n\n/** Segments d'un chemin de dossier, pour l'affichage du fil d'Ariane. */\nexport function crumbsOf(dir) {\n  const parts = String(dir || '').split('/').filter(Boolean)\n  return parts.map((name, i) => ({ name, path: parts.slice(0, i + 1).join('/') }))\n}\n\nexport function parentOf(dir) {\n  const parts = String(dir || '').split('/').filter(Boolean)\n  return parts.length > 1 ? parts.slice(0, -1).join('/') : parts[0] || 'pages'\n}\n\nexport function dirOf(path) {\n  const i = String(path || '').lastIndexOf('/')\n  return i > 0 ? path.slice(0, i) : DEFAULT_MEDIA_DIR\n}\n// ZenRayMedia — LE MODÈLE DE CALQUES (carte L1, 2026-08-04).\n//\n// « Pense éditeur d'UI comme React mais en GUI + layer HTML comme Photoshop = layer de PNG ou\n// effets. » Cette phrase de Matthieu tranche une contradiction qui a coûté cinq jours : l'INTERFACE\n// est celle d'Unreal, le MODÈLE est celui de Photoshop.\n//\n// Photoshop n'imbrique pas, il EMPILE. Une pile ordonnée de calques sur un canevas de taille fixe,\n// chacun portant sa position, sa taille, son rang, son opacité, son mode de fusion et ses effets.\n// C'est ce qui rend la composition rapide, et c'est aussi ce qui rend ce fichier court : un arbre\n// avec emplacements demanderait des semaines pour un gain nul sur « craft rapidement ».\n//\n// LE CONTRAT DE `composition.js` N'EST PAS ROUVERT, et c'est le cadeau de la carte C1 du\n// 2026-08-01 : depuis cette date `normalizeComposition` conserve les clefs qu'elle ne connaît pas.\n// Un tableau `layers` posé à côté de `rows` survit donc à tous les gestes sans qu'une seule ligne de\n// son contrat change, et les documents déjà enregistrés restent lisibles puisqu'un document sans\n// calques rend simplement un tableau vide.\n\nimport { makeId } from './contracts.js'\n\n// FAMILLE POWERPOINT 5 · UN CINQUIÈME TYPE DE CALQUE, LE TABLEAU. Portée assumée, écrite ici plutôt\n// que devinée en silence : les graphiques et SmartArt de PowerPoint réclament soit une bibliothèque\n// de rendu de graphiques, soit un moteur de mise en page générative pour les diagrammes — un\n// chantier disproportionné pour l'usage réel d'aujourd'hui (des affiches, VISION.md), et absent de\n// ce dépôt. Le TABLEAU, lui, est borné (texte en grille) et sert un cas fréquent des publications\n// sociales (comparatif, trois conseils en colonnes) : c'est la seule des trois retenue.\nexport const LAYER_KINDS = ['text', 'image', 'shape', 'component', 'table']\n\n// FAMILLE PHOTOSHOP 4 · FORMES VECTORIELLES. Un calque « shape » ne rendait qu'un rectangle : la\n// couleur de remplissage et le contour existaient déjà (LAYER_STYLES porte backgroundColor et\n// border), mais la GÉOMÉTRIE, elle, n'avait qu'une seule forme possible. Trois formes couvrent le\n// noyau que la doc Photoshop retient : rectangle, ellipse, ligne.\n//\n// FAMILLE FIGMA 6 · le polygone et l'étoile s'ajoutent ici : ce sont les deux formes PARAMÉTRIQUES\n// que Figma construit par un nombre de côtés et, pour l'étoile, un ratio de rayon interne — jamais\n// un tracé à points qu'on déplace un par un. CE POINT EST ÉCRIT PLUTÔT QUE CACHÉ : la doc Figma va\n// plus loin, jusqu'à l'outil Plume et l'édition de points de courbe individuels, ce qui suppose un\n// second modèle de géométrie entier (des points de contrôle, pas une boîte x/y/w/h) pour un usage\n// que ce produit — des compositions de type poster/carrousel, jamais une icône dessinée à la main —\n// ne rencontre pas. Polygone et étoile couvrent la façon dont Figma sert RÉELLEMENT ce cas courant,\n// le tracé à points reste hors périmètre, assumé par écrit.\nexport const SHAPE_TYPES = ['rectangle', 'ellipse', 'line', 'polygon', 'star']\n\n// FAMILLE POWERPOINT 3 · TEXTE ET TYPOGRAPHIE. Police, corps, graisse, casse, alignements et\n// interlignage sont déjà couverts par `LAYER_STYLES` (carte S2) ; ce qui manquait au regard de la\n// doc PowerPoint est la LISTE (à puces ou numérotée) et le LIEN. Portée assumée : une liste ici est\n// une ligne par retour à la ligne du texte, jamais des niveaux de puces imbriqués — le texte d'un\n// calque reste un champ plat, et un système de sous-niveaux rouvrirait ce champ pour un gain que\n// l'usage réel (une affiche, pas un document long) ne réclame pas.\nexport const LIST_STYLES = ['none', 'bullet', 'number']\n\n// FAMILLE POWERPOINT 6 · ANIMATIONS. Portée assumée, écrite plutôt que devinée : les TRANSITIONS\n// entre diapositives n'ont pas d'équivalent réel ici — un carrousel Instagram change de panneau par\n// un coup sec, jamais un fondu, et ZenRayMedia ne porte aucun mode « présentation » qui jouerait une\n// transition entre deux compilations. Seule l'ENTRÉE ANIMÉE d'un calque survit à la traduction :\n// elle sert l'aperçu interactif et un futur export vidéo/GIF d'un seul canevas, sans réclamer de\n// moteur de timeline (déclenchement, séquençage, sortie) qu'aucun usage réel ne demande aujourd'hui.\nexport const ANIMATION_STYLES = ['none', 'fade', 'rise', 'zoom']\n\nexport const CONSTRAINTS_H = ['left', 'center', 'right', 'scale']\nexport const CONSTRAINTS_V = ['top', 'center', 'bottom', 'scale']\n\n// Les modes de fusion sont ceux que CSS sait appliquer NATIVEMENT via `mix-blend-mode`. On ne\n// propose que ce que le navigateur exécute réellement : un mode qu'il faudrait émuler en toile\n// coûterait un rendu hors iframe et casserait l'export en page autonome.\nexport const BLEND_MODES = [\n  'normal', 'multiply', 'screen', 'overlay', 'darken', 'lighten',\n  'color-dodge', 'color-burn', 'hard-light', 'soft-light', 'difference', 'exclusion',\n]\n\n// Les effets sont des FILTRES CSS, pour la même raison. Chacun se réduit à une fonction de\n// `filter` ou à `box-shadow`, donc à une chaîne que l'export emporte sans dépendance.\nexport const EFFECT_KEYS = ['blur', 'brightness', 'contrast', 'saturate', 'shadow']\n\n// FAMILLE FIGMA 7 · APPARENCE. Opacité, fusion, filtres et ombre existaient déjà (ci-dessus) : ce\n// qui manquait au regard de la doc Figma est le REMPLISSAGE DÉGRADÉ, omniprésent dans une affiche\n// ou un post social (fond qui module la lumière derrière un titre) et absent tant que `backgroundColor`\n// ne portait qu'une couleur unie. PORTÉE ASSUMÉE, ÉCRITE PLUTÔT QUE CACHÉE : Figma empile plusieurs\n// fills indépendants par calque (solide + dégradé + image, chacun avec sa propre opacité) ; ce\n// produit n'en garde qu'UN SEUL À LA FOIS, solide ou dégradé, choisi par `fillType`. L'empilement de\n// fills sert des compositions bien plus complexes qu'une affiche 2D pour Instagram ou LinkedIn — le\n// seul usage réel aujourd'hui, au sens de VISION.md — et l'ajouter maintenant coûterait une UI de\n// calques DANS le calque pour un gain que ce produit ne rencontre pas encore.\nexport const FILL_TYPES = ['solid', 'gradient']\n\nconst HEX_RE = /^#[0-9a-fA-F]{3,8}$/\n\n// Le dégradé linéaire d'un calque, en CSS réel. Fonction PURE, séparée de `styleOf` : un dégradé a\n// besoin de PLUSIEURS champs coordonnés (deux couleurs, un angle), pas d'une seule valeur de texte\n// libre comme le reste de `LAYER_STYLES` — même raison de conception que `transformOf`/`shapeClipPath`.\nexport function fillOf(layer) {\n  if (layer?.fillType !== 'gradient') return ''\n  const de = HEX_RE.test(layer.gradientFrom) ? layer.gradientFrom : '#6fb6ed'\n  const a = HEX_RE.test(layer.gradientTo) ? layer.gradientTo : '#4371ee'\n  const angle = Number.isFinite(layer.gradientAngle) ? ((Math.round(layer.gradientAngle) % 360) + 360) % 360 : 135\n  return `background:linear-gradient(${angle}deg, ${de}, ${a})`\n}\n\n// FAMILLE POWERPOINT 3 · LE LIEN, restreint aux protocoles qu'un clic dans l'aperçu peut suivre\n// sans risque. `javascript:` (et tout schéma non listé) est refusé plutôt qu'assaini : un lien\n// qu'on refuse d'écrire ne peut jamais s'exécuter, ce qu'aucun nettoyage de chaîne ne garantit\n// avec la même certitude.\nexport function safeHref(href) {\n  const valeur = typeof href === 'string' ? href.trim() : ''\n  if (!valeur) return ''\n  if (/^(https?:|mailto:)/i.test(valeur) || valeur.startsWith('/') || valeur.startsWith('#')) return valeur\n  return ''\n}\n\n// FAMILLE POWERPOINT 6 · l'entrée animée d'un calque, en CSS réel. Même nom de keyframe pour tous\n// les calques d'un style donné (`zrm-anim-fade` etc.) : les définitions vivent UNE fois dans la\n// feuille statique de la page, jamais dupliquées par calque.\nexport function animationOf(layer) {\n  if (!layer || layer.animationStyle === 'none' || !layer.animationStyle) return ''\n  const delai = Number.isFinite(layer.animationDelay) ? Math.max(0, Math.round(layer.animationDelay)) : 0\n  return `animation:zrm-anim-${layer.animationStyle} 520ms var(--zrm-ease,ease) ${delai}ms both`\n}\n\n// LE STYLE PROPRE D'UN CALQUE, et d'abord celui d'un calque de TEXTE. Matthieu : « toutes les\n// fonctions de base que tu as créées, comme la fonction texte, je veux qu'elle soit parfaite. »\n// Un calque de texte qui ne sait ni changer de corps, ni de couleur, ni d'alignement n'est pas une\n// fonction texte, c'est une étiquette. La liste est FERMÉE, pour la même raison que celle des\n// sous-composants : on écrit du style en ligne à partir de valeurs connues, jamais de saisie libre.\nexport const LAYER_STYLES = [\n  { key: 'color', label: 'Couleur', type: 'color' },\n  { key: 'backgroundColor', label: 'Fond', type: 'color' },\n  { key: 'fontFamily', label: 'Police', type: 'select', options: ['', 'AnthropicSans', 'AnthropicSerif', 'AnthropicMono'] },\n  { key: 'fontSize', label: 'Corps', type: 'text', hint: '48px' },\n  { key: 'fontWeight', label: 'Graisse', type: 'select', options: ['', '300', '400', '500', '600', '700', '800'] },\n  { key: 'fontStyle', label: 'Italique', type: 'select', options: ['', 'normal', 'italic'] },\n  { key: 'letterSpacing', label: 'Interlettre', type: 'text', hint: '-.02em' },\n  { key: 'lineHeight', label: 'Interligne', type: 'text', hint: '1.1' },\n  { key: 'textAlign', label: 'Alignement', type: 'select', options: ['', 'left', 'center', 'right'] },\n  { key: 'textTransform', label: 'Casse', type: 'select', options: ['', 'none', 'uppercase', 'lowercase', 'capitalize'] },\n  { key: 'justifyContent', label: 'Vertical', type: 'select', options: ['', 'flex-start', 'center', 'flex-end'] },\n  { key: 'padding', label: 'Marge int.', type: 'text', hint: '0' },\n  { key: 'borderRadius', label: 'Rayon', type: 'text', hint: '0' },\n  { key: 'border', label: 'Bordure', type: 'text', hint: '1px solid #000' },\n]\n\nconst CLEFS_STYLE_CALQUE = new Set(LAYER_STYLES.map((c) => c.key))\n\n// La chaîne de style d'un calque, filtrée sur la liste fermée et débarrassée de tout caractère qui\n// permettrait de sortir de l'attribut. Même précaution que dans `nodes.js`, même raison.\nexport function styleOf(layer) {\n  return Object.entries(layer?.style || {})\n    .filter(([clef, valeur]) => CLEFS_STYLE_CALQUE.has(clef) && typeof valeur === 'string' && valeur.trim())\n    .map(([clef, valeur]) => `${clef.replace(/[A-Z]/g, (m) => `-${m.toLowerCase()}`)}:${valeur.replace(/[;<>\"']/g, '')}`)\n    .join(';')\n}\n\nexport function emptyEffects() {\n  return { blur: 0, brightness: 1, contrast: 1, saturate: 1, shadow: '' }\n}\n\n// Le gabarit d'un calque neuf. Une taille par défaut qui NE SOIT PAS nulle : un calque de zéro\n// pixel se pose sans qu'on le voie, et l'utilisateur conclut que le dépôt a échoué.\nexport function makeLayer(composition, kind, patch = {}) {\n  if (!LAYER_KINDS.includes(kind)) throw new Error(`kind de calque inconnu : ${kind}`)\n  const serial = (composition?.serial || 0) + 1\n  return {\n    id: makeId('lay', `${composition?.themeId || 'sans-theme'}:${kind}`, serial),\n    serial,\n    kind,\n    name: patch.name || defaultName(kind),\n    x: 0, y: 0, w: 320, h: kind === 'text' ? 64 : 180,\n    z: nextZ(composition),\n    rotation: 0,     // degrés, sens horaire, pivot au centre du calque\n    flipX: false, flipY: false,   // retournement horizontal / vertical (famille Photoshop 2)\n    shapeType: 'rectangle',   // famille Photoshop 4 : rectangle | ellipse | line | polygon | star (F6)\n    shapeSides: 6, shapeStarRatio: 0.5,   // famille Figma 6 : nombre de côtés, ratio de l'étoile\n    fillType: 'solid', gradientFrom: '#6fb6ed', gradientTo: '#4371ee', gradientAngle: 135,   // famille Figma 7\n    listStyle: 'none', href: '',   // famille PowerPoint 3 : liste à puces/numérotée, lien\n    tableRows: 2, tableCols: 2, tableCells: ['', '', '', ''],   // famille PowerPoint 5 : tableau\n    animationStyle: 'none', animationDelay: 0,   // famille PowerPoint 6 : entrée animée\n    connectFrom: '', connectTo: '',   // famille Miro 6 : connecteur, identifiants des deux calques reliés\n    connectorX1: 0, connectorY1: 0, connectorX2: 0, connectorY2: 0,   // coordonnées relatives, recalculées\n    pathPoints: [], pathClosed: false,   // famille Illustrator I2 : tracé vectoriel, l'outil Plume\n    pathStrokeColor: '', pathStrokeWidth: 2,   // contour du tracé, indépendant du fond (backgroundColor)\n    focalX: 50, focalY: 50,   // famille Photoshop 6 : point focal d'une image dans son cadre, en %\n    // FAMILLE FIGMA 3 · CONTRAINTES. Comment le calque réagit quand le CANEVAS change de taille\n    // (changer de format n'est pas rare ici : un même brief se décline en carré, en 9:16, en A4).\n    // « left/top » : distance au bord fixe, par défaut, exactement le défaut de Figma. « right »,\n    // « bottom » : distance à l'autre bord fixe. « center » : reste à équidistance des deux bords.\n    // « scale » : grandit ou rétrécit avec le canevas, dans la même proportion.\n    constrainH: 'left', constrainV: 'top',\n    opacity: 1,\n    blend: 'normal',\n    hidden: false,\n    locked: false,\n    source: '',          // texte du calque, adresse de l'image, ou identifiant du composant\n    style: {},           // style propre, voir LAYER_STYLES\n    effects: emptyEffects(),\n    ...patch,\n  }\n}\n\nfunction defaultName(kind) {\n  return { text: 'Texte', image: 'Image', shape: 'Forme', component: 'Composant', table: 'Tableau' }[kind]\n}\n\n// FAMILLE POWERPOINT 5 · LE TABLEAU. `tableCells` est un tableau À PLAT de `tableRows * tableCols`\n// chaînes, jamais une grille de tableaux — un chemin d'indices `[ligne][colonne]` demanderait deux\n// bornes à vérifier partout où une seule (`lignes * colonnes`) suffit.\nfunction normaliserTableau(l) {\n  const lignes = Math.min(8, Math.max(1, Math.round(nombre(l.tableRows, 2))))\n  const colonnes = Math.min(8, Math.max(1, Math.round(nombre(l.tableCols, 2))))\n  const brut = Array.isArray(l.tableCells) ? l.tableCells : []\n  const cellules = Array.from({ length: lignes * colonnes }, (_, i) => (typeof brut[i] === 'string' ? brut[i] : ''))\n  return { tableRows: lignes, tableCols: colonnes, tableCells: cellules }\n}\n\n// FAMILLE ILLUSTRATOR I2 · LE TRACÉ VECTORIEL. Chaque point porte sa position ET ses deux poignées\n// bézier (`inX/inY` pour la courbe qui ARRIVE sur ce point, `outX/outY` pour celle qui EN PART),\n// toutes en POURCENTAGE de la boîte du calque (0-100), jamais en pixels absolus — exactement la\n// même raison que le remplissage dégradé (carte F7) ou le point focal (carte P6) : le tracé doit\n// s'étirer avec le calque, pas se recalculer contre ses pixels réels à chaque redimensionnement.\n// Un point dont la poignée coïncide avec l'ancre (in ou out égal à x/y) ne courbe pas ce côté-là :\n// c'est un ANGLE. Des poignées écartées de l'ancre produisent une courbe : un point LISSE.\nfunction borneNombre(v, repli) {\n  return Number.isFinite(v) ? Math.min(100, Math.max(0, v)) : repli\n}\n\nfunction normaliserPointTrace(p) {\n  const x = borneNombre(p?.x, 0), y = borneNombre(p?.y, 0)\n  return {\n    x, y,\n    inX: borneNombre(p?.inX, x), inY: borneNombre(p?.inY, y),\n    outX: borneNombre(p?.outX, x), outY: borneNombre(p?.outY, y),\n  }\n}\n\nfunction normaliserTrace(l) {\n  const points = Array.isArray(l.pathPoints) ? l.pathPoints.filter((p) => p && typeof p === 'object').map(normaliserPointTrace) : []\n  return {\n    pathPoints: points,\n    pathClosed: !!l.pathClosed,\n    pathStrokeColor: typeof l.pathStrokeColor === 'string' && HEX_RE.test(l.pathStrokeColor) ? l.pathStrokeColor : '',\n    pathStrokeWidth: Math.min(20, Math.max(0.5, nombre(l.pathStrokeWidth, 2))),\n  }\n}\n\n/**\n * Redimensionne une grille de cellules à `newRows × newCols`, en conservant le contenu des\n * cellules qui existaient déjà aux mêmes coordonnées — agrandir un tableau ne doit jamais effacer\n * ce qu'il portait, et rétrécir ne doit perdre que ce qui tombe hors des nouvelles bornes.\n */\nexport function resizeTableCells(cells, oldRows, oldCols, newRows, newCols) {\n  const source = Array.isArray(cells) ? cells : []\n  const grille = []\n  for (let r = 0; r < newRows; r++) {\n    for (let c = 0; c < newCols; c++) {\n   