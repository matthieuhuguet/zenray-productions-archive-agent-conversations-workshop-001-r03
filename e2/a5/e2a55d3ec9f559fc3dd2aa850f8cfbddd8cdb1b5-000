{"timestamp":"2026-08-05T17:28:05.992Z","ordinal":1496,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd2f7-d868-7c21-8813-502a95f8be57","call_id":"call_CGk9sAPHPk3rnPslCHrnuxNj","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"src/zenraymedia/zenraymedia.test.js:10:import { renderTemplate, escapeHtml, inspectTemplate } from './htmlTemplate.js'\nsrc/zenraymedia/zenraymedia.test.js:336:    expect(inspectTemplate('<p>rien</p>')).toEqual({ usesTitle: false, usesBeats: false, hasHtmlSkeleton: false })\nsrc/zenraymedia/zenraymedia.test.js:337:    expect(inspectTemplate('<html><h1>{{title}}</h1>{{#beats}}x{{/beats}}</html>').usesBeats).toBe(true)\nsrc/zenraymedia/htmlTemplate.js:110:export function inspectTemplate(template) {\n  // voie ÉCRIT elle-même toutes ses valeurs. Ici les composants apportent leur propre feuille, et\n  // rien ne permet de réécrire un `font-size:16px` posé à l'intérieur. La densité est donc portée\n  // par la taille de police RACINE, ce qui met à l'échelle tout ce qui est exprimé en unités\n  // relatives et rien d'autre.\n  // **Limite nommée, pas oubliée :** un composant qui code ses tailles en pixels durs ne suivra pas.\n  // Les 48 parts du thème Spotify étant à écrire, elles doivent l'être en `em` ou `rem` dès le\n  // départ ; c'est le contrat de la voie Lego et il vaut mieux l'établir avant qu'après.\n  const fixed = format.canvas.h > 0\n  const safe = format.safe || { top: 0, bottom: 0, sides: 0 }\n  const density = format.density || 1\n  const entries = new Map((bundle?.components || []).map((entry) => [entry.id, entry]))\n  const data = { ...templateData(brief, cut, theme, format), dark, scale }\n  const styles = []\n  const rows = []\n\n  for (const row of composition.rows || []) {\n    const items = []\n    for (const item of row.items || []) {\n      if (item.hidden) continue\n      if (item.kind === 'image') {\n        items.push(`<figure class=\"zrm-lego-item zrm-lego-image\" data-zrm-instance=\"${escapeHtml(item.id)}\" style=\"--zrm-image-ratio:${escapeHtml(item.props?.ratio || '16 / 9')};--zrm-image-radius:${Number(item.props?.radius) || 18}px\"><img src=\"${escapeHtml(item.url || '')}\" alt=\"${escapeHtml(item.name || '')}\"></figure>`)\n        continue\n      }\n      const entry = entries.get(item.componentId)\n      if (!entry?.html) continue\n      const part = splitPart(entry.html)\n      styles.push(part.styles)\n      let body = renderTemplate(part.body, resolveItemData(data, item, entry))\n      // Il y avait ici une rustine : elle réécrivait le contenu de tout <h1-3> d'un composant de\n      // titre avec `brief.title`. Elle existait parce que les composants portaient un exemple\n      // figé au lieu de lire le brief. Ils lisent maintenant `{{title}}` comme n'importe quel\n      // gabarit — la rustine ne réparait donc plus rien et DÉTRUISAIT le balisage interne du\n      // titre (petites capitales, exposants, marques de coupe). Supprimée le 2026-07-28.\n      items.push(`<section class=\"zrm-lego-item\" data-zrm-instance=\"${escapeHtml(item.id)}\" data-zrm-component=\"${escapeHtml(item.componentId)}\">${body}</section>`)\n    }\n    if (items.length) rows.push(`<div class=\"zrm-lego-row\" data-zrm-row=\"${escapeHtml(row.id)}\">${items.join('')}</div>`)\n  }\n\n  const calques = layersHtml(composition, entries, data, interactive)\n  styles.push(...calques.styles)\n\n  // Les définitions SVG sont une dépendance invisible. La planche reste ajoutable comme composant,\n  // mais tous les autres blocs peuvent déjà employer leurs <use href=\"#…\"> sans ordre imposé.\n  const definitions = splitPart(bundle?.definitionsHtml || '')\n  if (definitions.styles) styles.unshift(definitions.styles)\n\n  const css = `\n${FONT_FACES}\n${fontFaceCss(theme.fonts || [])}\n${bundle?.tokensCss || ''}\n*{box-sizing:border-box}\nhtml,body{margin:0;min-height:100%;background:var(--zrm-paper,var(--zrm-bg,#fff));color:var(--zrm-ink,#151515)}\nbody{font-family:var(--f-body,var(--zrm-body,'AnthropicSans',system-ui,sans-serif));-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;${fixed ? `width:${format.canvas.w}px;height:${format.canvas.h}px;overflow:hidden;` : ''}}\n.zrm-lego-page{position:relative;width:100%;margin:0 auto;display:flex;flex-direction:column;${fixed\n  ? `height:100%;max-width:none;padding:${safe.top}px ${safe.sides}px ${safe.bottom}px;justify-content:flex-start;overflow:hidden;font-size:${Math.round(density * 100)}%;gap:${Math.round(14 * density)}px;`\n  : `max-width:${format.canvas.w || 1180}px;min-height:0;padding:clamp(12px,2.8vw,42px);gap:clamp(10px,1.6vw,24px);`}}\n/* LE TEXTE ÉTAIT ROGNÉ, ET C'ÉTAIT ÉCRIT ICI EN TOUTES LETTRES (2026-08-04).\n\n   « overflow:hidden » sur la pièce, plus « align-items:stretch » sur la rangée : les cellules d'une\n   même rangée prenaient toutes la hauteur de la plus haute, et toute pièce dont le contenu\n   dépassait sa cellule se faisait couper en silence. C'est le « composant au texte cropé » de la\n   capture, et c'est ce qui se produisait sur les formats carrés et portraits, où la place manque.\n\n   La pièce cesse donc de rogner : elle prend la hauteur de son contenu. La rangée s'aligne en haut\n   plutôt que de s'étirer, ce qui évite de gonfler une pièce courte à la taille de sa voisine. Le\n   seul rognage qui subsiste est celui de la PAGE, sur les formats à hauteur fixe, et il est\n   légitime : une image de 1080 par 1080 ne peut pas grandir. Le Critique le mesure et le dit. */\n.zrm-lego-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));align-items:start;gap:clamp(8px,1.25vw,18px);min-width:0}\n.zrm-lego-item{min-width:0;min-height:0}\n/* Ce qui doit encore rogner le fait explicitement, et seulement là où la coupe est voulue. */\n.zrm-lego-item img,.zrm-lego-item svg{max-width:100%}\n.zrm-lego-image{margin:0;aspect-ratio:var(--zrm-image-ratio);border-radius:var(--zrm-image-radius);background:rgba(127,127,127,.12)}\n.zrm-lego-image img{display:block;width:100%;height:100%;object-fit:cover}\n.zrm-layers{position:absolute;inset:0;pointer-events:none}\n.zrm-layer{position:absolute;pointer-events:auto;overflow:hidden}\n.zrm-layer-text-host{font-family:var(--f-display,var(--zrm-display,inherit));font-size:2rem;line-height:1.15}\n.zrm-layer-shape{background:var(--zrm-accent,#0a84ff)}\n/* FAMILLE PHOTOSHOP 4 · TROIS FORMES, une geometrie chacune. L'ellipse reutilise le remplissage et\n   le contour deja poses par LAYER_STYLES (backgroundColor/border) ; la ligne fixe sa hauteur a un\n   trait de 3 px quelle que soit celle du calque, la ligne d'un logiciel de dessin est un TRAIT, pas\n   un rectangle aplati. */\n.zrm-layer-shape[data-shape=\"ellipse\"]{border-radius:50%}\n.zrm-layer-shape[data-shape=\"line\"]{height:3px !important}\n.zrm-layer-image img{display:block;width:100%;height:100%;object-fit:cover}\n.zrm-layer-text{width:100%;height:100%;display:flex;align-items:center;justify-content:inherit;flex-direction:column;font:inherit;color:inherit;text-align:inherit;white-space:pre-wrap}\n.zrm-layer-text>span{width:100%}\n.zrm-layer-text{display:flex;flex-direction:column;justify-content:center}\n/* FAMILLE POWERPOINT 3 : liste et lien. La liste hérite police/couleur/alignement du calque comme\n   le fait déjà le span de texte ; le lien ne change que le soulignement, jamais la couleur. */\n.zrm-layer-list{margin:0;padding-left:1.3em;width:100%;text-align:inherit}\n.zrm-layer-text a{color:inherit;text-decoration:underline;text-decoration-thickness:.06em}\n/* FAMILLE POWERPOINT 5 · le tableau porte son propre quadrillage par défaut (une bordure sur\n   chaque cellule) : un tableau sans trait visible ne se lirait pas comme un tableau. */\n.zrm-layer-table{width:100%;height:100%;border-collapse:collapse;font:inherit;color:inherit}\n.zrm-layer-table td{border:1px solid currentColor;padding:.4em .6em;text-align:inherit}\n/* FAMILLE MIRO 6 : le connecteur remplit sa boîte englobante, la ligne interne porte sa propre\n   géométrie (points relatifs) : rien à positionner ici, seulement à ne pas déborder. */\n.zrm-layer-connector{width:100%;height:100%;display:block;overflow:visible;color:var(--zrm-ink,#151515)}\n/* FAMILLE POWERPOINT 6 : les trois entrées animées. Définies UNE fois ici, jamais par calque,\n   la fonction animationOf ne pose que le nom ; ces règles portent le mouvement réel. */\n@keyframes zrm-anim-fade{from{opacity:0}to{opacity:1}}\n@keyframes zrm-anim-rise{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}\n@keyframes zrm-anim-zoom{from{opacity:0;transform:scale(.85)}to{opacity:1;transform:none}}\n${styles.join('\\n')}\n${interactive ? '.zrm-lego-item{cursor:pointer}[data-zrm-on]{outline:2px solid var(--zrm-accent,#0a84ff);outline-offset:2px;border-radius:3px}' : ''}\n@media(prefers-reduced-motion:no-preference){\n  .zrm-lego-item{animation:zrm-lego-in .3s cubic-bezier(.2,.75,.2,1) both}\n  .zrm-lego-item:nth-child(2){animation-delay:.035s}.zrm-lego-item:nth-child(3){animation-delay:.07s}\n  @keyframes zrm-lego-in{from{opacity:0;transform:translateY(7px) scale(.995)}to{opacity:1;transform:none}}\n}\n${fixed ? '' : '@media(max-width:620px){.zrm-lego-page{padding:12px}.zrm-lego-row{grid-template-columns:1fr}}'}\n`.trim()\n\n  // LES RÉGLAGES DE SOUS-COMPOSANTS S'APPLIQUENT EN DERNIER, sur la page entière (2026-08-04).\n  //\n  // Ils ne peuvent pas s'appliquer plus tôt, au moment où chaque fragment est rendu, parce qu'un\n  // chemin d'indices se compte dans l'arbre FINAL : le fragment n'est pas encore posé dans son\n  // hôte, ses indices ne sont donc pas encore ceux que l'utilisateur voit. Passer en dernier coûte\n  // une analyse de la page, mais c'est la seule position où les chemins disent vrai.\n  const reglages = {}\n  for (const row of composition.rows || []) {\n    for (const item of row.items || []) {\n      if (item?.props?.__nodes && Object.keys(item.props.__nodes).length) reglages[item.id] = item.props.__nodes\n    }\n  }\n  for (const layer of paintOrder(composition)) {\n    if (layer?.props?.__nodes && Object.keys(layer.props.__nodes).length) reglages[layer.id] = layer.props.__nodes\n  }\n\n  const page = `<!doctype html>\n<html lang=\"fr\" data-zrm-theme=\"${escapeHtml(theme.id)}\" data-zrm-format=\"${escapeHtml(format.id)}\" data-zrm-composed=\"1\"${dark ? ' data-zrm-dark=\"1\"' : ''}>\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>${escapeHtml(brief.title)}</title><style>${css}</style></head>\n<body>${definitions.body ? `<div hidden>${definitions.body}</div>` : ''}<main class=\"zrm-lego-page\">${rows.join('')}${calques.html}</main>${interactive ? PONT_SELECTION : ''}</body>\n</html>`\n  return applyOverrides(page, reglages)\n}\n\n// Données offertes aux gabarits HTML déposés à la main.\nexport function templateData(brief, cut, theme, format) {\n  const rt = readingTimeOf(cut)\n  return {\n    title: brief.title,\n    message: brief.message,\n    audience: brief.audience,\n    register: brief.register,\n    intent: brief.intent,\n    themeName: theme.name,\n    formatLabel: format.label,\n    readingMinutes: rt.minutes,\n    words: rt.words,\n    duration: isTemporal(format) ? durationOf(cut, format) : 0,\n    beats: (cut.beats || []).map((b, i) => ({\n      index: i, number: i + 1, role: b.role, roleLabel: ROLE_LABELS[b.role] || b.role,\n      text: b.text, html: escapeHtml(b.text).replace(/\\n/g, '<br>'),\n      weight: b.weight ?? 0.5, tempo: b.tempo || 'calm', duration: beatDuration(b),\n    })),\n  }\n}\n\n/**\n * Compile une page autonome.\n * @returns {{ html: string, meta: object }}\n */\nexport function compile({ brief, cut, theme, format, dark = false, seed = 1, fitScale = null, composition = null, componentBundle = null, interactive = false, selectedId = null }) {\n  if (!brief || !cut || !theme || !format) throw new Error('compile : brief, cut, theme et format sont tous requis.')\n  const next = rng(seed)              // consommé par les thèmes qui en ont besoin ; jamais Math.random\n  const jitter = Math.round(next() * 1000) / 1000\n  // `fitScale` vient de l'ajustement MESURÉ dans le document réel. Quand il est fourni, il gagne\n  // sur l'estimation : une mesure bat toujours une formule. La valeur retenue part dans `meta`,\n  // donc l'export utilise EXACTEMENT la même que l'aperçu.\n  const scale = Number.isFinite(fitScale) && fitScale > 0 ? fitScale : shrinkFactor(cut, format)\n  const rt = readingTimeOf(cut)\n\n  // Voie Lego : dès qu'un composant est posé, la composition devient la source du Stage.\n  // Un document ancien ou une composition vide conserve exactement son gabarit monolithique.\n  // Un document peut n'avoir QUE des calques et aucune rangee : c'est meme le cas normal du\n  // nouveau modele, ou l'on compose en empilant. La voie composee s'ouvre donc sur l'un OU l'autre.\n  if (composition?.rows?.some((row) => row.items?.length) || composition?.layers?.length) {\n    const html = composedPage({ brief, cut, theme, format, dark, scale, bundle: componentBundle, composition, interactive, selectedId })\n    return { html, meta: { scale, seed, readingMinutes: rt.minutes, words: rt.words, source: 'composition', themeId: theme.id, formatId: format.id, omitted: 0, shown: (composition.rows || []).reduce((n, row) => n + (row.items?.length || 0), 0) } }\n  }\n\n  // Voie 2 : gabarit HTML déposé à la main.\n  if (theme.html) {\n    const data = { ...templateData(brief, cut, theme, format), dark, scale, jitter }\n    const body = renderTemplate(theme.html, data)\n    const html = /<html[\\s>]/i.test(body)\n      ? body\n      : `<!doctype html><html lang=\"fr\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>${escapeHtml(brief.title)}</title></head><body>${body}</body></html>`\n    return { html, meta: { scale, seed, readingMinutes: rt.minutes, words: rt.words, source: 'html', themeId: theme.id, formatId: format.id, omitted: omittedCount(cut, format), shown: visibleBeats(cut, format).length } }\n  }\n\n  // Voie 1 : thème à tokens.\n  const css = themeCss(theme, format, { dark, scale })\n  // Surtitre « registre · intention » RETIRÉ de la page le 2026-07-25 (retour Matthieu : « je ne\n  // trouve pas que ça ait vraiment un intérêt »). Ces deux champs pilotent encore le Critique et\n  // la suggestion de thèmes, mais ils n'ont rien à faire sur une page qu'on partage : le lecteur\n  // se moque de savoir dans quel registre on a classé le texte. `chrome.kicker` continue de\n  // gouverner les libellés de rôle DANS les blocs, qui, eux, structurent la lecture.\n  const kicker = ''\n  const standfirst = brief.message ? `      <p class=\"zrm-standfirst\">${escapeHtml(brief.message)}</p>\\n` : ''\n  const bylineBits = []\n  if (theme.chrome.byline && brief.audience) bylineBits.push(`Pour ${brief.audience}`)\n  if (theme.chrome.readingTime) bylineBits.push(isTemporal(format) ? `${durationOf(cut, format)} s` : `${rt.minutes} min de lecture`)\n  const byline = theme.chrome.byline && bylineBits.length ? `      <p class=\"zrm-byline\">${escapeHtml(bylineBits.join(' · '))}</p>\\n` : ''\n  const footer = theme.chrome.footer ? `      <footer class=\"zrm-footer\">${escapeHtml(theme.name)} · ${escapeHtml(format.label)}</footer>\\n` : ''\n\n  const html = `<!doctype html>\n<html lang=\"fr\" data-zrm-theme=\"${escapeHtml(theme.id)}\" data-zrm-format=\"${escapeHtml(format.id)}\" data-zrm-scale=\"${scale}\"${dark ? ' data-zrm-dark=\"1\"' : ''}>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>${escapeHtml(brief.title)}</title>\n  <style>${css}</style>\n</head>\n<body>\n  <div class=\"zrm-frame\">\n    <article class=\"zrm-page\">\n${kicker}      <h1 class=\"zrm-title\">${escapeHtml(brief.title)}</h1>\n${standfirst}${byline}${beatsHtml(cut, theme, format)}\n${footer}    </article>\n  </div>\n</body>\n</html>`\n\n  return { html, meta: { scale, seed, readingMinutes: rt.minutes, words: rt.words, source: 'tokens', themeId: theme.id, formatId: format.id, omitted: omittedCount(cut, format), shown: visibleBeats(cut, format).length } }\n}\n// ZenRayMedia — sorties navigateur (pipelines P1, P2, P3, P7 de 01-PLAN §7).\n//\n// Ce que le navigateur SAIT faire de façon fiable : page HTML autonome, image fixe, PDF via\n// l'impression, texte au presse-papiers. C'est fait ici, réellement.\n// Ce qu'il ne sait PAS faire de façon fiable : encoder du ProRes 4444 alpha. C'est la Forge\n// locale (`forge.js`), et le produit le dit au lieu de faire semblant.\n\nimport { FONTS, essentialFaces } from './fonts.js'\n\nconst FONT_FILES = {\n  AnthropicSerif: '/fonts/AnthropicSerif-Romans.woff2',\n  AnthropicSans: '/fonts/AnthropicSans-Romans.woff2',\n  AnthropicMono: '/fonts/AnthropicMono.woff2',\n}\n\n// Les familles Google Fonts installées, indexées par nom -> liste de fichiers WOFF2.\n// Elles sont sous licence libre (OFL/Apache) : les EMBARQUER dans un fichier livré à un client\n// est autorisé, ce qui est précisément ce dont une page autonome a besoin.\nconst THEME_FONT_FILES = Object.fromEntries(FONTS.map((f) => [f.family, f.faces]))\n\nconst fontCache = new Map()\n\n/** Lit un fichier de police servi par le site et le rend en data URI. Mis en cache. */\nasync function fileDataUrl(url) {\n  if (fontCache.has(url)) return fontCache.get(url)\n  const promise = (async () => {\n    try {\n      const res = await fetch(url)\n      if (!res.ok) return null\n      const bytes = new Uint8Array(await res.arrayBuffer())\n      let binary = ''\n      const CHUNK = 0x8000\n      for (let i = 0; i < bytes.length; i += CHUNK) binary += String.fromCharCode(...bytes.subarray(i, i + CHUNK))\n      return `data:font/woff2;base64,${btoa(binary)}`\n    } catch { return null }\n  })()\n  fontCache.set(url, promise)\n  return promise\n}\n\nasync function fontDataUrl(family) {\n  if (fontCache.has(family)) return fontCache.get(family)\n  const url = FONT_FILES[family]\n  if (!url) return null\n  const promise = (async () => {\n    try {\n      const res = await fetch(url)\n      if (!res.ok) return null\n      const buf = await res.arrayBuffer()\n      let binary = ''\n      const bytes = new Uint8Array(buf)\n      const CHUNK = 0x8000\n      for (let i = 0; i < bytes.length; i += CHUNK) binary += String.fromCharCode(...bytes.subarray(i, i + CHUNK))\n      return `data:font/woff2;base64,${btoa(binary)}`\n    } catch { return null }\n  })()\n  fontCache.set(family, promise)\n  return promise\n}\n\n// ZM-L6-02 : polices EN BASE64 dans la page. Une page exportée qui va chercher sa police sur le\n// réseau n'est pas autonome — ouverte hors ligne ou chez un client, elle change d'apparence.\nexport async function embedFonts(html) {\n  const faces = []\n\n  // 1. Les trois familles Anthropic (chrome et thèmes maison).\n  for (const family of Object.keys(FONT_FILES).filter((f) => html.includes(f))) {\n    const data = await fontDataUrl(family)\n    if (data) faces.push(`@font-face{font-family:'${family}';src:url(${data}) format('woff2');font-weight:100 900;font-style:normal;font-display:block;}`)\n  }\n\n  // 2. Les familles Google Fonts que la page utilise réellement. On embarque CHAQUE coupe\n  //    (romain, italique, sous-ensembles) avec son unicode-range : sans lui, le navigateur\n  //    chargerait la première coupe pour tous les alphabets et l'accentuation casserait.\n  for (const [family, entryFaces] of Object.entries(THEME_FONT_FILES)) {\n    if (!html.includes(family)) continue\n    // On n'embarque que les coupes utiles, cf. `essentialFaces` : trente-six fichiers par famille\n    // dont six servaient, c'est ce qui produisait les 3,8 Mo signalés par le Critique.\n    for (const face of essentialFaces(family).length ? essentialFaces(family) : entryFaces) {\n      const data = await fileDataUrl(face.file)\n      if (!data) continue\n      faces.push(`@font-face{font-family:'${family}';font-style:${face.style};font-weight:${face.weight};font-display:block;src:url(${data}) format('woff2');${face.unicodeRange ? `unicode-range:${face.unicodeRange};` : ''}}`)\n    }\n  }\n\n  if (!faces.length) return html\n  const block = `<style data-zrm-fonts>${faces.join('')}</style>`\n  return html.includes('</head>') ? html.replace('</head>', `${block}</head>`) : `${block}${html}`\n}\n\nexport function downloadBlob(blob, filename) {\n  const url = URL.createObjectURL(blob)\n  const a = document.createElement('a')\n  a.href = url\n  a.download = filename\n  document.body.appendChild(a)\n  a.click()\n  a.remove()\n  // Révocation différée : Safari lit l'URL après le clic, une révocation immédiate annule le\n  // téléchargement sans erreur visible.\n  setTimeout(() => URL.revokeObjectURL(url), 10_000)\n}\n\nexport async function exportHtml(html, filename) {\n  const withFonts = await embedFonts(html)\n  downloadBlob(new Blob([withFonts], { type: 'text/html;charset=utf-8' }), filename)\n  return { bytes: new Blob([withFonts]).size, container: 'html' }\n}\n\n// Image fixe : SVG foreignObject -> canvas -> PNG.\n// Sérialisation via XMLSerializer sur un DOM parsé : c'est ce qui garantit un XHTML bien formé\n// (`<br/>`, `<img/>`…). Une concaténation de chaînes casserait au premier élément vide.\nexport async function exportPng(html, format, filename, { scale = 1 } = {}) {\n  const width = format.canvas.w\n  const height = format.canvas.h || 1200\n  const withFonts = await embedFonts(html)\n\n  const parsed = new DOMParser().parseFromString(withFonts, 'text/html')\n  const svgNS = 'http://www.w3.org/2000/svg'\n  const xhtmlNS = 'http://www.w3.org/1999/xhtml'\n  const svg = document.createElementNS(svgNS, 'svg')\n  svg.setAttribute('xmlns', svgNS)\n  svg.setAttribute('width', String(width))\n  svg.setAttribute('height', String(height))\n  svg.setAttribute('viewBox', `0 0 ${width} ${height}`)\n  const fo = document.createElementNS(svgNS, 'foreignObject')\n  fo.setAttribute('x', '0'); fo.setAttribute('y', '0')\n  fo.setAttribute('width', String(width)); fo.setAttribute('height', String(height))\n  const wrapper = document.createElementNS(xhtmlNS, 'div')\n  wrapper.setAttribute('style', `width:${width}px;height:${height}px;overflow:hidden;`)\n  for (const style of parsed.querySelectorAll('style')) wrapper.appendChild(document.importNode(style, true))\n  for (const child of Array.from(parsed.body.childNodes)) wrapper.appendChild(document.importNode(child, true))\n  fo.appendChild(wrapper)\n  svg.appendChild(fo)\n\n  const serialized = new XMLSerializer().serializeToString(svg)\n  const svgUrl = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(serialized)}`\n\n  const image = await new Promise((resolve, reject) => {\n    const img = new Image()\n    img.onload = () => resolve(img)\n    img.onerror = () => reject(new Error(\"Image non rendue. Cause la plus fréquente : un média distant dans un emplacement. Utilise un fichier déposé (encodé dans la page) plutôt qu'une adresse externe.\"))\n    img.src = svgUrl\n  })\n\n  const canvas = document.createElement('canvas')\n  canvas.width = Math.round(width * scale)\n  canvas.height = Math.round(height * scale)\n  const ctx = canvas.getContext('2d')\n  ctx.fillStyle = '#ffffff'\n  ctx.fillRect(0, 0, canvas.width, canvas.height)\n  ctx.drawImage(image, 0, 0, canvas.width, canvas.height)\n\n  const blob = await new Promise((resolve, reject) => {\n    canvas.toBlob((b) => (b ? resolve(b) : reject(new Error('Encodage PNG refusé par le navigateur.'))), 'image/png')\n  })\n  downloadBlob(blob, filename)\n  return { bytes: blob.size, container: 'png', width: canvas.width, height: canvas.height }\n}\n\n// PDF : on passe par l'impression du navigateur, seul chemin qui produit un vrai PDF vectoriel\n// (texte sélectionnable, 300 dpi réels) sans embarquer de bibliothèque.\nexport async function exportPdf(html) {\n  const withFonts = await embedFonts(html)\n  const frame = document.createElement('iframe')\n  frame.style.cssText = 'position:fixed;right:0;bottom:0;width:0;height:0;border:0;opacity:0;'\n  document.body.appendChild(frame)\n  await new Promise((resolve) => {\n    frame.onload = resolve\n    frame.srcdoc = withFonts\n  })\n  // Laisse au moteur le temps de poser les polices avant d'ouvrir la boîte d'impression.\n  try { await frame.contentDocument?.fonts?.ready } catch { /* fonts API absente : sans effet */ }\n  await new Promise((r) => setTimeout(r, 120))\n  frame.contentWindow?.focus()\n  frame.contentWindow?.print()\n  setTimeout(() => frame.remove(), 60_000)\n  return { container: 'pdf' }\n}\n\nexport async function copyText(text) {\n  try {\n    await navigator.clipboard.writeText(text)\n    return true\n  } catch {\n    // Repli sans API presse-papiers (contexte non sécurisé, permission refusée).\n    const ta = document.createElement('textarea')\n    ta.value = text\n    ta.style.cssText = 'position:fixed;opacity:0;'\n    document.body.appendChild(ta)\n    ta.select()\n    let ok = false\n    try { ok = document.execCommand('copy') } catch { ok = false }\n    ta.remove()\n    return ok\n  }\n}\n\nexport function safeFileName(text, extension) {\n  const base = String(text || 'zenraymedia')\n    .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-+|-+$/g, '').toLowerCase().slice(0, 60) || 'zenraymedia'\n  return `${base}.${extension}`\n}\n// ZenRayMedia — L7 : la Forge.\n//\n// DÉCISION ASSUMÉE (01-PLAN §8). Le rendu vidéo ne tourne PAS dans le navigateur ni sur Vercel :\n//   - les fonctions serverless du projet plafonnent la réponse à ~4,5 Mo (incident 2026-07-21,\n//     fichiers tronqués à 4,2 Mo) ;\n//   - une séquence RGBA 4K pèse 33,18 Mo PAR IMAGE, soit ~29,9 Go pour 30 s à 30 i/s.\n// La Forge est donc un processus LOCAL. C'est ce que veut dire « auto-hébergé ».\n//\n// Ce module ne simule rien : il produit le pipeline EXACT, reproductible, à exécuter sur le Mac.\n// Les réglages viennent du Format, jamais d'une valeur magique.\n\nimport { durationOf, isTemporal } from './formats.js'\nimport { checksumOf } from './contracts.js'\n\nconst shellQuote = (s) => `'${String(s).replace(/'/g, `'\\\\''`)}'`\n\n// Commande d'encodage, dérivée de `format.delivery`.\nexport function ffmpegCommand(format, { input = 'frames (flux)', output } = {}) {\n  const d = format.delivery\n  const fps = format.time?.fps || 30\n  const out = output || `zenraymedia.${d.container}`\n  const common = `-f image2pipe -framerate ${fps} -i -`\n  if (format.kind === 'overlay') {\n    // prores_ks + yuva444p10le : couche alpha réelle. VÉRIFIÉ disponible (ffmpeg 8.1.1).\n    // prores_videotoolbox est volontairement écarté : son support alpha n'est pas mesuré.\n    return `ffmpeg -y ${common} -c:v prores_ks -profile:v 4444 -pix_fmt yuva444p10le -alpha_bits 16 -vendor apl0 ${shellQuote(out)}`\n  }\n  if (format.kind === 'video') {\n    // `-tag:v hvc1` : règle dure du projet. Sans elle, Apple refuse le fichier (bug payé 2026-07-05).\n    return `ffmpeg -y ${common} -c:v ${d.codec} -tag:v ${d.tag} -pix_fmt ${d.pixfmt} -b:v 12M -movflags +faststart ${shellQuote(out)}`\n  }\n  return `ffmpeg -y -i ${shellQuote(input)} ${shellQuote(out)}`\n}\n\nexport function probeCommand(output) {\n  return `ffprobe -v error -count_frames -select_streams v:0 -show_entries stream=nb_read_frames,codec_name,pix_fmt,width,height -show_entries format=duration ${shellQuote(output)}`\n}\n\n/**\n * Script de rendu déterministe, prêt à coller dans `Scripts/`.\n * Le point dur est l'HORLOGE VIRTUELLE : chaque image est posée à `t = n/fps` en déplaçant\n * `currentTime` de toutes les animations. Aucune capture ne dépend de l'horloge réelle, donc\n * deux exécutions produisent le même fichier (règle d'or, 01-PLAN §6.1).\n */\nexport function renderScript({ format, durationSeconds, htmlFileName = 'page.html', output }) {\n  const fps = format.time?.fps || 30\n  const frames = Math.round(durationSeconds * fps)\n  const out = output || `zenraymedia.${format.delivery.container}`\n  const transparent = format.kind === 'overlay'\n\n  return `#!/usr/bin/env node\n// ZenRayMedia — rendu déterministe. Généré par la Forge, à exécuter localement.\n//   npm i -D playwright        (chromium déjà présent dans ~/Library/Caches/ms-playwright)\n//   node zrm-render.mjs\n//\n// GARANTIE : même page + même graine => même fichier, octet pour octet.\n// Vérification obligatoire avant d'aller plus loin (ZM-L6-05) :\n//   node zrm-render.mjs && shasum -a 256 ${out} && node zrm-render.mjs && shasum -a 256 ${out}\n//   -> les deux empreintes DOIVENT être identiques.\n\nimport { chromium } from 'playwright'\nimport { spawn } from 'node:child_process'\nimport { readFileSync } from 'node:fs'\nimport { pathToFileURL } from 'node:url'\n\nconst FPS = ${fps}\nconst FRAMES = ${frames}\nconst WIDTH = ${format.canvas.w}\nconst HEIGHT = ${format.canvas.h}\nconst OUTPUT = ${JSON.stringify(out)}\n\nconst ffmpeg = spawn('ffmpeg', ${JSON.stringify(ffmpegCommand(format, { output: out }).split(' ').slice(1).map((a) => a.replace(/^'|'$/g, '')))}, { stdio: ['pipe', 'inherit', 'inherit'] })\n\nconst browser = await chromium.launch()\nconst page = await browser.newPage({ viewport: { width: WIDTH, height: HEIGHT }, deviceScaleFactor: 1 })\nawait page.setContent(readFileSync(${JSON.stringify(htmlFileName)}, 'utf8'), { waitUntil: 'load' })\n\n// Préchauffage (ZM-L6-03) : polices posées ET images décodées avant la première image.\nawait page.evaluate(async () => { await document.fonts.ready; await Promise.all([...document.images].map((i) => i.decode().catch(() => {}))) })\n\n// Horloge virtuelle (ZM-L6-04/06) : on met en pause toutes les animations et on les POSITIONNE.\nawait page.evaluate(() => { for (const a of document.getAnimations()) { a.pause() } })\n\nfor (let n = 0; n < FRAMES; n++) {\n  const t = (n / FPS) * 1000\n  await page.evaluate((ms) => { for (const a of document.getAnimations()) { a.currentTime = ms } }, t)\n  const buffer = await page.screenshot({ type: 'png', omitBackground: ${transparent} })\n  // Flux DIRECT vers l'encodeur : aucune image n'atteint le disque (ZM-L6-11).\n  if (!ffmpeg.stdin.write(buffer)) await new Promise((r) => ffmpeg.stdin.once('drain', r))\n}\n\nffmpeg.stdin.end()\nawait new Promise((resolve, reject) => ffmpeg.on('close', (code) => (code === 0 ? resolve() : reject(new Error('ffmpeg code ' + code)))))\nawait browser.close()\nconsole.log('OK', OUTPUT, FRAMES, 'images @', FPS, 'i/s')\n`\n}\n\n// Plan complet d'un job temporel : ce qu'il faut faire, dans l'ordre, avec les chiffres réels.\nexport function forgePlan({ brief, cut, theme, format, html, seed }) {\n  const duration = isTemporal(format) ? durationOf(cut, format) : 0\n  const fps = format.time?.fps || 30\n  const frames = Math.round(duration * fps)\n  const bytesPerFrame = format.canvas.w * format.canvas.h * 4\n  return {\n    duration,\n    fps,\n    frames,\n    // Ce chiffre est la raison pour laquelle rien n'est écrit sur le disque.\n    rawBytesIfWrittenToDisk: bytesPerFrame * frames,\n    bytesPerFrame,\n    command: ffmpegCommand(format),\n    probe: probeCommand(`zenraymedia.${format.delivery.container}`),\n    script: renderScript({ format, durationSeconds: duration }),\n    htmlChecksum: checksumOf(html || ''),\n    seed,\n    steps: [\n      'Exporter la page compilée (bouton « Page HTML ») à côté du script.',\n      'Coller le script dans Scripts/zrm-render.mjs.',\n      'Lancer le rendu, puis la sonde ffprobe.',\n      `Vérifier que la sonde annonce exactement ${frames} images.`,\n      'Rejouer le rendu et comparer les empreintes sha256 : elles doivent être identiques.',\n    ],\n  }\n}\n\nexport function formatBytes(bytes) {\n  if (!Number.isFinite(bytes) || bytes <= 0) return '0 o'\n  const units = ['o', 'ko', 'Mo', 'Go', 'To']\n  const i = Math.min(units.length - 1, Math.floor(Math.log(bytes) / Math.log(1024)))\n  const value = bytes / Math.pow(1024, i)\n  return `${value >= 100 ? Math.round(value) : Math.round(value * 10) / 10} ${units[i]}`\n}\n// ZenRayMedia — L8 : PUBLIER.\n//\n// Publier n'est pas enregistrer (cf. `document.js`) :\n//   enregistrer -> `.zmedia.json`, la SOURCE, pour rouvrir et continuer ;\n//   publier     -> une PAGE `.md` dans Create, figée, lisible, cherchable, adressable par URL.\n//\n// Le format de sortie est du Markdown, pas du HTML compilé. Raison : une page `.md` est un\n// citoyen de première classe de Create — elle s'ouvre dans l'éditeur, se cherche, se déplace,\n// se partage, se modifie. Une page HTML serait un corps étranger qu'aucun outil du projet ne\n// saurait relire. Le rendu stylé, lui, reste l'export (`exporters.js`).\n\nimport { saveText } from '../ref/content.js'\nimport { ROLE_LABELS } from './contracts.js'\nimport { visibleBeats } from './compile.js'\nimport { slugify } from './document.js'\n\n/** Markdown d'un article. Déterministe : mêmes entrées, même texte, à l'octet près. */\nexport function toMarkdown({ brief, cut, theme, format }) {\n  const lines = []\n  lines.push(`# ${brief.title}`)\n  lines.push('')\n  if (brief.message) { lines.push(`> ${brief.message}`); lines.push('') }\n  if (brief.audience) { lines.push(`*Pour ${brief.audience}.*`); lines.push('') }\n\n  for (const beat of visibleBeats(cut, format)) {\n    // Le rôle devient un intertitre seulement quand il porte du sens à la lecture. Une accroche\n    // et une chute n'ont pas besoin d'être annoncées : elles se reconnaissent à leur place.\n    if (!['hook', 'payoff'].includes(beat.role)) {\n      lines.push(`### ${ROLE_LABELS[beat.role] || beat.role}`)\n      lines.push('')\n    }\n    lines.push(String(beat.text).trim())\n    lines.push('')\n    for (const slot of beat.slots || []) {\n      const src = slot.dataUrl || slot.url\n      if (src) { lines.push(`![${(slot.label || '').replace(/[[\\]]/g, '')}](${src})`); lines.push('') }\n    }\n  }\n\n  lines.push('---')\n  lines.push('')\n  lines.push(`*Composé avec ZenRayMedia · thème « ${theme.name} » · format ${format.label}.*`)\n  lines.push('')\n  return lines.join('\\n')\n}\n\nexport function publishPathFor(dir, title) {\n  return `${String(dir).replace(/\\/+$/, '')}/${slugify(title)}.md`\n}\n\n/** URL de l'application qui ouvre directement cette page. */\nexport function pageUrlFor(path, origin) {\n  const base = origin || (typeof window !== 'undefined' ? window.location.origin : '')\n  return `${base}/?page=${encodeURIComponent(path)}`\n}\n\n/**\n * Publie l'article et rend son adresse.\n *\n * Trois étapes, dans cet ordre, parce que l'ordre compte :\n *   1. écrire la page (si ça échoue, rien d'autre ne doit se produire) ;\n *   2. l'ajouter à l'index de recherche (sinon elle existe mais reste introuvable) ;\n *   3. rendre l'URL — ET SEULEMENT SI les deux premières ont réussi.\n *\n * L'indexation est volontairement NON bloquante : une page écrite mais pas encore indexée est\n * un défaut mineur et réparable (elle sera reprise au prochain build d'index), alors qu'une\n * publication annulée parce que l'index a hoqueté serait une perte pour rien.\n */\nexport async function publishArticle({ dir, brief, cut, theme, format, sha, origin }) {\n  const path = publishPathFor(dir, brief.title)\n  const markdown = toMarkdown({ brief, cut, theme, format })\n\n  const written = await saveText(path, markdown, sha)\n  if (written.conflict) return { ok: false, conflict: true, path, error: 'Une page porte déjà ce nom et a changé depuis. Renomme l’article ou recharge.' }\n  if (!written.ok) return { ok: false, path, error: written.error === 'network' ? 'Publication impossible (réseau).' : `Publication refusée (${written.error || 'inconnu'}).` }\n\n  let indexed = true\n  try {\n    const res = await fetch('/api/page', {\n      method: 'POST', headers: { 'content-type': 'application/json' },\n      body: JSON.stringify({ action: 'index-add', paths: [path] }),\n    }).then((r) => r.json()).catch(() => null)\n    indexed = !!(res && !res.error)\n  } catch { indexed = false }\n\n  return { ok: true, path, sha: written.sha, indexed, url: pageUrlFor(path, origin), bytes: new Blob([markdown]).size }\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"6b8c71a4-bf2e-4775-bb32-5a852d61030b"}}}
