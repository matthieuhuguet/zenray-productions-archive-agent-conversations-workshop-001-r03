{ ...l, ...applyConstraints(l, oldCanvas, newCanvas) }))\n  return { ...composition, layers }\n}\n\n// ═══════════════════════════════════════════════════════════════════════════════════════════════\n// FAMILLE FIGMA 4 · AUTO LAYOUT (carte F4, 2026-08-04)\n//\n// « Le parent réagit immédiatement aux changements de contenu. » C'est la différence entre Auto\n// Layout et un simple alignement ponctuel (déjà fait, carte P2) : un alignement s'applique UNE\n// fois et se fige, Auto Layout reste une CONTRAINTE qui se réapplique à chaque geste — ajouter un\n// membre, en retirer un, redimensionner l'un d'eux.\n//\n// PORTÉE ASSUMÉE, ET C'EST DIT PLUTÔT QUE CACHÉ : Figma calcule aussi le « Hug/Fill/Fixed » de\n// CHAQUE axe du conteneur lui-même, ce qui suppose qu'un groupe possède sa propre géométrie — or\n// un groupe de ce produit n'est qu'une étiquette (carte P5), sans boîte propre. Réintroduire une\n// géométrie de groupe rouvrirait le contrat une troisième fois pour une carte de plus. Ce qui EST\n// fait, et qui est le cœur de la valeur du geste, « je n'ai plus à déplacer chaque voisin à la\n// main » : les membres d'un groupe en Auto Layout se rangent en ligne ou en colonne, avec un écart\n// et une marge, ancrés au coin où le groupe se trouvait à l'activation, et cela se RECALCULE à\n// chaque mutation de la composition, pas une fois pour toutes.\nexport function toggleAutoLayout(composition, groupId, direction = 'column') {\n  const groups = readGroups(composition)\n  const groupe = groups.find((g) => g.id === groupId)\n  if (!groupe) return composition\n  if (groupe.autoLayout) {\n    // Désactiver GÈLE la disposition telle qu'elle est : les membres gardent leur position\n    // actuelle, comme Figma qui conserve la géométrie au moment où Auto Layout est retiré.\n    return patchGroup(composition, groupId, { autoLayout: null })\n  }\n  const membres = readLayers(composition).filter((l) => l.groupId === groupId)\n  if (!membres.length) return composition\n  const gauche = Math.min(...membres.map((l) => l.x))\n  const haut = Math.min(...membres.map((l) => l.y))\n  return patchGroup(composition, groupId, { autoLayout: { direction, gap: 8, padding: 0 }, autoX: gauche, autoY: haut })\n}\n\nexport function setAutoLayoutProp(composition, groupId, patch) {\n  const groupe = readGroups(composition).find((g) => g.id === groupId)\n  if (!groupe?.autoLayout) return composition\n  return patchGroup(composition, groupId, { autoLayout: { ...groupe.autoLayout, ...patch } })\n}\n\n/**\n * Réaligne les membres de CHAQUE groupe en Auto Layout, dans l'ordre d'empilement (même ordre que\n * `paintOrder`, pour que la pile visuelle et le flux de lecture ne racontent jamais deux histoires\n * différentes). Fonction PURE, appelée après CHAQUE mutation de la composition — c'est ce qui la\n * rend « vivante » plutôt que ponctuelle.\n */\nexport function applyAutoLayout(composition) {\n  const groups = readGroups(composition)\n  if (!groups.some((g) => g.autoLayout)) return composition\n  let layers = readLayers(composition)\n  for (const groupe of groups) {\n    if (!groupe.autoLayout) continue\n    const membres = layers.filter((l) => l.groupId === groupe.id).sort((a, b) => a.z - b.z)\n    if (!membres.length) continue\n    const { direction, gap, padding } = groupe.autoLayout\n    const ancreX = Number.isFinite(groupe.autoX) ? groupe.autoX : membres[0].x\n    const ancreY = Number.isFinite(groupe.autoY) ? groupe.autoY : membres[0].y\n    let curseur = (direction === 'row' ? ancreX : ancreY) + padding\n    const places = new Map()\n    for (const m of membres) {\n      const x = direction === 'row' ? curseur : ancreX + padding\n      const y = direction === 'row' ? ancreY + padding : curseur\n      places.set(m.id, { x: Math.round(x), y: Math.round(y) })\n      curseur += (direction === 'row' ? m.w : m.h) + gap\n    }\n    layers = layers.map((l) => (places.has(l.id) ? { ...l, ...places.get(l.id) } : l))\n  }\n  return { ...composition, layers }\n}\n"