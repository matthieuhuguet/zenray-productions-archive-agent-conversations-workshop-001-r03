{"timestamp":"2026-08-05T17:39:00.714Z","ordinal":1701,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd301-d5ea-7ca3-8023-5fc35b05f28e","call_id":"call_ZmdYht7Yn7tjABbB06ACxzbz","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"---1---\n// ZenRayMedia — L8 : le document `.zmedia.json` dans Create.\n//\n// DEUX CHOSES DIFFÉRENTES, souvent confondues (retour Matthieu 2026-07-25) :\n//\n//   1. ENREGISTRER  = ranger le document dans MON index, à un endroit que je choisis, pour le\n//      rouvrir et continuer à travailler. C'est ce fichier-ci. Le contenu est la SOURCE\n//      (brief + blocs + thème + format), pas le rendu.\n//   2. PUBLIER      = produire une page figée et partageable. C'est `exporters.js`.\n//\n// Même hiérarchie de dossiers, deux affichages et deux intentions distinctes. On peut enregistrer\n// sans jamais publier, et republier sans réenregistrer.\n//\n// Le fichier reste volontairement LISIBLE et MINUSCULE : aucun HTML compilé n'y est stocké, il se\n// recompile en quelques millisecondes. Stocker le rendu créerait deux vérités qui divergeraient.\n\nimport { readJson, saveJson, listChildren } from '../ref/content.js'\nimport { emptyBrief, makeId, validate } from './contracts.js'\nimport { DEFAULT_THEME_ID } from './themes/registry.js'\n\nexport const ZMEDIA_EXT = '.zmedia.json'\nexport const ZMEDIA_VERSION = 2\nexport const DEFAULT_MEDIA_DIR = 'pages/Media'\n\nexport function isZMediaPath(path) { return typeof path === 'string' && path.endsWith(ZMEDIA_EXT) }\n\nexport function slugify(text) {\n  return String(text || '')\n    .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-+|-+$/g, '')\n    .toLowerCase().slice(0, 60) || 'media'\n}\n\n// Chemin proposé pour un projet dans un dossier donné. Le suffixe court évite d'écraser un\n// homonyme sans avoir à interroger le serveur avant d'afficher une proposition.\nexport function suggestPath(dir, title, salt = 0) {\n  // Normaliser D'ABORD, se servir de la valeur normalisée PARTOUT ensuite.\n  // Bug réel (2026-07-25) : l'empreinte était calculée sur `dir` brut alors que le chemin final\n  // utilisait `dir` nettoyé -> « pages/Media » et « pages/Media/ » désignent le même dossier mais\n  // produisaient deux noms de fichier différents. Un même document enregistré deux fois depuis\n  // deux points d'entrée aurait créé deux fichiers au lieu d'un.\n  const folder = String(dir || DEFAULT_MEDIA_DIR).replace(/\\/+$/, '')\n  const base = slugify(title)\n  const suffix = makeId('', `${folder}/${base}`, salt).replace(/^-/, '').slice(-4)\n  return `${folder}/${base}-${suffix}${ZMEDIA_EXT}`\n}\n\n// --- Sérialisation ------------------------------------------------------------------------------\nexport function toDocument(project, { themeId, formatId, path }) {\n  return {\n    type: 'zenraymedia',\n    v: ZMEDIA_VERSION,\n    title: project.brief?.title || 'Sans titre',\n    path: path || null,\n    brief: project.brief,\n    notes: project.notes || '',\n    cut: project.cut || null,\n    compositions: project.compositions || {},\n    themeId: themeId || DEFAULT_THEME_ID,\n    formatId: formatId || 'F-web-article',\n    seed: project.seed ?? 1,\n  }\n}\n\n// Tolérant en LECTURE, strict en écriture : un document écrit par une version future ne doit pas\n// faire planter l'application, juste perdre ce qu'elle ne comprend pas.\nexport function fromDocument(doc, path) {\n  if (!doc || doc.type !== 'zenraymedia') return null\n  const brief = { ...emptyBrief(), ...(doc.brief || {}) }\n  if (!brief.id) brief.id = makeId('brief', path || doc.title || 'zmedia', 0)\n  return {\n    project: {\n      id: makeId('project', path || doc.title || 'zmedia', 0),\n      brief,\n      notes: typeof doc.notes === 'string' ? doc.notes : '',\n      cut: doc.cut && Array.isArray(doc.cut.beats) && doc.cut.beats.length ? doc.cut : null,\n      // Une composition par thème : essayer une autre famille ne détruit jamais le montage Lego.\n      // `composition` garde la lecture tolérante d'une courte version de développement.\n      compositions: doc.compositions && typeof doc.compositions === 'object'\n        ? doc.compositions\n        : (doc.composition?.themeId ? { [doc.composition.themeId]: doc.composition } : {}),\n      seed: Number.isFinite(doc.seed) ? doc.seed : 1,\n      path: path || doc.path || null,\n    },\n    themeId: doc.themeId || DEFAULT_THEME_ID,\n    formatId: doc.formatId || 'F-web-article',\n  }\n}\n\n// --- Entrées / sorties ---------------------------------------------------------------------------\n/** Lit un document. `{ ok, project, themeId, formatId, sha, error }` — ne lève jamais. */\nexport async function loadDocument(path) {\n  if (!isZMediaPath(path)) return { ok: false, error: 'Chemin qui n’est pas un document ZenRayMedia.' }\n  const { data, sha, missing, error } = await readJson(path)\n  if (missing) return { ok: false, error: 'Document introuvable.' }\n  if (error) return { ok: false, error: error === 'parse' ? 'Document illisible (JSON invalide).' : 'Lecture impossible (réseau).' }\n  const parsed = fromDocument(data, path)\n  if (!parsed) return { ok: false, error: 'Ce fichier n’est pas un document ZenRayMedia.' }\n  return { ok: true, ...parsed, sha }\n}\n\n/**\n * Écrit un document. `sha` est celui lu précédemment : c'est lui qui permet à GitHub de refuser\n * une écriture concurrente plutôt que d'écraser le travail d'un autre onglet.\n */\nexport async function saveDocument(path, project, { themeId, formatId, sha } = {}) {\n  const errors = validate('brief', project?.brief || null)\n  if (errors.length) return { ok: false, error: `Document incomplet : ${errors[0].message}` }\n  const doc = toDocument(project, { themeId, formatId, path })\n  const res = await saveJson(path, doc, sha)\n  if (res.conflict) return { ok: false, conflict: true, error: 'Ce document a été modifié ailleurs. Recharge-le avant d’enregistrer.' }\n  if (!res.ok) return { ok: false, error: res.error === 'network' ? 'Enregistrement impossible (réseau).' : `Enregistrement refusé (${res.error || 'inconnu'}).` }\n  return { ok: true, sha: res.sha }\n}\n\n// --- Navigation de dossiers (le fil d'Ariane) -------------------------------------------------\n/** Sous-dossiers directs d'un dossier, triés. `listChildren` passe par l'API `children`. */\nexport async function listFolders(dir) {\n  const entries = await listChildren(dir)\n  return entries\n    .filter((e) => e && e.type === 'dir')\n    .map((e) => ({ name: e.name, path: e.path }))\n    .sort((a, b) => a.name.localeCompare(b.name, 'fr'))\n}\n\n/** Documents ZenRayMedia directement dans un dossier. */\nexport async function listDocuments(dir) {\n  const entries = await listChildren(dir)\n  return entries\n    .filter((e) => e && e.type !== 'dir' && isZMediaPath(e.path || e.name))\n    .map((e) => ({ name: String(e.name).replace(ZMEDIA_EXT, ''), path: e.path }))\n    .sort((a, b) => a.name.localeCompare(b.name, 'fr'))\n}\n\n/** Segments d'un chemin de dossier, pour l'affichage du fil d'Ariane. */\nexport function crumbsOf(dir) {\n  const parts = String(dir || '').split('/').filter(Boolean)\n  return parts.map((name, i) => ({ name, path: parts.slice(0, i + 1).join('/') }))\n}\n\nexport function parentOf(dir) {\n  const parts = String(dir || '').split('/').filter(Boolean)\n  return parts.length > 1 ? parts.slice(0, -1).join('/') : parts[0] || 'pages'\n}\n\nexport function dirOf(path) {\n  const i = String(path || '').lastIndexOf('/')\n  return i > 0 ? path.slice(0, i) : DEFAULT_MEDIA_DIR\n}\n          ...item,\n        })),\n      }))\n      .filter((row) => row.items.length),\n  }\n}\n\nfunction allocate(composition, prefix, salt) {\n  const serial = composition.serial + 1\n  return { id: makeId(prefix, `${composition.themeId}:${salt}`, serial), serial }\n}\n\nexport function componentInstance(composition, component) {\n  const next = allocate(composition, 'cmp', component.id)\n  return {\n    serial: next.serial,\n    item: {\n      id: next.id,\n      kind: 'component',\n      themeId: composition.themeId,\n      componentId: component.id,\n      name: component.name,\n      group: component.group,\n      hidden: false,\n      locked: false,\n      props: {},\n    },\n  }\n}\n\nexport function imageInstance(composition, image) {\n  const next = allocate(composition, 'img', image.path || image.name)\n  return {\n    serial: next.serial,\n    item: {\n      id: next.id,\n      kind: 'image',\n      name: image.name || 'Image',\n      refPath: image.path || null,\n      url: image.url || '',\n      hidden: false,\n      locked: false,\n      props: { fit: 'cover', radius: 18, ratio: '16 / 9' },\n    },\n  }\n}\n\nfunction locate(rows, itemId) {\n  for (let rowIndex = 0; rowIndex < rows.length; rowIndex += 1) {\n    const itemIndex = rows[rowIndex].items.findIndex((item) => item.id === itemId)\n    if (itemIndex >= 0) return { rowIndex, itemIndex }\n  }\n  return null\n}\n\nfunction newRow(composition, item, serial) {\n  return { id: makeId('row', `${composition.themeId}:${item.id}`, serial), items: [item] }\n}\n\nexport function insertItem(value, item, targetId = null, placement = 'below', serial = value.serial) {\n  const composition = normalizeComposition(value, value.themeId)\n  const rows = composition.rows.map((row) => ({ ...row, items: [...row.items] }))\n  const target = targetId ? locate(rows, targetId) : null\n\n  if (!target) {\n    rows.push(newRow(composition, item, serial))\n    document.body.appendChild(ta)\n    ta.select()\n    let ok = false\n    try { ok = document.execCommand('copy') } catch { ok = false }\n    ta.remove()\n    return ok\n  }\n}\n\nexport function safeFileName(text, extension) {\n  const base = String(text || 'zenraymedia')\n    .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-+|-+$/g, '').toLowerCase().slice(0, 60) || 'zenraymedia'\n  return `${base}.${extension}`\n}\n"},{"type":"input_text","text":"---2---\n// ZenRayMedia — le fil d'Ariane de Create.\n//\n// UN SEUL composant pour les deux gestes, parce que c'est le même geste : parcourir la même\n// arborescence.\n//   mode=\"save\" -> choisir le dossier de destination et le nom du fichier\n//   mode=\"open\" -> parcourir et ouvrir un document existant\n//\n// Il ne charge QUE le dossier affiché (`action=children`, non récursif) : parcourir un drive de\n// plusieurs milliers de nœuds ne coûte jamais plus qu'un seul appel par dossier ouvert.\n\nimport React from 'react'\nimport Icon from '../components/Icon.jsx'\nimport { listFolders, listDocuments, crumbsOf, parentOf, slugify, ZMEDIA_EXT, DEFAULT_MEDIA_DIR } from './document.js'\n\nexport default function CreateBrowser({ mode = 'save', startDir = DEFAULT_MEDIA_DIR, defaultName = '', onCancel, onConfirm, onOpen, busy = false }) {\n  const [dir, setDir] = React.useState(startDir)\n  const [folders, setFolders] = React.useState([])\n  const [documents, setDocuments] = React.useState([])\n  const [loading, setLoading] = React.useState(true)\n  const [name, setName] = React.useState(slugify(defaultName))\n  const [newFolder, setNewFolder] = React.useState('')\n\n  React.useEffect(() => {\n    let cancelled = false\n    setLoading(true)\n    Promise.all([listFolders(dir), mode === 'open' ? listDocuments(dir) : Promise.resolve([])])\n      .then(([f, d]) => { if (!cancelled) { setFolders(f); setDocuments(d) } })\n      .catch(() => { if (!cancelled) { setFolders([]); setDocuments([]) } })\n      .finally(() => { if (!cancelled) setLoading(false) })\n    return () => { cancelled = true }\n  }, [dir, mode])\n\n  const crumbs = crumbsOf(dir)\n  const atRoot = crumbs.length <= 1\n  const finalPath = `${dir.replace(/\\/+$/, '')}/${slugify(name) || 'media'}${ZMEDIA_EXT}`\n\n  // Un dossier n'existe pas tant qu'il ne contient rien : on ne crée donc rien tout de suite,\n  // on descend simplement dedans. Le dossier naîtra avec le premier fichier écrit — c'est déjà\n  // le comportement de Git, inutile d'inventer une étape de création qui pourrait échouer.\n  const enterNewFolder = () => {\n    const slug = slugify(newFolder)\n    if (!slug) return\n    setDir(`${dir.replace(/\\/+$/, '')}/${slug}`)\n    setNewFolder('')\n  }\n\n  return (\n    <div className=\"zrm-browser\">\n      <div className=\"zrm-crumbs\">\n        <button className=\"zrm-btn zrm-btn-sm zrm-btn-icon\" title=\"Dossier parent\" onClick={() => setDir(parentOf(dir))} disabled={atRoot}>\n          <Icon name=\"chevron.left\" size={12} />\n        </button>\n        {crumbs.map((crumb, i) => (\n          <React.Fragment key={crumb.path}>\n            {i > 0 && <span className=\"zrm-crumb-sep\">/</span>}\n            <button className=\"zrm-crumb\" data-on={i === crumbs.length - 1} onClick={() => setDir(crumb.path)}>{crumb.name}</button>\n          </React.Fragment>\n        ))}\n      </div>\n\n      <div className=\"zrm-browser-list\">\n        {loading && <p className=\"zrm-note\">Lecture du dossier…</p>}\n        {!loading && folders.length === 0 && documents.length === 0 && <p className=\"zrm-note\">Dossier vide.</p>}\n        {folders.map((folder) => (\n          <button key={folder.path} className=\"zrm-browser-row\" onClick={() => setDir(folder.path)}>\n            <Icon name=\"folder\" size={14} />\n            <span className=\"zrm-browser-name\">{folder.name}</span>\n            <Icon name=\"chevron.right\" size={11} />\n          </button>\n        ))}\n        {documents.map((doc) => (\n          <button key={doc.path} className=\"zrm-browser-row\" data-doc=\"true\" onClick={() => onOpen?.(doc.path)}>\n            <Icon name=\"doc.text\" size={14} />\n            <span className=\"zrm-browser-name\">{doc.name}</span>\n          </button>\n        ))}\n      </div>\n\n      {mode === 'save' ? (\n        <div className=\"zrm-browser-foot\">\n          <div className=\"zrm-row\">\n            <input className=\"zrm-input\" aria-label=\"Nom du fichier\" value={name} placeholder=\"nom-du-document\"\n              onChange={(e) => setName(e.target.value)} onKeyDown={(e) => { if (e.key === 'Enter') onConfirm?.(finalPath) }} />\n            <input className=\"zrm-input\" aria-label=\"Nouveau sous-dossier\" value={newFolder} placeholder=\"+ sous-dossier\"\n              onChange={(e) => setNewFolder(e.target.value)} onKeyDown={(e) => { if (e.key === 'Enter') enterNewFolder() }} />\n          </div>\n          <p className=\"zrm-mono zrm-browser-path\" title={finalPath}>{finalPath}</p>\n          <div className=\"zrm-row\">\n            <button className=\"zrm-btn\" onClick={onCancel} disabled={busy}>Annuler</button>\n            <button className=\"zrm-btn zrm-btn-primary\" onClick={() => onConfirm?.(finalPath)} disabled={busy || !slugify(name)}>\n              {busy ? 'Enregistrement…' : 'Enregistrer ici'}\n            </button>\n          </div>\n        </div>\n      ) : (\n        <div className=\"zrm-browser-foot\">\n          <button className=\"zrm-btn\" onClick={onCancel}>Fermer</button>\n        </div>\n      )}\n    </div>\n  )\n}\n  // --- État ---------------------------------------------------------------------------------\n  const [projects, setProjects] = React.useState(() => loadProjects())\n  const [currentId, setCurrentId] = React.useState(() => loadCurrentId() || loadProjects()[0]?.id)\n  const [themeId, setThemeId] = React.useState(DEFAULT_THEME_ID)\n  const [formatId, setFormatId] = React.useState('F-web-article')\n  const [renderDark, setRenderDark] = React.useState(false)\n  const [theme, setTheme] = React.useState(null)\n  const [themeError, setThemeError] = React.useState('')\n  // L'onglet d'ouverture devient « Détails » : c'est le geste central d'un éditeur type UMG, on\n  // sélectionne une pièce et on lit ses propriétés. Ouvrir sur « Thèmes » plaçait le catalogue au\n  // premier plan, or le catalogue est un choix qu'on fait UNE fois par document.\n  const [deckTab, setDeckTab] = React.useState('details')\n  const [menuOpen, setMenuOpen] = React.useState(null)   // zone 1 · menu déroulant ouvert\n  // Le SOUS-COMPOSANT sélectionné, distinct de la pièce : on sélectionne une pièce, puis un nœud\n  // dans cette pièce. Deux niveaux, comme dans Unreal où l'on choisit un widget puis un slot.\n  const [selectedNode, setSelectedNode] = React.useState(null)   // chemin d'indices, ou null\n  const [openNodes, setOpenNodes] = React.useState({})       // les PIÈCES dépliées\n  const [ouverts, setOuverts] = React.useState({})           // les NŒUDS dépliés, clef « inst:chemin »\n  // LES GROUPES DE LA HIÉRARCHIE, replies par leur clef : la racine, la pile de calques, chaque\n  // rangée. Ils n'avaient AUCUN état, ce qui explique que « le repli ne fonctionne toujours pas » :\n  // leurs triangles étaient décoratifs et le bouton « tout replier » n'avait rien à replier.\n  const [groupesReplies, setGroupesReplies] = React.useState({})\n  const replier = React.useCallback((clef) => setGroupesReplies((g) => ({ ...g, [clef]: !g[clef] })), [])\n\n  // LA SÉLECTION MULTIPLE. `selectedComponent` reste la sélection PRINCIPALE, celle que le panneau\n  // de droite affiche, parce qu'on ne règle pas quinze objets à la fois. `selection` porte\n  // l'ensemble, sur lequel agissent masquer, verrouiller et retirer.\n  const [selection, setSelection] = React.useState([])\n  const ancreRef = React.useRef(null)\n\n  // LE VERROU DU PANNEAU DE DÉTAILS (famille 1, doc Slate §« Details Panel Locking »).\n  //\n  // Verrouiller ROMPT la synchronisation automatique : l'utilisateur continue de sélectionner\n  // d'autres pièces dans la hiérarchie ou dans l'aperçu, mais le panneau de droite garde celles\n  // du premier objet. Cela sert à comparer deux pièces, ou à lire les réglages de l'une pendant\n  // qu'on en pose une autre. `panelLockedId` porte l'objet gelé ; `null` signifie « non verrouillé,\n  // le panneau suit ».\n  const [panelLockedId, setPanelLockedId] = React.useState(null)\n\n\n\n  const [animOpen, setAnimOpen] = React.useState(false)\n  const [hierQuery, setHierQuery] = React.useState('')   // zone 6 · filtre de l'arbre\n  const [detSections, setDetSections] = React.useState({}) // zone 5 · sections repliées\n  const [openFamilies, setOpenFamilies] = React.useState({})\n  const [paletteOpen, setPaletteOpen] = React.useState(false)\n  const [query, setQuery] = React.useState('')\n  const [paletteIndex, setPaletteIndex] = React.useState(0)\n  const [toast, setToast] = React.useState(null)\n  const [busy, setBusy] = React.useState(null)\n  const [renderedIssues, setRenderedIssues] = React.useState([])\n  const [log, setLog] = React.useState(() => loadLog())\n  const [showSafe, setShowSafe] = React.useState(false)\n  const [selectedBeat, setSelectedBeat] = React.useState(0)\n  const [actionCount, setActionCount] = React.useState(0)\n  const [componentBundle, setComponentBundle] = React.useState(null)\n  // LE REPLI DES PANNEAUX EXISTAIT DEJA, PERSONNE NE L'APPELAIT (remis en service le 2026-08-01).\n  //\n  // `media.css` porte `[data-panes=\"two\"]` et `[data-panes=\"one\"]` depuis l'origine, et cette ligne\n  // ecrivait `data-panes=\"three\"` EN DUR, sans etat ni condition. Le manque de place dont Matthieu\n  // se plaint tenait donc pour une part a un mecanisme deja ecrit : le remettre en service coute un\n  // etat et un attribut, pas une refonte.\n  //\n  // On MASQUE au lieu de demonter, et c'est deliberé. Demonter le panneau Details ferait perdre une\n  // edition en cours, exactement le bug de double montage paye le 2026-07-30 sur la vue Plan : un\n  // composant qui se demonte ecrit son etat au passage. Masque, il garde tout et revient intact.\n  const [panes, setPanes] = React.useState('three')\n  // LES LARGEURS DE COLONNES (famille 3, docking). En mémoire pour cette session : une disposition\n  // enregistrée entre deux ouvertures aurait été une fonctionnalité de plus, non demandée par cette\n  // carte, qui porte sur le GESTE de redimensionnement et non sur sa persistance.\n  const [colWidths, setColWidths] = React.useState({ left: 212, right: 244 })\n      .then((loaded) => { if (!cancelled) setTheme(loaded) })\n      .catch((err) => { if (!cancelled) { setTheme(null); setThemeError(err.message) } })\n    return () => { cancelled = true }\n  }, [themeId])\n\n  React.useEffect(() => { setSelectedComponent(null); setDropTarget(null) }, [themeId])\n\n  React.useEffect(() => {\n    let cancelled = false\n    setComponentBundle(null)\n    loadThemeComponents(themeId)\n      .then((loaded) => { if (!cancelled) setComponentBundle(loaded) })\n      .catch(() => { if (!cancelled) setComponentBundle({ themeId, components: [], tokensCss: '', definitionsHtml: '' }) })\n    return () => { cancelled = true }\n  }, [themeId])\n\n  React.useEffect(() => {\n    if (libraryTab !== 'images' || imageIndexReady) return undefined\n    let live = true\n    loadSearchIndex().then(() => { if (live) setImageIndexReady(true) }).catch(() => { if (live) setImageIndexReady(true) })\n    return () => { live = false }\n  }, [libraryTab, imageIndexReady])\n\n  // --- Cut : construit à la demande, jamais écrasé en silence --------------------------------\n  const cut = project?.cut\n  const composition = React.useMemo(\n    () => normalizeComposition(project?.compositions?.[themeId], themeId),\n    [project?.compositions, themeId],\n  )\n  // Le verrou se libère tout seul si l'objet auquel il tient a disparu (retiré, undo) : sinon le\n  // panneau resterait vide sans qu'aucun signe explique pourquoi, ce qui se lit comme un bug\n  // plutôt que comme l'état voulu.\n  React.useEffect(() => {\n    if (!panelLockedId) return\n    const existe = findLayer(composition, panelLockedId)\n      || (composition.rows || []).some((r) => (r.items || []).some((it) => it.id === panelLockedId))\n    if (!existe) setPanelLockedId(null)\n  }, [composition, panelLockedId])\n\n  // ═══ FAMILLE PHOTOSHOP 8 · HISTORIQUE — ANNULER ET RÉTABLIR ═══════════════════════════════════\n  //\n  // « L'historique est le filet sous le trapèze. Sans lui, l'utilisateur hésite, travaille plus\n  // lentement et évite les expérimentations. » C'est le point que la doc Photoshop range dans le\n  // noyau indispensable de la famille, et c'était la carte L7, déjà notée et déjà différée depuis\n  // le tableau du 2026-08-04.\n  //\n  // `patchComposition` est l'UNIQUE point d'entrée de toute modification de la composition — pièces\n  // Lego et calques confondus — depuis la carte C1. C'est ce qui rend l'historique possible sans\n  // instrumenter chaque geste séparément : il suffit d'empiler l'état PRÉCÉDENT à cet unique\n  // endroit, et tout ce qui transite déjà par lui (déplacer, redimensionner, régler un style,\n  // grouper, retirer) devient annulable sans une ligne de plus ailleurs.\n  //\n  // BORNÉ À CINQUANTE ÉTATS : Photoshop borne aussi son historique par défaut. Un historique\n  // infini fuirait la mémoire sur une session longue, et personne ne remonte cinquante gestes en\n  // arrière — la doc elle-même dit que les états les plus anciens s'effacent d'eux-mêmes.\n  const HISTORIQUE_MAX = 50\n  const [pileAnnuler, setPileAnnuler] = React.useState([])\n  const [pileRetablir, setPileRetablir] = React.useState([])\n\n  // Un changement de DOCUMENT ou de THÈME ouvre un historique NEUF : annuler ne doit jamais faire\n  // remonter un geste posé sur un autre brief, ce qui serait aussi déroutant qu'un Ctrl+Z de\n  // traitement de texte qui modifierait soudain un autre fichier.\n  React.useEffect(() => { setPileAnnuler([]); setPileRetablir([]) }, [currentId, themeId])\n\n  const patchComposition = React.useCallback((nextOrFactory) => {\n    const avant = normalizeComposition(project?.compositions?.[themeId], themeId)\n    patchProject((p) => {\n      const current = normalizeComposition(p.compositions?.[themeId], themeId)\n      const brut = typeof nextOrFactory === 'function' ? nextOrFactory(current) : nextOrFactory\n      // Un groupe en Auto Layout (carte Figma F4) n'est jamais qu'un alignement figé : c'est une\n      // CONTRAINTE, réappliquée après CHAQUE mutation, pas seulement au moment où elle s'active.\n      // Même principe pour un connecteur (carte Miro F6/M6) : sa géométrie suit les calques qu'il\n      // relie, recalculée ici plutôt qu'au seul moment où on l'a posé.\n      const next = applyConnectors(applyAutoLayout(brut))\n      return { compositions: { ...(p.compositions || {}), [themeId]: next } }\n    })\n    setPileAnnuler((pile) => [...pile.slice(-(HISTORIQUE_MAX - 1)), avant])\n    setPileRetablir([])   // toute action neuve efface le « futur » qu'annuler aurait pu rouvrir\n    setActionCount((n) => n + 1)\n  }, [patchProject, themeId, currentId, project])\n\n  const annuler = React.useCallback(() => {\n    if (!pileAnnuler.length) return\n    const precedent = pileAnnuler[pileAnnuler.length - 1]\n    const actuel = normalizeComposition(project?.compositions?.[themeId], themeId)\n    setPileAnnuler((pile) => pile.slice(0, -1))\n    setPileRetablir((pile) => [...pile, actuel])\n    patchProject((p) => ({ compositions: { ...(p.compositions || {}), [themeId]: precedent } }))\n  }, [pileAnnuler, patchProject, themeId, currentId, project])\n\n  const retablir = React.useCallback(() => {\n    if (!pileRetablir.length) return\n    const suivant = pileRetablir[pileRetablir.length - 1]\n    const actuel = normalizeComposition(project?.compositions?.[themeId], themeId)\n    setPileRetablir((pile) => pile.slice(0, -1))\n    setPileAnnuler((pile) => [...pile, actuel])\n    patchProject((p) => ({ compositions: { ...(p.compositions || {}), [themeId]: suivant } }))\n  }, [pileRetablir, patchProject, themeId, currentId, project])\n\n  // ═══ FAMILLE FIGMA 3 · LES CONTRAINTES S'APPLIQUENT AU CHANGEMENT DE FORMAT ═══════════════════\n  //\n  // Le canevas change de taille à chaque format choisi — carré, 9:16, A4 — et c'est le SEUL\n  // moment où « la frame est redimensionnée » a un sens dans ce produit. `canevasPrecedentRef`\n  // porte les dimensions d'AVANT le changement, pour que `applyConstraintsToAll` sache de combien\n  // le cadre a bougé. Elle se réinitialise sur un changement de document ou de thème, pour la même\n  // raison que l'historique juste au-dessus : un format qui change de sens sur un autre document\n  // ne doit jamais faire bouger les calques de celui qu'on regarde maintenant.\n  const canevasPrecedentRef = React.useRef({ w: format.canvas.w, h: format.canvas.h })\n  React.useEffect(() => { canevasPrecedentRef.current = { w: format.canvas.w, h: format.canvas.h } }, [currentId, themeId])\n  React.useEffect(() => {\n    const avant = canevasPrecedentRef.current\n    const apres = { w: format.canvas.w, h: format.canvas.h }\n    if (avant.w === apres.w && avant.h === apres.h) return\n    patchComposition((c) => applyConstraintsToAll(c, avant, apres))\n    canevasPrecedentRef.current = apres\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [format.canvas.w, format.canvas.h])\n\n  const buildCutNow = React.useCallback(() => {\n    if (!project) return\n    const next = buildCut(project.brief, project.notes, theme)\n"},{"type":"input_text","text":"---3---\nsrc/App.jsx-75-const LazyDriveDashboard = lazyRetry(() => import('./components/DriveDashboard.jsx'))\nsrc/App.jsx-76-const LazyIndexView = lazyRetry(() => import('./components/IndexView.jsx')) // vue Index du stockage (2026-07-05)\nsrc/App.jsx-77-const LazyShelf = lazyRetry(() => import('./components/Shelf.jsx'))\nsrc/App.jsx-78-const LazyDownloadsView = lazyRetry(() => import('./components/DownloadsView.jsx')) // A3 : vue Downloads (UX Drive)\nsrc/App.jsx-79-// Ref (lot B) : nouvel onglet + renderers explicites des nœuds canvas/embed (P0 : jamais l'éditeur Markdown).\nsrc/App.jsx-80-const LazyRefApp = lazyRetry(() => import('./ref/RefApp.jsx'))\nsrc/App.jsx-81-// ZenRayMedia (2026-07-25) : studio média. lazyRetry OBLIGATOIRE (règle projet : tout React.lazy\nsrc/App.jsx-82-// passe par ce helper unique, sinon un onglet ouvert avant un redeploy casse sur un chunk 404).\nsrc/App.jsx:83:const LazyMediaApp = lazyRetry(() => import('./zenraymedia/MediaApp.jsx'))\nsrc/App.jsx-84-const LazyPlanBoard = lazyRetry(() => import('./create/PlanBoard.jsx'))\nsrc/App.jsx-85-// ZenRay Ref (2026-07-19) : un board .ref.json se crée directement depuis \"+ New\", n'importe où dans\nsrc/App.jsx-86-// Create (retour Matthieu : plus d'onglet Ref séparé). makeCanvas est un module pur minuscule (pas de\nsrc/App.jsx-87-// tldraw dedans) -> import direct, pas de lazyRetry nécessaire.\nsrc/App.jsx-88-import { makeCanvas } from './ref/schema.js'\nsrc/App.jsx-89-// Viewers de nœuds (image/média/archive/canvas/embed/table) : dispatch centralisé dans UnifiedViewer (E7).\nsrc/App.jsx-90-import { ImgNodeThumb, prefetchFullImages, clearManifestCache, invalidateManifest, shardThumbUrl, readImgManifestCached, resolveThumbUrl, downloadMedia } from './components/ImageNodeViewer.jsx'\nsrc/App.jsx-91-import { clearPageReadCache } from './lib/manifestReadCache.js'\n--\nsrc/App.jsx-1681-  } })\nsrc/App.jsx-1682-  // Document ZenRayMedia (2026-07-25) : créé dans le dossier courant, comme un board Ref. On écrit\nsrc/App.jsx-1683-  // une source MINIMALE valide (aucun rendu stocké : il se recompile) puis on bascule sur la vue\nsrc/App.jsx-1684-  // Media, qui devient propriétaire de l'édition.\nsrc/App.jsx-1685-  const newMediaDoc = (folderPath) => setNamePrompt({ icon: 'doc.richtext', label: 'Nouveau document Media', placeholder: 'Titre du document', value: '', cta: 'Créer', onOk: (title) => {\nsrc/App.jsx-1686-    const slug = slugify(title) || 'media'\nsrc/App.jsx-1687-    const path = `${folderPath}/${slug}-${Date.now().toString(36).slice(-4)}.zmedia.json`\nsrc/App.jsx-1688-    const seed = {\nsrc/App.jsx:1689:      type: 'zenraymedia', v: 1, tit