ngth >= 2) {\n          const nom = `Groupe ${readGroups(composition).length + 1}`\n          patchComposition((c) => groupLayers(c, selection, nom)); setSelection([])\n        }\n        return\n      }\n      // ⌘Z ANNULE, ⌘⇧Z RÉTABLIT (famille Photoshop 8). Testé AVANT le cas ⌘⇧I ci-dessous puisque\n      // les deux partagent le modificateur Maj : l'ordre des `if` décide, comme pour ⌘G plus haut.\n      if ((e.metaKey || e.ctrlKey) && e.code === 'KeyZ' && !e.shiftKey) { e.preventDefault(); annuler(); return }\n      if ((e.metaKey || e.ctrlKey) && e.shiftKey && e.code === 'KeyZ') { e.preventDefault(); retablir(); return }\n      // ⌘C / ⌘X / ⌘V (famille Photoshop 8). Refusés quand rien n'est sélectionné : copier le\n      // vide collerait le vide, un geste sans effet qui ne mérite pas de vider le presse-papiers.\n      if ((e.metaKey || e.ctrlKey) && e.code === 'KeyC') { e.preventDefault(); copierSelection(); return }\n      if ((e.metaKey || e.ctrlKey) && e.code === 'KeyX') { e.preventDefault(); couperSelection(); return }\n      if ((e.metaKey || e.ctrlKey) && e.code === 'KeyV') { e.preventDefault(); collerSelection(); return }\n      if ((e.metaKey || e.ctrlKey) && e.shiftKey && e.code === 'KeyI') {\n        e.preventDefault()\n        const inverse = ordreHierarchie.filter((id) => !selection.includes(id))\n        setSelection(inverse); setSelectedComponent(inverse[inverse.length - 1] || null)\n        return\n      }\n      if (e.metaKey || e.ctrlKey || e.altKey) return\n      if (e.code === 'Space') { e.preventDefault(); espaceRef.current = true }\n      // « F » recadre le plan de travail, comme dans Photoshop et dans tous les logiciels 3D.\n      else if (e.code === 'KeyF' && e.shiftKey) { e.preventDefault(); cadrerLaSelection() }\n      else if (e.code === 'KeyF') { e.preventDefault(); setZoom(1); setPan({ x: 0, y: 0 }) }\n      // Échap désélectionne, ce qui est le seul moyen de revenir à « rien de choisi ».\n      else if (e.code === 'Escape') { if (menuContextuel) setMenuContextuel(null); else { setSelection([]); setSelectedComponent(null); setSelectedNode(null) } }\n      else if (e.code === 'ArrowDown') { e.preventDefault(); naviguerHierarchie(1) }\n      else if (e.code === 'ArrowUp') { e.preventDefault(); naviguerHierarchie(-1) }\n      // FAMILLE POWERPOINT 7 · navigation au clavier entre diapositives, le seul geste de la\n      // doc « présentation » qui survit à la traduction — pointeur laser, minuteur,\n      // enregistrement caméra et vue Présentateur deux écrans n'ont pas d'équivalent réel dans\n      // un compositeur d'affiches (portée écarte et écrite dans KANBAN.md).\n      else if (e.code === 'PageDown' || e.code === 'PageUp') {\n        const diapositives = readSlides(composition)\n        if (diapositives.length) {\n          e.preventDefault()\n          const i = diapositives.findIndex((s) => s.id === composition.activeSlideId)\n          const cible = e.code === 'PageDown' ? diapositives[i + 1] : diapositives[i - 1]\n          if (cible) patchComposition((c) => setActiveSlide(c, cible.id))\n        }\n      }\n    }\n    const haut = (e) => { if (e.code === 'Space') espaceRef.current = false }\n    window.addEventListener('keydown', bas)\n    window.addEventListener('keyup', haut)\n    return () => { window.removeEventListener('keydown', bas); window.removeEventListener('keyup', haut) }\n    // `menuContextuel` et `cadrerLaSelection` DOIVENT être dans ce tableau : un effet à dépendances\n    // vides capture sa fermeture au premier rendu, où `menuContextuel` valait `null` et\n    // `calqueSelectionne` (dont dépend `cadrerLaSelection`) valait aussi `null`. Sans eux, Échap\n    // n'aurait jamais fermé le menu contextuel et Maj+F n'aurait jamais cadré aucune sélection —\n    // un bogue de fermeture périmée découvert en écrivant le test de la carte S4, pas en le devinant.\n  }, [menuContextuel, cadrerLaSelection, naviguerHierarchie, ordreHierarchie, selection, composition, patchComposition