{"timestamp":"2026-08-05T19:10:37.011Z","ordinal":3545,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd355-b3d2-7021-b120-4280253ed4b4","call_id":"call_GDXZJh46OqEeqvkPfCGccD6U","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"--- 1 ---\ncommit 5ceae3a6190692910f021ad98f07d90d13807d78\nAuthor: Matthieu Huguet <matth.huguet@gmail.com>\nDate:   Thu Aug 6 04:08:55 2026 +0900\n\n    ZenRayMedia — Illustrator I2 : outil Plume, tracé vectoriel complet\n    \n    Un tracé se dessine par points (clic = angle, glisser = lisse), se ferme\n    près du premier point ou finit ouvert à Entrée, expose ses ancres et\n    poignées dès qu'il est sélectionné (glisser pour déplacer, Suppr pour\n    retirer un point, double-clic pour convertir angle/lisse ou insérer un\n    point sur la courbe), et règle couleur/épaisseur/fermeture du contour\n    dans le panneau Détails. Corrige au passage un bogue réel de geste\n    (le point sans glisser lisait la distance au point précédent plutôt\n    qu'à son propre départ) et un test préexistant qui ne passait que par\n    course avec le debounce d'aperçu.\n    \n    769 tests verts sur 58 fichiers, build vert.\n\ndiff --git a/src/zenraymedia/layers.test.js b/src/zenraymedia/layers.test.js\nindex a46dd4b..d1a7691 100644\n--- a/src/zenraymedia/layers.test.js\n+++ b/src/zenraymedia/layers.test.js\n@@ -1513,3 +1513,227 @@ describe('Miro M6 — connecteurs', () => {\n     expect(el.hasAttribute('data-shape')).toBe(false)\n   })\n })\n+\n+// ═══════════════════════════════════════════════════════════════════════════════════════════════\n+// Carte I2 (Illustrator) — famille « Création et modification de tracés vectoriels » (l'outil Plume).\n+// ═══════════════════════════════════════════════════════════════════════════════════════════════\n+import { pathD, createPathLayer, movePathAnchor, movePathHandle, removePathPoint, insertPathPoint } from './layers.js'\n+\n+describe('Illustrator I2 — tracé vectoriel (Plume)', () => {\n+  it('un calque neuf n’a aucun point : ce n’est pas un tracé', () => {\n+    const l = readLayers(addLayer(vide(), 'shape'))[0]\n+    expect(l.pathPoints).toEqual([])\n+    expect(l.pathClosed).toBe(false)\n+  })\n+\n+  it('pathD relie deux points d’ANGLE par une courbe plate (poignées confondues avec l’ancre)', () => {\n+    const points = [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n+      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },\n+    ]\n+    expect(pathD(points, false)).toBe('M 0 0 C 0 0 100 0 100 0')\n+  })\n+\n+  it('pathD ferme le tracé (Z) et relie le dernier point au premier quand closed=true', () => {\n+    const points = [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n+      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },\n+      { x: 50, y: 100, inX: 50, inY: 100, outX: 50, outY: 100 },\n+    ]\n+    expect(pathD(points, true)).toBe('M 0 0 C 0 0 100 0 100 0 C 100 0 50 100 50 100 C 50 100 0 0 0 0 Z')\n+  })\n+\n+  it('pathD ne ferme jamais un tracé de seulement deux points (rien « entre » à boucler)', () => {\n+    const points = [{ x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 }, { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 }]\n+    expect(pathD(points, true)).not.toContain('Z')\n+  })\n+\n+  it('pathD rend une chaîne vide sous deux points : rien à tracer', () => {\n+    expect(pathD([{ x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 }], false)).toBe('')\n+    expect(pathD([], false)).toBe('')\n+  })\n+\n+  it('createPathLayer calcule la boîte englobante EN INCLUANT les poignées, jamais seulement les ancres', () => {\n+    // Ancres à (0,0) et (100,0), mais une poignée déborde jusqu'à y=-50 : la boîte doit la contenir.\n+    const points = [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 20, outY: -50 },\n+      { x: 100, y: 0, inX: 80, inY: -50, outX: 100, outY: 0 },\n+    ]\n+    let c = createPathLayer(vide(), points, false)\n+    const l = readLayers(c).find((x) => x.name === 'Tracé')\n+    expect(l.y).toBe(-50)\n+    expect(l.h).toBe(50)\n+  })\n+\n+  it('createPathLayer normalise les points en POURCENTAGE 0-100 de la boîte calculée', () => {\n+    const points = [{ x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 }, { x: 200, y: 100, inX: 200, inY: 100, outX: 200, outY: 100 }]\n+    let c = createPathLayer(vide(), points, false)\n+    const l = readLayers(c).find((x) => x.name === 'Tracé')\n+    expect(l.pathPoints[0]).toEqual({ x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 })\n+    expect(l.pathPoints[1]).toEqual({ x: 100, y: 100, inX: 100, inY: 100, outX: 100, outY: 100 })\n+  })\n+\n+  it('createPathLayer refuse un tracé de moins de deux points', () => {\n+    const c = vide()\n+    expect(createPathLayer(c, [{ x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 }], false)).toBe(c)\n+    expect(createPathLayer(c, [], false)).toBe(c)\n+  })\n+\n+  it('movePathAnchor déplace l’ancre ET ses deux poignées PAR LA MÊME TRANSLATION', () => {\n+    const points = [{ x: 10, y: 10, inX: 0, inY: 0, outX: 20, outY: 20 }]\n+    const suivant = movePathAnchor(points, 0, 15, 25)\n+    // Delta : +5 en x, +15 en y. Les poignées suivent exactement ce même déplacement.\n+    expect(suivant[0]).toEqual({ x: 15, y: 25, inX: 5, inY: 15, outX: 25, outY: 35 })\n+  })\n+\n+  it('movePathHandle déplace UNE SEULE poignée, sans toucher à l’autre ni à l’ancre', () => {\n+    const points = [{ x: 10, y: 10, inX: 0, inY: 0, outX: 20, outY: 20 }]\n+    const suivant = movePathHandle(points, 0, 'out', 50, 60)\n+    expect(suivant[0]).toEqual({ x: 10, y: 10, inX: 0, inY: 0, outX: 50, outY: 60 })\n+  })\n+\n+  it('removePathPoint retire un point, mais jamais sous deux points restants', () => {\n+    const points = [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n+      { x: 50, y: 50, inX: 50, inY: 50, outX: 50, outY: 50 },\n+      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },\n+    ]\n+    const deuxPoints = removePathPoint(points, 1)\n+    expect(deuxPoints).toHaveLength(2)\n+    const plancher = removePathPoint(deuxPoints, 0)\n+    expect(plancher).toBe(deuxPoints)   // refuse de descendre sous deux points\n+  })\n+\n+  it('insertPathPoint ajoute un point d’ANGLE (poignées confondues) juste après l’index donné', () => {\n+    const points = [{ x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 }, { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 }]\n+    const suivant = insertPathPoint(points, 0, 50, 30)\n+    expect(suivant).toHaveLength(3)\n+    expect(suivant[1]).toEqual({ x: 50, y: 30, inX: 50, inY: 30, outX: 50, outY: 30 })\n+  })\n+\n+  it('un point hors 0-100 est ramené dans les bornes à la relecture, jamais laissé libre', () => {\n+    let c = addLayer(vide(), 'shape', { pathPoints: [{ x: -10, y: 150, inX: 0, inY: 0, outX: 0, outY: 0 }, { x: 50, y: 50, inX: 50, inY: 50, outX: 50, outY: 50 }] })\n+    const l = readLayers(c)[0]\n+    expect(l.pathPoints[0].x).toBe(0)\n+    expect(l.pathPoints[0].y).toBe(100)\n+  })\n+\n+  it('le tracé compile en <svg><path> réel, avec le fond et le contour du calque', () => {\n+    let c = createPathLayer(vide(), [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n+      { x: 100, y: 100, inX: 100, inY: 100, outX: 100, outY: 100 },\n+    ], false)\n+    const tracé = readLayers(c).find((l) => l.name === 'Tracé')\n+    c = patchLayer(c, tracé.id, { style: { backgroundColor: '#ffcc00' } })\n+    const { html } = compiler(c)\n+    expect(html).toContain('<svg')\n+    expect(html).toContain('fill=\"#ffcc00\"')\n+    expect(html).toContain('stroke=\"#151515\"')\n+  })\n+\n+  it('un tracé SANS fond réglé ne peint aucune surface (fill=\"none\"), seulement son contour', () => {\n+    let c = createPathLayer(vide(), [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n+      { x: 100, y: 100, inX: 100, inY: 100, outX: 100, outY: 100 },\n+    ], false)\n+    const { html } = compiler(c)\n+    expect(html).toContain('fill=\"none\"')\n+  })\n+\n+  it('un tracé ne porte JAMAIS l’attribut data-shape : sa géométrie n’est pas une forme paramétrique', () => {\n+    let c = createPathLayer(vide(), [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n+      { x: 100, y: 100, inX: 100, inY: 100, outX: 100, outY: 100 },\n+    ], false)\n+    const tracé = readLayers(c).find((l) => l.name === 'Tracé')\n+    const { html } = compiler(c)\n+    const doc = new DOMParser().parseFromString(html, 'text/html')\n+    const el = doc.querySelector(`[data-zrm-layer=\"${tracé.id}\"]`)\n+    expect(el.hasAttribute('data-shape')).toBe(false)\n+  })\n+})\n+\n+// Carte I2 (suite) — édition d'un tracé DÉJÀ posé : convertir un point, ajouter un point sur un\n+// segment existant. La Sélection directe d'Illustrator, plutôt qu'un second outil séparé — ici un\n+// seul et même calque de tracé, sélectionné, expose ses points à l'édition.\n+import { toggleAnchorSmoothness, nearestPointOnTrace, pathPointsInPixels } from './layers.js'\n+\n+describe('Illustrator I2 — convertir et insérer un point sur un tracé existant', () => {\n+  it('pathPointsInPixels convertit chaque coordonnée de pourcentage (0-100) en pixels réels du calque', () => {\n+    const layer = { w: 200, h: 50, pathPoints: [{ x: 0, y: 0, inX: 0, inY: 0, outX: 50, outY: 100 }] }\n+    expect(pathPointsInPixels(layer)).toEqual([{ x: 0, y: 0, inX: 0, inY: 0, outX: 100, outY: 50 }])\n+  })\n+\n+  it('convertit un point d’ANGLE en point LISSE : les poignées sortent le long de la tangente aux voisins', () => {\n+    const points = [\n+      { x: 0, y: 50, inX: 0, inY: 50, outX: 0, outY: 50 },\n+      { x: 50, y: 50, inX: 50, inY: 50, outX: 50, outY: 50 },   // point d'angle, au milieu\n+      { x: 100, y: 50, inX: 100, inY: 50, outX: 100, outY: 50 },\n+    ]\n+    const suivant = toggleAnchorSmoothness(points, 1, false)\n+    // Voisins alignés sur l'axe x : la tangente est horizontale, les poignées s'écartent en x, pas en y.\n+    expect(suivant[1].outX).toBeGreaterThan(50)\n+    expect(suivant[1].inX).toBeLessThan(50)\n+    expect(suivant[1].outY).toBe(50)\n+    expect(suivant[1].inY).toBe(50)\n+  })\n+\n+  it('convertit un point LISSE en point d’ANGLE : les deux poignées reviennent exactement sur l’ancre', () => {\n+    const points = [{ x: 50, y: 50, inX: 30, inY: 40, outX: 70, outY: 60 }]\n+    const suivant = toggleAnchorSmoothness(points, 0, false)\n+    expect(suivant[0]).toEqual({ x: 50, y: 50, inX: 50, inY: 50, outX: 50, outY: 50 })\n+  })\n+\n+  it('convertir le SEUL point d’un bout de tracé ouvert utilise son unique voisin, sans jamais planter', () => {\n+    const points = [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n+      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },\n+    ]\n+    const suivant = toggleAnchorSmoothness(points, 0, false)\n+    expect(suivant[0].outX).toBeGreaterThan(0)   // tiré vers l'unique voisin, à droite\n+  })\n+\n+  it('nearestPointOnTrace trouve un point EXACTEMENT sur la courbe, près d’un clic à côté d’elle', () => {\n+    const points = [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n+      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },\n+    ]\n+    // Segment plat sur y=0 : cliquer à (50, 6) doit accrocher un échantillon proche de (50, 0).\n+    const trouve = nearestPointOnTrace(points, false, 50, 6)\n+    expect(trouve.afterIndex).toBe(0)\n+    expect(trouve.x).toBeCloseTo(50, 0)\n+    expect(trouve.y).toBeCloseTo(0, 0)\n+  })\n+\n+  it('nearestPointOnTrace identifie le bon SEGMENT parmi plusieurs, jamais le premier par défaut', () => {\n+    const points = [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n+      { x: 50, y: 0, inX: 50, inY: 0, outX: 50, outY: 0 },\n+      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },\n+    ]\n+    const trouve = nearestPointOnTrace(points, false, 80, 0)\n+    expect(trouve.afterIndex).toBe(1)   // le second segment, entre les points 1 et 2\n+  })\n+\n+  it('insérer via nearestPointOnTrace place le nouveau point SUR la courbe, réellement au milieu', () => {\n+    const points = [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n+      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },\n+    ]\n+    const trouve = nearestPointOnTrace(points, false, 50, 0)\n+    const suivant = insertPathPoint(points, trouve.afterIndex, trouve.x, trouve.y)\n+    expect(suivant).toHaveLength(3)\n+    expect(suivant[1].x).toBeCloseTo(50, 0)\n+  })\n+\n+  it('nearestPointOnTrace couvre aussi le segment de FERMETURE d’un tracé fermé', () => {\n+    const points = [\n+      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },\n+      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },\n+      { x: 50, y: 100, inX: 50, inY: 100, outX: 50, outY: 100 },\n+    ]\n+    // (25, 50) est sur le segment de retour du dernier point (50,100) vers le premier (0,0).\n+    const trouve = nearestPointOnTrace(points, true, 25, 50)\n+    expect(trouve.afterIndex).toBe(2)\n+  })\n+})\n"},{"type":"input_text","text":"--- 2 ---\ncommit 5ceae3a6190692910f021ad98f07d90d13807d78\nAuthor: Matthieu Huguet <matth.huguet@gmail.com>\nDate:   Thu Aug 6 04:08:55 2026 +0900\n\n    ZenRayMedia — Illustrator I2 : outil Plume, tracé vectoriel complet\n    \n    Un tracé se dessine par points (clic = angle, glisser = lisse), se ferme\n    près du premier point ou finit ouvert à Entrée, expose ses ancres et\n    poignées dès qu'il est sélectionné (glisser pour déplacer, Suppr pour\n    retirer un point, double-clic pour convertir angle/lisse ou insérer un\n    point sur la courbe), et règle couleur/épaisseur/fermeture du contour\n    dans le panneau Détails. Corrige au passage un bogue réel de geste\n    (le point sans glisser lisait la distance au point précédent plutôt\n    qu'à son propre départ) et un test préexistant qui ne passait que par\n    course avec le debounce d'aperçu.\n    \n    769 tests verts sur 58 fichiers, build vert.\n\ndiff --git a/src/zenraymedia/MediaApp.test.jsx b/src/zenraymedia/MediaApp.test.jsx\nindex c20eac2..a8ab7cc 100644\n--- a/src/zenraymedia/MediaApp.test.jsx\n+++ b/src/zenraymedia/MediaApp.test.jsx\n@@ -579,8 +579,14 @@ describe('Famille Photoshop 5 — groupes', () => {\n \n     // Masquer le DOSSIER masque les deux calques dans la page compilée, sans qu'aucun des deux ne\n     // porte lui-même `hidden`.\n+    // BOGUE DE TEST RÉEL CORRIGÉ ICI (trouvé en carte Illustrator I2, une session de plus tard) :\n+    // `data-shape` est aussi le nom d'un SÉLECTEUR CSS STATIQUE, toujours présent dans la feuille de\n+    // style compilée dès qu'un seul calque existe dans la composition, masqué ou non — cette\n+    // assertion ne passait donc que par COURSE (elle attrapait un aperçu encore périmé, pas encore\n+    // rattrapé par le debounce de 220 ms, avant même la pose des deux calques). Le vrai test de\n+    // « masqué » est l'ABSENCE de tout calque rendu, `data-zrm-layer`, jamais une sous-chaîne de CSS.\n     fireEvent.click(screen.getByTitle('Masquer le groupe'))\n-    await waitFor(() => expect(screen.getByTitle('Aperçu ZenRayMedia').srcdoc).not.toContain('data-shape'))\n+    await waitFor(() => expect(screen.getByTitle('Aperçu ZenRayMedia').srcdoc).not.toContain('data-zrm-layer'))\n   })\n \n   it('grouper un seul calque ne fait rien : il faut au moins deux membres', async () => {\n@@ -1298,3 +1304,130 @@ describe('Miro M6 — connecteurs', () => {\n     })\n   })\n })\n+\n+// ═══════════════════════════════════════════════════════════════════════════════════════════════\n+// Famille Illustrator I2 — l'outil Plume : dessiner un tracé, éditer ses points, régler son contour.\n+// jsdom ne simule pas fidèlement `getBoundingClientRect`/l'échelle de l'aperçu (limite déjà connue,\n+// voir S3) : ces tests vérifient donc la STRUCTURE produite (nombre de points, présence d'un `Z` de\n+// fermeture, le `d` qui change) plutôt que des coordonnées exactes, déjà prouvées par les fonctions\n+// pures de `layers.test.js`.\n+describe('Illustrator I2 — outil Plume', () => {\n+  function outilPlume() { return screen.getByRole('button', { name: /Plume/ }) }\n+  function canevas() { return document.querySelector('.zrm-stage-body') }\n+  function traceCompile() {\n+    const srcdoc = screen.getByTitle('Aperçu ZenRayMedia').srcdoc\n+    const d = srcdoc.match(/<svg class=\"zrm-layer-path\"[^>]*><path d=\"([^\"]*)\"/)\n+    return { srcdoc, d: d ? d[1] : null }\n+  }\n+  function clic(x, y) {\n+    fireEvent.pointerDown(canevas(), { button: 0, clientX: x, clientY: y })\n+    fireEvent.pointerUp(canevas())\n+  }\n+\n+  it('le bouton Plume est un BASCULE : il s’active et se désactive au clic, jamais une pose immédiate', async () => {\n+    await mount()\n+    expect(outilPlume().getAttribute('data-on')).toBe('false')\n+    fireEvent.click(outilPlume())\n+    expect(outilPlume().getAttribute('data-on')).toBe('true')\n+    fireEvent.click(outilPlume())\n+    expect(outilPlume().getAttribute('data-on')).toBe('false')\n+  })\n+\n+  it('trois clics puis Entrée posent réellement un tracé OUVERT à trois points dans la page compilée', async () => {\n+    await mount()\n+    fireEvent.click(outilPlume())\n+    clic(100, 100); clic(250, 140); clic(180, 260)\n+    fireEvent.keyDown(document.body, { code: 'Enter' })\n+    await waitFor(() => expect(traceCompile().d).toBeTruthy())\n+    const { d } = traceCompile()\n+    expect((d.match(/ C /g) || [])).toHaveLength(2)   // deux segments entre trois points accumulés\n+    expect(d.trim().endsWith('Z')).toBe(false)         // jamais fermé sans le geste de fermeture\n+  })\n+\n+  // Fermer un tracé en cliquant PRÈS DU PREMIER POINT n'est pas vérifié ici : jsdom n'implémente\n+  // aucun constructeur `PointerEvent` (vérifié empiriquement), donc `event.clientX` d'un\n+  // pointerDown/pointerUp simulé arrive toujours `undefined` — la comparaison de distance entre\n+  // deux clics n'a alors plus aucun sens à tester. Ce que cette fermeture produit RÉELLEMENT\n+  // (le `Z` de `pathD` sur un tracé fermé de plus de deux points, jamais sur deux) est déjà prouvé\n+  // par les fonctions pures de `layers.test.js` ; ce qu'expose l'interface en est vérifié plus bas\n+  // par un geste qui, lui, ne dépend d'aucune coordonnée : le bouton « Tracé fermé » du panneau\n+  // Détails.\n+\n+  it('Échap annule le point en cours SANS quitter l’outil ; un second Échap, lui, quitte l’outil', async () => {\n+    await mount()\n+    fireEvent.click(outilPlume())\n+    clic(100, 100)\n+    fireEvent.keyDown(document.body, { code: 'Escape' })\n+    expect(outilPlume().getAttribute('data-on')).toBe('true')   // trace annulée, outil toujours actif\n+    fireEvent.keyDown(document.body, { code: 'Escape' })\n+    expect(outilPlume().getAttribute('data-on')).toBe('false')  // trace déjà vide : ce second Échap quitte\n+  })\n+\n+\n+  it('le tracé qu’on vient de poser devient la sélection : ses points d’ancrage sont immédiatement visibles', async () => {\n+    await mount()\n+    fireEvent.click(outilPlume())\n+    clic(100, 100); clic(250, 140); clic(180, 260)\n+    fireEvent.keyDown(document.body, { code: 'Enter' })\n+    await waitFor(() => expect(document.querySelectorAll('.zrm-path-anchor[data-point-index]')).toHaveLength(3))\n+  })\n+\n+  it('sélectionner un point puis Suppr retire CE point, jamais le calque entier', async () => {\n+    await mount()\n+    fireEvent.click(outilPlume())\n+    clic(100, 100); clic(250, 140); clic(180, 260)\n+    fireEvent.keyDown(document.body, { code: 'Enter' })\n+    await waitFor(() => expect(document.querySelectorAll('.zrm-path-anchor[data-point-index]')).toHaveLength(3))\n+    const ancre1 = document.querySelector('.zrm-path-anchor[data-point-index=\"1\"]')\n+    fireEvent.pointerDown(ancre1, { button: 0, clientX: 250, clientY: 140 })\n+    fireEvent.pointerUp(canevas())\n+    fireEvent.keyDown(document.body, { code: 'Backspace' })\n+    await waitFor(() => expect(document.querySelectorAll('.zrm-path-anchor[data-point-index]')).toHaveLength(2))\n+    // L'aperçu compilé est débouncé (220ms, carte L6) : lire `srcdoc` à l'instant même de la\n+    // frappe attraperait presque toujours la version PRÉCÉDENTE, pas encore rafraîchie.\n+    await waitFor(() => expect(traceCompile().srcdoc).toContain('zrm-layer-path'))   // le calque tracé existe toujours\n+  })\n+\n+  it('double-cliquer une ancre convertit angle ↔ lisse : la courbe compilée change réellement', async () => {\n+    await mount()\n+    fireEvent.click(outilPlume())\n+    clic(100, 100); clic(250, 140); clic(180, 260)\n+    fireEvent.keyDown(document.body, { code: 'Enter' })\n+    await waitFor(() => expect(document.querySelectorAll('.zrm-path-anchor[data-point-index]')).toHaveLength(3))\n+    const avant = traceCompile().d\n+    const ancre1 = document.querySelector('.zrm-path-anchor[data-point-index=\"1\"]')\n+    fireEvent.doubleClick(ancre1)\n+    await waitFor(() => expect(traceCompile().d).not.toBe(avant))\n+  })\n+\n+  it('double-cliquer LE TRACÉ (pas une ancre) insère un point de plus sur la courbe', async () => {\n+    await mount()\n+    fireEvent.click(outilPlume())\n+    clic(100, 100); clic(300, 100)\n+    fireEvent.keyDown(document.body, { code: 'Enter' })\n+    await waitFor(() => expect(traceCompile().d).toBeTruthy())\n+    expect((traceCompile().d.match(/ C /g) || [])).toHaveLength(1)\n+    const traitCliquable = document.querySelector('.zrm-path-hit')\n+    fireEvent.doubleClick(traitCliquable, { clientX: 200, clientY: 100 })\n+    await waitFor(() => expect((traceCompile().d.match(/ C /g) || [])).toHaveLength(2))\n+  })\n+\n+  it('le panneau Détails règle la couleur, l’épaisseur et l’ouverture du contour, et cela compile réellement', async () => {\n+    await mount()\n+    fireEvent.click(outilPlume())\n+    clic(100, 100); clic(250, 140); clic(180, 260)\n+    fireEvent.keyDown(document.body, { code: 'Enter' })\n+    await waitFor(() => expect(screen.getByLabelText('Couleur du contour du tracé')).toBeTruthy())\n+\n+    fireEvent.change(screen.getByLabelText('Couleur du contour du tracé'), { target: { value: '#ff00aa' } })\n+    await waitFor(() => expect(traceCompile().srcdoc).toContain('stroke=\"#ff00aa\"'))\n+\n+    fireEvent.change(screen.getByLabelText('Épaisseur du contour du tracé'), { target: { value: '6' } })\n+    await waitFor(() => expect(traceCompile().srcdoc).toContain('stroke-width=\"6\"'))\n+\n+    expect(screen.getByText('Ouvert')).toBeTruthy()\n+    fireEvent.click(screen.getByText('Ouvert'))\n+    await waitFor(() => expect(traceCompile().d.trim().endsWith('Z')).toBe(true))\n+    expect(screen.getByText('Fermé')).toBeTruthy()\n+  })\n+})\n"},{"type":"input_text","text":"--- 3 ---\ncommit 5ceae3a6190692910f021ad98f07d90d13807d78\nAuthor: Matthieu Huguet <matth.huguet@gmail.com>\nDate:   Thu Aug 6 04:08:55 2026 +0900\n\n    ZenRayMedia — Illustrator I2 : outil Plume, tracé vectoriel complet\n    \n    Un tracé se dessine par points (clic = angle, glisser = lisse), se ferme\n    près du premier point ou finit ouvert à Entrée, expose ses ancres et\n    poignées dès qu'il est sélectionné (glisser pour déplacer, Suppr pour\n    retirer un point, double-clic pour convertir angle/lisse ou insérer un\n    point sur la courbe), et règle couleur/épaisseur/fermeture du contour\n    dans le panneau Détails. Corrige au passage un bogue réel de geste\n    (le point sans glisser lisait la distance au point précédent plutôt\n    qu'à son propre départ) et un test préexistant qui ne passait que par\n    course avec le debounce d'aperçu.\n    \n    769 tests verts sur 58 fichiers, build vert.\n\ndiff --git a/src/zenraymedia/media.css b/src/zenraymedia/media.css\nindex 39d0828..b5f4386 100644\n--- a/src/zenraymedia/media.css\n+++ b/src/zenraymedia/media.css\n@@ -783,6 +783,24 @@\n .zrm-lay-h[data-at=\"sw\"] { left: -5px; bottom: -5px; cursor: nesw-resize }\n .zrm-lay-h[data-at=\"w\"]  { left: -5px; top: calc(50% - 5px); cursor: ew-resize }\n \n+/* ═══ FAMILLE ILLUSTRATOR I2 · LES POINTS D'UN TRACÉ SÉLECTIONNÉ ════════════════════════════════\n+   Ancres en carrés (même langage que les huit poignées ci-dessus), poignées de courbe en cercles\n+   creux (comme Illustrator distingue visuellement l'ancre qu'on pose de la courbe qu'on sculpte),\n+   reliées par un fil fin. `position:absolute` : chaque point vit dans le référentiel DE LA BOÎTE,\n+   donc suit sa rotation exactement comme les huit poignées de redimensionnement. */\n+.zrm-path-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }\n+.zrm-path-anchor {\n+  position: absolute; width: 8px; height: 8px; margin: -4px 0 0 -4px;\n+  background: #fff; border: 1.5px solid var(--zrm-accent); box-shadow: 0 1px 3px rgba(0,0,0,.5);\n+  cursor: pointer;\n+}\n+.zrm-path-anchor[data-on=\"true\"] { background: var(--zrm-accent); }\n+.zrm-path-handle {\n+  position: absolute; width: 7px; height: 7px; margin: -3.5px 0 0 -3.5px; border-radius: 50%;\n+  background: #fff; border: 1.5px solid var(--zrm-accent); cursor: pointer;\n+}\n+.zrm-path-handle-line { position: absolute; height: 1px; background: var(--zrm-accent); transform-origin: 0 0; pointer-events: none; }\n+\n /* ═══════════════════════════════════════════════════════════════════════════════════════════════\n    RONDE 1 · PLUS AUCUN BOUTON NE PREND LA PLACE D'UN AUTRE (2026-08-04, retour de Matthieu)\n \n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"255bb7e6-b68d-4c5c-b91b-c6a1965e3c1d"}}}
