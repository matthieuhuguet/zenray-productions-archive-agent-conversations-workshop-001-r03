{"timestamp":"2026-08-05T16:49:39.322Z","ordinal":735,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd2d4-a5fa-7a02-93f4-0c85e8bfd3ec","call_id":"call_LWDYm2eeUpgc5LN5EXyuVzvD","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"---1---\nsrc/zenraymedia/MediaApp.test.jsx\nsrc/zenraymedia/componentCatalog.test.js\nsrc/zenraymedia/composition.test.js\nsrc/zenraymedia/document.test.js\nsrc/zenraymedia/layers.test.js\nsrc/zenraymedia/layout.test.js\nsrc/zenraymedia/lego.test.js\nsrc/zenraymedia/nodes.test.js\nsrc/zenraymedia/themes.test.js\nsrc/zenraymedia/zenraymedia.test.js\n"},{"type":"input_text","text":"---2---\n// ZenRayMedia — catalogue de composants construit depuis les registres déjà présents.\n// Vite produit un chunk par registre/partie : ouvrir Media ne télécharge que le thème actif,\n// jamais les 162 composants d'un coup.\n\nimport tokens0111 from './themes/T-01-1-1--une-nationale-du-matin/tokens.css?raw'\nimport tokens0112 from './themes/T-01-1-2--une-de-rupture/tokens.css?raw'\nimport tokens0113 from './themes/T-01-1-3--quotidien-de-reference-sobre/tokens.css?raw'\nimport tokens0114 from './themes/T-01-1-4--quotidien-economique-saumon/tokens.css?raw'\nimport tokens0115 from './themes/T-01-1-5--tabloid-daccroche/tokens.css?raw'\nimport tokens0411 from './themes/T-04-1-1--revelation-cinematique/tokens.css?raw'\n\nconst registries = import.meta.glob('./themes/*/component-registry.json', { import: 'default' })\nconst parts = import.meta.glob('./themes/*/parts/*.html', { query: '?raw', import: 'default' })\nconst tokenSheets = {\n  'T-01-1-1': tokens0111,\n  'T-01-1-2': tokens0112,\n  'T-01-1-3': tokens0113,\n  'T-01-1-4': tokens0114,\n  'T-01-1-5': tokens0115,\n  'T-04-1-1': tokens0411,\n}\n\nfunction themeDirectory(themeId) {\n  const prefix = `./themes/${themeId}--`\n  const key = Object.keys(registries).find((path) => path.startsWith(prefix))\n  return key ? key.slice('./themes/'.length, key.indexOf('/component-registry.json')) : null\n}\n\nexport async function loadThemeComponents(themeId) {\n  const directory = themeDirectory(themeId)\n  if (!directory) return { themeId, directory: null, components: [], tokensCss: '', definitionsHtml: '' }\n\n  const registryKey = `./themes/${directory}/component-registry.json`\n  const registry = await registries[registryKey]()\n  const tokensCss = tokenSheets[themeId] || ''\n\n  const entries = Array.isArray(registry) ? registry : (registry.components || [])\n  const components = await Promise.all(entries.map(async (entry) => {\n    // Le registre pointe vers les pages de documentation autonomes `components/`. L'éditeur\n    // charge leurs homologues légers `parts/`, faits pour être assemblés dans une même page.\n    const key = `./themes/${directory}/parts/${String(entry.file).split('/').pop()}`\n    const html = parts[key] ? await parts[key]() : ''\n    return { ...entry, html }\n  }))\n  const definitionsHtml = components.find((entry) => entry.id === '00-icons')?.html || ''\n  return { themeId, directory, components, tokensCss, definitionsHtml }\n}\n\nexport function groupComponents(components) {\n  return (components || []).reduce((groups, component) => {\n    const key = component.group || 'Autres'\n    ;(groups[key] = groups[key] || []).push(component)\n    return groups\n  }, {})\n}\n// ZenRayMedia — L4 : le registre de thèmes.\n//\n// C'EST LA PIÈCE D'EXTENSIBILITÉ. Elle répond à la contrainte : « je vais t'ajouter des thèmes\n// au compte-goutte, à terme au moins 1024 HTML interchangeables ».\n//\n// Deux formes de thème, découvertes AUTOMATIQUEMENT par Vite, sans jamais toucher au code :\n//\n//   1. `T-FF-S-V.theme.js`            -> thème à tokens (les 7 groupes de 01-PLAN §10.2).\n//   2. `T-FF-S-V--mon-slug.html`      -> gabarit HTML brut (celui que tu produis à la main).\n//\n// Déposer un fichier dans ce dossier SUFFIT : il apparaît dans le Deck au prochain build.\n//\n// COÛT À L'ÉCHELLE (décision d'architecture, pas une optimisation) : les métadonnées d'un\n// thème HTML sont dérivées de son NOM DE FICHIER, jamais de son contenu. Lire 1024 fichiers\n// HTML pour construire la liste ferait entrer des mégaoctets dans le bundle. Ici, lister\n// 1024 thèmes coûte 1024 chaînes de caractères ; seul le thème RÉELLEMENT choisi est chargé.\n\nimport { parseThemeFileName, parseThemeId, FAMILIES } from '../taxonomy.js'\nimport { validate } from '../contracts.js'\nimport { defaultFontFor } from '../themeFonts.js'\n\n// Thèmes à tokens : peu nombreux, curatés, chargés d'emblée (quelques kilo-octets).\nconst JS_THEMES = import.meta.glob('./*.theme.js', { eager: true })\n// Gabarits HTML : potentiellement des centaines. Chargement PARESSEUX, un par un.\nconst HTML_THEMES = import.meta.glob('./*.html', { query: '?raw', import: 'default' })\n\nfunction entriesFromJs() {\n  const out = []\n  for (const [path, mod] of Object.entries(JS_THEMES)) {\n    const theme = mod?.default\n    if (!theme?.id) continue\n    const parsed = parseThemeId(theme.id)\n    if (!parsed) continue\n    out.push({\n      id: theme.id,\n      name: theme.name || parsed.id,\n      description: theme.description || '',\n      family: parsed.family,\n      familyLabel: parsed.familyLabel,\n      sub: parsed.sub,\n      variant: parsed.variant,\n      formats: Array.isArray(theme.formats) ? theme.formats : ['F-web-article'],\n      source: 'js',\n      path,\n    })\n  }\n  return out\n}\n\nfunction entriesFromHtml() {\n  const out = []\n  for (const path of Object.keys(HTML_THEMES)) {\n    const parsed = parseThemeFileName(path)\n    if (!parsed) {\n      // Nom de fichier hors contrat : on l'ignore SILENCIEUSEMENT côté produit, mais on le\n      // signale en console pour que l'auteur du gabarit comprenne pourquoi il n'apparaît pas.\n      if (typeof console !== 'undefined') console.warn(`[zenraymedia] gabarit ignoré (nom attendu : T-FF-S-V--slug.html) : ${path}`)\n      continue\n    }\n    out.push({\n      id: parsed.id,\n      name: parsed.name,\n      description: `Gabarit HTML — ${parsed.familyLabel}.`,\n      family: parsed.family,\n      familyLabel: parsed.familyLabel,\n      sub: parsed.sub,\n      variant: parsed.variant,\n      formats: ['F-web-article'],\n      source: 'html',\n      path,\n    })\n  }\n  return out\n}\n\n// Liste complète, triée par identifiant. Les thèmes à tokens gagnent en cas de doublon d'id :\n// un gabarit HTML ne doit pas pouvoir masquer un thème curaté.\nexport function listThemes() {\n  const js = entriesFromJs()\n  const taken = new Set(js.map((e) => e.id))\n  const html = entriesFromHtml().filter((e) => !taken.has(e.id))\n  return [...js, ...html].sort((a, b) => a.id.localeCompare(b.id))\n}\n\nexport function listFamilies() {\n  const present = new Set(listThemes().map((e) => e.family))\n  return Object.entries(FAMILIES)\n    .filter(([code]) => present.has(code))\n    .map(([code, label]) => ({ code, label, count: listThemes().filter((e) => e.family === code).length }))\n}\n\nexport function findEntry(id) { return listThemes().find((e) => e.id === id) || null }\n\n// En-tête déclaratif OPTIONNEL d'un gabarit HTML, en tête de fichier :\n//\n//   <!--zr-theme { \"description\": \"...\", \"formats\": [\"F-web-article\",\"F-print-a4\"],\n//                  \"beatCount\": { \"min\": 3, \"max\": 12 }, \"measure\": 64 } -->\n//\n// Sans lui, le gabarit reste parfaitement valide et prend les valeurs neutres ci-dessous :\n// c'est le chemin le plus court pour déposer un fichier. Avec lui, un gabarit reconstruit à\n// partir de captures d'écran déclare les formats qu'il sait VRAIMENT servir au lieu d'être\n// cantonné au web. L'en-tête est lu APRÈS chargement du fichier : il ne coûte donc rien au\n// listing du catalogue, qui ne lit que les noms de fichiers -- c'est ce qui tient à 1024.\nexport function readThemeHeader(html) {\n  const match = /<!--\\s*zr-theme\\s*([\\s\\S]*?)-->/i.exec(String(html || ''))\n  if (!match) return {}\n  try {\n    const parsed = JSON.parse(match[1].trim())\n    return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {}\n  } catch {\n    // Un en-tête malformé ne doit JAMAIS empêcher le gabarit de fonctionner : on le signale\n    // à l'auteur et on repart des valeurs neutres.\n    if (typeof console !== 'undefined') console.warn('[zenraymedia] en-tête <!--zr-theme …--> illisible (JSON invalide) : valeurs par défaut appliquées.')\n    return {}\n  }\n}\n\n// Groupes par défaut d'un gabarit HTML : il apporte sa mise en page, pas ses tokens.\n// Ces valeurs neutres existent pour que `validateTheme` passe et que le Critique ait des\n// seuils à vérifier, jamais pour imposer un style au gabarit.\nfunction htmlThemeShell(entry, html) {\n  return {\n    id: entry.id,\n    name: entry.name,\n    description: entry.description,\n    calibration: { ref: '', notes: '' },\n    formats: entry.formats,\n    beatCount: { min: 1, max: 24 },\n    surface: { background: '#ffffff', backgroundDark: '#0f1012', grain: 0, vignette: 0, texture: 'none', shadow: 'none' },\n    palette: { ink: 'rgba(20,22,26,.92)', inkDark: 'rgba(244,245,247,.92)', muted: 'rgba(20,22,26,.60)', mutedDark: 'rgba(244,245,247,.54)', rule: 'rgba(20,22,26,.12)', ruleDark: 'rgba(244,245,247,.14)', accent: '#1a1a1a', accentDark: '#f4f5f7', minContrast: 4.5 },\n    typography: { body: \"'AnthropicSans', system-ui, sans-serif\", display: \"'AnthropicSans', system-ui, sans-serif\", mono: \"'AnthropicMono', ui-monospace, monospace\", scale: { base: 17, ratio: 1.25, steps: { h1: 3, h2: 2, h3: 1, body: 0, small: -1 } }, lineHeight: { body: 1.55, display: 1.15 }, tracking: { display: '-0.02em', body: '0em', mono: '0.06em' }, measure: 66, weights: { body: 400, display: 500, emphasis: 500 }, case: { display: 'none', label: 'none' } },\n    grid: { columns: 1, gutter: 0, margin: { top: 72, bottom: 96, sides: 24 }, rhythm: 8, align: 'left', maxWidth: 760 },\n    motion: { enabled: false, ease: 'cubic-bezier(.16,1,.3,1)', enter: 0, stagger: 0, cut: 'none' },\n    chrome: { kicker: true, byline: true, readingTime: true, rules: false, dropCap: false, footer: true, numbering: false },\n    sound: { bed: null, bedLufs: null, cues: [], allowed: [] },\n    html,\n  }\n}\n\nconst cache = new Map()\n\n// Charge un thème et le VALIDE avant de le rendre. Un thème invalide ne doit jamais atteindre\n// le compilateur : il produirait une page cassée sans dire pourquoi.\nexport async function loadTheme(id) {\n  if (cache.has(id)) return cache.get(id)\n  const entry = findEntry(id)\n  if (!entry) throw new Error(`Thème introuvable : ${id}`)\n\n  let theme\n  if (entry.source === 'js') {\n    theme = JS_THEMES[entry.path]?.default\n  } else {\n    const loader = HTML_THEMES[entry.path]\n    if (!loader) throw new Error(`Gabarit introuvable : ${entry.path}`)\n    const raw = await loader()\n    const html = String(raw || '')\n    theme = htmlThemeShell(entry, html)\n    // L'en-tête n'a AUCUN droit sur l'identité : ni sur l'id (il vient du nom de fichier, seule\n    // source de vérité du catalogue), ni sur le nom public (règle anti-marque, 02-RISQUES R5).\n    // Il n'enrichit que ce que le gabarit sait de lui-même.\n    const header = readThemeHeader(html)\n    if (typeof header.description === 'string') theme.description = header.description\n    if (Array.isArray(header.formats) && header.formats.length) theme.formats = header.formats\n    if (header.beatCount && Number.isFinite(header.beatCount.min) && Number.isFinite(header.beatCount.max)) {\n      theme.beatCount = { min: header.beatCount.min, max: header.beatCount.max }\n    }\n    if (Number.isFinite(header.measure)) theme.typography = { ...theme.typography, measure: header.measure }\n    if (header.calibration && typeof header.calibration === 'object') theme.calibration = header.calibration\n    // Polices déclarées par le gabarit. Elles sont servies pour l'aperçu et embarquées à l'export ;\n    // celles qui ne sont pas installées retombent proprement sur leur pile système (fonts.js).\n    if (Array.isArray(header.fonts) && header.fonts.length) theme.fonts = header.fonts\n    // Sans déclaration, le gabarit hérite de la police de SA SOUS-FAMILLE (themeFonts.js).\n    // Un thème de presse quotidienne reçoit ainsi un serif de labeur et un thème de chaîne\n    // d'info un condensé, sans que l'auteur ait à y penser — et il garde le droit de choisir.\n    else { const fallback = defaultFontFor(entry.id); if (fallback) theme.fonts = [fallback] }\n    if (header.typography && typeof header.typography === 'object') theme.typography = { ...theme.typography, ...header.typography }\n  }\n\n  const errors = validate('theme', theme)\n  if (errors.length) throw new Error(`Thème ${id} invalide : ${errors.map((e) => e.message).join(' · ')}`)\n  cache.set(id, theme)\n  return theme\n}\n\n// Le quotidien de référence est le premier thème doté du contrat complet\n// thème → groupes → composants : l'atelier Lego ne doit jamais s'ouvrir vide.\nexport const DEFAULT_THEME_ID = 'T-01-1-3'\n# Déposer un thème ZenRayMedia\n\nDeux formes possibles. Dans les deux cas, **déposer le fichier dans ce dossier suffit** : il\napparaît dans le Deck au prochain build, sans toucher une ligne de code.\n\n---\n\n## Forme 1 — gabarit HTML (celle prévue pour tes 1024)\n\n**Nom du fichier obligatoire :** `T-FF-S-V--slug.html`\n\n- `FF` = famille sur 2 chiffres (`01` à `16`, voir `docs/zenraymedia/05-THEMES-1024-*.md`)\n- `S` = sous-famille (`1` à `8`)\n- `V` = variante (`1` à `8`)\n- `slug` = le nom public, en minuscules, tirets pour les espaces\n\nExemple : `T-02-1-1--bandeau-alerte-permanente.html` → apparaît sous « Télévision & broadcast »\navec le nom « Bandeau alerte permanente ».\n\n**Pourquoi le nom porte les métadonnées :** avec 1024 gabarits, lire chaque fichier pour\nconstruire la liste ferait entrer des mégaoctets dans le bundle. Ici, lister le catalogue coûte\n1024 chaînes de caractères ; seul le thème réellement choisi est chargé.\n\nUn fichier mal nommé est **ignoré**, avec un avertissement en console qui rappelle le format.\n\n### En-tête déclaratif (optionnel mais recommandé)\n\nEn tête de fichier, il permet au gabarit de déclarer ce qu'il sait servir :\n\n```html\n<!--zr-theme {\n  \"description\": \"Manchette 6 colonnes, filet fin, une seule photo dominante.\",\n  \"formats\": [\"F-web-article\", \"F-print-a4\", \"F-still-1080x1350\"],\n  \"beatCount\": { \"min\": 4, \"max\": 12 },\n  \"measure\": 64\n} -->\n```\n\nSans lui, le gabarit reste valide et prend les valeurs neutres (format web seul, 1 à 24 blocs).\nL'en-tête n'a **aucun droit** sur l'identité : l'`id` et le nom public viennent du nom de fichier,\nseule source de vérité du catalogue. Un en-tête au JSON invalide n'empêche jamais le gabarit de\nfonctionner : il est signalé en console et les valeurs par défaut s'appliquent.\n\n**Reconstruire un thème à partir de captures d'écran :** méthode complète dans\n`docs/zenraymedia/07-PROMPT-THEME-DEPUIS-CAPTURES.md` (mesure image par image, correspondance\nrôle → composant, QA par le Critique).\n\n### Ce que le gabarit reçoit\n\nQuatre constructions, pas une de plus (`htmlTemplate.js`) :\n\n| Écrire | Effet |\n|---|---|\n| `{{champ}}` | valeur, échappée |\n| `{{{champ}}}` | valeur brute (HTML) |\n| `{{#beats}} … {{/beats}}` | répète le bloc sur chaque beat |\n| `{{^beats}} … {{/beats}}` | affiché seulement si la liste est vide |\n\n**Champs de la page :** `title`, `message`, `audience`, `register`, `intent`, `themeName`,\n`formatLabel`, `readingMinutes`, `words`, `duration`, `dark`, `scale`.\n\n**Champs disponibles dans un bloc `beats` :** `number`, `index`, `role`, `roleLabel`, `text`,\n`html`, `weight`, `tempo`, `duration`, `isFirst`, `isLast`.\n\n### Squelette minimal\n\n```html\n<!doctype html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>{{title}}</title>\n  <style>\n    /* Tout le style vit ici. Aucune ressource externe : la page doit rester autonome. */\n    body { margin: 0; font-family: 'AnthropicSans', system-ui, sans-serif; }\n    .beat { max-width: 62ch; margin: 0 auto 2rem; }\n  </style>\n</head>\n<body>\n  <h1>{{title}}</h1>\n  <p>{{message}}</p>\n  {{#beats}}\n    <section class=\"beat\" data-role=\"{{role}}\">\n      <span>{{number}} · {{roleLabel}}</span>\n      <p>{{text}}</p>\n    </section>\n  {{/beats}}\n  {{^beats}}<p>Aucun beat.</p>{{/beats}}\n</body>\n</html>\n```\n\n### Deux règles à respecter\n\n1. **Aucune ressource externe** (police, image, feuille de style distante). La page compilée doit\n   s'ouvrir hors ligne à l'identique. Les polices du projet sont disponibles par leur nom :\n   `AnthropicSerif`, `AnthropicSans`, `AnthropicMono`.\n2. **Consommer `{{title}}` et `{{#beats}}`.** Un gabarit qui ne les utilise pas est muet : le\n   contenu du brief n'apparaît nulle part.\n\n---\n\n## Forme 2 — thème à tokens (`T-FF-S-V.theme.js`)\n\nPour un thème piloté par des décisions plutôt que par une mise en page figée. Le compilateur\nfabrique alors le CSS depuis les **sept groupes** de `docs/zenraymedia/01-PLAN.md §10.2` :\n`surface`, `palette`, `typography`, `grid`, `motion`, `chrome`, `sound`.\n\nRéférence à copier : `T-01-3-2.theme.js`.\n\nAvantage : le thème s'adapte à **tous les formats** (article, image, affiche, vidéo) sans\nréécriture. Un gabarit HTML, lui, décrit une mise en page et vise surtout l'article.\n\n---\n\n## Règle de marque, sans exception\n\nLe nom public d'un thème est un **archétype de genre** (« chaîne d'info continue »), jamais une\nmarque déposée. La référence de calibrage vit dans le champ privé `calibration.ref`, jamais rendu,\njamais poussé. Un thème dont le nom contient une marque connue est **refusé au chargement** par\n`validateTheme` (`contracts.js`).\n"},{"type":"input_text","text":"---3---\n21:export const DECLENSION_GROUPS = [\n22:  { id: 'lecture', label: 'Lecture', formats: ['F-web-article', 'F-print-a4'] },\n23:  { id: 'reseaux', label: 'Réseaux', formats: ['F-still-1080-square', 'F-still-1080x1350', 'F-still-1080x1920'] },\n24:  { id: 'ecran', label: 'Écran', formats: ['F-video-1920x1080', 'F-overlay-1920x1080'] },\n56:export function declensionTree({ brief, cut, theme, dark = false, groups = DECLENSION_GROUPS }) {\n// ZenRayMedia — L5/L9 : l'ARBRE DE DÉCLINAISONS.\n//\n// C'est la thèse du produit rendue visible : `Livrable = Rendu(Brief × Thème × Format)`.\n// Jusqu'ici l'application n'affichait qu'UN format à la fois — on devait cliquer une pastille\n// pour découvrir qu'un texte ne tenait pas en 1:1. L'arbre montre les sorties SIMULTANÉMENT,\n// avec le verdict du Critique sur chacune, avant d'avoir cliqué quoi que ce soit.\n//\n// Inspiré de l'éditeur de référence de Matthieu (`zenraymediav1-editor.html`), qui présente\n// « YouTube 16:9 · Reel 9:16 · Carrousel 4:5 · Infolettre · Images » comme un arbre sous une\n// source unique. La différence ici : chaque branche porte son état RÉEL, pas une décoration.\n\nimport { FORMATS, getFormat, isTemporal, durationOf } from './formats.js'\nimport { visibleBeats, omittedCount, readingTimeOf } from './compile.js'\nimport { inspectStatic, summarize } from './critic.js'\n\n/**\n * Les groupes de déclinaisons proposés par défaut.\n * Un groupe n'est PAS un format : c'est une intention de diffusion, qui se traduit en un ou\n * plusieurs formats. « Réseaux » veut dire trois sorties, pas une.\n */\nexport const DECLENSION_GROUPS = [\n  { id: 'lecture', label: 'Lecture', formats: ['F-web-article', 'F-print-a4'] },\n  { id: 'reseaux', label: 'Réseaux', formats: ['F-still-1080-square', 'F-still-1080x1350', 'F-still-1080x1920'] },\n  { id: 'ecran', label: 'Écran', formats: ['F-video-1920x1080', 'F-overlay-1920x1080'] },\n]\n\n/**\n * État d'une déclinaison, calculé sans rien rendre : ce que le format montre, ce qu'il laisse\n * de côté, sa durée s'il est temporel, et le verdict du Critique.\n */\nexport function declensionState({ brief, cut, theme, format, dark = false }) {\n  const shown = visibleBeats(cut, format).length\n  const omitted = omittedCount(cut, format)\n  const issues = inspectStatic({ brief, cut, theme, format, dark })\n  const verdict = summarize(issues)\n  return {\n    formatId: format.id,\n    label: format.label,\n    short: format.short,\n    kind: format.kind,\n    canvas: format.canvas,\n    ratio: format.canvas.h > 0 ? format.canvas.w / format.canvas.h : null,\n    shown,\n    omitted,\n    total: shown + omitted,\n    duration: isTemporal(format) ? durationOf(cut, format) : 0,\n    declared: Array.isArray(theme?.formats) ? theme.formats.includes(format.id) : true,\n    blocking: verdict.blocking.length,\n    warnings: verdict.warnings.length,\n    ready: verdict.canPublish,\n    issues,\n  }\n}\n\n/** L'arbre complet, groupé par intention de diffusion. */\nexport function declensionTree({ brief, cut, theme, dark = false, groups = DECLENSION_GROUPS }) {\n  if (!brief || !cut || !theme) return []\n  return groups.map((group) => {\n    const branches = group.formats\n      .map((id) => getFormat(id))\n      .filter(Boolean)\n      .map((format) => declensionState({ brief, cut, theme, format, dark }))\n    return {\n      ...group,\n      branches,\n      ready: branches.filter((b) => b.ready).length,\n      total: branches.length,\n      // Un groupe est en défaut dès qu'UNE de ses branches l'est : on ne moyenne pas un blocage.\n      blocking: branches.reduce((n, b) => n + b.blocking, 0),\n    }\n  })\n}\n\n/** Résumé d'une passe complète, pour l'en-tête de l'arbre. */\nexport function declensionSummary(tree) {\n  const branches = tree.flatMap((g) => g.branches)\n  return {\n    total: branches.length,\n    ready: branches.filter((b) => b.ready).length,\n    blocking: branches.reduce((n, b) => n + b.blocking, 0),\n    // Formats que le thème ne déclare pas : ils rendront quand même, mais approximativement.\n    undeclared: branches.filter((b) => !b.declared).map((b) => b.formatId),\n  }\n}\n\n/**\n * Estimation du travail restant, en mots, pour qu'un format cesse de tronquer.\n * Sert à dire « il te manque de la place », pas seulement « ça déborde ».\n */\nexport function trimAdvice(cut, format) {\n  const omitted = omittedCount(cut, format)\n  if (omitted <= 0) return null\n  const hidden = (cut?.beats || []).slice(visibleBeats(cut, format).length)\n  const words = hidden.reduce((n, b) => n + String(b.text || '').trim().split(/\\s+/).filter(Boolean).length, 0)\n  return { omitted, words, minutes: readingTimeOf({ beats: hidden }).minutes }\n}\n20:    id: 'F-web-article', fit: { mode: 'full', maxBeats: Infinity }, density: 1 /* l'écran est la référence : 1 px CSS = 1 px */, kind: 'web', label: 'libre · 820', short: '820',\n27:    id: 'F-still-1080-square', fit: { mode: 'poster', maxBeats: 1 }, density: 1.7 /* lisible en vignette de fil social */, kind: 'still', label: '1:1 · 1080', short: '1:1',\n34:    id: 'F-still-1080x1350', fit: { mode: 'poster', maxBeats: 2 }, density: 1.7 /* lisible en vignette de fil social */, kind: 'still', label: '4:5 · 1080×1350', short: '4:5',\n41:    id: 'F-still-1080x1920', fit: { mode: 'poster', maxBeats: 2 }, density: 1.7 /* lisible sur un écran de téléphone tenu à bout de bras */, kind: 'still', label: '9:16 · 1080×1920', short: '9:16',\n50:    id: 'F-print-a4', fit: { mode: 'full', maxBeats: Infinity }, density: 3.125 /* 300 dpi / 96 dpi de référence CSS -> corps ~14 pt réels */, kind: 'print', label: 'A4 · 2480×3508', short: 'A4',\n57:    id: 'F-video-1920x1080', fit: { mode: 'poster', maxBeats: 1 }, density: 1.6 /* lisible à 2 m d'un téléviseur */, kind: 'video', label: '16:9 · 1920×1080', short: '16:9',\n66:    id: 'F-overlay-1920x1080', fit: { mode: 'poster', maxBeats: 1 }, density: 1.6 /* même échelle que la vidéo qu'il habille */, kind: 'overlay', label: '16:9 α · 1920×1080', short: 'α',\n90:  { id: 'F-web-og', fit: { mode: 'poster', maxBeats: 1 }, density: 1.35, kind: 'still', label: '