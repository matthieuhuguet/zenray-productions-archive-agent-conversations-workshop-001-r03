nst parts = m[1].split(/[,\\s/]+/).filter(Boolean).map(Number)\n    if (parts.length >= 3 && parts.slice(0, 3).every((n) => Number.isFinite(n))) {\n      return { r: parts[0], g: parts[1], b: parts[2], a: Number.isFinite(parts[3]) ? parts[3] : 1 }\n    }\n  }\n  return null\n}\n\nfunction channelLuminance(c) {\n  const v = c / 255\n  return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4)\n}\n\nexport function relativeLuminance(color) {\n  return 0.2126 * channelLuminance(color.r) + 0.7152 * channelLuminance(color.g) + 0.0722 * channelLuminance(color.b)\n}\n\n// Compose une couleur semi-transparente sur son fond : sans ça, un `rgba(20,22,26,.56)` sur blanc\n// serait mesuré comme du quasi-noir et le contraste serait faux.\nexport function composite(fg, bg) {\n  const a = fg.a ?? 1\n  return { r: fg.r * a + bg.r * (1 - a), g: fg.g * a + bg.g * (1 - a), b: fg.b * a + bg.b * (1 - a), a: 1 }\n}\n\nexport function contrastRatio(foreground, background) {\n  const fg = parseColor(foreground)\n  const bg = parseColor(background)\n  if (!fg || !bg) return null\n  const composed = composite(fg, { ...bg, a: 1 })\n  const l1 = relativeLuminance(composed)\n  const l2 = relativeLuminance(bg)\n  const [hi, lo] = l1 > l2 ? [l1, l2] : [l2, l1]\n  return Math.round(((hi + 0.05) / (lo + 0.05)) * 100) / 100\n}\n\n// --- Contrôles statiques -----------------------------------------------------------------------\nexport function inspectStatic({ brief, cut, theme, format, dark = false, composed = false }) {\n  const issues = []\n\n  for (const [kind, value] of [['brief', brief], ['cut', cut], ['theme', theme], ['format', format]]) {\n    for (const err of validate(kind, value)) {\n      issues.push(issue(SEVERITY.blocking, `${kind}.${err.code}`, err.message))\n    }\n  }\n  if (issues.length) return issues // inutile de mesurer une structure invalide\n\n  // ZM-L2-02 — message unique.\n  if (sentenceCount(brief.message) > 1) {\n    issues.push(issue(SEVERITY.blocking, 'message.multi', 'Le message tient en une seule phrase.'))\n  }\n\n  // ZM-L11-02 — contraste réel de l'encre sur le fond, au seuil posé par le thème.\n  const ink = dark ? theme.palette.inkDark : theme.palette.ink\n  const bg = dark ? theme.surface.backgroundDark : theme.surface.background\n  const ratio = contrastRatio(ink, bg)\n  const minContrast = theme.palette.minContrast || 4.5\n  if (ratio == null) {\n    issues.push(issue(SEVERITY.warning, 'contrast.unreadable', 'Couleurs du thème non analysables : contraste non vérifié.'))\n  } else if (ratio < minContrast) {\n    issues.push(issue(SEVERITY.blocking, 'contrast.low', `Contraste ${ratio}:1 sous le seuil ${minContrast}:1 du thème (mode ${dark ? 'sombre' : 'clair'}).`))\n  }\n  const muted = dark ? theme.palette.mutedDark : theme.palette.muted\n  const mutedRatio = contrastRatio(muted, bg)\n  if (mutedRatio != null && mutedRatio < 4.5) {\n    issues.push(issue(SEVERITY.warning, 'contrast.muted', `Texte secondaire à ${mutedRatio}:1 : sous 4,5:1, il devient pénible à lire.`))\n  }\n\n  // ZM-L4 — le thème déclare-t-il ce format ?\n  if (Array.isArray(theme.formats) && !theme.formats.includes(format.id)) {\n    issues.push(issue(SEVERITY.warning, 'theme.format', `« ${theme.name} » ne déclare pas le format ${format.label} : le rendu peut être approximatif.`))\n  }\n\n  // ZM-L3-03 — nombre de beats imposé par le thème.\n  const count = cut.beats.length\n  const { min, max } = theme.beatCount || { min: 1, max: 99 }\n  if (count < min) issues.push(issue(SEVERITY.warning, 'cut.tooFew', `${count} beat(s) pour un thème qui en attend ${min} au minimum.`, 'refit'))\n  if (count > max) issues.push(issue(SEVERITY.warning, 'cut.tooMany', `${count} beats pour un thème qui en accepte ${max} au maximum.`, 'refit'))\n\n  // ZM-L11-04 — durée dans les bornes du format.\n  if (isTemporal(format)) {\n    const d = durationOf(cut, format)\n    if (d <= format.time.min) issues.push(issue(SEVERITY.warning, 'duration.short', `Durée ${d}s au plancher du format (${format.time.min}s) : le contenu a été comprimé.`))\n    if (d >= format.time.max) issues.push(issue(SEVERITY.blocking, 'duration.long', `Durée ${d}s au plafond du format (${format.time.max}s) : retire ou raccourcis un beat.`))\n  }\n\n  // ZM-L2-08 — les mentions obligatoires apparaissent dans le contenu.\n  const haystack = `${brief.title} ${brief.message} ${cut.beats.map((b) => b.text).join(' ')}`.toLowerCase()\n  for (const mention of brief.constraints?.mentions || []) {\n    if (mention && !haystack.includes(String(mention).toLowerCase())) {\n      issues.push(issue(SEVERITY.blocking, 'mention.missing', `Mention obligatoire absente du contenu : « ${mention} ».`))\n    }\n  }\n\n  // Politique de contenu du format : ce qui n'est pas affiché doit être DIT. Un bloc qui\n  // disparaît sans un mot est la pire des interfaces -- on croit avoir publié son texte entier.\n  // ... SAUF sur la voie composée, où les blocs ne sont plus la source de la page : celle-ci est\n  // faite des pièces posées, et compter des blocs « omis » y raconte une histoire fausse. C'est le\n  // second point où le Critique parlait de l'ancien modèle en regardant le nouveau.\n  const omitted = composed ? 0 : omittedCount(cut, format)\n  if (omitted > 0) {\n    issues.push(issue(SEVERITY.info, 'fit.omitted',\n      `Ce format montre ${visibleBeats(cut, format).length} bloc(s) sur ${cut.beats.length} : ${omitted} restent réservés aux formats de lecture (Web, A4). C'est voulu — une image ne porte pas un article.`))\n  }\n\n  // Poids des médias encodés. Un document de plusieurs mégaoctets alourdit chaque enregistrement\n  // dans le drive et chaque relecture : on le dit AVANT que ça devienne pénible, pas après.\n  const mediaBytes = slotsWeight(cut)\n  if (mediaBytes > 6_000_000) {\n    issues.push(issue(SEVERITY.warning, 'doc.heavy', `${Math.round(mediaBytes / 1e6)} Mo d'images encodées dans le document : au-delà de 6 Mo, chaque enregistrement devient lent. Retire une image ou attends le stockage en shards.`))\n  }\n  const slots = countSlots(cut)\n  if (slots > 0 && format.kind === 'web' && slots > cut.beats.length * MAX_SLOTS) {\n    issues.push(issue(SEVERITY.warning, 'slots.many', `${slots} images pour ${cut.beats.length} blocs : la page devient lourde à charger.`))\n  }\n\n  // ZM-L4-11 — polices du thème. Une famille absente du disque n'est pas une erreur : la page\n  // retombe sur sa pile système. Mais le rendu ne sera PAS celui mesuré sur les captures, et\n  // c'est exactement le genre d'écart qu'on ne voit pas et qu'on livre quand même.\n  const missing = missingFamilies(theme.fonts || [])\n  if (missing.length) {\n    issues.push(issue(SEVERITY.warning, 'font.missing',\n      `Police non installée : ${missing.join(', ')}. Le rendu utilise un repli système, donc pas la typographie mesurée. Installer avec « node scripts/zrm-fonts.mjs --cjk » si c'est une famille japonaise.`))\n  }\n  const fontBytes = fontsWeight(theme.fonts || [])\n  if (fontBytes > 1_500_000) {\n    issues.push(issue(SEVERITY.warning, 'font.heavy',\n      `${Math.round(fontBytes / 1e6 * 10) / 10} Mo de polices embarquées à l'export : la page devient lente à ouvrir. Retire une graisse ou une famille.`))\n  }\n\n  // ZM-L11-06 — un beat d'un seul mot n'est pas un beat.\n  cut.beats.forEach((beat, i) => {\n    const words = String(beat.text).trim().split(/\\s+/).filter(Boolean).length\n    if (words < 3) issues.push(issue(SEVERITY.warning, 'beat.thin', `Beat ${i + 1} (${beat.role}) : ${words} mot(s). Trop court pour porter quoi que ce soit.`))\n  })\n\n  // Un cut sans appel final quand l'intention est de vendre ou convaincre.\n  if (['vendre', 'convaincre'].includes(brief.intent) && !cut.beats.some((b) => b.role === 'cta')) {\n    issues.push(issue(SEVERITY.warning, 'cut.noCta', `Intention « ${brief.intent} » sans beat d'appel : le lecteur ne saura pas quoi faire.`))\n  }\n\n  return issues\n}\n\n// --- Contrôles mesurés sur la page rendue -------------------------------------------------------\n// `doc` est le document de l'iframe d'aperçu. On MESURE, on n'estime pas.\nexport function inspectRendered(doc, format) {\n  const issues = []\n  if (!doc || !doc.body) return issues\n  const view = doc.defaultView\n  if (!view) return issues\n\n  // LE CRITIQUE ÉTAIT AVEUGLE À LA VOIE LEGO, et cela produisait un faux positif systématique.\n  //\n  // Il cherchait `.zrm-page`, que seule la voie à jetons produit ; la voie composée écrit\n  // `.zrm-lego-page`. Faute de la trouver, il mesurait le `body`, lequel fait exactement la taille\n  // du canevas, et le comparait à l'espace utile, c'est-à-dire au canevas MOINS les zones de\n  // sécurité. Le verdict tombait donc toujours, et toujours du même chiffre : la somme des zones\n  // de sécurité. En Carré 1080, quarante-huit en haut plus quarante-huit en bas, soit les 96 px\n  // annoncés sur les deux axes à la fois. Un débordement identique en hauteur et en largeur n'est\n  // jamais du contenu, c'est une constante ; c'est ce qui a mis sur la piste.\n  const legoPage = doc.querySelector('.zrm-lego-page')\n  const page = legoPage || doc.querySelector('.zrm-page') || doc.body\n  const fixed = format?.canvas?.h > 0\n  const safe = format?.safe || { top: 0, bottom: 0, sides: 0 }\n\n  // ZM-L11-03 — débordement réel.\n  // On mesure la page CONTRE L'ESPACE UTILE (canevas moins zones de sécurité), pas contre le\n  // body. Le cadre centre son contenu en flex avec `overflow:hidden` : un contenu trop haut y\n  // déborde SYMÉTRIQUEMENT et se fait rogner en haut ET en bas, sans que `scrollHeight` du body\n  // ne bouge. Mesurer le body laisserait donc passer une coupe franche sans rien signaler.\n  if (fixed) {\n    const usableH = format.canvas.h - safe.top - safe.bottom\n    const usableW = format.canvas.w - safe.sides * 2\n    // La page composée RÉSERVE elle-même ses zones de sécurité, sous forme de remplissage. Son\n    // débordement se lit donc dans sa propre boîte, et non contre une largeur utile qu'elle a déjà\n    // déduite : la mesurer comme l'autre voie reviendrait à retrancher deux fois la même marge.\n    const overflowY = legoPage\n      ? Math.round(legoPage.scrollHeight - legoPage.clientHeight)\n      : Math.round(page.getBoundingClientRect().height - usableH)\n    if (overflowY > 2) {\n      issues.push(issue(SEVERITY.blocking, 'overflow.vertical', `Le contenu dépasse de ${overflowY} px la hauteur utile du format : il sera rogné en haut et en bas.`, 'shrink'))\n    }\n    const overflowX = legoPage\n      ? Math.round(legoPage.scrollWidth - legoPage.clientWidth)\n      : Math.round(page.scrollWidth - usableW)\n    if (overflowX > 2) {\n      issues.push(issue(SEVERITY.blocking, 'overflow.horizontal', `Le contenu dépasse de ${overflowX} px la largeur utile du format.`, 'shrink'))\n    }\n  }\n\n  // ZM-L11-01 — zones de sécurité des plateformes.\n  if (fixed && format?.safe) {\n    const H = format.canvas.h\n    const W = format.canvas.w\n    for (const el of doc.querySelectorAll('.zrm-title, .zrm-beat-text, .zrm-standfirst, .zrm-byline, .zrm-kicker')) {\n      const r = el.getBoundingClientRect()\n      if (r.width === 0 && r.height === 0) continue\n      if (r.top < safe.top - 1) { issues.push(issue(SEVERITY.blocking, 'safe.top', `Du texte entre dans la zone haute réservée à l'interface (${Math.round(safe.top - r.top)} px trop haut).`, 'shrink')); break }\n      if (r.bottom > H - safe.bottom + 1) { issues.push(issue(SEVERITY.blocking, 'safe.bottom', `Du texte entre dans la zone basse réservée à l'interface (${Math.round(r.bottom - (H - safe.bottom))} px trop bas).`, 'shrink')); break }\n      if (r.left < safe.sides - 1 || r.right > W - safe.sides + 1) { issues.push(issue(SEVERITY.blocking, 'safe.sides', 'Du texte sort des marges latérales de sécurité.', 'shrink')); break }\n    }\n  }\n\n  // ZM-L11-05 — plancher de lisibilité. 12 px est la règle du projet sur poste fixe ; sur un\n  // format à canevas fixe, le plancher est rel