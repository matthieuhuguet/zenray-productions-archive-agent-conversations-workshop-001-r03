ool\" style={{ height: 20 }} data-on={showSafe} disabled={!format.safe}\n              title=\"Zones de sécurité\" onClick={() => setShowSafe((v) => !v)}><Icon name=\"rectangle.dashed\" size={11} /></button>\n            <button className=\"zrm-tool\" style={{ height: 20 }} data-on={renderDark}\n              title={renderDark ? 'Rendu en clair' : 'Rendu en sombre'} onClick={() => setRenderDark((v) => !v)}>\n              <Icon name={renderDark ? 'sun.max' : 'moon'} size={11} /></button>\n            <span className=\"zrm-tool-sep\" />\n            <button className=\"zrm-tool\" style={{ height: 20 }} data-on={!!selectedComponent}\n              title=\"Désélectionner\" onClick={() => { setSelectedComponent(null); setSelectedNode(null) }}><Icon name=\"cursorarrow\" size={11} /></button>\n            <span className=\"zrm-tool-sep\" />\n            <button className=\"zrm-tool\" style={{ height: 20 }} title=\"Réduire\" onClick={() => setZoom((z) => Math.max(0.1, z / 1.25))}><Icon name=\"minus\" size={11} /></button>\n            <button className=\"zrm-tool\" style={{ height: 20 }} title=\"Replacer la vue (double-clic sur le fond)\" onClick={replacerLaVue}>{Math.round(zoom * 100)} %</button>\n            <button className=\"zrm-tool\" style={{ height: 20 }} title=\"Agrandir\" onClick={() => setZoom((z) => Math.min(8, z * 1.25))}><Icon name=\"plus\" size={11} /></button>\n            {calqueSelectionne && (\n              <button className=\"zrm-tool\" style={{ height: 20 }} title=\"Cadrer la sélection (Maj+F)\" onClick={cadrerLaSelection}>\n                <Icon name=\"rectangle.dashed\" size={11} />\n              </button>\n            )}\n          </div>\n          <div className=\"zrm-vp-note\" data-at=\"tl\">\n            Échelle {Math.round(fitScale * 100)} %{zoom !== 1 ? ' · vue déplacée' : ''}<br />\n            Sélection : {pieceSelectionnee ? pieceSelectionnee.name : 'aucune'}\n          </div>\n          <div className=\"zrm-vp-note\" data-at=\"bl\">\n   