sans = os.path.join(font_dir, 'AnthropicSans-Bold.ttf')\n\n# 1. Master Title setup (PRE-RENDERED ONCE TO AVOID ANY VARIABLE SHADOWING)\ntitle_sectra_bold_italic = ImageFont.truetype(p_sectra_bold_italic, 66)\ntitle_inter = ImageFont.truetype(p_inter, 66)\ntitle_inter.set_variation_by_axes([700])\ntitle_mono = ImageFont.truetype(p_mono, 66)\n\nt_w1 = title_sectra_bold_italic.getlength('Houdini')\nspace_w = 18\nt_w2 = title_inter.getlength('Procedural')\nt_w3 = title_mono.getlength('Texturing')\ntotal_title_w = t_w1 + space_w + t_w2 + space_w + t_w3\ntitle_tx = (W - total_title_w) // 2\ntitle_baseline_y = 330\nshear = 0.22\n\nascent_t, descent_t = title_mono.getmetrics()\nbox_w = int(t_w3 + 60)\nbox_h = int(ascent_t + descent_t + 20)\npatch_title = Image.new('RGBA', (box_w, box_h), (0, 0, 0, 0))\np_draw = ImageDraw.Draw(patch_title)\nox = 10\np_draw.text((ox, ascent_t), 'Texturing', font=title_mono, fill=(255, 255, 255), stroke_width=4, stroke_fill=(0, 0, 0), anchor='ls')\nmat = (1, shear, -shear * ascent_t, 0, 1, 0)\nslanted_title_mono = patch_title.transform((box_w, box_h), Image.AFFINE, mat, resample=Image.BICUBIC)\npaste_title_mono_pos = (int(title_tx + t_w1 + space_w + t_w2 + space_w - ox), int(title_baseline_y - ascent_t))\n\ntitle_layer = Image.new('RGBA', (W, H), (0, 0, 0, 0))\nt_draw = ImageDraw.Draw(title_layer)\nt_draw.text((title_tx, title_baseline_y), 'Houdini', font=title_sectra_bold_italic, fill=(255, 255, 255), stroke_width=4, stroke_fill=(0, 0, 0), anchor='ls')\nt_draw.text((title_tx + t_w1 + space_w, title_baseline_y), 'Procedural', font=title_inter, fill=(255, 255, 255), stroke_width=4, stroke_fill=(0, 0, 0), anchor='ls')\ntitle_layer.paste(slanted_title_mono, paste_title_mono_pos, slanted_title_mono)\n\n# 2. Subtitles: 5 cues in 2 punchy lines, line-by-line canon animation\ncues_2lines = [\n    [\n        'Testing a new procedural workflow,',\n        'getting used to Copernicus in Houdini.'\n    ],\n    [\n        'Equivalent of Substance Designer,',\n        'directly inside the Houdini graph.'\n    ],\n    [\n        'Takes more time than Designer,',\n        'until custom recipes are built.'\n    ],\n    [\n        'Building wood height layer by layer,',\n        'from fine fibers to organic knots.'\n    ],\n    [\n        'Blending all layers together,',\n        'full procedural look for lookdev.'\n    ]\n]\n\nMAX_W = 940\nspace_sub = 16\nc1 = (540, 1530)\nc2 = (540, 1630)\n\npunch_curve = [\n    (0.50, 0.0),\n    (0.68, 0.4),\n    (0.85, 0.7),\n    (1.02, 1.0),\n    (1.14, 1.0),\n    (1.18, 1.0), # peak punch\n    (1.16, 1.0),\n    (1.11, 1.0),\n    (1.05, 1.0),\n    (0.99, 1.0),\n    (0.96, 1.0),\n    (0.97, 1.0),\n    (0.99, 1.0),\n    (1.01, 1.0),\n    (1.00, 1.0)\n]\n\ndef render_line_card(line, font_size, cue_idx, line_idx):\n    f_i = ImageFont.truetype(p_inter, font_size)\n    f_i.set_variation_by_axes([700])\n    f_s = ImageFont.truetype(p_serif, font_size)\n    f_m = ImageFont.truetype(p_mono, int(font_size * 0.92))\n    pool = [f_i, f_s, f_m]\n    \n    rng = random.Random(cue_idx * 1337 + 42 + line_idx * 99)\n    last_idx = -1\n    \n    words = line.split(' ')\n    w_fonts = []\n    is_mono = []\n    widths = []\n    for w in words:\n        choices = [i for i in range(len(pool)) if i != last_idx]\n        last_idx = rng.choice(choices)\n        chosen_font = pool[last_idx]\n        w_fonts.append(chosen_font)\n        is_mono.append(chosen_font == f_m)\n        widths.append(chosen_font.getlength(w))\n        \n    total_w = sum(widths) + space_sub * (len(words) - 1)\n    im_w = int(total_w + 40)\n    im_h = int(font_size * 1.5 + 30)\n    \n    im = Image.new('RGBA', (im_w, im_h), (0, 0, 0, 0))\n    d = ImageDraw.Draw(im)\n    \n    cur_x = 20\n    base_y = int(font_size * 1.1 + 10)\n    \n    for w, f, width, imono in zip(words, w_fonts, widths, is_mono):\n        if imono:\n            asc, desc = f.getmetrics()\n            bw = int(width + 60)\n            bh = int(asc + desc + 30)\n            pp = Image.new('RGBA', (bw, bh), (0, 0, 0, 0))\n            pd = ImageDraw.Draw(pp)\n            pd.text((15, asc), w, font=f, fill=(255, 225, 68), stroke_width=4, stroke_fill=(0, 0, 0), anchor='ls')\n            m = (1, shear, -shear * asc, 0, 1, 0)\n            sl = pp.transform((bw, bh), Image.AFFINE, m, resample=Image.BICUBIC)\n            im.paste(sl, (int(cur_x - 15), int(base_y - asc)), sl)\n        else:\n            d.text((cur_x, base_y), w, font=f, fill=(255, 225, 68), stroke_width=4, stroke_fill=(0, 0, 0), anchor='ls')\n        cur_x += width + space_sub\n        \n    return im, im_w, im_h\n\n# Pre-render cues for canon line-by-line\nrendered_cues = []\nfor c_idx, cue in enumerate(cues_2lines):\n    best_size = 40\n    for test_size in range(62, 38, -1):\n        f_i = ImageFont.truetype(p_inter, test_size)\n        f_i.set_variation_by_axes([700])\n        f_s = ImageFont.truetype(p_serif, test_size)\n        f_m = ImageFont.truetype(p_mono, int(test_size * 0.92))\n        pool = [f_i, f_s, f_m]\n        fits = True\n        for l_idx, line in enumerate(cue):\n            rng = random.Random(c_idx * 1337 + 42 + l_idx * 99)\n            last_idx = -1\n            words = line.split(' ')\n            lw = sum(pool[rng.choice([i for i in range(len(pool)) if i != last_idx])].getlength(w) for w in words) + space_sub * (len(words) - 1)\n            if lw > MAX_W:\n                fits = False\n                break\n        if fits:\n            best_size = test_size\n            break\n            \n    card_im1, card_w1, card_h1 = render_line_card(cue[0], best_size, c_idx, 0)\n    card_im2, card_w2, card_h2 = render_line_card(cue[1], best_size, c_idx, 1)\n    \n    # Pre-scale Line 1 frames\n    l1_frames = []\n    for s, a in punch_curve:\n        if a > 0.0:\n            sw = int(card_w1 * s)\n            sh = int(card_h1 * s)\n            res = card_im1.resize((sw, sh), Image.Resampling.BILINEAR)\n            if a < 1.0:\n                r, g, b, alpha_ch = res.split()\n                alpha_ch = alpha_ch.point(lambda p: int(p * a))\n                res = Image.merge('RGBA', (r, g, b, alpha_ch))\n            l1_frames.append((res, c1[0] - sw // 2, c1[1] - sh // 2))\n        else:\n            l1_frames.append(None)\n    l1_steady = (card_im1, c1[0] - card_w1 // 2, c1[1] - card_h1 // 2)\n    \n    # Pre-scale Line 2 frames\n    l2_frames = []\n    for s, a in punch_curve:\n        if a > 0.0:\n            sw = int(card_w2 * s)\n            sh = int(card_h2 * s)\n            res = card_im2.resize((sw, sh), Image.Resampling.BILINEAR)\n            if a < 1.0:\n                r, g, b, alpha_ch = res.split()\n                alpha_ch = alpha_ch.point(lambda p: int(p * a))\n                res = Image.merge('RGBA', (r, g, b, alpha_ch))\n            l2_frames.append((res, c2[0] - sw // 2, c2[1] - sh // 2))\n        else:\n            l2_frames.append(None)\n    l2_steady = (card_im2, c2[0] - card_w2 // 2, c2[1] - card_h2 // 2)\n    \n    rendered_cues.append({\n        'l1_frames': l1_frames,\n        'l1_steady': l1_steady,\n        'l2_frames': l2_frames,\n        'l2_steady': l2_steady\n    })\n\n# 3. Sphere crops for 15.0 to 18.0s: Inverted order requested\n# 1st (15-16s): Fiber Knot\n# 2nd (16-17s): Cathedral Waves\n# 3rd (17-18s): Composite Blend\nbadge_font = ImageFont.truetype(p_sans, 38)\nsphere_specs = [\n    ('/Users/zenray/Downloads/tmp-3D-houdini/Layers/selection/crops/crop-03-wood-knot.jpg', 'FIBER KNOT'),\n    ('/Users/zenray/Downloads/tmp-3D-houdini/Layers/selection/crops/crop-01-cathedral-grain.jpg', 'CATHEDRAL WAVES'),\n    ('/Users/zenray/Downloads/tmp-3D-houdini/Layers/selection/crops/crop-02-blended-composite.jpg', 'COMPOSITE BLEND')\n]\nspheres_loaded = []\nfor p, label in sphere_specs:\n    im = Image.open(p).convert('RGBA')\n    spheres_loaded.append((im, label))\n\n# Video pipes\nseg1_cmd = [\n    'ffmpeg', '-y', '-ss', '00:00:01', '-t', '3.0',\n    '-i', '/Users/zenray/Downloads/tmp-shorts-vestibule-louisiana-bayou/raw/obs/turntable-raw-obs.mkv',\n    '-vf', 'fps=60,scale=1080:698:flags=lanczos,pad=1080:1920:0:611:color=black',\n    '-pix_fmt', 'rgb24', '-f', 'rawvideo', 'pipe:1'\n]\n\nseg2_cmd = [\n    'ffmpeg', '-y', '-ss', '00:00:01', '-t', '12.0',\n    '-i', '/Users/zenray/Downloads/tmp-3D-houdini/raw/walkthrough-15s-raw.mkv',\n    '-vf', 'fps=60,scale=1080:698:flags=lanczos,pad=1080:1920:0:611:color=black',\n    '-pix_fmt', 'rgb24', '-f', 'rawvideo', 'pipe:1'\n]\n\np1 = subprocess.Popen(seg1_cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)\np2 = subprocess.Popen(seg2_cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)\n\nout_mov = '/Users/zenray/Downloads/tmp-3D-houdini/short-materials-layers.mov'\nout_mp4 = '/Users/zenray/Downloads/tmp-3D-houdini/short-materials-layers.mp4'\nmusic = '/tmp/music_18s.m4a'\n\nenc_cmd = [\n    'ffmpeg', '-y',\n    '-f', 'rawvideo', '-pix_fmt', 'rgb24', '-s', f'{W}x{H}', '-r', '60', '-i', 'pipe:0',\n    '-i', music,\n    '-c:v', 'libx264', '-preset', 'slow', '-crf', '17', '-pix_fmt', 'yuv420p',\n    '-c:a', 'aac', '-b:a', '320k', '-ar', '48000',\n    '-shortest', out_mov\n]\np_out = subprocess.Popen(enc_cmd, stdin=subprocess.PIPE)\n\nbytes_per_frame = W * H * 3\ncanon_delay = 40  # 0.67s delay for Line 2 canon pop\n\nprint('Processing 1080 frames (18.00s exact) at 60 fps with line-by-line canon subtitles...')\n\nfor frame_idx in range(TOTAL_FRAMES):\n    t = frame_idx / float(FPS)\n    \n    # 1. Base video frame\n    if t < 3.0:\n        raw = p1.stdout.read(bytes_per_frame)\n        if len(raw) < bytes_per_frame:\n            base_frame = Image.new('RGB', (W, H), (0,0,0))\n        else:\n            base_frame = Image.frombytes('RGB', (W, H), raw)\n    elif t < 15.0:\n        raw = p2.stdout.read(bytes_per_frame)\n        if len(raw) < bytes_per_frame:\n            base_frame = Image.new('RGB', (W, H), (0,0,0))\n        else:\n            base_frame = Image.frombytes('RGB', (W, H), raw)\n    else:\n        # Spheres parade: 15-16s (Knot), 16-17s (Waves), 17-18s (Blend)\n        s_idx = int(t - 15.0)\n        s_idx = min(s_idx, 2)\n        base_frame = Image.new('RGB', (W, H), (14, 14, 16))\n        sph_img, sph_label = spheres_loaded[s_idx]\n        sw, sh = sph_img.size\n        px = (W - sw) // 2\n        py = (H - sh) // 2 - 40\n        base_frame.paste(sph_img, (px, py), sph_img)\n        \n        bd_draw = ImageDraw.Draw(base_frame)\n        bb = bd_draw.textbbox((0, 0), sph_label, font=badge_font)\n        bw = bb[2] - bb[0]\n        bh = bb[3] - bb[1]\n        bx = (W - bw) // 2\n        by = py + sh + 25\n        bd_draw.rounded_rectangle([bx - 24, by - 10, bx + bw + 24, by + bh + 14], radius=16, fill=(24, 24, 28))\n        bd_draw.text((bx, by), sph_label, font=badge_font, fill=(255, 255, 255))\n\n    # 2. Master Title: pre-rendered title layer pasted onto base_frame\n    base_frame.paste(title_layer, (0, 0), title_layer)\n    \n    # 3. Master Subtitles in CANON LINE-BY-LINE (ONLY for t < 15.0s, removed in last 3s as requested)\n    if frame_idx < 900: # 15.0s * 60fps = 900 frames\n        cue_idx = frame_idx // 180\n        cue_idx = min(cue_idx, len(rendered_cues) - 1)\n        f_rel = frame_idx % 180\n        cdata = rendered_cues[cue_idx]\n        \n        # Line 1 pops at f_rel = 0\n        if f_rel < len(cdata['l1_frames']):\n            part1 = cdata['l1_frames'][f_rel]\n        else:\n            part1 = cdata['l1_steady']\n        if part1 is not None:\n            im1, px1, py1 = part1\n            base_frame.paste(im1, (px1, py1), im1)\n            \n        # Line 2 pops in CANON after canon_delay (40 frames = 0.67s)\n        if f_rel >= canon_delay:\n            k = f_rel - canon_delay\n            if k < len(cdata['l2_frames']):\n                part2 = cdata['l2_frames'][k]\n            else:\n                part2 = cdata['l2_steady']\n            if part2 is not None:\n                im2, px2, py2 = part2\n                base_fra