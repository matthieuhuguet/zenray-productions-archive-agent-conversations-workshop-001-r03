t_t), title_word, font=title_mono, fill=(255, 255, 255), stroke_width=4, stroke_fill=(0, 0, 0), anchor='ls')\n        mat = (1, shear, -shear * ascent_t, 0, 1, 0)\n        slanted_title_mono = patch_title.transform((box_w, box_h), Image.AFFINE, mat, resample=Image.BICUBIC)\n        paste_title_mono_pos = (int(current_title_x - ox), int(title_baseline_y - ascent_t))\n        title_layer.paste(slanted_title_mono, paste_title_mono_pos, slanted_title_mono)\n    else:\n        t_draw.text((current_title_x, title_baseline_y), title_word, font=title_font, fill=(255, 255, 255), stroke_width=4, stroke_fill=(0, 0, 0), anchor='ls')\n    current_title_x += title_width + space_w\n\n# 2. Subtitles: 5 cues in 2 punchy lines, line-by-line canon animation\ncues_2lines = [\n    [\n        'Testing a new procedural workflow,',\n        'getting used to Copernicus in Houdini.'\n    ],\n    [\n        'Equivalent of Substance Designer,',\n        'directly inside the Houdini graph.'\n    ],\n    [\n        'Takes more time than Designer,',\n        'until custom recipes are built.'\n    ],\n    [\n        'Building wood height layer by layer,',\n        'from fine fibers to organic knots.'\n    ],\n    [\n        'Blending all layers together,',\n        'full procedural look for lookdev.'\n    ]\n]\n\nMAX_W = 940\nspace_sub = 16\nc1 = (540, 1530)\nc2 = (540, 1630)\n\npunch_curve = [\n    (0.50, 0.0),\n    (0.68, 0.4),\n    (0.85, 0.7),\n    (1.02, 1.0),\n    (1.14, 1.0),\n    (1.18, 1.0), # peak punch\n    (1.16, 1.0),\n    (1.11, 1.0),\n    (1.05, 1.0),\n    (0.99, 1.0),\n    (0.96, 1.0),\n"},{"type":"input_text","text":"\n---\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a09fca-cb4b-77a3-abf4-5af4649eec2b","create_time":1789387478.031571}}}
