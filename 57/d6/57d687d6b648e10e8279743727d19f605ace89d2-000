e2 in CUES:\n        font1, _ = fit_font(line1, P['subtitle_font'], P['subtitle_size_start'], max_width, P['subtitle_weight'])\n        font2, _ = fit_font(line2, P['subtitle_font'], P['subtitle_size_start'], max_width, P['subtitle_weight'])\n        sprites.append((make_text_sprite(line1, font1, P['subtitle_color']),\n                        make_text_sprite(line2, font2, P['subtitle_color'])))\n\n    title_layer = build_title_layer()\n\n    total_frames = int(round(P['duration'] * P['fps']))\n    out = sys.stdout.buffer\n    for frame_index in range(total_frames):\n        t = frame_index / P['fps']\n        cue_index = min(int(t // P['cue_seconds']), len(CUES) - 1)\n        local_t = t - cue_index * P['cue_seconds']\n        sprite1, sprite2 = sprites[cue_index]\n\n        frame = title_layer.copy()\n        scale1, opacity1 = envelope(max(0.0, local_t - P['pop_line1_offset']))\n        scale2, opacity2 = envelope(max(0.0, local_t - P['pop_line2_offset']))\n        if local_t < P['pop_line2_offset']:\n            opacity2 = 0.0\n        paste_scaled(frame, sprite1, P['width'] / 2, P['line1_y'], scale1, opacity1)\n        paste_scaled(frame, sprite2, P['width'] / 2, P['line2_y'], scale2, opacity2)\n\n        out.write(frame.tobytes())\n    out.flush()\n\n\nif __name__ == '__main__':\n    # Updated 2026-09-14 00:25 CEST: 4K is the only output resolution.\n    main()\n","exit_code":0,"duration":{"secs":0,"nanos":2333},"formatted_output":"\"\"\"Render the animated subtitle and title overlay for a 30 second short, piped straight into ffmpeg.\n\nWHY A PIPE. 900 RGBA frames at 2160x3840 would mean writing and re-reading about 28 GB of PNGs. Streaming\nraw frames to ffmpeg's stdin, as a second input, skips that entirely: no intermediate files, no\ncompression overhead, one process reads what the other writes.\n\nFR : le pipe evite d ecrire puis relire des gigaoctets de PNG intermediaires.\n\"\"\"\nimport sys\nfrom PIL import Image, ImageDraw, ImageFont\n\n# -- PARAMETERS (HDA law: everything tunable lives here) -----------------------------------------\nP = {\n    'width': 2160,\n    'height': 3840,\n    'fps': 30,\n    'duration': 30.0,\n    # Corrected 2026-09-12, final pass: the title is MIXED. \"Houdini\" keeps sentence case (not\n    # HOUDINI) in AnthropicSerif SemiBold, upright. The rest, \"LOUISIANA BAYOU\", stays uppercase\n    # in AnthropicSerif SemiBold ITALIC. Matthieu: \"c'etait Houdini pas en caps ... pas italic\n    # mais le reste du titre est italic\".\n    # FR : \"Houdini\" en casse normale et droit, \"LOUISIANA BAYOU\" en majuscules et italique.\n    'title_font': '/Users/zenray/Library/Fonts/AnthropicSerif-SemiBold.ttf',\n    'title_font_italic': '/Users/zenray/Library/Fonts/AnthropicSerif-SemiBoldItalic.ttf',\n    # Corrected again: NO forced uppercase anywhere in the title, sentence case throughout.\n    # Matthieu: \"NON TOUT EN CASSE NORMAL\".\n    # FR : plus aucune majuscule forcee, casse normale partout.\n    'title_text_upright': 'Houdini',\n    'title_text_italic': ' Louisiana Bayou',\n    'title_size_start': 260,           # the title is sized to the MAXIMUM px that still fits, never cropped\n    'title_max_pill_width_ratio': 0.92,\n    'title_pill_bg': (255, 255, 255, 255),\n    'title_text_color': (0, 0, 0, 255),\n    'title_radius_ratio': 0.30,\n    'title_pad_x_ratio': 0.55,\n    'title_pad_y_ratio': 0.42,\n    'title_y_center': 520,\n    'subtitle_font': '/Users/zenray/Library/Fonts/InterVariable.ttf',\n    # Corrected 2026-09-12: the bottom subtitles are Inter ExtraBold (800), not SemiBold (600).\n    # FR : les sous-titres du bas sont en Inter ExtraBold, pas SemiBold.\n    # Corrected 2026-09-12, final pass: #f8f671 read as too washed out. Matthieu: \"un jaune\n    # complet normal\". Pure vivid yellow, the same #FFE600 already documented as \"jaune vif\" in\n    # this skill's own history (section 6), not a pale tint.\n    # FR : jaune vif plein, pas une teinte pale.\n    'subtitle_weight': 900,\n    'subtitle_color': (0xFF, 0xE6, 0x00, 255),\n    'subtitle_size_start': 124,\n    'subtitle_max_width_ratio': 0.86,\n    'line1_y': 3040,\n    'line2_y': 3220,\n    'cue_seconds': 3.0,\n    'pop_line1_offset': 0.0,\n    'pop_line2_offset': 0.4,\n    # (time, scale, opacity) keyframes of the pop-in envelope, held at the last value after.\n    'pop_keys': [(0.0, 0.5, 0.0), (0.05, 0.5, 1.0), (0.15, 1.18, 1.0), (0.30, 0.96, 1.0), (0.45, 1.0, 1.0)],\n}\n\nCUES = [\n    (\"Today I continued developing\", \"my procedural Louisiana bayou church in Houdini.\"),\n    (\"I added a new asymmetrical vestibule\", \"on the porch stairs.\"),\n    (\"It sits off-center\", \"as part of the porch entrance.\"),\n    (\"I also started a Copernicus workflow\", \"for procedural materials like Substance Designer.\"),\n    (\"Its advantage is staying\", \"inside the same software.\"),\n    (\"I will see how far Copernicus can go\", \"compared with Substance Designer.\"),\n    (\"Across my existing components,\", \"I identified the material tags.\"),\n    (\"Those tags assign materials\", \"directly to the geometry.\"),\n    (\"I chose four materials from\", \"my concept art and reference images.\"),\n    (\"Next is the Karma XPU lookdev render.\", \"The complete graph is already set up.\"),\n]\n\n\nWEIGHT_NAMES = {400: b'Regular', 500: b'Medium', 600: b'SemiBold', 700: b'Bold',\n                800: b'ExtraBold', 900: b'Black'}\n\n\ndef load_variable_font(path, size, weight):\n    # InterVariable carries TWO axes, optical size then weight: set_variation_by_axes([weight])\n    # silently sets the FIRST axis (optical size) instead, and the glyphs stay Regular.\n    # The named instance is unambiguous and matches exactly what \"ExtraBold\" means.\n    # FR : passer un seul poids regle le premier axe (optical size), pas le poids ; le nom evite l erreur.\n    font = ImageFont.truetype(path, size)\n    try:\n        font.set_variation_by_name(WEIGHT_NAMES.get(weight, b'Regular'))\n    except Exception:\n        pass\n    return font\n\n\ndef fit_font(text, path, start_size, max_width, weight=None):\n    size = start_size\n    while size > 20:\n        font = (load_variable_font(path, size, weight) if weight else ImageFont.truetype(path, size))\n        box = font.getbbox(text)\n        if (box[2] - box[0]) <= max_width:\n            return font, box\n        size -= 2\n    font = (load_variable_font(path, size, weight) if weight else ImageFont.truetype(path, size))\n    return font, font.getbbox(text)\n\n\ndef make_text_sprite(text, font, color, pad=12):\n    \"\"\"A tight RGBA sprite, so scaling it later scales the glyphs around their own center.\"\"\"\n    box = font.getbbox(text)\n    width = box[2] - box[0] + pad * 2\n    height = box[3] - box[1] + pad * 2\n    sprite = Image.new('RGBA', (width, height), (0, 0, 0, 0))\n    draw = ImageDraw.Draw(sprite)\n    draw.text((pad - box[0], pad - box[1]), text, font=font, fill=color)\n    return sprite\n\n\ndef build_title_layer():\n    \"\"\"Two runs, two fonts, one baseline. \"Houdini\" is upright, the rest is italic: PIL has no\n    mixed-style text drawing, so the title is measured and placed as two separate runs that share\n    the SAME baseline, computed from each font's own ascent, not from the bounding box top.\"\"\"\n    # Grow the title to the largest size whose PILL still fits inside the canvas with a margin:\n    # the size is not guessed, it is measured against the real pill width at each step.\n    # FR : la taille se mesure contre la vraie largeur de pastille, jamais devinee.\n    max_pill_width = int(P['width'] * P['title_max_pill_width_ratio'])\n    size = P['title_size_start']\n    while size > 24:\n        font_up = ImageFont.truetype(P['title_font'], size)\n        font_it = ImageFont.truetype(P['title_font_italic'], size)\n        w_up = font_up.getlength(P['title_text_upright'])\n        w_it = font_it.getlength(P['title_text_italic'])\n        ascent_up, descent_up = font_up.getmetrics()\n        ascent_it, descent_it = font_it.getmetrics()\n        cap_h = max(ascent_up, ascent_it)          # used only to size the padding, as before\n        pad_x = int(cap_h * P['title_pad_x_ratio'])\n        pill_w = w_up + w_it + pad_x * 2\n        if pill_w <= max_pill_width:\n            break\n        size -= 2\n\n    ascent = max(ascent_up, ascent_it)\n    descent = max(descent_up, descent_it)\n    text_h = ascent + descent\n    pad_x = int(cap_h * P['title_pad_x_ratio'])\n    pad_y = int(cap_h * P['title_pad_y_ratio'])\n    text_w = w_up + w_it\n    pill_w, pill_h = text_w + pad_x * 2, text_h + pad_y * 2\n    radius = int(pill_h * P['title_radius_ratio'])\n\n    layer = Image.new('RGBA', (P['width'], P['height']), (0, 0, 0, 0))\n    draw = ImageDraw.Draw(layer)\n    x0 = (P['width'] - pill_w) // 2\n    y0 = P['title_y_center'] - pill_h // 2\n    draw.rounded_rectangle([x0, y0, x0 + pill_w, y0 + pill_h], radius=radius, fill=P['title_pill_bg'])\n\n    baseline_y = y0 + pad_y + ascent\n    draw.text((x0 + pad_x, baseline_y - ascent_up), P['title_text_upright'], font=font_up,\n              fill=P['title_text_color'])\n    draw.text((x0 + pad_x + w_up, baseline_y - ascent_it), P['title_text_italic'], font=font_it,\n              fill=P['title_text_color'])\n    return layer\n\n\ndef envelope(local_t):\n    keys = P['pop_keys']\n    if local_t <= keys[0][0]:\n        return keys[0][1], keys[0][2]\n    if local_t >= keys[-1][0]:\n        return keys[-1][1], keys[-1][2]\n    for (t0, s0, o0), (t1, s1, o1) in zip(keys, keys[1:]):\n        if t0 <= local_t <= t1:\n            f = (local_t - t0) / (t1 - t0)\n            return s0 + (s1 - s0) * f, o0 + (o1 - o0) * f\n    return keys[-1][1], keys[-1][2]\n\n\ndef paste_scaled(base, sprite, center_x, center_y, scale, opacity):\n    if opacity <= 0.0 or scale <= 0.0:\n        return\n    w, h = sprite.size\n    new_w, new_h = max(1, int(w * scale)), max(1, int(h * scale))\n    resized = sprite.resize((new_w, new_h), Image.LANCZOS)\n    if opacity < 1.0:\n        alpha = resized.getchannel('A').point(lambda a: int(a * opacity))\n        resized.putalpha(alpha)\n    base.alpha_composite(resized, (int(center_x - new_w / 2), int(center_y - new_h / 2)))\n\n\ndef main():\n    max_width = int(P['width'] * P['subtitle_max_width_ratio'])\n    sprites = []\n    for line1, line2 in CUES:\n        font1, _ = fit_font(line1, P['subtitle_font'], P['subtitle_size_start'], max_width, P['subtitle_weight'])\n        font2, _ = fit_font(line2, P['subtitle_font'], P['subtitle_size_start'], max_width, P['subtitle_weight'])\n        sprites.append((make_text_sprite(line1, font1, P['subtitle_color']),\n                        make_text_sprite(line2, font2, P['subtitle_color'])))\n\n    title_layer = build_title_layer()\n\n    total_frames = int(round(P['duration'] * P['fps']))\n    out = sys.stdout.buffer\n    for frame_index in range(total_frames):\n        t = frame_index / P['fps']\n        cue_index = min(int(t // P['cue_seconds']), len(CUES) - 1)\n        local_t = t - cue_index * P['cue_seconds']\n        sprite1, sprite2 = sprites[cue_index]\n\n        frame = title_layer.copy()\n        scale1, opacity1 = envelope(max(0.0, local_t - P['pop_line1_offset']))\n        scale2, opacity2 = envelope(max(0.0, local_t - P['pop_line2_offset']))\n        if local_t < P['pop_line2_offset']:\n            opacity2 = 0.0\n        paste_scaled(frame, sprite1, P['width'] / 2, P['line1_y'], scale1, opacity1)\n        paste_scaled(frame, sprite2, P['width'] / 2, P['line2_y'], scale2, opacity2)\n\n        out.write(frame.tobytes())\n    out.flush()\n\n\nif __name__ == '__main__':\n    # Updated 2026-09-14 00:25 CEST: 4K is the only output resolution.\n    main()\n"},"started_at_ms":1789382255092,"completed_at_ms":1789382255092}}
