t,\n              fill=P['title_text_color'])\n    return layer\n\n\ndef envelope(local_t):\n    keys = P['pop_keys']\n    if local_t <= keys[0][0]:\n        return keys[0][1], keys[0][2]\n    if local_t >= keys[-1][0]:\n        return keys[-1][1], keys[-1][2]\n    for (t0, s0, o0), (t1, s1, o1) in zip(keys, keys[1:]):\n        if t0 <= local_t <= t1:\n            f = (local_t - t0) / (t1 - t0)\n            return s0 + (s1 - s0) * f, o0 + (o1 - o0) * f\n    return keys[-1][1], keys[-1][2]\n\n\ndef paste_scaled(base, sprite, center_x, center_y, scale, opacity):\n    if opacity <= 0.0 or scale <= 0.0:\n        return\n    w, h = sprite.size\n    new_w, new_h = max(1, int(w * scale)), max(1, int(h * scale))\n    resized = sprite.resize((new_w, new_h), Image.LANCZOS)\n    if opacity < 1.0:\n        alpha = resized.getchannel('A').point(lambda a: int(a * opacity))\n        resized.putalpha(alpha)\n    base.alpha_composite(resized, (int(center_x - new_w / 2), int(center_y - new_h / 2)))\n1:\"\"\"Render the animated subtitle and title overlay for a 30 second short, piped straight into ffmpeg.\n4:raw frames to ffmpeg's stdin, as a second input, skips that entirely: no intermediate files, no\n7:FR : le pipe evite d ecrire puis relire des gigaoctets de PNG intermediaires.\n10:from PIL import Image, ImageDraw, ImageFont\n18:    # Corrected 2026-09-12, final pass: the title is MIXED. \"Houdini\" keeps sentence case (not\n19:    # HOUDINI) in AnthropicSerif SemiBold, upright. The rest, \"LOUISIANA BAYOU\", stays uppercase\n20:    # in AnthropicSerif SemiBold ITALIC. Matthieu: \"c'etait Houdini pas en caps ... pas italic\n23:    'title_font': '/Users/zenray/Library/Fonts/AnthropicSerif-SemiBold.ttf',\n24:    'title_font_italic': '/Users/zenray/Library/Fonts/AnthropicSerif-SemiBoldItalic.ttf',\n25:    # Corrected again: NO forced uppercase anywhere in the title, sentence case throughout.\n28:    'title_text_upright': 'Houdini',\n29:    'title_text_italic': ' Louisiana Bayou',\n30: