{"timestamp":"2026-09-14T11:15:43.950Z","ordinal":745,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a09f6e-5429-73b1-9c25-75c9e5b13e4d","turn_id":"01a09f9e-59a8-7110-b2bc-302f7c57f92c","item":{"type":"FileChange","id":"exec-679c34fe-5aa0-4baf-9024-6e458190b903","changes":{"/Users/zenray/Downloads/tmp-3D-houdini/Scripts/RenderTitleVariants.py":{"type":"add","content":"#!/usr/bin/env python3\n\nfrom __future__ import annotations\n\nimport json\nimport shutil\nimport subprocess\nimport tempfile\nfrom concurrent.futures import ThreadPoolExecutor\nfrom dataclasses import dataclass\nfrom pathlib import Path\n\nfrom PIL import Image, ImageDraw, ImageFont\n\n\n# Updated 2026-09-14 13:05 CEST: render comparable mixed and Sectra-only title variants.\n@dataclass(frozen=True)\nclass RenderConfig:\n    project_dir: Path = Path(\"/Users/zenray/Downloads/tmp-3D-houdini\")\n    input_video_name: str = \"short-materials-layers.mp4\"\n    width: int = 1080\n    height: int = 1920\n    frame_rate: int = 60\n    title_font_size: int = 66\n    title_baseline_y: int = 330\n    title_space: int = 18\n    title_clear_top: int = 220\n    title_clear_bottom: int = 410\n    stroke_width: int = 4\n    mono_shear: float = 0.22\n    video_bitrate: str = \"12M\"\n\n    @property\n    def input_video(self) -> Path:\n        return self.project_dir / self.input_video_name\n\n    @property\n    def preview_dir(self) -> Path:\n        return self.project_dir / \"previews\"\n\n\n@dataclass(frozen=True)\nclass TitleVariant:\n    name: str\n    font_keys: tuple[str, str, str]\n    output_name: str\n    preview_name: str\n\n\nCONFIG = RenderConfig()\nFONT_PATHS = {\n    \"sectra\": Path(\"/Users/zenray/Library/Fonts/GT-Sectra-LCGV-Bold-Italic.otf\"),\n    \"inter\": Path(\"/Users/zenray/Library/Fonts/InterTight-Italic-VariableFont_wght.ttf\"),\n    \"mono\": Path(\"/Users/zenray/Library/Fonts/AnthropicMono-Bold.ttf\"),\n}\nTITLE_WORDS = (\"Houdini\", \"Procedural\", \"Texturing\")\nTITLE_VARIANTS = (\n    TitleVariant(\n        name=\"random\",\n        font_keys=(\"sectra\", \"inter\", \"mono\"),\n        output_name=\"short-materials-layers-title-random.mp4\",\n        preview_name=\"short-materials-layers-title-random.jpg\",\n    ),\n    TitleVariant(\n        name=\"sectra-only\",\n        font_keys=(\"sectra\", \"sectra\", \"sectra\"),\n        output_name=\"short-materials-layers-title-sectra-only.mp4\",\n        preview_name=\"short-materials-layers-title-sectra-only.jpg\",\n    ),\n)\n\n\ndef require_inputs() -> None:\n    required_paths = [CONFIG.input_video, *FONT_PATHS.values()]\n    missing_paths = [str(path) for path in required_paths if not path.is_file()]\n    if missing_paths:\n        raise FileNotFoundError(f\"Missing required files: {missing_paths}\")\n    for command in (\"ffmpeg\", \"ffprobe\"):\n        if shutil.which(command) is None:\n            raise FileNotFoundError(f\"Missing command: {command}\")\n\n\ndef load_fonts() -> dict[str, ImageFont.FreeTypeFont]:\n    fonts = {\n        key: ImageFont.truetype(str(path), CONFIG.title_font_size)\n        for key, path in FONT_PATHS.items()\n    }\n    fonts[\"inter\"].set_variation_by_axes([700])\n    return fonts\n\n\ndef draw_slanted_mono_word(\n    overlay: Image.Image,\n    word: str,\n    font: ImageFont.FreeTypeFont,\n    x: float,\n) -> None:\n    width = font.getlength(word)\n    ascent, descent = font.getmetrics()\n    patch_width = int(width + 60)\n    patch_height = int(ascent + descent + 20)\n    patch = Image.new(\"RGBA\", (patch_width, patch_height), (0, 0, 0, 0))\n    patch_draw = ImageDraw.Draw(patch)\n    origin_x = 10\n    patch_draw.text(\n        (origin_x, ascent),\n        word,\n        font=font,\n        fill=(255, 255, 255),\n        stroke_width=CONFIG.stroke_width,\n        stroke_fill=(0, 0, 0),\n        anchor=\"ls\",\n    )\n    matrix = (\n        1,\n        CONFIG.mono_shear,\n        -CONFIG.mono_shear * ascent,\n        0,\n        1,\n        0,\n    )\n    slanted = patch.transform(\n        (patch_width, patch_height),\n        Image.Transform.AFFINE,\n        matrix,\n        resample=Image.Resampling.BICUBIC,\n    )\n    paste_position = (\n        int(x - origin_x),\n        int(CONFIG.title_baseline_y - ascent),\n    )\n    overlay.paste(slanted, paste_position, slanted)\n\n\ndef render_title_overlay(\n    variant: TitleVariant,\n    output_path: Path,\n) -> None:\n    fonts = load_fonts()\n    selected_fonts = [fonts[key] for key in variant.font_keys]\n    widths = [\n        font.getlength(word)\n        for word, font in zip(TITLE_WORDS, selected_fonts, strict=True)\n    ]\n    total_width = sum(widths) + CONFIG.title_space * (len(TITLE_WORDS) - 1)\n    current_x = (CONFIG.width - total_width) / 2\n\n    overlay = Image.new(\n        \"RGBA\",\n        (CONFIG.width, CONFIG.height),\n        (0, 0, 0, 0),\n    )\n    draw = ImageDraw.Draw(overlay)\n    draw.rectangle(\n        (0, CONFIG.title_clear_top, CONFIG.width, CONFIG.title_clear_bottom),\n        fill=(0, 0, 0, 255),\n    )\n\n    for word, font_key, font, width in zip(\n        TITLE_WORDS,\n        variant.font_keys,\n        selected_fonts,\n        widths,\n        strict=True,\n    ):\n        if font_key == \"mono\":\n            draw_slanted_mono_word(overlay, word, font, current_x)\n        else:\n            draw.text(\n                (current_x, CONFIG.title_baseline_y),\n                word,\n                font=font,\n                fill=(255, 255, 255),\n                stroke_width=CONFIG.stroke_width,\n                stroke_fill=(0, 0, 0),\n                anchor=\"ls\",\n            )\n        current_x += width + CONFIG.title_space\n\n    overlay.save(output_path)\n\n\ndef run_checked(command: list[str]) -> None:\n    result = subprocess.run(\n        command,\n        check=False,\n        stdout=subprocess.PIPE,\n        stderr=subprocess.PIPE,\n        text=True,\n    )\n    if result.returncode != 0:\n        error_tail = \"\\n\".join(result.stderr.splitlines()[-30:])\n        raise RuntimeError(f\"Command failed: {command[0]}\\n{error_tail}\")\n\n\ndef verify_video(output_path: Path) -> dict[str, object]:\n    result = subprocess.run(\n        [\n            \"ffprobe\",\n            \"-v\",\n            \"error\",\n            \"-show_entries\",\n            \"format=duration,size\",\n            \"-show_entries\",\n            \"stream=codec_type,codec_name,width,height,r_frame_rate\",\n            \"-of\",\n            \"json\",\n            str(output_path),\n        ],\n        check=True,\n        stdout=subprocess.PIPE,\n        text=True,\n    )\n    metadata = json.loads(result.stdout)\n    duration = float(metadata[\"format\"][\"duration\"])\n    video_streams = [\n        stream for stream in metadata[\"streams\"] if stream[\"codec_type\"] == \"video\"\n    ]\n    audio_streams = [\n        stream for stream in metadata[\"streams\"] if stream[\"codec_type\"] == \"audio\"\n    ]\n    if abs(duration - 18.0) > 0.05:\n        raise RuntimeError(f\"Unexpected duration for {output_path}: {duration}\")\n    if len(video_streams) != 1 or len(audio_streams) != 1:\n        raise RuntimeError(f\"Unexpected stream count for {output_path}\")\n    video_stream = video_streams[0]\n    if (\n        video_stream.get(\"width\") != CONFIG.width\n        or video_stream.get(\"height\") != CONFIG.height\n        or video_stream.get(\"r_frame_rate\") != \"60/1\"\n    ):\n        raise RuntimeError(f\"Unexpected video geometry for {output_path}: {video_stream}\")\n    return {\n        \"path\": str(output_path),\n        \"duration\": duration,\n        \"size\": int(metadata[\"format\"][\"size\"]),\n        \"video_codec\": video_stream[\"codec_name\"],\n        \"audio_codec\": audio_streams[0][\"codec_name\"],\n    }\n\n\ndef render_variant(\n    variant: TitleVariant,\n    overlay_path: Path,\n) -> dict[str, object]:\n    output_path = CONFIG.project_dir / variant.output_name\n    preview_path = CONFIG.preview_dir / variant.preview_name\n    run_checked(\n        [\n            \"ffmpeg\",\n            \"-y\",\n            \"-i\",\n            str(CONFIG.input_video),\n            \"-loop\",\n            \"1\",\n            \"-framerate\",\n            str(CONFIG.frame_rate),\n            \"-i\",\n            str(overlay_path),\n            \"-filter_complex\",\n            \"[0:v][1:v]overlay=0:0:eof_action=repeat:shortest=1[v]\",\n            \"-map\",\n            \"[v]\",\n            \"-map\",\n            \"0:a?\",\n            \"-c:v\",\n            \"h264_videotoolbox\",\n            \"-b:v\",\n            CONFIG.video_bitrate,\n            \"-maxrate\",\n            \"16M\",\n            \"-bufsize\",\n            \"24M\",\n            \"-pix_fmt\",\n            \"yuv420p\",\n            \"-tag:v\",\n            \"avc1\",\n            \"-c:a\",\n            \"copy\",\n            \"-movflags\",\n            \"+faststart\",\n            str(output_path),\n        ]\n    )\n    run_checked(\n        [\n            \"ffmpeg\",\n            \"-y\",\n            \"-ss\",\n            \"00:00:01\",\n            \"-i\",\n            str(output_path),\n            \"-frames:v\",\n            \"1\",\n            \"-q:v\",\n            \"2\",\n            str(preview_path),\n        ]\n    )\n    verification = verify_video(output_path)\n    verification[\"variant\"] = variant.name\n    verification[\"preview\"] = str(preview_path)\n    return verification\n\n\ndef main() -> None:\n    require_inputs()\n    CONFIG.preview_dir.mkdir(parents=True, exist_ok=True)\n    with tempfile.TemporaryDirectory(prefix=\"zenray-title-variants-\") as temporary_dir:\n        temporary_path = Path(temporary_dir)\n        overlay_paths: dict[str, Path] = {}\n        for variant in TITLE_VARIANTS:\n            overlay_path = temporary_path / f\"{variant.name}.png\"\n            render_title_overlay(variant, overlay_path)\n            overlay_paths[variant.name] = overlay_path\n\n        with ThreadPoolExecutor(max_workers=len(TITLE_VARIANTS)) as executor:\n            futures = [\n                executor.submit(render_variant, variant, overlay_paths[variant.name])\n                for variant in TITLE_VARIANTS\n            ]\n            results = [future.result() for future in futures]\n\n    print(json.dumps(results, indent=2))\n\n\nif __name__ == \"__main__\":\n    main()\n"}},"status":"completed","stdout":"Success. Updated the following files:\nA /Users/zenray/Downloads/tmp-3D-houdini/Scripts/RenderTitleVariants.py\n","stderr":""},"started_at_ms":1789384543948,"completed_at_ms":1789384543950}}
