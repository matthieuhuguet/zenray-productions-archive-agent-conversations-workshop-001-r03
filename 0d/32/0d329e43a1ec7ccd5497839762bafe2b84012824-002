le vit sous l'onglet « Contenu ». Le montage de\n35\t  // test ouvre donc successivement les deux onglets dont les tests ont besoin, au lieu de supposer\n36\t  // que tout est visible d'emblée. C'est une correction du HARNAIS, pas un contournement : le\n37\t  // produit affiche bien ces champs, à un clic d'onglet près.\n38\t  // Les thèmes vivent dans la PALETTE depuis le 2026-08-04 ; on y passe pour attendre le signal de\n39\t  // chargement, puis on revient aux composants, puis on ouvre le contenu de l'article.\n40\t  fireEvent.click(screen.getByRole('button', { name: 'Thèmes' }))\n41\t  await waitFor(() => expect(screen.getByRole('button', { name: /Lecture pure/ })).toBeTruthy())\n42\t  fireEvent.click(screen.getByRole('button', { name: 'Comp.' }))\n43\t  fireEvent.click(screen.getByRole('button', { name: 'Contenu' }))\n44\t  await waitFor(() => expect(screen.getByLabelText('Texte du bloc 1')).toBeTruthy())\n45\t  return utils\n46\t}\n47\t\n48\t// Rouvre l'onglet dont un test a besoin, sans supposer lequel est ouvert.\n49\tfunction onglet(nom) { fireEvent.click(screen.getByRole('button', { name: nom })) }\n50\t\n51\tdescribe('ZenRayMedia — interface', () => {\n52\t  it('s’ouvre sur le brief de démonstration, jamais sur un écran vide', async () => {\n53\t    await mount()\n54\t    expect(screen.getByLabelText('Titre de travail').value).toBe('Un brief, mille formes')\n55\t    expect(screen.getByLabelText('Message').value).toMatch(/goulot/)\n56\t    // L'article est monté automatiquement : ses blocs sont directement modifiables.\n57\t    await waitFor(() => expect(screen.getByLabelText('Texte du bloc 1')).toBeTruthy())\n58\t  })\n59\t\n60\t  it('affiche le catalogue de thèmes avec sa famille et le contrat de dépôt', async () => {\n61\t    await mount()\n62\t    fireEvent.click(screen.getByRole('button', { name: 'Thèmes' }))\n63\t    expect(screen.getByText('Presse & éditorial')).toBeTruthy()\n64\t    expect(screen.getByText(/T-01-3-2/)).toBeTruthy()\n65\t    // Le mode d'emploi d'ajout des futurs gabarits est visible dans le produit, pas seulement en doc.\n66\t    expect(screen.getByText(/T-FF-S-V--slug\\.html/)).toBeTruthy()\n67\t  })\n68\t\n69\t  it('refuse un message à deux phrases et le dit à l’endroit du champ', async () => {\n70\t    await mount()\n71\t    const message = screen.getByLabelText('Message')\n72\t    fireEvent.change(message, { target: { value: 'Première phrase. Seconde phrase.' } })\n73\t    await waitFor(() => expect(screen.getByText(/Le message doit tenir en UNE phrase/)).toBeTruthy())\n74\t  })\n75\t\n76\t  it('change de format en un clic et le Stage suit', async () => {\n77\t    await mount()\n78\t    const listeFormat = screen.getByLabelText('Format de sortie')\n79\t    fireEvent.change(listeFormat, { target: { value: 'F-still-1080x1920' } })\n80\t    await waitFor(() => expect(screen.getByText(/1080 × 1920/)).toBeTruthy())\n81\t    fireEvent.change(listeFormat, { target: { value: 'F-web-article' } })\n82\t    await waitFor(() => expect(screen.getByText(/820 × libre/)).toBeTruthy())\n83\t  })\n84\t\n85\t  it('le Critique rend un verdict et il est atteignable en un clic', async () => {\n86\t    await mount()\n87\t    fireEvent.click(screen.getByRole('button', { name: /^Critique/ }))\n88\t    await waitFor(() => expect(screen.getByText(/Publiable\\./)).toBeTruthy())\n89\t  })\n90\t\n91\t  it('l’article est modifiable en place : ajoute et retire un bloc sans changer d’onglet', async () => {\n92\t    await mount()\n93\t    const before = screen.getAllByRole('combobox').filter((el) => el.className.includes('zrm-beat-role')).length\n94\t    expect(before).toBeGreaterThan(0)\n95\t\n96\t    fireEvent.click(screen.getAllByRole('button', { name: '+' })[0])\n97\t    await waitFor(() => {\n98\t      const after = screen.getAllByRole('combobox').filter((el) => el.className.includes('zrm-beat-role')).length\n99\t      expect(after).toBe(before + 1)\n100\t    })\n101\t\n102\t    fireEvent.click(screen.getAllByRole('button', { name: 'Retirer' })[0])\n103\t    await waitFor(() => {\n104\t      const after = screen.getAllByRole('combobox').filter((el) => el.className.includes('zrm-beat-role')).length\n105\t      expect(after).toBe(before)\n106\t    })\n107\t  })\n108\t\n109\t  it('la Forge ne s’active que sur un format temporel, et donne la commande alpha exacte', async () => {\n110\t    await mount()\n111\t    fireEvent.click(screen.getByRole('button', { name: 'Forge' }))\n112\t    expect(screen.getByText(/La Forge s’active sur un format temporel/)).toBeTruthy()\n113\t\n114\t    fireEvent.change(screen.getByLabelText('Format de sortie'), { target: { value: 'F-overlay-1920x1080' } })\n115\t    await waitFor(() => expect(screen.getByText(/prores_ks/)).toBeTruthy())\n116\t    expect(screen.getByText(/yuva444p10le/)).toBeTruthy()\n117\t    // Le coût disque évité est affiché : c'est la justification du flux direct.\n118\t    expect(screen.getByText(/images à 30 i\\/s/)).toBeTruthy()\n119\t  })\n120\t\n121\t  it('la barre de commande ⌘K filtre et exécute une action réelle', async () => {\n122\t    await mount()\n123\t    const input = screen.getByPlaceholderText(/Rechercher une action/)\n124\t    fireEvent.change(input, { target: { value: 'sombre' } })\n125\t    const item = await screen.findByText('Rendu en sombre')\n126\t    fireEvent.click(item)\n127\t    await waitFor(() => expect(screen.getByTitle('Rendu en clair')).toBeTruthy())\n128\t  })\n129\t\n130\t  it('crée et supprime un brief sans jamais perdre le dernier', async () => {\n131\t    await mount()\n132\t    fireEvent.click(screen.getByRole('button', { name: 'Fichier' }))\n133\t    fireEvent.click(screen.getByRole('button', { name: /Nouveau document/ }))\n134\t    await waitFor(() => expect(screen.getByLabelText('Titre de travail').value).toBe('Nouveau brief'))\n135\t\n136\t    fireEvent.click(screen.getByRole('button', { name: 'Fichier' }))\n137\t    fireEvent.click(screen.getByRole('button', { name: /Supprimer le document/