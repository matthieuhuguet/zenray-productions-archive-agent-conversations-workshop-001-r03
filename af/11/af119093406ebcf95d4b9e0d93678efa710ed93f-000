text":"\"\"\"4:5 4K shorts compositor (2026-09-15 era). Single input, 10 cues x 3 s.\n\nVariant of render_short_4k_compositor.py (9:16, frozen history) for the 4:5\nformat ordered by Matthieu: 3072x3840 at 60 fps, 30.00 s exact. Same canon:\nSectra Bold Italic white title with black stroke and NO capsule, two-line\nsubtitles in line-by-line canon (line 2 at +0.67 s), punch curve, vivid\nyellow #f1f250. Kaomoji words route per character through the composite\nmono chain (AnthropicMono, EuphemiaCAS, Arial Unicode), coverage verified\n2026-09-15 by cmap probe: UCAS only in Euphemia, U+25BF only in Arial.\n\nFR : variante 4:5 du compositeur 9:16 (fichier d origine intouche, historique).\nRun with the shorts venv: ~/.venvs/shorts/bin/python <this file>\n\"\"\"\nimport os\nimport subprocess\n\nimport numpy as np\nfrom PIL import Image, ImageDraw, ImageFont\n\n\ndef frame_alpha(f, tint_rows, clean_rows, x0=216, x1=516):\n    \"\"\"Per-frame veil factor: median tinted sky over median clean sky.\"\"\"\n    t0, t1 = tint_rows\n    c0, c1 = clean_rows\n    tinted = np.median(f[t0:t1, x0:x1, :])\n    clean = np.median(f[c0:c1, x0:x1, :])\n    return float(np.clip(tinted / max(clean, 1.0), 0.5, 0.95))\n\n\ndef clean_chrome_bar(union_frame):\n    \"\"\"Classify the union frame, extract the state sub-crop, clean the veil.\n\n    EN: state A or B per frame, sub-crop shows the same scene rect in both\n    states (B viewport offset +(65,43) compensated), pure-multiply veil\n    undone with per-frame alpha, text cols repainted with the row sky\n    median. FR : sous-crop par etat (meme scene), voile inverse, texte\n    repeint. Returns (cleaned 2348x1298 frame, state letter).\n    \"\"\"\n    u = union_frame.astype(np.float32)\n    sr0, sr1 = STATE_ROWS\n    sc0, sc1 = STATE_COLS\n    sig = float(np.median(u[sr0:sr1, sc0:sc1, :]))\n    if sig > STATE_THRESH:\n        y0, y1, x0, x1 = A_SUB\n        f = u[y0:y1, x0:x1].copy()\n        alpha = frame_alpha(f, A_TINT, A_CLEAN)\n        b0, b1 = A_BAR\n        band = f[b0:b1]\n        band /= alpha\n        d0, _d1 = A_DIV\n        band[d0:d0 + 2] = (band[d0 - 1] + band[d0 + 2]) / 2.0\n        ref = np.median(band[:, sc0:sc1, :], axis=1, keepdims=True)\n        band[:, 0:A_GLYPH_X1, :] = ref\n        f[b1] = f[b1 + 1]\n        state = 'A'\n    else:\n        y0, y1, x0, x1 = B_SUB\n        f = u[y0:y1, x0:x1].copy()\n        bx0, bx1 = B_REF\n        alpha = frame_alpha(f, B_TINT, B_CLEAN, bx0, bx1)\n        b0, b1 = B_BAR\n        band = f[b0:b1]\n        band /= alpha\n        f[b1] = (f[b1 - 1] + f[b1 + 1]) / 2.0  # soften the AA ramp below\n        ref = np.median(band[:, bx0:bx1, :], axis=1, keepdims=True)\n        band[:, 0:B_GLYPH_X1, :] = ref\n        state = 'B'\n    np.clip(f, 0, 255, out=f)\n    return f.astype(np.uint8), state\n\nW, H = 3072, 3840\nFPS = 60\nTOTAL_FRAMES = 30 * FPS  # 1800 frames = 30.00 s exact\n\nSRC_MOV = '/Users/zenray/Downloads/tmp-3D-houdini/Shorts/2026-09-15 20-36-50.mov'\nOUT_DIR = '/Users/zenray/Downloads/tmp-3D-houdini/Shorts'\nOUT_MOV = os.path.join(OUT_DIR, '2026-09-15-churchyard-build-4x5-4k.mov')\nOUT_MP4 = os.path.join(OUT_DIR, '2026-09-15-churchyard-build-4x5-4k.mp4')\nTHUMB_DIR = os.path.join(OUT_DIR, 'thumbnails')\n\n# Letterbox 4:5 (2026-09-15, ordre Matthieu) : le plan garde son format\n# d origine, cale en largeur sur fond noir. Le viewport B est decale de\n# +(65,43) vs A (mesure par correlation : meme scene, zero saut). ffmpeg\n# sort l UNION des deux crops ; numpy selectionne le sous-crop de l etat,\n# donc les deux etats montrent EXACTEMENT les memes pixels scene.\n# La barre Rotate est un voile multiplicatif (alpha mesure par frame) : on\n# l inverse au lieu de couper, car le clocher passe derriere. Bandes noires\n# = titre dessus, sous-titres dessous, JAMAIS de contour/stroke/capsule.\nCROP = 'crop=2414:1342:112:488'\nCROP_W, CROP_H = 2414, 1342  # union frame from ffmpeg, EVEN dims (yuv420p\n# crop silently rounds odd widths down, shifting every row: 2413 broke this)\nassert CROP_W % 2 == 0 and CROP_H % 2 == 0, 'crop dims must stay even'\nSUB_W, SUB_H = 2348, 1298    # per-state scene crop, identical dims\nA_SUB = (0, 1298, 0, 2348)   # union rows/cols = source 488..1785 x112..2459\nB_SUB = (43, 1341, 65, 2413)  # = source 531..1828 x177..2524, same scene\nIMG_W, IMG_H, IMG_Y = 3072, 1698, 1071  # placed image geometry on the canvas\n# Chrome states (union coords = source -(112,488); B coords = source -(177,531)):\n# A = Rotate bar only, B = header + taller bar + viewport shifted +(65,43).\nSTATE_ROWS = (0, 20)     # signature rows (source 488..508: A veil ~74)\nSTATE_COLS = (216, 516)  # signature cols, always sky (source 328..628)\nSTATE_THRESH = 65.0     # A ~74, B ~58\nA_BAR = (0, 92)         # tinted rows (source 488..579)\nA_DIV = (86, 87)        # hidden divider (source 574..575)\nA_GLYPH_X1 = 148        # text union + margin (source ..260)\nA_TINT = (60, 80)       # alpha probe, tinted sky\nA_CLEAN = (100, 120)    # alpha probe, clean sky\nB_BAR = (0, 93)         # tinted rows (B-rel, source 531..623)\nB_GLYPH_X1 = 147        # text union + margin (source ..308)\nB_TINT = (9, 69)        # alpha probe, tinted sky (source 540..600)\nB_CLEAN = (99, 119)     # alpha probe, clean sky (source 630..650)\nB_REF = (171, 451)      # sky reference cols (source 348..628)\n\nfont_dir = os.path.expanduser('~/Library/Fonts')\nsys_font_dir = '/System/Library/Fonts/Supplemental'\np_sectra_bold_italic = os.path.join(font_dir, 'GT-Sectra-LCGV-Bold-Italic.otf')\np_inter = os.path.join(font_dir, 'InterTight-Italic-VariableFont_wght.ttf')\np_serif = os.path.join(font_dir, 'AnthropicSerif-SemiBoldItalic.ttf')\np_mono = os.path.join(font_dir, 'AnthropicMono-Bold.ttf')\np_euphemia = os.path.join(sys_font_dir, 'EuphemiaCAS.ttc')\np_arialuni = os.path.join(sys_font_dir, 'Arial Unicode.ttf')\n\nYELLOW = (0xF1, 0xF2, 0x50)\n\n# 1. Master Title (sectra-only, auto-fit, no capsule ever)\ntitle_text = 'Houdini'\ntitle_reference_font_size = 132\ntitle_reference_stroke_width = 8\ntitle_baseline_y = 1000\ntitle_safe_margin_x = 64\ntitle_safe_top = 620\ntitle_safe_bottom = 1065\ntitle_max_font_size = 400\nshear = 0.22\n\ntitle_layer = Image.new('RGBA', (W, H), (0, 0, 0, 0))\nt_draw = ImageDraw.Draw(title_layer)\n\nfor title_font_size in range(title_max_font_size, 9, -1):\n    title_stroke_width = 0  # letterbox : texte sur bande noire, jamais de contour\n    title_font = ImageFont.truetype(p_sectra_bold_italic, title_font_size)\n    title_bbox = t_draw.textbbox((0, title_baseline_y), title_text, font=title_font,\n                                 stroke_width=title_stroke_width, anchor='ls')\n    title_bbox_width = title_bbox[2] - title_bbox[0]\n    title_fits = (\n        title_bbox_width <= W - 2 * title_safe_margin_x\n        and title_bbox[1] >= title_safe_top\n        and title_bbox[3] <= title_safe_bottom\n    )\n    if title_fits:\n        title_tx = (W - title_bbox_width) / 2 - title_bbox[0]\n        break\nelse:\n    raise ValueError('Sectra title cannot fit inside the configured safe area')\nt_draw.text((title_tx, title_baseline_y), title_text, font=title_font,\n            fill=(255, 255, 255), stroke_width=title_stroke_width,\n            stroke_fill=(0, 0, 0), anchor='ls')\nprint('title size %d' % title_font_size, flush=True)\n\n# 2. Subtitles: 10 cues in 2 punchy lines, line-by-line canon animation\ncues_2lines = [\n    ['Today I continued modeling', 'new assets for the bayou.'],\n    ['I built the entrance arch,', 'then the fences around the field.'],\n    ['I had lost my grass assets,', 'but my site article saved me.'],\n    ['I rebuilt the whole grass system', 'from the article, step by step.'],\n    ['Then came the heightfield :', 'grass, fences and arch on it.'],\n    ['I placed the church I fully', 'remodeled, then set the camera.'],\n    ['I also pushed two wood layers', 'in Copernicus for the church.'],\n    ['One height layer must split', 'into many thin ones. Hard part.']