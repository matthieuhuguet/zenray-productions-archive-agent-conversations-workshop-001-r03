  face = faces[K_SPECIAL.get(ch, 'mono')]\n        total += face.getlength(ch)\n    return total\n\n\ndef render_line_card(line, font_size, cue_idx, line_idx):\n    import random\n    pool, faces = load_pool(font_size)\n    rng = random.Random(cue_idx * 1337 + 42 + line_idx * 99)\n    last_idx = -1\n\n    words = line.split(' ')\n    w_fonts = []\n    is_mono = []\n    is_kao = []\n    widths = []\n    for w in words:\n        if is_kaomoji_word(w):\n            w_fonts.append(None)\n            is_mono.append(False)\n            is_kao.append(True)\n            widths.append(kaomoji_width(w, faces))\n            continue\n        choices = [i for i in range(len(pool)) if i != last_idx]\n        last_idx = rng.choice(choices)\n        chosen_font = pool[last_idx]\n        w_fonts.append(chosen_font)\n        is_mono.append(chosen_font == pool[2])\n        is_kao.append(False)\n        widths.append(chosen_font.getlength(w))\n\n    total_w = sum(widths) + space_sub * (len(words) - 1)\n    im_w = int(total_w + 80)\n    im_h = int(font_size * 1.5 + 60)\n\n    im = Image.new('RGBA', (im_w, im_h), (0, 0, 0, 0))\n    d = ImageDraw.Draw(im)\n\n    cur_x = 40\n    base_y = int(font_size * 1.1 + 20)\n\n    for w, f, width, imono, kao in zip(words, w_fonts, widths, is_mono, is_kao):\n        if kao:\n            asc = max(faces[k].getmetrics()[0] for k in ('mono', 'euph', 'arial'))\n            x = cur_x\n            for ch in w:\n                face = faces[K_SPECIAL.get(ch, 'mono')]\n                a, _ = face.getmetrics()\n                d.text((x, base_y + (asc - a)), ch, font=face, fill=YELLOW,\n                       stroke_width=subtitle_stroke_width, stroke_fill=(0, 0, 0), anchor='ls')\n                x += face.getlength(ch)\n        elif imono:\n            asc, desc = f.getmetrics()\n            bw = int(width + 120)\n            bh = int(asc + desc + 60)\n            pp = Image.new('RGBA', (bw, bh), (0, 0, 0, 0))\n            pd = ImageDraw.Draw(pp)\n            mono_origin_x = 30\n            pd.text((mono_origin_x, asc), w, font=f, fill=YELLOW,\n                    stroke_width=subtitle_stroke_width, stroke_fill=(0, 0, 0), anchor='ls')\n            m = (1, shear, -shear * asc, 0, 1, 0)\n            sl = pp.transform((bw, bh), Image.AFFINE, m, resample=Image.BICUBIC)\n            im.paste(sl, (int(cur_x - mono_origin_x), int(base_y - asc)), sl)\n        else:\n            d.text((cur_x, base_y), w, font=f, fill=YELLOW,\n                   stroke_width=subtitle_stroke_width, stroke_fill=(0, 0, 0), anchor='ls')\n        cur_x += width + space_sub\n\n    return im, im_w, im_h\n\n\ndef measure_line(line, font_size, cue_idx, line_idx):\n    import random\n    pool, faces = load_pool(font_size)\n    rng = random.Random(cue_idx * 1337 + 42 + line_idx * 99)\n    last_idx = -1\n    total = 0.0\n    for w in line.split(' '):\n        if is_kaomoji_word(w):\n            total += kaomoji_width(w, faces)\n            continue\n        choices = [i for i in range(len(pool)) if i != last_idx]\n        last_idx = rng.choice(choices)\n        total += pool[last_idx].getlength(w)\n    return total + space_sub * (len(line.split(' ')) - 1)\n\n\n# Pre-render cues for canon line-by-line\nrendered_cues = []\nfor c_idx, cue in enumerate(cues_2lines):\n    best_size = 80\n    for test_size in range(124, 76, -1):\n        fits = True\n        for l_idx, line in enumerate(cue):\n            if measure_line(line, test_size, c_idx, l_idx) > MAX_W:\n                fits = False\n                break\n        if fits:\n            best_size = test_size\n            break\n\n    card_im1, card_w1, card_h1 = render_line_card(cue[0], best_size, c_idx, 0)\n    card_im2, card_w2, card_h2 = render_line_card(cue[1], best_size, c_idx, 1)\n\n    l1_frames = []\n    for s, a in punch_curve:\n        if a > 0.0:\n            sw = int(card_w1 * s)\n            sh = int(card_h1 * s)\n            res = card_im1.resize((sw, sh), Image.Resampling.BILINEAR)\n            if a < 1.0:\n                r, g, b, alpha_ch = res.split()\n                alpha_ch = alpha_ch.point(lambda p: int(p * a))\n                res = Image.merge('RGBA', (r, g, b, alpha_ch))\n            l1_frames.append((res, c1[0] - sw // 2, c1[1] - sh // 2))\n        else:\n            l1_frames.append(None)\n    l1_steady = (card_im1, c1[0] - card_w1 // 2, c1[1] - card_h1 // 2)\n\n    l2_frames = []\n    for s, a in punch_curve:\n        if a > 0.0:\n"},{"type":"input_text","text":"--- 3 ---"},{"type":"input_text","text":"---\nname: skill-sync\ndescription: Synchronize personal skills from Claude to Codex, Antigravity, and Memory. Claude is the single source of truth. Use automatically whenever creating or modifying a personal skill.\n---\n\n# Skill Sync\n\n**`~/.claude/skills/<name>` est la source de vérité, et elle seule s'édite.**\nJamais Codex, jamais Antigravity/Gemini, jamais ChatGPT, jamais la copie dans Memory. Cette direction a été\ninversée le 2026-08-15 sur décision de Matthieu ; auparavant `~/.codex/skills/`\nfaisait foi, et toute documentation qui l'affirme encore est périmée.\n\nAprès avoir créé ou modifié un skill :\n\n```zsh\n~/.claude/skills/skill-sync/scripts/sync-skill.sh <name>\n```\n\nLe script propage le skill vers deux copies écrites, puis un troisième environnement lit directement :\n\n- `~/.codex/skills/<name>` — copie écrite par `rsync -a --delete`\n- `Memory/Skills/<name>` — copie écrite par `rsync -a --delete`\n- Antigravity/Gemini — lit directement via le lien symbolique `~/.gemini/config/skills -> ~/.claude/skills` et `~/.gemini/config/skills.json` ; aucune copie n'est faite\n\nAprès la copie, le script affiche les empreintes SHA des trois `SKILL.md` (source + deux copies) pour prouver l'identité. Le lien symbolique Antigravity n'a pas de SHA séparé : il pointe sur la source, donc il est toujours à jour par construction.\n\nNe pas mentionner la synchronisation à Matthieu, sauf si elle échoue.\n\n## Ce que le script fait ensuite, tout seul\n\n**Il régénère l'index des skills** (`scripts/update-skill-index.py`) dans le bloc\ndélimité par les marqueurs `SKILL-INDEX:START` et `SKILL-INDEX:END` de\n`~/.claude/CLAUDE.md`. L'index se construit à partir du `description` de chaque\nfrontmatter, tronqué à 160 caractères. Ne jamais éditer ce bloc à la main :\ncréer, renommer ou supprimer le dossier dans `~/.claude/skills/`, puis relancer\nla synchronisation de n'importe quel skill, et l'index suit.\n\n**Il régénère `~/.codex/AGENTS.md` et `~/.gemini/config/AGENTS.md` / `GEMINI.md`** (`scripts/mirror-agents.sh`), copies\nintégrales de `~/.claude/CLAUDE.md` précédées d'un avertissement. AGENTS.md et GEMINI.md ne\ns'éditent donc jamais non plus. Ce miroir existe parce que les règles\navaient divergé d'une dizaine de bannières entre juin et août 2026, Codex\ntravaillant sur des règles périmées sans que rien ne le signale.\n\n## Un skill sans frontmatter sort mal dans l'index\n\nSans bloc `---` en tête portant `name` et `description`, le générateur retombe\nsur la première ligne de prose du fichier, ce qui donne des descriptions\nabsurdes. Cas réel : `ytb-dlp` s'annonçait par\n`<!-- MANPAGE: BEGIN EXCLUDED SECTION -->`. Tout skill doit porter son\nfrontmatter.\n#!/bin/zsh\n# Source de verite UNIQUE : ~/.claude/skills/<name>. Jamais Codex, jamais ChatGPT.\n# Codex et Memory sont des copies, ecrasees a chaque passage. Editer ailleurs\n# que dans ~/.claude/skills revient a perdre son travail au prochain sync.\nset -euo pipefail\n\nname=\"${1:?usage: sync-skill.sh <skill-name>}\"\ncase \"$name\" in\n  ''|*[!a-z0-9-]*) print -u2 'skill name must use lowercase letters, digits, and hyphens'; exit 2 ;;\nesac\n\nsource=\"$HOME/.claude/skills/$name\"\n[[ -f \"$source/SKILL.md\" ]] || { print -u2 \"missing canonical skill: $source\"; exit 1; }\n\n# Gemini / Antigravity lit via lien symbolique direct vers ~/.claude/skills\nmkdir -p \"$HOME/.gemini/config\"\nif [[ ! -L \"$HOME/.gemini/config/skills\" || \"$(readlink \"