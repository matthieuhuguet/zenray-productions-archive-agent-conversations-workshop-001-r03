t):\n    # InterVariable carries TWO axes, optical size then weight: set_variation_by_axes([weight])\n    # silently sets the FIRST axis (optical size) instead, and the glyphs stay Regular.\n    # The named instance is unambiguous and matches exactly what \"ExtraBold\" means.\n    # FR : passer un seul poids regle le premier axe (optical size), pas le poids ; le nom evite l erreur.\n    font = ImageFont.truetype(path, size)\n    try:\n        font.set_variation_by_name(WEIGHT_NAMES.get(weight, b'Regular'))\n    except Exception:\n        pass\n    return font\n\n\ndef fit_font(text, path, start_size, max_width, weight=None):\n    size = start_size\n    while size > 20:\n        font = (load_variable_font(path, size, weight) if weight else ImageFont.truetype(path, size))\n        box = font.getbbox(text)\n        if (box[2] - box[0]) <= max_width:\n            return font, box\n        size -= 2\n    font = (load_variable_font(path, size, weight) if weight else ImageFont.truetype(path, size))\n    return font, font.getbbox(text)\n\n\ndef make_text_sprite(text, font, color, pad=12):\n    \"\"\"A tight RGBA sprite, so scaling it later scales the glyphs around their own center.\"\"\"\n    box = font.getbbox(text)\n    width = box[2] - box[0] + pad * 2\n    height = box[3] - box[1] + pad * 2\n    sprite = Image.new('RGBA', (width, height), (0, 0, 0, 0))\n    draw = ImageDraw.Draw(sprite)\n    draw.text((pad - box[0], pad - box[1]), text, font=font, fill=color)\n    return sprite\n\n\ndef build_title_layer():\n    \"\"\"Two runs, two fonts, one baseline. \"Houdini\" is upright, the rest is italic: PIL has no\n    mixed-style text drawing, so the title is measured and placed as two separate runs that share\n    the SAME baseline, computed from each font's own ascent, not from the bounding box top.\"\"\"\n    # Grow the title to the largest size whose PILL still fits inside the canvas with a margin:\n    # the size is not guessed, it is measured against the real pill width at each step.\n    # FR : la taille se mesure contre la vraie largeur de pastille, jamais devinee.\n    max_pill_width = int(P['width'] * P['title_max_pill_width_ratio'])\n    size = P['title_size_start']\n    while size > 24:\n        font_up = ImageFont.truetype(P['title_font'], size)\n        font_it = ImageFont.truetype(P['title_font_italic'], size)\n        w_up = font_up.getlength(P['title_text_upright'])\n        w_it = font_it.getlength(P['title_text_italic'])\n        ascent_up, descent_up = font_up.getmetrics()\n        ascent_it, descent_it = font_it.getmetrics()\n        cap_h = max(ascent_up, ascent_it)          # used only to size the padding, as before\n        pad_x = int(cap_h * P['title_pad_x_ratio'])\n        pill_w = w_up + w_it + pad_x * 2\n        if pill_w <= max_pill_width:\n            break\n        size -= 2\n\n    ascent = max(ascent_up, ascent_it)\n    descent = max(descent_up, descent_it)\n    text_h = ascent + descent\n    pad_x = int(cap_h * P['title_pad_x_ratio'])\n    pad_y = int(cap_h * P['title_pad_y_ratio'])\n    text_w = w_up + w_it\n    pill_w, pill_h = text_w + pad_x * 2, text_h + pad_y * 2\n    radius = int(pill_h * P['title_radius_ratio'])\n\n    layer = Image.new('RGBA', (P['width'], P['height']), (0, 0, 0, 0))\n    draw = ImageDraw.Draw(layer)\n    x0 = (P['width'] - pill_w) // 2\n    y0 = P['title_y_center'] - pill_h // 2\n    draw.rounded_rectangle([x0, y0, x0 + pill_w, y0 + pill_h], radius=radius, fill=P['title_pill_bg'])\n\n    baseline_y = y0 + pad_y + ascent\n    draw.text((x0 + pad_x, baseline_y - ascent_up), P['title_text_upright'], font=font_up,\n              fill=P['title_text_color'])\n    draw.text((x0 + pad_x + w_up, baseline_y - ascent_it), P['title_text_italic'], font=font_it,\n              fill=P['title_text_color'])\n    return layer\n\n\ndef envelope(local_t):\n    keys = P['pop_keys']\n    if local_t <= keys[0][0]:\n        return keys[0][1], keys[0][2]\n    if local_t >= keys[-1][0]:\n        return keys[-1][1], keys[-1][2]\n    for (t0, s0, o0), (t1, s1, o1) in zip(keys, keys[1:]):\n        if t0 <= local_t <= t1:\n            f = (local_t - t0) / (t1 - t0)\n            return s0 + (s1 - s0) * f, o0 + (o1 - o0) * f\n    return keys[-1][1], keys[-1][2]\n\n\ndef paste_scaled(base, sprite, center_x, center_y, scale, opacity):\n    if opacity <= 0.0 or scale <= 0.0:\n        return\n    w, h = sprite.size\n    new_w, new_h = max(1, int(w * scale)), max(1, int(h * scale))\n    resized = sprite.resize((new_w, new_h), Image.LANCZOS)\n    if opacity < 1.0:\n        alpha = resized.getchannel('A').point(lambda a: int(a * opacity))\n        resized.putalpha(alpha)\n    base.alpha_composite(resized, (int(center_x - new_w / 2), int(center_y - new_h / 2)))\n\n\ndef main():\n    max_width = int(P['width'] * P['subtitle_max_width_ratio'])\n    sprites = []\n    for line1, line2 in CUES:\n        font1, _ = fit_font(line1, P['subtitle_font'], P['subtitle_size_start'], max_width, P['subtitle_weight'])\n        font2, _ = fit_font(line2, P['subtitle_font'], P['subtitle_size_start'], max_width, P['subtitle_weight'])\n        sprites.append((make_text_sprite(line1, font1, P['subtitle_color']),\n                        make_text_sprite(line2, font2, P['subtitle_color'])))\n\n    title_layer = build_title_layer()\n\n    total_frames = int(round(P['duration'] * P['fps']))\n    out = sys.stdout.buffer\n    for frame_index in range(total_frames):\n        t = frame_index / P['fps']\n        cue_index = min(int(t // P['cue_seconds']), len(CUES) - 1)\n        local_t = t - cue_index * P['cue_seconds']\n        sprite1, sprite2 = sprites[cue_index]\n\n        frame = title_layer.copy()\n        scale1, opacity1 = envelope(max(0.0, local_t - P['pop_line1_offset']))\n        scale2, opacity2 = envelope(max(0.0, local_t - P['pop_line2_offset']))\n        if local_t < P['pop_line2_offset']:\n            opacity2 = 0.0\n        paste_scaled(frame, sprite1, P['width'] / 2, P['line1_y'], scale1, opacity1)\n        paste_scaled(frame, sprite2, P['width'] / 2, P['line2_y'], scale2, opacity2)\n\n        out.write(frame.tobytes())\n    out.flush()\n\n\nif __name__ == '__main__':\n    # Updated 2026-09-14 00:25 CEST: 4K is the only output resolution.\n    main()\n#!/usr/bin/env python3\n\"\"\"Archive Houdini source dependencies and verify bytes without touching a scene.\"\"\"\n# 2026-09-12: Keep source files and every superseded archive byte recoverable.\nimport argparse\nimport hashlib\nimport json\nimport shutil\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nSKILL_ROOT = Path(__file__).resolve().parents[1]\nDEFAULT_SOURCE = Path('/Users/zenray/.claude/Memory1/Houdini')\nFOLDERS = ('MCP', 'Recipes', 'Scripts', 'Site', 'otls', 'Snapshots', 'Archives', 'Tests', 'Scenes')\nCOMPONENTS = ('Armature', 'WoodFacade', 'PorchStairs', 'WindowA', 'WindowB', 'Roof')\nEXCLUDED_SUFFIXES = ('.pyc', '.mp4', '.mov', '.avif')\n\n\ndef digest(path):\n    value = hashlib.sha256()\n    with path.open('rb') as stream:\n        for chunk in iter(lambda: stream.read(1024 * 1024), b''):\n            value.update(chunk)\n    return value.hexdigest()\n\n\ndef source_files(source):\n    return sorted(p for name in FOLDERS for p in (source / name).rglob('*')\n                  if p.is_file() and '__pycache__' not in p.parts\n                  and p.suffix.lower() not in EXCLUDED_SUFFIXES and p.name != '.DS_Store')\n\n\ndef preserve(path, archive):\n    checksum = digest(path)\n    target = archive / 'objects' / checksum[:2] / checksum\n    target.parent.mkdir(parents=True, exist_ok=True)\n    if target.exists():\n        if digest(target) != checksum:\n            raise ValueError('Corrupt archive object: ' + str(target))\n    else:\n        shutil.copy2(path, target)\n    return checksum\n\n\ndef archive(source, skill):\n    source = source.resolve()\n    for component in COMPONENTS:\n        required = source / 'otls' / ('Component_' + component + '.hda')\n        if not required.is_file():\n            raise FileNotFoundError(str(required))\n    base = skill / 'Library'\n    target_root = base / 'Houdini'\n    entries = []\n    files = source_files(source)\n    if not files:\n        raise ValueError('No source files found')\n    for path in files:\n        relative = path.relative_to(source)\n        target = target_root / relative\n        checksum = preserve(path, base)\n        if target.exists() and digest(target) != checksum:\n            preserve(target, base)\n        target.parent.mkdir(parents=True, exist_ok=True)\n        shutil.copy2(path, target)\n        if digest(target) != checksum or digest(path) != checksum:\n            raise ValueError('Source changed during copy: ' + str(path))\n        entries.append({'path': str(relative), 'sha256': checksum, 'bytes': target.stat().st_size})\n    # Preserve the conventional direct otls entrypoint as well as the full source tree.\n    aliases = []\n    for path in sorted((source / 'otls').glob('*.hda')):\n        target = skill / 'otls' / path.name\n        if target.exists():\n            preserve(target, base)\n        target.parent.mkdir(parents=True, exist_ok=True)\n        shutil.copy2(path, target)\n        aliases.append({'path': str(target.relative_to(skill)), 'sha256': digest(path)})\n    data = {'schema_version': 1, 'created_utc': datetime.now(timezone.utc).isoformat(),\n            'source_root': str(source), 'folders': list(FOLDERS),\n            'excluded_suffixes': list(EXCLUDED_SUFFIXES), 'files': entries,\n            'aliases': aliases, 'artistic_validation': False,\n            'meaning': 'Hash archive only; no claim of graph replay or visual approval.'}\n    manifests = base / 'manifests'\n    manifests.mkdir(parents=True, exist_ok=True)\n    stamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')\n    manifest = manifests / (stamp + '.json')\n    manifest.write_text(json.dumps(data, indent=2) + '\\n')\n    (base / 'latest.json').write_text(json.dumps({'manifest': str(manifest.relative_to(base))}, indent=2) + '\\n')\n    return verify(skill, source)\n\n\ndef verify(skill, source=None):\n    base = skill / 'Library'\n    pointer = json.loads((base / 'latest.json').read_text())\n    manifest = base / pointer['manifest']\n    data = json.loads(manifest.read_text())\n    failures = []\n    for entry in data['files']:\n        candidates = [('library', base / 'Houdini' / entry['path']),\n                      ('object', base / 'objects' / entry['sha256'][:2] / entry['sha256'])]\n        if source is not None:\n            candidates.append(('source', source / entry['path']))\n        for label, path in candidates:\n            if not path.is_file():\n                failures.append({'kind': 'missing_' + label, 'path': str(path)})\n            elif digest(path) != entry['sha256']:\n                failures.append({'kind': 'hash_mismatch_' + label, 'path': str(path)})\n    for entry in data['aliases']:\n        path = skill / entry['path']\n        if not path.is_file() or digest(path) != entry['sha256']:\n            failures.append({'kind': 'alias_missing_or_changed', 'path': str(path)})\n    if source is not None:\n        expected = {entry['path'] for entry in data['files']}\n        for path in source_files(source):\n            if str(path.relative_to(source)) not in expected:\n                failures.append({'kind': 'new_unarchived_source', 'path': str(path)})\n    return {'ok': not failures, 'manifest': str(manifest), 'files': len(data['files']),\n            'bytes': sum(entry['bytes'] for entry in data['files']),\n            'python_files': sum(entry['path'].endswith('.py') for entry in data['files']),\n            'hda_files': sum(entry['path'].endswith('.hda') for entry in data['files']),\n            'failures': failures, 'artistic_validation': False}\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument('mode', choices=('sync', 'check'))\n    parser.add_argument('--source', type=Path, default=DEFAULT_SOURCE)\n    parser.add_argument('--skill', type=Path, default=SKILL_ROOT)\n    parser.add_argument('--offline', action='store_true', help='Verify archive without reading the source tree')\n    parser.add_argument('--output', type=Path)\n    args = parser.parse_args()\n    try:\n        result = archive(args.source, args.skill) if args.mode == 'sync' else verify(args.skill, None if args.offline else args.source)\n    except Exception as error:\n        result = {'ok': False, 'error': str(error)}\n    output = json.dumps(result, indent=2)\n    if args.output:\n        args.output.parent.mkdir(parents=True, exist_ok=True)\n        args.output.write_text(output + '\\n')\n    print(output)\n    raise SystemExit(0 if result['ok'] else 1)\n\n\nif __name__ == '__main__':\n    main()\n","exit_code":0,"duration":{"secs":0,"nanos":2042},"formatted_output":"\"\"\"Render the animated subtitle and title overlay for a 30 second short, piped straight into ffmpeg.\n\nWHY A PIPE. 900 RGBA frames at 2160x3840 would mean writing and re-reading about 28 GB of PNGs. Streaming\nraw frames to ffmpeg's stdin, as a second input, skips that entirely: no intermediate files, no\ncompression overhead, one process reads what the other writes.\n\nFR : le pipe evite d ecrire puis relire des gigaoctets de PNG intermediaires.\n\"\"\"\nimport sys\nfrom PIL import Image, ImageDraw, ImageFont\n\n# -- PARAMETERS (HDA law: everything tunable lives here) -----------------------------------------\nP = {\n    'width': 2160,\n    'height': 3840,\n    'fps': 30,\n    'duration': 30.0,\n    # Corrected 2026-09-12, final pass: the title is MIXED. \"Houdini\" keeps sentence case (not\n    # HOUDINI) in AnthropicSerif SemiBold, upright. The rest, \"LOUISIANA BAYOU\", stays uppercase\n    # in AnthropicSerif SemiBold ITALIC. Matthieu: \"c'etait Houdini pas en caps ... pas italic\n    # mais le reste du titre est italic\".\n    # FR : \"Houdini\" en casse normale