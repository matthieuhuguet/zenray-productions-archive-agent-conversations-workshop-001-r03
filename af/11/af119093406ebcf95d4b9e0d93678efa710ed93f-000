nimport subprocess\n\nimport numpy as np\nfrom PIL import Image, ImageDraw, ImageFont\n\n\ndef frame_alpha(f, tint_rows, clean_rows, x0=216, x1=516):\n    \"\"\"Per-frame veil factor: median tinted sky over median clean sky.\"\"\"\n    t0, t1 = tint_rows\n    c0, c1 = clean_rows\n    tinted = np.median(f[t0:t1, x0:x1, :])\n    clean = np.median(f[c0:c1, x0:x1, :])\n    return float(np.clip(tinted / max(clean, 1.0), 0.5, 0.95))\n\n\ndef clean_chrome_bar(union_frame):\n    \"\"\"Classify the union frame, extract the state sub-crop, clean the veil.\n\n    EN: state A or B per frame, sub-crop shows the same scene rect in both\n    states (B viewport offset +(65,43) compensated), pure-multiply veil\n    undone with per-frame alpha, text cols repainted with the row sky\n    median. FR : sous-crop par etat (meme scene), voile inverse, texte\n    repeint. Returns (cleaned 2348x1298 frame, state letter).\n    \"\"\"\n    u = union_frame.astype(np.float32)\n    sr0, sr1 = STATE_ROWS\n    sc0, sc1 = STATE_COLS\n    sig = float(np.median(u[sr0:sr1, sc0:sc1, :]))\n    if sig > STATE_THRESH:\n        y0, y1, x0, x1 = A_SUB\n        f = u[y0:y1, x0:x1].copy()\n        alpha = frame_alpha(f, A_TINT, A_CLEAN)\n        b0, b1 = A_BAR\n        band = f[b0:b1]\n        band /= alpha\n        d0, _d1 = A_DIV\n        band[d0:d0 + 2] = (band[d0 - 1] + band[d0 + 2]) / 2.0\n        ref = np.median(band[:, sc0:sc1, :], axis=1, keepdims=True)\n        band[:, 0:A_GLYPH_X1, :] = ref\n        f[b1] = f[b1 + 1]\n        state = 'A'\n    else:\n        y0, y1, x0, x1 = B_SUB\n        f = u[y0:y1, x0:x1].copy()\n        bx0, bx1 = B_REF\n        alpha = frame_alpha(f, B_TINT, B_CLEAN, bx0, bx1)\n        b0, b1 = B_BAR\n        band = f[b0:b1]\n        band /= alpha\n        f[b1] = (f[b1 - 1] + f[b1 + 1]) / 2.0  # soften the AA ramp below\n        ref = np.median(band[:, bx0:bx1, :], axis=1, keepdims=True)\n        band[:, 0:B_GLYPH_X1, :] = ref\n        state = 'B'\n    np.clip(f, 0, 255, out=f)