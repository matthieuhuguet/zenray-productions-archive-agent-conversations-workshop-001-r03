{"parentUuid":"fd932945-b87a-4b1a-8817-b8a9c6024319","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/zenray/Downloads/tmp-graphic1/build.py","snippet":"1\t#!/usr/bin/env python3\n2\t\"\"\"Le cook du projet : instancie les HDA de hda/ depuis _params.json.\n3\t\n4\t    python3 build.py            # tout\n5\t    python3 build.py rows       # une seule famille (rows, text, logo, compose)\n6\t\n7\tSortie : assets/src/*.html (instances de gabarit) et assets/*.png (rendus),\n8\tpuis slide-1.html et slide-1-guides.html (les compositions).\n9\tAucune valeur de design ne vit ici : tout vient de _params.json.\n10\t\"\"\"\n11\timport json, math, re, subprocess, sys, glob, os\n12\tfrom concurrent.futures import ThreadPoolExecutor\n13\tfrom pathlib import Path\n14\tfrom PIL import Image\n15\t\n16\tROOT = Path(__file__).resolve().parent\n17\tP = json.loads((ROOT / \"_params.json\").read_text())\n18\t\n19\tCHROME = next(iter(sorted(glob.glob(os.path.expanduser(\n20\t    \"~/Library/Caches/ms-playwright/chromium-*/chrome-mac*/*.app/Contents/MacOS/*\")))), None)\n21\tif not CHROME:\n22\t    sys.exit(\"Chromium introuvable. Lancer : npx playwright install chromium\")\n23\t\n24\tFMT = P[\"canvas\"][\"formats\"][P[\"canvas\"][\"active\"]]\n25\tCW, CH = FMT[\"w\"], FMT[\"h\"]\n26\tSCALE = min(P[\"output\"][\"maxScale\"],\n27\t            max(1, math.ceil(P[\"output\"][\"targetLongEdge\"] / max(CW, CH))))\n28\t\n29\tTOK, FAM, INS = P[\"tokens\"], P[\"families\"], P[\"instances\"]\n30\tFONTDIR = TOK[\"font\"][\"dir\"]\n31\tSRC = ROOT / \"assets\" / \"src\"\n32\tOUT = ROOT / \"assets\"\n33\tSRC.mkdir(parents=True, exist_ok=True)\n34\t\n35\t\n36\t# ---------------------------------------------------------------- moteur HDA\n37\tdef cook(template: str, params: dict) -> str:\n38\t    \"\"\"Substitue {{cle}} par sa valeur et refuse tout parametre non resolu.\"\"\"\n39\t    html = (ROOT / \"hda\" / template).read_text()\n40\t    for k, v in params.items():\n41\t        html = html.replace(\"{{%s}}\" % k, str(v))\n42\t    leftover = set(re.findall(r\"\\{\\{(\\w+)\\}\\}\", html))\n43\t    if leftover:\n44\t        raise SystemExit(f\"{template} : parametres non fournis {sorted(leftover)}\")\n45\t    return html\n46\t\n47\t\n48\tdef font(key: str) -> str:\n49\t    return f\"{FONTDIR}/{TOK['font'][key]}\"\n50\t\n51\t\n52\tdef flag_glyph(code: str) -> str:\n53\t    \"\"\"Code ISO deux lettres vers la paire d'indicateurs regionaux.\"\"\"\n54\t    return \"\".join(chr(0x1F1E6 + ord(c) - ord(\"A\")) for c in code.upper())\n55\t\n56\t\n57\tdef shot(html_path: Path, png_path: Path, w: int, h: int) -> None:\n58\t    subprocess.run([CHROME, \"--headless=new\", \"--disable-gpu\", \"--hide-scrollbars\",\n59\t                    \"--default-background-color=00000000\",\n60\t                    f\"--force-device-scale-factor={SCALE}\",\n61\t                    f\"--window-size={w},{h}\",\n62\t                    f\"--screenshot={png_path}\", f\"file://{html_path}\"],\n63\t                   check=True, capture_output=True)\n64\t\n65\t\n66\tdef trim(png_path: Path) -> None:\n67\t    \"\"\"Rogne le transparent autour du contenu, pour un placement au glyphe.\"\"\"\n68\t    im = Image.open(png_path).convert(\"RGBA\")\n69\t    box = im.getbbox()\n70\t    if box:\n71\t        im.crop(box).save(png_path)\n72\t\n73\t\n74\tdef emit(name: str, template: str, params: dict, w: int, h: int, do_trim: bool):\n75\t    html_path = SRC / f\"{name}.html\"\n76\t    png_path = OUT / f\"{name}.png\"\n77\t    html_path.write_text(cook(template, params))\n78\t    shot(html_path, png_path, w, h)\n79\t    if do_trim:\n80\t        trim(png_path)\n81\t    return name\n82\t\n83\t\n84\t# ------------------------------------------------------------ famille : text\n85\tTEXT_BOX = (1000, 200)\n86\t\n87\t\n88\tdef build_text():\n89\t    f = FAM[\"textDisplay\"]\n90\t    jobs = []\n91\t    for name, key in [(\"03-title-l1\", \"titleL1\"), (\"04-title-l2\", \"titleL2\"),\n92\t                      (\"05-subtitle\", \"subtitle\"), (\"06-score-head\", \"scoreHeadL\"),\n93\t                      (\"07-source\", \"source\")]:\n94\t        i = INS[key]\n95\t        weight = i[\"weight\"]\n96\t        jobs.append((name, \"text.html\", {\n97\t            \"fontFile\": font(weight),\n98\t            \"boxW\": TEXT_BOX[0], \"boxH\": TEXT_BOX[1],\n99\t            \"justify\": \"flex-start\",\n100\t            \"size\": i[\"size\"],\n101\t            \"lineHeight\": f.get(\"lineHeight\", 1.05),\n102\t            \"tracking\": i.get(\"tracking\", f[\"tracking\"]),\n103\t            \"color\": TOK[\"color\"][i.get(\"color\", f[\"color\"])],\n104\t            \"fontStyle\": \"italic\" if weight == \"italic\" else \"normal\",\n105\t            \"text\": i[\"text\"],\n106\t        }, *TEXT_BOX, True))\n107\t    return jobs\n108\t\n109\t\n110\t# ------------------------------------------------------------ famille : logo\n111\tdef build_logo():\n112\t    f, i = FAM[\"logo\"], INS[\"logo\"]\n113\t    return [(\"02-logo\", \"logo.html\", {\n114\t        \"fontDisplay\": font(\"display\"), \"fontBody\": font(\"body\"),\n115\t        \"boxW\": 400, \"boxH\": 140,\n116\t        \"wordSize\": f[\"wordSize\"], \"subSize\": f[\"subSize\"],\n117\t        \"subGap\": f[\"subGap\"], \"dotSize\": f[\"dotSize\"], \"dotGap\": 5,\n118\t        \"dotColor\": f[\"dotColor\"], \"color\": TOK[\"color\"][\"white\"],\n119\t        \"word\": i[\"word\"], \"sub\": i[\"sub\"],\n120\t    }, 400, 140, True)]\n121\t\n122\t\n123\t# ------------------------------------------------------------ famille : rows\n124\tdef build_rows():\n125\t    f = FAM[\"rankRow\"]\n126\t    rowW = f[\"rankW\"] + f[\"rankGap\"] + f[\"barW\"]\n127\t    jobs = []\n128\t    for n, r in enumerate(INS[\"rows\"], start=1):\n129\t        v = r[\"variant\"]\n130\t        bar, sco = TOK[\"gradient\"][v], TOK[\"gradient\"][v + \"Score\"]\n131\t        slug = re.sub(r\"[^a-z0-9]+\", \"-\", r[\"country\"].lower())\n132\t        jobs.append((f\"{9+n}-row-{r['rank']:02d}-{slug}\", \"rank-row.html\", {\n133\t            \"fontDisplay\": font(\"display\"), \"fontStrong\": font(\"strong\"),\n134\t            \"fontEmoji\": TOK[\"font\"][\"emoji\"],\n135\t            \"rowW\": rowW, \"rankW\": f[\"rankW\"], \"rankGap\": f[\"rankGap\"],\n136\t            \"rankSize\": f[\"rankSize\"], \"rankInk\": TOK[\"color\"][\"rankInk\"],\n137\t            \"barW\": f[\"barW\"], \"barH\": f[\"barH\"], \"barPadL\": f[\"barPadL\"],\n138\t            \"barRadius\": TOK[\"radius\"][\"bar\"], \"chipRadius\": TOK[\"radius\"][\"chip\"],\n139\t            \"gradAngle\": TOK[\"gradient\"][\"$angle\"],\n140\t            \"barFrom\": bar[0], \"barTo\": bar[1],\n141\t            \"scoreFrom\": sco[0], \"scoreTo\": sco[1],\n142\t            \"flagW\": f[\"flagW\"], \"flagH\": f[\"flagH\"], \"flagGap\": f[\"flagGap\"],\n143\t            \"flagInset\": f[\"flagInset\"],\n144\t            \"flagGlyphSize\": round((f[\"flagW\"] - 2 * f[\"flagInset\"]) * 1.08),\n145\t            \"flagGlyphScale\": 1.0,\n146\t            \"flagGlyph\": flag_glyph(r[\"flag\"]),\n147\t            \"chipBg\": TOK[\"color\"][\"chip\"], \"chipEdge\": TOK[\"color\"][\"chipEdge\"],\n148\t            \"nameSize\": f[\"nameSize\"], \"nameInk\": TOK[\"color\"][\"white\"],\n149\t            \"scoreW\": f[\"scoreW\"], \"scoreSize\": f[\"scoreSize\"], \"scorePadL\": 12,\n150\t            \"scoreInk\": TOK[\"color\"][\"scoreInk\"],\n151\t            \"rank\": r[\"rank\"], \"country\": r[\"country\"], \"score\": r[\"score\"],\n152\t        }, rowW, f[\"barH\"], False))\n153\t    return jobs\n154\t\n155\t\n156\t# --------------------------------------------------------------- composition\n157\tdef png_w(name: str) -> float:\n158\t    return Image.open(OUT / f\"{name}.png\").size[0] / SCALE\n159\t\n160\t\n161\tdef compose(guides: bool):\n162\t    f = FAM[\"rankRow\"]\n163\t    rowW = f[\"rankW\"] + f[\"rankGap\"] + f[\"barW\"]\n164\t    layers = []\n165\t\n166\t    for s in INS[\"slots\"]:\n167\t        if s[\"src\"]:\n168\t            layers.append(f'<img class=\"slot\" style=\"left:{s[\"x\"]}px;top:{s[\"y\"]}px;'\n169\t                          f'width:{s[\"w\"]}px;height:{s[\"h\"]}px;z-index:{s[\"z\"]}\" '\n170\t                          f'src=\"{s[\"src\"]}\">')\n171\t        elif guides:\n172\t            layers.append(f'<div class=\"guide\" style=\"left:{s[\"x\"]}px;top:{s[\"y\"]}px;'\n173\t                          f'width:{s[\"w\"]}px;height:{s[\"h\"]}px;z-index:{s[\"z\"]}\">'\n174\t                          f'slot vide : {s[\"id\"]}</div>')\n175\t\n176\t    def place(name, x, y, anchor=\"left\"):\n177\t        left = x - png_w(name) if anchor == \"right\" else x\n178\t        layers.append(f'<img style=\"left:{left:.1f}px;top:{y}px;'\n179\t                      f'width:{png_w(name):.1f}px;z-index:20\" src=\"assets/{name}.png\">')\n180\t\n181\t    i = INS[\"logo\"]; place(\"02-logo\", i[\"x\"], i[\"y\"], i[\"anchor\"])\n182\t    for name, key in [(\"03-title-l1\", \"titleL1\"), (\"04-title-l2\", \"titleL2\"),\n183\t                      (\"05-subtitle\", \"subtitle\"), (\"07-source\", \"source\")]:\n\n... [54 lines truncated] ..."},"type":"attachment","uuid":"7ee33029-30f0-4cd4-bd8e-b30e202823dd","timestamp":"2026-08-15T11:52:45.102Z","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"311c2eba-91aa-44d6-93e9-d6d2e96bd19b","version":"2.1.229","gitBranch":"main"}
