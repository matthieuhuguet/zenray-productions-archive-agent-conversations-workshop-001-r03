.sm, padding: '9px 12px', fontFamily: FONTS.sans, fontSize: 14, outline: 'none' })\n   519\t\n   520\t  useEffect(() => { (async () => {\n   521\t    const j = await fetch(`/api/page?action=read&path=${PATH}`, { cache: 'no-store' }).then((r) => r.json()).catch(() => null)\n   522\t    if (j && j.markdown && !j.missing) { setSha(j.sha); try { setApps(JSON.parse(j.markdown).applications || []) } catch { setApps(FL_SEED) } }\n   523\t    else { setApps(FL_SEED); persist(FL_SEED, null) }\n   524\t  })() }, [])\n   525\t  async function persist(list, curSha) {\n   526\t    setStatus('…')\n   527\t    const j = await fetch('/api/page', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'save', path: PATH, markdown: JSON.stringify({ applications: list }, null, 1), sha: curSha === undefined ? sha : curSha }) }).then((r) => r.json()).catch(() => null)\n   528\t    if (j && j.ok) { setSha(j.sha); setStatus('enregistré ✓') } else setStatus('erreur')\n   529\t  }\n   530\t  const today = () => { const d = new Date(); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}` }\n   531\t  const add = () => { if (!form.company.trim()) return; const list = [{ id: 'a' + Date.now(), company: form.company.trim(), role: form.role.trim(), date: today(), status: 'Postulé', link: form.link.trim(), notes: '' }, ...apps]; setApps(list); setForm({ company: '', role: '', link: '' }); persist(list) }\n   532\t  const upd = (id, fields) => { const list = apps.map((a) => a.id === id ? { ...a, ...fields } : a); setApps(list); persist(list) }\n   533\t  const del = (id) => { if (!window.confirm('Supprimer cette candidature ?')) return; const list = apps.filter((a) => a.id !== id); setApps(list); persist(list) }\n   534\t\n   535\t  return (\n   536\t    <>\n   537\t      <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: 12, flexWrap: 'wrap' }}>\n   538\t        <SectionLabel t={t} color={t.textSecondary} nomargin>Freelance · candidatures <span style={{ fontFamily: FONTS.mono, fontSize: 10, opacity: 0.6 }}>· {apps ? apps.length : 0} · {status} · <a href={FREELANCE_URL} target=\"_blank\" rel=\"noreferrer\" style={{ color: t.textSecondary }}>ancien dashboard (deprecated) ↗</a></span></SectionLabel>\n   539\t        <ViewSwitch t={t} view={view} onChange={setView} options={['list', 'gallery', 'page']} />\n   540\t      </div>\n   541\t      <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', margin: '14px 0 18px' }}>\n   542\t        <input value={form.company} onChange={(e) => setForm({ ...form, company: e.target.value })} placeholder=\"Studio / entreprise\" style={inp(180)} />\n   543\t        <input value={form.role} onChange={(e) => setForm({ ...form, role: e.target.value })} placeholder=\"Poste\" style={inp(150)} />\n   544\t        <input value={form.link} onChange={(e) => setForm({ ...form, link: e.target.value })} placeholder=\"Lien de l'offre\" style={inp(200)} />\n   545\t        <button onClick={add} style={{ background: PALETTE.primary, color: '#fff', border: 'none', borderRadius: RADII.sm, padding: '9px 16px', cursor: 'pointer', fontFamily: FONTS.sans, fontSize: 14 }}>+ candidature</button>\n   546\t      </div>\n   547\t      {apps === null && <div style={{ color: t.textSecondary }}>chargement…</div>}\n   548\t      {apps && view !== 'list' && (\n   549\t        <DataView t={t} view={view} items={apps.map((a) => ({ id: a.id, title: a.company, subtitle: `${a.role || ''}${a.role && a.status ? ' · ' : ''}${a.status || ''}`, color: FL_COL[a.status] ? FL_COL[a.status] + '22' : undefined, badge: a.date, onOpen: () => setView('list') }))} />\n   550\t      )}\n   551\t      <div style={{ display: view === 'list' ? 'grid' : 'none', gap: 12 }}>\n   552\t        {apps && apps.map((a) => (\n   553\t          <div key={a.id} style={{ ...card(t), padding: '14px 16px' }}>\n   554\t            <div style={{ display: 'flex', alignItems: 'baseline', gap: 10, flexWrap: 'wrap' }}>\n   555\t              <span style={{ fontFamily: FONTS.serif, fontSize: 17, fontWeight: 600 }}>{a.company}</span>\n   556\t              <span style={{ color: t.textSecondary }}>{a.role}</span>\n   557\t              <span style={{ fontFamily: FONTS.mono, fontSize: 11, color: t.textSecondary }}>{a.date}</span>\n   558\t              {a.link && <a href={a.link} target=\"_blank\" rel=\"noreferrer\" style={{ color: PALETTE.primary, fontSize: 12 }}>offre ↗</a>}\n   559\t              <select value={a.status} onChange={(e) => upd(a.id, { status: e.target.value })} style={{ marginLeft: 'auto', border: `1px solid ${FL_COL[a.status] || t.border}`, color: FL_COL[a.status] || t.textPrimary, background: 'transparent', borderRadius: 99, padding: '3px 10px', fontFamily: FONTS.mono, fontSize: 11.5, fontWeight: 700, cursor: 'pointer' }}>\n   560\t                {FL_STATUSES.map((s) => <option key={s} value={s} style={{ color: '#000' }}>{s}</option>)}\n   561\t              </select>\n   562\t              <button onClick={() => del(a.id)} style={{ background: 'none', border: 'none', color: t.textSecondary, cursor: 'pointer', fontSize: 15 }}>×</button>\n   563\t            </div>\n   564\t            <textarea value={a.notes || ''} onChange={(e) => upd(a.id, { notes: e.target.value })} placeholder=\"notes…\" style={{ width: '100%', marginTop: 8, background: t.bg, color: t.textPrimary, border: `1px solid ${t.border}`, borderRadius: RADII.sm, padding: 8, fontFamily: FONTS.sans, fontSize: 13, minHeight: 46, resize: 'vertical', outline: 'none' }} />\n   565\t          </div>\n   566\t        ))}\n   567\t      </div>\n   568\t    </>\n   569\t  )\n   570\t}\n   571\t\n   572\t/* ───────── Pages (coeur type Notion, drive GitHub, navigation en arbre) ───────── */\n   573\tconst pgPretty = (n) => n.replace(/\\.md$/, '').replace(/-[a-z0-9]{1,4}$/, '').replace(/-/g, ' ')\n   574\t// Vignette Finder : lit la 1re image embarquée dans une page (markdown), sinon icône document. Cache module-level pour éviter de refetch.\n   575\tconst _thumbCache = {}\n   576\tfunction PageThumb({ path, size = 54, fallback }) {\n   577\t  const [url, setUrl] = useState(_thumbCache[path])\n   578\t  useEffect(() => {\n   579\t    if (_thumbCache[path] !== undefined) { setUrl(_thumbCache[path]); return }\n   580\t    let alive = true\n   581\t    fetch(`/api/page?action=read&path=${encodeURIComponent(path)}`, { cache: 'no-store' }).then((r) => r.json()).then((j) => {\n   582\t      let u = null\n   583\t      if (j && j.markdown) { const m = j.markdown.match(/!\\[[^\\]]*\\]\\(([^)\\s]+)\\)/) || j.markdown.match(/<img[^>]+src=[\"']([^\"']+)[\"']/); if (m) u = m[1] }\n   584\t      _thumbCache[path] = u; if (alive) setUrl(u)\n   585\t    }).catch(() => { _thumbCache[path] = null; if (alive) setUrl(null) })\n   586\t    return () => { alive = false }\n   587\t  }, [path])\n   588\t  if (url) return <img src={url} alt=\"\" loading=\"lazy\" style={{ width: size, height: size, objectFit: 'cover', borderRadius: 7, display: 'block', background: 'rgba(128,128,128,0.12)' }} />\n   589\t  return fallback\n   590\t}\n   591\t// buildTree est désormais importé de ./create/buildNodes.js (type-aware, sur-ensemble). Phase 1 OS.\n   592\t// pathDescend : la page ouverte est-elle ce nœud ou un de ses descendants ? (auto-expand des ancêtres)\n   593\tfunction nodeHasPath(node, target) {\n   594\t  if (!target) return false\n   595\t  if (node.contentPath === target) return true\n   596\t  return Object.values(node.children).some((c) => nodeHasPath(c, target))\n   597\t}\n   598\tfunction TreeItem({ node, depth, curPath, onOpen, t, prefix, onAddChild, onMovePage }) {\n   599\t  const kids = Object.keys(node.children).sort((a, b) => a.localeCompare(b))\n   600\t  const hasKids = kids.length > 0\n   601\t  const myPath = (prefix ? prefix + '/' : '') + node.name\n   602\t  const onPathInside = hasKids && nodeHasPath(node, curPath)\n   603\t  const [open, setOpen] = useState(onPathInside)\n   604\t  const [hover, setHover] = useState(false)\n   605\t  const [dragOver, setDragOver] = useState(false)\n   606\t  useEffect(() => { if (onPathInside) setOpen(true) }, [onPathInside])\n   607\t  const on = !!node.contentPath && curPath === node.contentPath\n   608\t  const handleName = () => { if (node.contentPath) onOpen(node.contentPath); else if (hasKids) setOpen((v) => !v) }\n   609\t  return (\n   610\t    <div>\n   611\t      <div className=\"zr-treeitem\" onMouseEnter={() => setHover(true)} onMouseLeave={() => setHover(false)}\n   612\t        onDragOver={(e) => { if (e.dataTransfer.types.includes('application/zenray-page')) { e.preventDefault(); setDragOver(true) } }}\n   613\t        onDragLeave={() => setDragOver(false)}\n   614\t        onDrop={(e) => { setDragOver(false); const d = e.dataTransfer.getData('application/zenray-page'); if (!d || !onMovePage) return; e.preventDefault(); e.stopPropagation(); try { const p = JSON.parse(d); setOpen(true); onMovePage(p.path, myPath) } catch {} }}\n   615\t        style={{ display: 'flex', alignItems: 'center', width: '100%', paddingLeft: 8 + depth * 12, paddingRight: 4, borderRadius: RADII.sm, background: dragOver ? PALETTE.primarySoft : (on ? PALETTE.primarySoft : 'transparent'), outline: dragOver ? `1px dashed ${PALETTE.primary}` : 'none' }}>\n   616\t        <span onClick={(e) => { e.stopPropagation(); if (hasKids) setOpen((v) => !v) }}\n   617\t          style={{ flex: '0 0 14px', width: 14, textAlign: 'center', cursor: hasKids ? 'pointer' : 'default', color: t.textSecondary, fontSize: 10, userSelect: 'none' }}>\n   618\t          {hasKids ? (open ? '▾' : '▸') : ''}\n   619\t        </span>\n   620\t        <button onClick={handleName} title={node.contentPath || node.name}\n   621\t          draggable={!!node.contentPath}\n   622\t          onDragStart={node.contentPath ? (e) => { e.dataTransfer.setData('application/zenray-page', JSON.stringify({ path: node.contentPath, name: node.name })); e.dataTransfer.effectAllowed = 'copy' } : undefined}\n   623\t          style={{ flex: 1, textAlign: 'left', padding: '5px 4px', background: 'transparent', border: 'none', cursor: 'pointer',\n   624\t            color: on ? PALETTE.primary : (node.contentPath ? t.textPrimary : t.textSecondary), fontFamily: FONTS.sans, fontSize: 13,\n   625\t            fontWeight: on ? 600 : (!node.contentPath && hasKids ? 600 : 400), whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>\n   626\t          {pgPretty(node.name)}{hasKids ? <span style={{ color: t.textSecondary, fontFamily: FONTS.mono, fontSize: 10, marginLeft: 6 }}>{kids.length}</span> : null}\n   627\t        </button>\n   628\t        <button onClick={(e) => { e.stopPropagation(); setOpen(true); onAddChild && onAddChild(myPath) }} title=\"Ajouter une sous-page\" className=\"zr-hover-action\"\n   629\t          style={{ flex: '0 0 auto', visibility: hover ? 'visible' : 'hidden', background: 'transparent', border: 'none', cursor: 'pointer', color: t.textSecondary, fontSize: 15, lineHeight: 1, padding: '0 4px' }}>+</button>\n   630\t      </div>\n   631\t      {open && hasKids && kids.map((k) => (\n   632\t        <TreeItem key={k} node={node.children[k]} depth={depth + 1} curPath={curPath} onOpen={onOpen} t={t} prefix={myPath} onAddChild={onAddChild} onMovePage={onMovePage} />\n   633\t      ))}\n   634\t    </div>\n   635\t  )\n   636\t}\n   637\tfunction TreeNode({ node, depth, curPath, onOpen, t, prefix, onAddChild, onMovePage }) {\n   638\t  return (\n   639\t    <>\n   640\t      {Object.keys(node.children).sort((a, b) => a.localeCompare(b)).map((k) => (\n   641\t        <TreeItem key={k} node={node.children[k]} depth={depth} curPath={curPath} onOpen={onOpen} t={t} prefix={prefix} onAddChild={onAddChild} onMovePage={onMovePage} />\n   642\t      ))}\n   643\t    </>\n   644\t  )\n   645\t}\n   646\t// Grille d'icônes VIRTUALISÉE (rendu fenêtré). Au-delà de ~200 tuiles, peindre tout le DOM rame :\n   647\t// ici on ne monte QUE les rangées visibles dans le conteneur scrollable + une marge (overscan).\n   648\t// Hauteur totale simulée par un conteneur vide, le bloc rendu est décalé en translateY.\n   649\tfunction VirtualIconGrid({ entries, zoom, scrollRef, renderTile }) {\n   650\t  const GAP = 4, ROW_H = 124, OVERSCAN = 3\n   651\t  const [width, setWidth] = useState(0)\n   652\t  const [scrollTop, setScrollTop] = useState(0)\n   653\t  const [viewH, setViewH] = useState(800)\n   654\t  useEffect(() => {\n   655\t    const el = scrollRef.current\n   656\t    if (!el) return\n   657\t    const onScroll = () => setScrollTop(el.scrollTop)\n   658\t    const measure = () => { setWidth(el.clientWidth - 32); setViewH(el.clientHeight) } // -32 = padding 16 gauche+droite\n   659\t    measure()\n   660\t    el.addEventListener('scroll', onScroll, { passive: true })\n   661\t    const ro = typeof ResizeObserver !== 'undefined' ? new ResizeObserver(measure) : null\n   662\t    if (ro) ro.observe(el)\n   663\t    window.addEventListener('resize', measure)\n   664\t    return () => { el.removeEventListener('scroll', onScroll); if (ro) ro.disconnect(); window.removeEventListener('resize', measure) }\n   665\t  }, [scrollRef])\n   666\t  const cols = Math.max(1, Math.floor((width + GAP) / (zoom + GAP))) || 1\n   667\t  const totalRows = Math.ceil(entries.length / cols)\n   668\t  const totalH = totalRows * ROW_H\n   669\t  const firstRow = Math.max(0, Math.floor(scrollTop / ROW_H) - OVERSCAN)\n   670\t  const lastRow = Math.min(totalRows, Math.ceil((scrollTop + viewH) / ROW_H) + OVERSCAN)\n   671\t  const slice = entries.slice(firstRow * cols, lastRow * cols)\n   672\t  return (\n   673\t    <div style={{ position: 'relative', height: totalH }}>\n   674\t      <div style={{ position: 'absolute', top: firstRow * ROW_H, left: 0, right: 0, display: 'grid', gridTemplateColumns: `repeat(${cols}, minmax(0, 1fr))`, gap: GAP }}>\n   6