)\n\ntest('posts: edit a draft, reschedule with null to unschedule, a published post is frozen, delete does not unpublish, unpublish works where the platform allows', async () => {\n  const h = await makeApp()\n  const { profile, account } = await seed(h)\n  const d = (await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'v1', accountIds: [account.id] } })).data\n  assert.equal(d.status, 'draft')\n  const u = (await h.call('PATCH', `/v1/posts/${d.id}`, { body: { content: 'v2', scheduledFor: '2026-12-01T10:00:00Z' } })).data\n  assert.equal(u.content, 'v2'); assert.equal(u.status, 'scheduled')\n  assert.equal((await h.call('PATCH', `/v1/posts/${d.id}`, { body: { scheduledFor: null } })).data.status, 'draft')\n  await h.call('POST', `/v1/posts/${d.id}/publish`); await h.ctx.background.drain()\n  assert.equal((await h.call('GET', `/v1/posts/${d.id}`)).data.status, 'published')\n  assert.equal((await h.call('PATCH', `/v1/posts/${d.id}`, { body: { content: 'v3' } })).status, 409, 'published posts are frozen')\n  const un = (await h.call('POST', `/v1/posts/${d.id}/unpublish`)).data\n  assert.equal(un.results[0].unpublished, true)\n  assert.equal((await h.ctx.store.get('sandboxWorld', account.id)).posts.length, 0, 'taken off the platform')\n  const keep = (await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'k', accountIds: [account.id], publishNow: true } })).data\n  await h.call('DELETE', `/v1/posts/${keep.id}`)\n  assert.equal((await h.ctx.store.get('sandboxWorld', account.id)).posts.length, 1, 'deleting on PostKit leaves what is live, live')\n  assert.equal((await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'x', accountIds: [account.id], scheduledFor: '2020-01-01T00:00:00Z' } })).status, 400, 'a past schedule is refused')\n  assert.equal((await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'x', accountIds: [account.id], platforms: [{ accountId: account.id }] } })).status, 4