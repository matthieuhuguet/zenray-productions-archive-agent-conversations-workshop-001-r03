{"parentUuid":"090a833e-73bc-4444-92e9-978e775bebdc","isSidechain":false,"message":{"model":"claude-sonnet-5-5","id":"msg_011Cff4PM3EgqWBFeYPssfj6","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01SpVrXUbVGKR4mahqf3SwVu","name":"Bash","input":{"command":"R=/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayPostKit; cd $R\ncat > test/connectors.test.js <<'EOF'\n// 3 October 2026 : Request-shape tests for every network connector against a recording fake API. They prove the code follows the documented\n// call sequences and parameter names; they do NOT prove the live platforms accept them (verification level stays \"mock\").\nimport { test } from 'node:test'\nimport assert from 'node:assert/strict'\nimport { createHmac } from 'node:crypto'\nimport { makeApp, seed } from './helpers.js'\nimport { CONFIG } from '../src/config.js'\n\nconst FAST = { ...CONFIG, polling: { attempts: 3, intervalMs: 0 } }\nconst json = (data, status = 200, headers = {}) => new Response(JSON.stringify(data), { status, headers: { 'content-type': 'application/json', ...headers } })\n\n// routes: [ [predicate(url, init) -> bool, responder(url, init) -> Response] ]\nfunction fakeApi(routes) {\n  const calls = []\n  const fetchImpl = async (url, init = {}) => {\n    const u = String(url); calls.push({ url: u, method: init.method || 'GET', body: init.body, headers: init.headers || {} })\n    for (const [match, respond] of routes) if (match(u, init)) return typeof respond === 'function' ? respond(u, init) : respond\n    return json({ error: { message: `unmocked ${init.method || 'GET'} ${u}` } }, 404)\n  }\n  return { fetchImpl, calls, find: (re, method) => calls.find((c) => re.test(c.url) && (!method || c.method === method)), all: (re) => calls.filter((c) => re.test(c.url)) }\n}\nconst has = (re, method) => (u, init) => re.test(u) && (!method || (init.method || 'GET') === method)\nconst form = (c) => Object.fromEntries(new URLSearchParams(c.body))\n\nasync function connect(h, platform, extra = {}, metadata = {}) {\n  const { profile } = await seed(h)\n  const acc = (await h.call('POST', '/v1/accounts/connect', { body: { platform, profileId: profile.id, externalId: extra.externalId || 'ext1', username: extra.username || `${platform}user`, accessToken: 'TOK', metadata } })).data\n  return { profile, acc }\n}\n\ntest('Instagram: image publish is container then media_publish then permalink; story has no caption and no URL; carousel and reel poll the container', async () => {\n  const api = fakeApi([\n    [has(/graph\\.instagram\\.com\\/v21\\.0\\/ext1\\/media$/, 'POST'), () => json({ id: `c${Math.random().toString(16).slice(2, 6)}` })],\n    [has(/\\/media_publish$/, 'POST'), json({ id: 'M1' })],\n    [has(/\\/M1\\?/), json({ permalink: 'https://www.instagram.com/p/AAA/' })],\n    [has(/\\/c[0-9a-f]+\\?fields=status_code/), json({ status_code: 'FINISHED' })],\n  ])\n  const h = await makeApp({ fetchImpl: api.fetchImpl, config: FAST })\n  const { profile, acc } = await connect(h, 'instagram')\n  const img = (await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'Launch', accountIds: [acc.id], mediaItems: [{ url: 'https://cdn/a.jpg', altText: 'alt' }], publishNow: true } })).data\n  assert.equal(img.status, 'published', JSON.stringify(img.targets[0].error)); assert.equal(img.targets[0].platformPostUrl, 'https://www.instagram.com/p/AAA/')\n  const create = form(api.find(/ext1\\/media$/, 'POST'))\n  assert.equal(create.image_url, 'https://cdn/a.jpg'); assert.equal(create.caption, 'Launch'); assert.equal(create.alt_text, 'alt'); assert.equal(create.access_token, 'TOK')\n  const story = (await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: '', accountIds: [acc.id], asStory: true, mediaItems: [{ url: 'https://cdn/s.jpg' }], publishNow: true } })).data\n  assert.equal(story.status, 'published'); assert.equal(story.targets[0].platformPostUrl, null, 'a story has no permanent URL')\n  assert.equal(form(api.all(/ext1\\/media$/).at(-1)).media_type, 'STORIES'); assert.equal(form(api.all(/ext1\\/media$/).at(-1)).caption, undefined)\n  assert.equal((await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: '', accountIds: [acc.id], asStory: true, mediaItems: [{ url: 'https://cdn/s.png' }] } })).status, 400, 'PNG story refused')\n  const reel = (await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'reel', accountIds: [acc.id], mediaItems: [{ url: 'https://cdn/r.mp4' }], trialReel: true, publishNow: true } })).data\n  assert.equal(reel.status, 'published')\n  const r = form(api.all(/ext1\\/media$/).at(-1)); assert.equal(r.media_type, 'REELS'); assert.equal(r.share_to_feed, 'true'); assert.equal(JSON.parse(r.trial_params).graduation_strategy, 'MANUAL')\n  const car = (await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'two', accountIds: [acc.id], mediaItems: [{ url: 'https://cdn/1.jpg' }, { url: 'https://cdn/2.jpg' }], publishNow: true } })).data\n  assert.equal(car.status, 'published')\n  const parent = form(api.all(/ext1\\/media$/).at(-1)); assert.equal(parent.media_type, 'CAROUSEL'); assert.equal(parent.children.split(',').length, 2)\n})\n\ntest('Instagram: comments, hide, private reply (one JSON call), DM with a button template, insights mapped with saved to saves and impressions null', async () => {\n  const api = fakeApi([\n    [has(/ext1\\/media\\?/), json({ data: [{ id: 'P1' }] })],\n    [has(/\\/P1\\/comments/), json({ data: [{ id: 'C1', text: 'GUIDE please', username: 'tom', timestamp: '2026-10-03T11:00:00Z', hidden: false }] })],\n    [has(/\\/C1\\/replies$/, 'POST'), json({ id: 'R1' })],\n    [has(/\\/C1$/, 'POST'), json({ success: true })],\n    [has(/ext1\\/messages/, 'POST'), json({ message_id: 'MID' })],\n    [has(/\\/P1\\/insights/), json({ data: [{ name: 'views', values: [{ value: 100 }] }, { name: 'reach', values: [{ value: 80 }] }, { name: 'likes', values: [{ value: 9 }] }, { name: 'comments', values: [{ value: 2 }] }, { name: 'shares', values: [{ value: 1 }] }, { name: 'saved', values: [{ value: 4 }] }] })],\n  ])\n  const h = await makeApp({ fetchImpl: api.fetchImpl, config: FAST })\n  const { acc } = await connect(h, 'instagram')\n  const a = (await h.call('POST', '/v1/comment-automations', { body: { accountId: acc.id, name: 'Guide', keywords: ['guide'], dmText: 'Here', dmButtonLabel: 'Get', dmButtonUrl: 'https://example.com/g' } })).data\n  assert.equal((await h.call('POST', '/v1/engagement/sync', { body: {} })).data.fetched, 1)\n  const dm = JSON.parse(api.find(/ext1\\/messages/, 'POST').body)\n  assert.deepEqual(dm.recipient, { comment_id: 'C1' }); assert.equal(dm.message.attachment.payload.template_type, 'button'); assert.equal(dm.message.attachment.payload.buttons[0].url, 'https://example.com/g')\n  assert.equal((await h.call('GET', `/v1/comment-automations/${a.id}`)).data.counters.sent, 1)\n  const eng = (await h.call('GET', '/v1/engagement')).data.engagements[0]\n  await h.call('POST', `/v1/engagement/${eng.id}/reply`, { body: { message: 'thanks' } })\n  assert.equal(form(api.find(/\\/C1\\/replies$/, 'POST')).message, 'thanks')\n  await h.call('POST', `/v1/engagement/${eng.id}/hide`, { body: { hidden: true } })\n  assert.equal(form(api.all(/\\/C1$/).find((c) => c.method === 'POST')).hide, 'true')\n  const m = await (await import('../src/platforms/registry.js')).createRegistry({ http: { request: async (u) => { const r = await api.fetchImpl(u); const t = await r.text(); return { ok: r.ok, status: r.status, data: JSON.parse(t), headers: r.headers } } }, config: FAST, store: h.ctx.store, clock: h.clock }).then((r) => r.get('instagram').getPostMetrics({ secret: { accessToken: 'TOK' }, platformPostId: 'P1' }))\n  assert.deepEqual(m, { views: 100, reach: 80, likes: 9, comments: 2, shares: 1, saves: 4, impressions: null, clicks: null })\n})\n\ntest('Instagram: inbound webhook is accepted only with a valid X-Hub-Signature-256, then lands in the inbox; a story reply enrols', async () => {\n  const h = await makeApp({ env: { POSTKIT_INSTAGRAM_CLIENT_SECRET: 'appsecret', POSTKIT_META_VERIFY_TOKEN: 'vt' } })\n  const { acc } = await connect(h, 'instagram')\n  const payload = JSON.stringify({ entry: [{ id: 'ext1', messaging: [{ sender: { id: 'u9' }, timestamp: Date.now(), message: { mid: 'm.1', text: 'hello' } }] }] })\n  const sig = `sha256=${createHmac('sha256', 'appsecret').update(payload).digest('hex')}`\n  assert.equal((await h.call('POST', '/v1/inbound/instagram', { token: null, body: payload, headers: { 'x-hub-signature-256': 'sha256=bad' } })).status, 401)\n  const ok = await h.call('POST', '/v1/inbound/instagram', { token: null, body: payload, headers: { 'x-hub-signature-256': sig } })\n  assert.equal(ok.status, 200); assert.equal(ok.data.handled, 1)\n  assert.equal((await h.call('GET', '/v1/inbox/conversations')).data.conversations[0].contactHandle, 'u9')\n  const verify = await h.call('GET', '/v1/inbound/instagram?hub.mode=subscribe&hub.verify_token=vt&hub.challenge=abc123', { token: null })\n  assert.equal(verify.data, 'abc123')\n  assert.equal((await h.call('GET', '/v1/inbound/instagram?hub.mode=subscribe&hub.verify_token=wrong&hub.challenge=x', { token: null })).status, 400)\n  void acc\n})\n\ntest('Facebook: one authorization yields one account per Page; feed, photo and comment calls use the Page id and token', async () => {\n  const api = fakeApi([\n    [has(/oauth\\/access_token\\?.*code=/), json({ access_token: 'SHORT' })],\n    [has(/oauth\\/access_token\\?.*fb_exchange_token/), json({ access_token: 'LONG' })],\n    [has(/me\\/accounts/), json({ data: [{ id: 'PG1', name: 'Page One', access_token: 'PT1' }, { id: 'PG2', name: 'Page Two', access_token: 'PT2' }] })],\n    [has(/PG1\\/feed$/, 'POST'), json({ id: 'PG1_100' })],\n    [has(/PG1\\/photos$/, 'POST'), json({ id: 'PH1', post_id: 'PG1_200' })],\n    [has(/PG1_100\\/comments$/, 'POST'), json({ id: 'RC1' })],\n  ])\n  const h = await makeApp({ fetchImpl: api.fetchImpl, env: { POSTKIT_FACEBOOK_CLIENT_ID: 'cid', POSTKIT_FACEBOOK_CLIENT_SECRET: 'sec' } })\n  const { profile } = await seed(h)\n  const { authUrl } = (await h.call('GET', `/v1/connect/facebook?profileId=${profile.id}`)).data\n  assert.match(authUrl, /pages_manage_metadata/)\n  const cb = await h.call('GET', `/v1/connect/facebook/callback?code=C&state=${new URL(authUrl).searchParams.get('state')}`, { token: null })\n  assert.equal(cb.data.accounts.length, 2)\n  const pg1 = cb.data.accounts.find((a) => a.externalId === 'PG1')\n  const text = (await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'We shipped', accountIds: [pg1.id], publishNow: true } })).data\n  assert.equal(text.status, 'published'); assert.equal(text.targets[0].platformPostUrl, 'https://www.facebook.com/PG1_100')\n  assert.equal(form(api.find(/PG1\\/feed$/, 'POST')).access_token, 'PT1', 'the Page token, not the user token')\n  const photo = (await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'pic', accountIds: [pg1.id], mediaItems: [{ url: 'https://cdn/p.jpg' }], publishNow: true } })).data\n  assert.equal(photo.targets[0].platformPostId, 'PG1_200')\n  assert.equal(form(api.find(/PG1\\/photos$/, 'POST')).caption, 'pic')\n})\n\ntest('Threads: two-step publish; 500-byte limit refuses at creation; stories, drafts and privacy levels are refused; allowComment false means mentioned_only', async () => {\n  const api = fakeApi([\n    [has(/ext1\\/threads$/, 'POST'), json({ id: 'CT1' })],\n    [has(/CT1\\?fields=status/), json({ status: 'FINISHED' })],\n    [has(/ext1\\/threads_publish$/, 'POST'), json({ id: 'T1' })],\n    [has(/\\/T1\\?fields=permalink/), json({ permalink: 'https://www.threads.net/@u/post/T1' })],\n  ])\n  const h = await makeApp({ fetchImpl: api.fetchImpl, config: FAST })\n  const { profile, acc } = await connect(h, 'threads')\n  const ok = (await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'hello threads', accountIds: [acc.id], allowComment: false, publishNow: true } })).data\n  assert.equal(ok.status, 'published'); assert.equal(ok.targets[0].platformPostUrl, 'https://www.threads.net/@u/post/T1')\n  const c = form(api.find(/ext1\\/threads$/, 'POST')); assert.equal(c.media_type, 'TEXT'); assert.equal(c.reply_control, 'mentioned_only')\n  assert.equal((await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'é'.repeat(300), accountIds: [acc.id] } })).status, 400, '300 chars of é are 600 bytes')\n  for (const opt of [{ asStory: true }, { asDraft: true }, { privacy: 'private' }]) assert.equal((await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'x', accountIds: [acc.id], mediaItems: [{ url: 'https://cdn/a.jpg' }], ...opt } })).status, 400)\n  assert.equal((await h.call('POST', '/v1/accounts/connect', { body: { platform: 'threads', profileId: profile.id, externalId: 'x', username: 'x' } })).status, 201)\n  assert.equal(h.ctx.connectors.get('threads').capabilities.messaging, false, 'no messaging on Threads')\n})\n\ntest('Telegram: token validated with getMe, channel publish for text and photo, inline-keyboard button with URL fallback', async () => {\n  let failKeyboard = false\n  const api = fakeApi([\n    [has(/botBAD\\/getMe/), json({ ok: false, description: 'Unauthorized' }, 401)],\n    [has(/botTOK\\/getMe/), json({ ok: true, result: { id: 777, username: 'zr_bot', first_name: 'ZR' } })],\n    [has(/botTOK\\/sendMessage/), (u, init) => (failKeyboard && JSON.parse(init.body).reply_markup ? json({ ok: false }, 400) : json({ ok: true, result: { message_id: 55 } }))],\n    [has(/botTOK\\/sendPhoto/), json({ ok: true, result: { message_id: 56 } })],\n  ])\n  const h = await makeApp({ fetchImpl: api.fetchImpl })\n  const { profile } = await seed(h)\n  assert.equal((await h.call('POST', '/v1/connect/telegram', { body: { profileId: profile.id, botToken: 'BAD' } })).status, 502, 'a bad token is refused before anything is stored')\n  assert.equal((await h.ctx.store.all('accounts')).filter((a) => a.platform === 'telegram').length, 0)\n  const acc = (await h.call('POST', '/v1/connect/telegram', { body: { profileId: profile.id, botToken: 'TOK', channelId: '@zenray' } })).data\n  assert.equal(acc.username, 'zr_bot')\n  const t = (await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'Hello channel', accountIds: [acc.id], publishNow: true } })).data\n  assert.equal(t.targets[0].platformPostUrl, 'https://t.me/zenray/55')\n  assert.deepEqual(JSON.parse(api.find(/sendMessage/).body), { chat_id: '@zenray', text: 'Hello channel' })\n  const p = (await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'caption', accountIds: [acc.id], mediaItems: [{ url: 'https://cdn/p.jpg' }], publishNow: true } })).data\n  assert.equal(p.targets[0].platformPostId, '56'); assert.equal(JSON.parse(api.find(/sendPhoto/).body).caption, 'caption')\n  const { ingestInbound } = await import('../src/domain/inbox.js')\n  const conv = (await ingestInbound(h.ctx, acc.id, { contactHandle: '4242', text: 'hi' })).conversation\n  await h.call('POST', `/v1/inbox/conversations/${conv.id}/messages`, { body: { text: 'link', buttonLabel: 'Open', buttonUrl: 'https://example.com' } })\n  assert.equal(JSON.parse(api.all(/sendMessage/).at(-1).body).reply_markup.inline_keyboard[0][0].url, 'https://example.com')\n  failKeyboard = true\n  await h.call('POST', `/v1/inbox/conversations/${conv.id}/messages`, { body: { text: 'link2', buttonLabel: 'Open', buttonUrl: 'https://example.com' } })\n  assert.match(JSON.parse(api.all(/sendMessage/).at(-1).body).text, /link2\\nhttps:\\/\\/example\\.com/, 'where the platform refuses the button, the URL is appended, not lost')\n})\n\ntest('X: publishing is metered (0.015, 0.20 with a URL) and the cost header says so; analytics stay off until consent and obey the cap; token refresh is persisted', async () => {\n  let tweetN = 0\n  const api = fakeApi([\n    [has(/api\\.x\\.com\\/2\\/tweets$/, 'POST'), () => json({ data: { id: `T${++tweetN}` } })],\n    [has(/api\\.x\\.com\\/2\\/oauth2\\/token/), json({ access_token: 'NEW', refresh_token: 'R2', expires_in: 7200 })],\n    [has(/api\\.x\\.com\\/2\\/tweets\\/T1\\?/), json({ data: { id: 'T1', public_metrics: { like_count: 5, reply_count: 1, retweet_count: 2, impression_count: 300 } } })],\n    [has(/api\\.x\\.com\\/2\\/users\\/me\\?user\\.fields=public_metrics/), json({ data: { public_metrics: { followers_count: 10, following_count: 3, tweet_count: 40 } } })],\n  ])\n  const h = await makeApp({ fetchImpl: api.fetchImpl, env: { POSTKIT_X_CLIENT_ID: 'cid', POSTKIT_X_CLIENT_SECRET: 'sec' } })\n  const { profile, acc } = await connect(h, 'x')\n  const plain = await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'plain tweet', accountIds: [acc.id], publishNow: true } })\n  assert.equal(plain.data.status, 'published'); assert.equal(plain.headers.get('x-postkit-cost-usd'), '0.015')\n  const link = await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'with link https://example.com', accountIds: [acc.id], publishNow: true } })\n  assert.equal(link.headers.get('x-postkit-cost-usd'), '0.2', 'a post containing a URL costs 0.20')\n  assert.equal((await h.call('GET', '/v1/usage')).data.total_usd, 0.215)\n  assert.equal((await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'x'.repeat(281), accountIds: [acc.id] } })).status, 400, '280 character limit')\n  const off = await h.app.tick()\n  assert.equal(off.analytics.find((a) => a.accountId === acc.id).skipped.length > 0, true, 'no polling before consent')\n  await h.call('PATCH', `/v1/accounts/${acc.id}/x-billing`, { body: { analytics: true, acknowledgeCost: true } })\n  await h.app.tick()\n  const sum = (await h.call('GET', '/v1/analytics/summary')).data\n  assert.equal(sum.metrics.likes.value, 5); assert.equal(sum.metrics.impressions.value, 300); assert.equal(sum.met