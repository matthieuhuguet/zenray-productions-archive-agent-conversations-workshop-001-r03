h keeps conversations and history. (3 October 2026)\nexport async function upsertAccount(ctx, { profileId, platform, externalId, username, displayName, avatarUrl, secret, tokenExpiresAt, metadata }) {\n  await owned(ctx, 'profiles', profileId, 'Profile')\n  const existing = (await listOwned(ctx, 'accounts', (a) => a.platform === platform && a.externalId === externalId))[0]\n  if (!existing || existing.status !== 'CONNECTED') await assertAccountQuota(ctx)\n  const t = ctx.clock.now().toISOString()\n  const doc = existing\n    ? stamp(ctx, { ...existing, profileId, username, displayName: displayName ?? existing.displayName, avatarUrl: avatarUrl ?? existing.avatarUrl, status: 'CONNECTED', isActive: true, needsReconnection: false, disconnectedReason: null, disconnectedAt: null, tokenExpiresAt: tokenExpiresAt ?? null, metadata: { ...existing.metadata, ...(metadata || {}) } })\n    : stamp(ctx, { _id: newId(PREFIX.account), workspaceId: ctx.actor.workspaceId, profileId, platform, externalId, username, displayName: displayName || username, avatarUrl: avatarUrl || null, status: 'CONNECTED', isActive: true, needsReconnection: false, disconnectedReason: null, connectedAt: t, tokenExpiresAt: tokenExpiresAt ?? null, metadata: metadata || {}, settings: {}, billing: {} }, { isNew: true })\n  await ctx.store.put('accounts', doc)\n  if (secret) await putSecret(ctx, doc._id, secret)\n  return accountView(ctx, doc)\n}\n\n// POST /accounts/connect: attach an account from credentials you already hold. (3 October 2026)\nexport async function connectManual(ctx, dto) {\n  if (!ctx.connectors.has(dto.platform)) throw badRequest(`Unknown platform ${dto.platform}.`)\n  const secret = dto.accessToken || dto.metadata ? { accessToken: dto.accessToken, ...(dto.metadata || {}) } : null\n  return upsertAccount(ctx, { profileId: dto.profileId, platform: dto.platform, externalId: dto.externalId, username: dto.username, displayName: dto.displayName, secret, metadata: dto.metadata })\n}\n\nexport async function disconnectAccount(ctx, id, reason = 'disconnected by user') {\n  const a = await owned(ctx, 'accounts', id, 'Account')\n  a.status = 'DISCONNECTED'; a.isActive = false; a.disconnectedReason = reason; a.disconnectedAt = ctx.clock.now().toISOString()\n  await ctx.store.put('accounts', stamp(ctx, a))\n  await wipeSecret(ctx, id) // posts and conversations are kept, the token is gone\n  await emit(ctx, 'account.disconnected', accountView(ctx, a))\n  return { success: true }\n}\n\nexport async function markNeedsReconnection(ctx, a, reason) {\n  a.needsReconnection = true; a.disconnectedReason = reason\n  await ctx.store.put('accounts', stamp(ctx, a))\n  await emit(ctx, 'account.disconnected', accountView(ctx, a), a.workspaceId)\n}\n\nexport async function deleteAccountPermanently(ctx, id) {\n  const a = await owned(ctx, 'accounts', id, 'Account')\n  if (a.status !== 'DISCONNECTED') throw conflict('Only a disconnected account can be deleted permanently.')\n  for (const col of ['posts']) for (const p of await listOwned(ctx, col)) { const targets = p.targets.filter((t) => t.accountId !== id); if (targets.length !== p.targets.length) await ctx.store.put(col, { ...p, targets }) }\n  for (const col of ['conversations', 'engagements']) for (const d of await listOwned(ctx, col, (x) => x.accountId === id)) await ctx.store.del(col, d._id)\n  await ctx.store.del('accounts', id)\n  return { success: true }\n}\n\n// Fold a duplicate account into this one: everything attached moves over, then the duplicate is deleted. (3 October 2026)\nexport async function replaceAccount(ctx, keepId, { accountId: dropId }) {\n  const keep = await owned(ctx, 'accounts', keepId, 'Account')\n  const drop = await owned(ctx, 'accounts', dropId, 'Account')\n  if (keep._id === drop._id) throw badRequest('Cannot replace an account with itself.')\n  if (keep.platform !== drop.platform) throw badRequest('Both accounts must be on the same platform.')\n  for (const p of await listOwned(ctx, 'posts')) 