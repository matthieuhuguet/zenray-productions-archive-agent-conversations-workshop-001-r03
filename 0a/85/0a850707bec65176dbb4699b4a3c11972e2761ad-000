t`)).status, 409)\n  assert.equal((await h.call('POST', `/v1/accounts/${account.id}/replace`, { body: { accountId: dup.id } })).status, 200)\n  assert.equal((await h.call('GET', `/v1/accounts/${dup.id}`)).status, 404, 'the duplicate is gone')\n  assert.equal((await h.call('GET', '/v1/posts')).data.posts[0].targets[0].accountId, account.id, 'its posts moved onto the kept account')\n  await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'second', accountIds: [account.id], publishNow: true } })\n  assert.equal((await h.call('DELETE', `/v1/accounts/${account.id}`)).status, 200)\n  const gone = (await h.call('GET', `/v1/accounts/${account.id}`)).data\n  assert.equal(gone.status, 'DISCONNECTED'); assert.equal(gone.isActive, false)\n  assert.equal(await h.ctx.store.get('secrets', account.id), null, 'token wiped')\n  assert.equal((await h.call('GET', '/v1/posts')).data.posts.length, 2, 'posts kept')\n  assert.equal((await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'x', accountIds: [account.id] } })).status, 400, 'cannot target a disconnected account')\n  await h.app.tick()\n  assert.equal((await h.call('GET', `/v1/webhooks/${wh.id}/deliveries`)).data.deliveries.length, 1)\n  assert.equal((await h.call('DELETE', `/v1/accounts/${account.id}/permanent`)).status, 200)\n})\n\ntest('profile delete cascades to accounts, posts, conversations; another workspace cannot see anything', async () => {\n  const h = await makeApp()\n  const { profile, account } = await seed(h)\n  const { ingestInbound } = await import('../src/domain/inbox.js')\n  await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'p', accountIds: [account.id], publishNow: true } })\n  await ingestInbound(h.ctx, account.id, { contactHandle: 'x', text: 'hi' })\n  const other = await makeApp()\n  await h.ctx.store.put('workspaces', { _id: 'ws_other', name: 'Other', ownerEmail: 'o@o', plan: 'PRO', settings: {} })\n  const { createApiKey } = await import('../src/domain/apikeys.js'); const { asActor, ownerActor } = await import('../src/context.js')\n  const otherKey = (await createApiKey(asActor(h.ctx, ownerActor(h.ctx, 'ws_other')), { name: 'o' })).key\n  assert.equal((await h.call('GET', `/v1/profiles/${profile.id}`, { token: otherKey })).status, 404, '404, never 403')\n  assert.equal((await h.call('GET', `/v1/posts`, { token: otherKey })).data.posts.length, 0)\n  assert.equal((await h.call('DELETE', `/v1/profiles/${profile.id}`)).status, 200)\n  assert.equal((await h.call('GET', '/v1/accounts')).data.accounts.length, 0); assert.equal((await h.call('GET', '/v1/posts')).data.posts.length, 0); assert.equal((await h.call('GET', '/v1/inbox/conversations')).data.conversations.length, 0)\n  void other\n})\n\ntest('workspaces and members: the owner is listed, an invite needs a valid email, the owner cannot be removed', async () => {\n  const h = await makeApp()\n  assert.equal((await h.call('GET', '/v1/workspaces')).data.workspaces[0].id, 'ws_default')\n  assert.equal((await h.call('POST', '/v1/workspaces/members', { body: { email: 'not-an-email' } })).status, 400)\n  const m = (await h.call('POST', '/v1/workspaces/members', { body: { email: 'Guest@Example.com' } })).data\n  assert.equal(m.email, 'guest@example.com')\n  assert.deepEqual((await h.call('GET', '/v1/workspaces/members')).data.members.map((x) => x.role), ['owner', 'member'])\n  assert.equal((await h.call('DELETE', '/v1/workspaces/members/owner')).status, 403)\n  assert.equal((await h.call('DELETE', `/v1/workspaces/members/${m.id}`)).status, 200)\n})\n\ntest('playbooks: install creates normal objects, a second install is refused unless forced, remove deletes what it created or keeps it', async () => {\n  const h = await makeApp()\n  const { account } = await seed(h)\n  assert.equal((await h.call('GET', '/v1/playbooks')).data.playbooks.length, 4)\n  assert.equal((await h.call('POST', '/v1/playbooks/waitlist/install', { body: { accounts: {} } })).status, 400, 'e