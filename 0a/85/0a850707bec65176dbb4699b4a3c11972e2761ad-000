tatus !== 'ready') throw badRequest(`Media ${id} has not finished uploading.`); out.push({ type: m.type, url: m.url, altText: null, thumbnail: null, mediaId: id }) }\n    return out\n  }\n  if (dto.mediaUrls?.length) return dto.mediaUrls.map((url) => ({ type: inferType(url), url, altText: null, thumbnail: null, mediaId: null }))\n  return []\n}\n\nasync function buildTargets(ctx, profileId, dto, { requireConnected = true } = {}) {\n  const hasIds = Array.isArray(dto.accountIds) && dto.accountIds.length\n  const hasPlatforms = Array.isArray(dto.platforms) && dto.platforms.length\n  if (hasIds === hasPlatforms) throw badRequest('Provide exactly one of accountIds or platforms.')\n  const wanted = hasIds ? dto.accountIds.map((accountId) => ({ accountId })) : dto.platforms\n  const seen = new Set()\n  const targets = []\n  for (const w of wanted) {\n    if (seen.has(w.accountId)) throw badRequest(`Account ${w.accountId} is listed twice.`)\n    seen.add(w.accountId)\n    const account = await owned(ctx, 'accounts', w.accountId, 'Account')\n    if (account.profileId !== profileId) throw badRequest(`Account ${w.accountId} does not belong to profile ${profileId}.`)\n    if (requireConnected && account.status !== 'CONNECTED') throw badRequest(`Account ${account.username} (${account.platform}) is disconnected.`)\n    targets.push({ _id: newId(PREFIX.target), accountId: account._id, platform: account.platform, status: 'pending', customContent: w.customContent ?? null, customMedia: w.customMedia ? w.customMedia.map((m) => ({ type: m.type || inferType(m.url), url: m.url, altText: m.altText || null, thumbnail: m.thumbnail || null })) : null, platformPostId: null, platformPostUrl: null, error: null, attempts: 0, publishedAt: null })\n  }\n  return targets\n}\n\n// Static rules: everything we can refuse at creation time instead of at publish time. (3 October 2026)\nasync function validatePost(ctx, post) {\n  const isStory = !!post.options.asStory\n  if (isStory && post.options.trial