ages and Videos APIs (Microsoft Learn, versioned 202609).\n// Publishes on the member's profile with scope w_member_social. Reading posts, comments and analytics needs r_member_social, a restricted\n// permission, so those capabilities are off and the dashboard says so. Verification level: mock (spec read 3 October 2026, no live call yet).\nimport { defineConnector } from '../base.js'\nimport { ApiError, badRequest } from '../../lib/errors.js'\nimport { mustOk } from '../../lib/http.js'\n\nconst PART = 4 * 1024 * 1024 // video parts are 4 MiB (byte ranges 0-4194303, 4194304-8388607, ...)\nconst urnPath = (urn) => encodeURIComponent(urn)\n\nexport function createLinkedinConnector({ http, config }) {\n  const api = config.apis\n  const hdr = (secret, extra = {}) => ({ authorization: `Bearer ${secret.accessToken}`, 'linkedin-version': api.linkedinVersion, 'x-restli-protocol-version': '2.0.0', ...extra })\n\n  async function initUpload(kind, secret, owner, extra = {}) {\n    const r = mustOk(await http.request(`${api.linkedinBase}/rest/${kind}?action=initializeUpload`, { method: 'POST', headers: hdr(secret), json: { initializeUploadRequest: { owner, ...extra } } }), `LinkedIn ${kind} upload init`)\n    return r.data.value\n  }\n\n  async function uploadImage(secret, owner, item, fetchMedia) {\n    const { bytes } = await fetchMedia(item)\n    const v = await initUpload('images', secret, owner)\n    mustOk(await http.request(v.uploadUrl, { method: 'PUT', headers: { authorization: `Bearer ${secret.accessToken}`, 'content-type': 'application/octet-stream' }, body: bytes, expect: 'text' }), 'LinkedIn image upload')\n    return { id: v.image, altText: item.altText || undefined }\n  }\n\n  async function uploadVideo(secret, owner, item, fetchMedia) {\n    const { bytes } = await fetchMedia(item)\n    const v = await initUpload('videos', secret, owner, { fileSizeBytes: bytes.length, uploadCaptions: false, uploadThumbnail: false })\n    const etags = []\n    for (const part of v.uploadInstructions) {\n      const r = mustOk(await http.request(part.uploadUrl, { method: 'PUT', headers: { 'content-type': 'application/octet-stream' }, body: bytes.subarray(part.firstByte, part.lastByte + 1), expect: 'text' }), 'LinkedIn video part upload')\n      etags.push(String(r.headers.get('etag') || '').replace(/^\"|\"$/g, '')) // the ETag of each part is its id in the finalize call\n    }\n    mustOk(await http.request(`${api.linkedinBase}/rest/videos?action=finalizeUpload`, { method: 'POST', headers: hdr(secret), json: { finalizeUploadRequest: { video: v.video, uploadToken: v.uploadToken || '', uploadedPartIds: etags } } }), 'LinkedIn video finalize')\n    return { id: v.video }\n  }\n\n  return defineConnector({\n    platform: 'linkedin', label: 'LinkedIn', verification: 'mock', auth: 'oauth',\n    requiredEnv: ['POSTKIT_LINKEDIN_CLIENT_ID', 'POSTKIT_LINKEDIN_CLIENT_SECRET'],\n    note: 'Publishes to the member profile (w_member_social). Reading posts, comments and analytics needs the restricted r_member_social permission, so they are off. Access tokens last 60 days: reconnect before expiry.',\n    capabilities: { publish: true, unpublish: true },\n    rules: { text: 'optional', maxChars: 3000, media: { min: 0, max: 20, types: ['image', 'video'] } },\n\n    validatePost(post, target) {\n      const media = target.customMedia ?? post.mediaItems\n      const text = (target.customContent ?? post.content ?? '').trim()\n      if (!text && !media.length) throw badRequest('LinkedIn needs text or media.')\n      const videos = media.filter((m) => m.type === 'video').length\n      if (videos && media.length > 1) throw badRequest('LinkedIn takes text only, or 1 to 20 images, or ONE video: they cannot be mixed.')\n    },\n\n    authorizeUrl({ state, redirectUri, creds }) {\n      const u = new URL('https://www.linkedin.com/oauth/v2/authorization')\n      u.search = new URLSearchParams({ response_type: 'code', client_id: creds.clientId, redirect_uri: redirectUri, state, scope: 'openid profile w_member_social' }).toString()\n      return u.toString()\n    },\n\n    async exchangeCode({ code, redirectUri, creds, now }) {\n      const t = mustOk(await http.request('https://www.linkedin.com/oauth/v2/accessToken', { method: 'POST', form: { grant_type: 'authorization_code', code, client_id: creds.clientId, client_secret: creds.clientSecret, redirect_uri: redirectUri } }), 'LinkedIn token exchange').data\n      const me = mustOk(await http.request(`${api.linkedinBase}/v2/userinfo`, { headers: { authorization: `Bearer ${t.access_token}` } }), 'LinkedIn userinfo').data\n      const expiresAt = new Date(now.getTime() + (t.expires_in || 5_184_000) * 1000).toISOString() // 60 days\n      return { accounts: [{ externalId: me.sub, username: me.name || me.sub, displayName: me.name || me.sub, avatarUrl: me.picture || null, secret: { accessToken: t.access_token, refreshToken: t.refresh_token || null, expiresAt }, tokenExpiresAt: expiresAt, metadata: { urn: `urn:li:person:${me.sub}` } }] }\n    },\n\n    async publish({ account, secret, post, target, media, fetchMedia, now }) {\n      if (secret?.expiresAt && new Date(secret.expiresAt) <= now) throw new ApiError(401, 'token_expired', 'The LinkedIn access token has expired (they last 60 days). Reconnect the account.')\n      const author = account.metadata.urn\n      const body = { author, commentary: (target.customContent ?? post.content ?? '').trim(), visibility: 'PUBLIC', distribution: { feedDistribution: 'MAIN_FEED', targetEntities: [], thirdPartyDistributionChannels: [] }, lifecycleState: 'PUBLISHED', isReshareDisabledByAuthor: false }\n      const video = media.find((m) => m.type === 'video')\n      if (video) {\n        const v = await uploadVideo(secret, author, video, fetchMedia)\n        body.content = { media: { title: (post.title || body.commentary.split('\\n')[0] || 'Video').slice(0, 200), id: v.id } }\n      } else if (media.length) {\n        const imgs = []\n        for (const