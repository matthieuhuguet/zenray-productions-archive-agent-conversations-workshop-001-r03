n visibleTools(actor) { return TOOLS.filter((t) => !t.write || actor.scopes.includes('write')) }\n\nasync function dispatch(ctx, msg) {\n  const { id, method, params = {} } = msg\n  const isNote = id === undefined\n  try {\n    switch (method) {\n      case 'initialize': return { jsonrpc: '2.0', id, result: { protocolVersion: PROTOCOLS.includes(params.protocolVersion) ? params.protocolVersion : PROTOCOLS[0], capabilities: { tools: { listChanged: false }, prompts: { listChanged: false } }, serverInfo: { name: 'postkit', version: CONFIG.product.apiVersion }, instructions: INSTRUCTIONS } }\n      case 'notifications/initialized': case 'notifications/cancelled': return null\n      case 'ping': return { jsonrpc: '2.0', id, result: {} }\n      case 'tools/list': return { jsonrpc: '2.0', id, result: { tools: visibleTools(ctx.actor).map(({ name, description, inputSchema, write }) => ({ name, description, inputSchema, annotations: { readOnlyHint: !write, destructiveHint: write && /delete|revoke|unpublish|send|publish/.test(name) } })) } }\n      case 'tools/call': {\n        const tool = toolByName.get(params.name)\n        // A tool hidden from this session behaves as if it did not exist. (3 October 2026)\n        if (!tool || (tool.write && !ctx.actor.scopes.includes('write'))) return { jsonrpc: '2.0', id, result: text(`Unknown tool: ${params.name}`, true) }\n        try { return { jsonrpc: '2.0', id, result: text(await tool.handler(ctx, params.arguments || {})) } }\n        catch (e) { const err = toApiError(e); return { jsonrpc: '2.0', id, result: text(`${err.status} ${err.code}: ${err.message}${err.details && Object.keys(err.details).length ? `\\n${JSON.stringify(err.details)}` : ''}`, true) } } // errors come back as text so the assistant can explain and retry\n      }\n      case 'prompts/list': return { jsonrpc: '2.0', id, result: { prompts: PROMPTS.map(({ name, description, arguments: args }) => ({ name, description, arguments: args })) } }\n      case 'prompts/get'