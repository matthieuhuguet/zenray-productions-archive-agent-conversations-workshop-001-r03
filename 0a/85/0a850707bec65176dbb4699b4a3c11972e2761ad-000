ance(3600_000); await h.app.tick()\n  assert.equal(api.all(/tweets\\/T1\\?/).length, readsBefore, 'a metered post is read at most once a day')\n  // cap: lower it under the current spend and background collection stops, publishing does not\n  await h.call('POST', '/v1/billing/spend-cap', { body: { capUsd: 0.5 } })\n  h.clock.advance(2 * 86_400_000)\n  const capped = await h.app.tick()\n  assert.ok(capped.analytics.find((a) => a.accountId === acc.id).skipped, 'cap reached: collection pauses silently')\n  const still = await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'still goes out', accountIds: [acc.id], publishNow: true } })\n  assert.equal(still.data.status, 'published', 'publishing is never blocked by the cap')\n})\n\ntest('X: an expiring token is refreshed with the refresh token and the new pair is persisted', async () => {\n  const api = fakeApi([[has(/oauth2\\/token/), json({ access_token: 'NEW', refresh_token: 'R2', expires_in: 7200 })], [has(/2\\/tweets$/, 'POST'), json({ data: { id: 'T9' } })]])\n  const h = await makeApp({ fetchImpl: api.fetchImpl, env: { POSTKIT_X_CLIENT_ID: 'cid', POSTKIT_X_CLIENT_SECRET: 'sec' } })\n  const { profile, acc } = await connect(h, 'x')\n  const { putSecret, getSecret } = await import('../src/domain/secrets.js')\n  await putSecret(h.ctx, acc.id, { accessToken: 'OLD', refreshToken: 'R1', expiresAt: '2026-10-03T12:00:30Z' })\n  const r = (await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'hi', accountIds: [acc.id], publishNow: true } })).data\n  assert.equal(r.status, 'published')\n  assert.match(api.find(/oauth2\\/token/).body, /grant_type=refresh_token/)\n  assert.equal(api.find(/2\\/tweets$/).headers.authorization, 'Bearer NEW')\n  const after = await getSecret(h.ctx, acc.id)\n  assert.equal(after.accessToken, 'NEW'); assert.equal(after.refreshToken, 'R2')\n})\n\ntest('WhatsApp: free text inside the window, refused after it, an approved template goes through with ordered v