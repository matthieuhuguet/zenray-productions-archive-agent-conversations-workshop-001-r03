{"parentUuid":"676d54e8-0d32-4396-9618-33b1b1b207bf","isSidechain":false,"message":{"model":"claude-sonnet-5-5","id":"msg_011Cff2qqD8roHSKumUcuNgw","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015wNcLL4qmMfHDytTdC6nxr","name":"Bash","input":{"command":"R=/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayPostKit; cd $R\ncat > src/domain/webhooks.js <<'EOF'\n// 3 October 2026 : Outbound webhooks. Events are queued by emit() and sent by a worker (dispatchDue), never inside the triggering request.\n// Delivery contract (same as PlugKit): 2xx within 10 s, 6 attempts with growing backoff, at least once, dedupe on the event id.\nimport { CONFIG } from '../config.js'\nimport { newId, PREFIX, randomHex } from '../lib/ids.js'\nimport { signWebhook } from '../lib/crypto.js'\nimport { seal, unseal } from '../lib/crypto.js'\nimport { badRequest } from '../lib/errors.js'\nimport { addMs } from '../lib/time.js'\nimport { listOwned, owned, stamp, view, nowIso } from './common.js'\n\nexport function assertWebhookUrl(ctx, url) {\n  let u\n  try { u = new URL(url) } catch { throw badRequest('url must be a valid URL.') }\n  const local = ['localhost', '127.0.0.1', '[::1]'].includes(u.hostname)\n  if (u.protocol !== 'https:' && !(local && ctx.env.POSTKIT_ALLOW_LOCAL_WEBHOOKS === '1')) throw badRequest('url must be an https endpoint.')\n  return u.toString()\n}\n\nfunction checkEvents(events) {\n  if (events === undefined) return []\n  if (!Array.isArray(events)) throw badRequest('events must be a list.')\n  const bad = events.filter((e) => !CONFIG.webhooks.events.includes(e))\n  if (bad.length) throw badRequest(`Unknown events: ${bad.join(', ')}`, { allowed: CONFIG.webhooks.events })\n  return events\n}\n\nconst publicEndpoint = (e) => { const { secretSealed, ...rest } = e; return view(rest) }\n\nexport async function createWebhook(ctx, { url, events }) {\n  const secret = `${CONFIG.auth.webhookSecretPrefix}${randomHex(CONFIG.auth.webhookSecretBytes)}`\n  const doc = await ctx.store.put('webhooks', stamp(ctx, {\n    _id: newId(PREFIX.webhook), workspaceId: ctx.actor.workspaceId, url: assertWebhookUrl(ctx, url), events: checkEvents(events), enabled: true,\n    secretSealed: seal(ctx.masterKey, { secret }),\n  }, { isNew: true }))\n  return { ...publicEndpoint(doc), secret } // the signing secret is returned once and never again\n}\nexport async function listWebhooks(ctx) { return { webhooks: (await listOwned(ctx, 'webhooks')).map(publicEndpoint) } }\nexport async function getWebhook(ctx, id) { return publicEndpoint(await owned(ctx, 'webhooks', id, 'Webhook')) }\nexport async function updateWebhook(ctx, id, patch) {\n  const w = await owned(ctx, 'webhooks', id, 'Webhook')\n  if (patch.url !== undefined) w.url = assertWebhookUrl(ctx, patch.url)\n  if (patch.events !== undefined) w.events = checkEvents(patch.events)\n  if (patch.enabled !== undefined) w.enabled = !!patch.enabled\n  return publicEndpoint(await ctx.store.put('webhooks', stamp(ctx, w)))\n}\nexport async function deleteWebhook(ctx, id) {\n  await owned(ctx, 'webhooks', id, 'Webhook')\n  await ctx.store.del('webhooks', id)\n  for (const d of await ctx.store.all('deliveries')) if (d.endpointId === id) await ctx.store.del('deliveries', d._id)\n  return { success: true }\n}\nexport async function listDeliveries(ctx, id) {\n  await owned(ctx, 'webhooks', id, 'Webhook')\n  const rows = (await ctx.store.all('deliveries')).filter((d) => d.endpointId === id).sort((a, b) => String(b.createdAt).localeCompare(String(a.createdAt)))\n  return { deliveries: rows.slice(0, 100).map(({ payload, ...d }) => view(d)) }\n}\n\n// Record an event and queue one delivery per subscribed endpoint. (3 October 2026)\nexport async function emit(ctx, type, data, workspaceId = ctx.actor?.workspaceId) {\n  if (!CONFIG.webhooks.events.includes(type)) throw new Error(`Unknown webhook event: ${type}`)\n  const event = { id: newId(PREFIX.event, 12), type, createdAt: nowIso(ctx), data }\n  const endpoints = (await ctx.store.all('webhooks')).filter((e) => e.workspaceId === workspaceId && e.enabled && (e.events.length === 0 || e.events.includes(type)))\n  for (const e of endpoints) {\n    await ctx.store.put('deliveries', { _id: newId(PREFIX.delivery), workspaceId, endpointId: e._id, eventId: event.id, type, payload: JSON.stringify(event), status: 'PENDING', attempts: 0, nextAttemptAt: event.createdAt, createdAt: event.createdAt })\n  }\n  await ctx.store.put('events', { _id: event.id, workspaceId, ...event })\n  return event\n}\n\nexport async function dispatchDue(ctx, { limit = CONFIG.scheduler.batchSize } = {}) {\n  const now = ctx.clock.now()\n  const due = (await ctx.store.all('deliveries')).filter((d) => d.status === 'PENDING' && new Date(d.nextAttemptAt) <= now).sort((a, b) => a.nextAttemptAt.localeCompare(b.nextAttemptAt)).slice(0, limit)\n  const out = []\n  for (const d of due) {\n    const endpoint = await ctx.store.get('webhooks', d.endpointId)\n    if (!endpoint) { await ctx.store.del('deliveries', d._id); continue }\n    const { secret } = unseal(ctx.masterKey, endpoint.secretSealed)\n    const ts = Math.floor(now.getTime() / 1000)\n    d.attempts += 1\n    try {\n      const res = await ctx.http.request(endpoint.url, {\n        method: 'POST', body: d.payload, timeoutMs: CONFIG.webhooks.timeoutMs, expect: 'text',\n        headers: { 'content-type': 'application/json', [CONFIG.headers.signature]: signWebhook(secret, d.payload, ts), 'x-postkit-event': d.type, 'x-postkit-delivery': d._id },\n      })\n      d.lastStatus = res.status\n      if (res.ok) { d.status = 'DELIVERED'; d.deliveredAt = nowIso(ctx); d.lastError = null } else d.lastError = `HTTP ${res.status}`\n    } catch (e) { d.lastStatus = null; d.lastError = e.message }\n    if (d.status !== 'DELIVERED') {\n      if (d.attempts >= CONFIG.webhooks.maxAttempts) d.status = 'FAILED'\n      else d.nextAttemptAt = addMs(now, CONFIG.webhooks.backoffSeconds[d.attempts - 1] * 1000).toISOString()\n    }\n    await ctx.store.put('deliveries', d)\n    out.push({ id: d._id, status: d.status, attempts: d.attempts })\n  }\n  return out\n}\nEOF\ncat > src/domain/usage.js <<'EOF'\n// 3 October 2026 : Pay-per-call usage and the monthly spend cap. Rules carried over from PlugKit:\n// nothing metered runs until the account consents (acknowledgeCost), a default cap always applies and can never be removed,\n// an alert fires once a month at 80%, and the cap stops background collection but never blocks publishing or sending.\nimport { CONFIG } from '../config.js'\nimport { newId, PREFIX } from '../lib/ids.js'\nimport { badRequest, paymentRequired } from '../lib/errors.js'\nimport { emit } from './webhooks.js'\nimport { listOwned, owned, stamp, workspaceSettingsRef } from './common.js'\nimport { patchWorkspaceSettings, workspaceSettings } from './workspaces.js'\n\nexport const monthOf = (d) => d.toISOString().slice(0, 7)\n\nexport async function capUsd(ctx) {\n  const s = await workspaceSettings(ctx)\n  return { capUsd: s.spendCapUsd ?? CONFIG.billing.defaultSpendCapUsd, isDefault: s.spendCapUsd === undefined || s.spendCapUsd === null }\n}\n\nexport async function setSpendCap(ctx, { capUsd: value }) {\n  if (value !== null && value !== undefined && (typeof value !== 'number' || !(value > 0))) throw badRequest('capUsd must be a positive number, or null to return to the default cap.')\n  // There is deliberately no \"unlimited\": null restores the default ceiling. (3 October 2026)\n  await patchWorkspaceSettings(ctx, { spendCapUsd: value ?? null })\n  return capUsd(ctx)\n}\n\nexport async function monthTotal(ctx, month = monthOf(ctx.clock.now())) {\n  const rows = await listOwned(ctx, 'usage', (u) => u.month === month)\n  return { rows, total: rows.reduce((n, r) => n + r.costUsd, 0) }\n}\n\nexport async function usageReport(ctx, { month } = {}) {\n  const m = month || monthOf(ctx.clock.now())\n  const { rows, total } = await monthTotal(ctx, m)\n  const cap = (await capUsd(ctx)).capUsd\n  const byOp = new Map()\n  for (const r of rows) { const e = byOp.get(r.operation) || { operation: r.operation, quantity: 0, cost_usd: 0 }; e.quantity += r.quantity; e.cost_usd = Math.round((e.cost_usd + r.costUsd) * 1e6) / 1e6; byOp.set(r.operation, e) }\n  return { period: m, currency: 'usd', total_usd: Math.round(total * 1e6) / 1e6, cap_usd: cap, remaining_usd: Math.max(0, Math.round((cap - total) * 1e6) / 1e6), breakdown: [...byOp.values()] }\n}\n\nexport async function capReached(ctx) { return (await monthTotal(ctx)).total >= (await capUsd(ctx)).capUsd }\n\n// Record a billable call. Returns its cost so the API layer can put it in the x-postkit-cost-usd header. (3 October 2026)\nexport async function recordUsage(ctx, operation, quantity = 1) {\n  const price = CONFIG.billing.prices[operation]\n  if (price === undefined) throw new Error(`Unknown billable operation ${operation}`)\n  const cost = price * quantity\n  const t = ctx.clock.now()\n  await ctx.store.put('usage', { _id: newId(PREFIX.usage), workspaceId: ctx.actor.workspaceId, month: monthOf(t), operation, quantity, costUsd: cost, at: t.toISOString() })\n  ctx.costUsd = (ctx.costUsd || 0) + cost\n  const { total } = await monthTotal(ctx)\n  const cap = (await capUsd(ctx)).capUsd\n  const settings = await workspaceSettings(ctx)\n  const month = monthOf(t)\n  if (total >= cap * CONFIG.billing.thresholdRatio && settings.thresholdAlertMonth !== month) {\n    await patchWorkspaceSettings(ctx, { thresholdAlertMonth: month })\n    await emit(ctx, 'usage.threshold_reached', { month, total_usd: total, cap_usd: cap, pausesAtCap: ['background analytics', 'background inbox sync'], keepsRunning: ['publishing', 'sending'] })\n  }\n  return cost\n}\n\n// A metered account must have consented to cost and must be under the cap for background work. (3 October 2026)\nexport async function meteredBackgroundAllowed(ctx, account, kind) {\n  const b = account.billing || {}\n  if (!(kind === 'analyti