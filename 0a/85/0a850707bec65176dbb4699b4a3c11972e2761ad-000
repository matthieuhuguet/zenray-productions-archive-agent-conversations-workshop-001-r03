uler tick), so they keep going when your process is not in front of them.\nimport { CONFIG } from '../config.js'\nimport { newId, PREFIX } from '../lib/ids.js'\nimport { ApiError, badRequest, conflict, unsupported } from '../lib/errors.js'\nimport { parseScheduled } from '../lib/time.js'\nimport { listOwned, owned, stamp, view, nowIso, pick, pageOffset } from './common.js'\nimport { getSecret } from './secrets.js'\nimport { emit } from './webhooks.js'\nimport { sendMessage } from './inbox.js'\n\nexport const norm = (s) => String(s || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().trim()\n\nexport function matchesText(rule, text) {\n  if (rule.matchType === 'any') return true\n  const hay = norm(text)\n  return (rule.keywords || []).some((k) => (rule.matchType === 'exact' ? hay === norm(k) : hay.includes(norm(k))))\n}\n\nfunction checkButton(label, url) {\n  if (!!label !== !!url) throw badRequest('A button needs both a label and a URL.')\n  if (url && !/^https:\\/\\//i.test(url)) throw badRequest('Button URLs must be https.')\n}\nconst buttonOf = (label, url) => (label && url ? { label: String(label).slice(0, 20), url } : null)\n\n// ============================================================ comment -> DM automations\nexport async function createAutomation(ctx, dto) {\n  const account = await owned(ctx, 'accounts', dto.accountId, 'Account')\n  if (!ctx.connectors.get(account.platform).capabilities.privateReply) throw unsupported('Only Instagram and Facebook Pages expose private replies to comments.')\n  const matchType = dto.matchType || 'contains'\n  if (matchType !== 'any' && !(dto.keywords || []).length) throw badRequest('keywords are required unless matchType is any.')\n  checkButton(dto.dmButtonLabel, dto.dmButtonUrl)\n  return view(await ctx.store.put('automations', stamp(ctx, { _id: newId(PREFIX.automation), workspaceId: ctx.actor.workspaceId, accountId: account._id, profileId: account.profileId, platform: account.platform, name: dto.name, mediaIds: dto.mediaIds || [], keywords: dto.keywords || [], matchType, dmText: dto.dmText, dmButtonLabel: dto.dmButtonLabel || null, dmButtonUrl: dto.dmButtonUrl || null, publicReplyText: dto.publicReplyText || null, oncePerUser: dto.oncePerUser !== false, status: 'active', counters: { triggered: 0, sent: 0, failed: 0, skipped: 0 } }, { isNew: true })))\n}\nexport const listAutomations = async (ctx) => ({ automations: (await listOwned(ctx, 'automations')).map(view) })\nexport const getAutomation = async (ctx, id) => view(await owned(ctx, 'automations', id, 'Automation'))\nexport async function updateAutomation(ctx, id, patch) {\n  const a = await owned(ctx, 'automations', id, 'Automation')\n  const next = { ...a, ...pick(patch, ['name', 'mediaIds', 'keywords', 'matchType', 'dmText', 'publicReplyText', 'oncePerUser', 'status']) }\n  if (patch.dmButtonLabel !== undefined || patch.dmButtonUrl !== undefined) { next.dmButtonLabel = patch.dmButtonLabel ?? a.dmButtonLabel; next.dmButtonUrl = patch.dmButtonUrl ?? a.dmButtonUrl; if (!patch.dmButtonLabel && !patch.dmButtonUrl) { next.dmButtonLabel = null; next.dmButtonUrl = null } checkButton(next.dmButtonLabel, next.dmButtonUrl) }\n  if (next.matchType !== 'any' && !next.keywords.length) throw badRequest('keywords are required unless matchType is any.')\n  return view(await ctx.store.put('automations', stamp(ctx, next)))\n}\nexport async function deleteAutomation(ctx, id) { await owned(ctx, 'automations', id, 'Automation'); await ctx.store.del('automations', id); return { success: true } }\nexport async function automationRuns(ctx, id) {\n  await owned(ctx, 'automations', id, 'Automation')\n  return { runs: (await ctx.store.all('automationRuns')).filter((r) => r.automationId === id).sort((a, b) => b.at.localeCompare(a.at)).slice(0, 200).map(view) }\n}\n\n// Meta allows ONE private reply per comment, within 7 days. It is the only way to message someone who never wrote to you,\n// and it does not come back: a second automation matching the same comment finds the door closed. (3 October 2026)\nasync function onComment(ctx, { account, engagement }) {\n  const autos = (await ctx.store.all('automations')).filter((a) => a.workspaceId === account.workspaceId && a.accountId === account._id && a.status === 'active')\n  for (const a of autos) {\n    if (a.mediaIds.length && !a.mediaIds.includes(engagement.postId)) continue\n    if (!matchesText(a, engagement.text)) continue\n    const run = { _id: newId(PREFIX.run), workspaceId: a.workspaceId, automationId: a._id, commentId: engagement.platformCommentId, author: engagement.author, text: engagement.text, at: nowIso(ctx), status: 'sent', reason: null }\n    a.counters.triggered += 1\n    const used = await ctx.store.get('privateReplies', `${account._id}:${engagement.platformCommentId}`)\n    const ageDays = (ctx.clock.now() - new Date(engagement.publishedAt)) / 86_400_000\n    const already = a.oncePerUser && (await ctx.store.all('automationRuns')).some((r) => r.automationId === a._id && r.author?.handle === engagement.author?.handle && r.status === 'sent')\n    if (used) { run.status = 'skipped'; run.reason = 'This comment already received its one private reply.'; a.counters.skipped += 1 }\n    else if (ageDays > CONFIG.messaging.privateReplyDays) { run.status = 'skipped'; run.reason = `The comment is older than ${CONFIG.messaging.privateReplyDays} days.`; a.counters.skipped += 1 }\n    else if (already) { run.status = 'skipped'; run.reason = 'This person already received a message from this automation.'; a.counters.skipped += 1 }\n    else {\n      try {\n        const connector = ctx.connectors.get(account.platform)\n        await connector.privateReply({ account, secret: await getSecret(ctx, account._id), comment: engagement, text: a.dmText, button: buttonOf(a.dmButtonLabel, a.dmButtonUrl), http: ctx.http, ctx, now: ctx.clock.now() })\n        await ctx.store.put('privateReplies', { _id: `${account._id}:${engagement.platformCommentId}`, at: nowIso(ctx) })\n        if (a.publicReplyText && connector.replyToComment) await connector.replyToComment({ account, secret: await getSecret(ctx, account._id), comment: engagement, text: a.publicReplyText, http: ctx.http, ctx, now: ctx.clock.now() }).catch(() => {})\n        a.counters.sent += 1\n        await emit(ctx, 'comment.dm_sent', { automationId: a._id, commentId: engagement.platformCommentId, author: engagement.author })\n        await enrollFromAutomation(ctx, account, a, engagement)\n      } catch (e) { run.status = 'failed'; run.reason = e.message; a.counters.failed += 1 }\n    }\n    await ctx.store.put('automationRuns', run)\n    await ctx.store.put('automations', a)\n  }\n}\n\n// ============================================================ sequences\nexport async function createSequence(ctx, dto) {\n  const account = await owned(ctx, 'accounts', dto.accountId, 'Account')\n  if (!ctx.connectors.get(account.platform).capabilities.messaging) throw unsupported('This platform has no messaging, so no sequences.')\n  const trigger = dto.trigger || 'conversation_started'\n  if (trigger === 'comment_automation') await owned(ctx, 'automations', dto.automationId, 'Automation')\n  if (!Array.isArray(dto.steps) || !dto.steps.length) throw badRequest('A sequence needs at least one step.')\n  dto.steps.forEach((s) => checkButton(s.buttonLabel, s.buttonUrl))\n  return view(await ctx.store.put('sequences', stamp(ctx, { _id: newId(PREFIX.sequence), workspaceId: ctx.actor.workspaceId, accountId: account._id, profileId: account.profileId, platform: account.platform, name: dto.name, trigger, automationId: dto.automationId || null, keywords: dto.keywords || [], matchType: dto.matchType || 'contains', stopOnReply: dto.stopOnReply !== false, steps: dto.steps.map((s) => ({ delayMinutes: s.delayMinutes, text: s.text, buttonLabel: s.buttonLabel || null, buttonUrl: s.buttonUrl || null })), status: 'active' }, { isNew: true })))\n}\nexport const listSequences = async (ctx) => ({ sequences: (await listOwned(ctx, 'sequences')).map(view) })\nexport const getSequence = async (ctx, id) => view(await owned(ctx, 'sequences', id, 'Sequence'))\nexport async function updateSequence(ctx, id, patch) {\n  const s = await owned(ctx, 'sequences', id, 'Sequence')\n  if (patch.steps) patch.steps.forEach((x) => checkButton(x.buttonLabel, x.buttonUrl))\n  return view(await ctx.store.put('sequences', stamp(ctx, { ...s, ...pick(patch, ['name', 'trigger', 'automationId', 'keywords', 'matchType', 'stopOnReply', 'steps', 'status']) })))\n}\nexport async function deleteSequence(ctx, id) {\n  await owned(ctx, 'sequences', id, 'Sequence'); await ctx.store.del('sequences', id)\n  for (const e of await ctx.store.all('enrollments')) if (e.sequenceId === id) await ctx.store.del('enrollments', e._id)\n  return { success: true }\n}\nexport async function sequenceEnrollments(ctx, id) {\n  await owned(ctx, 'sequences', id, 'Sequence')\n  return { enrollments: (await ctx.store.all('enrollments')).filter((e) => e.sequenceId === id).map(view) }\n}\n\nasync function enroll(ctx, sequence, conversation) {\n  const dup = (await ctx.store.all('enrollments')).find((e) => e.sequenceId === sequence._id && e.conversationId === conversation._id && e.status === 'active')\n  if (dup) return dup\n  const first = sequence.steps[0]\n  return ctx.store.put('enrollments', { _id: newId(PREFIX.enrollment), workspaceId: sequence.workspaceId, sequenceId: sequence._id, accountId: sequence.accountId, conversationId: conversation._id, contactHandle: conversation.contactHandle, stepIndex: 0, nextRunAt: new Date(ctx.clock.now().getTime() + first.delayMinutes * 60_000).toISOString(), status: 'active', enrolledAt: nowIso(ctx), history: [] })\n}\n\nexport async function enrollManually(ctx, sequenceId, { conversationId }) {\n  const seq = await owned(ctx, 'sequences', sequenceId, 'Sequence')\n  const conv = await owned(ctx, 'conversations', conversationId, 'Conversation')\n  if (conv.accountId !== seq.accountId) throw badRequest('The conversation belongs to another account.')\n  return view(await enroll(ctx, seq, conv))\n}\n\nasync function enrollFromAutomation(ctx, account, automation, engagement) {\n  const seqs = (await ctx.store.all('sequences')).filter((s) => s.workspaceId === account.workspaceId && s.status === 'active' && s.trigger === 'comment_automation' && s.automationId === automation._id)\n  if (!seqs.length) return\n  const { conv } = await (await import('./inbox.js')).startConversation ? { conv: await openConversation(ctx, account, engagement.author) } : {}\n  for (const s of seqs) await enroll(ctx, s, conv)\n}\nasync function openConversation(ctx, account, author) {\n  const ex = (await ctx.store.all('conversations')).find((c) => c.accountId === account._id && c.externalConversationId === author.handle)\n  if (ex) return ex\n  return ctx.store.put('conversations', stamp(ctx, { _id: newId(PREFIX.conversation), workspaceId: account.workspaceId, accountId: account._id, profileId: account.profileId, platform: account.platform, contactHandle: author.handle, contactName: author.name || author.handle, externalConversationId: author.handle, lastMessageAt: nowIso(ctx), lastInboundAt: null, lastDirection: null, lastMessagePreview: '', unreadCount: 0 }, { isNew: true }))\n}\n\nasync function onInbound(ctx, { account, conversation, message, created, storyReply }) {\n  const enrollments = (await ctx.store.all('enrollments')).filter((e) => e.conversationId === conversation._id && e.status === 'active')\n  for (const e of enrollments) {\n    const seq = await ctx.store.get('sequences', e.sequenceId)\n    // A human reply that keeps getting followed up by a robot is the fastest way to lose the conversation you just won.\n    if (seq?.stopOnReply) await ctx.store.put('enrollments', { ...e, status: 'stopped', stoppedAt: nowIso(ctx), stopReason: 'contact replied' })\n  }\n  const seqs = (await ctx.store.all('sequences')).filter((s) => s.workspaceId === account.workspaceId && s.accountId === account._id && s.status === 'active')\n  for (const s of seqs) {\n    if (s.trigger === 'conversation_started' && created) await enroll(ctx, s, conversation)\n    if (s.trigger === 'story_reply' && storyReply && matchesText(s.matchType === 'any' || !(s.keywords || []).length ? { matchType: 'any' } : s, message.text)) await enroll(ctx, s, conversation)\n  }\n}\n\nexport async function runDueSequences(ctx) {\n  const now = ctx.clock.now()\n  const out = []\n  for (const e of (await ctx.store.all('enrollments')).filter((x) => x.status === 'active' && new Date(x.nextRunAt) <= now)) {\n    const seq = await ctx.store.get('sequences', e.sequenceId)\n    if (!seq || seq.status !== 'active') continue\n    const sub = { ...ctx, actor: { ...ctx.actor, workspaceId: e.workspaceId } }\n    const step = seq.steps[e.stepIndex]\n    try {\n      await sendMessage(sub, e.conversationId, { text: step.text, button: buttonOf(step.buttonLabel, step.buttonUrl) }, { via: 'sequence' })\n      e.history.push({ step: e.stepIndex, at: now.toISOString(), status: 'sent' })\n    } catch (err) {\n      // A step that comes due outside the 24 h window is recorded as failed for that person and the sequence moves on, never stalls.\n      e.history.push({ step: e.stepIndex, at: now.toISOString(), status: 'failed', reason: err.message })\n    }\n    e.stepIndex += 1\n    if (e.stepIndex >= seq.steps.length) { e.status = 'completed'; e.completedAt = now.toISOString() } else e.nextRunAt = new Date(now.getTime() + seq.steps[e.stepIndex].delayMinutes * 60_000).toISOString()\n    await ctx.store.put('enrollments', e)\n    out.push({ enrollmentId: e._id, step: e.history[e.history.length - 1] })\n  }\n  return out\n}\n\n// ============================================================ broadcasts\nexport async function broadcastAudience(ctx, { accountId, activeWithinDays }) {\n  const account = await owned(ctx, 'accounts', accountId, 'Account')\n  const rows = await resolveAudience(ctx, account, { activeWithinDays: activeWithinDays === undefined ? 1 : Number(activeWithinDays) })\n  return { accountId, activeWithinDays: activeWithinDays === undefined ? 1 : Number(activeWithinDays), count: rows.length }\n}\n\nasync function resolveAudience(ctx, account, audience = {}) {\n  const convs = (await ctx.store.all('conversations')).filter((c) => c.accountId === account._id && c.workspaceId === account.workspaceId)\n  if (audience.conversationIds?.length) return convs.filter((c) => audience.conversationIds.includes(c._id))\n  if (audience.activeWithinDays === undefined || audience.activeWithinDays === null) return convs\n  const since = ctx.clock.now().getTime() - audience.activeWithinDays * 86_400_000\n  return convs.filter((c) => new Date(c.lastMessageAt).getTime() >= since)\n}\n\nexport async function createBroadcast(ctx, dto) {\n  const account = await owned(ctx, 'accounts', dto.accountId, 'Account')\n  const connector = ctx.connectors.get(account.platform)\n  if (!connector.capabilities.messaging) throw unsupported('This platform has no messaging.')\n  if (account.platform === 'x') throw unsupported('Broadcasts exclude X: its DMs are billed per call and a large broadcast would build an invoice nobody approved.')\n  checkButton(dto.buttonLabel, dto.buttonUrl)\n  const scheduledFor = dto.sendNow ? ctx.clock.now() : dto.scheduledFor ? parseScheduled(dto.scheduledFor, dto.timezone || 'UTC') : null\n  return view(await ctx.store.put('broadcasts', stamp(ctx, { _id: newId(PREFIX.broadcast), workspaceId: ctx.actor.workspaceId, accountId: account._id, profileId: account.profileId, platform: account.platform, name: dto.name, text: dto.text, buttonLabel: dto.buttonLabel || null, buttonUrl: dto.buttonUrl || null, audience: dto.audience || { activeWithinDays: 1 }, scheduledFor: scheduledFor ? scheduledFor.toISOString() : null, timezone: dto.timezone || null, status: scheduledFor ? 'scheduled' : 'draft', counts: { total: 0, sent: 0, failed: 0 } }, { isNew: true })))\n}\nexport async function listBroadcasts(ctx) { const rows = await listOwned(ctx, 'broadcasts'); rows.sort((a, b) => b.createdAt.localeCompare(a.createdAt)); return { broadcasts: rows.map(view) } }\nexport const getBroadcast = async (ctx, id) => view(await owned(ctx, 'broadcasts', id, 'Broadcast'))\nexport async function updateBroadcast(ctx, id, patch) {\n  const b = await owned(ctx, 'broadcasts', id, 'Broadcast')\n  if (!['draft', 'scheduled'].includes(b.status)) throw conflict(`A ${b.status} broadcast can no longer be edited.`)\n  const next = { ...b, ...pick(patch, ['name', 'text', 'buttonLabel', 'buttonUrl', 'audience', 'timezone']) }\n  checkButton(next.buttonLabel, next.buttonUrl)\n  if (patch.sendNow) { next.scheduledFor = nowIso(ctx); next.status = 'scheduled' }\n  else if (patch.scheduledFor !== undefined) { next.scheduledFor = patch.scheduledFor ? parseScheduled(patch.scheduledFor, next.timezone || 'UTC').toISOString() : null; next.status = next.scheduledFor ? 'scheduled' : 'draft' }\n  return view(await ctx.store.put('broadcasts', stamp(ctx, next)))\n}\nexport async function deleteBroadcast(ctx, id) {\n  const b = await owned(ctx, 'broadcasts', id, 'Broadcast')\n  if (b.status === 'sending') throw conflict('A broadcast being sent cannot be deleted.')\n  await ctx.store.del('broadcasts', id)\n  for (const r of await ctx.store.all('broadcastRecipients')) if (r.broadcastId === id) await ctx.store.del('broadcastRecipients', r._id)\n  return { success: true }\n}\nexport async function sendBroadcast(ctx, id) {\n  const b = await owned(ctx, 'broadcasts', id, 'Broadcast')\n  if (!['draft', 'scheduled'].includes(b.status)) throw conflict(`This broadcast is ${b.status}.`)\n  b.status = 'scheduled'; b.scheduledFor = nowIso(ctx)\n  return view(await ctx.store.put('broadcasts', stamp(ctx, b)))\n}\nexport async function cancelBroadcast(ctx, id) {\n  const b = await owned(ctx, 'broadcasts', id, 'Broadcast')\n  if (b.status !== 'scheduled') throw conflict('Only a scheduled