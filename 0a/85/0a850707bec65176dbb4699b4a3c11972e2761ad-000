('profileId is required.')\n  await owned(ctx, 'profiles', profileId, 'Profile')\n  const creds = platformCreds(ctx, platform)\n  if (!creds.clientId) throw new ApiError(400, 'platform_not_configured', `${connector.label} is not configured on this server.`, { missingEnv: [`POSTKIT_${platform.toUpperCase()}_CLIENT_ID`, `POSTKIT_${platform.toUpperCase()}_CLIENT_SECRET`, ...(connector.requiredEnv || [])] })\n  const state = randomHex(16)\n  const verifier = randomHex(32)\n  await ctx.store.put('oauthStates', { _id: state, workspaceId: ctx.actor.workspaceId, profileId, platform, verifier, returnTo: returnTo || null, expiresAt: new Date(ctx.clock.now().getTime() + 30 * 60_000).toISOString() })\n  const codeChallenge = Buffer.from(sha256(verifier), 'hex').toString('base64url')\n  return { authUrl: authorizeUrl({ state, redirectUri: redirectUriFor(ctx, platform), creds, codeChallenge }) }\n}\n\n// Public callback: the state ties it back to the workspace that started the flow. (3 October 2026)\nexport async function handleCallback(ctx, platform, query) {\n  if (query.error) throw badRequest(`${platform} authorization failed: ${query.error_description || query.error}`)\n  const st = await ctx.store.get('oauthStates', query.state)\n  if (!st || st.platform !== platform || new Date(st.expiresAt) < ctx.clock.now()) throw notFound('Authorization state')\n  await ctx.store.del('oauthStates', st._id)\n  const connector = ctx.connectors.get(platform)\n  const exchange = need(connector, 'exchangeCode', 'OAuth connection')\n  const result = await exchange({ code: query.code, redirectUri: redirectUriFor(ctx, platform), creds: platformCreds(ctx, platform), verifier: st.verifier, http: ctx.http, now: ctx.clock.now() })\n  const sub = { ...ctx, actor: { ...ctx.actor, workspaceId: st.workspaceId } }\n  const accounts = []\n  for (const a of result.accounts) accounts.push(await upsertAccount(sub, { profileId: st.profileId, platform, ...a }))\n  return { accounts, returnTo: st.returnTo }\n}