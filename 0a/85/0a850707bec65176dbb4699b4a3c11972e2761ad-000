- 1]\n    const base = [...rows].reverse().find((s) => s.date <= w.from.toISOString().slice(0, 10)) || rows[0]\n    total = (total ?? 0) + latest.followers\n    change = (change ?? 0) + (latest.followers - base.followers)\n  }\n  return { total, change }\n}\n\nasync function syncTimes(ctx, posts) {\n  const last = posts.map((p) => p.lastSyncAt).filter(Boolean).sort().pop() || null\n  const next = posts.map((p) => p.nextSyncAt).filter(Boolean).sort()[0] || null\n  return { lastSyncAt: last, nextSyncAt: next }\n}\n\nexport async function summary(ctx, q = {}) {\n  const w = await resolveWindow(ctx, q)\n  const span = w.to - w.from\n  const prevW = { from: new Date(w.from - span), to: w.from }\n  const cur = await profileFilter(ctx, q, await scopedPosts(ctx, q, w))\n  const prev = await profileFilter(ctx, q, await scopedPosts(ctx, q, prevW))\n  const a = aggregate(cur); const b = aggregate(prev)\n  const best = [...cur].sort((x, y) => (engagementOf(y.metrics) ?? -1) - (engagementOf(x.metrics) ?? -1))[0]\n  const f = await followerTotals(ctx, q, w)\n  return {\n    window: windowOut(w),\n    posts: { value: a.count, change: volumeChange(a.count, b.count) },\n    engagementRate: { value: a.rate, change: a.rate !== null && b.rate !== null ? r1(a.rate - b.rate) : null }, // a rate changes in points, a volume in percent\n    metrics: Object.fromEntries(METRICS.map((m) => [m, { value: a.metrics[m], change: volumeChange(a.metrics[m], b.metrics[m]) }])),\n    followers: f,\n    bestPost: best ? { id: best._id, platform: best.platform, engagement: engagementOf(best.metrics), permalink: best.permalink } : null,\n    ...(await syncTimes(ctx, cur)),\n  }\n}\n\nexport async function postsReport(ctx, q = {}) {\n  const w = await resolveWindow(ctx, q)\n  let rows = await profileFilter(ctx, q, await scopedPosts(ctx, q, w))\n  const sortBy = q.sortBy || 'date'\n  const val = (p) => (sortBy === 'date' ? new Date(p.publishedAt).getTime() : sortBy === 'engagement' ? engagementOf(p.metrics) ?? -1 : p.metrics?.[sortBy] ?? -1)\n  rows.sort((x, y) => (q.order === 'asc' ? val(x) - val(y) : val(y) - val(x)))\n  const p = pageOffset(rows, { page: q.page, limit: Math.min(Number(q.limit) || 20, 100) })\n  return { window: windowOut(w), posts: p.rows.map((t) => ({ id: t._id, accountId: t.accountId, platform: t.platform, platformPostId: t.platformPostId, permalink: t.permalink, caption: t.caption, publishedAt: t.publishedAt, source: t.source === 'postkit' ? 'plugkit' : 'external', metrics: t.metrics, engagement: engagementOf(t.metrics), lastSyncAt: t.lastSyncAt, nextSyncAt: t.nextSyncAt })), pagination: { page: p.page, limit: p.limit, total: p.total, hasMore: p.hasMore }, ...(await syncTimes(ctx, rows)) }\n}\n\nexport async function platformsReport(ctx, q = {}) {\n  const w = await resolveWindow(ctx, q)\n  const rows = await profileFilter(ctx, q, await scopedPosts(ctx, q, w))\n  const byPlatform = new Map()\n  for (const p of rows) byPlatform.set(p.platform, [...(byPlatform.get(p.platform) || []), p])\n  return { window: windowOut(w), platforms: [...byPlatform.entries()].map(([platform, posts]) => { const a = aggregate(posts); return { platform, posts: a.count, engagementRate: a.rate, metrics: a.metrics } }), ...(await syncTimes(ctx, rows)) }\n}\n\nfunction bucketKey(dateIso, granularity) {\n  const d = new Date(dateIso)\n  if (granularity === 'month') return new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), 1)).toISOString()\n  if (granularity === 'week') { const day = (d.getUTCDay() + 6) % 7; return new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate() - day)).toISOString() }\n  return new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate())).toISOString()\n}\n\nexport async function timeseries(ctx, q = {}) {\n  const metric = q.metric || 'likes'\n  if (![...METRICS, 'engagement'].includes(metric)) throw badRequest(`metric must be one of ${[...METRICS, 'engagement'].join(', ')}.`)\n  const granularity = q.granularity || 'day