tion: 'handoff', auth: 'handoff',\n    note: 'No public write API. PostKit prepares title, description, tags, software and ordered images; you paste them into a new ArtStation project and confirm with the project URL.',\n    capabilities: { publish: true },\n    rules: { text: 'optional', maxChars: 5000, media: { min: 1, max: 50, types: ['image', 'gif', 'video'] }, titleRequired: true },\n\n    async connectWithToken({ username }) {\n      return { accounts: [{ externalId: username || 'artstation', username: username || 'artstation', displayName: username || 'ArtStation', secret: null, metadata: { profileUrl: username ? `https://www.artstation.com/${username}` : cfg.newProjectUrl } }] }\n    },\n\n    // Never fails on the network: it only builds the package. The target becomes awaiting_manual. (3 October 2026)\n    async publish({ account, post, target, media, fetchMedia, ctx }) {\n      const text = (target.customContent ?? post.content ?? '').trim()\n      const opts = post.options?.artstation || {}\n      const tags = unique([...(opts.tags || []), ...hashtagsOf(text)]).slice(0, 30)\n      const images = []\n      for (const [i, item] of media.entries()) {\n        if (item.type === 'video') { images.push({ order: i + 1, type: 'video', url: item.url, altText: item.altText || null, note: 'Upload this MP4 as a video block.' }); continue }\n        let prepared = null\n        if (ctx?.imageTools && item.type === 'image') {\n          const { bytes, filename } = await fetchMedia(item)\n          const out = await ctx.imageTools.resize(bytes, { width: cfg.imageMaxWidth, quality: cfg.imageQuality, format: 'jpg' })\n          if (out) prepared = await uploadMedia(ctx, { filename: `${(filename || `image-${i + 1}`).replace(/\\.[^.]+$/, '')}-artstation.jpg`, bytes: out, contentType: 'image/jpeg' })\n        }\n        images.push({ order: i + 1, type: item.type, url: prepared?.url || item.url, prepared: !!prepared, altText: item.altText || null })\n      }\n      return {