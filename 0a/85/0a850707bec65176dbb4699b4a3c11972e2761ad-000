rticle postkit \\(PostKit\\)/)\n  assert.equal(readFileSync(join(repo, 'DIRTY.txt'), 'utf8'), 'owner has uncommitted work', 'owner tree untouched')\n  assert.equal(execFileSync('git', ['branch', '--show-current'], { cwd: repo }).toString().trim(), 'master', 'owner checkout still on master')\n  assert.ok(!readFileSync(join(repo, 'src', 'App.jsx'), 'utf8').includes('postkit'), 'owner App.jsx not modified')\n})\n\ntest('Website deploy mode: builds, uploads with Wrangler, verifies the live URL with a cache-buster, only then publishes', { skip: !PNG && 'magick not installed' }, async () => {\n  const repo = makeSiteRepo()\n  const cmds = []\n  const real = (await import('../src/lib/exec.js')).run\n  const exec = async (cmd, args, opts) => { if (cmd === 'npm' || cmd === 'npx') { cmds.push([cmd, ...args]); return { code: 0, stdout: '', stderr: '' } } return real(cmd, args, opts) }\n  const urls = []\n  const fetchImpl = async (url) => { urls.push(String(url)); return String(url).startsWith('https://cdn.test/') ? new Response(PNG, { status: 200 }) : new Response('<html>', { status: 200 }) }\n  const { createApp } = await import('../src/app.js'); const { MemoryStore } = await import('../src/store/memory.js'); const { fixedClock } = await import('../src/lib/time.js')\n  const h = await makeApp({ fetchImpl })\n  h.ctx.exec = exec\n  const { profile } = await seed(h)\n  const site = (await h.call('POST', '/v1/accounts/connect', { body: { platform: 'website', profileId: profile.id, externalId: 'matthieuhuguet.com', username: 'matthieuhuguet.com', metadata: { repoPath: repo, publicUrl: 'https://matthieuhuguet.com', pagesProject: 'matthieu-huguet', deploy: true } } })).data\n  const r = (await h.call('POST', '/v1/posts', { body: { profileId: profile.id, title: 'Deployed', content: 'Live now.', accountIds: [site.id], mediaItems: [{ url: 'https://cdn.test/a.png', type: 'image' }], publishNow: true } })).data\n  assert.equal(r.status, 'published', JSON.stringify(r.targets[0].error))\n  assert.equal(r.targets[0].platformPostUrl, 'https://matthieuhuguet.com/reels/deployed')\n  assert.deepEqual(cmds[0], ['npm', 'run', 'build'])\n  assert.deepEqual(cmds[1].slice(0, 7), ['npx', 'wrangler', 'pages', 'deploy', 'dist', '--project-name', 'matthieu-huguet'])\n  assert.ok(urls.some((u) => /reels\\/deployed\\?cb=\\d+/.test(u)), 'verified with a cache-buster')\n  void createApp; void MemoryStore; void fixedClock\n})\nEOF\nnode --test test/connectors-new.test.js 2>&1 | grep -E \"^(✔|✖|ℹ (tests|pass|fail|skipped))|actual|expected|rror\" | head -40","description":"Write website connector and tests for the three new integrations"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7577,"cache_read_input_tokens":630093,"output_tokens":14545,"output_tokens_details":{"thinking_tokens":101},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":7577,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":14545,"cache_read_input_tokens":630093,"cache_creation_input_tokens":7577,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7577},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01UVaSHYid9yhHBBk5u1j7Fw":{"command":"R=/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayPostKit; cd $R\nsed -i '' \"s/async publish({ account, post, target, media, fetchMedia, ctx }) {/async publish({ account, post, target, media, fetchMedia, ctx, now }) {/; s/preparedAt: new Date().toISOString(),/preparedAt: now.toISOString(),/\" src/platforms/connectors/artstation.js\ncat > src/platforms/connectors/website.js <<'EOF'\n// 3 October 2026 : Website connector for matthieuhuguet.com (repo ZenRayWebsite, skill zenray-website). A post becomes an article.\n// Rules from that skill, enforced here: never touch the owner's working tree (it is often dirty), so the work happens in a clean\n// git worktree on a branch postkit/<slug>; images go out as WebP at 3840 px, quality 95 (2560 px when there are many); no PNG or AVIF in\n// public/; the PROJECTS card id is computed from the existing ids (a duplicated id silently hides another project); deployment is an\n// explicit upload with Wrangler, never an automatic Git deploy, and only when the account setting deploy is true.\nimport { mkdtempSync, mkdirSync, writeFileSync, readFileSync, symlinkSync, existsSync, rmSync } from 'node:fs'\nimport { tmpdir } from 'node:os'\nimport { join } from 'node:path'\nimport { defineConnector } from '../base.js'\nimport { ApiError, badRequest } from '../../lib/errors.js'\n\nexport const slugify = (s) => String(s || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60)\n\n// Blank-line separated paragraphs, \"# \" headings and \"- \" bullet runs, images interleaved after the text. (3 October 2026)\nexport function contentToBlocks(text, images, slug) {\n  const blocks = []\n  for (const chunk of String(text || '').split(/\\n{2,}/).map((c) => c.trim()).filter(Boolean)) {\n    const lines = chunk.split('\\n')\n    if (/^#{1,3} /.test(chunk)) { const level = chunk.match(/^#+/)[0].length; blocks.push({ type: 'heading', props: { level }, content: chunk.replace(/^#+\\s*/, '') }); continue }\n    if (lines.every((l) => /^[-*] /.test(l))) { for (const l of lines) blocks.push({ type: 'bulletListItem', content: l.replace(/^[-*]\\s+/, '') }); continue }\n    blocks.push({ type: 'paragraph', content: lines.join(' ') })\n  }\n  images.forEach((img, i) => blocks.push({ type: 'image', props: { url: `/projects/${slug}/${String(i + 1).padStart(2, '0')}.webp`, caption: img.altText || '' } }))\n  return blocks\n}\n\n// Insert a card first in the PROJECTS array (newest first), with a verified-unique id. Throws instead of guessing. (3 October 2026)\nexport function insertProjectCard(source, card) {\n  const anchor = 'const PROJECTS = ['\n  const at = source.indexOf(anchor)\n  if (at < 0) throw new Error('Could not find \"const PROJECTS = [\" in src/App.jsx: the site changed, update the connector.')\n  const end = source.indexOf('\\n]', at)\n  const block = source.slice(at, end)\n  const ids = [...block.matchAll(/^\\s{2}\\s*id:\\s*(\\d+),/gm)].map((m) => Number(m[1]))\n  if (!ids.length) throw new Error('No project ids found in PROJECTS: refusing to guess a new id.')\n  const id = Math.max(...ids) + 1\n  if (block.includes(`articleSlug: \"${card.articleSlug}\"`)) throw new Error(`A project already uses the article slug ${card.articleSlug}.`)\n  const text = `\\n  {\\n    id: ${id},\\n    brand: ${JSON.stringify(card.brand)},\\n    title: ${JSON.stringify(card.title)},\\n    articleSlug: ${JSON.stringify(card.articleSlug)},\\n    color: ${JSON.stringify(card.color)},\\n    accent: ${JSON.stringify(card.accent)},\\n    image: ${JSON.stringify(card.image)},\\n    hidden: true,\\n  },`\n  return { source: source.slice(0, at + anchor.length) + text + source.slice(at + anchor.length), id }\n}\n\nexport function createWebsiteConnector({ config, http, exec: defaultExec }) {\n  const cfg = config.website\n\n  async function git(exec, cwd, ...args) { return (await exec('git', args, { cwd })).stdout.trim() }\n\n  return defineConnector({\n    platform: 'website', label: 'Website (matthieuhuguet.com)', verification: 'local', auth: 'local',\n    note: 'Turns a post into an article of the site, in a clean git worktree on a postkit/<slug> branch. Stage mode stops there; deploy mode (account setting deploy: true) also builds and uploads with Wrangler, then checks the live URL.',\n    capabilities: { publish: true },\n    rules: { text: 'required', maxChars: null, media: { min: 0, max: 60, types: ['image'] }, titleRequired: true },\n\n    async connectWithToken(input = {}) {\n      const repoPath = input.repoPath || cfg.repoPath\n      if (!existsSync(join(repoPath, '.git'))) throw badRequest(`${repoPath} is not a git repository.`)\n      return { accounts: [{ externalId: 'matthieuhuguet.com', username: 'matthieuhuguet.com', displayName: 'matthieuhuguet.com', secret: null, metadata: { repoPath, pagesProject: input.pagesProject || cfg.pagesProject, publicUrl: input.publicUrl || cfg.publicUrl, deploy: !!input.deploy } }] }\n    },\n\n    async publish({ account, post, target, media, fetchMedia, ctx, now }) {\n      const exec = ctx.exec || defaultExec\n      const meta = { repoPath: cfg.repoPath, pagesProject: cfg.pagesProject, publicUrl: cfg.publicUrl, deploy: false, ...account.metadata, ...(account.settings || {}) }\n      const opts = post.options?.website || {}\n      const title = (post.title || '').trim() || (target.customContent ?? post.content ?? '').trim().split('\\n')[0].slice(0, 100)\n      if (!title) throw badRequest('The website needs a title.')\n      const slug = opts.slug || slugify(title)\n      // Slug trap from the skill: a project whose slugified title equals the article slug would hide the article. Suffix the card title.\n      const cardTitle = slugify(title) === slug ? `${title} Post` : title\n      if (!existsSync(join(meta.repoPath, '.git'))) throw new ApiError(422, 'repo_missing', `The website repository was not found at ${meta.repoPath}.`)\n\n      const base = await git(exec, meta.repoPath, 'rev-parse', '--abbrev-ref', 'HEAD').then((b) => (b === 'HEAD' ? 'master' : b))\n      const dir = mkdtempSync(join(tmpdir(), 'postkit-site-'))\n      const branch = `${cfg.branchPrefix}${slug}`\n      await git(exec, meta.repoPath, 'worktree', 'add', '-b', branch, dir, base) // a clean checkout: the owner's dirty tree stays untouched\n\n      try {\n        const items = media.filter((m) => m.type === 'image')\n        const width = items.length > cfg.denseImageThreshold ? cfg.imageWidthDense : cfg.imageWidth\n        mkdirSync(join(dir, 'public', 'projects', slug), { recursive: true })\n        for (const [i, item] of items.entries()) {\n          const { bytes } = await fetchMedia(item)\n          const out = await ctx.imageTools.resize(bytes, { width, quality: cfg.imageQuality, format: 'webp' })\n          if (!out) throw new ApiError(422, 'imagemagick_missing', 'ImageMagick (magick) is required to produce the WebP images of the site.')\n          writeFileSync(join(dir, 'public', 'projects', slug, `${String(i + 1).padStart(2, '0')}.webp`), out)\n        }\n        const text = (target.customContent ?? post.content ?? '').trim()\n        const article = { schema: 'article.public.v1', slug, title, subtitle: opts.subtitle || '', ...(items.length ? { hero: { type: 'image', src: `/projects/${slug}/01.webp`, alt: items[0].altText || title } } : {}), blocks: contentToBlocks(text.split('\\n').slice(post.title ? 0 : 1).join('\\n') || text, items, slug) }\n        mkdirSync(join(dir, 'public', 'articles'), { recursive: true })\n        writeFileSync(join(dir, 'public', 'articles', `${slug}.json`), JSON.stringify(article, null, 1) + '\\n')\n\n        const indexPath = join(dir, 'public', 'articles', 'index.json')\n        const index = existsSync(indexPath) ? JSON.parse(readFileSync(indexPath, 'utf8')) : { items: [] }\n        index.items = [{ slug, title, subtitle: opts.subtitle || '' }, ...index.items.filter((x) => x.slug !== slug)]\n        writeFileSync(indexPath, JSON.stringify(index, null, 1) + '\\n')\n\n        const appPath = join(dir, 'src', 'App.jsx')\n        const card = insertProjectCard(readFileSync(appPath, 'utf8'), { brand: opts.brand || 'Post', title: cardTitle, articleSlug: slug, color: opts.color || '#1f1f1e', accent: opts.accent || '#4371ee', image: items.length ? `/projects/${slug}/01.webp` : '' })\n        writeFileSync(appPath, card.source)\n\n        const sitemapPath = join(dir, 'public', 'sitemap.xml')\n        if (existsSync(sitemapPath)) {\n          const sm = readFileSync(sitemapPath, 'utf8')\n          if (!sm.includes(`/reels/${slug}<`)) writeFileSync(sitemapPath, sm.replace('</urlset>', `  <url><loc>${meta.publicUrl}/reels/${slug}</loc></url>\\n</urlset>`))\n        }\n\n        // Stage only the paths we wrote (never \"git add -A\"), then commit on the postkit branch.\n        const paths = ['public/articles', 'src/App.jsx', ...(items.length ? [`public/projects/${slug}`] : []), ...(existsSync(sitemapPath) ? ['public/sitemap.xml'] : [])]\n        await git(exec, dir, 'add', '--', ...paths)\n        await git(exec, dir, 'commit', '-m', `Add article ${slug} (PostKit)\\n\\nPublished from PostKit post ${post._id}.`)\n        const diffStat = await git(exec, dir, 'diff', '--stat', `${base}..${branch}`)\n        const liveUrl = `${meta.publicUrl}/reels/${slug}`\n\n        if (!meta.deploy) {\n          return { handoff: { kind: 'website', branch, worktree: dir, baseBranch: base, slug, projectId: card.id, diffStat, liveUrl, steps: [`Review the branch ${branch} (git -C ${meta.repoPath} diff ${base}..${branch}).`, `Merge it into ${base}, then deploy: npm run build && npx wrangler pages deploy dist --project-name ${meta.pagesProject}.`, 'Complete this target with the live URL, or enable deploy on the account to let PostKit do it.'] } }\n        }\n\n        // Deploy mode: explicit and public. Build in the worktree (node_modules linked from the repo), upload with Wrangler, verify.\n        if (!existsSync(join(dir, 'node_modules')) && existsSync(join(meta.repoPath, 'node_modules'))) symlinkSync(join(meta.repoPath, 'node_modules'), join(dir, 'node_modules'))\n        await exec('npm', ['run', 'build'], { cwd: dir })\n        await exec('npx', ['wrangler', 'pages', 'deploy', 'dist', '--project-name', meta.pagesProject, '--branch', base], { cwd: dir })\n        // A request made before the deploy can cache the SPA fallback for the bare URL: always verify with a cache-buster.\n        const check = await http.request(`${liveUrl}?cb=${now.getTime()}`, { expect: 'text' })\n        if (!check.ok) throw new ApiError(502, 'deploy_unverified', `Deployed, but ${liveUrl} answered ${check.status}. Check the deployment before announcing it.`)\n        return { platformPostId: slug, platformPostUrl: liveUrl }\n      } finally {\n        if (!meta.deploy) { /* the staged worktree is kept for review */ } else { await exec('git', ['worktree', 'remove', '--force', dir], { cwd: meta.repoPath, allowFail: true }); rmSync(dir, { recursive: true, force: true }) }\n      }\n    },\n  })\n}\nEOF\ncat > test/connectors-new.test.js <<'EOF'\n// 3 October 2026 : Tests for the three added integrations. LinkedIn against a recorded fake API, ArtStation handoff end to end,\n// the website connector on a real temporary git repository shaped like ZenRayWebsite.\nimport { test } from 'node:test'\nimport assert from 'node:assert/strict'\nimport { mkdtempSync, mkdirSync, writeFileSync, readFileSync, existsSync } from 'node:fs'\nimport { tmpdir } from 'node:os'\nimport { join } from 'node:path'\nimport { execFileSync } from 'node:child_process'\nimport { makeApp, seed } from './helpers.js'\nimport { insertProjectCard, slugify, contentToBlocks } from '../src/platforms/connectors/website.js'\nimport { hashtagsOf } from '../src/platforms/connectors/artstation.js'\nimport { hasMagick } from '../src/lib/image.js'\n\nconst PNG = (() => { try { return execFileSync('magick', ['-size', '40x30', 'xc:red', 'png:-']) } catch { return null } })()\nconst json = (data, status = 200, headers = {}) => new Response(JSON.stringify(data), { status, headers: { 'content-type': 'application/json', ...headers } })\n\ntest('LinkedIn: connect form builds the official authorize URL', async () => {\n  const h = await makeApp({ env: { POSTKIT_LINKEDIN_CLIENT_ID: 'cid', POSTKIT_LINKEDIN_CLIENT_SECRET: 'sec', POSTKIT_PUBLIC_URL: 'https://pk.example' } })\n  const { profile } = await seed(h)\n  const r = await h.call('GET', `/v1/connect/linkedin?profileId=${profile.id}`)\n  assert.equal(r.status, 200)\n  const u = new URL(r.data.authUrl)\n  assert.equal(u.origin + u.pathname, 'https://www.linkedin.com/oauth/v2/authorization')\n  assert.equal(u.searchParams.get('scope'), 'openid profile w_member_social')\n  assert.equal(u.searchParams.get('redirect_uri'), 'https://pk.example/v1/connect/linkedin/callback')\n  const noCreds = await (await makeApp()).call('GET', '/v1/connect/linkedin?profileId=x')\n  assert.ok([400, 404].includes(noCreds.status))\n})\n\ntest('LinkedIn: callback exchanges the code, reads the member id, stores a sealed token with its 60-day expiry', async () => {\n  const log = []\n  const fetchImpl = async (url, init) => {\n    log.push({ url: String(url), init })\n    if (String(url).includes('oauth/v2/accessToken')) return json({ access_token: 'AT', expires_in: 5184000 })\n    if (String(url).endsWith('/v2/userinfo')) return json({ sub: 'abc123', name: 'Matthieu Huguet', picture: 'https://img/p.jpg' })\n    return json({})\n  }\n  const h = await makeApp({ fetchImpl, env: { POSTKIT_LINKEDIN_CLIENT_ID: 'cid', POSTKIT_LINKEDIN_CLIENT_SECRET: 'sec' } })\n  const { profile } = await seed(h)\n  const { authUrl } = (await h.call('GET', `/v1/connect/linkedin?profileId=${profile.id}`)).data\n  const state = new URL(authUrl).searchParams.get('state')\n  const cb = await h.call('GET', `/v1/connect/linkedin/callback?code=XYZ&state=${state}`, { token: null })\n  assert.equal(cb.status, 200)\n  const acc = cb.data.accounts[0]\n  assert.equal(acc.externalId, 'abc123'); assert.equal(acc.metadata.urn, 'urn:li:person:abc123'); assert.equal(acc.verification, 'mock')\n  assert.equal(acc.capabilities.analytics, false, 'honest: reading needs a restricted permission')\n  assert.ok(acc.tokenExpiresAt.startsWith('2026-12-02'), '60 days after 3 October 2026')\n  assert.match(log[0].init.body, /grant_type=authorization_code/)\n  assert.ok(!JSON.stringify(acc).includes('AT'), 'the token is not in the account')\n  assert.equal((await h.call('GET', `/v1/connect/linkedin/callback?code=XYZ&state=${state}`, { token: null })).status, 404, 'state is single use')\n})\n\nasync function linkedinAccount(h, fetchLog) {\n  const { profile } = await seed(h)\n  const acc = (await h.call('POST', '/v1/accounts/connect', { body: { platform: 'linkedin', profileId: profile.id, externalId: 'abc123', username: 'Matthieu', accessToken: 'AT', metadata: { urn: 'urn:li:person:abc123' } } })).data\n  const { putSecret } = await import('../src/domain/secrets.js')\n  await putSecret(h.ctx, acc.id, { accessToken: 'AT', expiresAt: '2026-12-01T00:00:00Z' })\n  return { profile, acc }\n}\n\ntest('LinkedIn: text post sends the official body with versioned headers and returns the URN as the post id', async () => {\n  const log = []\n  const fetchImpl = async (url, init) => { log.push({ url: String(url), init }); return new Response(null, { status: 201, headers: { 'x-restli-id': 'urn:li:share:777' } }) }\n  const h = await makeApp({ fetchImpl })\n  const { profile, acc } = await linkedinAccount(h)\n  const r = (await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'Shipped PostKit #buildinpublic', accountIds: [acc.id], publishNow: true } })).data\n  assert.equal(r.status, 'published'); assert.equal(r.targets[0].platformPostId, 'urn:li:share:777')\n  assert.equal(r.targets[0].platformPostUrl, 'https://www.linkedin.com/feed/update/urn:li:share:777/')\n  const call = log.find((c) => c.url.endsWith('/rest/posts'))\n  assert.equal(call.init.headers['linkedin-version'], '202609'); assert.equal(call.init.headers['x-restli-protocol-version'], '2.0.0'); assert.equal(call.init.headers.authorization, 'Bearer AT')\n  const body = JSON.parse(call.init.body)\n  assert.equal(body.author, 'urn:li:person:abc123'); assert.equal(body.visibility, 'PUBLIC'); assert.equal(body.lifecycleState, 'PUBLISHED'); assert.equal(body.distribution.feedDistribution, 'MAIN_FEED')\n})\n\ntest('LinkedIn: images upload through initializeUpload then PUT, 1 image is content.media, 3 images are content.multiImage', async () => {\n  const log = []\n  let n = 0\n  const fetchImpl = async (url, init) => {\n    const u = String(url); log.push({ url: u, init })\n    if (u.includes('/rest/images?action=initializeUpload')) { n += 1; return json({ value: { uploadUrl: `https://www.linkedin.com/dms-uploads/img${n}`, image: `urn:li:image:IMG${n}` } }) }\n    if (u.includes('dms-uploads')) return new Response(null, { status: 201 })\n    if (u.endsWith('/rest/posts')) return new Response(null, { status: 201, headers: { 'x-restli-id': 'urn:li:share:9' } })\n    if (u.startsWith('https://cdn.test/')) return new Response(Buffer.from('imagebytes'), { status: 200, headers: { 'content-type': 'image/jpeg' } })\n    return json({})\n  }\n  const h = await makeApp({ fetchImpl })\n  const { profile, acc } = await linkedinAccount(h)\n  const one = (await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'one', accountIds: [acc.id], mediaItems: [{ url: 'https://cdn.test/a.jpg', altText: 'alt A' }], publishNow: true } })).data\n  assert.equal(one.status, 'published')\n  let post = JSON.parse(log.filter((c) => c.url.endsWith('/rest/posts')).pop().init.body)\n  assert.deepEqual(post.content, { media: { id: 'urn:li:image:IMG1', altText: 'alt A' } })\n  assert.equal(log.find((c) => c.url.endsWith('/img1')).init.method, 'PUT')\n  const three = (await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'three', accountIds: [acc.id], mediaItems: [{ url: 'https://cdn.test/a.jpg' }, { url: 'https://cdn.test/b.jpg' }, { url: 'https://cdn.test/c.jpg' }], publishNow: true } })).data\n  assert.equal(three.status, 'published')\n  post = JSON.parse(log.filter((c) => c.url.endsWith('/rest/posts')).pop().init.body)\n  assert.equal(post.content.multiImage.images.length, 3)\n  const mixed = await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'mix', accountIds: [acc.id], mediaItems: [{ url: 'https://cdn.test/a.jpg' }, { url: 'https://cdn.test/v.mp4' }] } })\n  assert.equal(mixed.status, 400); assert.match(mixed.data.error.message, /cannot be mixed/)\n})\n\ntest('LinkedIn: a video is split in 4 MiB parts, each part ETag is sent back in order to finalizeUpload', async () => {\n  const log = []\n  const video = Buffer.alloc(4 * 1024 * 1024 + 100, 1)\n  const fetchImpl = async (url, init) => {\n    const u = String(url); log.push({ url: u, init })\n    if (u.includes('/rest/videos?action=initializeUpload')) return json({ value: { video: 'urn:li:video:V1', uploadToken: 'tok', uploadInstructions: [{ uploadUrl: 'https://www.linkedin.com/dms-uploads/p1', firstByte: 0, lastByte: 4194303 }, { uploadUrl: 'https://www.linkedin.com/dms-uploads/p2', firstByte: 4194304, lastByte: 4194403 }] } })\n    if (u.endsWith('/p1')) return new Response(null, { status: 200, headers: { etag: '\"etag-one\"' } })\n    if (u.endsWith('/p2')) return new Response(null, { status: 200, headers: { etag: '\"etag-two\"' } })\n    if (u.includes('finalizeUpload')) return new Response(null, { status: 200 })\n    if (u.endsWith('/rest/posts')) return new Response(null, { status: 201, headers: { 'x-restli-id': 'urn:li:share:V' } })\n    if (u.startsWith('https://cdn.test/')) return new Response(video, { status: 200 })\n    return json({})\n  }\n  const h = await makeApp({ fetchImpl })\n  const { profile, acc } = await linkedinAccount(h)\n  const r = (await h.call('POST', '/v1/posts', { body: { profileId: profile.id, title: 'Reel', content: 'video', accountIds: [acc.id], mediaItems: [{ url: 'https://cdn.test/v.mp4' }], publishNow: true } })).data\n  assert.equal(r.status, 'published')\n  const init = JSON.parse(log.find((c) => c.url.includes('/rest/videos?action=initializeUpload')).init.body)\n  assert.equal(init.initializeUploadRequest.fileSizeBytes, video.length); assert.equal(init.initializeUploadRequest.owner, 'urn:li:person:abc123')\n  assert.equal(log.find((c) => c.url.endsWith('/p1')).init.body.length, 4194304); assert.equal(log.find((c) => c.url.endsWith('/p2')).init.body.length, 100)\n  const fin = JSON.parse(log.find((c) => c.url.includes('finalizeUpload')).init.body)\n  assert.deepEqual(fin.finalizeUploadRequest.uploadedPartIds, ['etag-one', 'etag-two'])\n  assert.deepEqual(JSON.parse(log.filter((c) => c.url.endsWith('/rest/posts')).pop().init.body).content.media, { title: 'Reel', id: 'urn:li:video:V1' })\n})\n\ntest('LinkedIn: an expired token fails the target with a clear reason, flags needsReconnection and emits account.disconnected; unpublish uses DELETE', async () => {\n  const log = []\n  const fetchImpl = async (url, init) => { log.push({ url: String(url), init }); return new Response(null, { status: url.toString().endsWith('/rest/posts') ? 201 : 204, headers: { 'x-restli-id': 'urn:li:share:5' } }) }\n  const h = await makeApp({ fetchImpl })\n  const { profile, acc } = await linkedinAccount(h)\n  const wh = (await h.call('POST', '/v1/webhooks', { body: { url: 'http://localhost:9/h', events: ['account.disconnected'] } })).data\n  h.clock.set('2026-12-05T00:00:00Z')\n  const r = (await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'late', accountIds: [acc.id], publishNow: true } })).data\n  assert.equal(r.status, 'failed'); assert.match(r.targets[0].error, /expired/)\n  assert.equal((await h.call('GET', `/v1/accounts/${acc.id}`)).data.needsReconnection, true)\n  const deliveries = (await h.call('GET', `/v1/webhooks/${wh.id}/deliveries`)).data.deliveries\n  assert.equal(deliveries.length, 1)\n  h.clock.set('2026-10-10T00:00:00Z')\n  const { putSecret } = await import('../src/domain/secrets.js'); await putSecret(h.ctx, acc.id, { accessToken: 'AT', expiresAt: '2026-12-01T00:00:00Z' })\n  await h.ctx.store.put('accounts', { ...(await h.ctx.store.get('accounts', acc.id)), needsReconnection: false, disconnectedReason: null })\n  const ok = (await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'ok', accountIds: [acc.id], publishNow: true } })).data\n  assert.equal(ok.status, 'published')\n  const un = (await h.call('POST', `/v1/posts/${ok.id}/unpublish`)).data\n  assert.equal(un.results[0].unpublished, true)\n  const del = log.find((c) => c.init?.method === 'DELETE')\n  assert.match(del.url, /\\/rest\\/posts\\/urn%3Ali%3Ashare%3A5$/)\n})\n\ntest('ArtStation: handoff package is prepared, the target waits, completing it records the URL and emits post.published', async () => {\n  const h = await makeApp()\n  const { profile } = await seed(h)\n  const acc = (await h.call('POST', '/v1/accounts/connect', { body: { platform: 'artstation', profileId: profile.id, externalId: 'zenray', username: 'zenray', metadata: { profileUrl: 'https://www.artstation.com/zenray' } } })).data\n  assert.equal(acc.verification, 'handoff')\n  const wh = (await h.call('POST', '/v1/webhooks', { body: { url: 'http://localhost:9/h', events: ['post.published'] } })).data\n  const r = (await h.call('POST', '/v1/posts', { body: { profileId: profile.id, title: 'Louisiana Bayou Church', content: 'Procedural church in Houdini. #houdini #unrealengine', accountIds: [acc.id], mediaItems: [{ url: 'https://cdn.test/a.jpg', type: 'image' }], artstation: { software: ['Houdini', 'Unreal Engine'], category: 'Environments' }, publishNow: true } })).data\n  assert.equal(r.status, 'awaiting_manual')\n  const hand = r.targets[0].handoff\n  assert.equal(hand.kind, 'artstation'); assert.deepEqual(hand.tags, ['houdini', 'unrealengine']); assert.deepEqual(hand.software, ['Houdini', 'Unreal Engine'])\n  assert.equal(hand.description, 'Procedural church in Houdini.'); assert.equal(hand.openUrl, 'https://www.artstation.com/zenray'); assert.ok(hand.steps.length >= 4)\n  assert.equal((await h.call('GET', '/v1/dashboard')).data.queue.awaitingManual.length, 1)\n  assert.equal((await h.call('POST', `/v1/posts/${r.id}/targets/${acc.id}/complete`, { body