ord', default: 'INFO' }, { key: 'link', label: 'Link to send', default: 'https://example.com/guide' }, { key: 'dmText', label: 'Message', default: 'Here it is 👇' }, { key: 'buttonLabel', label: 'Button label', default: 'Get the link' }] },\n  { slug: 'waitlist', name: 'Waitlist', description: 'A keyword comment adds the person to a waitlist and a follow-up announces the launch.', slots: [{ key: 'account', label: 'Instagram or Facebook Page account', platforms: ['instagram', 'facebook', 'sandbox'] }], inputs: [{ key: 'keyword', label: 'Keyword', default: 'LIST' }, { key: 'dmText', label: 'Confirmation', default: 'You are on the list! I will message you at launch.' }, { key: 'followUp', label: 'Launch message', default: 'It is live! Thank you for waiting.' }, { key: 'delayMinutes', label: 'Follow-up delay in minutes', default: 10080 }] },\n  { slug: 'welcome-message', name: 'Welcome message', description: 'A short welcome for anyone who opens a new conversation.', slots: [{ key: 'account', label: 'Messaging account', platforms: ['instagram', 'facebook', 'whatsapp', 'telegram', 'sandbox'] }], inputs: [{ key: 'text', label: 'Welcome text', default: 'Hi! Thanks for reaching out, I will reply as soon as I can.' }] },\n])\n\nexport const listPlaybooks = () => ({ playbooks: PLAYBOOKS.map(({ slug, name, description }) => ({ slug, name, description })) })\nexport function getPlaybook(slug) { const p = PLAYBOOKS.find((x) => x.slug === slug); if (!p) throw new ApiError(404, 'not_found', 'Playbook not found.'); return p }\nexport async function listInstalls(ctx) { return { installs: (await listOwned(ctx, 'playbookInstalls')).map(view) } }\n\nexport async function installPlaybook(ctx, slug, { accounts = {}, inputs = {}, force = false }) {\n  const pb = getPlaybook(slug)\n  for (const s of pb.slots) if (!accounts[s.key]) throw badRequest(`Slot \"${s.key}\" must be filled with an account id.`)\n  const account = await owned(ctx, 'accounts', accounts.account, 'Account')\n  if (!pb.slots[0].platforms.includes(account.platform)) throw badRequest(`This playbook does not run on ${account.platform}.`)\n  if (!force && (await listOwned(ctx, 'playbookInstalls', (i) => i.slug === slug && i.accountId === account._id)).length) throw conflict('This playbook already runs on this account. Pass force to install a second copy: two copies send two DMs for one comment.')\n  const v = Object.fromEntries(pb.inputs.map((i) => [i.key, inputs[i.key] ?? i.default]))\n  const resources = []\n  if (slug === 'comment-to-dm-lead-magnet') {\n    const a = await createAutomation(ctx, { accountId: account._id, name: pb.name, keywords: [v.keyword], matchType: 'contains', dmText: fill(v.dmText, v), dmButtonLabel: v.buttonLabel, dmButtonUrl: v.link, publicReplyText: v.publicReply, oncePerUser: true })\n    resources.push({ type: 'automation', id: a._id })\n  } else if (slug === 'story-lead-magnet') {\n    const s = await createSequence(ctx, { accountId: account._id, name: pb.name, trigger: 'story_reply', keywords: [v.keyword], matchType: 'contains', stopOnReply: true, steps: [{ delayMinutes: 0, text: v.dmText, buttonLabel: v.buttonLabel, buttonUrl: v.link }] })\n    resources.push({ type: 'sequence', id: s._id })\n  } else if (slug === 'waitlist') {\n    const a = await createAutomation(ctx, { accountId: account._id, name: `${pb.name}: signup`, keywords: [v.keyword], matchType: 'contains', dmText: v.dmText, oncePerUser: true })\n    const s = await createSequence(ctx, { accountId: account._id, name: `${pb.name}: launch`, trigger: 'comment_automation', automationId: a._id, stopOnReply: false, steps: [{ delayMinutes: Number(v.delayMinutes), text: v.followUp }] })\n    resources.push({ type: 'automation', id: a._id }, { type: 'sequence', id: s._id })\n  } else if (slug === 'welcome-message') {\n    const s = await createSequence(ctx, { accountId: account._id, name: pb.name, trigger: 'conversation_started', stopOnReply: false, steps: [{ delayMinutes: 0, text: v.text }] })\n    resources.push({ type: 'sequence', id: s._id })\n  }\n  return view(await ctx.store.put('playbookInstalls', stamp(ctx, { _id: newId(PREFIX.playbookInstall), workspaceId: ctx.actor.workspaceId, slug, accountId: account._id, inputs: v, resources, status: 'active' }, { isNew: true })))\n}\n\nexport async function removeInstall(ctx, id, { keepResources = false } = {}) {\n  const inst = await owned(ctx, 'playbookInstalls', id, 'Playbook install')\n  if (!keepResources) for (const r of inst.resources) { if (r.type === 'automation') await ctx.store.del('automations', r.id); else await deleteSequence(ctx, r.id) }\n  await ctx.store.del('playbookInstalls', id)\n  return { success: true, keptResources: keepResources }\n}\nEOF\nnode -e \"import('./src/domain/campaigns.js').then(()=>console.log('campaigns ok'))\"","description":"Fix analytics queue logic; write campaigns, sequences, broadcasts, playbooks"}},"serverClassifierRequest":"bf57889a-d4e1-4c02-b23b-3c760abbc57c","apiBlockIndex":1,"requestId":"req_011Cff3C8bxDuoJp2YqGjhMr","attributionSkill":"zenrayprogress-context","type":"assistant","uuid":"c2546edb-9b8d-4c1f-ac6a-356c4796fe58","timestamp":"2026-10-03T09:08:02.291Z","effort":"xhigh","perTurnEffort":"xhigh","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/.claude/Memory1","sessionId":"00ffe75e-952c-45fc-88a9-6f1bb05adeb3","version":"2.1.286","gitBranch":"main"}
