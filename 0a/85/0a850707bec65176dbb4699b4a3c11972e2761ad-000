turn view(await ctx.store.put('broadcasts', stamp(ctx, b)))\n}\nexport async function cancelBroadcast(ctx, id) {\n  const b = await owned(ctx, 'broadcasts', id, 'Broadcast')\n  if (b.status !== 'scheduled') throw conflict('Only a scheduled broadcast can be put back to draft.')\n  b.status = 'draft'; b.scheduledFor = null\n  return view(await ctx.store.put('broadcasts', stamp(ctx, b)))\n}\nexport async function broadcastRecipients(ctx, id) {\n  await owned(ctx, 'broadcasts', id, 'Broadcast')\n  return { recipients: (await ctx.store.all('broadcastRecipients')).filter((r) => r.broadcastId === id).map(view) }\n}\n\n// The audience is resolved ONCE, when sending starts, and written down: a conversation that arrives mid-send is not silently added,\n// and a retry after a partial failure never messages anyone twice. (3 October 2026)\nexport async function runDueBroadcasts(ctx) {\n  const now = ctx.clock.now()\n  const done = []\n  for (const b of (await ctx.store.all('broadcasts')).filter((x) => (x.status === 'scheduled' && x.scheduledFor && new Date(x.scheduledFor) <= now) || x.status === 'sending')) {\n    const sub = { ...ctx, actor: { ...ctx.actor, workspaceId: b.workspaceId } }\n    const account = await ctx.store.get('accounts', b.accountId)\n    let recipients = (await ctx.store.all('broadcastRecipients')).filter((r) => r.broadcastId === b._id)\n    if (b.status === 'scheduled') {\n      const aud = await resolveAudience(ctx, account, b.audience)\n      recipients = []\n      for (const c of aud) recipients.push(await ctx.store.put('broadcastRecipients', { _id: newId(PREFIX.recipient), workspaceId: b.workspaceId, broadcastId: b._id, conversationId: c._id, contactHandle: c.contactHandle, status: 'pending', reason: null }))\n      b.status = 'sending'; b.counts.total = recipients.length; b.startedAt = now.toISOString()\n    }\n    for (const r of recipients.filter((x) => x.status === 'pending').slice(0, CONFIG.scheduler.batchSize)) {\n      try { await sendMessage(sub