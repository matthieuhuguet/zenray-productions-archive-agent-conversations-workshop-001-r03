ther', body, header, { now: 1_700_000_100_000 }), 'wrong secret')\n  assert.ok(!verifyWebhook(secret, body, header, { now: 1_700_001_000_000 }), 'replay older than 5 minutes')\n})\n\ntest('secrets are sealed with AES-GCM and fail closed with another key', () => {\n  const key = deriveMasterKey('correct horse')\n  const sealed = seal(key, { accessToken: 'tok' })\n  assert.deepEqual(unseal(key, sealed), { accessToken: 'tok' })\n  assert.throws(() => unseal(deriveMasterKey('wrong'), sealed))\n})\n\ntest('validator enforces required, enum, length and nested items', () => {\n  const comps = { Item: { type: 'object', required: ['url'], properties: { url: { type: 'string' }, type: { type: 'string', enum: ['image', 'video'] } } } }\n  const schema = { type: 'object', required: ['name'], properties: { name: { type: 'string', maxLength: 3 }, items: { type: 'array', items: { $ref: '#/components/schemas/Item' } } } }\n  assert.deepEqual(validate(schema, { name: 'ab' }, comps), [])\n  assert.match(validate(schema, {}, comps)[0], /name is required/)\n  assert.match(validate(schema, { name: 'abcd' }, comps)[0], /longer than 3/)\n  assert.match(validate(schema, { name: 'a', items: [{ type: 'gif' }] }, comps).join(' '), /url is required/)\n  assert.match(validate(schema, { name: 'a', items: [{ url: 'x', type: 'gif' }] }, comps).join(' '), /one of image, video/)\n})\n\ntest('MemoryStore clones on read and write; FileStore persists across instances', async () => {\n  const s = new MemoryStore()\n  const doc = { _id: 'a', n: 1 }\n  await s.put('things', doc); doc.n = 99\n  assert.equal((await s.get('things', 'a')).n, 1)\n  const dir = mkdtempSync(join(tmpdir(), 'postkit-'))\n  const f1 = new FileStore(dir)\n  await f1.put('things', { _id: 'x', v: 'kept' }); await f1.putBlob('b1', Buffer.from('hello'), { type: 'text/plain' }); await f1.flush()\n  const f2 = new FileStore(dir)\n  assert.equal((await f2.get('things', 'x')).v, 'kept')\n  assert.equal((await f2.getBlob('b1')).bytes.toString