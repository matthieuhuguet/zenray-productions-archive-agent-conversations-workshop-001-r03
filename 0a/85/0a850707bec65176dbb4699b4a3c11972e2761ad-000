reads({ secret }) { return (await g(secret).get('/me/conversations', { platform: 'instagram', fields: 'id,participants,updated_time' })).data || [] },\n    async subscribeWebhooks({ account, secret }) { await g(secret).post(`/${uid(account)}/subscribed_apps`, { subscribed_fields: 'messages,comments,messaging_postbacks,mentions' }, 'subscribe webhooks'); return { subscribed: true } },\n\n    // Shopping (product tags). Needs a second Facebook authorization that the user grants from the dashboard. (3 October 2026)\n    async shoppingStatus({ account, secret }) {\n      const r = await g(secret).get(`/${uid(account)}`, { fields: 'shopping_product_tag_eligibility' })\n      return { eligible: !!r.shopping_product_tag_eligibility, details: r }\n    },\n    async shoppingAuthorize() { throw unsupported('Product tagging authorization is granted by the user from the dashboard Connections page.') },\n    async shoppingOff() { return { success: true } },\n    async shoppingProducts({ account, secret, q }) {\n      const r = await g(secret).get(`/${uid(account)}/available_catalogs`, {})\n      const catalog = r.data?.[0]?.catalog_id\n      if (!catalog) return { products: [], reason: 'No shop catalogue is attached to this account.' }\n      const p = await g(secret).get(`/${catalog}/products`, { q: q?.query, fields: 'product_id,product_name,review_status,is_checkout_flow' })\n      return { products: (p.data || []).map((x) => ({ id: x.product_id, name: x.product_name, reviewStatus: x.review_status, taggable: x.review_status === 'approved' })) }\n    },\n    async shoppingTag({ secret, mediaId, productTags }) {\n      await g(secret).postJson(`/${mediaId}/product_tags`, { updated_tags: productTags.map((t) => ({ product_id: t.productId, ...(t.x !== undefined ? { x: t.x, y: t.y } : {}) })) }, 'tag products')\n      return { success: true, mediaId, tags: productTags.length }\n    },\n  })\n}\n\n// Button template when a button is given (a bare link in a DM is what Meta flags); pla