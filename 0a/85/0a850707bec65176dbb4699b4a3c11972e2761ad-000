ields) => fields.some((f) => String(f ?? '').toLowerCase().includes(needle))\n\nexport async function search(ctx, { query }) {\n  if (!query) throw badRequest('query is required.')\n  const m = has(String(query).toLowerCase())\n  const results = []\n  const add = (type, id, title, text) => results.push({ id: `${type}:${id}`, title, text: String(text || '').slice(0, 200), url: `postkit://${type}/${id}` })\n  for (const p of await listOwned(ctx, 'posts', (x) => m(x.content, x.title, x.status))) add('post', p._id, p.title || `Post ${p.status}`, p.content)\n  for (const c of await listOwned(ctx, 'conversations', (x) => m(x.contactHandle, x.contactName))) add('conversation', c._id, `Conversation with ${c.contactName || c.contactHandle}`, c.lastMessagePreview)\n  const messages = (await listOwned(ctx, 'messages', (x) => m(x.text)))\n  for (const msg of messages.slice(0, 20)) { const c = await ctx.store.get('conversations', msg.conversationId); if (c) add('conversation', c._id, `Conversation with ${c.contactName || c.contactHandle}`, msg.text) }\n  for (const a of await listOwned(ctx, 'accounts', (x) => m(x.username, x.displayName, x.platform))) add('account', a._id, `${a.platform} @${a.username}`, a.displayName)\n  for (const p of await listOwned(ctx, 'profiles', (x) => m(x.name, x.description))) add('profile', p._id, p.name, p.description)\n  for (const f of await listOwned(ctx, 'media', (x) => m(x.filename))) add('media', f._id, f.filename, f.type)\n  for (const a of await listOwned(ctx, 'automations', (x) => m(x.name, x.dmText, ...(x.keywords || [])))) add('automation', a._id, a.name, a.dmText)\n  for (const s of await listOwned(ctx, 'sequences', (x) => m(x.name))) add('sequence', s._id, s.name, `${s.steps.length} steps`)\n  for (const b of await listOwned(ctx, 'broadcasts', (x) => m(x.name, x.text))) add('broadcast', b._id, b.name, b.text)\n  for (const p of PLAYBOOKS.filter((x) => m(x.slug, x.name, x.description))) add('playbook', p.slug, p.name, p.description)\n  re