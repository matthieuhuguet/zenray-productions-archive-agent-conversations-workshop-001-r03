)\n  const g = (...a) => execFileSync('git', a, { cwd: dir, stdio: 'pipe' })\n  g('init', '-q', '-b', 'master'); g('config', 'user.email', 't@t'); g('config', 'user.name', 't')\n  mkdirSync(join(dir, 'public', 'articles'), { recursive: true }); mkdirSync(join(dir, 'src'), { recursive: true })\n  writeFileSync(join(dir, 'public', 'articles', 'index.json'), JSON.stringify({ items: [{ slug: 'old', title: 'Old', subtitle: '' }] }))\n  writeFileSync(join(dir, 'public', 'sitemap.xml'), '<?xml version=\"1.0\"?>\\n<urlset>\\n</urlset>\\n')\n  writeFileSync(join(dir, 'src', 'App.jsx'), 'const PROJECTS = [\\n  {\\n    id: 41,\\n    title: \"Old Post\",\\n    articleSlug: \"old\",\\n  },\\n]\\n')\n  g('add', '.'); g('commit', '-q', '-m', 'init')\n  writeFileSync(join(dir, 'DIRTY.txt'), 'owner has uncommitted work') // the owner's tree is dirty: it must stay exactly so\n  return dir\n}\n\ntest('Website stage mode: a clean worktree branch gets the article, images, index, sitemap and card; the owner tree is untouched', { skip: !PNG && 'magick not installed' }, async () => {\n  const repo = makeSiteRepo()\n  const fetchImpl = async (url) => (String(url).startsWith('https://cdn.test/') ? new Response(PNG, { status: 200, headers: { 'content-type': 'image/png' } }) : new Response('{}', { status: 200 }))\n  const h = await makeApp({ fetchImpl })\n  const { profile } = await seed(h)\n  const site = (await h.call('POST', '/v1/accounts/connect', { body: { platform: 'website', profileId: profile.id, externalId: 'matthieuhuguet.com', username: 'matthieuhuguet.com', metadata: { repoPath: repo, publicUrl: 'https://matthieuhuguet.com', pagesProject: 'matthieu-huguet', deploy: false } } })).data\n  const r = (await h.call('POST', '/v1/posts', { body: { profileId: profile.id, title: 'PostKit', content: 'PostKit publishes everywhere.\\n\\n- one API\\n- one inbox', accountIds: [site.id], mediaItems: [{ url: 'https://cdn.test/a.png', type: 'image', altText: 'Dashboard' }], publishNow: true } })).d