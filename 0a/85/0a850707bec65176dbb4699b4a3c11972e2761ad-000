ra?.config_id || '', scope: 'whatsapp_business_management,whatsapp_business_messaging' })}`\n    },\n    // The Embedded Signup front end hands back waba_id and phone_number_id; the callback receives them as query parameters. (3 October 2026)\n    async exchangeCode({ code, redirectUri, creds, query = {} }) {\n      const t = mustOk(await http.request(`${api.graphBase}/${api.graphVersion}/oauth/access_token?${new URLSearchParams({ client_id: creds.clientId, client_secret: creds.clientSecret, redirect_uri: redirectUri, code })}`), 'WhatsApp token exchange').data\n      const { waba_id: waba, phone_number_id: phone } = query\n      if (!waba || !phone) throw badRequest('Embedded Signup must return waba_id and phone_number_id.')\n      const info = await graph(http, api.graphBase, { version: api.graphVersion, token: t.access_token }).get(`/${phone}`, { fields: 'display_phone_number,verified_name' })\n      return { accounts: [{ externalId: phone, username: info.display_phone_number, displayName: info.verified_name || info.display_phone_number, secret: { accessToken: t.access_token }, tokenExpiresAt: null, metadata: { wabaId: waba, phoneNumberId: phone } }] }\n    },\n\n    async sendMessage({ account, secret, conversation, text, template, button }) {\n      const to = conversation.contactHandle\n      let message\n      if (template) {\n        const components = template.components || (template.variables?.length ? [{ type: 'body', parameters: template.variables.map((v) => ({ type: 'text', text: String(v) })) }] : [])\n        message = { type: 'template', template: { name: template.name, language: { code: template.language || 'en_US' }, ...(components.length ? { components } : {}) } }\n      } else if (button) message = { type: 'interactive', interactive: { type: 'cta_url', body: { text }, action: { name: 'cta_url', parameters: { display_text: button.label, url: button.url } } } }\n      else message = { type: 'text', text: { body: text } }\n      const r = await g(se