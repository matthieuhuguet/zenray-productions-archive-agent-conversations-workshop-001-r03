 calls, polling, metrics.\nimport { mustOk } from '../../lib/http.js'\nimport { ApiError } from '../../lib/errors.js'\n\nexport const sleep = (ms) => (ms > 0 ? new Promise((r) => setTimeout(r, ms)) : Promise.resolve())\n\nexport function graph(http, base, { version, token } = {}) {\n  const root = version ? `${base}/${version}` : base\n  const withAuth = (params = {}) => ({ ...params, access_token: token })\n  const qs = (o) => new URLSearchParams(Object.fromEntries(Object.entries(o).filter(([, v]) => v !== undefined && v !== null).map(([k, v]) => [k, typeof v === 'object' ? JSON.stringify(v) : String(v)]))).toString()\n  return {\n    async get(path, params, label = path) { return mustOk(await http.request(`${root}${path}?${qs(withAuth(params))}`), `Graph GET ${label}`).data },\n    async post(path, params = {}, label = path) { return mustOk(await http.request(`${root}${path}`, { method: 'POST', form: Object.fromEntries(new URLSearchParams(qs(withAuth(params)))) }), `Graph POST ${label}`).data },\n    async postJson(path, body, label = path) { return mustOk(await http.request(`${root}${path}?${qs({ access_token: token })}`, { method: 'POST', json: body }), `Graph POST ${label}`).data },\n    async del(path, params, label = path) { return mustOk(await http.request(`${root}${path}?${qs(withAuth(params))}`, { method: 'DELETE' }), `Graph DELETE ${label}`).data },\n  }\n}\n\n// Wait until a job reports a terminal state. `read()` returns { state, detail }. (3 October 2026)\nexport async function pollUntil(config, read, { ok = ['FINISHED'], fail = ['ERROR', 'EXPIRED'], what = 'processing' } = {}) {\n  for (let i = 0; i < config.polling.attempts; i += 1) {\n    const { state, detail } = await read()\n    if (ok.includes(state)) return state\n    if (fail.includes(state)) throw new ApiError(502, 'upstream_error', `The platform failed ${what}: ${state}${detail ? ` (${detail})` : ''}.`)\n    await sleep(config.polling.intervalMs)\n  }\n  throw new ApiError(504, 'upstream_timeout', `The platform did not finish ${what} in time.`)\n}\n\nexport const num = (v) => (typeof v === 'number' ? v : v === undefined || v === null ? null : Number(v))\nexport const insightMap = (data, rename = {}) => Object.fromEntries((data?.data || []).map((m) => [rename[m.name] || m.name, num(m.values?.[0]?.value ?? m.total_value?.value)]))\nEOF\ncat > src/platforms/connectors/instagram.js <<'EOF'\n// 3 October 2026 : Instagram connector: \"Instagram API with Instagram Login\" (graph.instagram.com). Professional accounts only.\n// Publishing is two steps (create a media container, then publish), polled for video. Verification level: mock (request shapes follow Meta's\n// documentation, no live call yet). Stories, reels (with trial mode), carousels, product tags, comments, private replies, DMs, insights.\nimport { defineConnector } from '../base.js'\nimport { ApiError, badRequest, unsupported } from '../../lib/errors.js'\nimport { mustOk } from '../../lib/http.js'\nimport { graph, pollUntil, insightMap, num } from './meta.js'\n\nconst SCOPES = ['instagram_business_basic', 'instagram_business_content_publish', 'instagram_business_manage_messages', 'instagram_business_manage_comments', 'instagram_business_manage_insights']\n\nexport function createInstagramConnector({ http, config }) {\n  const api = config.apis\n  const g = (secret) => graph(http, api.instagramBase, { version: api.graphVersion, token: secret.accessToken })\n  const uid = (account) => account.externalId\n\n  async function container(secret, account, params) {\n    const c = await g(secret).post(`/${uid(account)}/media`, params, 'create media container')\n    return c.id\n  }\n  async function waitContainer(secret, id) {\n    await pollUntil(config, async () => { const s = await g(secret).get(`/${id}`, { fields: 'status_code,status' }); return { state: s.status_code, detail: s.status } }, { what: 'media processing' })\n  }\n\n  return defineConnector({\n    platform: 'instagram', label: 'Instagram', verification: 'mock', auth: 'oauth',\n    requiredEnv: ['POSTKIT_INSTAGRAM_CLIENT_ID', 'POSTKIT_INSTAGRAM_CLIENT_SECRET'],\n    note: 'Needs an Instagram professional (business or creator) account. Media must be reachable by Instagram from a public URL.',\n    capabilities: { publish: true, messaging: true, comments: true, analytics: true, stories: true, privateReply: true, messagingWindow: true, externalPosts: true },\n    rules: { text: 'optional', maxChars: 2200, media: { min: 1, max: 10, types: ['image', 'video'] } },\n\n    validatePost(post, target) {\n      const media = target.customMedia ?? post.mediaItems\n      if (post.options.asStory && media.length !== 1) throw badRequest('An Instagram story takes exactly one media item (a JPEG image, or an MP4 or MOV of 3 to 60 seconds).')\n      if (post.options.asStory && media[0]?.url.toLowerCase().endsWith('.png')) throw badRequest('Instagram stories refuse PNG: use a JPEG image.')\n    },\n\n    authorizeUrl({ state, redirectUri, creds }) {\n      return `https://www.instagram.com/oauth/authorize?${new URLSearchParams({ client_id: creds.clientId, redirect_uri: redirectUri, response_type: 'code', scope: SCOPES.join(','), state })}`\n    },\n    async exchangeCode({ code, redirectUri, creds, now }) {\n      const short = mustOk(await http.request('https://api.instagram.com/oauth/access_token', { method: 'POST', form: { client_id: creds.clientId, client_secret: creds.clientSecret, grant_type: 'authorization_code', redirect_uri: redirectUri, code } }), 'Instagram token exchange').data\n      const long = mustOk(await http.request(`${api.instagramBase}/access_token?${new URLSearchParams({ grant_type: 'ig_exchange_token', client_secret: creds.clientSecret, access_token: short.access_token })}`), 'Instagram long-lived token').data\n      const me = await graph(http, api.instagramBase, { version: api.graphVersion, token: long.access_token }).get('/me', { fields: 'user_id,username,name,profile_picture_url,account_type' })\n      const expiresAt = new Date(now.getTime() + (long.expires_in || 5_184_000) * 1000).toISOString()\n      return { accounts: [{ externalId: String(me.user_id || short.user_id), username: me.username, displayName: me.name || me.username, avatarUrl: me.profile_picture_url || null, secret: { accessToken: long.access_token, expiresAt }, tokenExpiresAt: expiresAt, metadata: { accountType: me.account_type } }] }\n    },\n\n    async publish({ account, secret, post, target, media }) {\n      const caption = target.customContent ?? post.content ?? ''\n      const o = post.options\n      let id\n      if (o.asStory) {\n        const m = media[0]\n        id = await container(secret, account, { media_type: 'STORIES', ...(m.type === 'video' ? { video_url: m.url } : { image_url: m.url }) }) // no caption: Instagram drops it\n        if (m.type === 'video') await waitContainer(secret, id)\n      } else if (media.length > 1) {\n        const children = []\n        for (const m of media) { const cid = await container(secret, account, { is_carousel_item: true, ...(m.type === 'video' ? { media_type: 'VIDEO', video_url: m.url } : { image_url: m.url, alt_text: m.altText || undefined }) }); if (m.type === 'video') await waitContainer(secret, cid); children.push(cid) }\n        id = await container(secret, account, { media_type: 'CAROUSEL', children: children.join(','), caption })\n      } else if (media[0].type === 'video') {\n        id = await container(secret, account, { media_type: 'REELS', video_url: media[0].url, caption, share_to_feed: o.shareToFeed ?? true, ...(o.trialReel ? { trial_params: { graduation_strategy: o.trialGraduation || 'MANUAL' } } : {}), cover_url: media[0].thumbnail || undefined, product_tags: o.productTags?.length ? o.productTags.map((t) => ({ product_id: t.productId })) : undefined })\n        await waitContainer(secret, id)\n      } else {\n        id = await container(secret, account, { image_url: media[0].url, caption, alt_text: media[0].altText || undefined, product_tags: o.productTags?.length ? o.productTags.map((t) => ({ product_id: t.productId, x: t.x ?? 0.5, y: t.y ?? 0.5 })) : undefined })\n      }\n      const pub = await g(secret).post(`/${uid(account)}/media_publish`, { creation_id: id }, 'publish media')\n      // A story lasts 24 hours and has no permanent URL, so none is recorded.\n      const link = o.asStory ? null : (await g(secret).get(`/${pub.id}`, { fields: 'permalink' })).permalink\n      return { platformPostId: pub.id, platformPostUrl: link }\n    },\n\n    async listPosts({ account, secret }) {\n      const r = await g(secret).get(`/${uid(account)}/media`, { fields: 'id,caption,media_type,media_url,thumbnail_url,permalink,timestamp', limit: 50 })\n      return (r.data || []).map((m) => ({ platformPostId: m.id, permalink: m.permalink, caption: m.caption || null, thumbnailUrl: m.thumbnail_url || m.media_url || null, publishedAt: m.timestamp }))\n    },\n    async getPostMetrics({ secret, platformPostId }) {\n      try {\n        const ins = await g(secret).get(`/${platformPostId}/insights`, { metric: 'views,reach,likes,comments,shares,saved' })\n        const m = insightMap(ins, { saved: 'saves' })\n        // Meta retired media `impressions` in favour of `views`: an unavailable metric stays null, never 0.\n        return { views: m.views ?? null, reach: m.reach ?? null, likes: m.likes ?? null, comments: m.comments ?? null, shares: m.shares ?? null, saves: m.saves ?? null, impressions: null, clicks: null }\n      } catch (e) { if (e.details?.status === 404) return null; throw e }\n    },\n    async getAccountStats({ account, secret }) {\n      const r = await g(secret).get(`/${uid(account)}`, { fields: 'followers_count,follows_count,media_count' })\n      return { followers: num(r.followers_count), following: num(r.follows_count), postCount: num(r.media_count) }\n    },\n\n    async listEngagement({ account, secret, postId }) {\n      const ids = postId ? [postId] : (await g(secret).get(`/${uid(account)}/media`, { fields: 'id', limit: config.engagement.sweepRecentPosts })).data.map((m) => m.id)\n      const out = []\n      for (const id of ids) {\n        const r = await g(secret).get(`/${id}/comments`, { fields: 'id,text,username,timestamp,hidden,parent_id,from', limit: 50 })\n        for (const c of r.data || []) out.push({ platformCommentId: c.id, kind: 'comment', postId: id, parentId: c.parent_id || null, author: { handle: c.username || c.from?.username, name: c.username || c.from?.username }, text: c.text, hidden: c.hidden ?? null, isOwn: (c.username || c.from?.username) === account.username, publishedAt: c.timestamp })\n      }\n      return out\n    },\n    async replyToComment({ secret, comment, text }) { const r = await g(secret).post(`/${comment.platformCommentId}/replies`, { message: text }, 'reply to comment'); return { platformCommentId: r.id } },\n    async hideComment({ secret, comment, hidden }) { await g(secret).post(`/${comment.platformCommentId}`, { hide: hidden }, 'hide comment') },\n    async deleteComment({ secret, comment }) { await g(secret).del(`/${comment.platformCommentId}`, {}, 'delete comment') },\n    // Meta allows ONE private reply per comment, within 7 days. (3 October 2026)\n    async privateReply({ account, secret, comment, text, button }) {\n      return { platformMessageId: (await g(secret).postJson(`/${uid(account)}/messages`, { recipient: { comment_id: comment.platformCommentId }, message: messageBody(text, button) }, 'private reply')).message_id }\n    },\n    async sendMessage({ account, secret, conversation, text, button }) {\n      return { platformMessageId: (await g(secret).postJson(`/${uid(account)}/messages`, { recipient: { id: conversation.contactHandle }, message: messageBody(text, button) }, 'send message')).message_id }\n    },\n    async syncConversations({ secret }) {\n      const r = await g(secret).get('/me/conversations', { platform: 'instagram', fields: 'id,participants,messages.limit(20){id,message,from,created_time}' })\n      return (r.data || []).map((t) => { const other = t.participants?.data?.find((p) => p.id !== t.messages?.data?.[0]?.to?.data?.[0]?.id) || t.participants?.data?.[0]; return { externalConversationId: t.id, contactHandle: other?.id, contactName: other?.username, messages: (t.messages?.data || []).map((m) => ({ id: m.id, direction: m.from?.id === other?.id ? 'in' : 'out', text: m.message, at: m.created_time })) } })\n    },\n    async listThreads({ secret }) { return (await g(secret).get('/me/conversations', { platform: 'instagram', fields: 'id,participants,updated_time' })).data || [] },\n    async subscribeWebhooks({ account, secret }) { await g(secret).post(`/${uid(account)}/subscribed_apps`, { subscribed_fields: 'messages,comments,messaging_postbacks,mentions' }, 'subscribe webhooks'); return { subscribed: true } },\n\n    // Shopping (product tags). Needs a second Facebook authorization that the user grants from the dashboard. (3 October 2026)\n    async shoppingStatus({ account, secret }) {\n      const r = await g(secret).get(`/${uid(account)}`, { fields: 'shopping_product_tag_eligibility' })\n      return { eligible: !!r.shopping_product_tag_eligibility, details: r }\n    },\n    async shoppingAuthorize() { throw unsupported('Product tagging authorization is granted by the user from the dashboard Connections page.') },\n    async shoppingOff() { return { success: true } },\n    async shoppingProducts({ account, secret, q }) {\n      const r = await g(secret).get(`/${uid(account)}/available_catalogs`, {})\n      const catalog = r.data?.[0]?.catalog_id\n      if (!catalog) return { products: [], reason: 'No shop catalogue is attached to this account.' }\n      const p = await g(secret).get(`/${catalog}/products`, { q: q?.query, fields: 'product_id,product_name,review_status,is_checkout_flow' })\n      return { products: (p.data || []).map((x) => ({ id: x.product_id, name: x.product_name, reviewStatus: x.review_status, taggable: x.revi