wait h.call('GET', '/v1/profiles', { token: created.key })).status, 200)\n  const rolled = (await h.call('POST', `/v1/api-keys/${created.id}/roll`)).data\n  assert.equal((await h.call('GET', '/v1/profiles', { token: created.key })).status, 401, 'old key revoked')\n  assert.equal((await h.call('GET', '/v1/profiles', { token: rolled.key })).status, 200)\n})\n\ntest('publish now to a sandbox account, then the post is published with a URL; publishing again does not duplicate', async () => {\n  const h = await makeApp()\n  const { profile, account } = await seed(h)\n  const res = await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'Hello', accountIds: [account.id], publishNow: true } })\n  assert.equal(res.status, 201); assert.equal(res.data.status, 'published')\n  assert.match(res.data.targets[0].platformPostUrl, /sandbox\\.invalid/)\n  const again = await h.call('POST', `/v1/posts/${res.data.id}/publish`)\n  assert.equal(again.status, 202); assert.equal(again.data.status, 'published')\n  const world = await h.ctx.store.get('sandboxWorld', account.id)\n  assert.equal(world.posts.length, 1, 'exactly one post on the platform')\n})\n\ntest('scheduling reads the time in the given zone and the scheduler publishes when due', async () => {\n  const h = await makeApp({ now: '2026-12-31T00:00:00Z' })\n  const { profile, account } = await seed(h)\n  const p = (await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'NYE', accountIds: [account.id], scheduledFor: '2027-01-01T09:00:00', timezone: 'Europe/Paris' } })).data\n  assert.equal(p.status, 'scheduled'); assert.equal(p.scheduledFor, '2027-01-01T08:00:00.000Z')\n  await h.app.tick(); assert.equal((await h.call('GET', `/v1/posts/${p.id}`)).data.status, 'scheduled', 'not due yet')\n  h.clock.set('2027-01-01T08:00:01Z')\n  const rep = await h.app.tick(); assert.equal(rep.posts[0].status, 'published')\n  const rep2 = await h.app.tick(); assert.equal(rep2.posts.length, 0, 'second tick publishes nothing again (idempotent)')\n})\n\ntest('a post with a failing target is partial, the good target stays live, and a retry only sends the failed one', async () => {\n  const h = await makeApp()\n  const { profile, account } = await seed(h)\n  const acc2 = (await h.call('POST', '/v1/accounts/connect', { body: { platform: 'sandbox', profileId: profile.id, externalId: 'ext2', username: 'second' } })).data\n  const real = h.ctx.connectors.get('sandbox')\n  let failSecond = true\n  const original = real.publish\n  h.ctx.connectors.get('sandbox').publish = async (args) => { if (args.account.username === 'second' && failSecond) throw new Error('boom'); return original(args) }\n  const res = (await h.call('POST', '/v1/posts', { body: { profileId: profile.id, content: 'two', accountIds: [account.id, acc2.id], publishNow: true } })).data\n  assert.equal(res.status, 'partial')\n  assert.equal(res.targets.find((t) => t.accountId === account.id).status, 'published')\n  assert.equal(res.targets.find((t) => t.accountId === acc2.id).error, 'boom')\n  failSecond = false\n  await h.call('POST', `/v1/posts/${res.id}/publish`); await h.ctx.background.drain()\n  const after = (await h.call('GET', `/v1/posts/${res.id}`)).data\n  assert.equal(after.status, 'published')\n  const w1 = await h.ctx.store.get('sandboxWorld', account.id)\n  assert.equal(w1.posts.length, 1, 'the first account was not posted to twice')\n  h.ctx.connectors.get('sandbox').publish = original\n})\nEOF\nnode --test test/ 2>&1 | grep -E \"^(✔|✖|ℹ (tests|pass|fail))|Error|error:|expected|actual\" | head -40","description":"Write handler, app, server, CLI and first end-to-end tests"}},"serverClassifierRequest":"744b68c0-af6b-4146-ad99-9813fbcdefc9","apiBlockIndex":1,"requestId":"req_011Cff3RrmbixUfdD5oVuDfo","attributionSkill":"zenrayprogress-context","type":"assistant","uuid":"740886ae-38e5-41ae-ae60-a8bf8d60c481","timestamp":"2026-10-03T09:10:42.536Z","effort":"xhigh","perTurnEffort":"xhigh","userType":"external