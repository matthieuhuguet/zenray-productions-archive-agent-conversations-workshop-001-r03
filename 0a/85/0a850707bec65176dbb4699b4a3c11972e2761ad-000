ngestComment } from './engagement.js'\nimport { owned } from './common.js'\nimport { platformCreds } from './connect.js'\n\nasync function accountByExternal(ctx, platform, externalId) {\n  return (await ctx.store.all('accounts')).find((a) => a.platform === platform && a.externalId === String(externalId) && a.status === 'CONNECTED') || null\n}\n\nexport function verifyMetaSignature(secret, raw, header) {\n  const expected = `sha256=${createHmac('sha256', secret).update(raw).digest('hex')}`\n  return safeEqual(expected, header || '')\n}\n\nexport async function handleInbound(ctx, platform, request, accountId) {\n  const raw = await request.text()\n  let payload\n  try { payload = JSON.parse(raw) } catch { throw badRequest('Invalid JSON.') }\n  let handled = 0\n  if (platform === 'telegram') {\n    const expected = ctx.env.POSTKIT_TELEGRAM_WEBHOOK_SECRET\n    if (expected && !safeEqual(expected, request.headers.get('x-telegram-bot-api-secret-token') || '')) throw unauthorized('Bad Telegram secret token.')\n    const m = payload.message\n    const account = accountId ? await ctx.store.get('accounts', accountId) : null\n    if (m?.text && account) { await ingestInbound(ctx, account._id, { contactHandle: String(m.chat.id), contactName: m.chat.username || m.chat.first_name, text: m.text, platformMessageId: `${m.chat.id}:${m.message_id}`, at: new Date(m.date * 1000).toISOString() }); handled += 1 }\n    return { received: true, handled }\n  }\n  if (['instagram', 'facebook', 'whatsapp', 'threads'].includes(platform)) {\n    const secret = platformCreds(ctx, platform).clientSecret\n    if (!secret || !verifyMetaSignature(secret, raw, request.headers.get('x-hub-signature-256'))) throw unauthorized('Bad webhook signature.')\n    for (const entry of payload.entry || []) {\n      for (const ev of entry.messaging || []) {\n        const account = await accountByExternal(ctx, platform, entry.id)\n        if (account && ev.message?.text && !ev.message.is_echo) { await ingestInbound