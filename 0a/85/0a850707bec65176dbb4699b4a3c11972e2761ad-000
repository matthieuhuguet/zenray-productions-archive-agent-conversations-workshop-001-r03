{"parentUuid":"c67c83ee-59e2-4a76-9dcd-db2958173220","isSidechain":false,"message":{"model":"claude-sonnet-5-5","id":"msg_011Cff4qVM2VRdnAPVRBUxHs","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01VLcarh7GMPiKzWEhkwcL9g","name":"Bash","input":{"command":"cd /Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/src/postkit && cat > AnalyticsPanel.jsx <<'EOF'\n// 3 October 2026, 13:02 : Analytics, read from PostKit's own store. Two rules are visible on screen: a metric the platform does not expose is\n// \"n/a\" and never 0, and every answer shows how fresh it is. Charts are plain inline SVG: no chart library for a bar and a grid.\nimport React, { useMemo, useState } from 'react'\nimport { POSTKIT } from './postkitConfig.js'\nimport { useAction, useQuery } from './usePostKit.js'\nimport { qs } from './postkitClient.js'\nimport { Badge, Btn, Card, Empty, ErrorLine, Field, Metric, Num, PlatformDot, Tile, ago, change, metric } from './ui.jsx'\nimport { PLATFORM_COLORS } from '../config/colors.js'\n\nconst METRIC_ROWS = [['views', 'Views'], ['reach', 'Reach'], ['likes', 'Likes'], ['comments', 'Comments'], ['shares', 'Shares'], ['saves', 'Saves'], ['impressions', 'Impressions'], ['clicks', 'Clicks']]\nconst DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']\nconst tzOf = () => { try { return Intl.DateTimeFormat().resolvedOptions().timeZone } catch { return 'UTC' } }\n\nexport function Bars({ series }) {\n  const dates = [...new Set(series.map((s) => s.date))].sort()\n  const platforms = [...new Set(series.map((s) => s.platform || 'all'))]\n  const totals = dates.map((d) => series.filter((s) => s.date === d).reduce((n, s) => n + s.total, 0))\n  const max = Math.max(1, ...totals)\n  const w = 520; const h = 120; const bw = Math.max(4, Math.min(28, w / Math.max(dates.length, 1) - 4))\n  return (\n    <svg viewBox={`0 0 ${w} ${h + 18}`} className=\"zr-pk-chart\" role=\"img\" aria-label=\"Metric over time\">\n      {dates.map((d, i) => {\n        let y = h\n        return <g key={d}>{platforms.map((p) => { const v = series.find((s) => s.date === d && (s.platform || 'all') === p)?.total || 0; const bh = (v / max) * (h - 8); y -= bh; return <rect key={p} x={i * (bw + 4)} y={y} width={bw} height={bh} rx=\"2\" fill={PLATFORM_COLORS[p] || 'currentColor'} opacity=\"0.85\" /> })}<text x={i * (bw + 4)} y={h + 14} fontSize=\"9\" fill=\"currentColor\" opacity=\"0.55\">{d.slice(5, 10)}</text></g>\n      })}\n    </svg>\n  )\n}\n\nexport function HeatGrid({ cells }) {\n  const max = Math.max(1, ...cells.map((c) => c.averageEngagement))\n  const by = new Map(cells.map((c) => [`${c.weekday}|${c.hour}`, c]))\n  return (\n    <div className=\"zr-pk-heat\" role=\"img\" aria-label=\"Best times to post\">\n      {DAYS.map((d, wd) => <div key={d} className=\"zr-pk-heatrow\"><span className=\"zr-pk-heatday\">{d}</span>{Array.from({ length: 24 }, (_, h) => { const c = by.get(`${wd}|${h}`); return <i key={h} className=\"zr-pk-cell\" style={{ opacity: c ? 0.18 + 0.82 * (c.averageEngagement / max) : 0.05 }} title={c ? `${d} ${h}:00, ${c.posts} post(s), avg ${c.averageEngagement}${c.posts < 3 ? ' (too few posts to act on)' : ''}` : `${d} ${h}:00, no data`} /> })}</div>)}\n    </div>\n  )\n}\n\nfunction ManualMetrics({ client, accounts, reload }) {\n  const manual = accounts.filter((a) => a.status === 'CONNECTED' && !a.capabilities?.analytics && a.capabilities?.publish)\n  const [f, setF] = useState({ accountId: manual[0]?.id || '', platformPostId: '', permalink: '', views: '', likes: '' })\n  const act = useAction(reload)\n  if (!manual.length) return null\n  const num = (v) => (v === '' ? undefined : Number(v))\n  return (\n    <details className=\"zr-pk-details\"><summary>Record figures by hand (ArtStation, LinkedIn…)</summary>\n      <p className=\"zr-pk-meta\">These platforms expose no automatic reading. Hand-typed figures are marked <em>manual</em> and never mixed with measured ones.</p>\n      <div className=\"zr-pk-grid3\">\n        <Field label=\"Account\"><select value={f.accountId} onChange={(e) => setF({ ...f, accountId: e.target.value })}>{manual.map((a) => <option key={a.id} value={a.id}>{a.platform} @{a.username}</option>)}</select></Field>\n        <Field label=\"Post id or URL\"><input value={f.platformPostId} onChange={(e) => setF({ ...f, platformPostId: e.target.value })} /></Field>\n        <Field label=\"Permalink\"><input value={f.permalink} onChange={(e) => setF({ ...f, permalink: e.target.value })} /></Field>\n        <Field label=\"Views\"><input inputMode=\"numeric\" value={f.views} onChange={(e) => setF({ ...f, views: e.target.value })} /></Field>\n        <Field label=\"Likes\"><input inputMode=\"numeric\" value={f.likes} onChange={(e) => setF({ ...f, likes: e.target.value })} /></Field>\n      </div>\n      <Btn busy={act.busy} disabled={!f.platformPostId} onClick={() => act.run(() => client.post('/v1/analytics/manual', { accountId: f.accountId, platformPostId: f.platformPostId, permalink: f.permalink || undefined, metrics: { views: num(f.views), likes: num(f.likes) } }))}>Save figures</Btn>\n      <ErrorLine error={act.error} />\n    </details>\n  )\n}\n\nexport default function AnalyticsPanel({ client, overview, reload }) {\n  const [days, setDays] = useState(POSTKIT.defaultWindowDays)\n  const from = useMemo(() => new Date(Date.now() - days * 86_400_000).toISOString(), [days])\n  const tz = useMemo(tzOf, [])\n  const summary = useQuery(client, `/v1/analytics/summary${qs({ from })}`)\n  const top = useQuery(client, `/v1/analytics/posts${qs({ from, sortBy: 'engagement', limit: 8 })}`)\n  const accounts = useQuery(client, `/v1/analytics/accounts${qs({ from })}`)\n  const series = useQuery(client, `/v1/analytics/timeseries${qs({ from, metric: 'engagement', granularity: days > 90 ? 'week' : 'day', byPlatform: true })}`)\n  const best = useQuery(client, `/v1/analytics/best-times${qs({ from, timezone: tz })}`)\n  const acc = useQuery(client, `/v1/analytics/accumulation${qs({ from })}`)\n  const fol = useQuery(client, `/v1/analytics/followers${qs({ from })}`)\n  const reloadAll = async () => { await Promise.all([summary, top, accounts, series, best, acc, fol].map((q) => q.reload())); await reload() }\n  const sync = useAction(reloadAll)\n  const s = summary.data\n  return (\n    <>\n      <Card title=\"Analytics\" aside={<div className=\"zr-pk-chips\">{POSTKIT.analyticsWindowsDays.map((d) => <button key={d} className={`zr-pk-tab${days === d ? ' is-on' : ''}`} onClick={() => setDays(d)}>{d} d</button>)}<Btn busy={sync.busy} onClick={() => sync.run(() => client.post('/v1/analytics/sync', {}))}>Refresh</Btn></div>}>\n        <ErrorLine error={summary.error || sync.error} />\n        {s ? (\n          <>\n            <p className=\"zr-pk-meta\">Read from PostKit's store{s.lastSyncAt ? `, last collected ${ago(s.lastSyncAt)}` : ', nothing collected yet'}{s.nextSyncAt ? `, next ${ago(s.nextSyncAt)}`.replace(' ago', '') : ''}. {s.window.clamped && <Badge tone=\"warn\">history clamped to {s.window.maxHistoryDays} days</Badge>}</p>\n            <div className=\"zr-pk-tiles\">\n              <Tile label=\"Posts\" value={s.posts.value} sub={change(s.posts.change)} />\n              <Tile label=\"Engagement rate\" value={s.engagementRate.value === null ? 'n/a' : `${s.engagementRate.value}%`} sub={change(s.engagementRate.change, 'pts')} />\n              {s.followers.total !== null && <Tile label=\"Followers\" value={metric(s.followers.total)} sub={`${s.followers.change > 0 ? '+' : ''}${s.followers.change} in window`} />}\n              {METRIC_ROWS.map(([k, label]) => <Tile key={k} label={label} value={s.metrics[k].value === null ? 'n/a' : metric(s.metrics[k].value)} sub={s.metrics[k].value === null ? 'not exposed' : change(s.metrics[k].change)} />)}\n            </div>\n          </>\n        ) : <Empty>{summary.loading ? 'Loading…' : 'No data.'}</Empty>}\n      </Card>\n\n      <div className=\"zr-pk-grid2\">\n        <Card title=\"Engagement over time\">{series.data?.series?.length ? <Bars series={series.data.series} /> : <Empty>No engagement measured in this window.</Empty>}</Card>\n        <Card title={`Best times to post (${tz})`}>{best.data?.cells?.length ? <HeatGrid cells={best.data.cells} /> : <Empty>Not enough posts yet.</Empty>}</Card>\n      </div>\n\n      <div className=\"zr-pk-grid2\">\n        <Card title=\"Top posts\">\n          {top.data?.posts?.length ? <table className=\"zr-pk-table\"><thead><tr><th>Post</th><th>Source</th><th>Eng.</th><th>Views</th></tr></thead><tbody>{top.data.posts.map((p) => <tr key={p.id}><td><PlatformDot platform={p.platform} label={(p.caption || p.platformPostId || '').slice(0, 48)} /></td><td><Badge tone={p.source === 'external' ? 'muted' : 'info'}>{p.source === 'plugkit' ? 'postkit' : p.source}</Badge></td><td><Metric value={p.engagement} /></td><td><Metric value={p.metrics?.views} /></td></tr>)}</tbody></table> : <Empty>No post in this window.</Empty>}\n        </Card>\n        <Card title=\"By account\">\n          {accounts.data?.accounts?.length ? <table className=\"zr-pk-table\"><thead><tr><th>Account</th><th>Posts</th><th>Rate</th><th>Reach</th></tr></thead><tbody>{accounts.data.accounts.map((a) => <tr key={a.accountId}><td><PlatformDot platform={a.platform} label={`@${a.username}`} /></td><td><Num>{a.posts}</Num></td><td>{a.engagementRate === null ? <Metric value={null} /> : <Num>{a.engagementRate}%</Num>}</td><td><Metric value={a.metrics.reach} /></td></tr>)}</tbody></table> : <Empty>No account.</Empty>}\n        </Card>\n      </div>\n\n      <div className=\"zr-pk-grid2\">\n        <Card title=\"Engagement accumulation\">\n          {acc.data?.buckets?.length ? <ul className=\"zr-pk-bars\">{acc.data.buckets.map((b) => <li key={b.bucket}><span>{b.bucket}</span><i style={{ width: `${b.share}%` }} /><Num>{b.share}%</Num><small>{b.samples} post(s)</small></li>)}</ul> : <Empty>Fills in as your posts age: each one is measured again and again.</Empty>}\n        </Card>\n        <Card title=\"Followers\">\n          {fol.data?.accounts?.length ? <ul className=\"zr-pk-list\">{fol.data.accounts.map((a) => <li key={a.accountId} className=\"zr-pk-row\"><PlatformDot platform={a.platform} label={`@${a.username}`} /><span className=\"zr-pk-spacer\" /><Num>{metric(a.series[a.series.length - 1].followers)}</Num><Badge tone={a.growth >= 0 ? 'ok' : 'warn'}>{a.growth > 0 ? '+' : ''}{a.growth}</Badge></li>)}</ul> : <Empty>The series starts the day an account is connected: no platform hands back history it did not record.</Empty>}\n        </Card>\n      </div>\n      <Card><ManualMetrics client={client} accounts={overview.data.accounts} reload={reloadAll} /></Card>\n    </>\n  )\n}\nEOF\ncat > CampaignsPanel.jsx <<'EOF'\n// 3 October 2026, 13:08 : Campaigns: comment-to-DM automations, broadcasts and follow-up sequences, plus one-call playbooks. They run on\n// PostKit's scheduler, so they keep going when this page is closed. The audience is previewed before any send.\nimport React, { useState } from 'react'\nimport { useAction, useQuery } from './usePostKit.js'\nimport { qs } from './postkitClient.js'\nimport { Badge, Btn, Card, Empty, ErrorLine, Field, PlatformDot, StatusBadge } from './ui.jsx'\n\nconst messagingAccounts = (accounts) => accounts.filter((a) => a.status === 'CONNECTED' && a.capabilities?.messaging)\n\nfunction Automations({ client, accounts, reload }) {\n  const list = useQuery(client, '/v1/comment-automations')\n  const eligible = accounts.filter((a) => a.status === 'CONNECTED' && a.capabilities?.privateReply)\n  const [f, setF] = useState({ accountId: eligible[0]?.id || '', name: '', keywords: '', dmText: '', btnLabel: '', btnUrl: '', publicReply: '' })\n  const act = useAction(async () => { await list.reload(); await reload() })\n  const set = (k) => (e) => setF({ ...f, [k]: e.target.value })\n  return (\n    <Card title=\"Comment to DM\">\n      <ErrorLine error={list.error} />\n      {list.data?.automations?.length ? <ul className=\"zr-pk-list\">{list.data.automations.map((a) => (\n        <li key={a.id} className=\"zr-pk-li\"><div className=\"zr-pk-row\"><PlatformDot platform={a.platform} label={a.name} /><StatusBadge status={a.status} /><span className=\"zr-pk-meta\">{a.keywords.join(', ') || 'any comment'} · sent {a.counters.sent} · skipped {a.counters.skipped} · failed {a.counters.failed}</span><span className=\"zr-pk-spacer\" />\n          <Btn busy={act.busy} onClick={() => act.run(() => client.patch(`/v1/comment-automations/${a.id}`, { status: a.status === 'active' ? 'paused' : 'active' }))}>{a.status === 'active' ? 'Pause' : 'Resume'}</Btn>\n          <Btn tone=\"danger\" busy={act.busy} onClick={() => act.run(() => client.del(`/v1/comment-automations/${a.id}`))}>Delete</Btn></div></li>))}</ul> : <Empty>No automation.</Empty>}\n      {eligible.length > 0 && <details className=\"zr-pk-details\"><summary>New automation</summary>\n        <div className=\"zr-pk-grid3\"><Field label=\"Account\"><select value={f.accountId} onChange={set('accountId')}>{eligible.map((a) => <option key={a.id} value={a.id}>{a.platform} @{a.username}</option>)}</select></Field><Field label=\"Name\"><input value={f.name} onChange={set('name')} /></Field><Field label=\"Keywords, comma separated\"><input value={f.keywords} onChange={set('keywords')} /></Field></div>\n        <Field label=\"Message sent privately\" hint=\"Meta allows one private reply per comment, within 7 days.\"><textarea rows={2} value={f.dmText} onChange={set('dmText')} /></Field>\n        <div className=\"zr-pk-grid3\"><Field label=\"Button label\"><input value={f.btnLabel} onChange={set('btnLabel')} /></Field><Field label=\"Button URL (https)\"><input value={f.btnUrl} onChange={set('btnUrl')} /></Field><Field label=\"Public reply (optional)\"><input value={f.publicReply} onChange={set('publicReply')} /></Field></div>\n        <Btn tone=\"primary\" busy={act.busy} onClick={() => act.run(() => client.post('/v1/comment-automations', { accountId: f.accountId, name: f.name, keywords: f.keywords.split(',').map((s) => s.trim()).filter(Boolean), dmText: f.dmText, dmButtonLabel: f.btnLabel || undefined, dmButtonUrl: f.btnUrl || undefined, publicReplyText: f.publicReply || undefined }))}>Create</Btn><ErrorLine error={act.error} /></details>}\n    </Card>\n  )\n}\n\nfunction Broadcasts({ client, accounts, reload }) {\n  const list = useQuery(client, '/v1/broadcasts')\n  const eligible = messagingAccounts(accounts).filter((a) => a.platform !== 'x')\n  const [f, setF] = useState({ accountId: eligible[0]?.id || '', name: '', text: '', days: '1' })\n  const [count, setCount] = useState(null)\n  const act = useAction(async () => { await list.reload(); await reload() })\n  const set = (k) => (e) => setF({ ...f, [k]: e.target.value })\n  return (\n    <Card title=\"Broadcasts\">\n      <ErrorLine error={list.error} />\n      {list.data?.broadcasts?.length ? <ul className=\"zr-pk-list\">{list.data.broadcasts.map((b) => (\n        <li key={b.id} className=\"zr-pk-li\"><div className=\"zr-pk-row\"><PlatformDot platform={b.platform} label={b.name} /><StatusBadge status={b.status} /><span className=\"zr-pk-meta\">{b.counts.sent}/{b.counts.total} sent · {b.counts.failed} failed</span><span className=\"zr-pk-spacer\" />\n          {['draft', 'scheduled'].includes(b.status) && <Btn tone=\"primary\" busy={act.busy} onClick={() => confirm(`Send \"${b.name}\" now? Immediate and irreversible for every recipient.`) && act.run(() => client.post(`/v1/broadcasts/${b.id}/send`))}>Send</Btn>}\n          {b.status === 'scheduled' && <Btn busy={act.busy} onClick={() => act.run(() => client.post(`/v1/broadcasts/${b.id}/cancel`))}>Back to draft</Btn>}\n          <Btn tone=\"danger\" busy={act.busy} disabled={b.status === 'sending'} onClick={() => act.run(() => client.del(`/v1/broadcasts/${b.id}`))}>Delete</Btn></div><p className=\"zr-pk-meta\">{b.text}</p></li>))}</ul> : <Empty>No broadcast.</Empty>}\n      {eligible.length > 0 && <details className=\"zr-pk-details\"><summary>New broadcast</summary>\n        <div className=\"zr-pk-grid3\"><Field label=\"Account\"><select value={f.accountId} onChange={set('accountId')}>{eligible.map((a) => <option key={a.id} value={a.id}>{a.platform} @{a.username}</option>)}</select></Field><Field label=\"Name\"><input value={f.name} onChange={set('name')} /></Field><Field label=\"Active within (days)\" hint=\"1 = the slice that can actually be delivered.\"><input inputMode=\"numeric\" value={f.days} onChange={set('days')} /></Field></div>\n        <Field label=\"Message\"><textarea rows={3} value={f.text} onChange={set('text')} /></Field>\n        <div className=\"zr-pk-inline\"><Btn busy={act.busy} onClick={() => act.run(async () => setCount((await client.get(`/v1/broadcasts/audience${qs({ accountId: f.accountId, activeWithinDays: f.days })}`)).count))}>Preview audience</Btn>{count !== null && <Badge tone=\"info\">{count} recipient(s)</Badge>}<Btn tone=\"primary\" busy={act.busy} onClick={() => act.run(() => client.post('/v1/broadcasts', { accountId: f.accountId, name: f.name, text: f.text, audience: { activeWithinDays: Number(f.days) } }))}>Save as draft</Btn></div><ErrorLine error={act.error} /></details>}\n    </Card>\n  )\n}\n\nfunction Sequences({ client }) {\n  const list = useQuery(client, '/v1/sequences')\n  return (\n    <Card title=\"Sequences\">\n      <ErrorLine error={list.error} />\n      {list.data?.sequences?.length ? <ul className=\"zr-pk-list\">{list.data.sequences.map((s) => <li key={s.id} className=\"zr-pk-li\"><div className=\"zr-pk-row\"><PlatformDot platform={s.platform} label={s.name} /><StatusBadge status={s.status} /><Badge tone=\"muted\">{s.trigger.replace('_', ' ')}</Badge><span className=\"zr-pk-meta\">{s.steps.length} step(s){s.stopOnReply ? ' · stops when they reply' : ''}</span></div></li>)}</ul> : <Empty>No sequence. Install a playbook to create one.</Empty>}\n    </Card>\n  )\n}\n\nfunction 