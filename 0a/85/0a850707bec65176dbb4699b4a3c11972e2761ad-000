 const refreshed = (await h.call('POST', '/oauth/token', { token: null, headers: { 'content-type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ grant_type: 'refresh_token', refresh_token: tok.refresh_token }).toString() })).data\n  assert.equal((await h.call('GET', '/v1/profiles', { token: tok.access_token })).status, 401, 'rotation stops the old access token')\n  const apps = (await h.call('GET', '/v1/connected-apps')).data.apps\n  assert.equal(apps.length, 1); assert.equal(apps[0].clientName, 'Claude')\n  await h.call('DELETE', `/v1/connected-apps/${apps[0].id}`)\n  assert.equal((await h.call('GET', '/v1/profiles', { token: refreshed.access_token })).status, 401, 'revoked from Connected apps')\n})\n\ntest('consent refuses a wrong secret and a non-S256 request', async () => {\n  const h = await makeApp()\n  const { post } = await flow(h, { secret: 'not-the-owner' })\n  assert.equal(post.status, 401)\n  const reg = (await h.call('POST', '/oauth/register', { token: null, body: { redirect_uris: ['http://localhost:1/cb'] } })).data\n  const r = await h.call('GET', `/oauth/authorize?${new URLSearchParams({ response_type: 'code', client_id: reg.client_id, redirect_uri: 'http://localhost:1/cb', code_challenge: 'x', code_challenge_method: 'plain' })}`, { token: null })\n  assert.equal(r.status, 400)\n})\nEOF\nnode --test test/ 2>&1 | grep -E \"^(✖|ℹ (tests|pass|fail))|actual|expected|Error\" | head -20","description":"Implement OAuth 2.1 server for MCP with tests"}},"serverClassifierRequest":"0c31f9e7-3822-4995-b222-eaea0aa067f2","apiBlockIndex":1,"requestId":"req_011Cff3prj1dciiFBJ4TTzdW","attributionSkill":"zenrayprogress-context","type":"assistant","uuid":"b1c21a35-255a-4970-8fe5-a2c0e94070e3","timestamp":"2026-10-03T09:15:49.753Z","effort":"xhigh","perTurnEffort":"xhigh","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/.claude/Memory1","sessionId":"00ffe75e-952c-45fc-88a9-6f1bb05adeb3","version":"2.1.286","gitBranch":"main"