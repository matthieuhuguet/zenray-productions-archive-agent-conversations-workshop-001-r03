m))) add('account', a._id, `${a.platform} @${a.username}`, a.displayName)\n  for (const p of await listOwned(ctx, 'profiles', (x) => m(x.name, x.description))) add('profile', p._id, p.name, p.description)\n  for (const f of await listOwned(ctx, 'media', (x) => m(x.filename))) add('media', f._id, f.filename, f.type)\n  for (const a of await listOwned(ctx, 'automations', (x) => m(x.name, x.dmText, ...(x.keywords || [])))) add('automation', a._id, a.name, a.dmText)\n  for (const s of await listOwned(ctx, 'sequences', (x) => m(x.name))) add('sequence', s._id, s.name, `${s.steps.length} steps`)\n  for (const b of await listOwned(ctx, 'broadcasts', (x) => m(x.name, x.text))) add('broadcast', b._id, b.name, b.text)\n  for (const p of PLAYBOOKS.filter((x) => m(x.slug, x.name, x.description))) add('playbook', p.slug, p.name, p.description)\n  return { results }\n}\n\nconst COLLECTION = { post: 'posts', conversation: 'conversations', account: 'accounts', profile: 'profiles', media: 'media', automation: 'automations', sequence: 'sequences', broadcast: 'broadcasts' }\n\nexport async function fetchResult(ctx, { id }) {\n  const [type, ...rest] = String(id || '').split(':')\n  const rid = rest.join(':')\n  if (type === 'playbook') { const p = PLAYBOOKS.find((x) => x.slug === rid); if (!p) throw notFound('Playbook'); return { id, title: p.name, text: JSON.stringify(p, null, 2), url: `postkit://playbook/${rid}` } }\n  const col = COLLECTION[type]\n  if (!col) throw badRequest(`Unknown result id ${id}. Use an id returned by search.`)\n  const doc = await ctx.store.get(col, rid)\n  if (!doc || doc.workspaceId !== ctx.actor.workspaceId) throw notFound(type)\n  let extra = {}\n  if (type === 'conversation') extra = { messages: (await listOwned(ctx, 'messages', (m) => m.conversationId === rid)).sort((a, b) => a.at.localeCompare(b.at)).slice(-30).map(view) }\n  if (type === 'post') extra = { targets: doc.targets }\n  return { id, title: doc.title || doc.name || doc.username || doc.contac