{"parentUuid":"c9532991-5881-4aba-8951-6d9a38b6fdbc","isSidechain":false,"message":{"model":"claude-sonnet-5-5","id":"msg_011Cff4ChmNcR5xqvMYqxuXW","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XqZNYq4AtyGQJeUhHz1j7R","name":"Bash","input":{"command":"R=/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayPostKit; cd $R\ncat > src/platforms/connectors/facebook.js <<'EOF'\n// 3 October 2026 : Facebook connector (Pages, never personal profiles) on the Graph API. One authorization can attach several Pages, one account\n// per Page. Without pages_manage_metadata the Page cannot be subscribed to webhooks and NO inbound message or comment arrives, silently:\n// that is why subscribeWebhooks is a first-class call here. Verification level: mock.\nimport { defineConnector } from '../base.js'\nimport { badRequest } from '../../lib/errors.js'\nimport { mustOk } from '../../lib/http.js'\nimport { graph, num } from './meta.js'\nimport { messageBody } from './instagram.js'\n\nconst SCOPES = ['pages_show_list', 'pages_read_engagement', 'pages_manage_posts', 'pages_messaging', 'pages_manage_engagement', 'pages_manage_metadata', 'read_insights']\n\nexport function createFacebookConnector({ http, config }) {\n  const api = config.apis\n  const g = (secret) => graph(http, api.graphBase, { version: api.graphVersion, token: secret.accessToken })\n  const page = (account) => account.externalId\n\n  return defineConnector({\n    platform: 'facebook', label: 'Facebook Pages', verification: 'mock', auth: 'oauth',\n    requiredEnv: ['POSTKIT_FACEBOOK_CLIENT_ID', 'POSTKIT_FACEBOOK_CLIENT_SECRET'],\n    note: 'Connects Pages. Grant pages_manage_metadata or no inbound message or comment will ever arrive.',\n    capabilities: { publish: true, messaging: true, comments: true, analytics: true, stories: true, privateReply: true, messagingWindow: true, externalPosts: true, unpublish: true },\n    rules: { text: 'optional', maxChars: 63206, media: { min: 0, max: 10, types: ['image', 'video'] } },\n\n    authorizeUrl({ state, redirectUri, creds }) {\n      return `https://www.facebook.com/${api.graphVersion}/dialog/oauth?${new URLSearchParams({ client_id: creds.clientId, redirect_uri: redirectUri, state, scope: SCOPES.join(','), response_type: 'code' })}`\n    },\n    async exchangeCode({ code, redirectUri, creds, now }) {\n      const short = mustOk(await http.request(`${api.graphBase}/${api.graphVersion}/oauth/access_token?${new URLSearchParams({ client_id: creds.clientId, client_secret: creds.clientSecret, redirect_uri: redirectUri, code })}`), 'Facebook token exchange').data\n      const long = mustOk(await http.request(`${api.graphBase}/${api.graphVersion}/oauth/access_token?${new URLSearchParams({ grant_type: 'fb_exchange_token', client_id: creds.clientId, client_secret: creds.clientSecret, fb_exchange_token: short.access_token })}`), 'Facebook long-lived token').data\n      const pages = await graph(http, api.graphBase, { version: api.graphVersion, token: long.access_token }).get('/me/accounts', { fields: 'id,name,access_token,picture{url}', limit: 100 })\n      // Page tokens derived from a long-lived user token do not expire. (3 October 2026)\n      return { accounts: (pages.data || []).map((p) => ({ externalId: p.id, username: p.name, displayName: p.name, avatarUrl: p.picture?.data?.url || null, secret: { accessToken: p.access_token }, tokenExpiresAt: null, metadata: {} })) }\n    },\n\n    async publish({ account, secret, post, target, media }) {\n      const message = target.customContent ?? post.content ?? ''\n      const o = post.options\n      if (o.asStory) {\n        const m = media[0]\n        if (!m) throw badRequest('A Facebook story needs one media item.')\n        const up = m.type === 'video' ? await g(secret).post(`/${page(account)}/video_stories`, { upload_phase: 'start' }, 'video story') : await g(secret).post(`/${page(account)}/photos`, { url: m.url, published: false }, 'story photo')\n        const st = await g(secret).post(`/${page(account)}/photo_stories`, { photo_id: up.id }, 'photo story')\n        return { platformPostId: st.post_id || st.id, platformPostUrl: null }\n      }\n      let r\n      if (!media.length) r = await g(secret).post(`/${page(account)}/feed`, { message }, 'feed post')\n      else if (media[0].type === 'video') r = await g(secret).post(`/${page(account)}/videos`, { file_url: media[0].url, description: message }, 'video post')\n      else if (media.length === 1) r = await g(secret).post(`/${page(account)}/photos`, { url: media[0].url, caption: message }, 'photo post')\n      else {\n        const ids = []\n        for (const m of media) ids.push((await g(secret).post(`/${page(account)}/photos`, { url: m.url, published: false }, 'unpublished photo')).id)\n        r = await g(secret).post(`/${page(account)}/feed`, { message, attached_media: ids.map((id) => ({ media_fbid: id })) }, 'multi photo post')\n      }\n      const id = r.post_id || r.id\n      return { platformPostId: id, platformPostUrl: `https://www.facebook.com/${id}` }\n    },\n    async unpublish({ secret, target }) { await g(secret).del(`/${target.platformPostId}`, {}, 'delete post') },\n\n    async listPosts({ account, secret }) {\n      const r = await g(secret).get(`/${page(account)}/posts`, { fields: 'id,message,created_time,permalink_url,full_picture', limit: 50 })\n      return (r.data || []).map((p) => ({ platformPostId: p.id, permalink: p.permalink_url, caption: p.message || null, thumbnailUrl: p.full_picture || null, publishedAt: p.created_time }))\n    },\n    async getPostMetrics({ secret, platformPostId }) {\n      try {\n        const base = await g(secret).get(`/${platformPostId}`, { fields: 'reactions.summary(true),comments.summary(true),shares' })\n        const ins = await g(secret).get(`/${platformPostId}/insights`, { metric: 'post_impressions,post_impressions_unique,post_clicks' }).catch(() => ({ data: [] }))\n        const m = Object.fromEntries((ins.data || []).map((x) => [x.name, num(x.values?.[0]?.value)]))\n        return { views: null, reach: m.post_impressions_unique ?? null, likes: num(base.reactions?.summary?.total_count), comments: num(base.comments?.summary?.total_count), shares: num(base.shares?.count ?? 0), saves: null, impressions: m.post_impressions ?? null, clicks: m.post_clicks ?? null }\n      } catch (e) { if (e.details?.status === 404) return null; throw e }\n    },\n    async getAccountStats({ account, secret }) { const r = await g(secret).get(`/${page(account)}`, { fields: 'fan_count,followers_count' }); return { followers: num(r.followers_count ?? r.fan_count), following: null, postCount: null } },\n\n    async listEngagement({ account, secret, postId }) {\n      const ids = postId ? [postId] : ((await g(secret).get(`/${page(account)}/posts`, { fields: 'id', limit: config.engagement.sweepRecentPosts })).data || []).map((p) => p.id)\n      const out = []\n      for (const id of ids) {\n        const r = await g(secret).get(`/${id}/comments`, { fields: 'id,message,from,created_time,is_hidden,parent{id}', limit: 50, filter: 'stream' })\n        for (const c of r.data || []) out.push({ platformCommentId: c.id, kind: 'comment', postId: id, parentId: c.parent?.id || null, author: { handle: c.from?.id || 'unknown', name: c.from?.name || 'unknown' }, text: c.message, hidden: c.is_hidden ?? null, isOwn: c.from?.id === page(account), publishedAt: c.created_time })\n      }\n      return out\n    },\n    async replyToComment({ secret, comment, text }) { const r = await g(secret).post(`/${comment.platformCommentId}/comments`, { message: text }, 'reply to comment'); return { platformCommentId: r.id } },\n    async hideComment({ secret, comment, hidden }) { await g(secret).post(`/${comment.platformCommentId}`, { is_hidden: hidden }, 'hide comment') },\n    async deleteComment({ secret, comment }) { await g(secret).del(`/${comment.platformCommentId}`, {}, 'delete comment') },\n    async privateReply({ account, secret, comment, text, button }) { return { platformMessageId: (await g(secret).postJson(`/${page(account)}/messages`, { recipient: { comment_id: comment.platformCommentId }, message: messageBody(text, button) }, 'private reply')).message_id } },\n    async sendMessage({ account, secret, conversation, text, button }) { return { platformMessageId: (await g(secret).postJson(`/${page(account)}/messages`, { recipient: { id: conversation.contactHandle }, messaging_type: 'RESPONSE', message: messageBody(text, button) }, 'send message')).message_id } },\n    async syncConversations({ account, secret }) {\n      const r = await g(secret).get(`/${page(account)}/conversations`, { fields: 'id,participants,messages.limit(20){id,message,from,created_time}', platform: 'messenger' })\n      return (r.data || []).map((t) => { const other = t.participants?.data?.find((p) => p.id !== page(account)); return { externalConversationId: t.id, contactHandle: other?.id, contactName: other?.name, messages: (t.messages?.data || []).map((m) => ({ id: m.id, direction: m.from?.id === page(account) ? 'out' : 'in', text: m.message, at: m.created_time })) } })\n    },\n    async subscribeWebhooks({ account, secret }) { await g(secret).post(`/${page(account)}/subscribed_apps`, { subscribed_fields: 'messages,message_echoes,feed,messaging_postbacks' }, 'subscribe webhooks'); return { subscribed: true } },\n  })\n}\nEOF\ncat > src/platforms/connectors/threads.js <<'EOF'\n// 3 October 2026 : Threads connector (graph.threads.net). A Meta platform but NOT Instagram: own credentials, own consent screen, own threads_* scopes.\n// Rules from the PlugKit docs: 500 characters counted as UTF-8 bytes, carousels of 2 to 20, no stories, no drafts, no privacy levels, no messaging,\n// replies can be hidden but not deleted, a post can be deleted. Verification level: mock.\nimport { defineConnector } from '../base.js'\nimport { badRequest } from '../../lib/errors.js'\nimport { mustOk } from '../../lib/http.js'\nimport { graph, pollUntil, insightMap, num } from './meta.js'\n\nconst SCOPES = ['threads_basic', 'threads_content_publish', 'threads_manage_replies', 'threads_read_replies', 'threads_manage_insights']\n\nexport function createThreadsConnector({ http, config }) {\n  const api = config.apis\n  const g = (secret) => graph(http, api.threadsBase, { version: 'v1.0', token: secret.accessToken })\n  const uid = (a) => a.externalId\n\n  async function create(secret, account, params) {\n    const c = await g(secret).post(`/${uid(account)}/threads`, params, 'create thread container')\n    if (params.media_type !== 'TEXT') await pollUntil(config, async () => { const s = await g(secret).get(`/${c.id}`, { fields: 'status,error_message' }); return { state: s.status, detail: s.error_message } }, { ok: ['FINISHED'], fail: ['ERROR', 'EXPIRED'], what: 'media processing' })\n    return c.id\n  }\n\n  return defineConnector({\n    platform: 'threads', label: 'Threads', verification: 'mock', auth: 'oauth',\n    requiredEnv: ['POSTKIT_THREADS_CLIENT_ID', 'POSTKIT_THREADS_CLIENT_SECRET'],\n    note: 'Own credentials and permissions, nothing carries over from Instagram. 250 posts per 24 hours. No messaging.',\n    capabilities: { publish: true, comments: true, analytics: true, externalPosts: true, unpublish: true },\n    rules: { text: 'optional', maxChars: config.publishing.threadsMaxChars, countBytes: true, media: { min: 0, max: 20, types: ['image', 'video'] } },\n\n    validatePost(post, target) {\n      const media = target.customMedia ?? post.mediaItems\n      const [lo, hi] = config.publishing.threadsCarouselRange\n      if (media.length > 1 && (media.length < lo || media.length > hi)) throw badRequest(`A Threads carousel takes ${lo} to ${hi} items.`)\n      for (const k of ['asStory', 'asDraft', 'trialReel']) if (post.options[k]) throw badRequest(`Threads has no ${k}: the option is refused rather than ignored.`)\n      if (post.options.privacy && post.options.privacy !== 'public') throw badRequest('A Threads post is public: there are no privacy levels.')\n    },\n\n    authorizeUrl({ state, redirectUri, creds }) { return `https://threads.net/oauth/authorize?${new URLSearchParams({ client_id: creds.clientId, redirect_uri: redirectUri, scope: SCOPES.join(','), response_type: 'code', state })}` },\n    async exchangeCode({ code, redirectUri, creds, now }) {\n      const short = mustOk(await http.request('https://graph.threads.net/oauth/access_token', { method: 'POST', form: { client_id: creds.clientId, client_secret: creds.clientSecret, grant_type: 'authorization_code', redirect_uri: redirectUri, code } }), 'Threads token exchange').data\n      const long = mustOk(await http.request(`https://graph.threads.net/access_token?${new URLSearchParams({ grant_type: 'th_exchange_token', client_secret: creds.clientSecret, access_token: short.access_token })}`), 'Threads long-lived token').data\n      const me = await graph(http, api.threadsBase, { version: 'v1.0', token: long.access_token }).get('/me', { fields: 'id,username,name,threads_profile_picture_url' })\n      const expiresAt = new Date(now.getTime() + (long.expires_in || 5_184_000) * 1000).toISOString()\n      return { accounts: [{ externalId: String(me.id), username: me.username, displayName: me.name || me.username, avatarUrl: me.threads_profile_picture_url || null, secret: { accessToken: long.access_token, expiresAt }, tokenExpiresAt: expiresAt, metadata: {} }] }\n    },\n\n    async publish({ account, secret, post, target, media }) {\n      const text = target.customContent ?? post.content ?? ''\n      const reply = post.options.allowComment === false ? { reply_control: 'mentioned_only' } : {} // the strictest setting Threads offers: there is no \"nobody\"\n      let id\n      if (media.length > 1) {\n        const kids = []\n        for (const m of media) kids.push(await create(secret, account, { media_type: m.type === 'video' ? 'VIDEO' : 'IMAGE', ...(m.type === 'video' ? { video_url: m.url } : { image_url: m.url }), is_carousel_item: true }))\n        id = await create(secret, account, { media_type: 'CAROUSEL', children: kids.join(','), text, ...reply })\n      } else if (media.length === 1) id = await create(secret, account, { media_type: media[0].type === 'video' ? 'VIDEO' : 'IMAGE', ...(media[0].type === 'video' ? { video_url: media[0].url } : { image_url: media[0].url }), text, ...reply })\n      else id = await create(secret, account, { media_type: 'TEXT', text, ...reply })\n      const pub = await g(secret).post(`/${uid(account)}/threads_publish`, { creation_id: id }, 'publish thread')\n      const link = (await g(secret).get(`/${pub.id}`, { fields: 'permalink' })).permalink\n      return { platformPostId: pub.id, platformPostUrl: link }\n    },\n    async unpublish({ secret, target }) { await g(secret).del(`/${target.platformPostId}`, {}, 'delete thread') },\n\n    async listPosts({ account, secret }) {\n      const r = await g(secret).get(`/${uid(account)}/threads`, { fields: 'id,text,permalink,timestamp,media_url', limit: 50 })\n      return (r.data || []).map((p) => ({ platformPostId: p.id, permalink: p.permalink, caption: p.text || null, thumbnailUrl: p.media_url || null, publishedAt: p.timestamp }))\n    },\n    async getPostMetrics({ secret, platformPostId }) {\n      try { const m = insightMap(await g(secret).get(`/${platformPostId}/insights`, { metric: 'views,likes,replies,reposts,quotes' }), { replies: 'comments', reposts: 'shares' }); return { views: m.views ?? null, reach: null, likes: m.likes ?? null, comments: m.comments ?? null, shares: m.shares ?? null, saves: null, impressions: null, clicks: null } }\n      catch (e) { if (e.details?.status === 404) return null; throw e }\n    },\n    async getAccountStats({ account, secret }) { const m = insightMap(await g(secret).get(`/${uid(account)}/threads_insights`, { metric: 'followers_count' })); return { followers: m.followers_count ?? null, following: null, postCount: null } },\n\n    async listEngagement({ account, secret, postId }) {\n      const ids = postId ? [postId] : ((await g(secret).get(`/${uid(account)}/threads`, { fields: 'id', limit: config.engagement.sweepRecentPosts })).data || []).map((p) => p.id)\n      const out = []\n      for (const id of ids) {\n        const r = await g(secret).get(`/${id}/replies`, { fields: 'id,text,username,timestamp,hide_status,replied_to', limit: 50 })\n        for (const c of r.data || []) out.push({ platformCommentId: c.id, kind: 'comment', postId: id, parentId: c.replied_to?.id && c.replied_to.id !== id ? c.replied_to.id : null, author: { handle: c.username, name: c.username }, text: c.text, hidden: c.hide_status ? c.hide_status !== 'NOT_HUSHED' && c.hide_status !== 'UNHUSHED' : null, isOwn: c.username === account.username, publishedAt: c.timestamp })\n      }\n      return out\n    },\n    async replyToComment({ account, secret, comment, text }) {\n      const c = await create(secret, account, { media_type: 'TEXT', text, reply_to_id: comment.platformCommentId })\n      const p = await g(secret).post(`/${uid(account)}/threads_publish`, { creation_id: c }, 'publish reply')\n      return { platformCommentId: p.id }\n    },\n    async hideComment({ secret, comment, hidden }) { await g(secret).post(`/${comment.platformCommentId}/manage_reply`, { hide: hidden }, 'hide reply') },\n  })\n}\nEOF\ncat > src/platforms/connectors/telegram.js <<'EOF'\n// 3 October 2026 : Telegram connector. No OAuth and no review: a bot token from @BotFather. The bot publishes to a channel or group where it is an\n// ADMIN (a Telegram rule) and receives the messages sent to it. Telegram has no 24 hour window, no comments surface and no analytics here.\nimport { defineConnector } from '../base.js'\nimport { badRequest } from '../../lib/errors.js'\nimport { mustOk } from '../../lib/http.js'\nimport { publicBaseUrl } from '../../domain/connect.js'\n\nexport function createTelegramConnector({ http, config, env }) {\n  const api = (token) => `${config.apis.telegramBase}/bot${token}`\n  async function call(token, method, body) { return mustOk(await http.request(`${api(token)}/${method}`, { method: 'POST', json: body }), `Telegram ${method}`).data.result }\n\n  return defineConnector({\n    platform: 'telegram', label: 'Telegram', verification: 'mock', auth: 'token',\n    note: 'Create a bot with @BotFather, add it as an administrator of the channel, then connect it with its token and the channel id or @username.',\n    capabilities: { publish: true, messaging: true },\n    rules: { text: 'optional', maxChars: 4096, media: { min: 0, max: 10, types: ['image', 'video', 'gif'] } },\n\n    async connectWithToken({ botToken, channelId }) {\n      const me = await call(botToken, 'getMe', {}) // validated before anything is stored\n      return { accounts: [{ externalId: String(me.id), username: me.username, displayName: me.first_name || me.username, secret: { botToken }, metadata: { channelId: channelId || null, botName: me.first_name } }] }\n    },\n\n    async publish({ account, secret, post, target, media }) {\n      const chat = account.metadata?.channelId\n      if (!chat) throw badRequest('Set the channel id (or @username) on the Telegram account: the bot posts where it is an admin.')\n      const text = target.customContent ?? post.content ?? ''\n      let result\n      if (!media.length) result = await call(secret.botToken, 'sendMessage', { chat_id: chat, text })\n      else if (media.length === 1) result = await call(secret.botToken, media[0].type === 'video' ? 'sendVideo' : media[0].type === 'gif' ? 'sendAnimation' : 'sendPhoto', { chat_id: chat, [media[0].type === 'video' ? 'video' : media[0].type === 'gif' ? 'animation' : 'photo']: media[0].url, caption: text })\n      else result = (await call(secret.botToken, 'sendMediaGroup', { chat_id: chat, media: media.map((m, i) => ({ type: m.type === 'video' ? 'video' : 'photo', media: m.url, ...(i === 0 ? { caption: text } : {}) })) }))[0]\n      const handle = String(chat).startsWith('@') ? String(chat).slice(1) : null\n      return { platformPostId: String(result.message_id), platformPostUrl: handle ? `https://t.me/${handle}/${result.message_id}` : null }\n    },\n\n    // Inline keyboard for the button; when Telegram refuses it the URL is appended to the text instead of being lost.\n    async sendMessage({ secret, conversation, text, button }) {\n      const body = { chat_id: conversation.contactHandle, text, ...(button ? { reply_markup: { inline_keyboard: [[{ text: button.label, url: button.url }]] } } : {}) }\n      try { return { platformMessageId: String((await call(secret.botToken, 'sendMessage', body)).message_id) } }\n      catch (e) { if (!button) throw e; return { platformMessageId: String((await call(secret.botToken, 'sendMessage', { chat_id: conversation.contactHandle, text: `${text}\\n${button.url}` })).message_id) } }\n    },\n    async syncConversations({ secret }) {\n      const updates = await call(secret.botToken, 'getUpdates', { timeout: 0 })\n      const byChat = new Map()\n      for (const u of updates) { const m = u.message; if (!m?.text) continue; const t = byChat.get(String(m.chat.id)) || { externalConversationId: String(m.chat.id), contactHandle: String(m.chat.id), contactName: m.chat.username || m.chat.first_name, messages: [] }; t.messages.push({ id: `${m.chat.id}:${m.message_id}`, direction: 'in', text: m.text, at: new Date(m.date * 1000).toISOString() }); byChat.set(t.externalConversationId, t) }\n      return [...byChat.values()]\n    },\n    async subscribeWebhooks({ account, secret, ctx }) {\n      await call(secret.botToken, 'setWebhook', { url: `${publicBaseUrl(ctx)}/v1/inbound/telegram/${account._id}`, secret_token: (env?.POSTKIT_TELEGRAM_WEBHOOK_SECRET || undefined) })\n      return { subscribed: true }\n    },\n  })\n}\nEOF\nfor f in facebook threads telegram; do node -e \"import('./src/platforms/connectors/$f.js').then(()=>console.log('$f ok'))\"; done","description":