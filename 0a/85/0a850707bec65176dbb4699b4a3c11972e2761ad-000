Rate: g.rate, metrics: g.metrics } }) }\n}\nEOF\nnode -e \"import('./src/domain/analytics.js').then(()=>console.log('analytics ok'))\"","description":"Write analytics collector and query service"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11062,"cache_read_input_tokens":514854,"output_tokens":11066,"output_tokens_details":{"thinking_tokens":1641},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":11062,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":11066,"cache_read_input_tokens":514854,"cache_creation_input_tokens":11062,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11062},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01XE8uDDbsq8ezUHstCQRTr7":{"command":"R=/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayPostKit; cd $R\ncat > src/domain/analytics.js <<'EOF'\n// 3 October 2026 : Analytics store, collector and queries.\n// Numbers come from PostKit's own store, filled by a background collector (not from the platform at request time), because follower history,\n// engagement accumulation and period comparison are impossible to answer live. Rules kept from PlugKit: null is not zero, every answer\n// carries its sync times, history older than the plan allows is clamped (and says so), posts older than 180 days are frozen.\nimport { CONFIG } from '../config.js'\nimport { addMs, DAY, HOUR, zonedWeekdayHour } from '../lib/time.js'\nimport { badRequest } from '../lib/errors.js'\nimport { listOwned, owned, nowIso, pageOffset, view } from './common.js'\nimport { getSecret } from './secrets.js'\nimport { meteredBackgroundAllowed, recordUsage } from './usage.js'\n\nexport const METRICS = ['views', 'reach', 'likes', 'comments', 'shares', 'saves', 'impressions', 'clicks']\nconst ENGAGEMENT = ['likes', 'comments', 'shares', 'saves']\nconst r1 = (n) => (n === null ? null : Math.round(n * 10) / 10)\nconst sumDefined = (rows, f) => { const v = rows.map(f).filter((x) => x !== null && x !== undefined); return v.length ? v.reduce((a, b) => a + b, 0) : null }\nexport const engagementOf = (m) => (m ? sumDefined([m], (x) => sumDefined(ENGAGEMENT.map((k) => ({ k })), (e) => x[e.k])) : null)\nconst denominator = (m) => (m ? m.reach ?? m.views ?? m.impressions ?? null : null)\n\n// ------------------------------------------------------------------ collector\nfunction cadenceSeconds(ctx, plan, ageMs, platform) {\n  if (ageMs > CONFIG.analytics.freezeAfterDays * DAY) return null // frozen\n  if (platform === 'x') return DAY / 1000 / CONFIG.analytics.meteredReadsPerDay\n  const c = CONFIG.analytics.cadence[plan] || CONFIG.analytics.cadence.PRO\n  return ageMs < 48 * HOUR ? c.under48h : ageMs < 30 * DAY ? c.under30d : c.over30d\n}\n\nasync function ensureTracked(ctx, account, rows) {\n  for (const r of rows) {\n    const id = `${account._id}:${r.platformPostId}`\n    const ex = await ctx.store.get('trackedPosts', id)\n    if (ex) { await ctx.store.put('trackedPosts', { ...ex, permalink: r.permalink ?? ex.permalink, caption: r.caption ?? ex.caption, postId: r.postId ?? ex.postId }); continue }\n    await ctx.store.put('trackedPosts', { _id: id, workspaceId: account.workspaceId, accountId: account._id, platform: account.platform, platformPostId: r.platformPostId, permalink: r.permalink || null, caption: r.caption || null, thumbnailUrl: r.thumbnailUrl || null, publishedAt: r.publishedAt, source: r.source || 'external', postId: r.postId || null, metrics: null, lastSyncAt: null, nextSyncAt: nowIso(ctx), frozen: false, missing: false })\n  }\n}\n\nexport async function collectAccount(ctx, account, { force = false } = {}) {\n  const connector = ctx.connectors.get(account.platform)\n  if (!connector.capabilities.analytics) return { accountId: account._id, skipped: 'This platform exposes no analytics.' }\n  if (account.platform === 'x' && !(await meteredBackgroundAllowed(ctx, account, 'analytics'))) return { accountId: account._id, skipped: 'Metered analytics are off for this X account, or the spend cap is reached.' }\n  const sub = { ...ctx, actor: { ...ctx.actor, workspaceId: account.workspaceId } }\n  const ws = await ctx.store.get('workspaces', account.workspaceId)\n  const plan = ws?.plan || CONFIG.defaults.plan\n  const now = ctx.clock.now()\n  const state = { ...(account.analyticsState || {}) }\n  const secret = await getSecret(ctx, account._id)\n  const out = { accountId: account._id, discovered: 0, read: 0, frozen: 0, followers: false }\n  const cadence = CONFIG.analytics.cadence[plan]\n\n  // 1. Posts we published ourselves are always tracked.\n  const ours = (await ctx.store.all('posts')).filter((p) => p.workspaceId === account.workspaceId).flatMap((p) => p.targets.filter((t) => t.accountId === account._id && t.status === 'published' && t.platformPostId).map((t) => ({ platformPostId: t.platformPostId, permalink: t.platformPostUrl, caption: p.content, publishedAt: t.publishedAt || p.publishedAt, source: 'postkit', postId: p._id })))\n  await ensureTracked(sub, account, ours)\n\n  // 2. Discovery of posts published natively on the platform (not for metered X: a billed read per page, forever).\n  const discoverDue = force || !state.lastDiscoverAt || now - new Date(state.lastDiscoverAt) >= cadence.discover * 1000\n  if (discoverDue && connector.capabilities.externalPosts && typeof connector.listPosts === 'function') {\n    const listed = await connector.listPosts({ account, secret, http: ctx.http, ctx, now })\n    await ensureTracked(sub, account, listed.map((p) => ({ ...p, source: p.source || 'external' })))\n    state.lastDiscoverAt = now.toISOString(); out.discovered = listed.length\n  }\n\n  // 3. Per-post metrics, cadence by age. A post the platform no longer knows is frozen on its last reading, not erased.\n  for (const t of (await ctx.store.all('trackedPosts')).filter((x) => x.accountId === account._id && !x.frozen)) {\n    const age = now - new Date(t.publishedAt)\n    const every = cadenceSeconds(ctx, plan, age, account.platform)\n    if (every === null) { await ctx.store.put('trackedPosts', { ...t, frozen: true, nextSyncAt: null }); out.frozen += 1; continue }\n    if (!force && t.lastSyncAt && now - new Date(t.lastSyncAt) < every * 1000) continue\n    let metrics = null\n    try { metrics = await connector.getPostMetrics({ account, secret, platformPostId: t.platformPostId, http: ctx.http, ctx, now }) } catch (e) { continue }\n    if (account.platform === 'x') await recordUsage(sub, 'X_READ')\n    if (metrics === null) { await ctx.store.put('trackedPosts', { ...t, missing: true, frozen: true, nextSyncAt: null }); out.frozen += 1; continue }\n    await ctx.store.put('postMetrics', { _id: `${t._id}@${now.toISOString()}`, workspaceId: account.workspaceId, trackedId: t._id, accountId: account._id, platform: account.platform, readAt: now.toISOString(), ageHours: age / HOUR, metrics })\n    await ctx.store.put('trackedPosts', { ...t, metrics, lastSyncAt: now.toISOString(), nextSyncAt: addMs(now, every * 1000).toISOString() })\n    out.read += 1\n  }\n\n  // 4. Followers, measured forward once a day: no platform can hand back a count it did not record.\n  const today = now.toISOString().slice(0, 10)\n  if (typeof connector.getAccountStats === 'function' && (force || state.lastFollowersDate !== today)) {\n    const s = await connector.getAccountStats({ account, secret, http: ctx.http, ctx, now })\n    if (account.platform === 'x') await recordUsage(sub, 'X_USER_READ')\n    if (s) { await ctx.store.put('accountStats', { _id: `${account._id}:${today}`, workspaceId: account.workspaceId, accountId: account._id, platform: account.platform, date: today, followers: s.followers ?? null, following: s.following ?? null, postCount: s.postCount ?? null, readAt: now.toISOString() }); state.lastFollowersDate = today; out.followers = true }\n  }\n  await ctx.store.put('accounts', { ...account, analyticsState: state })\n  return out\n}\n\nexport async function collectAll(ctx) {\n  const results = []\n  for (const account of (await ctx.store.all('accounts')).filter((a) => a.status === 'CONNECTED')) {\n    try { results.push(await collectAccount(ctx, account)) } catch (e) { results.push({ accountId: account._id, error: e.message }) }\n  }\n  return results\n}\n\n// POST /analytics/sync. With an accountId the platform is queried in the request; calls within 15 s on the same account are ignored.\nexport async function syncAnalytics(ctx, { accountId } = {}) {\n  const now = ctx.clock.now()\n  const accounts = await listOwned(ctx, 'accounts', (a) => a.status === 'CONNECTED' && (!accountId || a._id === accountId))\n  if (accountId && !accounts.length) await owned(ctx, 'accounts', accountId, 'Account')\n  const results = []\n  for (const a of accounts) {\n    const last = a.analyticsState?.lastSyncRequestAt\n    if (last && now - new Date(last) < CONFIG.analytics.syncDebounceSeconds * 1000) { results.push({ accountId: a._id, debounced: true }); continue }\n    await ctx.store.put('accounts', { ...a, analyticsState: { ...(a.analyticsState || {}), lastSyncRequestAt: now.toISOString() } })\n    if (accountId) results.push(await collectAccount(ctx, { ...a, analyticsState: { ...(a.analyticsState || {}), lastSyncRequestAt: now.toISOString() } }, { force: true }))\n    else await ctx.store.put('trackedPosts', ...[]) // queued: picked up on the next cycle\n  }\n  return { success: true, mode: accountId ? 'immediate' : 'queued', results }\n}\n\n// Figures typed in by hand for platforms with no automatic reading (ArtStation, LinkedIn). Marked source \"manual\". (3 October 2026)\nexport async function recordManualMetrics(ctx, { accountId, platformPostId, permalink, caption, publishedAt, metrics }) {\n  if (!platformPostId || !metrics || typeof metrics !== 'object') throw badRequest('platformPostId and metrics are required.')\n  const account = await owned(ctx, 'accounts', accountId, 'Account')\n  const id = `${accountId}:${platformPostId}`\n  const now = ctx.clock.now()\n  const clean = Object.fromEntries(METRICS.map((k) => [k, typeof metrics[k] === 'number' ? metrics[k] : null]))\n  const ex = await ctx.store.get('trackedPosts', id)\n  const pubAt = publishedAt || ex?.publishedAt || now.toISOString()\n  await ctx.store.put('trackedPosts', { ...(ex || {}), _id: id, workspaceId: account.workspaceId, accountId, platform: account.platform, platformPostId, permalink: permalink ?? ex?.permalink ?? null, caption: caption ?? ex?.caption ?? null, publishedAt: pubAt, source: ex?.source === 'postkit' ? 'postkit' : 'manual', metrics: clean, lastSyncAt: now.toISOString(), nextSyncAt: null, frozen: true, missing: false })\n  await ctx.store.put('postMetrics', { _id: `${id}@${now.toISOString()}`, workspaceId: account.workspaceId, trackedId: id, accountId, platform: account.platform, readAt: now.toISOString(), ageHours: (now - new Date(pubAt)) / HOUR, metrics: clean, manual: true })\n  return { success: true, trackedId: id, metrics: clean }\n}\n\n// ------------------------------------------------------------------ queries\nexport async function workspacePlan(ctx) { return (await ctx.store.get('workspaces', ctx.actor.workspaceId))?.plan || CONFIG.defaults.plan }\n\nexport async function resolveWindow(ctx, { from, to } = {}) {\n  const now = ctx.clock.now()\n  const max = CONFIG.analytics.historyDays[await workspacePlan(ctx)]\n  let end = to ? new Date(to) : now\n  let start = from ? new Date(from) : addMs(end, -30 * DAY)\n  if (Number.isNaN(start.getTime()) || Number.isNaN(end.getTime())) throw badRequest('from and to must be valid dates.')\n  const floor = addMs(now, -max * DAY)\n  const clamped = start < floor\n  if (cl