{"timestamp":"2026-08-22T13:32:46.685Z","ordinal":3308,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a029ac-82dd-7aa2-95bc-0d1a5d82aa1c","call_id":"call_uYP6HMdj3iOeo8PHDO9Roa4k","output":[{"type":"input_text","text":"Script completed\nWall time 0.6 seconds\nOutput:\n"},{"type":"input_text","text":"FILES\nSocialMediaGuard.sh\nSocialMediaGuardTimer.swift\n\nSTATUS\n## main...origin/main\n M ../../Skills/README.md\n ? ../Recovery/_legacy/build/ntfs-3g\n\nTOOLCHAIN\nswift-driver version: 1.148.6 Apple Swift version 6.3.3 (swiftlang-6.3.3.1.3 clang-2100.1.1.101)\nTarget: arm64-apple-macosx28.0\nXcode 26.6\nBuild version 17F113\n\nGUARD\n#!/bin/zsh\n#\n# YouTube Guard\n#\n# Rule: YouTube is blocked. One click grants 15 minutes on the whole site.\n# Always free, no click needed: /feed/subscriptions, @IciJapon, @IciJaponCorp.\n#\n# A short list of channels is treated as STRICT: unlocking one of them only\n# buys 1 minute, not 15, and it never rides along on a general 15-minute\n# grant. Watching one of these means clicking through a block screen roughly\n# once a minute — enough friction to break the habit without an outright ban.\n#\n# 1. Settings\n# 2. Reading a URL\n# 3. Grants (general 15 min, strict 1 min)\n# 4. The block page\n# 5. Talking to Chrome\n# 6. The loop\n# 7. Install / uninstall / status\n#\n\nset -u\nexport PATH=\"/usr/bin:/bin:/usr/sbin:/sbin\"\n\n# ---------------------------------------------------------------- 1. Settings\n\nGRANT_MINUTES=15          # general YouTube unlock\nSTRICT_GRANT_MINUTES=1    # unlock for channels in STRICT_CHANNELS\n\n# Channels that get the 1-minute leash instead of the general 15-minute one.\n# Match against the lowercased path, no query/anchor (see UrlPath below).\nSTRICT_CHANNELS=(\n  \"/@gregguillotin\"\n  \"/channel/ucm1c1okz-7cpv7bez-pzugg\"   # Greg Guillotin (main)\n  \"/channel/ucjd8rq4cazzsximqtkqlh1q\"   # Greg Guillotin - La Chaîne Animale\n)\n\nMEMORY_ROOT=\"${MEMORY_ROOT:-/Users/zenray/Create/Build/Memory}\"\nFOCUS_DIR=\"$MEMORY_ROOT/Focus\"\nSTATE_DIR=\"$FOCUS_DIR/.SocialMediaGuardState\"\nTABS_DIR=\"$STATE_DIR/tabs\"\nGRANT_FILE=\"$STATE_DIR/grant_until\"\nSTRICT_GRANT_FILE=\"$STATE_DIR/grant_until_strict\"\n\nBLOCK_PAGE_FILE=\"$FOCUS_DIR/SocialMediaBlocked.html\"\nBLOCK_PAGE_URL=\"file://$BLOCK_PAGE_FILE\"\n\nTIMER_SOURCE=\"$MEMORY_ROOT/Tools/FocusGuard/SocialMediaGuardTimer.swift\"\nTIMER_BIN=\"$STATE_DIR/SocialMediaGuardTimer\"\n\nSCRIPT_PATH=\"$MEMORY_ROOT/Tools/FocusGuard/SocialMediaGuard.sh\"\nUSER_LABEL=\"com.zenray.social-media-guard.tabs\"\nUSER_PLIST=\"$HOME/Library/LaunchAgents/$USER_LABEL.plist\"\n\nSay() { printf '%s\\n' \"$*\"; }\nNow() { date '+%s'; }\n\nEnsureState() {\n  mkdir -p \"$FOCUS_DIR\" \"$STATE_DIR\" \"$TABS_DIR\"\n  chmod 700 \"$STATE_DIR\"\n}\n\n# ---------------------------------------------------------- 2. Reading a URL\n\n# Everything below works on the lowercased URL, with query and anchor removed.\nUrlPath() {\n  local path=\"${1%%\\?*}\"\n  printf '%s' \"${${path%%\\#*}:l}\"\n}\n\nIsYouTube() {\n  case \"${1:l}\" in\n    https://youtube.com*|https://www.youtube.com*|https://m.youtube.com*) return 0 ;;\n    https://music.youtube.com*|https://youtu.be*) return 0 ;;\n    *) return 1 ;;\n  esac\n}\n\n# Pages that never need a grant.\nIsAlwaysFree() {\n  local path; path=\"$(UrlPath \"$1\")\"\n  case \"$path\" in\n    */feed/subscriptions|*/feed/subscriptions/*) return 0 ;;\n    */@icijapon|*/@icijapon/*|*/@icijaponcorp|*/@icijaponcorp/*) return 0 ;;\n    */channel/ucegev5mbdmgmgzfpralemfa|*/channel/ucegev5mbdmgmgzfpralemfa/*) return 0 ;;\n    */channel/uc_r99mjdkzksbgeedoylbkw|*/channel/uc_r99mjdkzksbgeedoylbkw/*) return 0 ;;\n    *) return 1 ;;\n  esac\n}\n\n# Channels on the 1-minute leash.\nIsStrictChannel() {\n  local path pattern; path=\"$(UrlPath \"$1\")\"\n  for pattern in $STRICT_CHANNELS; do\n    case \"$path\" in\n      *\"$pattern\"|*\"$pattern\"/*) return 0 ;;\n    esac\n  done\n  return 1\n}\n\nScope() { IsStrictChannel \"$1\" && printf 'strict' || printf 'general' }\n\nIsBlockPage() { [[ \"$1\" == \"$BLOCK_PAGE_URL\"* ]] }\nIsUnlockClick() { [[ \"$1\" == \"$BLOCK_PAGE_URL\"* ]] && [[ \"$1\" == *\"unlock=1\"* ]] }\nScopeFromURL() { [[ \"$1\" == *\"scope=strict\"* ]] && printf 'strict' || printf 'general' }\n\n# ------------------------------------------------------- 3. Grants (per scope)\n\nGrantFile() { [[ \"$1\" == strict ]] && printf '%s' \"$STRICT_GRANT_FILE\" || printf '%s' \"$GRANT_FILE\" }\nGrantMinutes() { [[ \"$1\" == strict ]] && printf '%s' \"$STRICT_GRANT_MINUTES\" || printf '%s' \"$GRANT_MINUTES\" }\nTimerPidFile() { printf '%s' \"$STATE_DIR/timer_pid_$1\" }\n\nGrantActive() {\n  local file=\"$(GrantFile \"$1\")\" until\n  [[ -s \"$file\" ]] || return 1\n  until=\"$(cat \"$file\" 2>/dev/null || printf '0')\"\n  [[ \"$until\" =~ '^[0-9]+$' ]] || return 1\n  (( $(Now) < until ))\n}\n\nStartGrant() {\n  local scope=\"$1\" file minutes pidfile\n  file=\"$(GrantFile \"$scope\")\"; minutes=\"$(GrantMinutes \"$scope\")\"; pidfile=\"$(TimerPidFile \"$scope\")\"\n  EnsureState\n  printf '%s\\n' $(( $(Now) + minutes * 60 )) > \"$file\"\n  [[ -s \"$pidfile\" ]] && kill \"$(cat \"$pidfile\")\" >/dev/null 2>&1\n  rm -f \"$pidfile\"\n  if [[ -x \"$TIMER_BIN\" ]]; then\n    nohup \"$TIMER_BIN\" \"$file\" >/dev/null 2>&1 </dev/null &\n    printf '%s\\n' $! > \"$pidfile\"\n  fi\n}\n\nEndGrant() {\n  local scope=\"$1\" pidfile; pidfile=\"$(TimerPidFile \"$scope\")\"\n  [[ -s \"$pidfile\" ]] && kill \"$(cat \"$pidfile\")\" >/dev/null 2>&1\n  rm -f \"$pidfile\" \"$(GrantFile \"$scope\")\"\n}\n\n# The pkill sweep catches timers left over by an older version, which knew no\n# pid file: one surviving timer holds the binary open and makes swiftc fail.\nEndAllGrants() {\n  EndGrant general\n  EndGrant strict\n  pkill -x SocialMediaGuardTimer >/dev/null 2>&1 || true\n  rm -f \"$TABS_DIR\"/*(N)\n}\n\n# Each blocked tab remembers where it was going, keyed by its Chrome tab id.\nRememberTab() { printf '%s\\n' \"$2\" > \"$TABS_DIR/$1\" }\nRecallTab() { cat \"$TABS_DIR/$1\" 2>/dev/null }\nForgetTab() { rm -f \"$TABS_DIR/$1\" }\n\n# --------------------------------------------------------- 4. The block page\n\nWriteBlockPage() {\n  cat > \"$BLOCK_PAGE_FILE\" <<HTML\n<!doctype html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>YouTube bloqué</title>\n<style>\n  :root {\n    color-scheme: dark;\n    --font-sans: \"Inter Variable\", \"Inter\", sans-serif;\n    --font-serif: \"AnthropicSerif\", serif;\n    --font-mono: \"AnthropicMono\", monospace;\n    --font-sans-weight: 400;\n    --font-serif-weight: 350;\n    --font-number-weight: 400;\n  }\n  * { box-sizing: border-box }\n  body { margin: 0; min-height: 100vh; display: grid; place-items: center;\n         background: #202020; color: #f3f3f3; font-family: var(--font-sans);\n         font-size: 18px; font-weight: var(--font-sans-weight) }\n  main { width: min(620px, calc(100vw - 40px)); padding: 56px 40px; text-align: center;\n         border-radius: 18px; background: #292929; box-shadow: 0 24px 80px #0005 }\n  h1 { margin: 0; font-family: var(--font-serif); font-size: clamp(32px, 6vw, 58px);\n       font-weight: var(--font-serif-weight); line-height: 1.08 }\n  p { color: #aaa; font-weight: var(--font-sans-weight); line-height: 1.5 }\n  .number { font-family: var(--font-serif); font-weight: var(--font-number-weight) }\n  a { display: inline-block; margin-top: 18px; padding: 14px 28px; border-radius: 999px;\n      background: #f3f3f3; color: #202020; text-decoration: none; font-weight: var(--font-sans-weight) }\n  a:active { background: #c9c9c9 }\n</style>\n</head>\n<body>\n<main>\n  <h1 id=\"h1\">YouTube est bloqué.</h1>\n  <p id=\"p\">Un clic ouvre YouTube en entier pendant <span id=\"mins\" class=\"number\">$GRANT_MINUTES</span> minutes.</p>\n  <a id=\"unlock\" href=\"?unlock=1\">Ouvrir</a>\n</main>\n<script>\n  var minutesByScope = { general: $GRANT_MINUTES, strict: $STRICT_GRANT_MINUTES };\n  var scope = new URLSearchParams(location.search).get('scope') === 'strict' ? 'strict' : 'general';\n  var minutes = minutesByScope[scope];\n  document.getElementById('mins').textContent = minutes;\n  document.getElementById('unlock').href = '?unlock=1&scope=' + scope;\n  document.getElementById('unlock').innerHTML = 'Ouvrir <span class=\"number\">' + minutes + '</span> minute' + (minutes > 1 ? 's' : '');\n  if (scope === 'strict') {\n    document.title = 'Chaîne bloquée';\n    document.getElementById('h1').textContent = 'Cette chaîne est bloquée.';\n    document.getElementById('p').innerHTML = 'Elle recommence à couper toutes les <span class=\"number\">' + minutes + '</span> minute' + (minutes > 1 ? 's' : '') + '.';\n  }\n</script>\n</body>\n</html>\nHTML\n  chmod 644 \"$BLOCK_PAGE_FILE\"\n}\n\n# ------------------------------------------------------- 5. Talking to Chrome\n\n# One line per tab: window index, tab index, tab id, URL.\nListTabs() {\n  pgrep -x \"Google Chrome\" >/dev/null 2>&1 || return 0\n  osascript <<'APPLESCRIPT' 2>/dev/null || true\nset output to \"\"\nset sep to ASCII character 9\ntell application \"Google Chrome\"\n  repeat with w from 1 to (count of windows)\n    repeat with t from 1 to (count of tabs of window w)\n      try\n        set theTab to tab t of window w\n        set output to output & w & sep & t & sep & (id of theTab) & sep & (URL of theTab as text) & linefeed\n      end try\n    end repeat\n  end repeat\nend tell\nreturn output\nAPPLESCRIPT\n}\n\nSetTabURL() {\n  osascript - \"$1\" \"$2\" \"$3\" <<'APPLESCRIPT' >/dev/null 2>&1 || true\non run argv\n  set w to (item 1 of argv) as integer\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a029ac-110d-7110-8144-fd53c9c4b6bb","create_time":1787405566.685769}}}
