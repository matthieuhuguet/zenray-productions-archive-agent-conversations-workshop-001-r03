 panel.level = .floating\n        panel.hidesOnDeactivate = false\n        panel.collectionBehavior = [.canJoinAllSpaces, .fullScreenAuxiliary]\n        panel.backgroundColor = .clear\n        panel.isOpaque = false\n        panel.hasShadow = true\n        panel.isMovableByWindowBackground = true\n        panel.contentView = NSHostingView(\n            rootView: SleepShutdownView(model: model, onShutdown: { [weak self] in\n                self?.shutdownMac()\n            })\n        )\n\n        self.panel = panel\n        positionPanel()\n        panel.orderFrontRegardless()\n\n        NotificationCenter.default.addObserver(\n            self,\n            selector: #selector(repositionPanel),\n            name: NSApplication.didChangeScreenParametersNotification,\n            object: nil\n        )\n    }\n\n    func applicationShouldTerminateAfterLastWindowClosed(_ sender: NSApplication) -> Bool {\n        false\n    }\n\n    @objc private func repositionPanel() {\n        positionPanel()\n    }\n\n    private func positionPanel() {\n        guard let panel, let screen = NSScreen.main else { return }\n        let visibleFrame = screen.visibleFrame\n        let origin = NSPoint(\n            x: visibleFrame.maxX - panel.frame.width - model.config.widgetMargin,\n            y: visibleFrame.minY + model.config.widgetMargin\n        )\n        panel.setFrameOrigin(origin)\n    }\n\n    private func shutdownMac() {\n        var error: NSDictionary?\n        let script = #\"tell application \"System Events\" to shut down\"#\n        NSAppleScript(source: script)?.executeAndReturnError(&error)\n\n        if error != nil {\n            model.shutdownError = \"macOS n’a pas autorisé l’extinction. Autorise Sleep Shutdown dans Réglages Système.\"\n        }\n    }\n}\n\n@main\nstruct SleepShutdownMain {\n    static func main() {\n        let application = NSApplication.shared\n        let delegate = AppDelegate()\n        application.delegate = delegate\n        application.run()\n    }\n}\n"},"/Users/zenray/Create/Build/Memory/Tools/SleepShutdown/.gitignore":{"type":"add","content":".build/\ndist/\n"},"/Users/zenray/Create/Build/Memory/Tools/SleepShutdown/Scripts/install.sh":{"type":"add","content":"#!/bin/zsh\nset -euo pipefail\n\nPROJECT_ROOT=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\nUSER_HOME=\"$(/usr/bin/dscl . -read \"/Users/$USER\" NFSHomeDirectory | /usr/bin/awk '{print $2}')\"\nAPP_DEST=\"$USER_HOME/Applications/SleepShutdown.app\"\nPLIST_DEST=\"$USER_HOME/Library/LaunchAgents/com.zenray.sleep-shutdown.plist\"\nTEMPLATE=\"$PROJECT_ROOT/Resources/com.zenray.sleep-shutdown.plist.template\"\nGUI_DOMAIN=\"gui/$(/usr/bin/id -u)\"\n\n\"$PROJECT_ROOT/Scripts/build.sh\"\nmkdir -p \"$USER_HOME/Applications\" \"$USER_HOME/Library/LaunchAgents\" \"$USER_HOME/Library/Logs\"\nrm -rf \"$APP_DEST\"\nditto \"$PROJECT_ROOT/dist/SleepShutdown.app\" \"$APP_DEST\"\n\n/usr/bin/sed \\\n    -e \"s|__APP_PATH__|$APP_DEST|g\" \\\n    -e \"s|__USER_HOME__|$USER_HOME|g\" \\\n    \"$TEMPLATE\" > \"$PLIST_DEST\"\n\nlaunchctl bootout \"$GUI_DOMAIN/com.zenray.sleep-shutdown\" >/dev/null 2>&1 || true\nlaunchctl bootstrap \"$GUI_DOMAIN\" \"$PLIST_DEST\"\nlaunchctl kickstart -k \"$GUI_DOMAIN/com.zenray.sleep-shutdown\"\nprintf 'Installed and launched %s\\n' \"$APP_DEST\"\n"},"/Users/zenray/Create/Build/Memory/Tools/SleepShutdown/README.md":{"type":"add","content":"# Sleep Shutdown\n\nPetite application macOS native en Swift qui garde un rappel visuel flottant en bas à droite.\n\n## Fonctionnement\n\n- Le mode de test est réglé à `22:00` dans `Sources/SleepShutdown/AppConfig.swift`.\n- Après validation, remplacer uniquement `sleepStartHour = 22` par `sleepStartHour = 0`.\n- Le widget ne joue aucun son.\n- Le bouton d’extinction demande une confirmation avant de demander à macOS d’éteindre la machine.\n- Le LaunchAgent relance l’application à la connexion et la garde active.\n\n## Construire et installer\n\n```zsh\n./Scripts/build.sh\n./Scripts/install.sh\n```\n\nL’application installée est `~/Applications/SleepShutdown.app`.\n\n## Vérifier l’état\n\n```zsh\nlaunchctl print \"gui/$(id -u)/com.zenray.sleep-shutdown\"\n```\n\nLe test se fait sans attendre 22:00 en modifiant temporairement `sleepStartHour` à l’heure courante, puis en reconstruisant. La valeur de production reste `0` uniquement après validation visuelle du widget et du bouton.\n"},"/Users/zenray/Create/Build/Memory/Tools/SleepShutdown/Sources/SleepShutdown/AppConfig.swift":{"type":"add","content":"import Foundation\n\nstruct AppConfig {\n    // Debug test: 22:00. Change this single value to 0 after validation for midnight.\n    let sleepStartHour = 22\n    let sleepStartMinute = 0\n    let widgetWidth: CGFloat = 380\n    let widgetHeight: CGFloat = 250\n    let widgetMargin: CGFloat = 22\n}\n"},"/Users/zenray/Create/Build/Memory/Tools/SleepShutdown/Resources/com.zenray.sleep-shutdown.plist.template":{"type":"add","content":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n\t<key>Label</key>\n\t<string>com.zenray.sleep-shutdown</string>\n\t<key>ProgramArguments</key>\n\t<array>\n\t\t<string>__APP_PATH__/Contents/MacOS/SleepShutdown</string>\n\t</array>\n\t<key>RunAtLoad</key>\n\t<true/>\n\t<key>KeepAlive</key>\n\t<true/>\n\t<key>ProcessType</key>\n\t<string>Interactive</string>\n\t<key>LimitLoadToSessionType</key>\n\t<array>\n\t\t<string>Aqua</string>\n\t</array>\n\t<key>StandardOutPath</key>\n\t<string>__USER_HOME__/Library/Logs/SleepShutdown.log</string>\n\t<key>StandardErrorPath</key>\n\t<string>__USER_HOME__/Library/Logs/SleepShutdown.error.log</string>\n</dict>\n</plist>\n"},"/Users/zenray/Create/Build/Memory/Tools/SleepShutdown/Resources/Info.plist":{"type":"add","content":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\