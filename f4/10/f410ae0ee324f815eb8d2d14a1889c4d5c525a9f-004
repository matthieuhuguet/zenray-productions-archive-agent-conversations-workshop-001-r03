ation }\n    }\n    for child in children(of: application) {\n        if let match = findWindow(in: child) { return match }\n    }\n    return nil\n}\n\nprivate func findToggles(in element: AXUIElement, result: inout [AXUIElement]) {\n    if isToggle(element) { result.append(element) }\n    for child in children(of: element) { findToggles(in: child, result: &result) }\n}\n\nprivate func runningSystemSettings() -> NSRunningApplication? {\n    NSWorkspace.shared.runningApplications.first { $0.bundleIdentifier == \"com.apple.systempreferences\" }\n}\n\nprivate func openAppLimits() throws -> (NSRunningApplication, AXUIElement) {\n    _ = NSWorkspace.shared.open(appLimitsURL)\n\n    var app: NSRunningApplication?\n    for _ in 0..<30 {\n        app = runningSystemSettings()\n        if app != nil { break }\n        Thread.sleep(forTimeInterval: 0.2)\n    }\n    guard let settings = app else { throw ScreenTimeError.settingsUnavailable }\n\n    settings.unhide()\n    _ = settings.activate(options: [.activateAllWindows])\n\n    let application = AXUIElementCreateApplication(settings.processIdentifier)\n    for _ in 0..<50 {\n        if let window = findWindow(in: application) { return (settings, window) }\n        Thread.sleep(forTimeInterval: 0.2)\n    }\n    throw ScreenTimeError.appLimitsWindowUnavailable\n}\n\nprivate func firstToggle(in window: AXUIElement) -> AXUIElement? {\n    var toggles: [AXUIElement] = []\n    findToggles(in: window, result: &toggles)\n    return toggles.first\n}\n\nprivate func keyCode(for digit: Character) -> CGKeyCode? {\n    switch digit {\n    case \"0\": return 29\n    case \"1\": return 18\n    case \"2\": return 19\n    case \"3\": return 20\n    case \"4\": return 21\n    case \"5\": return 23\n    case \"6\": return 22\n    case \"7\": return 26\n    case \"8\": return 28\n    case \"9\": return 25\n    default: return nil\n    }\n}\n\nprivate func postKey(_ key: CGKeyCode) {\n    let down = CGEvent(keyboardEventSource: nil, virtualKey: key, keyDown: true)\n    let up = CGEvent(keyboardEventSource: nil, virtualKey: key, keyDown: false)\n    down?.post(tap: .cghidEventTap)\n    usleep(35_000)\n    up?.post(tap: .cghidEventTap)\n    usleep(35_000)\n}\n\nprivate func enterPasscode(_ passcode: String) throws {\n    for _ in 0..<4 { postKey(51) }\n    for digit in passcode {\n        guard let key = keyCode(for: digit) else { throw ScreenTimeError.invalidPasscode }\n        postKey(key)\n    }\n}\n\nprivate func pressToggleAndAuthenticate(_ toggle: AXUIElement, passcode: String) throws {\n    let error = AXUIElementPerformAction(toggle, kAXPressAction as CFString)\n    guard error == .success else { throw ScreenTimeError.togglePressFailed(error) }\n    Thread.sleep(forTimeInterval: 0.8)\n    try enterPasscode(passcode)\n    Thread.sleep(forTimeInterval: 2.0)\n}\n\nprivate func disableAppLimits() throws {\n    let passcode = ProcessInfo.processInfo.environment[\"SCREEN_TIME_PASSCODE\"] ?? \"\"\n    guard !passcode.isEmpty else { throw ScreenTimeError.missingPasscode }\n    guard passcode.count == 4 && passcode.allSatisfy(\\.isNumber) else { throw ScreenTimeError.invalidPasscode }\n\n    var (_, window) = try openAppLimits()\n    guard let initialToggle = firstToggle(in: window) else { throw ScreenTimeError.appLimitsToggleUnavailable }\n\n    // Screen Time can leave the switch visually off while a protected change is pending.\n    // One authenticated press normalizes that state; the second is used only if macOS\n    // reports that the global switch ended up on.\n    try pressToggleAndAuthenticate(initialToggle, passcode: passcode)\n\n    for _ in 0..<2 {\n        (_, window) = try openAppLimits()\n        guard let toggle = firstToggle(in: window) else { throw ScreenTimeError.appLimitsToggleUnavailable }\n        guard let isOn = toggleState(of: toggle) else { throw ScreenTimeError.appLimitsToggleUnavailable }\n        if !isOn {\n            print(\"Screen Time : App Limits est désactivé.\")\n            return\n        }\n        try pressToggleAndAuthenticate(toggle, passcode: passcode)\n    }\n\n    throw ScreenTimeError.appLimitsStillEnabled\n}\n\nguard CommandLine.arguments.contains(\"--disable-app-limits\") else {\n    fputs(\"Usage : fix-entertainment.sh\\n\", stderr)\n    exit(2)\n}\n\ndo {\n    try disableAppLimits()\n} catch {\n    fputs(\"Screen Time : \\(error.localizedDescription)\\n\", stderr)\n    exit(1)\n}\n"}},"status":"completed","stdout":"Success. Updated the following files:\nA /Users/zenray/Create/Build/Memory/Tools/ScreenTime/Scripts/fix-entertainment.sh\nA /Users/zenray/Create/Build/Memory/Tools/ScreenTime/Scripts/ScreenTimeAX.swift\n"},"completed_at_ms":1787408209127}}
