n\nfunction avecVerrou(cible, action) {\n  const verrou = `${cible}.lock`\n  fs.mkdirSync(path.dirname(cible), { recursive: true })\n  for (let essai = 0; essai < 100; essai++) {\n    try {\n      fs.mkdirSync(verrou)\n      fs.writeFileSync(path.join(verrou, 'owner.json'), JSON.stringify({ pid: process.pid, at: Date.now() }))\n      try { return action() }\n      finally { fs.rmSync(verrou, { recursive: true, force: true }) }\n    } catch (error) {\n      if (error?.code !== 'EEXIST') throw error\n      let proprietaire = null\n      try { proprietaire = JSON.parse(fs.readFileSync(path.join(verrou, 'owner.json'), 'utf8')) } catch {}\n      if (proprietaire && Date.now() - proprietaire.at > 30_000 && !processusExiste(proprietaire.pid)) {\n        fs.rmSync(verrou, { recursive: true, force: true })\n        continue\n      }\n      pause(50)\n    }\n  }\n  throw new Error(`verrou occupé depuis plus de 5 s : ${verrou}`)\n}\n\nfunction horodatage(date = new Date()) {\n  const p = new Intl.DateTimeFormat('sv-SE', {\n    timeZone: 'Asia/Tokyo', year: 'numeric', month: '2-digit', day: '2-digit',\n    hour: '2-digit', minute: '2-digit', hour12: false,\n  }).formatToParts(date).reduce((a, x) => ({ ...a, [x.type]: x.value }), {})\n  return `${p.year}-${p.month}-${p.day} ${p.hour}:${p.minute}`\n}\n\nfunction fichiersRecursifs(racine, suffixe, profondeur = 0) {\n  if (profondeur > 5 || !fs.existsSync(racine)) return []\n  const resultat = []\n  for (const entree of fs.readdirSync(racine, { withFileTypes: true })) {\n    const fichier = path.join(racine, entree.name)\n    if (entree.isDirectory()) resultat.push(...fichiersRecursifs(fichier, suffixe, profondeur + 1))\n    else if (entree.name.endsWith(suffixe)) resultat.push(fichier)\n  }\n  return resultat\n}\n\nfunction runtimeCodex() {\n  const session = process.env.CODEX_SESSION_ID || process.env.CODEX_THREAD_ID\n  if (!session) return null\n  const candidats = fichiersRecursifs(path.join(os.homedir(), '.codex', 'sessions'), `${session}.jsonl`)\n  const fichier = candidats.sort((a, b) => fs.statSync(b).mtimeMs - fs.statSync(a).mtimeMs)[0]\n  let model = '', effort = '', agent = 'Codex Desktop'\n  if (fichier) {\n    const lignes = fs.readFileSync(fichier, 'utf8').trimEnd().split('\\n')\n    for (const ligne of lignes) {\n      try {\n        const evenement = JSON.parse(ligne)\n        if (evenement.type === 'session_meta') agent = evenement.payload?.originator || agent\n        if (evenement.type === 'turn_context') {\n          model = evenement.payload?.model || model\n          effort = evenement.payload?.effort || effort\n        }\n      } catch {}\n    }\n  }\n  return { agent, model: model || 'non exposé par l’hôte', effort: effort || 'non exposé par l’hôte' }\n}\n\nfunction runtimeClaude() {\n  const actif = process.env.CLAUDECODE || process.env.CLAUDE_CODE_ENTRYPOINT || process.env.CLAUDE_CODE_SESSION_ID\n  if (!actif) return null\n  return { agent: 'Claude Code Desktop', model: 'non exposé par l’hôte', effort: 'non exposé par l’hôte' }\n}\n\nfunction runtime(options = {}) {\n  const detecte = runtimeCodex() || runtimeClaude()\n  const agent = options.agent || detecte?.agent\n  if (!agent) throw new Error('agent non identifiable ; passer --agent depuis les métadonnées de l’hôte')\n  return {\n    agent,\n    model: options.model || detecte?.model || 'non exposé par l’hôte',\n    effort: options.effort || detecte?.effort || 'non exposé par l’hôte',\n  }\n}\n\nfunction masquer(texte) {\n  let masque = false\n  const lignes = String(texte).split('\\n').map((ligne) => {\n    if (/(?:mot de passe|password).*(?:=|:)/i.test(ligne)) {\n      masque = true\n      return '- Sécurité : contenu sensible masqué ; consulter sa source autorisée si l’action l’exige.'\n    }\n    const suivant = ligne\n      .replace(/ghp_[A-Za-z0-9]{20,}/g, () => { masque = true; return '[SECRET MASQUÉ]' })\n      .replace(/sk-[A-Za-z0-9_-]{20,}/g, () => { masque = true; return '[SECRET MASQUÉ]' })\n      .replace(/AKIA[0-9A-Z]{16}/g, () => { masque = true; return '[SECRET MASQUÉ]' })\n      .replace(/Bearer [A-Za-z0-9._-]{20,}/g, () => { masque = true; return 'Bearer [SECRET MASQUÉ]' })\n    return suivant\n  })\n  return { texte: lignes.join('\\n'), masque }\n}\n\nfunction entete() {\n  return `# PROGRESS global\\n\\nJournal chronologique unique de Claude Code et Codex pour tous les projets de Matthieu.\\nLes bases durables vivent dans /Users/zenray/Create/Build/Memory/**/**1.md ; ce fichier ne garde que les faits, décisions, preuves, échecs et pointeurs utiles à la reprise.\\n\\nRègles et écriture atomique : /Users/zenray/.claude/skills/progress/SKILL.md\\n\\n---\\n\\n`\n}\n\nfunction ecrireAppend(cible, texte) {\n  const fd = fs.openSync(cible, fs.constants.O_CREAT | fs.constants.O_WRONLY | fs.constants.O_APPEND, 0o600)\n  try { fs.writeSync(fd, texte, null, 'utf8') } finally { fs.closeSync(fd) }\n}\n\nfunction append(options) {\n  if (!options.project) aide('--project est obligatoire')\n  if (!options.fait) aide('--fait est obligatoire')\n  const cible = path.resolve(options.target || CIBLE_PAR_DEFAUT)\n  const contexte = runtime(options)\n  const corps = [\n    horodatage(),\n    `- Agent : ${contexte.agent}`,\n    `- Modèle : ${contexte.model} · effort ${contexte.effort}`,\n    `- Projet : ${options.project}`,\n  ]\n  for (const [cle, label] of CHAMPS) if (options[cle]) corps.push(`- ${label} : ${options[cle]}`)\n  const nettoye = masquer(corps.join('\\n'))\n  if (nettoye.masque) nettoye.texte += '\\n- Sécurité : au moins une valeur sensible a été masquée automatiquement.'\n  avecVerrou(cible, () => {\n    if (!fs.existsSync(cible)) ecrireAppend(cible, entete())\n    ecrireAppend(cible, `${nettoye.texte}\\n\\n`)\n  })\n  console.log(JSON.stringify({ ok: true, cible, runtime: contexte, secretMasque: nettoye.masque }))\n}\n\nfunction blocsLegacy(fichier) {\n  const lignes = fs.readFileSync(fichier, 'utf8').split(/\\r?\\n/)\n  const debuts = []\n  const re = /^#{0,3}\\s*(\\d{4}-\\d{2}-\\d{2})(?:\\s+(\\d{2}:\\d{2}|HH:MM))?\\b/\n  for (let i = 0; i < lignes.length; i++) {\n    const m = lignes[i].match(re)\n    if (m) debuts.push({ index: i, date: m[1], heure: m[2] || '00:00' })\n  }\n  return debuts.map((debut, n) => {\n    const fin = debuts[n + 1]?.index ?? lignes.length\n    const brut = lignes.slice(debut.index + 1, fin).join('\\n').trim()\n    const heure = debut.heure === 'HH:MM' ? '00:00' : debut.heure\n    const id = crypto.createHash('sha256').update(`${fichier}\\n${debut.index + 1}\\n${lignes.slice(debut.index, fin).join('\\n')}`).digest('hex').slice(0, 20)\n    return { id, at: `${debut.date} ${heure}`, originalAt: `${debut.date} ${debut.heure}`, ligne: debut.index + 1, brut }\n  })\n}\n\nfunction nomProjet(fichier) {\n  const parent = path.basename(path.dirname(fichier))\n  return parent === 'Memory' ? 'Memory global legacy' : parent\n}\n\nfunction importer(options) {\n  if (!options.source.length) aide('au moins un --source est obligatoire')\n  const cible = path.resolve(options.target || CIBLE_PAR_DEFAUT)\n  const sources = options.source.map((x) => path.resolve(x))\n  for (const source of sources) if (!fs.existsSync(source)) throw new Error(`source absente : ${source}`)\n  avecVerrou(cible, () => {\n    const existant = fs.existsSync(cible) ? fs.readFileSync(cible, 'utf8') : ''\n    const ids = new Set([...existant.matchAll(/<!-- legacy-id:([a-f0-9]{20}) -->/g)].map((m) => m[1]))\n    const blocs = sources.flatMap((source) => blocsLegacy(source).map((bloc) => ({ ...bloc, source })))\n      .sort((a, b) => a.at.localeCompare(b.at) || a.source.localeCompare(b.source) || a.ligne - b.ligne)\n    let ajoutees = 0, masquees = 0, sortie = fs.existsSync(cible) ? '' : entete()\n    for (const bloc of blocs) {\n      if (ids.has(bloc.id)) continue\n      const corps = masquer(bloc.brut)\n      if (corps.masque) masquees++\n      sortie += `<!-- legacy-id:${bloc.id} -->\\n${bloc.originalAt}\\n- Agent : historique antérieur, non attribuable\\n- Modèle : non exposé dans le journal source\\n- Projet : ${nomProjet(bloc.source)}\\n- Source legacy : \\`${bloc.source}:${bloc.ligne}\\`\\n${corps.texte}\\n\\n`\n      ajoutees++\n    }\n    if (sortie) ecrireAppend(cible, sortie)\n    console.log(JSON.stringify({ ok: true, cible, sources: sources.length, ajoutees, ignorees: blocs.length - ajoutees, entreesMasquees: masquees }))\n  })\n}\n\nfunction entrees(texte) {\n  const lignes = texte.split(/\\r?\\n/)\n  const debuts = []\n  for (let i = 0; i < lignes.length; i++) if (/^(?:\\d{4}-\\d{2}-\\d{2}) (?:\\d{2}:\\d{2}|HH:MM)\\b/.test(lignes[i])) debuts.push(i)\n  return debuts.map((debut, n) => lignes.slice(debut, debuts[n + 1] ?? lignes.length).join('\\n').trim())\n}\n\nfunction tail(options) {\n  const cible = path.resolve(options.target || CIBLE_PAR_DEFAUT)\n  if (!fs.existsSync(cible)) throw new Error(`journal absent : ${cible}`)\n  const count = Math.max(1, Math.min(50, Number(options.count || 3)))\n  const projet = options.project?.toLocaleLowerCase('fr')\n  let selection = entrees(fs.readFileSync(cible, 'utf8'))\n  if (projet) selection = selection.filter((x) => x.toLocaleLowerCase('fr').includes(`- projet : ${projet}`))\n  console.log(selection.slice(-count).join('\\n\\n'))\n}\n\nconst [commande, ...reste] = process.argv.slice(2)\nconst options = argumentsDe(reste)\ntry {\n  if (commande === 'append') append(options)\n  else if (commande === 'tail') tail(options)\n  else if (commande === 'runtime') console.log(JSON.stringify(runtime(options), null, 2))\n  else if (commande === 'import-legacy') importer(options)\n  else aide()\n} catch (error) {\n  console.error(error?.stack || String(error))\n  process.exit(1)\n}\n"},"/Users/zenray/.claude/skills/progress/SKILL.md":{"type":"add","content":"---\nname: progress\ndescription: Écrire et relire l’unique journal chronologique global de Matthieu dans ~/.claude/PROGRESS.md, quel que soit le projet et que l’agent soit Claude Code ou Codex. Utiliser automatiquement à chaque tâche, décision, mesure, échec, blocage, reprise ou demande « où en est-on ». Ne jamais créer de PROGRESS.md dans un projet.\n---\n\n# Progress global\n\nCe skill gère une seule chronologie pour toutes les sessions :\n\n`/Users/zenray/.claude/PROGRESS.md`\n\nIl ne remplace pas les bases de contexte de Memory. Les rôles restent séparés :\n\n- `~/.claude/PROGRESS.md` raconte **quand et quoi** à travers tous les projets ;\n- `Memory/<domaine>/<Nom>1.md` conserve **ce que le projet sait durablement** ;\n- un skill routeur indique quelle source `*1.md` lire ou compléter ;\n- `CLAUDE.md` porte les lois ; le code et ses commentaires portent l’implémentation.\n\nUne même session peut donc produire deux écritures sans duplication : le détail durable s’ajoute au bon\n`*1.md`, puis le journal global en garde une ligne courte et le chemin de cette source.\n\n## Écrire\n\nPasser toujours par le script, car Claude Code et Codex peuvent écrire au même instant :\n\n```zsh\nnode /Users/zenray/.claude/skills/progress/scripts/progress.mjs append \\\n  --project \"Nom du projet\" \\\n  --fait \"Résultat factuel\" \\\n  --verifie \"Commande ou preuve\" \\\n  --source-durable \"/chemin/vers/Projet1.md\" \\\n  --prochain \"Action suivante\"\n```\n\nChamps facultatifs : `--mesure`, `--decision`, `--echoue`, `--ecarte`, `--apprentissage`, `--blocage`.\n`--project` et `--fait` sont obligatoires. Ne jamais construire l’entrée à la main.\n\nLe script :\n\n- prend un verrou interprocessus, puis écrit toute l’entrée en un seul append ;\n- identifie Codex depuis le transcript de la session et relève le modèle et l’effort réellement utilisés ;\n- identifie Claude Code depuis son environnement, mais écrit `non exposé par l’hôte` si le modèle courant\n  n’est pas démontrable ;\n- masque toute valeur qui ressemble à un secret ;\n- refuse un agent inconnu au lieu d’en inventer un.\n\nPour Claude Code, passer `--model` et `--effort` seulement si les métadonnées de la session les exposent\nréellement. Le nom que le modèle donne de lui-même n’est pas une preuve ; l’hôte ou le transcript le sont.\n\n## Relire\n\nAu début d’une session, lire seulement les dernières entrées utiles, jamais le fichier entier :\n\n```zsh\nnode /Users/zenray/.claude/skills/progress/scripts/progress.mjs tail --count 3\nnode /Users/zenray/.claude/skills/progress/scripts/progress.mjs tail --project \"ZenRayShards\" --count 3\n```\n\nDonner ensuite en trois lignes maximum les trois derniers faits pertinents et la dernière étape `Prochain`.\n\n## Router vers Memory\n\nQuand le fait change la connaissance durable d’un domaine, utiliser son routeur avant l’entrée globale :\n\n- `matthieu-context` vers `Identity/Matthieu1.md` ;\n- `japanese-context` vers `Japanese/Japanese1.md` ;\n- `zenrayshards-context` vers `ZenRayShards/ZenRayShards1.md` ;\n- les autres domaines suivent le même contrat : un `*1.md` unique et un skill routeur court.\n\nNe jamais transformer le journal global en base de projet. L’entrée cite la source durable, elle ne la copie pas.\n\n## Journaux historiques\n\nLes anciens `PROGRESS.md` sont des sources legacy en lecture seule jusqu’à validation explicite de Matthieu.\nNe pas les compléter, déplacer, archiver ni supprimer. Leur agrégation se fait de manière idempotente :\n\n```zsh\nnode /Users/zenray/.claude/skills/progress/scripts/progress.mjs import-legacy \\\n  --source /chemin/ancien/PROGRESS.md\n```\n\nLe script ajoute un identifiant par entrée, ignore les doublons et masque les secrets dans la copie globale.\nL’original reste intact.\n\n## Déclencheurs\n\nÉcrire automatiquement après une tâche finie, une décision, une mesure, une piste échouée ou écartée, un\nblocage rencontré ou levé, une modification structurelle, un apprentissage notable, une pause, une compaction,\nou une demande explicite de sauvegarde. Une action triviale sans information durable ne mérite pas une entrée.\n\n"}},"status":"completed","stdout":"Success. Updated the following files:\nA /Users/zenray/.claude/skills/progress/SKILL.md\nA /Users/zenray/.claude/skills/progress/scripts/progress.mjs\n"},"completed_at_ms":1787257915953}}
