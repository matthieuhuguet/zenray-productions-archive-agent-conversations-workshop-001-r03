sr/bin/codesign -A\n\nsecurity add-trusted-cert -p codeSign -k \"$KEYCHAIN\" \"$TMP/cert.pem\"\n\necho\necho \"Done. Rebuild the app to sign with '$NAME':\"\necho \"  ./build.sh\"\n  364    26:33 endpointsecurityd\n  396    26:33 /usr/sbin/securityd -i\n  486    26:33 /usr/libexec/securityd_system\n22355    01:05 /System/Library/Frameworks/Security.framework/Versions/A/MachServices/SecurityAgent.bundle/Contents/MacOS/SecurityAgent\n  1) 4E1327B2F4EAD69568665B6698E915A4D0AD897A \"ZenRayDictate Local\"\n     1 valid identities found\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a02869-a886-7d83-965d-3989011e7b47","create_time":1787384834.421433}}}
