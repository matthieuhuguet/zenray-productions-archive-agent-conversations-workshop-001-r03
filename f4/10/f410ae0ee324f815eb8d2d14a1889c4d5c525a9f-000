{"timestamp":"2026-08-20T16:19:58.955Z","ordinal":607,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a01ff8-df6b-7121-96eb-4316914fd348","call_id":"call_C7HWHBwWs2tICxufNss4Vxxr","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"--- SocialMediaGuard.sh UI ---\n  EndGrant strict\n  pkill -x SocialMediaGuardTimer >/dev/null 2>&1 || true\n  rm -f \"$TABS_DIR\"/*(N)\n}\n\n# Each blocked tab remembers where it was going, keyed by its Chrome tab id.\nRememberTab() { printf '%s\\n' \"$2\" > \"$TABS_DIR/$1\" }\nRecallTab() { cat \"$TABS_DIR/$1\" 2>/dev/null }\nForgetTab() { rm -f \"$TABS_DIR/$1\" }\n\n# --------------------------------------------------------- 4. The block page\n\nWriteBlockPage() {\n  cat > \"$BLOCK_PAGE_FILE\" <<HTML\n<!doctype html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>YouTube bloqué</title>\n<style>\n  :root { color-scheme: dark }\n  * { box-sizing: border-box }\n  body { margin: 0; min-height: 100vh; display: grid; place-items: center;\n         background: #202020; color: #f3f3f3; font: 300 18px system-ui, sans-serif }\n  main { width: min(620px, calc(100vw - 40px)); padding: 56px 40px; text-align: center;\n         border-radius: 18px; background: #292929; box-shadow: 0 24px 80px #0005 }\n  h1 { margin: 0; font: 300 clamp(32px, 6vw, 58px)/1.08 Georgia, serif }\n  p { color: #aaa; line-height: 1.5 }\n  a { display: inline-block; margin-top: 18px; padding: 14px 28px; border-radius: 999px;\n      background: #f3f3f3; color: #202020; text-decoration: none; font-weight: 600 }\n  a:active { background: #c9c9c9 }\n</style>\n</head>\n<body>\n<main>\n  <h1 id=\"h1\">YouTube est bloqué.</h1>\n  <p id=\"p\">Un clic ouvre YouTube en entier pendant <span id=\"mins\">$GRANT_MINUTES</span> minutes.</p>\n  <a id=\"unlock\" href=\"?unlock=1\">Ouvrir</a>\n</main>\n<script>\n  var minutesByScope = { general: $GRANT_MINUTES, strict: $STRICT_GRANT_MINUTES };\n  var scope = new URLSearchParams(location.search).get('scope') === 'strict' ? 'strict' : 'general';\n  var minutes = minutesByScope[scope];\n  document.getElementById('mins').textContent = minutes;\n  document.getElementById('unlock').href = '?unlock=1&scope=' + scope;\n  document.getElementById('unlock').textContent = 'Ouvrir ' + minutes + ' minute' + (minutes > 1 ? 's' : '');\n  if (scope === 'strict') {\n    document.title = 'Chaîne bloquée';\n    document.getElementById('h1').textContent = 'Cette chaîne est bloquée.';\n    document.getElementById('p').textContent = 'Elle recommence à couper toutes les ' + minutes + ' minute' + (minutes > 1 ? 's' : '') + '.';\n  }\n</script>\n</body>\n</html>\nHTML\n  chmod 644 \"$BLOCK_PAGE_FILE\"\n}\n\n# ------------------------------------------------------- 5. Talking to Chrome\n\n# One line per tab: window index, tab index, tab id, URL.\nListTabs() {\n  pgrep -x \"Google Chrome\" >/dev/null 2>&1 || return 0\n  osascript <<'APPLESCRIPT' 2>/dev/null || true\nset output to \"\"\nset sep to ASCII character 9\ntell application \"Google Chrome\"\n  repeat with w from 1 to (count of windows)\n    repeat with t from 1 to (count of tabs of window w)\n      try\n--- SocialMediaGuardTimer.swift ---\nimport AppKit\n\n// Small floating card, bottom right, showing the time left on the YouTube grant.\n// It shows up while Chrome is in front on a YouTube page, and quits at zero.\n// It gets out of the way fast when Chrome goes fullscreen: a card parked over a\n// film is worse than no card at all.\n\nprivate enum Config {\n    static let panelSize = NSSize(width: 178, height: 64)\n    static let screenMargin: CGFloat = 24\n\n    static let tickInterval: TimeInterval = 0.5   // countdown + fullscreen check\n    static let urlCheckInterval: TimeInterval = 2 // asking Chrome costs a process\n\n    static let fadeIn: TimeInterval = 0.20\n    static let fadeOut: TimeInterval = 0.25\n    static let fadeOutFullscreen: TimeInterval = 0.08\n\n    // Measured on this Mac, screen 1728x1117: a fullscreen Chrome window sits at\n    // y=33 and runs 1084 tall, so its bottom lands on 1117, the very edge of the\n    // screen; merely zoomed, the same window is 1017 tall and stops at 1050 to\n    // leave the Dock its room. The bottom edge is what tells them apart, never\n    // the height, which is why matching the full screen size found nothing.\n    static let fullscreenTolerance: CGFloat = 2\n}\n\nfinal class TimerView: NSView {\n    var remaining = 0 { didSet { needsDisplay = true } }\n\n    override func draw(_ dirtyRect: NSRect) {\n        NSColor(calibratedWhite: 0.10, alpha: 0.96).setFill()\n        NSBezierPath(roundedRect: bounds.insetBy(dx: 0.5, dy: 0.5), xRadius: 14, yRadius: 14).fill()\n\n        NSString(string: \"YOUTUBE\").draw(\n            at: NSPoint(x: 18, y: bounds.maxY - 22),\n            withAttributes: [\n                .font: NSFont.systemFont(ofSize: 10, weight: .medium),\n                .foregroundColor: NSColor(calibratedWhite: 0.62, alpha: 1),\n                .kern: 1.1\n            ]\n        )\n        NSString(string: String(format: \"%02d:%02d\", max(0, remaining) / 60, max(0, remaining) % 60)).draw(\n            at: NSPoint(x: 18, y: 10),\n            withAttributes: [\n                .font: NSFont.monospacedDigitSystemFont(ofSize: 25, weight: .light),\n                .foregroundColor: NSColor.white\n            ]\n        )\n    }\n}\n\nfinal class TimerController: NSObject, NSApplicationDelegate {\n    private let stateURL: URL\n    private var panel: NSPanel?\n    private var view: TimerView?\n    private var ticker: Timer?\n    private var visible = false\n    private var onYouTube = false\n    private var lastURLCheck = Date.distantPast\n\n    init(stateURL: URL) { self.stateURL = stateURL }\n\n    func applicationDidFinishLaunching(_ notification: Notification) {\n        let panel = NSPanel(\n            contentRect: NSRect(origin: .zero, size: Config.panelSize),\n            styleMask: [.borderless, .nonactivatingPanel],\n            backing: .buffered,\n            defer: false\n        )\n        panel.isOpaque = false\n        panel.backgroundColor = .clear\n        panel.hasShadow = true\n        panel.level = .floating\n        panel.collectionBehavior = [.canJoinAllSpaces, .fullScreenAuxiliary, .stationary]\n        panel.ignoresMouseEvents = true\n        panel.hidesOnDeactivate = false\n        panel.alphaValue = 0\n\n        let view = TimerView(frame: NSRect(origin: .zero, size: Config.panelSize))\n        panel.contentView = view\n        self.panel = panel\n        self.view = view\n        position(panel)\n\n        NSWorkspace.shared.notificationCenter.addObserver(\n            self, selector: #selector(appChanged),\n            name: NSWorkspace.didActivateApplicationNotification, object: nil\n        )\n        ticker = Timer.scheduledTimer(withTimeInterval: Config.tickInterval, repeats: true) { [weak self] _ in\n            self?.tick()\n        }\n        tick()\n    }\n\n    // Chrome came to the front, or left it: re-read the address right away.\n    @objc private func appChanged() {\n        lastURLCheck = .distantPast\n        tick()\n    }\n\n    private func tick() {\n        guard\n            let raw = try? String(contentsOf: stateURL, encoding: .utf8),\n            let until = Int(raw.trimmingCharacters(in: .whitespacesAndNewlines)),\n            case let left = until - Int(Date().timeIntervalSince1970),\n            left > 0\n        else {\n            finish()\n            return\n        }\n\n        view?.remaining = left\n\n        if Date().timeIntervalSince(lastURLCheck) >= Config.urlCheckInterval {\n            lastURLCheck = Date()\n            onYouTube = chromeIsShowingYouTube()\n        }\n\n        // Cheap enough to run every tick, so leaving fullscreen brings the card back fast.\n        let fullscreen = someWindowIsFullscreen()\n\n        if onYouTube && !fullscreen {\n            fadeIn()\n        } else {\n            fadeOut(duration: fullscreen ? Config.fadeOutFullscreen : Config.fadeOut)\n        }\n    }\n\n    private func chromeIsShowingYouTube() -> Bool {\n        guard\n            NSWorkspace.shared.frontmostApplication?.localizedName == \"Google Chrome\",\n            let address = runAppleScript(frontTabURLScript),\n            let host = URL(string: address)?.host?.lowercased()\n        else { return false }\n        return host == \"youtube.com\" || host.hasSuffix(\".youtube.com\") || host == \"youtu.be\"\n    }\n\n    // No AppleScript here: the window list is a direct call, so it can run every tick.\n    // No owner name is checked either, on purpose: in HTML5 fullscreen the video\n    // window can belong to a Chrome helper process rather than to \"Google Chrome\",\n    // and a card left sitting on a fullscreen window is unwanted whoever owns it.\n    private func someWindowIsFullscreen() -> Bool {\n        guard let windows = CGWindowListCopyWindowInfo(\n            [.optionOnScreenOnly, .excludeDesktopElements], kCGNullWindowID\n        ) as? [[String: Any]] else { return false }\n\n        let screens = screenRectsInWindowSpace()\n\n        for window in windows {\n            guard\n                window[kCGWindowLayer as String] as? Int == 0,\n                let raw = window[kCGWindowBounds as String],\n                let bounds = CGRect(dictionaryRepresentation: raw as! CFDictionary)\n            else { continue }\n\n            for screen in screens\n            where abs(bounds.width - screen.width) < Config.fullscreenTolerance\n                && abs(bounds.maxY - screen.maxY) < Config.fullscreenTolerance {\n                return true\n            }\n        }\n        return false\n    }\n\n    // Window bounds count down from the top of the primary screen, while NSScreen\n    // counts up from its bottom, so the screens are fli