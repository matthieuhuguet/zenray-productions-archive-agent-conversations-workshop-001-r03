\n  for (const f of lireConfig().folders) if (!f.paused) surveillance.suivre(f.id, f.src)\n\n  moteur.on('maj', () => diffuser())\n  moteur.on('fini', ({ id, annule, resultat, erreur }: any) => {\n    if (annule) return\n    // Un échec ne réécrit pas l'histoire : le dernier succès reste consultable jusqu'à ce qu'un nouveau passage\n    // complet le remplace. Seule l'erreur courante change.\n    // `lastRunAt` marque la fin du passage DANS LES DEUX CAS. `lastSyncAt` ne retient que les succès, et\n    // s'en servir pour afficher « dernière activité » datait la carte du dernier passage réussi, soit la\n    // veille au matin alors qu'un passage venait de finir le soir même.\n    if (erreur) majDossier(id, { lastError: erreur, lastRunAt: Date.now() })\n    else majDossier(id, { lastSyncAt: Date.now(), lastRunAt: Date.now(), lastError: null, lastResult: resultat || null })\n    // ON PRÉVIENT DANS LES DEUX CAS, PAS SEULEMENT À L'ÉCHEC. Une sauvegarde de trois cent vingt-quatre\n    // gigaoctets se termine forcément pendant qu'on fait autre chose : ne notifier que les échecs revient à\n    // ne jamais dire que ça a marché, donc à laisser douter en permanence. Le bilan chiffré part avec.\n    if (Notification.isSupported()) {\n      const f = lireConfig().folders.find((x) => x.id === id)\n      const nom = f ? path.basename(f.src) : id\n      const b = moteur.bilans.get(id)\n      if (erreur) new Notification({ title: 'ZenRayCloud — échec', body: `${nom} : ${erreur}` }).show()\n      else if (b) new Notification({\n        title: `ZenRayCloud — ${nom} sauvegardé`,\n        body: `${b.fichiers} fichier(s) · ${(b.octets / 1e9).toFixed(2)} Go · ${(b.octetsParSeconde / 1e6).toFixed(1)} Mo/s`\n          + (b.sautes.length ? ` · ⚠ ${b.sautes.length} écarté(s), source à conserver` : ''),\n      }).show()\n    }\n    diffuser(true)\n  })\n\n  // RATTRAPAGE AU DÉMARRAGE. Tout ce qui a changé pendant que l'app était fermée est invisible pour FSEvents,\n  // qui ne raconte que le présent. Une sauvegarde qui ne rattrape pas son absence n'est pas une sauvegarde : on\n  // met donc tous les dossiers en file cinq secondes après l'ouverture. Le coût est faible, le moteur comparant\n  // les empreintes et ne renvoyant que ce qui a réellement bougé.\n  minuterieDemarrage = setTimeout(() => {\n    minuterieDemarrage = null\n    synchroniserTout()\n  }, defautsDossier().rattrapageAuDemarrageSec * 1000)\n\n  // Balayage de rattrapage : la minuterie se réarme avec la valeur COURANTE. Un `setInterval` construit au\n  // démarrage ignorait toute modification faite ensuite dans les préférences jusqu'au prochain lancement.\n  armerRattrapage()\n\n  ouvrirFenetre()\n  diffuser()\n})\n\napp.on('before-quit', () => {\n  if (minuterieRattrapage) clearTimeout(minuterieRattrapage)\n  if (minuterieDemarrage) clearTimeout(minuterieDemarrage)\n  if (minuterieDiffusion) clearTimeout(minuterieDiffusion)\n  minuterieRattrapage = minuterieDemarrage = minuterieDiffusion = null\n  diffusionArmee = false\n  surveillance.toutOublier()\n  moteur.arreterTout()\n})\n\nfunction armerRattrapage(): void {\n  if (minuterieRattrapage) clearTimeout(minuterieRattrapage)\n  const heures = Math.max(1, lireConfig().prefs.fullScanHours)\n  minuterieRattrapage = setTimeout(() => {\n    synchroniserTout()\n    armerRattrapage()\n  }, heures * 3600 * 1000)\n}\n{\n  \"repoRoot\": \"/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress\",\n  \"debounceSec\": 120,\n  \"fullScanHours\": 6,\n  \"launchAtLogin\": false\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0208e-93cb-7c30-bf1c-c670150c6911","create_time":1787253582.242415}}}
