location.get('city', '')), location.get('country', ''), contract, workplace, value.get('releasedDate'), text, f'{name}, recrutement officiel SmartRecruiters', value.get('applyUrl', ''), identifier + ':' + job['id'])\n        except Exception as error:\n            LEDGER.append({'source': base + '/' + job['id'], 'error': str(error), 'checkedAt': TODAY})\n            return None\n    with concurrent.futures.ThreadPoolExecutor(max_workers=CONFIG['workers']) as pool:\n        offers = [x for x in pool.map(detail, unique.values()) if x]\n    LEDGER.append({'source': name, 'listed': len(jobs), 'matched': len(offers), 'checkedAt': TODAY})\n    return offers\n\n\ndef lever(identifier, name):\n    jobs = fetch(f'https://api.lever.co/v0/postings/{identifier}?mode=json', 'lever_' + identifier)\n    offers = []\n    for job in jobs:\n        if not ROLE_PATTERN.search(job['text']):\n            continue\n        text = ' '.join([job.get('descriptionPlain', ''), job.get('additionalPlain', ''), *(x.get('content', '') for x in job.get('lists', []))])\n        categories = job.get('categories', {})\n        salary = job.get('salaryRange')\n        extra = 'Rémunération publiée : ' + json.dumps(salary, ensure_ascii=False) if salary else ''\n        offers.append(make_offer(name, job['text'], job['hostedUrl'], categories.get('location', ''), job.get('country', ''), categories.get('commitment', ''), job.get('workplaceType', ''), job.get('createdAt'), text, f'{name}, recrutement officiel Lever', job['applyUrl'], identifier + ':' + job['id'], extra))\n    LEDGER.append({'source': name, 'listed': len(jobs), 'matched': len(offers), 'checkedAt': TODAY})\n    return offers\n\n\ndef greenhouse(identifier, name):\n    jobs = fetch(f'https://boards-api.greenhouse.io/v1/boards/{identifier}/jobs?content=true', 'greenhouse_' + identifier)['jobs']\n    selected = [job for job in jobs if ROLE_PATTERN.search(job['title'])]\n    groups = {}\n    for job in selected:\n        groups.setdefault(job.get('internal_job_id') or job['id'], []).append(job)\n    offers = []\n    for variants in groups.values():\n        job = next((value for value in variants if 'BLANK' not in value['location']['name']), variants[0])\n        text = clean(job.get('content', ''))\n        extra = 'Même recrutement sous plusieurs localisations : ' + ' / '.join(value['location']['name'].replace('BLANK,BLANK,', '') + ': ' + value['absolute_url'] for value in variants) if len(variants) > 1 else ''\n        offers.append(make_offer(name, job['title'], job['absolute_url'], job['location']['name'].replace('BLANK,BLANK,', ''), '', 'Non précisé dans les données structurées', 'Voir conditions ; remote non présumé', job.get('first_published', ''), text, f'{name}, recrutement officiel Greenhouse', job['absolute_url'], identifier + ':' + str(job['id']), extra))\n    LEDGER.append({'source': name, 'listed': len(jobs), 'matched': len(offers), 'matchedPages': len(selected), 'checkedAt': TODAY})\n    return offers\n\n\ndef keywords():\n    board = 'https://www.keywordsstudios.com/en/careers/browse-careers/'\n    index = fetch(board, 'keywords_board')['html']\n    endpoint = re.search(r\"data_url:\\s*'([^']+filter_stream[^']+)'\", index)[1]\n    total = int(re.search(r'_filter_total\\s*=\\s*(\\d+)', index)[1])\n    offsets = range(0, total, 50)\n    with concurrent.futures.ThreadPoolExecutor(max_workers=CONFIG['workers']) as pool:\n        pages = list(pool.map(lambda offset: fetch(endpoint + f'?offset={offset}&limit=50', f'keywords-stream-{offset}'), offsets))\n    unique = {job['id']: job for page in pages for job in page}\n    selected = [job for job in unique.values() if ROLE_PATTERN.search(job['title'])]\n    def detail(job):\n        try:\n            body = fetch(job['url'], 'keywords-detail-' + job['id'])['html']\n            data = {}\n            for raw in re.findall(r'<script[^>]*type=[\\\"\\x27]application/ld\\+json[\\\"\\x27][^>]*>(.*?)</script>', body, re.S):\n                value = json.