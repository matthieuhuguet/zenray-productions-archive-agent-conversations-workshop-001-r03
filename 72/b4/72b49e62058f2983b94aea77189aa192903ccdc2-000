{"parentUuid":"1b13dcd7-9c51-4ebc-a4fb-80a885888634","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress-freelance/scripts/Freelance/sources/Afjv.mjs","snippet":"1\t// 4 October 2026: AFJV, the French video game job board (vacancies published by the studios themselves).\n2\t// FR : l'AFJV, tableau d'annonces francais du jeu video, deposees par les studios.\n3\timport { ROLE_PATTERN, offerId } from '../lib/Offer.mjs'\n4\timport { mapLimited } from '../lib/Http.mjs'\n5\timport { clean, jobPosting } from '../lib/Text.mjs'\n6\t\n7\texport const KEY = 'afjv'\n8\t\n9\t/** Rows of the listing page: the page carries every active vacancy and hides the filtered ones with CSS. */\n10\texport function parseListing(html, baseUrl) {\n11\t  const rows = [...html.matchAll(/<section[^>]*data-ref=[^>]*>[\\s\\S]*?<\\/section>/g)].map((match) => match[0])\n12\t  return rows.map((row) => {\n13\t    const field = (name) => clean((row.match(new RegExp(`class=\"${name}\"[^>]*>([\\\\s\\\\S]*?)</`)) || [])[1] || '')\n14\t    const href = (row.match(/class=\"emp_pos\" href=\"([^\"]+)/) || [])[1]\n15\t    return { company: field('empt_soc'), companyUrl: (row.match(/class=\"empt_soc\" href=\"([^\"]+)/) || [])[1] || '', title: field('emp_pos'), contract: field('emp_cat'), location: field('emp_vil'), published: field('emp_dat'), trade: field('emp_met'), url: href ? baseUrl + href : '' }\n16\t  }).filter((row) => row.url && row.title)\n17\t}\n18\t\n19\texport const isRelevant = (row) => row.trade === 'Conception' || ROLE_PATTERN.test(row.title)\n20\t\n21\texport function parseDetail(row, body, baseUrl) {\n22\t  if (/offre.*(?:expirée|n.est plus disponible|pourvue)/i.test(clean(body))) return null\n23\t  const posting = jobPosting(body) || {}\n...\n25\t  const stop = body.indexOf('id=\"nws_shr\"', start)\n26\t  const text = stop > start ? body.slice(start, stop) : posting.description || body.slice(start)\n27\t  const address = posting.jobLocation?.address || {}\n28\t  const country = address.addressCountry || (row.location.includes('(BE)') ? 'BE' : /\\(\\d{2}\\)/.test(row.location) && !row.location.includes('(00)') ? 'FR' : 'Non précisé')\n29\t  const slug = row.url.split('/').pop()\n30\t  return {\n31\t    sourceKey: KEY, sourceLabel: 'AFJV', evidence: 'AFJV, annonce déposée par le studio', name: row.company, title: row.title, url: row.url, applyUrl: `${baseUrl}/postuler/${slug}`,\n32\t    sourceId: row.url, location: row.location, country, contract: row.contract, workplace: row.location.includes('Télétravail') ? 'Télétravail' : 'Voir conditions de la fiche',\n33\t    published: posting.datePosted || row.published, text, careersUrl: row.companyUrl ? baseUrl + row.companyUrl : '', employerUrl: posting.hiringOrganization?.sameAs || posting.hiringOrganization?.url || '',\n34\t  }\n35\t}\n36\t\n37\texport async function collect({ http, config }) {\n38\t  const settings = config.sources.afjv\n39\t  const html = await http.text(settings.listUrl)\n40\t  const rows = parseListing(html, settings.baseUrl)\n41\t  if (!rows.length) throw new Error('AFJV listing returned no vacancy row; refusing to treat the page as empty')\n42\t  const selected = rows.filter(isRelevant)\n43\t  const errors = []\n44\t  const results = await mapLimited(selected, config.http.workers, async (row) => parseDetail(row, await http.text(row.url), settings.baseUrl))\n45\t  const listings = []\n46\t  results.forEach((result, index) => {\n47\t    if (!result.ok) errors.push({ source: selected[index].url, error: result.error.message })\n48\t    else if (result.value) listings.push(result.value)\n49\t  })\n50\t  return [{ key: KEY, label: settings.label, listings, seenIds: selected.map((row) => offerId(row.url)), listed: rows.length, matched: listings.length, errors, complete: true }]\n51\t}"},"type":"attachment","uuid":"d6080666-b347-4799-91bd-ac5c82f87119","timestamp":"2026-10-05T08:54:05.584Z","rendered":[{