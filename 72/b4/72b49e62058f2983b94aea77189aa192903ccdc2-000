{"parentUuid":"9baadf78-7fbf-48f1-86b3-ae57384fc6e9","isSidechain":false,"promptId":"b4e6a66e-4ed7-4f19-8374-215f42e35926","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017Mp4aKhPj33RmNWAeTCohd","type":"tool_result","content":"// 4 October 2026: the source registry. A new board is one adapter and one line here, plus its block in FreelanceConfig.json.\n// FR : le registre des sources. Un nouveau tableau, c'est un adaptateur et une ligne ici, plus son bloc de configuration.\nimport * as afjv from './Afjv.mjs'\nimport * as keywords from './Keywords.mjs'\nimport * as gamesindustry from './GamesIndustry.mjs'\nimport { smartrecruiters, lever, greenhouse, ashby, recruitee, breezy, teamtailor } from './Ats.mjs'\n\nexport const REGISTRY = { afjv: afjv.collect, gamesindustry: gamesindustry.collect, keywords: keywords.collect, smartrecruiters, lever, greenhouse, ashby, recruitee, breezy, teamtailor }\n\n/** Runs every enabled source; one source failing yields an incomplete board with its error and never stops the others. */\nexport async function collectAll({ http, config, registry = REGISTRY, only = null, onSource = () => {} }) {\n  const names = Object.keys(registry).filter((name) => config.sources[name]?.enabled && (!only || only.includes(name)))\n  const settled = await Promise.all(names.map(async (name) => {\n    try {\n      const boards = await registry[name]({ http, config })\n      onSource(name, { ok: true, boards: boards.length })\n      return boards\n    } catch (error) {\n      onSource(name, { ok: false, error: error.message })\n      return [{ key: name, label: config.sources[name].label || name, listings: [], seenIds: [], listed: 0, matched: 0, errors: [{ source: name, error: error.message }], complete: false }]\n    }\n  }))\n  return settled.flat()\n}\n// 4 October 2026: GamesIndustry.biz jobs, a public job board read through its own search pages.\n// FR : l'espace emploi de GamesIndustry.biz, lu par ses pages de recherche publiques