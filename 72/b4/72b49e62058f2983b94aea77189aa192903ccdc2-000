ssPill({ t, statusKey, color, children, onClick, active, title }) {\n  const dot = color || (statusKey ? statusColor(statusKey) : null)\n  const Tag = onClick ? 'button' : 'span'\n  return (\n    <Tag type={onClick ? 'button' : undefined} onClick={onClick} title={title} aria-pressed={onClick && active !== undefined ? Boolean(active) : undefined}\n      style={{ ...glassStyle(t, dot), cursor: onClick ? 'pointer' : 'default', opacity: active === false ? 0.55 : 1, fontWeight: active ? 600 : 400, font: 'inherit', fontSize: 12.5, fontFamily: P.sans }}>\n      {dot && <Dot color={dot} />}{children || (statusKey ? statusLabel(statusKey) : null)}\n    </Tag>\n  )\n}\n\nexport function Field({ t, value, onChange, placeholder, width = 180, onKeyDown, label }) {\n  return (\n    <input value={value} onChange={(e) => onChange(e.target.value)} placeholder={placeholder} onKeyDown={onKeyDown} aria-label={label || placeholder}\n      style={{ flex: `1 1 ${width}px`, minWidth: 120, background: t.surface, color: t.textPrimary, border: `1px solid ${t.border}`, borderRadius: P.radius, padding: '9px 12px', fontFamily: P.sans, fontSize: 13.5, outline: 'none' }\n  )\n}\n\nexport function Button({ t, onClick, children, primary, disabled, title, small }) {\n  return (\n    <button type=\"button\" onClick={onClick} disabled={disabled} title={title}\n      style={{ background: primary ? t.textPrimary : 'transparent', color: primary ? t.bg : t.textPrimary, border: primary ? 'none' : `1px solid ${t.border}`, borderRadius: P.radius, padding: small ? '6px 11px' : '9px 15px', curso\n  )\n}\n\nexport function SectionTitle({ t, title, count, aside }) {\n  return (\n    <div style={{ display: 'flex', alignItems: 'baseline', gap: 12, margin: '0 0 14px' }}>\n      <h3 style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 20, letterSpacing: '-0.015em', margin: 0 }}>{title}</h3>\n      {count !== undefined && count !== '' && <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fon