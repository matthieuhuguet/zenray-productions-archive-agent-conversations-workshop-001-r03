{"parentUuid":"31700e61-edc4-4525-aeec-27a44201f8bf","isSidechain":false,"attachment":{"type":"file","filename":"/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress-freelance/scripts/Freelance/Hooks.mjs","content":{"type":"text","file":{"filePath":"/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress-freelance/scripts/Freelance/Hooks.mjs","content":"// 4 October 2026: the optional writer of the studio paragraph, run by Claude Sonnet 5.5 (medium effort) on Matthieu's own subscription.\n// It needs a long-lived token that only he can create (`claude setup-token`); without it the engine keeps its deterministic paragraph.\n// The model only ever writes ONE paragraph about what the role asks and what the CV already shows. It may never claim a taste, a play\n// or a study of the studio, and every answer is checked against the CV before it is used. A failure always falls back, never blocks.\n// FR : l'ecrivain optionnel du paragraphe de studio, Claude Sonnet 5.5 en effort moyen sur l'abonnement de Matthieu. Il faut un jeton\n// que lui seul peut creer ; sans lui le moteur garde son paragraphe deterministe. Le modele n'ecrit qu'UN paragraphe, sur ce que le\n// poste demande et ce que le CV montre deja, et chaque reponse est verifiee contre le CV avant usage.\nimport { execFile } from 'node:child_process'\nimport { promisify } from 'node:util'\nimport { readdir, access } from 'node:fs/promises'\nimport os from 'node:os'\nimport path from 'node:path'\nimport { SKILLS, skillsOf } from './lib/Offer.mjs'\nimport { overlappingSkills, latestPublished } from './CvSource.mjs'\nimport { clean, noLongDash } from './lib/Text.mjs'\n\nconst run = promisify(execFile)\n\n/** The newest Claude Code the desktop app installed, or the one on the PATH. */\nexport async function findClaude({ configured = '', home = os.homedir() } = {}) {\n  if (configured) { try { await access(configured); return configured } catch {} }\n  const root = path.join(home, 'Library/Application Support/Claude/claude-code')\n  try {\n    const versions = (await readdir(root)).sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))\n    for (const version of versions.reverse()) {\n      for (const hash of await readdir(path.join(root, version))) {\n        const candidate = path.join(root, version, hash, 'claude.app/Contents/MacOS/claude')\n        try { await access(candidate); return candidate } catch {}\n      }\n    }\n  } catch {}\n  return null\n}\n\nconst FORBIDDEN = /\\b(joué|jouer|played|play(?:ing)?|fan\\b|admir|j[’']adore|adore|love[sd]?\\b|passionn|rêve|dream|always wanted|toujours voulu|étudié|studied your|suivi votre|follow(?:ed)? your)/i\nconst WORDS = (text) => (clean(text).match(/\\S+/g) || []).length\n\n/** An answer is used only if it stays inside what the CV states and what the offer says. */\nexport function validateHook(text, { cv, offerSkills = [], offerText = '' }) {\n  const value = String(text || '').trim()\n  if (!value) return { ok: false, reason: 'empty' }\n  if (/[\\u2014\\u2013]/.test(value)) return { ok: false, reason: 'long dash' }\n  if (value.includes('\\n\\n')) return { ok: false, reason: 'more than one paragraph' }\n  if (WORDS(value) > 95) return { ok: false, reason: 'too long' }\n  if (WORDS(value) < 12) return { ok: false, reason: 'too short' }\n  if (FORBIDDEN.test(value)) return { ok: false, reason: 'claims a taste or a play' }\n  if (/https?:\\/\\/|@[a-z0-9]/i.test(value)) return { ok: false, reason: 'carries a link or address' }\n  const allowed = new Set([...overlappingSkills(cv, offerSkills), ...skillsOf(offerText).filter((skill) => overlappingSkills(cv, [skill]).length)])\n  const claimed = skillsOf(value)\n  const outside = claimed.filter((skill) => !allowed.has(skill) && overlappingSkills(cv, [skill]).length === 0)\n  if (outside.length) return { ok: false, reason: `names a skill the CV does not state: ${outside.join(', ')}` }\n  return { ok: true }\n}\n\nexport function buildPrompt({ studio, offerText, cv, language }) {\n  const skills = cv.skills.map((skill) => `${skill.name} (${skill.level}/5: ${(skill.tags || []).join(', ')})`).join('; ')\n  const experience = cv.experiences.filter((entry) => !entry.divers).slice(0, 3).map((entry) => `${entry.title}, ${entry.company} (${entry.period}): ${(language === 'fr' ? entry.highlights : entry.highlightsEn || entry.highlights).slice(0, 3).join(' ')}`).join('\\n')\n  const work = latestPublished(cv, 3, language).map((item) => `${item.title}: ${item.description}`).join('\\n')\n  const system = [\n    `You write ONE paragraph of 2 to 4 sentences, in ${language === 'fr' ? 'French' : 'English'}, for the cover letter of Matthieu Huguet, a freelance Technical Artist.`,\n    'It sits right after the sentence about his current work and tells the studio why this role fits what he already does.',\n    'Use only the FACTS and the OFFER below. Say what the role asks for and which of his real skills or published projects answer it.',\n    'Never claim that he played, loved, admired, followed or studied the studio, its games or its people. Never invent an experience, a number, a tool or a diploma.',\n    'Never name a skill that is not in FACTS. No greeting, no sign-off, no link, no dash punctuation, no list. Reply with the paragraph only.',\n  ].join(' ')\n  const user = `FACTS\\nSkills: ${skills}\\nExperience:\\n${experience}\\nPublished work:\\n${work}\\n\\nOFFER\\nStudio: ${studio.name}\\nRole: ${studio.role}\\n${clean(offerText).slice(0, 3500)}`\n  return { system, user }\n}\n\nexport function createHookWriter({ config, exec = run, env = process.env, find = findClaude, tmp = os.tmpdir(), now = () => Date.now() }) {\n  const settings = config.letters.claude\n  const token = () => env[settings.tokenEnv] || ''\n  let login = { at: null, value: false }\n  // The CLI's own sign-in (`claude auth login`, kept and refreshed by Claude Code itself) is the primary way; the one-year token is the alternative.\n  // FR : la connexion propre a la CLI (`claude auth login`, gardee et renouvelee par Claude Code) est la voie principale ; le jeton d'un an est l'alternative.\n  async function signedIn() {\n    if (login.at !== null && now() - login.at < 5 * 60 * 1000) return login.value\n    const binary = await find({ configured: settings.binary || '' })\n    let value = false\n    if (binary) {\n      try {\n        const { stdout } = await exec(binary, ['auth', 'status'], { cwd: tmp, timeout: 20000, env: { ...env, [settings.tokenEnv]: '' } })\n        value = JSON.parse(stdout).loggedIn === true\n      } catch (error) { try { value = JSON.parse(error.stdout).loggedIn === true } catch { value = false } }\n    }\n    login = { at: now(), value }\n    return value\n  }\n  return {\n    available: async () => Boolean(token()) || await signedIn(),\n    via: async () => (token() ? 'token' : (await signedIn()) ? 'login' : 'none'),\n    /** Resolves { text, source: 'claude' } or { skipped: reason }; never throws, so a pass is never blocked by the model. */\n    async write({ studio, offerText, cv, language, offerSkills = [] }) {\n      if (!(await this.available())) return { skipped: 'not-signed-in' }\n      const binary = await find({ configured: settings.binary || '' })\n      if (!binary) return { skipped: 'claude-not-found' }\n      const { system, user } = buildPrompt({ studio, offerText, cv, language })\n      const childEnv = token() ? { ...env, [settings.tokenEnv]: token() } : { ...env, [settings.tokenEnv]: '' }\n      try {\n        const { stdout } = await exec(binary, ['-p', '--no-session-persistence', '--model', settings.model, '--effort', settings.effort, '--tools', '', '--disable-slash-commands', '--output-format', 'json', '--system-prompt', system, user], {\n          cwd: tmp, timeout: settings.timeoutMs, maxBuffer: 8 * 1024 * 1024, env: childEnv,\n        })\n        const answer = JSON.parse(stdout)\n        if (answer.is_error) return { skipped: `model: ${String(answer.result).slice(0, 120)}` }\n        const text = noLongDash(String(answer.result || '').trim().replace(/^[\"«]\\s*|\\s*[\"»]$/g, ''))\n        const verdict = validateHook(text, { cv, offerSkills, offerText })\n        return verdict.ok ? { text, source: 'claude' } : { skipped: `rejected: ${verdict.reason}` }\n      } catch (error) {\n        // A failing `claude -p` still prints a JSON answer on stdout: its message is the real reason.\n        let reason = String(error.message).split('\\n')[0]\n        try { reason = String(JSON.parse(error.stdout).result || reason) } catch {}\n        return { skipped: `error: ${reason.slice(0, 120)}` }\n      }\n    },\n  }\n}\n\nexport { SKILLS }\n","numLines":119,"startLine":1,"totalLines":119}},"displayPath":"../../Create/Build/Productions/GithubProductions/ZenRayProgress-freelance/scripts/Freelance/Hooks.mjs"},"type":"attachment","uuid":"f35f6de2-4d71-4a10-83b2-6e512ab1c6ab","timestamp":"2026-10-05T08:56:43.214Z","rendered":[{"content":"<system-reminder>\nCalled the Read tool with the following input: {\"file_path\":\"/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress-freelance/scripts/Freelance/Hooks.mjs\"}\n</system-reminder>"},{"content":"<system-reminder>\nResult of calling the Read tool:\n1\t// 4 October 2026: the optional writer of the studio paragraph, run by Claude Sonnet 5.5 (medium effort) on Matthieu's own subscription.\n2\t// It needs a long-lived token that only he can create (`claude setup-token`); without it the engine keeps its deterministic paragraph.\n3\t// The model only ever writes ONE paragraph about what the role asks and what the CV already shows. It may never claim a taste, a play\n4\t// or a study of the studio, and every answer is checked against the CV before it is used. A failure always falls back, never blocks.\n5\t// FR : l'ecrivain optionnel du paragraphe de studio, Claude Sonnet 5.5 en effort moyen sur l'abonnement de Matthieu. Il faut un jeton\n6\t// que lui seul peut creer ; sans lui