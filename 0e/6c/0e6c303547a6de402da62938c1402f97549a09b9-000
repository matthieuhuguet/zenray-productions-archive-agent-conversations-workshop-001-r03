{"parentUuid":"ab68e704-7609-45d7-bd36-d42e4e5c0ff2","isSidechain":false,"promptId":"af1c1a1f-81da-45e4-82b4-5656f063e21c","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TRN5XevKp46AGjC7Fcev32","type":"tool_result","content":"1\t#!/bin/zsh\n2\tset -euo pipefail\n3\texport PATH=\"/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin\"\n4\t\n5\t# ===========================================================================\n6\t#  SOCIAL MEDIA GUARD\n7\t#  Closes the creators (YouTube + Instagram/TikTok/X/Facebook) that Matthieu\n8\t#  chose to stop watching. Instead of a hard block, the tab switches to a\n9\t#  countdown page: after WAIT_MINUTES a button opens the content for\n10\t#  REWARD_MINUTES, then the tab is caught again.\n11\t#\n12\t#  How blocking stays fast (no visible frame of the real page):\n13\t#    - FAST pass  (~0.1s): checks only the ACTIVE tab and redirects it inside\n14\t#      AppleScript. Runs only while a browser is frontmost. Kills the frame.\n15\t#    - DEEP pass  (~1s):   full sweep of every tab, resolves YouTube videos\n16\t#      through yt-dlp, handles the reward, catches background tabs.\n17\t#\n18\t#  File map:\n19\t#     1. Config              - paths, timings, browsers\n20\t#     2. Blocked creators    - BLOCKED_PATTERNS (single editable source)\n21\t#     3. Small helpers       - dates, text, url encoding\n22\t#     4. Files and migration - folders, password, old names\n23\t#     5. On / Off            - disabled, suspended, active window\n24\t#     6. Match engine        - does this text point to a blocked creator?\n25\t#     7. Reward (grace)      - temporary earned access, per creator\n26\t#     8. Block page          - the HTML shown in the tab\n27\t#     9. Browser control     - list tabs, redirect one tab\n28\t#    10. Fast pass           - instant redirect of the active tab\n29\t#    11. Watch loop          - the loop the background service runs\n30\t#    12. Install             - user service (+ optional root layer)\n31\t#    13. Commands            - status, suspend, disable/enable, uninstall\n32\t#    14. Entry point         - command line dispatch\n33\t#\n34\t#  Usage: SocialMediaGuard.sh <command>\n35\t#    install-user | status | enable | disable | suspend [min] |\n36\t#    enforce | watch-tabs | close-tabs | uninstall-user |\n37\t#    install-root | uninstall-root | cleanup-root\n38\t# ===========================================================================\n39\t\n40\t\n41\t# --- 1. Config -------------------------------------------------------------\n42\t\n43\tOWNER=\"zenray\"\n44\tMEMORY_ROOT=\"${MEMORY_ROOT:-/Users/zenray/Create/Build/Memory}\"\n45\tFOCUS_DIR=\"$MEMORY_ROOT/Focus\"\n46\t\n47\tSECRET_FILE=\"$FOCUS_DIR/.SocialMediaGuardPassword\"     # local password (git-ignored)\n48\tSTATE_DIR=\"$FOCUS_DIR/.SocialMediaGuardState\"          # internal state (git-ignored)\n49\tDISABLED_FILE=\"$STATE_DIR/disabled\"                    # present = guard turned off\n50\tSUSPEND_FILE=\"$STATE_DIR/suspend_until\"                # epoch when suspension ends\n51\tBLOCK_PAGE_FILE=\"$FOCUS_DIR/SocialMediaBlocked.html\"   # the page shown in the tab\n52\tBLOCK_PAGE_URL=\"file://$BLOCK_PAGE_FILE\"\n53\tILLUSTRATION_URL=\"file://$MEMORY_ROOT/ArtDirection/output_v3.png\"\n54\t\n55\t# Timings (overridable from the plist via environment variables).\n56\tWAIT_MINUTES=\"${SMG_WAIT_MINUTES:-30}\"      # wait before the content can open\n57\tREWARD_MINUTES=\"${SMG_REWARD_MINUTES:-30}\"  # how long access lasts once earned\n58\tSTART_HOUR=\"${SMG_START_HOUR:-0}\"           # active window: 0..24 = always on\n59\tEND_HOUR=\"${SMG_END_HOUR:-24}\"\n60\tFAST_SLEEP=\"${SMG_FAST_SLEEP:-0.1}\"         # active-tab poll interval (seconds)\n61\tDEEP_EVERY=\"${SMG_DEEP_EVERY:-10}\"          # deep sweep once every N fast passes\n62\t\n63\t# Background service (LaunchAgent).\n64\tUSER_LABEL=\"com.zenray.social-media-guard.tabs\"\n65\tROOT_LABEL=\"com.zenray.social-media-guard\"\n66\tUSER_PLIST=\"$HOME/Library/LaunchAgents/$USER_LABEL.plist\"\n67\tROOT_PLIST=\"/Library/LaunchDaemons/$ROOT_LABEL.plist\"\n68\tSCRIPT_PATH=\"$MEMORY_ROOT/Tools/FocusGuard/SocialMediaGuard.sh\"\n69\tUSER_LOG=\"$HOME/Library/Logs/SocialMediaGuard.tabs.log\"\n70\tUSER_ERR_LOG=\"$HOME/Library/Logs/SocialMediaGuard.tabs.err.log\"\n71\t\n72\t# Optional root layer (hosts + Chrome policy). Inactive without sudo.\n73\tHOSTS_FILE=\"/etc/hosts\"\n74\tHOSTS_MARK_START=\"# ZENRAY_SOCIAL_MEDIA_GUARD_START\"\n75\tHOSTS_MARK_END=\"# ZENRAY_SOCIAL_MEDIA_GUARD_END\"\n76\tCHROME_POLICY_FILE=\"/Library/Managed Preferences/com.google.Chrome.plist\"\n77\tCHROME_POLICY_BACKUP=\"$STATE_DIR/com.google.Chrome.plist.before-guard\"\n78\tCHROME_POLICY_MARKER=\"$STATE_DIR/chrome_policy_backup_state\"\n79\tHOST_DOMAINS=()\n80\tCHROME_BLOCKLIST=()\n81\t\n82\t# Browsers we drive. Every Chromium shares Google Chrome's tab vocabulary\n83\t# (\"using terms from\"); Safari has its own.\n84\tCHROMIUM_BROWSERS=(\n85\t  \"Google Chrome\" \"Google Chrome Beta\" \"Google Chrome Canary\" \"Chromium\"\n86\t  \"Brave Browser\" \"Brave Browser Beta\" \"Microsoft Edge\" \"Microsoft Edge Beta\"\n87\t  \"Vivaldi\" \"Opera\" \"Opera GX\"\n88\t)\n89\t\n90\t\n91\t# --- 2. Blocked creators (single source of truth) --------------------------\n92\t#\n93\t# Each entry is matched as a substring, case-insensitive and separator-\n94\t# insensitive (see Normalize), against two things:\n95\t#   1) the tab URL (any network) - blocks YouTube, Instagram, TikTok,\n96\t#      Facebook and X as soon as the entry is the account handle;\n97\t#   2) the identity yt-dlp returns for a /watch page (channel name, uploader)\n98\t#      - catches every video and side channel of a creator, even without\n99\t#      knowing their exact handle.\n100\t# Safety: an entry that matches nothing blocks nothing (harmless miss). So we\n101\t# can be broad on NAMES and stay precise (joined handle or URL) to never block\n102\t# a third party by accident.\n103\t#\n104\t# A few entries keep accents on purpose: they are real creator names, and a\n105\t# channel identity like \"HugoDecrypte\" written with the accent is only caught\n106\t# by the accented form.\n107\t\n108\tBLOCKED_PATTERNS=(\n109\t  # --- Ici Japon ---\n110\t  \"youtube.com/@icijaponcorp\"  \"youtube.com/channel/uct11zynefnunokgcrso9uyg\"  \"ici japon\"\n111\t  # --- Silicon Carne / Carlos Diaz ---\n112\t  \"youtube.com/@siliconcarnepod\"  \"siliconcarne\"  \"silicon carne\"  \"carlosdiaz\"  \"carlos diaz\"\n113\t  # --- Oussama Ammar ---\n114\t  \"youtube.com/@oussamaammaroff\"  \"youtube.com/channel/ucxh-b8b2sx4kgshsvj3ngza\"\n115\t  \"oussamaammaroff\"  \"oussamaammar\"  \"oussama ammar\"\n116\t  # --- Yomi Denzel ---\n117\t  \"youtube.com/@yomidenzel\"  \"youtube.com/yomidenzel\"  \"youtube.com/channel/uchge6r4qaugajalyijoccgw\"\n118\t  \"yomidenzel\"  \"yomi.denzel\"  \"yomi denzel\"\n119\t  # --- Antoine Blanco (+ business channel) ---\n120\t  \"youtube.com/@antoineblanco\"  \"youtube.com/@antoineblanco99\"  \"youtube.com/@antoineblancobusiness\"\n121\t  \"youtube.com/channel/uc0kcckhmqfiguifkqco-iya\"  \"antoineblanco\"  \"antoine blanco\"\n122\t  # --- Sixtine Moulle-Berteaux ---\n123\t  \"youtube.com/@sixtinemoulleberteaux\"  \"sixtinemoulleberteaux\"  \"sixtine.moulleberteaux\"\n124\t  \"sixtine moulle\"  \"sixtine moulle-berteaux\"\n125\t  # --- Wallerand Moulle-Berteaux ---\n126\t  \"wallerandmoulleberteaux\"  \"wallerand.moulleberteaux\"  \"wallerand moulle\"  \"wallerand moulle-berteaux\"\n127\t  # --- Eric Larcheveque ---\n128\t  \"ericlarcheveque\"  \"eric larcheveque\"  \"eric l'archeveque\"  \"eric larchevêque\"\n129\t  # --- Guillaume Moubeche ---\n130\t  \"guillaumemoubeche\"  \"guillaume moubeche\"  \"guillaume moubèche\"\n131\t  # --- Alex Hitchens (+ side channels via identity) ---\n132\t  \"alexhitchens\"  \"alex hitchens\"\n133\t  # --- Julien Chieze (gaming news) ---\n134\t  \"julienchieze\"  \"julien chieze\"\n135\t  # --- HugoDecrypte (news, all channels) ---\n136\t  \"youtube.com/@hugodecrypte\"  \"youtube.com/@hugodecrypteactus\"  \"youtube.com/@hugodecryptegrandsformats\"\n137\t  \"hugodecrypte\"  \"hugo decrypte\"  \"hugo décrypte\"\n138\t  # --- Le Crayon (news/media) ---\n139\t  \"youtube.com/@lecrayon\"  \"le crayon\"\n140\t  # --- La Chapelle Radio / Hugo Bentz ---\n141\t  \"youtube.com/@la-chapelle-radio-hugo-bentz\"  \"la chapelle radio\"  \"hugo bentz\"\n142\t  # --- Matthieu Stefani / Generation Do It Yourself ---\n143\t  \"matthieu stefani\"  \"generation do it yourself\"  \"génération do it yourself\"  \"gdiy\"\n144\t  # --- Pauline Laigneau ---\n145\t  \"youtube.com/@paulinelaigneau\"  \"pauline laigneau\"\n146\t  # --- Les Decouvreurs ---\n147\t  \"youtube.com/@les_decouvreurs\"  \"les decouvreurs\"  \"les découvreurs\"\n148\t  # --- Theophile Eliet (hyphen handle, handled by Normalize) ---\n149\t  \"youtube.com/@theophile-eliet\"  \"theophile eliet\"  \"théophile eliet\"\n150\t  # --- Le Precepteur ---\n151\t  \"le precepteur\"  \"le précepteur\"\n152\t  # --- My Better Self ---\n153\t  \"mybetterself\"  \"my better self\"\n154\t  # --- LouisSan (+ side channels: LouisSanCorp...) ---\n155\t  \"louissan\"  \"louissancorp\"\n156\t  # --- Business / make-money / mindset / manosphere sphere (NAMES only) ---\n157\t  \"iman gadzhi\"  \"imangadzhi\"  \"andrew tate\"  \"tristan tate\"  \"cobratate\"\n158\t  \"enzo honore\"  \"enzo honoré\"  \"franck nicolas\"  \"idriss aberkane\"  \"anthony bourbon\"\n159\t  \"hasheur\"  \"owen simonin\"  \"lorenzo ferrante\"  \"mick levy\"  \"younes belghazi\"\n160\t  \"yann darwin\"  \"yan darwin\"  \"raoul pop\"  \"david laroche\"  \"fabien snauwaert\"\n161\t  \"romain pichon\"  \"tugan bara\"  \"tugan.baranovsky\"  \"morgan prevel\"  \"morgan prével\"\n162\t  \"valentin decker\"  \"jean riviere\"  \"jean rivière\"  \"jeremy kohlmann\"  \"aurelien amacker\"  \"aurélien amacker\"\n163\t  \"squeezie\"  \"naval ravikant\"  \"navalravikant\"  \"laurent alexandre\"  \"alexandre cicoupoulos\"\n164\t)\n165\t\n166\t\n167\t# --- 3. Small helpers ------------------------------------------------------\n168\t\n169\tSay()      { printf '%s\\n' \"$*\"; }\n170\tNowEpoch() { date '+%s'; }\n171\t\n172\t# Drop case AND separators: \"Theophile-Eliet\", \"theophile.eliet\" and\n173\t# \"theophile eliet\" all become \"theophileeliet\". One place that removes the\n174\t# whole family of separator bugs (hyphen vs dot vs space).\n175\tNormalize() {\n176\t  local s=\"${1:l}\"\n177\t  printf '%s' \"${s//[-._ ]/}\"\n178\t}\n179\t\n180\tUrlEncode() { python3 -c 'import sys,urllib.parse;print(urllib.parse.quote(sys.argv[1], safe=\"\"))' \"$1\"; }\n181\tUrlDecode() { python3 -c 'import sys,urllib.parse;print(urllib.parse.unquote(sys.argv[1]))'         \"$1\"; }\n182\t\n183\t# Value (decoded) of query parameter $2 in the URL $1.\n184\tExtractParam() {\n185\t  local u=\"$1\" name=\"$2\" q pair\n186\t  q=\"${u#*\\?}\"\n187\t  [[ \"$q\" == \"$u\" ]] && return 0          # no '?' means no query string\n188\t  for pair in ${(s:&:)q}; do\n189\t    [[ \"$pair\" == \"$name=\"* ]] && { UrlDecode \"${pair#$name=}\"; return 0; }\n190\t  done\n191\t}\n192\t\n193\t# Normalized form of every entry, computed ONCE at load (not inside the loop\n194\t# that runs many times per second), to avoid needless work.\n195\tNORMALIZED_PATTERNS=()\n196\tfor _p in \"${BLOCKED_PATTERNS[@]}\"; do NORMALIZED_PATTERNS+=(\"$(Normalize \"$_p\")\"); done\n197\tunset _p\n198\t\n199\t# The subset the fast pass uses: entries that can appear in a URL (no spaces),\n200\t# lowercased. Spaced names never appear in a URL, so they stay for the deep\n201\t# pass only (matched against the yt-dlp identity).\n202\tFAST_PATTERNS=()\n203\tfor _p in \"${BLOCKED_PATTERNS[@]}\"; do\n204\t  [[ \"$_p\" == *\" \"* ]] && continue\n205\t  FAST_PATTERNS+=(\"${_p:l}\")\n206\tdone\n207\tunset _p\n208\t\n209\t\n210\t# --- 4. Files and migration ------------------------------------------------\n211\t\n212\t# Rename the files from older versions (YouTube*, then SocialMediaFocus*) to\n213\t# the current names, so we keep the local password and any running reward.\n214\t# Idempotent: after migration the old ones are gone. Never overwrites a file\n215\t# that already exists under the new name.\n216\tMigrateLegacy() {\n217\t  local old\n218\t  for old in \"$FOCUS_DIR/.SocialMediaFocusGuardPassword\" \"$FOCUS_DIR/.YouTubeFocusGuardPassword\"; do\n219\t    [[ -f \"$old\" && ! -f \"$SECRET_FILE\" ]] && mv \"$old\" \"$SECRET_FILE\" 2>/dev/null\n220\t  done\n221\t  for old in \"$FOCUS_DIR/.SocialMediaFocusGuardState\" \"$FOCUS_DIR/.YouTubeFocusGuardState\"; do\n222\t    [[ -d \"$old\" && ! -d \"$STATE_DIR\" ]] && mv \"$old\" \"$STATE_DIR\" 2>/dev/null\n223\t  done\n224\t  rm -f \"$FOCUS_DIR/YouTubeBlocked.html\" 2>/dev/null\n225\t  return 0\n226\t}\n227\t\n228\tEnsureDirs() {\n229\t  MigrateLegacy\n230\t  mkdir -p \"$FOCUS_DIR\" \"$STATE_DIR\"\n231\t  chmod 700 \"$STATE_DIR\" 2>/dev/null || true\n232\t}\n233\t\n234\t# Create a local password on first run (Matthieu does not memorize it; the\n235\t# assistant can read it on disk if a real unlock is ever needed).\n236\tEnsureSecret() {\n237\t  EnsureDirs\n238\t  EnsureBlockPage\n239\t  if [[ ! -f \"$SECRET_FILE\" ]]; then\n240\t    umask 077\n241\t    /opt/homebrew/bin/openssl rand -base64 48 | tr -d '\\n' > \"$SECRET_FILE\"\n242\t    printf '\\n' >> \"$SECRET_FILE\"\n243\t  fi\n244\t  chmod 600 \"$SECRET_FILE\" 2>/dev/null || true\n245\t  if [[ \"$EUID\" -eq 0 ]]; then\n246\t    chown \"${OWNER}:staff\" \"$SECRET_FILE\" \"$FOCUS_DIR\" \"$STATE_DIR\" 2>/dev/null || true\n247\t  fi\n248\t}\n249\t\n250\t# Barrier against the reflex for the sensitive commands (suspend/disable/uninstall).\n251\tRequireGuardPassword() {\n252\t  EnsureSecret\n253\t  local expected input\n254\t  expected=\"$(cat \"$SECRET_FILE\")\"\n255\t  if [[ -n \"${SMG_PASSWORD:-}\" ]]; then\n256\t    input=\"$SMG_PASSWORD\"\n257\t  else\n258\t    printf 'Focus password: ' >&2\n259\t    stty -echo; IFS= read -r input; stty echo\n260\t    printf '\\n' >&2\n261\t  fi\n262\t  [[ \"$input\" == \"$expected\" ]] || { Say \"Wrong focus password.\"; exit 2; }\n263\t}\n264\t\n265\t\n266\t# --- 5. On / Off -----------------------------------------------------------\n267\t\n268\tIsDisabled() { [[ -f \"$DISABLED_FILE\" ]]; }\n269\t\n270\tIsSuspended() {\n271\t  [[ -f \"$SUSPEND_FILE\" ]] || return 1\n272\t  local until; until=\"$(cat \"$SUSPEND_FILE\" 2>/dev/null || printf '0')\"\n273\t  [[ \"$until\" =~ '^[0-9]+$' ]] || return 1\n274\t  [[ \"$(NowEpoch)\" -lt \"$until\" ]]\n275\t}\n276\t\n277\t# Active time window (default 0..24, so always).\n278\tIsProtectedNow() {\n279\t  local hour; hour=\"$(date '+%H')\"; hour=\"${hour#0}\"; [[ -z \"$hour\" ]] && hour=0\n280\t  [[ \"$hour\" -ge \"$START_HOUR\" && \"$hour\" -lt \"$END_HOUR\" ]]\n281\t}\n282\t\n283\t# Should we block right now? No if turned off, suspended, or out of window.\n284\tShouldBlock() {\n285\t  IsDisabled  && return 1\n286\t  IsSuspended && return 1\n287\t  IsProtectedNow\n288\t}\n289\t\n290\t# Is a browser the frontmost app? The fast pass only runs then: while Matthieu\n291\t# works in Houdini or Unreal there is no visible tab to flash, so we stay idle.\n292\tBrowserIsFrontmost() {\n293\t  local front\n294\t  front=\"$(lsappinfo info -only name \"$(lsappinfo front 2>/dev/null)\" 2>/dev/null)\"\n295\t  case \"$front\" in\n296\t    *\"Google Chrome\"*|*Safari*|*\"Brave Browser\"*|*\"Microsoft Edge\"*|*Vivaldi*|*Opera*|*Chromium*) return 0 ;;\n297\t    *) return 1 ;;\n298\t  esac\n299\t}\n300\t\n301\t\n302\t# --- 6. Match engine: does this text point to a blocked creator? -----------\n303\t\n304\t# One elementary test, raw form OR normalized form. GrantGrace and\n305\t# TextMatchesBlocked both use it: they MUST agree on \"which entries this text\n306\t# triggers\", otherwise a granted reward would miss an entry that only matches\n307\t# after normalization (e.g. \"silicon carne\" with a space) and re-block right\n308\t# away despite the earned reward.\n309\tPatternMatches() {\n310\t  local lpattern=\"$1\" npattern=\"$2\" text=\"$3\" ntext=\"$4\"\n311\t  [[ \"$text\" == *\"$lpattern\"* ]] && return 0\n312\t  [[ -n \"$npattern\" && \"$ntext\" == *\"$npattern\"* ]] && return 0\n313\t  return 1\n314\t}\n315\t\n316\t# True if the text (a URL or a yt-dlp identity) names a blocked creator AND is\n317\t# not currently covered by a reward.\n318\tTextMatchesBlocked() {\n319\t  local raw=\"$1\" text=\"${1:l}\" ntext anyGrace=0 i n\n320\t  local -a graceFiles\n321\t  ntext=\"$(Normalize \"$raw\")\"\n322\t  graceFiles=(\"$STATE_DIR\"/grace_*.until(N))\n323\t  (( ${#graceFiles[@]} > 0 )) && anyGrace=1\n324\t  n=${#BLOCKED_PATTERNS[@]}\n325\t  for (( i = 1; i <= n; i++ )); do\n326\t    if PatternMatches \"${BLOCKED_PATTERNS[i]:l}\" \"${NORMALIZED_PATTERNS[i]}\" \"$text\" \"$ntext\"; then\n327\t      if (( anyGrace )) && PatternIsGraced \"${BLOCKED_PATTERNS[i]}\"; then continue; fi\n328\t      return 0\n329\t    fi\n330\t  done\n331\t  return 1\n332\t}\n333\t\n334\t# YouTube pages whose real channel yt-dlp can resolve (a video URL does not\n335\t# always carry the handle).\n336\tIsResolvableYouTubeUrl() {\n337\t  local url=\"${1:l}\"\n338\t  case \"$url\" in\n339\t    *youtube.com/watch\\?*|*youtube.com/shorts/*|*youtube.com/live/*|*youtube.com/post/*|*youtu.be/*) return 0 ;;\n340\t    *) return 1 ;;\n341\t  esac\n342\t}\n343\t\n344\t# The real identity behind a YouTube URL: first a direct test on the URL\n345\t# (handle visible), otherwise ask yt-dlp (channel name, uploader...), cached\n346\t# so we do not repeat the network call on every pass.\n347\tYouTubeIdentityForUrl() {\n348\t  local url=\"$1\"\n349\t  TextMatchesBlocked \"$url\" && { printf '%s\\n' \"$url\"; return 0; }\n350\t  IsResolvableYouTubeUrl \"$url\" || return 1\n351\t\n352\t  local ytdlp cacheDir cache json identity\n353\t  ytdlp=\"$(command -v yt-dlp 2>/dev/null || true)\"\n354\t  [[ -n \"$ytdlp\" ]] || return 1\n355\t\n356\t  cacheDir=\"$STATE_DIR/youtube-identity-cache\"; mkdir -p \"$cacheDir\"\n357\t  cache=\"$cacheDir/$(printf '%s' \"$url\" | shasum -a 256 | awk '{print $1}').txt\"\n358\t  [[ -s \"$cache\" ]] && { cat \"$cache\"; return 0; }\n359\t\n360\t  json=\"$(\"$ytdlp\" --dump-single-json --no-playlist --skip-download \\\n361\t    --socket-timeout 4 --extractor-retries 1 --retries 1 \"$url\" 2>/dev/null || true)\"\n362\t  identity=\"$(printf '%s' \"$json\" | jq -r '\n363\t    [ .channel, .uploader, .channel_id, .uploader_id, .channel_url,\n364\t      .uploader_url, .creator, .webpage_url, .original_url ]\n365\t    | map(select(type == \"string\" and length > 0)) | join(\" \")' 2>/dev/null || true)\"\n366\t\n367\t  [[ -n \"$identity\" ]] && printf '%s\\n' \"$identity\" > \"$cache\"\n368\t  printf '%s\\n' \"$identity\"\n369\t}\n370\t\n371\t\n372\t# --- 7. Reward (grace): temporary earned access, per creator ---------------\n373\t\n374\t# Path of a pattern's reward marker (a safe file name, no shasum fork).\n375\tGraceFileFor() {\n376\t  printf '%s/grace_%s.until' \"$STATE_DIR\" \"$(printf '%s' \"${1:l}\" | tr -c 'a-z0-9' '_')\"\n377\t}\n378\t\n379\t# True if this pattern has a reward that is still valid.\n380\tPatternIsGraced() {\n381\t  local f until; f=\"$(GraceFileFor \"$1\")\"\n382\t  [[ -f \"$f\" ]] || return 1\n383\t  until=\"$(cat \"$f\" 2>/dev/null || printf '0')\"\n384\t  [[ \"$until\" =~ ^[0-9]+$ ]] || return 1\n385\t  [[ \"$(NowEpoch)\" -lt \"$until\" ]]\n386\t}\n387\t\n388\t# Grant REWARD_MINUTES to every entry the target URL triggers, and only those:\n389\t# earning access to one creator never unblocks the others.\n390\tGrantGrace() {\n391\t  local target=\"$1\" ltarget nltarget until i n\n392\t  ltarget=\"${target:l}\"; nltarget=\"$(Normalize \"$target\")\"\n393\t  until=\"$(( $(NowEpoch) + REWARD_MINUTES * 60 ))\"\n394\t  EnsureDirs\n395\t  n=${#BLOCKED_PATTERNS[@]}\n396\t  for (( i = 1; i <= n; i++ )); do\n397\t    if PatternMatches \"${BLOCKED_PATTERNS[i]:l}\" \"${NORMALIZED_PATTERNS[i]}\" \"$ltarget\" \"$nltarget\"; then\n398\t      printf '%s\\n' \"$until\" > \"$(GraceFileFor \"${BLOCKED_PATTERNS[i]}\")\"\n399\t    fi\n400\t  done\n401\t}\n402\t\n403\t# The block-page URL for a target, timestamped (lets the page recompute the\n404\t# time left even after the tab is reloaded).\n405\tGateUrlFor() {\n406\t  printf '%s?u=%s&t=%s' \"$BLOCK_PAGE_URL\" \"$(UrlEncode \"$1\")\" \"$(NowEpoch)\"\n407\t}\n408\t\n409\t\n410\t# --- 8. Block page (the HTML shown in the tab) -----------------------------\n411\t# English, plain tone. Numbers in Anthropic Serif, text in Anthropic Sans.\n412\t\n413\tEnsureBlockPage() {\n414\t  EnsureDirs\n415\t  local F=\"/Users/zenray/Library/Fonts\"\n416\t  cat > \"$BLOCK_PAGE_FILE\" <<HTML\n417\t<!doctype html>\n418\t<html lang=\"en\">\n419\t<head>\n420\t<meta charset=\"utf-8\">\n421\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n422\t<title>Blocked</title>\n423\t<style>\n424\t  @font-face { font-family:\"AnthropicSans\"; src:url(\"file://$F/AnthropicSans-Light.ttf\") format(\"truetype\"); font-weight:300 }\n425\t  @font-face { font-family:\"AnthropicSans\"; src:url(\"file://$F/AnthropicSans-Medium.ttf\") format(\"truetype\"); font-weight:500 }\n426\t  @font-face { font-family:\"AnthropicSerif\"; src:url(\"file://$F/AnthropicSerif-Light.ttf\") format(\"truetype\"); font-weight:300 }\n427\t  @font-face { font-family:\"AnthropicSerif\"; src:url(\"file://$F/AnthropicSerif-Regular.ttf\") format(\"truetype\"); font-weight:400 }\n428\t  :root { color-scheme:dark }\n429\t  * { box-sizing:border-box }\n430\t  body {\n431\t    margin:0; min-height:100vh; display:grid; place-items:center;\n432\t    background:#242424; color:#f2f2f2;\n433\t    font-family:\"AnthropicSans\", system-ui, sans-serif; font-weight:300;\n434\t  }\n435\t  main { width:min(1500px, calc(100vw - 48px)); text-align:center }\n436\t  .art { display:block; width:min(640px, calc(100vw - 120px)); margin:0 auto 34px;\n437\t         border-radius:8px; box-shadow:0 16px 48px rgba(0,0,0,.28) }\n438\t  .eyebrow { font-weight:500; font-size:13px; letter-spacing:.14em; text-transform:uppercase;\n439\t             color:#cc7c5e; margin:0 0 18px }\n440\t  /* Numbers: always Serif. */\n441\t  .timer { font-family:\"AnthropicSerif\", serif; font-weight:300;\n442\t           font-size:clamp(64px, 12vw, 168px); line-height:1; color:#f4f4f4;\n443\t           font-variant-numeric:tabular-nums; margin:0 }\n444\t  .num { font-family:\"AnthropicSerif\", serif }\n445\t  .head { font-weight:300; font-size:clamp(22px, 2.4vw, 34px); color:#efefef; margin:6px 0 0 }\n446\t  .cap { font-size:15px; color:#8c857d; margin:14px 0 0 }\n447\t  .btn { display:inline-block; margin-top:22px; padding:14px 32px; border-radius:999px;\n448\t         background:#f2f2f2; color:#242424; text-decoration:none; font-weight:500 }\n449\t</style>\n450\t</head>\n451\t<body>\n452\t<main>\n453\t  <img class=\"art\" src=\"$ILLUSTRATION_URL\" alt=\"\">\n454\t  <section id=\"waitBox\">\n455\t    <p class=\"eyebrow\">Creator mode</p>\n456\t    <p class=\"timer\" id=\"countdown\">--:--</p>\n457\t    <p class=\"cap\">until this opens</p>\n458\t  </section>\n459\t  <section id=\"rewardBox\" style=\"display:none\">\n460\t    <p class=\"eyebrow\">Creator mode</p>\n461\t    <p class=\"head\">Time's up.</p>\n462\t    <a id=\"rewardLink\" class=\"btn\" href=\"#\">Open now</a>\n463\t    <p class=\"cap\">Open for <span class=\"num\">$REWARD_MINUTES</span> min, then it closes.</p>\n464\t  </section>\n465\t  <section id=\"closedBox\" style=\"display:none\">\n466\t    <p class=\"eyebrow\">Creator mode</p>\n467\t    <p class=\"head\">Closed.</p>\n468\t  </section>\n469\t</main>\n470\t<script>\n471\t(function () {\n472\t  var p = new URLSearchParams(location.search);\n473\t  var target = p.get('u') || '';\n474\t  var startedSec = parseInt(p.get('t') || '0', 10) || 0;\n475\t  var WAIT_SECONDS = $((WAIT_MINUTES * 60));\n476\t  var waitBox = document.getElementById('waitBox');\n477\t  var rewardBox = document.getElementById('rewardBox');\n478\t  var closedBox = document.getElementById('closedBox');\n479\t  if (!target || !startedSec) { waitBox.style.display = 'none'; closedBox.style.display = 'block'; return; }\n480\t  var el = document.getElementById('countdown');\n481\t  function fmt(s) { var m = Math.floor(s/60), r = s%60; return (m<10?'0':'')+m+':'+(r<10?'0':'')+r; }\n482\t  function tick() {\n483\t    var remain = WAIT_SECONDS - (Math.floor(Date.now()/1000) - startedSec);\n484\t    if (remain <= 0) {\n485\t      waitBox.style.display = 'none';\n486\t      document.getElementById('rewardLink').href =\n487\t        location.pathname + '?u=' + encodeURIComponent(target) + '&t=' + startedSec + '&unlock=1';\n488\t      rewardBox.style.display = 'block';\n489\t      return;\n490\t    }\n491\t    el.textContent = fmt(remain);\n492\t    setTimeout(tick, 1000);\n493\t  }\n494\t  tick();\n495\t})();\n496\t</script>\n497\t</body>\n498\t</html>\n499\tHTML\n500\t  chmod 644 \"$BLOCK_PAGE_FILE\" 2>/dev/null || true\n501\t}\n502\t\n503\t\n504\t# --- 9. Browser control ----------------------------------------------------\n505\t\n506\t# List open tabs as \"browser<TAB>window<TAB>tab<TAB>url\" per line. One osascript\n507\t# per RUNNING browser (pgrep), so we never name an app that is not installed\n508\t# (which would pop a blocking \"Where is X?\" dialog), and a browser that fails\n509\t# does not stop us from reading the others.\n510\tListBrowserTabs() {\n511\t  local b\n512\t  for b in \"${CHROMIUM_BROWSERS[@]}\"; do\n513\t    pgrep -x \"$b\" >/dev/null 2>&1 || continue\n514\t    osascript <<APPLESCRIPT 2>/dev/null || true\n515\tset Output to \"\"\n516\tset T to ASCII character 9\n517\tusing terms from application \"Google Chrome\"\n518\t  tell application \"$b\"\n519\t    repeat with W from 1 to (count of windows)\n520\t      repeat with I from 1 to (count of tabs of window W)\n521\t        try\n522\t          set Output to Output & \"$b\" & T & W & T & I & T & (URL of tab I of window W as text) & linefeed\n523\t        end try\n524\t      end repeat\n525\t    end repeat\n526\t  end tell\n527\tend using terms from\n528\treturn Output\n529\tAPPLESCRIPT\n530\t  done\n531\t  if pgrep -x \"Safari\" >/dev/null 2>&1; then\n532\t    osascript <<'APPLESCRIPT' 2>/dev/null || true\n533\tset Output to \"\"\n534\tset T to ASCII character 9\n535\ttell application \"Safari\"\n536\t  repeat with W from 1 to (count of windows)\n537\t    repeat with I from 1 to (count of tabs of window W)\n538\t      try\n539\t        set Output to Output & \"Safari\" & T & W & T & I & T & (URL of tab I of window W as text) & linefeed\n540\t      end try\n541\t    end repeat\n542\t  end repeat\n543\tend tell\n544\treturn Output\n545\tAPPLESCRIPT\n546\t  fi\n547\t}\n548\t\n549\t# Change one specific tab's URL (to the block page, or to the real content when\n550\t# a reward is granted). Chromium through \"using terms from\", Safari natively.\n551\tRedirectBrowserTab() {\n552\t  local browser=\"$1\" windowIndex=\"$2\" tabIndex=\"$3\" destUrl=\"$4\"\n553\t  osascript - \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$destUrl\" <<'APPLESCRIPT' >/dev/null 2>&1 || true\n554\ton run argv\n555\t  set BrowserName to item 1 of argv\n556\t  set W to (item 2 of argv) as integer\n557\t  set I to (item 3 of argv) as integer\n558\t  set DestUrl to item 4 of argv\n559\t  if BrowserName is \"Safari\" then\n560\t    tell application \"Safari\" to set URL of tab I of window W to DestUrl\n561\t  else\n562\t    using terms from application \"Google Chrome\"\n563\t      tell application BrowserName to set URL of tab I of window W to DestUrl\n564\t    end using terms from\n565\t  end if\n566\tend run\n567\tAPPLESCRIPT\n568\t}\n569\t\n570\t# Decide and act for ONE tab (deep pass):\n571\t#  - already on the block page with unlock=1 (button clicked, wait elapsed)\n572\t#    -> grant the reward and open the real content;\n573\t#  - on a social network pointing at a blocked creator -> switch to the block\n574\t#    page (with the target and the countdown start time).\n575\tHandleTab() {\n576\t  local browser=\"$1\" windowIndex=\"$2\" tabIndex=\"$3\" url=\"$4\"\n577\t\n578\t  if [[ \"$url\" == \"$BLOCK_PAGE_URL\"* ]]; then\n579\t    [[ \"$url\" == *\"unlock=1\"* ]] || return 0\n580\t    local target startedAt\n581\t    target=\"$(ExtractParam \"$url\" u)\"\n582\t    startedAt=\"$(ExtractParam \"$url\" t)\"\n583\t    [[ -n \"$target\" ]] || return 0\n584\t    if [[ \"$startedAt\" =~ ^[0-9]+$ && $(( $(NowEpoch) - startedAt )) -ge $(( WAIT_MINUTES * 60 )) ]]; then\n585\t      GrantGrace \"$target\"\n586\t      RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$target\"\n587\t    else\n588\t      # Early or malformed unlock: restart from an honest countdown.\n589\t      RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$(GateUrlFor \"$target\")\"\n590\t    fi\n591\t    return 0\n592\t  fi\n593\t\n594\t  local lurl=\"${url:l}\"\n595\t  case \"$lurl\" in\n596\t    *youtube.com*|*youtu.be*|*instagram.com*|*tiktok.com*|*facebook.com*|*fb.watch*|*twitter.com*|*x.com*) ;;\n597\t    *) return 0 ;;\n598\t  esac\n599\t\n600\t  local identity=\"$url\"\n601\t  if [[ \"$lurl\" == *youtube.com* || \"$lurl\" == *youtu.be* ]]; then\n602\t    identity=\"$(YouTubeIdentityForUrl \"$url\" || true)\"\n603\t    [[ -n \"$identity\" ]] || identity=\"$url\"\n604\t  fi\n605\t\n606\t  TextMatchesBlocked \"$identity\" \\\n607\t    && RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$(GateUrlFor \"$url\")\"\n608\t}\n609\t\n610\t# One full sweep over every tab of every running browser (deep pass).\n611\tEnforceTabs() {\n612\t  local browser windowIndex tabIndex url\n613\t  while IFS=$'\\t' read -r browser windowIndex tabIndex url; do\n614\t    [[ -n \"$browser\" && -n \"$windowIndex\" && -n \"$tabIndex\" && -n \"$url\" ]] || continue\n615\t    HandleTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$url\"\n616\t  done < <(ListBrowserTabs)\n617\t}\n618\t\n619\t\n620\t# --- 10. Fast pass: instant redirect of the active tab ---------------------\n621\t\n622\t# The AppleScript \"if URL contains ...\" lines, built from FAST_PATTERNS minus\n623\t# any pattern that currently has a reward. Rebuilt each fast pass; cheap\n624\t# because there is usually no reward in flight.\n625\tBuildFastClauses() {\n626\t  local p anyGrace=0\n627\t  local -a graceFiles\n628\t  graceFiles=(\"$STATE_DIR\"/grace_*.until(N))\n629\t  (( ${#graceFiles[@]} > 0 )) && anyGrace=1\n630\t  for p in \"${FAST_PATTERNS[@]}\"; do\n631\t    if (( anyGrace )) && PatternIsGraced \"$p\"; then continue; fi\n632\t    printf '              if u contains \"%s\" then set doBlock to true\\n' \"${p//\\\"/\\\\\\\"}\"\n633\t  done\n634\t}\n635\t\n636\t# Check only the ACTIVE tab of each window, in one osascript that both detects\n637\t# and redirects. No shell round-trip and no yt-dlp: this is what removes the\n638\t# visible frame of the real page. The target keeps its handle so the reward\n639\t# reopens the right creator.\n640\tFastPassActiveTabs() {\n641\t  local now clauses script b hasTarget=0\n642\t  clauses=\"$(BuildFastClauses)\"\n643\t  [[ -n \"$clauses\" ]] || return 0\n644\t  now=\"$(NowEpoch)\"\n645\t\n646\t  script=\"global blockUrl, nowStr\"$'\\n'\n647\t  script+=\"set blockUrl to \\\"$BLOCK_PAGE_URL\\\"\"$'\\n'\n648\t  script+=\"set nowStr to \\\"$now\\\"\"$'\\n'\n649\t  script+='on stripQuery(u)'$'\\n'\n650\t  script+='  if u contains \"?\" then set u to text 1 thru ((offset of \"?\" in u) - 1) of u'$'\\n'\n651\t  script+='  if u contains \"#\" then set u to text 1 thru ((offset of \"#\" in u) - 1) of u'$'\\n'\n652\t  script+='  return u'$'\\n'\n653\t  script+='end stripQuery'$'\\n'\n654\t  script+='on gateFor(u)'$'\\n'\n655\t  script+='  return blockUrl & \"?u=\" & my stripQuery(u) & \"&t=\" & nowStr'$'\\n'\n656\t  script+='end gateFor'$'\\n'\n657\t\n658\t  for b in \"${CHROMIUM_BROWSERS[@]}\"; do\n659\t    pgrep -x \"$b\" >/dev/null 2>&1 || continue\n660\t    hasTarget=1\n661\t    script+='using terms from application \"Google Chrome\"'$'\\n'\n662\t    script+='  tell application \"'\"$b\"'\"'$'\\n'\n663\t    script+='    try'$'\\n'\n664\t    script+='      repeat with W in windows'$'\\n'\n665\t    script+='        try'$'\\n'\n666\t    script+='          set theTab to active tab of W'$'\\n'\n667\t    script+='          set u to (URL of theTab as text)'$'\\n'\n668\t    script+='          if not (u starts with blockUrl) then'$'\\n'\n669\t    script+='            set doBlock to false'$'\\n'\n670\t    script+='            ignoring case'$'\\n'\n671\t    script+=\"$clauses\"\n672\t    script+='            end ignoring'$'\\n'\n673\t    script+='            if doBlock then set URL of theTab to my gateFor(u)'$'\\n'\n674\t    script+='          end if'$'\\n'\n675\t    script+='        end try'$'\\n'\n676\t    script+='      end repeat'$'\\n'\n677\t    script+='    end try'$'\\n'\n678\t    script+='  end tell'$'\\n'\n679\t    script+='end using terms from'$'\\n'\n680\t  done\n681\t\n682\t  if pgrep -x \"Safari\" >/dev/null 2>&1; then\n683\t    hasTarget=1\n684\t    script+='tell application \"Safari\"'$'\\n'\n685\t    script+='  try'$'\\n'\n686\t    script+='    repeat with W in windows'$'\\n'\n687\t    script+='      try'$'\\n'\n688\t    script+='        set theTab to current tab of W'$'\\n'\n689\t    script+='        set u to (URL of theTab as text)'$'\\n'\n690\t    script+='        if not (u starts with blockUrl) then'$'\\n'\n691\t    script+='          set doBlock to false'$'\\n'\n692\t    script+='          ignoring case'$'\\n'\n693\t    script+=\"$clauses\"\n694\t    script+='          end ignoring'$'\\n'\n695\t    script+='          if doBlock then set URL of theTab to my gateFor(u)'$'\\n'\n696\t    script+='        end if'$'\\n'\n697\t    script+='      end try'$'\\n'\n698\t    script+='    end repeat'$'\\n'\n699\t    script+='  end try'$'\\n'\n700\t    script+='end tell'$'\\n'\n701\t  fi\n702\t\n703\t  (( hasTarget )) || return 0\n704\t  print -r -- \"$script\" | osascript - >/dev/null 2>&1 || true\n705\t}\n706\t\n707\t\n708\t# --- 11. Watch loop --------------------------------------------------------\n709\t\n710\t# Single pass (also used by the root layer, which cleans hosts/policy).\n711\tEnforce() {\n712\t  EnsureSecret\n713\t  ShouldBlock && EnforceTabs\n714\t  RemoveHostsBlock\n715\t  RemoveChromePolicy\n716\t}\n717\t\n718\t# The background service. Adaptive:\n719\t#  - browser frontmost -> fast pass every FAST_SLEEP, deep pass every DEEP_EVERY;\n720\t#  - browser in the background -> just a deep pass every second (no frame to\n721\t#    hide, so no need to burn CPU polling);\n722\t#  - out of the active window -> idle a minute.\n723\tWatchTabs() {\n724\t  EnsureSecret\n725\t  local i=0\n726\t  while true; do\n727\t    if ! ShouldBlock; then sleep 60; continue; fi\n728\t    # A hiccup in one pass must never kill the loop (KeepAlive would just\n729\t    # restart it in a churn); swallow non-zero and keep going.\n730\t    if BrowserIsFrontmost; then\n731\t      FastPassActiveTabs || true\n732\t      if (( i % DEEP_EVERY == 0 )); then EnforceTabs || true; fi\n733\t      i=$(( (i + 1) % 1000000 ))\n734\t      sleep \"$FAST_SLEEP\"\n735\t    else\n736\t      EnforceTabs || true\n737\t      i=0\n738\t      sleep 1\n739\t    fi\n740\t  done\n741\t}\n742\t\n743\t\n744\t# --- 12. Install -----------------------------------------------------------\n745\t\n746\tWriteUserPlist() {\n747\t  mkdir -p \"$HOME/Library/LaunchAgents\" \"$HOME/Library/Logs\"\n748\t  cat > \"$USER_PLIST\" <<PLIST\n749\t<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n750\t<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n751\t<plist version=\"1.0\">\n752\t<dict>\n753\t  <key>Label</key><string>$USER_LABEL</string>\n754\t  <key>ProgramArguments</key>\n755\t  <array><string>$SCRIPT_PATH</string><string>watch-tabs</string></array>\n756\t  <key>RunAtLoad</key><true/>\n757\t  <key>KeepAlive</key><true/>\n758\t  <key>StandardOutPath</key><string>$USER_LOG</string>\n759\t  <key>StandardErrorPath</key><string>$USER_ERR_LOG</string>\n760\t</dict>\n761\t</plist>\n762\tPLIST\n763\t  plutil -lint \"$USER_PLIST\" >/dev/null\n764\t}\n765\t\n766\tInstallUser() {\n767\t  EnsureSecret\n768\t  WriteUserPlist\n769\t  chmod 644 \"$USER_PLIST\" 2>/dev/null || true\n770\t  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n771\t  # macOS keeps a per-LABEL \"disabled\" flag, separate from our own\n772\t  # DISABLED_FILE: if this guard was ever stopped, that bit sticks and makes\n773\t  # the load fail (I/O error) until we explicitly clear it here.\n774\t  launchctl enable \"gui/$(id -u)/$USER_LABEL\" >/dev/null 2>&1 || true\n775\t  launchctl bootstrap \"gui/$(id -u)\" \"$USER_PLIST\"\n776\t  Say \"User tab guard installed.\"\n777\t}\n778\t\n779\tUninstallUser() {\n780\t  RequireGuardPassword\n781\t  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n782\t  rm -f \"$USER_PLIST\"\n783\t  Say \"User tab guard uninstalled.\"\n784\t}\n785\t\n786\t# Optional root layer: /etc/hosts + Chrome policy (with IncognitoModeAvailability=1,\n787\t# which forces normal windows, so the watcher can see them).\n788\t\n789\tFlushDns() { dscacheutil -flushcache 2>/dev/null || true; killall -HUP mDNSResponder 2>/dev/null || true; }\n790\t\n791\tStripHostsBlock() {\n792\t  awk -v s=\"$HOSTS_MARK_START\" -v e=\"$HOSTS_MARK_END\" \\\n793\t    '$0==s{skip=1;next} $0==e{skip=0;next} skip!=1{print}' \"$1\"\n794\t}\n795\t\n796\tApplyHostsBlock() {\n797\t  [[ \"$EUID\" -eq 0 ]] || return 0\n798\t  local tmp; tmp=\"$(mktemp)\"\n799\t  StripHostsBlock \"$HOSTS_FILE\" > \"$tmp\"\n800\t  { cat \"$tmp\"; printf '\\n%s\\n' \"$HOSTS_MARK_START\"\n801\t    local d; for d in \"${HOST_DOMAINS[@]}\"; do printf '0.0.0.0\\t%s\\n::1\\t%s\\n' \"$d\" \"$d\"; done\n802\t    printf '%s\\n' \"$HOSTS_MARK_END\"; } > \"$tmp.new\"\n803\t  cp \"$tmp.new\" \"$HOSTS_FILE\"; rm -f \"$tmp\" \"$tmp.new\"; FlushDns\n804\t}\n805\t\n806\tRemoveHostsBlock() {\n807\t  [[ \"$EUID\" -eq 0 ]] || return 0\n808\t  local tmp; tmp=\"$(mktemp)\"\n809\t  StripHostsBlock \"$HOSTS_FILE\" > \"$tmp\"; cp \"$tmp\" \"$HOSTS_FILE\"; rm -f \"$tmp\"; FlushDns\n810\t}\n811\t\n812\t# URL-shaped entries -> Chrome URLBlocklist entries (also covers incognito).\n813\tBuildChromeBlocklist() {\n814\t  CHROME_BLOCKLIST=(); local p\n815\t  for p in \"${BLOCKED_PATTERNS[@]}\"; do [[ \"$p\" == *\"/\"* ]] && CHROME_BLOCKLIST+=(\"$p\"); done\n816\t}\n817\t\n818\tApplyChromePolicy() {\n819\t  [[ \"$EUID\" -eq 0 ]] || return 0\n820\t  local tmp entry; BuildChromeBlocklist\n821\t  mkdir -p \"/Library/Managed Preferences\"\n822\t  if [[ ! -f \"$CHROME_POLICY_MARKER\" ]]; then\n823\t    if [[ -f \"$CHROME_POLICY_FILE\" ]]; then cp \"$CHROME_POLICY_FILE\" \"$CHROME_POLICY_BACKUP\"; printf 'existed\\n' > \"$CHROME_POLICY_MARKER\"\n824\t    else printf 'absent\\n' > \"$CHROME_POLICY_MARKER\"; fi\n825\t  fi\n826\t  tmp=\"$(mktemp)\"\n827\t  cat > \"$tmp\" <<'PLIST'\n828\t<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n829\t<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n830\t<plist version=\"1.0\">\n831\t<dict>\n832\t  <key>IncognitoModeAvailability</key><integer>1</integer>\n833\t  <key>URLBlocklist</key>\n834\t  <array>\n835\tPLIST\n836\t  for entry in \"${CHROME_BLOCKLIST[@]}\"; do printf '    <string>%s</string>\\n' \"$entry\" >> \"$tmp\"; done\n837\t  printf '  </array>\\n</dict>\\n</plist>\\n' >> \"$tmp\"\n838\t  plutil -lint \"$tmp\" >/dev/null\n839\t  cp \"$tmp\" \"$CHROME_POLICY_FILE\"; rm -f \"$tmp\"\n840\t  chown root:wheel \"$CHROME_POLICY_FILE\"; chmod 644 \"$CHROME_POLICY_FILE\"\n841\t  plutil -lint \"$CHROME_POLICY_FILE\" >/dev/null\n842\t}\n843\t\n844\tRemoveChromePolicy() {\n845\t  [[ \"$EUID\" -eq 0 ]] || return 0\n846\t  [[ -f \"$CHROME_POLICY_MARKER\" ]] || return 0\n847\t  local state; state=\"$(cat \"$CHROME_POLICY_MARKER\" 2>/dev/null || printf 'absent')\"\n848\t  if [[ \"$state\" == \"existed\" && -f \"$CHROME_POLICY_BACKUP\" ]]; then cp \"$CHROME_POLICY_BACKUP\" \"$CHROME_POLICY_FILE\"\n849\t  else rm -f \"$CHROME_POLICY_FILE\"; fi\n850\t}\n851\t\n852\tWriteRootPlist() {\n853\t  [[ \"$EUID\" -eq 0 ]] || { Say \"Root install needs admin rights.\"; exit 1; }\n854\t  cat > \"$ROOT_PLIST\" <<PLIST\n855\t<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n856\t<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n857\t<plist version=\"1.0\">\n858\t<dict>\n859\t  <key>Label</key><string>$ROOT_LABEL</string>\n860\t  <key>ProgramArguments</key>\n861\t  <array><string>$SCRIPT_PATH</string><string>enforce</string></array>\n862\t  <key>RunAtLoad</key><true/>\n863\t  <key>StartInterval</key><integer>60</integer>\n864\t  <key>StandardOutPath</key><string>/var/log/SocialMediaGuard.log</string>\n865\t  <key>StandardErrorPath</key><string>/var/log/SocialMediaGuard.err.log</string>\n866\t</dict>\n867\t</plist>\n868\tPLIST\n869\t  chown root:wheel \"$ROOT_PLIST\"; chmod 644 \"$ROOT_PLIST\"; plutil -lint \"$ROOT_PLIST\" >/dev/null\n870\t}\n871\t\n872\tInstallRoot() { EnsureSecret; CleanupRoot; }\n873\t\n874\tCleanupRoot() {\n875\t  [[ \"$EUID\" -eq 0 ]] || { Say \"Root cleanup needs admin rights.\"; exit 1; }\n876\t  RemoveHostsBlock; RemoveChromePolicy\n877\t  launchctl bootout system \"$ROOT_PLIST\" >/dev/null 2>&1 || true\n878\t  rm -f \"$ROOT_PLIST\"\n879\t  Say \"Root network guard removed. UI guard is active through the user agent.\"\n880\t}\n881\t\n882\tUninstallRoot() {\n883\t  RequireGuardPassword\n884\t  [[ \"$EUID\" -eq 0 ]] || { Say \"Root uninstall needs admin rights.\"; exit 1; }\n885\t  RemoveHostsBlock; RemoveChromePolicy\n886\t  launchctl bootout system \"$ROOT_PLIST\" >/dev/null 2>&1 || true\n887\t  rm -f \"$ROOT_PLIST\"\n888\t  Say \"Root host guard uninstalled.\"\n889\t}\n890\t\n891\t\n892\t# --- 13. Commands ----------------------------------------------------------\n893\t\n894\tSuspend() {\n895\t  RequireGuardPassword\n896\t  local minutes=\"${1:-30}\"\n897\t  [[ \"$minutes\" =~ '^[0-9]+$' ]] || { Say \"Minutes must be a number.\"; exit 1; }\n898\t  EnsureDirs\n899\t  printf '%s\\n' \"$(( $(NowEpoch) + minutes * 60 ))\" > \"$SUSPEND_FILE\"\n900\t  Enforce\n901\t  Say \"Guard suspended for $minutes minutes.\"\n902\t}\n903\t\n904\tDisable() {\n905\t  RequireGuardPassword\n906\t  EnsureDirs\n907\t  date '+%Y-%m-%d %H:%M:%S' > \"$DISABLED_FILE\"\n908\t  Enforce\n909\t  Say \"Guard disabled.\"\n910\t}\n911\t\n912\tEnable() {\n913\t  EnsureDirs\n914\t  rm -f \"$DISABLED_FILE\" \"$SUSPEND_FILE\"\n915\t  Enforce\n916\t  Say \"Guard enabled.\"\n917\t}\n918\t\n919\tStatus() {\n920\t  local userLoaded=\"no\" rootLoaded=\"no\" chromePolicy=\"no\"\n921\t  launchctl print \"gui/$(id -u)/$USER_LABEL\" >/dev/null 2>&1 && userLoaded=\"yes\"\n922\t  launchctl print \"system/$ROOT_LABEL\"        >/dev/null 2>&1 && rootLoaded=\"yes\"\n923\t  [[ -f \"$CHROME_POLICY_FILE\" ]] && /usr/libexec/PlistBuddy -c \"Print :URLBlocklist\" \"$CHROME_POLICY_FILE\" >/dev/null 2>&1 && chromePolicy=\"yes\"\n924\t\n925\t  Say \"protected_hours=$(IsProtectedNow && printf yes || printf no)\"\n926\t  Say \"disabled=$(IsDisabled && printf yes || printf no)\"\n927\t  Say \"suspended=$(IsSuspended && printf yes || printf no)\"\n928\t  Say \"user_tab_guard_loaded=$userLoaded\"\n929\t  Say \"root_host_guard_loaded=$rootLoaded\"\n930\t  Say \"hosts_block_present=$(grep -q \"$HOSTS_MARK_START\" \"$HOSTS_FILE\" 2>/dev/null && printf yes || printf no)\"\n931\t  Say \"chrome_policy_present=$chromePolicy\"\n932\t  Say \"block_page_present=$([[ -f \"$BLOCK_PAGE_FILE\" ]] && printf yes || printf no)\"\n933\t  Say \"secret_present=$([[ -f \"$SECRET_FILE\" ]] && printf yes || printf no)\"\n934\t  Say \"blocked_patterns=${#BLOCKED_PATTERNS[@]}\"\n935\t  Say \"fast_patterns=${#FAST_PATTERNS[@]}\"\n936\t}\n937\t\n938\t\n939\t# --- 14. Entry point -------------------------------------------------------\n940\t\n941\tcase \"${1:-status}\" in\n942\t  install-user)   InstallUser ;;\n943\t  install-root)   InstallRoot ;;\n944\t  enforce)        Enforce ;;\n945\t  watch-tabs)     WatchTabs ;;\n946\t  close-tabs)     EnsureBlockPage; EnforceTabs ;;\n947\t  suspend)        Suspend \"${2:-30}\" ;;\n948\t  disable)        Disable ;;\n949\t  enable)         Enable ;;\n950\t  status)         Status ;;\n951\t  uninstall-user) UninstallUser ;;\n952\t  uninstall-root) UninstallRoot ;;\n953\t  cleanup-root)   CleanupRoot ;;\n954\t  *)\n955\t    Say \"Usage: $0 install-user|status|enable|disable|suspend [min]|enforce|watch-tabs|close-tabs|uninstall-user|install-root|uninstall-root|cleanup-root\"\n956\t    exit 1 ;;\n957\tesac\n958\t"}]},"uuid":"d3967501-5ad0-4381-aae9-ed94145b9b6a","timestamp":"2026-08-07T09:11:31.373Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/zenray/Create/Build/Memory/Tools/FocusGuard/SocialMediaGuard.sh","content":"#!/bin/zsh\nset -euo pipefail\nexport PATH=\"/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin\"\n\n# ===========================================================================\n#  SOCIAL MEDIA GUARD\n#  Closes the creators (YouTube + Instagram/TikTok/X/Facebook) that Matthieu\n#  chose to stop watching. Instead of a hard block, the tab switches to a\n#  countdown page: after WAIT_MINUTES a button opens the content for\n#  REWARD_MINUTES, then the tab is caught again.\n#\n#  How blocking stays fast (no visible frame of the real page):\n#    - FAST pass  (~0.1s): checks only the ACTIVE tab and redirects it inside\n#      AppleScript. Runs only while a browser is frontmost. Kills the frame.\n#    - DEEP pass  (~1s):   full sweep of every tab, resolves YouTube videos\n#      through yt-dlp, handles the reward, catches background tabs.\n#\n#  File map:\n#     1. Config              - paths, timings, browsers\n#     2. Blocked creators    - BLOCKED_PATTERNS (single editable source)\n#     3. Small helpers       - dates, text, url encoding\n#     4. Files and migration - folders, password, old names\n#     5. On / Off            - disabled, suspended, active window\n#     6. Match engine        - does this text point to a blocked creator?\n#     7. Reward (grace)      - temporary earned access, per creator\n#     8. Block page          - the HTML shown in the tab\n#     9. Browser control     - list tabs, redirect one tab\n#    10. Fast pass           - instant redirect of the active tab\n#    11. Watch loop          - the loop the background service runs\n#    12. Install             - user service (+ optional root layer)\n#    13. Commands            - status, suspend, disable/enable, uninstall\n#    14. Entry point         - command line dispatch\n#\n#  Usage: SocialMediaGuard.sh <command>\n#    install-user | status | enable | disable | suspend [min] |\n#    enforce | watch-tabs | close-tabs | uninstall-user |\n#    install-root | uninstall-root | cleanup-root\n# ===========================================================================\n\n\n# --- 1. Config -------------------------------------------------------------\n\nOWNER=\"zenray\"\nMEMORY_ROOT=\"${MEMORY_ROOT:-/Users/zenray/Create/Build/Memory}\"\nFOCUS_DIR=\"$MEMORY_ROOT/Focus\"\n\nSECRET_FILE=\"$FOCUS_DIR/.SocialMediaGuardPassword\"     # local password (git-ignored)\nSTATE_DIR=\"$FOCUS_DIR/.SocialMediaGuardState\"          # internal state (git-ignored)\nDISABLED_FILE=\"$STATE_DIR/disabled\"                    # present = guard turned off\nSUSPEND_FILE=\"$STATE_DIR/suspend_until\"                # epoch when suspension ends\nBLOCK_PAGE_FILE=\"$FOCUS_DIR/SocialMediaBlocked.html\"   # the page shown in the tab\nBLOCK_PAGE_URL=\"file://$BLOCK_PAGE_FILE\"\nILLUSTRATION_URL=\"file://$MEMORY_ROOT/ArtDirection/output_v3.png\"\n\n# Timings (overridable from the plist via environment variables).\nWAIT_MINUTES=\"${SMG_WAIT_MINUTES:-30}\"      # wait before the content can open\nREWARD_MINUTES=\"${SMG_REWARD_MINUTES:-30}\"  # how long access lasts once earned\nSTART_HOUR=\"${SMG_START_HOUR:-0}\"           # active window: 0..24 = always on\nEND_HOUR=\"${SMG_END_HOUR:-24}\"\nFAST_SLEEP=\"${SMG_FAST_SLEEP:-0.1}\"         # active-tab poll interval (seconds)\nDEEP_EVERY=\"${SMG_DEEP_EVERY:-10}\"          # deep sweep once every N fast passes\n\n# Background service (LaunchAgent).\nUSER_LABEL=\"com.zenray.social-media-guard.tabs\"\nROOT_LABEL=\"com.zenray.social-media-guard\"\nUSER_PLIST=\"$HOME/Library/LaunchAgents/$USER_LABEL.plist\"\nROOT_PLIST=\"/Library/LaunchDaemons/$ROOT_LABEL.plist\"\nSCRIPT_PATH=\"$MEMORY_ROOT/Tools/FocusGuard/SocialMediaGuard.sh\"\nUSER_LOG=\"$HOME/Library/Logs/SocialMediaGuard.tabs.log\"\nUSER_ERR_LOG=\"$HOME/Library/Logs/SocialMediaGuard.tabs.err.log\"\n\n# Optional root layer (hosts + Chrome policy). Inactive without sudo.\nHOSTS_FILE=\"/etc/hosts\"\nHOSTS_MARK_START=\"# ZENRAY_SOCIAL_MEDIA_GUARD_START\"\nHOSTS_MARK_END=\"# ZENRAY_SOCIAL_MEDIA_GUARD_END\"\nCHROME_POLICY_FILE=\"/Library/Managed Preferences/com.google.Chrome.plist\"\nCHROME_POLICY_BACKUP=\"$STATE_DIR/com.google.Chrome.plist.before-guard\"\nCHROME_POLICY_MARKER=\"$STATE_DIR/chrome_policy_backup_state\"\nHOST_DOMAINS=()\nCHROME_BLOCKLIST=()\n\n# Browsers we drive. Every Chromium shares Google Chrome's tab vocabulary\n# (\"using terms from\"); Safari has its own.\nCHROMIUM_BROWSERS=(\n  \"Google Chrome\" \"Google Chrome Beta\" \"Google Chrome Canary\" \"Chromium\"\n  \"Brave Browser\" \"Brave Browser Beta\" \"Microsoft Edge\" \"Microsoft Edge Beta\"\n  \"Vivaldi\" \"Opera\" \"Opera GX\"\n)\n\n\n# --- 2. Blocked creators (single source of truth) --------------------------\n#\n# Each entry is matched as a substring, case-insensitive and separator-\n# insensitive (see Normalize), against two things:\n#   1) the tab URL (any network) - blocks YouTube, Instagram, TikTok,\n#      Facebook and X as soon as the entry is the account handle;\n#   2) the identity yt-dlp returns for a /watch page (channel name, uploader)\n#      - catches every video and side channel of a creator, even without\n#      knowing their exact handle.\n# Safety: an entry that matches nothing blocks nothing (harmless miss). So we\n# can be broad on NAMES and stay precise (joined handle or URL) to never block\n# a third party by accident.\n#\n# A few entries keep accents on purpose: they are real creator names, and a\n# channel identity like \"HugoDecrypte\" written with the accent is only caught\n# by the accented form.\n\nBLOCKED_PATTERNS=(\n  # --- Ici Japon ---\n  \"youtube.com/@icijaponcorp\"  \"youtube.com/channel/uct11zynefnunokgcrso9uyg\"  \"ici japon\"\n  # --- Silicon Carne / Carlos Diaz ---\n  \"youtube.com/@siliconcarnepod\"  \"siliconcarne\"  \"silicon carne\"  \"carlosdiaz\"  \"carlos diaz\"\n  # --- Oussama Ammar ---\n  \"youtube.com/@oussamaammaroff\"  \"youtube.com/channel/ucxh-b8b2sx4kgshsvj3ngza\"\n  \"oussamaammaroff\"  \"oussamaammar\"  \"oussama ammar\"\n  # --- Yomi Denzel ---\n  \"youtube.com/@yomidenzel\"  \"youtube.com/yomidenzel\"  \"youtube.com/channel/uchge6r4qaugajalyijoccgw\"\n  \"yomidenzel\"  \"yomi.denzel\"  \"yomi denzel\"\n  # --- Antoine Blanco (+ business channel) ---\n  \"youtube.com/@antoineblanco\"  \"youtube.com/@antoineblanco99\"  \"youtube.com/@antoineblancobusiness\"\n  \"youtube.com/channel/uc0kcckhmqfiguifkqco-iya\"  \"antoineblanco\"  \"antoine blanco\"\n  # --- Sixtine Moulle-Berteaux ---\n  \"youtube.com/@sixtinemoulleberteaux\"  \"sixtinemoulleberteaux\"  \"sixtine.moulleberteaux\"\n  \"sixtine moulle\"  \"sixtine moulle-berteaux\"\n  # --- Wallerand Moulle-Berteaux ---\n  \"wallerandmoulleberteaux\"  \"wallerand.moulleberteaux\"  \"wallerand moulle\"  \"wallerand moulle-berteaux\"\n  # --- Eric Larcheveque ---\n  \"ericlarcheveque\"  \"eric larcheveque\"  \"eric l'archeveque\"  \"eric larchevêque\"\n  # --- Guillaume Moubeche ---\n  \"guillaumemoubeche\"  \"guillaume moubeche\"  \"guillaume moubèche\"\n  # --- Alex Hitchens (+ side channels via identity) ---\n  \"alexhitchens\"  \"alex hitchens\"\n  # --- Julien Chieze (gaming news) ---\n  \"julienchieze\"  \"julien chieze\"\n  # --- HugoDecrypte (news, all channels) ---\n  \"youtube.com/@hugodecrypte\"  \"youtube.com/@hugodecrypteactus\"  \"youtube.com/@hugodecryptegrandsformats\"\n  \"hugodecrypte\"  \"hugo decrypte\"  \"hugo décrypte\"\n  # --- Le Crayon (news/media) ---\n  \"youtube.com/@lecrayon\"  \"le crayon\"\n  # --- La Chapelle Radio / Hugo Bentz ---\n  \"youtube.com/@la-chapelle-radio-hugo-bentz\"  \"la chapelle radio\"  \"hugo bentz\"\n  # --- Matthieu Stefani / Generation Do It Yourself ---\n  \"matthieu stefani\"  \"generation do it yourself\"  \"génération do it yourself\"  \"gdiy\"\n  # --- Pauline Laigneau ---\n  \"youtube.com/@paulinelaigneau\"  \"pauline laigneau\"\n  # --- Les Decouvreurs ---\n  \"youtube.com/@les_decouvreurs\"  \"les decouvreurs\"  \"les découvreurs\"\n  # --- Theophile Eliet (hyphen handle, handled by Normalize) ---\n  \"youtube.com/@theophile-eliet\"  \"theophile eliet\"  \"théophile eliet\"\n  # --- Le Precepteur ---\n  \"le precepteur\"  \"le précepteur\"\n  # --- My Better Self ---\n  \"mybetterself\"  \"my better self\"\n  # --- LouisSan (+ side channels: LouisSanCorp...) ---\n  \"louissan\"  \"louissancorp\"\n  # --- Business / make-money / mindset / manosphere sphere (NAMES only) ---\n  \"iman gadzhi\"  \"imangadzhi\"  \"andrew tate\"  \"tristan tate\"  \"cobratate\"\n  \"enzo honore\"  \"enzo honoré\"  \"franck nicolas\"  \"idriss aberkane\"  \"anthony bourbon\"\n  \"hasheur\"  \"owen simonin\"  \"lorenzo ferrante\"  \"mick levy\"  \"younes belghazi\"\n  \"yann darwin\"  \"yan darwin\"  \"raoul pop\"  \"david laroche\"  \"fabien snauwaert\"\n  \"romain pichon\"  \"tugan bara\"  \"tugan.baranovsky\"  \"morgan prevel\"  \"morgan prével\"\n  \"valentin decker\"  \"jean riviere\"  \"jean rivière\"  \"jeremy kohlmann\"  \"aurelien amacker\"  \"aurélien amacker\"\n  \"squeezie\"  \"naval ravikant\"  \"navalravikant\"  \"laurent alexandre\"  \"alexandre cicoupoulos\"\n)\n\n\n# --- 3. Small helpers ------------------------------------------------------\n\nSay()      { printf '%s\\n' \"$*\"; }\nNowEpoch() { date '+%s'; }\n\n# Drop case AND separators: \"Theophile-Eliet\", \"theophile.eliet\" and\n# \"theophile eliet\" all become \"theophileeliet\". One place that removes the\n# whole family of separator bugs (hyphen vs dot vs space).\nNormalize() {\n  local s=\"${1:l}\"\n  printf '%s' \"${s//[-._ ]/}\"\n}\n\nUrlEncode() { python3 -c 'import sys,urllib.parse;print(urllib.parse.quote(sys.argv[1], safe=\"\"))' \"$1\"; }\nUrlDecode() { python3 -c 'import sys,urllib.parse;print(urllib.parse.unquote(sys.argv[1]))'         \"$1\"; }\n\n# Value (decoded) of query parameter $2 in the URL $1.\nExtractParam() {\n  local u=\"$1\" name=\"$2\" q pair\n  q=\"${u#*\\?}\"\n  [[ \"$q\" == \"$u\" ]] && return 0          # no '?' means no query string\n  for pair in ${(s:&:)q}; do\n    [[ \"$pair\" == \"$name=\"* ]] && { UrlDecode \"${pair#$name=}\"; return 0; }\n  done\n}\n\n# Normalized form of every entry, computed ONCE at load (not inside the loop\n# that runs many times per second), to avoid needless work.\nNORMALIZED_PATTERNS=()\nfor _p in \"${BLOCKED_PATTERNS[@]}\"; do NORMALIZED_PATTERNS+=(\"$(Normalize \"$_p\")\"); done\nunset _p\n\n# The subset the fast pass uses: entries that can appear in a URL (no spaces),\n# lowercased. Spaced names never appear in a URL, so they stay for the deep\n# pass only (matched against the yt-dlp identity).\nFAST_PATTERNS=()\nfor _p in \"${BLOCKED_PATTERNS[@]}\"; do\n  [[ \"$_p\" == *\" \"* ]] && continue\n  FAST_PATTERNS+=(\"${_p:l}\")\ndone\nunset _p\n\n\n# --- 4. Files and migration ------------------------------------------------\n\n# Rename the files from older versions (YouTube*, then SocialMediaFocus*) to\n# the current names, so we keep the local password and any running reward.\n# Idempotent: after migration the old ones are gone. Never overwrites a file\n# that already exists under the new name.\nMigrateLegacy() {\n  local old\n  for old in \"$FOCUS_DIR/.SocialMediaFocusGuardPassword\" \"$FOCUS_DIR/.YouTubeFocusGuardPassword\"; do\n    [[ -f \"$old\" && ! -f \"$SECRET_FILE\" ]] && mv \"$old\" \"$SECRET_FILE\" 2>/dev/null\n  done\n  for old in \"$FOCUS_DIR/.SocialMediaFocusGuardState\" \"$FOCUS_DIR/.YouTubeFocusGuardState\"; do\n    [[ -d \"$old\" && ! -d \"$STATE_DIR\" ]] && mv \"$old\" \"$STATE_DIR\" 2>/dev/null\n  done\n  rm -f \"$FOCUS_DIR/YouTubeBlocked.html\" 2>/dev/null\n  return 0\n}\n\nEnsureDirs() {\n  MigrateLegacy\n  mkdir -p \"$FOCUS_DIR\" \"$STATE_DIR\"\n  chmod 700 \"$STATE_DIR\" 2>/dev/null || true\n}\n\n# Create a local password on first run (Matthieu does not memorize it; the\n# assistant can read it on disk if a real unlock is ever needed).\nEnsureSecret() {\n  EnsureDirs\n  EnsureBlockPage\n  if [[ ! -f \"$SECRET_FILE\" ]]; then\n    umask 077\n    /opt/homebrew/bin/openssl rand -base64 48 | tr -d '\\n' > \"$SECRET_FILE\"\n    printf '\\n' >> \"$SECRET_FILE\"\n  fi\n  chmod 600 \"$SECRET_FILE\" 2>/dev/null || true\n  if [[ \"$EUID\" -eq 0 ]]; then\n    chown \"${OWNER}:staff\" \"$SECRET_FILE\" \"$FOCUS_DIR\" \"$STATE_DIR\" 2>/dev/null || true\n  fi\n}\n\n# Barrier against the reflex for the sensitive commands (suspend/disable/uninstall).\nRequireGuardPassword() {\n  EnsureSecret\n  local expected input\n  expected=\"$(cat \"$SECRET_FILE\")\"\n  if [[ -n \"${SMG_PASSWORD:-}\" ]]; then\n    input=\"$SMG_PASSWORD\"\n  else\n    printf 'Focus password: ' >&2\n    stty -echo; IFS= read -r input; stty echo\n    printf '\\n' >&2\n  fi\n  [[ \"$input\" == \"$expected\" ]] || { Say \"Wrong focus password.\"; exit 2; }\n}\n\n\n# --- 5. On / Off -----------------------------------------------------------\n\nIsDisabled() { [[ -f \"$DISABLED_FILE\" ]]; }\n\nIsSuspended() {\n  [[ -f \"$SUSPEND_FILE\" ]] || return 1\n  local until; until=\"$(cat \"$SUSPEND_FILE\" 2>/dev/null || printf '0')\"\n  [[ \"$until\" =~ '^[0-9]+$' ]] || return 1\n  [[ \"$(NowEpoch)\" -lt \"$until\" ]]\n}\n\n# Active time window (default 0..24, so always).\nIsProtectedNow() {\n  local hour; hour=\"$(date '+%H')\"; hour=\"${hour#0}\"; [[ -z \"$hour\" ]] && hour=0\n  [[ \"$hour\" -ge \"$START_HOUR\" && \"$hour\" -lt \"$END_HOUR\" ]]\n}\n\n# Should we block right now? No if turned off, suspended, or out of window.\nShouldBlock() {\n  IsDisabled  && return 1\n  IsSuspended && return 1\n  IsProtectedNow\n}\n\n# Is a browser the frontmost app? The fast pass only runs then: while Matthieu\n# works in Houdini or Unreal there is no visible tab to flash, so we stay idle.\nBrowserIsFrontmost() {\n  local front\n  front=\"$(lsappinfo info -only name \"$(lsappinfo front 2>/dev/null)\" 2>/dev/null)\"\n  case \"$front\" in\n    *\"Google Chrome\"*|*Safari*|*\"Brave Browser\"*|*\"Microsoft Edge\"*|*Vivaldi*|*Opera*|*Chromium*) return 0 ;;\n    *) return 1 ;;\n  esac\n}\n\n\n# --- 6. Match engine: does this text point to a blocked creator? -----------\n\n# One elementary test, raw form OR normalized form. GrantGrace and\n# TextMatchesBlocked both use it: they MUST agree on \"which entries this text\n# triggers\", otherwise a granted reward would miss an entry that only matches\n# after normalization (e.g. \"silicon carne\" with a space) and re-block right\n# away despite the earned reward.\nPatternMatches() {\n  local lpattern=\"$1\" npattern=\"$2\" text=\"$3\" ntext=\"$4\"\n  [[ \"$text\" == *\"$lpattern\"* ]] && return 0\n  [[ -n \"$npattern\" && \"$ntext\" == *\"$npattern\"* ]] && return 0\n  return 1\n}\n\n# True if the text (a URL or a yt-dlp identity) names a blocked creator AND is\n# not currently covered by a reward.\nTextMatchesBlocked() {\n  local raw=\"$1\" text=\"${1:l}\" ntext anyGrace=0 i n\n  local -a graceFiles\n  ntext=\"$(Normalize \"$raw\")\"\n  graceFiles=(\"$STATE_DIR\"/grace_*.until(N))\n  (( ${#graceFiles[@]} > 0 )) && anyGrace=1\n  n=${#BLOCKED_PATTERNS[@]}\n  for (( i = 1; i <= n; i++ )); do\n    if PatternMatches \"${BLOCKED_PATTERNS[i]:l}\" \"${NORMALIZED_PATTERNS[i]}\" \"$text\" \"$ntext\"; then\n      if (( anyGrace )) && PatternIsGraced \"${BLOCKED_PATTERNS[i]}\"; then continue; fi\n      return 0\n    fi\n  done\n  return 1\n}\n\n# YouTube pages whose real channel yt-dlp can resolve (a video URL does not\n# always carry the handle).\nIsResolvableYouTubeUrl() {\n  local url=\"${1:l}\"\n  case \"$url\" in\n    *youtube.com/watch\\?*|*youtube.com/shorts/*|*youtube.com/live/*|*youtube.com/post/*|*youtu.be/*) return 0 ;;\n    *) return 1 ;;\n  esac\n}\n\n# The real identity behind a YouTube URL: first a direct test on the URL\n# (handle visible), otherwise ask yt-dlp (channel name, uploader...), cached\n# so we do not repeat the network call on every pass.\nYouTubeIdentityForUrl() {\n  local url=\"$1\"\n  TextMatchesBlocked \"$url\" && { printf '%s\\n' \"$url\"; return 0; }\n  IsResolvableYouTubeUrl \"$url\" || return 1\n\n  local ytdlp cacheDir cache json identity\n  ytdlp=\"$(command -v yt-dlp 2>/dev/null || true)\"\n  [[ -n \"$ytdlp\" ]] || return 1\n\n  cacheDir=\"$STATE_DIR/youtube-identity-cache\"; mkdir -p \"$cacheDir\"\n  cache=\"$cacheDir/$(printf '%s' \"$url\" | shasum -a 256 | awk '{print $1}').txt\"\n  [[ -s \"$cache\" ]] && { cat \"$cache\"; return 0; }\n\n  json=\"$(\"$ytdlp\" --dump-single-json --no-playlist --skip-download \\\n    --socket-timeout 4 --extractor-retries 1 --retries 1 \"$url\" 2>/dev/null || true)\"\n  identity=\"$(printf '%s' \"$json\" | jq -r '\n    [ .channel, .uploader, .channel_id, .uploader_id, .channel_url,\n      .uploader_url, .creator, .webpage_url, .original_url ]\n    | map(select(type == \"string\" and length > 0)) | join(\" \")' 2>/dev/null || true)\"\n\n  [[ -n \"$identity\" ]] && printf '%s\\n' \"$identity\" > \"$cache\"\n  printf '%s\\n' \"$identity\"\n}\n\n\n# --- 7. Reward (grace): temporary earned access, per creator ---------------\n\n# Path of a pattern's reward marker (a safe file name, no shasum fork).\nGraceFileFor() {\n  printf '%s/grace_%s.until' \"$STATE_DIR\" \"$(printf '%s' \"${1:l}\" | tr -c 'a-z0-9' '_')\"\n}\n\n# True if this pattern has a reward that is still valid.\nPatternIsGraced() {\n  local f until; f=\"$(GraceFileFor \"$1\")\"\n  [[ -f \"$f\" ]] || return 1\n  until=\"$(cat \"$f\" 2>/dev/null || printf '0')\"\n  [[ \"$until\" =~ ^[0-9]+$ ]] || return 1\n  [[ \"$(NowEpoch)\" -lt \"$until\" ]]\n}\n\n# Grant REWARD_MINUTES to every entry the target URL triggers, and only those:\n# earning access to one creator never unblocks the others.\nGrantGrace() {\n  local target=\"$1\" ltarget nltarget until i n\n  ltarget=\"${target:l}\"; nltarget=\"$(Normalize \"$target\")\"\n  until=\"$(( $(NowEpoch) + REWARD_MINUTES * 60 ))\"\n  EnsureDirs\n  n=${#BLOCKED_PATTERNS[@]}\n  for (( i = 1; i <= n; i++ )); do\n    if PatternMatches \"${BLOCKED_PATTERNS[i]:l}\" \"${NORMALIZED_PATTERNS[i]}\" \"$ltarget\" \"$nltarget\"; then\n      printf '%s\\n' \"$until\" > \"$(GraceFileFor \"${BLOCKED_PATTERNS[i]}\")\"\n    fi\n  done\n}\n\n# The block-page URL for a target, timestamped (lets the page recompute the\n# time left even after the tab is reloaded).\nGateUrlFor() {\n  printf '%s?u=%s&t=%s' \"$BLOCK_PAGE_URL\" \"$(UrlEncode \"$1\")\" \"$(NowEpoch)\"\n}\n\n\n# --- 8. Block page (the HTML shown in the tab) -----------------------------\n# English, plain tone. Numbers in Anthropic Serif, text in Anthropic Sans.\n\nEnsureBlockPage() {\n  EnsureDirs\n  local F=\"/Users/zenray/Library/Fonts\"\n  cat > \"$BLOCK_PAGE_FILE\" <<HTML\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Blocked</title>\n<style>\n  @font-face { font-family:\"AnthropicSans\"; src:url(\"file://$F/AnthropicSans-Light.ttf\") format(\"truetype\"); font-weight:300 }\n  @font-face { font-family:\"AnthropicSans\"; src:url(\"file://$F/AnthropicSans-Medium.ttf\") format(\"truetype\"); font-weight:500 }\n  @font-face { font-family:\"AnthropicSerif\"; src:url(\"file://$F/AnthropicSerif-Light.ttf\") format(\"truetype\"); font-weight:300 }\n  @font-face { font-family:\"AnthropicSerif\"; src:url(\"file://$F/AnthropicSerif-Regular.ttf\") format(\"truetype\"); font-weight:400 }\n  :root { color-scheme:dark }\n  * { box-sizing:border-box }\n  body {\n    margin:0; min-height:100vh; display:grid; place-items:center;\n    background:#242424; color:#f2f2f2;\n    font-family:\"AnthropicSans\", system-ui, sans-serif; font-weight:300;\n  }\n  main { width:min(1500px, calc(100vw - 48px)); text-align:center }\n  .art { display:block; width:min(640px, calc(100vw - 120px)); margin:0 auto 34px;\n         border-radius:8px; box-shadow:0 16px 48px rgba(0,0,0,.28) }\n  .eyebrow { font-weight:500; font-size:13px; letter-spacing:.14em; text-transform:uppercase;\n             color:#cc7c5e; margin:0 0 18px }\n  /* Numbers: always Serif. */\n  .timer { font-family:\"AnthropicSerif\", serif; font-weight:300;\n           font-size:clamp(64px, 12vw, 168px); line-height:1; color:#f4f4f4;\n           font-variant-numeric:tabular-nums; margin:0 }\n  .num { font-family:\"AnthropicSerif\", serif }\n  .head { font-weight:300; font-size:clamp(22px, 2.4vw, 34px); color:#efefef; margin:6px 0 0 }\n  .cap { font-size:15px; color:#8c857d; margin:14px 0 0 }\n  .btn { display:inline-block; margin-top:22px; padding:14px 32px; border-radius:999px;\n         background:#f2f2f2; color:#242424; text-decoration:none; font-weight:500 }\n</style>\n</head>\n<body>\n<main>\n  <img class=\"art\" src=\"$ILLUSTRATION_URL\" alt=\"\">\n  <section id=\"waitBox\">\n    <p class=\"eyebrow\">Creator mode</p>\n    <p class=\"timer\" id=\"countdown\">--:--</p>\n    <p class=\"cap\">until this opens</p>\n  </section>\n  <section id=\"rewardBox\" style=\"display:none\">\n    <p class=\"eyebrow\">Creator mode</p>\n    <p class=\"head\">Time's up.</p>\n    <a id=\"rewardLink\" class=\"btn\" href=\"#\">Open now</a>\n    <p class=\"cap\">Open for <span class=\"num\">$REWARD_MINUTES</span> min, then it closes.</p>\n  </section>\n  <section id=\"closedBox\" style=\"display:none\">\n    <p class=\"eyebrow\">Creator mode</p>\n    <p class=\"head\">Closed.</p>\n  </section>\n</main>\n<script>\n(function () {\n  var p = new URLSearchParams(location.search);\n  var target = p.get('u') || '';\n  var startedSec = parseInt(p.get('t') || '0', 10) || 0;\n  var WAIT_SECONDS = $((WAIT_MINUTES * 60));\n  var waitBox = document.getElementById('waitBox');\n  var rewardBox = document.getElementById('rewardBox');\n  var closedBox = document.getElementById('closedBox');\n  if (!target || !startedSec) { waitBox.style.display = 'none'; closedBox.style.display = 'block'; return; }\n  var el = document.getElementById('countdown');\n  function fmt(s) { var m = Math.floor(s/60), r = s%60; return (m<10?'0':'')+m+':'+(r<10?'0':'')+r; }\n  function tick() {\n    var remain = WAIT_SECONDS - (Math.floor(Date.now()/1000) - startedSec);\n    if (remain <= 0) {\n      waitBox.style.display = 'none';\n      document.getElementById('rewardLink').href =\n        location.pathname + '?u=' + encodeURIComponent(target) + '&t=' + startedSec + '&unlock=1';\n      rewardBox.style.display = 'block';\n      return;\n    }\n    el.textContent = fmt(remain);\n    setTimeout(tick, 1000);\n  }\n  tick();\n})();\n</script>\n</body>\n</html>\nHTML\n  chmod 644 \"$BLOCK_PAGE_FILE\" 2>/dev/null || true\n}\n\n\n# --- 9. Browser control ----------------------------------------------------\n\n# List open tabs as \"browser<TAB>window<TAB>tab<TAB>url\" per line. One osascript\n# per RUNNING browser (pgrep), so we never name an app that is not installed\n# (which would pop a blocking \"Where is X?\" dialog), and a browser that fails\n# does not stop us from reading the others.\nListBrowserTabs() {\n  local b\n  for b in \"${CHROMIUM_BROWSERS[@]}\"; do\n    pgrep -x \"$b\" >/dev/null 2>&1 || continue\n    osascript <<APPLESCRIPT 2>/dev/null || true\nset Output to \"\"\nset T to ASCII character 9\nusing terms from application \"Google Chrome\"\n  tell application \"$b\"\n    repeat with W from 1 to (count of windows)\n      repeat with I from 1 to (count of tabs of window W)\n        try\n          set Output to Output & \"$b\" & T & W & T & I & T & (URL of tab I of window W as text) & linefeed\n        end try\n      end repeat\n    end repeat\n  end tell\nend using terms from\nreturn Output\nAPPLESCRIPT\n  done\n  if pgrep -x \"Safari\" >/dev/null 2>&1; then\n    osascript <<'APPLESCRIPT' 2>/dev/null || true\nset Output to \"\"\nset T to ASCII character 9\ntell application \"Safari\"\n  repeat with W from 1 to (count of windows)\n    repeat with I from 1 to (count of tabs of window W)\n      try\n        set Output to Output & \"Safari\" & T & W & T & I & T & (URL of tab I of window W as text) & linefeed\n      end try\n    end repeat\n  end repeat\nend tell\nreturn Output\nAPPLESCRIPT\n  fi\n}\n\n# Change one specific tab's URL (to the block page, or to the real content when\n# a reward is granted). Chromium through \"using terms from\", Safari natively.\nRedirectBrowserTab() {\n  local browser=\"$1\" windowIndex=\"$2\" tabIndex=\"$3\" destUrl=\"$4\"\n  osascript - \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$destUrl\" <<'APPLESCRIPT' >/dev/null 2>&1 || true\non run argv\n  set BrowserName to item 1 of argv\n  set W to (item 2 of argv) as integer\n  set I to (item 3 of argv) as integer\n  set DestUrl to item 4 of argv\n  if BrowserName is \"Safari\" then\n    tell application \"Safari\" to set URL of tab I of window W to DestUrl\n  else\n    using terms from application \"Google Chrome\"\n      tell application BrowserName to set URL of tab I of window W to DestUrl\n    end using terms from\n  end if\nend run\nAPPLESCRIPT\n}\n\n# Decide and act for ONE tab (deep pass):\n#  - already on the block page with unlock=1 (button clicked, wait elapsed)\n#    -> grant the reward and open the real content;\n#  - on a social network pointing at a blocked creator -> switch to the block\n#    page (with the target and the countdown start time).\nHandleTab() {\n  local browser=\"$1\" windowIndex=\"$2\" tabIndex=\"$3\" url=\"$4\"\n\n  if [[ \"$url\" == \"$BLOCK_PAGE_URL\"* ]]; then\n    [[ \"$url\" == *\"unlock=1\"* ]] || return 0\n    local target startedAt\n    target=\"$(ExtractParam \"$url\" u)\"\n    startedAt=\"$(ExtractParam \"$url\" t)\"\n    [[ -n \"$target\" ]] || return 0\n    if [[ \"$startedAt\" =~ ^[0-9]+$ && $(( $(NowEpoch) - startedAt )) -ge $(( WAIT_MINUTES * 60 )) ]]; then\n      GrantGrace \"$target\"\n      RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$target\"\n    else\n      # Early or malformed unlock: restart from an honest countdown.\n      RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$(GateUrlFor \"$target\")\"\n    fi\n    return 0\n  fi\n\n  local lurl=\"${url:l}\"\n  case \"$lurl\" in\n    *youtube.com*|*youtu.be*|*instagram.com*|*tiktok.com*|*facebook.com*|*fb.watch*|*twitter.com*|*x.com*) ;;\n    *) return 0 ;;\n  esac\n\n  local identity=\"$url\"\n  if [[ \"$lurl\" == *youtube.com* || \"$lurl\" == *youtu.be* ]]; then\n    identity=\"$(YouTubeIdentityForUrl \"$url\" || true)\"\n    [[ -n \"$identity\" ]] || identity=\"$url\"\n  fi\n\n  TextMatchesBlocked \"$identity\" \\\n    && RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$(GateUrlFor \"$url\")\"\n}\n\n# One full sweep over every tab of every running browser (deep pass).\nEnforceTabs() {\n  local browser windowIndex tabIndex url\n  while IFS=$'\\t' read -r browser windowIndex tabIndex url; do\n    [[ -n \"$browser\" && -n \"$windowIndex\" && -n \"$tabIndex\" && -n \"$url\" ]] || continue\n    HandleTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$url\"\n  done < <(ListBrowserTabs)\n}\n\n\n# --- 10. Fast pass: instant redirect of the active tab ---------------------\n\n# The AppleScript \"if URL contains ...\" lines, built from FAST_PATTERNS minus\n# any pattern that currently has a reward. Rebuilt each fast pass; cheap\n# because there is usually no reward in flight.\nBuildFastClauses() {\n  local p anyGrace=0\n  local -a graceFiles\n  graceFiles=(\"$STATE_DIR\"/grace_*.until(N))\n  (( ${#graceFiles[@]} > 0 )) && anyGrace=1\n  for p in \"${FAST_PATTERNS[@]}\"; do\n    if (( anyGrace )) && PatternIsGraced \"$p\"; then continue; fi\n    printf '              if u contains \"%s\" then set doBlock to true\\n' \"${p//\\\"/\\\\\\\"}\"\n  done\n}\n\n# Check only the ACTIVE tab of each window, in one osascript that both detects\n# and redirects. No shell round-trip and no yt-dlp: this is what removes the\n# visible frame of the real page. The target keeps its handle so the reward\n# reopens the right creator.\nFastPassActiveTabs() {\n  local now clauses script b hasTarget=0\n  clauses=\"$(BuildFastClauses)\"\n  [[ -n \"$clauses\" ]] || return 0\n  now=\"$(NowEpoch)\"\n\n  script=\"global blockUrl, nowStr\"$'\\n'\n  script+=\"set blockUrl to \\\"$BLOCK_PAGE_URL\\\"\"$'\\n'\n  script+=\"set nowStr to \\\"$now\\\"\"$'\\n'\n  script+='on stripQuery(u)'$'\\n'\n  script+='  if u contains \"?\" then set u to text 1 thru ((offset of \"?\" in u) - 1) of u'$'\\n'\n  script+='  if u contains \"#\" then set u to text 1 thru ((offset of \"#\" in u) - 1) of u'$'\\n'\n  script+='  return u'$'\\n'\n  script+='end stripQuery'$'\\n'\n  script+='on gateFor(u)'$'\\n'\n  script+='  return blockUrl & \"?u=\" & my stripQuery(u) & \"&t=\" & nowStr'$'\\n'\n  script+='end gateFor'$'\\n'\n\n  for b in \"${CHROMIUM_BROWSERS[@]}\"; do\n    pgrep -x \"$b\" >/dev/null 2>&1 || continue\n    hasTarget=1\n    script+='using terms from application \"Google Chrome\"'$'\\n'\n    script+='  tell application \"'\"$b\"'\"'$'\\n'\n    script+='    try'$'\\n'\n    script+='      repeat with W in windows'$'\\n'\n    script+='        try'$'\\n'\n    script+='          set theTab to active tab of W'$'\\n'\n    script+='          set u to (URL of theTab as text)'$'\\n'\n    script+='          if not (u starts with blockUrl) then'$'\\n'\n    script+='            set doBlock to false'$'\\n'\n    script+='            ignoring case'$'\\n'\n    script+=\"$clauses\"\n    script+='            end ignoring'$'\\n'\n    script+='            if doBlock then set URL of theTab to my gateFor(u)'$'\\n'\n    script+='          end if'$'\\n'\n    script+='        end try'$'\\n'\n    script+='      end repeat'$'\\n'\n    script+='    end try'$'\\n'\n    script+='  end tell'$'\\n'\n    script+='end using terms from'$'\\n'\n  done\n\n  if pgrep -x \"Safari\" >/dev/null 2>&1; then\n    hasTarget=1\n    script+='tell application \"Safari\"'$'\\n'\n    script+='  try'$'\\n'\n    script+='    repeat with W in windows'$'\\n'\n    script+='      try'$'\\n'\n    script+='        set theTab to current tab of W'$'\\n'\n    script+='        set u to (URL of theTab as text)'$'\\n'\n    script+='        if not (u starts with blockUrl) then'$'\\n'\n    script+='          set doBlock to false'$'\\n'\n    script+='          ignoring case'$'\\n'\n    script+=\"$clauses\"\n    script+='          end ignoring'$'\\n'\n    script+='          if doBlock then set URL of theTab to my gateFor(u)'$'\\n'\n    script+='        end if'$'\\n'\n    script+='      end try'$'\\n'\n    script+='    end repeat'$'\\n'\n    script+='  end try'$'\\n'\n    script+='end tell'$'\\n'\n  fi\n\n  (( hasTarget )) || return 0\n  print -r -- \"$script\" | osascript - >/dev/null 2>&1 || true\n}\n\n\n# --- 11. Watch loop --------------------------------------------------------\n\n# Single pass (also used by the root layer, which cleans hosts/policy).\nEnforce() {\n  EnsureSecret\n  ShouldBlock && EnforceTabs\n  RemoveHostsBlock\n  RemoveChromePolicy\n}\n\n# The background service. Adaptive:\n#  - browser frontmost -> fast pass every FAST_SLEEP, deep pass every DEEP_EVERY;\n#  - browser in the background -> just a deep pass every second (no frame to\n#    hide, so no need to burn CPU polling);\n#  - out of the active window -> idle a minute.\nWatchTabs() {\n  EnsureSecret\n  local i=0\n  while true; do\n    if ! ShouldBlock; then sleep 60; continue; fi\n    # A hiccup in one pass must never kill the loop (KeepAlive would just\n    # restart it in a churn); swallow non-zero and keep going.\n    if BrowserIsFrontmost; then\n      FastPassActiveTabs || true\n      if (( i % DEEP_EVERY == 0 )); then EnforceTabs || true; fi\n      i=$(( (i + 1) % 1000000 ))\n      sleep \"$FAST_SLEEP\"\n    else\n      EnforceTabs || true\n      i=0\n      sleep 1\n    fi\n  done\n}\n\n\n# --- 12. Install -----------------------------------------------------------\n\nWriteUserPlist() {\n  mkdir -p \"$HOME/Library/LaunchAgents\" \"$HOME/Library/Logs\"\n  cat > \"$USER_PLIST\" <<PLIST\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n  <key>Label</key><string>$USER_LABEL</string>\n  <key>ProgramArguments</key>\n  <array><string>$SCRIPT_PATH</string><string>watch-tabs</string></array>\n  <key>RunAtLoad</key><true/>\n  <key>KeepAlive</key><true/>\n  <key>StandardOutPath</key><string>$USER_LOG</string>\n  <key>StandardErrorPath</key><string>$USER_ERR_LOG</string>\n</dict>\n</plist>\nPLIST\n  plutil -lint \"$USER_PLIST\" >/dev/null\n}\n\nInstallUser() {\n  EnsureSecret\n  WriteUserPlist\n  chmod 644 \"$USER_PLIST\" 2>/dev/null || true\n  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n  # macOS keeps a per-LABEL \"disabled\" flag, separate from our own\n  # DISABLED_FILE: if this guard was ever stopped, that bit sticks and makes\n  # the load fail (I/O error) until we explicitly clear it here.\n  launchctl enable \"gui/$(id -u)/$USER_LABEL\" >/dev/null 2>&1 || true\n  launchctl bootstrap \"gui/$(id -u)\" \"$USER_PLIST\"\n  Say \"User tab guard installed.\"\n}\n\nUninstallUser() {\n  RequireGuardPassword\n  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n  rm -f \"$USER_PLIST\"\n  Say \"User tab guard uninstalled.\"\n}\n\n# Optional root layer: /etc/hosts + Chrome policy (with IncognitoModeAvailability=1,\n# which forces normal windows, so the watcher can see them).\n\nFlushDns() { dscacheutil -flushcache 2>/dev/null || true; killall -HUP mDNSResponder 2>/dev/null || true; }\n\nStripHostsBlock() {\n  awk -v s=\"$HOSTS_MARK_START\" -v e=\"$HOSTS_MARK_END\" \\\n    '$0==s{skip=1;next} $0==e{skip=0;next} skip!=1{print}' \"$1\"\n}\n\nApplyHostsBlock() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  local tmp; tmp=\"$(mktemp)\"\n  StripHostsBlock \"$HOSTS_FILE\" > \"$tmp\"\n  { cat \"$tmp\"; printf '\\n%s\\n' \"$HOSTS_MARK_START\"\n    local d; for d in \"${HOST_DOMAINS[@]}\"; do printf '0.0.0.0\\t%s\\n::1\\t%s\\n' \"$d\" \"$d\"; done\n    printf '%s\\n' \"$HOSTS_MARK_END\"; } > \"$tmp.new\"\n  cp \"$tmp.new\" \"$HOSTS_FILE\"; rm -f \"$tmp\" \"$tmp.new\"; FlushDns\n}\n\nRemoveHostsBlock() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  local tmp; tmp=\"$(mktemp)\"\n  StripHostsBlock \"$HOSTS_FILE\" > \"$tmp\"; cp \"$tmp\" \"$HOSTS_FILE\"; rm -f \"$tmp\"; FlushDns\n}\n\n# URL-shaped entries -> Chrome URLBlocklist entries (also covers incognito).\nBuildChromeBlocklist() {\n  CHROME_BLOCKLIST=(); local p\n  for p in \"${BLOCKED_PATTERNS[@]}\"; do [[ \"$p\" == *\"/\"* ]] && CHROME_BLOCKLIST+=(\"$p\"); done\n}\n\nApplyChromePolicy() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  local tmp entry; BuildChromeBlocklist\n  mkdir -p \"/Library/Managed Preferences\"\n  if [[ ! -f \"$CHROME_POLICY_MARKER\" ]]; then\n    if [[ -f \"$CHROME_POLICY_FILE\" ]]; then cp \"$CHROME_POLICY_FILE\" \"$CHROME_POLICY_BACKUP\"; printf 'existed\\n' > \"$CHROME_POLICY_MARKER\"\n    else printf 'absent\\n' > \"$CHROME_POLICY_MARKER\"; fi\n  fi\n  tmp=\"$(mktemp)\"\n  cat > \"$tmp\" <<'PLIST'\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n  <key>IncognitoModeAvailability</key><integer>1</integer>\n  <key>URLBlocklist</key>\n  <array>\nPLIST\n  for entry in \"${CHROME_BLOCKLIST[@]}\"; do printf '    <string>%s</string>\\n' \"$entry\" >> \"$tmp\"; done\n  printf '  </array>\\n</dict>\\n</plist>\\n' >> \"$tmp\"\n  plutil -lint \"$tmp\" >/dev/null\n  cp \"$tmp\" \"$CHROME_POLICY_FILE\"; rm -f \"$tmp\"\n  chown root:wheel \"$CHROME_POLICY_FILE\"; chmod 644 \"$CHROME_POLICY_FILE\"\n  plutil -lint \"$CHROME_POLICY_FILE\" >/dev/null\n}\n\nRemoveChromePolicy() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  [[ -f \"$CHROME_POLICY_MARKER\" ]] || return 0\n  local state; state=\"$(cat \"$CHROME_POLICY_MARKER\" 2>/dev/null || printf 'absent')\"\n  if [[ \"$state\" == \"existed\" && -f \"$CHROME_POLICY_BACKUP\" ]]; then cp \"$CHROME_POLICY_BACKUP\" \"$CHROME_POLICY_FILE\"\n  else rm -f \"$CHROME_POLICY_FILE\"; fi\n}\n\nWriteRootPlist() {\n  [[ \"$EUID\" -eq 0 ]] || { Say \"Root install needs admin rights.\"; exit 1; }\n  cat > \"$ROOT_PLIST\" <<PLIST\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n  <key>Label</key><string>$ROOT_LABEL</string>\n  <key>ProgramArguments</key>\n  <array><string>$SCRIPT_PATH</string><string>enforce</string></array>\n  <key>RunAtLoad</key><true/>\n  <key>StartInterval</key><integer>60</integer>\n  <key>StandardOutPath</key><string>/var/log/SocialMediaGuard.log</string>\n  <key>StandardErrorPath</key><string>/var/log/SocialMediaGuard.err.log</string>\n</dict>\n</plist>\nPLIST\n  chown root:wheel \"$ROOT_PLIST\"; chmod 644 \"$ROOT_PLIST\"; plutil -lint \"$ROOT_PLIST\" >/dev/null\n}\n\nInstallRoot() { EnsureSecret; CleanupRoot; }\n\nCleanupRoot() {\n  [[ \"$EUID\" -eq 0 ]] || { Say \"Root cleanup needs admin rights.\"; exit 1; }\n  RemoveHostsBlock; RemoveChromePolicy\n  launchctl bootout system \"$ROOT_PLIST\" >/dev/null 2>&1 || true\n  rm -f \"$ROOT_PLIST\"\n  Say \"Root network guard removed. UI guard is active through the user agent.\"\n}\n\nUninstallRoot() {\n  RequireGuardPassword\n  [[ \"$EUID\" -eq 0 ]] || { Say \"Root uninstall needs admin rights.\"; exit 1; }\n  RemoveHostsBlock; RemoveChromePolicy\n  launchctl bootout system \"$ROOT_PLIST\" >/dev/null 2>&1 || true\n  rm -f \"$ROOT_PLIST\"\n  Say \"Root host guard uninstalled.\"\n}\n\n\n# --- 13. Commands ----------------------------------------------------------\n\nSuspend() {\n  RequireGuardPassword\n  local minutes=\"${1:-30}\"\n  [[ \"$minutes\" =~ '^[0-9]+$' ]] || { Say \"Minutes must be a number.\"; exit 1; }\n  EnsureDirs\n  printf '%s\\n' \"$(( $(NowEpoch) + minutes * 60 ))\" > \"$SUSPEND_FILE\"\n  Enforce\n  Say \"Guard suspended for $minutes minutes.\"\n}\n\nDisable() {\n  RequireGuardPassword\n  EnsureDirs\n  date '+%Y-%m-%d %H:%M:%S' > \"$DISABLED_FILE\"\n  Enforce\n  Say \"Guard disabled.\"\n}\n\nEnable() {\n  EnsureDirs\n  rm -f \"$DISABLED_FILE\" \"$SUSPEND_FILE\"\n  Enforce\n  Say \"Guard enabled.\"\n}\n\nStatus() {\n  local userLoaded=\"no\" rootLoaded=\"no\" chromePolicy=\"no\"\n  launchctl print \"gui/$(id -u)/$USER_LABEL\" >/dev/null 2>&1 && userLoaded=\"yes\"\n  launchctl print \"system/$ROOT_LABEL\"        >/dev/null 2>&1 && rootLoaded=\"yes\"\n  [[ -f \"$CHROME_POLICY_FILE\" ]] && /usr/libexec/PlistBuddy -c \"Print :URLBlocklist\" \"$CHROME_POLICY_FILE\" >/dev/null 2>&1 && chromePolicy=\"yes\"\n\n  Say \"protected_hours=$(IsProtectedNow && printf yes || printf no)\"\n  Say \"disabled=$(IsDisabled && printf yes || printf no)\"\n  Say \"suspended=$(IsSuspended && printf yes || printf no)\"\n  Say \"user_tab_guard_loaded=$userLoaded\"\n  Say \"root_host_guard_loaded=$rootLoaded\"\n  Say \"hosts_block_present=$(grep -q \"$HOSTS_MARK_START\" \"$HOSTS_FILE\" 2>/dev/null && printf yes || printf no)\"\n  Say \"chrome_policy_present=$chromePolicy\"\n  Say \"block_page_present=$([[ -f \"$BLOCK_PAGE_FILE\" ]] && printf yes || printf no)\"\n  Say \"secret_present=$([[ -f \"$SECRET_FILE\" ]] && printf yes || printf no)\"\n  Say \"blocked_patterns=${#BLOCKED_PATTERNS[@]}\"\n  Say \"fast_patterns=${#FAST_PATTERNS[@]}\"\n}\n\n\n# --- 14. Entry point -------------------------------------------------------\n\ncase \"${1:-status}\" in\n  install-user)   InstallUser ;;\n  install-root)   InstallRoot ;;\n  enforce)        Enforce ;;\n  watch-tabs)     WatchTabs ;;\n  close-tabs)     EnsureBlockPage; EnforceTabs ;;\n  suspend)        Suspend \"${2:-30}\" ;;\n  disable)        Disable ;;\n  enable)         Enable ;;\n  status)         Status ;;\n  uninstall-user) UninstallUser ;;\n  uninstall-root) UninstallRoot ;;\n  cleanup-root)   CleanupRoot ;;\n  *)\n    Say \"Usage: $0 install-user|status|enable|disable|suspend [min]|enforce|watch-tabs|close-tabs|uninstall-user|install-root|uninstall-root|cleanup-root\"\n    exit 1 ;;\nesac\n","numLines":958,"startLine":1,"totalLines":958}},"sourceToolAssistantUUID":"ab68e704-7609-45d7-bd36-d42e4e5c0ff2","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"912f7b28-ed91-490c-95c5-f9e53de3a2a6","version":"2.1.221","gitBranch":"main"}
