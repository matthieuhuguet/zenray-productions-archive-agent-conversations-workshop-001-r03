ANT_MINUTES[used+1]}\"\n  else\n    printf '0\\n'\n  fi\n}\n\nYouTubeAccessGranted() {\n  EnsureYouTubeDayState\n  local until; until=\"$(cat \"$YT_UNTIL_FILE\" 2>/dev/null || printf '0')\"\n  [[ \"$until\" =~ ^[0-9]+$ ]] || return 1\n  [[ \"$(NowEpoch)\" -lt \"$until\" ]]\n}\n\n# Should the daytime YouTube gate fire right now?\nShouldBlockYouTubeDay() {\n  IsDisabled  && return 1\n  IsSuspended && return 1\n  EnsureYouTubeDayState\n  IsYouTubeDayWindow || return 1\n  YouTubeAccessGranted && return 1\n  return 0\n}\n\n# Consumes the next rung of the ladder and opens access for that many\n# minutes. Returns non-zero if the ladder is already spent for today.\nGrantYouTubeTime() {\n  EnsureYouTubeDayState\n  local minutes; minutes=\"$(NextYouTubeGrantMinutes)\"\n  [[ \"$minutes\" -gt 0 ]] || return 1\n  local used; used=\"$(YouTubeGrantsUsedToday)\"\n  printf '%s\\n' \"$(( used + 1 ))\" > \"$YT_GRANTS_USED_FILE\"\n  printf '%s\\n' \"$(( $(NowEpoch) + minutes * 60 ))\" > \"$YT_UNTIL_FILE\"\n  return 0\n}\n\nYouTubeGateUrlFor() {\n  printf '%s?u=%s&remaining=%s' \"$YT_BLOCK_PAGE_URL\" \"$(UrlEncode \"$1\")\" \"$(NextYouTubeGrantMinutes)\"\n}\n\n# The block page. Same visual language as the creator block page. The button\n# label and remaining minutes come from the \"remaining\" query param so the\n# page never needs regenerating between grants.\nEnsureYouTubeDayBlockPage() {\n  EnsureDirs\n  local F=\"/Users/zenray/Library/Fonts\"\n  cat > \"$YT_BLOCK_PAGE_FILE\" <<HTML\n<!doctype html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>YouTube bloqué</title>\n<style>\n  @font-face { font-family:\"AnthropicSans\"; src:url(\"file://$F/AnthropicSans-Light.ttf\") format(\"truetype\"); font-weight:300 }\n  @font-face { font-family:\"AnthropicSans\"; src:url(\"file://$F/AnthropicSans-Medium.ttf\") format(\"truetype\"); font-weight:500 }\n  @font-face { font-family:\"AnthropicSerif\"; src:url(