PT' >/dev/null 2>&1 || true\non run argv\n  set w to (item 1 of argv) as integer\n  set t to (item 2 of argv) as integer\n  tell application \"Google Chrome\" to set URL of tab t of window w to (item 3 of argv)\nend run\nAPPLESCRIPT\n}\n\n# ------------------------------------------------------------- 6. The loop\n\nEnforce() {\n  local -a lines fields\n  lines=(\"${(@f)$(ListTabs)}\")\n  local line window tab tabId url target\n\n  # Expired grant: forget everything, tabs get blocked again below.\n  [[ -s \"$GRANT_FILE\" ]] && ! GrantActive && EndGrant\n\n  # A click anywhere starts the grant, before any tab is handled.\n  if ! GrantActive; then\n    for line in $lines; do\n      IsUnlockClick \"${line##*$'\\t'}\" && { StartGrant; break }\n    done\n  fi\n\n  for line in $lines; do\n    [[ -n \"$line\" ]] || continue\n    fields=(\"${(@ps:\\t:)line}\")\n    (( ${#fields} == 4 )) || continue\n    window=$fields[1]; tab=$fields[2]; tabId=$fields[3]; url=$fields[4]\n\n    if IsBlockPage \"$url\"; then\n      # Grant is running: send every blocked tab back where it wanted to go.\n      GrantActive || continue\n      target=\"$(RecallTab \"$tabId\")\"\n      [[ -n \"$target\" ]] || target=\"https://www.youtube.com/\"\n      ForgetTab \"$tabId\"\n      SetTabURL \"$window\" \"$tab\" \"$target\"\n      continue\n    fi\n\n    IsYouTube \"$url\" || continue\n    IsAlwaysFree \"$url\" && continue\n    GrantActive && continue\n\n    RememberTab \"$tabId\" \"$url\"\n    SetTabURL \"$window\" \"$tab\" \"$BLOCK_PAGE_URL\"\n  done\n}\n\n# ---------------------------------------------- 7. Install / uninstall / status\n\nCompileTimer() {\n  command -v swiftc >/dev/null 2>&1 || { Say \"swiftc introuvable.\"; return 1 }\n  swiftc -O \"$TIMER_SOURCE\" -o \"$TIMER_BIN\"\n  chmod 700 \"$TIMER_BIN\"\n}\n\nInstallUser() {\n  EnsureState\n  WriteBlockPage\n  EndGrant\n  # Leftovers from the old per-channel version.\n  rm -f \"$STATE_DIR\"/channel_v2_*.txt(N) \"$STATE_DIR\"/grant_channel(N) \"$STATE_DIR\"/grant_url(N)\n  rm -rf \"$STATE_DIR/youtube-identity-cache\"\n  CompileTimer || return 1\n  mkdir -p \"$HOME/Library/LaunchAgents\" \"$HOME/Library/Logs\"\n  cat > \"$USER_PLIST\" <<PLIST\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0\" encoding=\"UTF-8\"?>\n<plist version=\"1.0\"><dict>\n  <key>Label</key><string>$USER_LABEL</string>\n  <key>ProgramArguments</key><array><string>$SCRIPT_PATH</string><string>watch-tabs</string></array>\n  <key>RunAtLoad</key><true/>\n  <key>KeepAlive</key><true/>\n  <key>StandardOutPath</key><string>$HOME/Library/Logs/SocialMediaGuard.tabs.log</string>\n  <key>StandardErrorPath</key><string>$HOME/Library/Logs/SocialMediaGuard.tabs.err.log</string>\n</dict></plist>\nPLIST\n  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n  launchctl bootstrap \"gui/$(id -u)\" \"$USER_PLIST\"\n  Say \"YouTube Guard installé : un clic ouvre YouTube $GRANT_MINUTES minutes.\"\n  Say \"Toujours libres : abonnements, Ici Japon, Ici Japon Corp.\"\n}\n\nUninstallUser() {\n  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n  EndGrant\n  rm -f \"$USER_PLIST\"\n  Say \"YouTube Guard désinstallé.\"\n}\n\nStatus() {\n  local loaded=no left=0\n  launchctl print \"gui/$(id -u)/$USER_LABEL\" >/dev/null 2>&1 && loaded=yes\n  GrantActive && left=$(( ( $(cat \"$GRANT_FILE\") - $(Now) + 59 ) / 60 ))\n  Say \"guard_loaded=$loaded\"\n  Say \"grant_minutes=$GRANT_MINUTES\"\n  Say \"grant_active=$(GrantActive && printf yes || printf no)\"\n  Say \"minutes_left=$left\"\n  Say \"timer_binary=$([[ -x \"$TIMER_BIN\" ]] && printf yes || printf no)\"\n}\n\ncase \"${1:-status}\" in\n  install-user) InstallUser ;;\n  uninstall-user) UninstallUser ;;\n  watch-tabs) EnsureState; while true; do Enforce; sleep 1; done ;;\n  enforce) EnsureState; WriteBlockPage; Enforce ;;\n  open) StartGrant; Say \"YouTube ouvert $GRANT_MINUTES minutes.\" ;;\n  close) EndGrant; Say \"YouTube refermé.\" ;;\n  status) Status ;;\n  *) Say \"Usage: $0 {install-user|uninstall-user|watch-tabs|enforce|open|close|status}\"; exit 1 ;;\nesac\n","structuredPatch":[{"oldStart":1,"oldLines":184,"newStart":1,"newLines":111,"lines":[" #!/bin/zsh","+#","+# YouTube Guard","+#","+# Rule: YouTube is blocked. One click grants 15 minutes on the whole site.","+# Always free, no click needed: /feed/subscriptions, @IciJapon, @IciJaponCorp.","+#","+# 1. Settings","+# 2. Reading a URL","+# 3. The 15 minute grant","+# 4. The block page","+# 5. Talking to Chrome","+# 6. The loop","+# 7. Install / uninstall / status","+#","+"," set -u","-export PATH=\"/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin\"","+export PATH=\"/usr/bin:/bin:/usr/sbin:/sbin\""," ","+# ---------------------------------------------------------------- 1. Settings","+","+GRANT_MINUTES=15","+"," MEMORY_ROOT=\"${MEMORY_ROOT:-/Users/zenray/Create/Build/Memory}\""," FOCUS_DIR=\"$MEMORY_ROOT/Focus\""," STATE_DIR=\"$FOCUS_DIR/.SocialMediaGuardState\"","+TABS_DIR=\"$STATE_DIR/tabs\"","+GRANT_FILE=\"$STATE_DIR/grant_until\"","+"," BLOCK_PAGE_FILE=\"$FOCUS_DIR/SocialMediaBlocked.html\""," BLOCK_PAGE_URL=\"file://$BLOCK_PAGE_FILE\"","-GRANT_UNTIL_FILE=\"$STATE_DIR/grant_until\"","-GRANT_CHANNEL_FILE=\"$STATE_DIR/grant_channel\"","-GRANT_URL_FILE=\"$STATE_DIR/grant_url\"","+"," TIMER_SOURCE=\"$MEMORY_ROOT/Tools/FocusGuard/SocialMediaGuardTimer.swift\""," TIMER_BIN=\"$STATE_DIR/SocialMediaGuardTimer\"","+","+SCRIPT_PATH=\"$MEMORY_ROOT/Tools/FocusGuard/SocialMediaGuard.sh\""," USER_LABEL=\"com.zenray.social-media-guard.tabs\""," USER_PLIST=\"$HOME/Library/LaunchAgents/$USER_LABEL.plist\"","-SCRIPT_PATH=\"$MEMORY_ROOT/Tools/FocusGuard/SocialMediaGuard.sh\""," ","-CHROMIUM_BROWSERS=(\"Google Chrome\")","-ICI_JAPON_IDS=(","-  \"ucegev5mbdmgmgzfpralemfa\"","-  \"uc_r99mjdkzksbgeedoylbkw\"","-)","-"," Say() { printf '%s\\n' \"$*\"; }"," Now() { date '+%s'; }"," "," EnsureState() {","-  mkdir -p \"$FOCUS_DIR\" \"$STATE_DIR\""