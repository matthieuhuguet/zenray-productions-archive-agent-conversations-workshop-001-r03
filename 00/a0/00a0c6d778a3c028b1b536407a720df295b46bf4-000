thon3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=\"\"))' \"$1\"\n}\n\nUrlDecode() {\n  python3 -c 'import sys, urllib.parse; print(urllib.parse.unquote(sys.argv[1]))' \"$1\"\n}\n\nParam() {\n  local url=\"$1\" name=\"$2\" pair\n  local query=\"${url#*\\?}\"\n  [[ \"$query\" != \"$url\" ]] || return 0\n  for pair in ${(s:&:)query}; do\n    [[ \"$pair\" == \"$name=\"* ]] && { UrlDecode \"${pair#$name=}\"; return 0; }\n  done\n}\n\nUrlPath() {\n  local path=\"${1%%\\?*}\"\n  path=\"${path%%\\#*}\"\n  printf '%s' \"${path:l}\"\n}\n\nIsYouTubeURL() {\n  case \"${1:l}\" in\n    https://youtube.com|https://youtube.com/*|https://www.youtube.com|https://www.youtube.com/*|https://m.youtube.com|https://m.youtube.com/*|https://music.youtube.com|https://music.youtube.com/*|https://youtu.be|https://youtu.be/*) return 0 ;;\n    *) return 1 ;;\n  esac\n}\n\nIsFeedURL() {\n  local path; path=\"$(UrlPath \"$1\")\"\n  [[ \"$path\" == */feed/subscriptions || \"$path\" == */feed/subscriptions/* ]]\n}\n\nIsAllowedChannelURL() {\n  local path; path=\"$(UrlPath \"$1\")\"\n  case \"$path\" in\n    */@icijapon|*/@icijapon/*|*/@icijaponcorp|*/@icijaponcorp/*) return 0 ;;\n  esac\n  [[ \"$path\" == */channel/ucegev5mbdmgmgzfpralemfa ||\n     \"$path\" == */channel/ucegev5mbdmgmgzfpralemfa/* ||\n     \"$path\" == */channel/uc_r99mjdkzksbgeedoylbkw ||\n     \"$path\" == */channel/uc_r99mjdkzksbgeedoylbkw/* ]]\n}\n\nIsVideoURL() {\n  local path; path=\"$(UrlPath \"$1\")\"\n  case \"$path\" in\n    */watch|*/shorts/*|*/live/*|*/embed/*|https://youtu.be/*) return 0 ;;\n    *) return 1 ;;\n  esac\n}\n\nYT_DLP_TIMEOUT_SECONDS=5\n\nRunYtDlpChannelId() {\n  local url=\"$1\" tmp pid watcher\n  tmp=\"$(mktemp \"${TMPDIR:-/tmp}/smg_ytdlp.XXXXXX\")\"\n  yt-dlp --print '%(channel_id)s' --skip-download --no-playlist \\\n    --no-warnings --socket-timeout 4 --extractor-retries 1 --retries 1 \\\n    \"$url\" > \"$tmp\" 2>/dev/null &\n  pid=$!\n  ( sleep \"$YT_DLP_TIMEOUT_SECONDS\"