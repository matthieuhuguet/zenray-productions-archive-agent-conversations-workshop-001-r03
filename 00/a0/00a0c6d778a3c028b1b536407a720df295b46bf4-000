tube.com*|https://m.youtube.com*) return 0 ;;\n    https://music.youtube.com*|https://youtu.be*) return 0 ;;\n    *) return 1 ;;\n  esac\n}\n\n# Pages that never need a grant.\nIsAlwaysFree() {\n  local path; path=\"$(UrlPath \"$1\")\"\n  case \"$path\" in\n    */feed/subscriptions|*/feed/subscriptions/*) return 0 ;;\n    */@icijapon|*/@icijapon/*|*/@icijaponcorp|*/@icijaponcorp/*) return 0 ;;\n    */channel/ucegev5mbdmgmgzfpralemfa|*/channel/ucegev5mbdmgmgzfpralemfa/*) return 0 ;;\n    */channel/uc_r99mjdkzksbgeedoylbkw|*/channel/uc_r99mjdkzksbgeedoylbkw/*) return 0 ;;\n    *) return 1 ;;\n  esac\n}\n\nIsBlockPage() { [[ \"$1\" == \"$BLOCK_PAGE_URL\"* ]] }\nIsUnlockClick() { [[ \"$1\" == \"$BLOCK_PAGE_URL\"*\"unlock=1\"* ]] }\n\n# ------------------------------------------------------- 3. The 15 minute grant\n\nGrantActive() {\n  local until\n  [[ -s \"$GRANT_FILE\" ]] || return 1\n  until=\"$(cat \"$GRANT_FILE\" 2>/dev/null || printf '0')\"\n  [[ \"$until\" =~ '^[0-9]+$' ]] || return 1\n  (( $(Now) < until ))\n}\n\nStartGrant() {\n  EnsureState\n  printf '%s\\n' $(( $(Now) + GRANT_MINUTES * 60 )) > \"$GRANT_FILE\"\n  pkill -x SocialMediaGuardTimer >/dev/null 2>&1 || true\n  [[ -x \"$TIMER_BIN\" ]] && nohup \"$TIMER_BIN\" \"$GRANT_FILE\" >/dev/null 2>&1 </dev/null &\n}\n\nEndGrant() {\n  pkill -x SocialMediaGuardTimer >/dev/null 2>&1 || true\n  rm -f \"$GRANT_FILE\"\n  rm -f \"$TABS_DIR\"/*(N)\n}\n\n# Each blocked tab remembers where it was going, keyed by its Chrome tab id.\nRememberTab() { printf '%s\\n' \"$2\" > \"$TABS_DIR/$1\" }\nRecallTab() { cat \"$TABS_DIR/$1\" 2>/dev/null }\nForgetTab() { rm -f \"$TABS_DIR/$1\" }\n\n# --------------------------------------------------------- 4. The block page\n\nWriteBlockPage() {\n  cat > \"$BLOCK_PAGE_FILE\" <<'HTML'\n<!doctype html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>YouTube bloqué</title>\n<style>\n  :root { color-scheme: dark }\n  * { box-sizing: border-box }\n  body { margin: 0; min-height: 100vh; display: grid; place-items: center;\n         background: #202020; color: #f3f3f3; font: 300 18px system-ui, sans-serif }\n  main { width: min(620px, calc(100vw - 40px)); padding: 56px 40px; text-align: center;\n         border-radius: 18px; background: #292929; box-shadow: 0 24px 80px #0005 }\n  h1 { margin: 0; font: 300 clamp(32px, 6vw, 58px)/1.08 Georgia, serif }\n  p { color: #aaa; line-height: 1.5 }\n  a { display: inline-block; margin-top: 18px; padding: 14px 28px; border-radius: 999px;\n      background: #f3f3f3; color: #202020; text-decoration: none; font-weight: 600 }\n  a:active { background: #c9c9c9 }\n</style>\n</head>\n<body>\n<main>\n  <h1>YouTube est bloqué.</h1>\n  <p>Un clic ouvre YouTube en entier pendant 15 minutes.</p>\n  <a href=\"?unlock=1\">Ouvrir pendant 15 minutes</a>\n</main>\n</body>\n</html>\nHTML\n  chmod 644 \"$BLOCK_PAGE_FILE\"\n}\n\n# ------------------------------------------------------- 5. Talking to Chrome\n\n# One line per tab: window index, tab index, tab id, URL.\nListTabs() {\n  pgrep -x \"Google Chrome\" >/dev/null 2>&1 || return 0\n  osascript <<'APPLESCRIPT' 2>/dev/null || true\nset output to \"\"\nset sep to ASCII character 9\ntell application \"Google Chrome\"\n  repeat with w from 1 to (count of windows)\n    repeat with t from 1 to (count of tabs of window w)\n      try\n        set theTab to tab t of window w\n        set output to output & w & sep & t & sep & (id of theTab) & sep & (URL of theTab as text) & linefeed\n      end try\n    end repeat\n  end repeat\nend tell\nreturn output\nAPPLESCRIPT\n}\n\nSetTabURL() {\n  osascript - \"$1\" \"$2\" \"$3\" <<'APPLESCRIPT' >/dev/null 2>&1 || true\non run argv\n  set w to (item 1 of argv) as integer\n  set t to (item 2 of argv) as integer\n  tell application \"Google Chrome\" to set URL of tab t of window w to (item 3 of argv)\nend run\nAPPLESCRIPT\n}\n\n# ------------------------------------------------------------- 6. The loop\n\nEnforce() {\n  local -a lines fields\n  lines=(\"${(@f)$(ListTabs)}\")\n  local line window tab tabId url target\n\n  # Expired grant: forget everything, tabs get blocked again below.\n  [[ -s \"$GRANT_FILE\" ]] && ! GrantActive && EndGrant\n\n  # A click anywhere starts the grant, before any tab is handled.\n  if ! GrantActive; then\n    for line in $lines; do\n      IsUnlockClick \"${line##*$'\\t'}\" && { StartGrant; break }\n    done\n  fi\n\n  for line in $lines; do\n    [[ -n \"$line\" ]] || continue\n    fields=(\"${(@ps:\\t:)line}\")\n    (( ${#fields} == 4 )) || continue\n    window=$fields[1]; tab=$fields[2]; tabId=$fields[3]; url=$fields[4]\n\n    if IsBlockPage \"$url\"; then\n      # Grant is running: send every blocked tab back where it wanted to go.\n      GrantActive || continue\n      target=\"$(RecallTab \"$tabId\")\"\n      [[ -n \"$target\" ]] || target=\"https://www.youtube.com/\"\n      ForgetTab \"$tabId\"\n      SetTabURL \"$window\" \"$tab\" \"$target\"\n      continue\n    fi\n\n    IsYouTube \"$url\" || continue\n    IsAlwaysFree \"$url\" && continue\n    GrantActive && continue\n\n    RememberTab \"$tabId\" \"$url\"\n    SetTabURL \"$window\" \"$tab\" \"$BLOCK_PAGE_URL\"\n  done\n}\n\n# ---------------------------------------------- 7. Install / uninstall / status\n\nCompileTimer() {\n  command -v swiftc >/dev/null 2>&1 || { Say \"swiftc introuvable.\"; return 1 }\n  swiftc -O \"$TIMER_SOURCE\" -o \"$TIMER_BIN\"\n  chmod 700 \"$TIMER_BIN\"\n}\n\nInstallUser() {\n  EnsureState\n  WriteBlockPage\n  EndGrant\n  # Leftovers from the old per-channel version.\n  rm -f \"$STATE_DIR\"/channel_v2_*.txt(N) \"$STATE_DIR\"/grant_channel(N) \"$STATE_DIR\"/grant_url(N)\n  rm -rf \"$STATE_DIR/youtube-identity-cache\"\n  CompileTimer || return 1\n  mkdir -p \"$HOME/Library/LaunchAgents\" \"$HOME/Library/Logs\"\n  cat > \"$USER_PLIST\" <<PLIST\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0\" encoding=\"UTF-8\"?>\n<plist version=\"1.0\"><dict>\n  <key>Label</key><string>$USER_LABEL</string>\n  <key>ProgramArguments</key><array><string>$SCRIPT_PATH</string><string>watch-tabs</string></array>\n  <key>RunAtLoad</key><true/>\n  <key>KeepAlive</key><true/>\n  <key>StandardOutPath</key><string>$HOME/Library/Logs/SocialMediaGuard.tabs.log</string>\n  <key>StandardErrorPath</key><string>$HOME/Library/Logs/SocialMediaGuard.tabs.err.log</string>\n</dict></plist>\nPLIST\n  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n  launchctl bootstrap \"gui/$(id -u)\" \"$USER_PLIST\"\n  Say \"YouTube Guard installé : un clic ouvre YouTube $GRANT_MINUTES minutes.\"\n  Say \"Toujours libres : abonnements, Ici Japon, Ici Japon Corp.\"\n}\n\nUninstallUser() {\n  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n  EndGrant\n  rm -f \"$USER_PLIST\"\n  Say \"YouTube Guard désinstallé.\"\n}\n\nStatus() {\n  local loaded=no left=0\n  launchctl print \"gui/$(id -u)/$USER_LABEL\" >/dev/null 2>&1 && loaded=yes\n  GrantActive && left=$(( ( $(cat \"$GRANT_FILE\") - $(Now) + 59 ) / 60 ))\n  Say \"guard_loaded=$loaded\"\n  Say \"grant_minutes=$GRANT_MINUTES\"\n  Say \"grant_active=$(GrantActive && printf yes || printf no)\"\n  Say \"minutes_left=$left\"\n  Say \"timer_binary=$([[ -x \"$TIMER_BIN\" ]] && printf yes || printf no)\"\n}\n\ncase \"${1:-status}\" in\n  install-user) InstallUser ;;\n  uninstall-user) UninstallUser ;;\n  watch-tabs) EnsureState; while true; do Enforce; sleep 1; done ;;\n  enforce) EnsureState; WriteBlockPage; Enforce ;;\n  open) StartGrant; Say \"YouTube ouvert $GRANT_MINUTES minutes.\" ;;\n  close) EndGrant; Say \"YouTube refermé.\" ;;\n  status) Status ;;\n  *) Say \"Usage: $0 {install-user|uninstall-user|watch-tabs|enforce|open|close|status}\"; exit 1 ;;\nesac\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cach