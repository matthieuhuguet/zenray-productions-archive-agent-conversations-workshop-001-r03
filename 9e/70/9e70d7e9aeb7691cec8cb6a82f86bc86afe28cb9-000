eption:\n        pass\n    return {\n        'model': model,\n        'perf_cores': int(pcores) if pcores else None,\n        'efficiency_cores': int(ecores) if ecores else None,\n        'logical_cores': int(lcores) if lcores else None,\n        'ram_total_gb': ram_gb,\n        'hw_encoders': hw_enc,\n        'detected_at': time.time(),\n    }\n\n\ndef load_or_refresh():\n    model_now = sysctl('hw.model')\n    if os.path.exists(CACHE):\n        try:\n            data = json.load(open(CACHE))\n            fresh = (time.time() - data.get('detected_at', 0)) < TTL_S\n            same_machine = data.get('model') == model_now\n            if fresh and same_machine:\n                return data\n        except Exception:\n            pass\n    data = detect_static()\n    os.makedirs(os.path.dirname(CACHE), exist_ok=True)\n    tmp = CACHE + '.tmp'\n    with open(tmp, 'w') as f:\n        json.dump(data, f)\n    os.replace(tmp, CACHE)  # ecriture atomique : jamais de cache corrompu a moitie ecrit\n    return data\n\n\ndef free_ram_gb():\n    out = subprocess.run(['vm_stat'], capture_output=True, text=True).stdout\n    page_size = 16384\n    pages = {}\n    for line in out.splitlines():\n        if ':' in line:\n            k, v = line.split(':', 1)\n            v = v.strip().rstrip('.')\n            if v.isdigit():\n                pages[k.strip()] = int(v)\n    free = pages.get('Pages free', 0) + pages.get('Pages speculative', 0) + pages.get('Pages inactive', 0)\n    return round(free * page_size / 1e9, 1)\n\n\ndef main():\n    static = load_or_refresh()\n    live_ram = free_ram_gb()\n\n    if '--json' in sys.argv:\n        print(json.dumps({**static, 'ram_free_gb_now': live_ram}))\n        return\n\n    enc = ', '.join(static['hw_encoders']) or 'aucun'\n    p, e, l = static['perf_cores'], static['efficiency_cores'], static['logical_cores']\n    cores_str = f\"{p}P+{e}E ({l} logiques)\" if p and e else f\"{l} logiques\"\n    print(f\"{static['model']} | {cores_str} | RAM {live_ram:.1f}/{static['ram_total_gb']} Go libre | \"\n          f\"HW encode: {enc}\")\n    print(f\"Parallelisme CPU-local/HW-encode recommande : {max(1, (l or 4) - 2)} (coeurs logiques - 2)\")\n\n    if live_ram < MIN_FREE_GB_ML:\n        print(f\"ATTENTION: {live_ram:.1f} Go libres < {MIN_FREE_GB_ML} Go. \"\n              f\"NE PAS lancer de job ML/torch lourd maintenant (risque de crash, deja vecu le 2026-07-11).\")\n    else:\n        print(f\"RAM OK pour un job ML/torch (seuil {MIN_FREE_GB_ML} Go) — un seul job ML a la fois, jamais en parallele d'un autre.\")\n\n\nif __name__ == '__main__':\n    main()\n","internal_chat_message_metadata_passthrough":{"turn_id":"019f96ca-5afc-7472-b8bf-86b5e38d92e4"}}}
