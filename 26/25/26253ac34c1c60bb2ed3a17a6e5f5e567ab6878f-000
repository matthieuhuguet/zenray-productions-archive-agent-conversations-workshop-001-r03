const customOk = !custom || effectiveAmount >= MIN_CUSTOM\n  const priceTooLow = effectiveAmount < MIN_CUSTOM\n  const canSubmit = name.trim() && emailOk && customOk && effectiveAmount >= MIN_CUSTOM && status !== 'sending'\n\n  const submit = async () => {\n    if (!canSubmit) { setErr(!name.trim() ? 'Your name?' : !emailOk ? 'A valid email?' : `At least $${MIN_CUSTOM}`); return }\n    setErr(''); setStatus('sending')\n    // Timeout dur (15s) : une fonction serverless qui stalle ne doit PAS laisser le bouton \"Sending…\" à l'infini.\n    const ctrl = new AbortController()\n    const timer = setTimeout(() => ctrl.abort(), 15000)\n    try {\n      const resp = await fetch('/api/prospect', {\n        method: 'POST', headers: { 'content-type': 'application/json' },\n        body: JSON.stringify({ name: name.trim(), email: email.trim(), amount: effectiveAmount, company }),\n        signal: ctrl.signal,\n      })\n      const r = await resp.json().catch(() => null)\n      if (r && r.ok) { setStatus('done'); try { track('prospect_submit', { amount: effectiveAmount, custom }) } catch { /* analytics best-effort : ne jamais casser la conversion */ } }\n      else { setStatus('error'); setErr((r && r.error) ? `Error: ${r.error}` : 'Something went wrong — try again.') }\n    } catch (e) {\n      setStatus('error')\n      setErr(e && e.name === 'AbortError' ? 'Timed out — try again.' : 'Network error — try again.')\n    } finally {\n      clearTimeout(timer)\n    }\n  }\n\n  // ── Carte (coque commune) ────────────────────────────────────────────────\n  const shell = { position: 'relative', maxWidth: 680, margin: '0 auto', width: '100%' }\n  const card = {\n    position: 'relative', background: surface, border: `1px solid ${border}`, borderRadius: 26,\n    padding: 'clamp(26px,4vw,38px) clamp(20px,4vw,32px) clamp(22px,3vw,28px)',\n    boxShadow: dark ? '0 30px 80px -28px rgba(0,0,0,0.6)' : '0 30px 80px -26px rgba(226,118,135,0.42), 0 6px 18px rgba(0,0,0,0.05)',\n  }\n  const headerPill = {\n    position: 'absolute', top: -17, left: '50%', transform: 'translateX(-50%)', whiteSpace: 'nowrap',\n    display: 'inline-flex', alignItems: 'center', gap: 8, padding: '8px 16px', borderRadius: 99,\n    background: 'linear-gradient(135deg, #6fb6ed 0%, #4371ee 100%)', color: '#fff', fontFamily: FONTS.sans, fontWeight: 600, fontSize: 13,\n    boxShadow: '0 8px 20px rgba(67,113,238,0.32)',\n  }\n  const glyph = <img src=\"/zenrayprogress-icon.png\" alt=\"\" width=\"20\" height=\"20\" style={{ display: 'inline-block', borderRadius: 5 }} />\n\n  if (status === 'done') {\n    return (\n      <div style={shell}>\n        <div style={{ ...card, textAlign: 'center' }}>\n          <div style={headerPill}>{glyph} ZenRayProgress</div>\n          <div style={{ width: 60, height: 60, borderRadius: 99, margin: '14px auto 16px', background: PALETTE.primarySoft, display: 'grid', placeItems: 'center' }}>\n            <svg width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M5 12.5l4.2 4.2L19 6.5\" stroke={PALETTE.primaryDark} strokeWidth=\"2.4\" strokeLinecap=\"round\" strokeLinejoin=\"round\" /></svg>\n          </div>\n          <div style={{ fontFamily: FONTS.serif, fontWeight: 800, fontSize: 27, color: textPrimary, marginBottom: 8 }}>You're on the list.</div>\n          <div style={{ fontFamily: FONTS.sans, fontSize: 15, color: textSecondary, lineHeight: 1.6 }}>Thanks {name.trim().split(' ')[0]} — you'll receive a mail for early access in a few days.</div>\n        </div>\n      </div>\n    )\n  }\n\n  const pill = (selected) => ({\n    flex: 1, padding: '12px 6px', borderRadius: 13, cursor: 'pointer', textAlign: 'center', position: 'relative',\n    border: selected ? `1.5px solid ${PALETTE.primary}` : `1.5px solid ${border}`,\n    background: selected ? PALETTE.primarySoft : fieldBg,\n    color: selected ? PALETTE.primaryDark : textPrimary,\n    fontFamily: FONTS.sans, fontWeight: 700, fontSize: 16, transition: 'all .15s ease',\n  })\n  const input = { width: '100%', boxSizing: 'border-box', padding: '13px 14px', borderRadius: 13, border: `1.5px solid ${border}`, background: fieldBg, color: textPrimary, fontFamily: FONTS.sans, fontSize: 15, outline: 'none' }\n\n  return (\n    <div style={shell}>\n      <div style={card}>\n        <div style={headerPill}>{glyph} ZenRayProgress</div>\n\n        {/* Accroche + grand prix (le montant choisi pilote le grand chiffre, effet Supaste) */}\n        <div style={{ textAlign: 'center', marginBottom: 18 }}>\n          <div style={{ fontFamily: FONTS.sans, fontSize: 13, fontWeight: 600, letterSpacing: 0.2, color: PALETTE.primaryDark, marginBottom: 10 }}>Choose a fair price</div>\n          <div style={{ display: 'flex', alignItems: 'baseline', justifyContent: 'center', gap: 8 }}>\n            <span style={{ ...priceFont, fontSize: 'clamp(46px,11vw,62px)', lineHeight: 1, color: textPrimary, letterSpacing: -1 }}>${effectiveAmount || MIN_CUSTOM}</span>\n            <span style={{ fontFamily: FONTS.sans, fontSize: 14, color: textSecondary }}>once</span>\n          </div>\n        </div>\n\n        {/* Choix du montant */}\n        <div style={{ display: 'flex', gap: 9, marginBottom: 12 }}>\n          {PRESETS.map((v) => (\n            <div key={v} role=\"button\" tabIndex={0} onClick={() => { setCustom(false); setAmount(v) }} onKeyDown={(e) => { if (e.key === 'Enter') { setCustom(false); setAmount(v) } }} style={pill(!custom && amount === v)}>\n              <span style={priceFont}>${v}</span>\n              {v === 30 && <span style={{ position: 'absolute', top: -9, right: -6, background: PALETTE.gradient, color: '#fff', fontFamily: FONTS.sans, fontSize: 9, fontWeight: 700, padding: '2px 7px', borderRadius: 99, letterSpacing: 0.3 }}>recommended</span>}\n            </div>\n          ))}\n          <div role=\"button\" tabIndex={0} onClick={() => setCustom(true)} onKeyDown={(e) => { if (e.key === 'Enter') setCustom(true) }} style={pill(custom)}>Custom</div>\n        </div>\n\n        {custom && (\n          <div style={{ marginBottom: 12 }}>\n            <div style={{ position: 'relative' }}>\n              <span style={{ position: 'absolute', left: 14, top: '50%', transform: 'translateY(-50%)', fontFamily: FONTS.sans, fontSize: 15, color: textSecondary }}>$</span>\n              <input type=\"number\" min={MIN_CUSTOM} step={1} value={customVal} onChange={(e) => setCustomVal(e.target.value)} placeholder={`${MIN_CUSTOM} or more`} style={{ ...input, paddingLeft: 26 }} autoFocus />\n            </div>\n            <div style={{ fontFamily: FONTS.sans, fontSize: 11, color: textSecondary, marginTop: 5 }}>Minimum ${MIN_CUSTOM} — this is for people who value their time.</div>\n          </div>\n        )}\n\n        {/* Honeypot anti-spam : invisible aux humains ET aux lecteurs d'écran (aria-hidden + hors écran), rempli par les robots -> rejeté côté serveur. */}\n        <input type=\"text\" name=\"company\" tabIndex={-1} autoComplete=\"off\" aria-hidden=\"true\" value={company} onChange={(e) => setCompany(e.target.value)} style={{ position: 'absolute', left: '-9999px', width: 1, height: 1, opacity: 0, pointerEvents: 'none' }} />\n        {/* Identité (friction minimale) */}\n        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 9, marginBottom: 12 }}>\n          <input value={name} onChange={(e) => setName(e.target.value)} placeholder=\"Your name\" style={input} autoComplete=\"name\" />\n          <input value={email} onChange={(e) => setEmail(e.target.value)} placeholder=\"Your email\" type=\"email\" style={input} autoComplete=\"email\" onKeyDown={(e) => { if (e.key === 'Enter') submit() }} />\n        </div>\n\n        {/* CTA : dégradé bleu de marque */}\n        <button onClick={submit} disabled={status === 'sending' || priceTooLow} style={{ width: '100%', padding: '15px', borderRadius: 14, border: 'none', cursor: (status === 'sending' || priceTooLow) ? 'not-allowed' : 'pointer', background: priceTooLow ? (dark ? 'rgba(255,255,255,0.14)' : '#d4d7dd') : 'linear-gradient(135deg, #6fb6ed 0%, #4371ee 100%)', color: priceTooLow ? (dark ? 'rgba(255,255,255,0.45)' : '#9a9da4') : '#fff', fontFamily: FONTS.sans, fontWeight: 700, fontSize: 16, opacity: status === 'sending' ? 0.7 : 1, transition: 'background .15s, color .15s, opacity .15s', boxShadow: priceTooLow ? 'none' : '0 10px 24px rgba(67,113,238,0.34)' }}>\n          {status === 'sending' ? 'Sending…' : 'Subscribe →'}\n        </button>\n        <div style={{ fontFamily: FONTS.sans, fontSize: 11.5, color: textSecondary, marginTop: 10, textAlign: 'center', lineHeight: 1.5 }}>You'll receive a mail for early access in a few days.</div>\n        {err && <div style={{ fontFamily: FONTS.sans, fontSize: 12, color: PALETTE.red, marginTop: 10, textAlign: 'center' }}>{err}</div>}\n      </div>\n    </div>\n  )\n}\n","numLines":156,"startLine":1,"totalLines":156}},"sourceToolAssistantUUID":"864aa1ae-d134-429e-92ac-b0e06c568df9","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"6a795d1e-819f-4aa6-b7a9-cd54c6f97b4b","version":"2.1.181","gitBranch":"main"}
