tion\": \"unknown\" | \"low\" | \"medium\" | \"high\",\n  \"outcome\": \"allow\" | \"deny\",\n  \"rationale\": string\n}\n"},"history_mode":"paginated","subagent_history_start_ordinal":232,"multi_agent_version":"disabled","context_window":{"window_id":"019f7614-0991-7b03-8994-659d5c71b0e4"},"git":{"commit_hash":"245d0be0810a70a94ee00edfb7be0405bcce8532","branch":"main","repository_url":"https://github.com/matthieuhuguet/Memory.git"}}}
