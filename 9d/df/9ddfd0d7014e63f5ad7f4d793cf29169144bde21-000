ropre en-tête. Une divergence sur ce fichier-là n'abîmerait pas l'affichage, elle abîmerait des archives.\n//\n// LE PROTOCOLE. Le script reçoit `--json` et écrit des lignes NDJSON préfixées `{\"zr\":1,...}` sur sa sortie\n// standard, EN PLUS de ses logs humains. On ne lit que ces lignes-là et on garde les autres pour le journal\n// affiché : aucun log existant ne peut casser le parseur, et le script reste lisible tel quel dans un terminal.\n//\n// Le nombre de dossiers simultanés reste paramétré et vaut un par défaut. Les voies d'un même dossier possèdent\n// leurs ateliers, tandis que les écritures partagées passent par les verrous du script d'archive.\nimport { EventEmitter } from 'node:events'\nimport { spawn, type ChildProcess } from 'node:child_process'\nimport { appendFileSync, existsSync, readFileSync, statSync as statFs, writeFileSync } from 'node:fs'\nimport { readdirSync } from 'node:fs'\nimport path from 'node:path'\nimport type { Bilan, Progress, SyncResult, WatchedFolder } from './types'\nimport { cpus } from 'node:os'\nimport { statSync } from 'node:fs'\nimport { envMoteur, type Binaires } from './env'\nimport { cheminEtat, cheminLogs } from './store'\nimport { p as par } from './params'\nimport { agregerEvenement, creerAgregation, erreurResultatSync, reportResultatSync, toutesLesVoiesTerminees } from './lane-events'\nimport { poserIcones } from './finder-icons'\nimport { signalerArbre } from './process-tree'\nimport { TamponLignes } from './line-buffer'\nimport { validerEvenementMoteur } from './engine-event'\n\nconst LOG_MAX = par<number>('familles.panneauVivant.lignesJournal')\nconst VIDE = { phase: 'inventaire' as const, seen: 0, total: 0, rel: '', bytes: 0, fichierFait: 0, fichierTotal: 0,\n  envoyes: 0, octetsParSeconde: 0, depot: '', morceau: 0, morceaux: 0, tailleMorceau: 0, atelier: '',\n  atelierOctets: 0, depotOctets: 0, morceauxEnAttente: [], sautes: [], voies: 0, voiesVivantes: 0, debut: 0,\n  fichiersDossier: 0, publies: 0, publiesTotal