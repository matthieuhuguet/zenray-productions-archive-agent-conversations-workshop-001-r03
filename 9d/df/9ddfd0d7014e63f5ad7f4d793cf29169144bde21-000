) await attendre(RESEAU.reculMs * tentative)\n    }\n  }\n  throw new Error(`${libelle} après ${essais} tentative(s) : ${derniere?.message || derniere}`)\n}\n\n/** Le manifeste se lit par l'API, JAMAIS par `raw.githubusercontent`, dont le cache de cinq minutes\n *  ferait restaurer une version périmée sans le dire. La règle est déjà écrite dans le CLAUDE.md du\n *  projet ; elle vaut ici plus qu'ailleurs, puisqu'on reconstruit un fichier à partir de ce qu'on lit. */\nasync function lireManifeste() {\n  const candidats = restoreManifestCandidates(rel, manifestArg)\n  let dernier404 = null\n  for (const candidat of candidats) {\n    const p = `${dest}/${candidat}`\n    const url = `https://api.github.com/repos/${OWNER}/${DATA}/contents/${p.split('/').map(encodeURIComponent).join('/')}`\n    try {\n      return await lireReponse(url, `manifeste ${p}`, async (r) => JSON.parse(await r.text()), enteteBrut, [404])\n    } catch (error) {\n      if (!String(error.message || error).includes('(404)')) throw error\n      dernier404 = error\n    }\n  }\n  throw new Error(`aucun manifeste file, img ou media pour ${rel} : ${dernier404?.message || 'introuvable'}`)\n}\n\nasync function lireReference(reference, numero, total) {\n  if (reference.isPrivate) {\n    return lireReponse(githubRawApiUrl(reference), `morceau ${numero}/${total}`,\n      async (r) => Buffer.from(await r.arrayBuffer()), enteteBrut)\n  }\n  try {\n    return await lireReponse(reference.url, `morceau ${numero}/${total}`,\n      async (r) => Buffer.from(await r.arrayBuffer()))\n  } catch {\n    return lireReponse(githubRawApiUrl(reference), `morceau ${numero}/${total}`,\n      async (r) => Buffer.from(await r.arrayBuffer()), enteteBrut)\n  }\n}\n\nasync function principal() {\n  const brut = await lireManifeste()\n  if (brut.deleted) {\n    console.log(`ⓘ ce fichier est marqué supprimé le ${brut.deletedAt || '?'} — ses morceaux sont pourtant toujours`\n      + ' en ligne, c\\'est précisément pourquoi une sauvegarde n\\'efface jamais rien. Restauration possible.')\n  }\n  const m = effectiveManifest(brut, versionArg === '' ? null : Number(versionArg))\n  const planStream = buildStreamRestorePlan(m, OWNER)\n  const refs = planStream ? planStream.refs : chunkRefs(m)\n  if (!refs.length) throw new Error('ce manifeste ne décrit aucun morceau pris en charge')\n  const attendu = planStream?.sha256 || m.sha256\n  if (!attendu) throw new Error('empreinte source absente : restauration refusée sans preuve d’intégrité')\n\n  const taille = planStream?.size ?? m.size\n  console.log(`restauration de « ${rel} » — ${refs.length} morceau(x), ${(taille / 1e9).toFixed(2)} Go`)\n  const h = createHash('sha256')\n  const cibleDemandee = path.join(sortie.replace(/^~/, process.env.HOME || '~'), rel)\n  await mkdir(path.dirname(cibleDemandee), { recursive: true })\n  const temporaire = path.join(path.dirname(cibleDemandee), `.${path.basename(cibleDemandee)}.zrc-part-${process.pid}-${Date.now()}`)\n  const flux = createWriteStream(temporaire, { flags: 'wx' })\n  let cible = ''\n  try {\n    let decoder = null\n    let key = null\n    if (planStream) {\n      const repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..', '..')\n      key = loadMasterKey(repoRoot, { readFileSync })\n      if (!key) throw new Error('clé maître média introuvable')\n      if (planStream.mode === 'whole-gcm') decoder = new WholeGcmDecoder(key, planStream.iv)\n    }\n    for (let i = 0; i < refs.length; i++) {\n      const chiffre = planStream\n        ? await lireReference(refs[i], i + 1, refs.length)\n        : await lireReponse(refUrl(refs[i]), `morceau ${i + 1}/${refs.length}`, async (r) => Buffer.from(await r.arrayBuffer()))\n      const clair = !planStream ? chiffre\n        : planStream.mode === 'part-gcm' ? decryptGcmPart(chiffre, refs[i].iv, key)\n          : decoder.push(chiffre)\n      if (clair.length) { h.update(clair); await writeBuffer(flux, clair) }\n      if ((i + 1) % 10 === 0 || i + 1 