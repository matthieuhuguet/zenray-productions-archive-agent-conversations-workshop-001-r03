ng); streamedImg++; done++\n1423:      if (done % 25 === 0) console.log(`  [${done} maj] image -> .img.json (streamable) ${f.rel}`)\n1434:      streamBlobs.push(res.manifestBlob); streamedVid++; done++\n1436:      console.log(`  [${done} maj] vidéo exacte -> .media.json ${f.rel}`)\n1444:      streamBlobs.push(enrichStreamManifest(res.manifestBlob, f.rel, sha)); streamedMedia++; done++\n1445:      console.log(`  [${done} maj] ${kind} -> chunked-media (streamable) ${f.rel}`)\n1451:  // pipeline === 'chunk' (ou repli ci-dessus) : CODE CHUNK LEGACY .file.json, STRICTEMENT INCHANGÉ.\n1476:        await rm(ancien, { recursive: true, force: true }).catch(() => {})\n1505:        emit({ ev: 'chunk', rel: f.rel, done: pos, total: curSize, seen, files: files.length,\n1511:        if (JSON_OUT) { lastEmit = Date.now(); emit({ ev: 'chunk', rel: f.rel, done: pos, total: curSize, seen,\n1527:  records.push(rec); prets.push(rec); done++\n1530:  if (done % 25 === 0 || curSize > RAW_MAX) console.log(`  [${done} maj / ${unchanged} inchangés / ${skipped.length} skip / ${files.length}] ${f.rel} (${(curSize / 1048576).toFixed(1)} Mo, ${ci} chunk(s)${rec.parts.length > 1 ? `, ${rec.parts.length} parts` : ''}) [shard ${(shardBytes / 1073741824).toFixed(2)} Go]`)\n1560:  if (totalStreamables && REINDEX) reconstruireIndexRecherche()\n1564:  emit({ ev: 'done', chunked: 0, images: streamedImg, videos: streamedVid, media: streamedMedia, unchanged, reused: reutilises.length, restored: restaures.length, skipped: skipped.map((x) => x.rel), verifyKo: 0 })\n1565:  await rm(WORK, { recursive: true, force: true }).catch(() => {})\n1569:// ── 4) MANIFESTES .file.json dans zenray-data (lots de 600, arbre inline) ───\n1575:console.log(`\\nmanifestes: ${blobs.length} .file.json -> ${DATA}:${DEST}`)\n1588:    emit({ ev: 'manifests', done: Math.min(i + 600, blobs.length), total: blobs.length })\n1622:emit({ ev: 'verify', total: urls.length, ko })\n1625:if (REINDEX && ko === 0) {\n1630:await rm(WORK, { recur