e = 500; return res.json({ error: String(e.message || e) }) }\n      try { res.end() } catch {}\n    }\n    return\n  }\n\n  // ── PARTAGE (miroir des rewrites vercel.json) : /watch, /view, /folder -> share-og (balises OG dynamiques). ──\n  const SHARE_TYPE = { '/watch': 'watch', '/view': 'view', '/folder': 'folder' }[url.pathname]\n  if (SHARE_TYPE) {\n    try {\n      const mod = await import(path.join(ROOT, 'api', '[...route].js'))\n      req.query = Object.fromEntries(url.searchParams)\n      req.query.route = ['share-og'] // miroir EXACT de vercel.json : un seul segment, le type voyage en query\n      req.query.shareType = SHARE_TYPE\n      await mod.default(req, res)\n    } catch (e) { res.statusCode = 500; res.end('share-og error: ' + (e.message || e)) }\n    return\n  }\n  // ── API ──\n  if (url.pathname.startsWith('/api/')) {\n    // Route via le MÊME catch-all que Vercel (api/[...route].js) : une seule source de vérité, handlers dans ../server/.\n    const parts = url.pathname.slice(5).split('/').filter(Boolean)\n    try {\n      const mod = await import(path.join(ROOT, 'api', '[...route].js'))\n      req.query = Object.fromEntries(url.searchParams)\n      req.query.route = parts // segment dynamique = `route` (ne PAS écraser ?path= des handlers)\n      if (req.method === 'POST' || req.method === 'PUT') {\n        const chunks = []; for await (const c of req) chunks.push(c)\n        const raw = Buffer.concat(chunks).toString('utf8')\n        try { req.body = JSON.parse(raw) } catch { req.body = raw }\n      }\n      await mod.default(req, res)\n    } catch (e) { res.statusCode = 500; res.end('api error: ' + (e.message || e)) }\n    return\n  }\n  // ── static (SPA) ──\n  let f = path.join(DIST, url.pathname === '/' ? 'index.html' : url.pathname)\n  try { await stat(f) } catch { f = path.join(DIST, 'index.html') } // fallback SPA\n  try {\n    const buf = await readFile(f)\n    res.setHeader('content-type', MIME[path.extname(f)] || 'application/octet-stream')\n    // index.html (et tout .html) : JAMAIS en cache. Sinon, après un rebuild, le navigateur garde un\n    // ancien index.html qui pointe vers des assets JS hashés SUPPRIMÉS -> 404 -> app blanche (bug observé).\n    // Les assets hashés (/assets/*.js) sont immuables -> cache long. Le reste : revalidation.\n    const ext = path.extname(f)\n    if (ext === '.html') res.setHeader('Cache-Control', 'no-cache, no-store, must-revalidate')\n    else if (/\\/assets\\//.test(f) && /\\.[0-9a-zA-Z_-]{8}\\.(js|css)$/.test(f)) res.setHeader('Cache-Control', 'public, max-age=31536000, immutable')\n    else res.setHeader('Cache-Control', 'no-cache')\n    res.end(buf)\n  } catch { res.statusCode = 404; res.end('not found') }\n})\n// SÉCURITÉ : on écoute UNIQUEMENT sur la loopback (127.0.0.1), JAMAIS sur 0.0.0.0. Sinon le serveur (qui porte\n// le GITHUB_TOKEN, sert la clé maître de déchiffrement et accepte les écritures sur le drive) serait joignable\n// par TOUT appareil du réseau local. Bind loopback = accessible seulement depuis cette machine.\nconst HOST = process.env.ZR_BIND || '127.0.0.1'\nserver.listen(PORT, HOST, () => console.log(`ZenRay local -> http://localhost:${PORT}  (bind ${HOST}, token: ${process.env.GITHUB_TOKEN ? 'OK' : 'ABSENT'})`))\n","exit_code":0,"duration":{"secs":0,"nanos":7542},"formatted_output":"import { link, rm } from 'node:fs/promises'\nimport path from 'node:path'\n\nexport function restorationCandidate(basePath, occurrence) {\n  if (occurrence === 1) return basePath\n  const parsed = path.parse(basePath)\n  return path.join(parsed.dir, `${parsed.name} (${occurrence})${parsed.ext}`)\n}\n\nexport async function publishRestoreWithoutOverwrite(temporaryPath, requestedPath) {\n  for (let occurrence = 1; ; occurrence++) {\n    const candidate = restorationCandidate(requestedPath, occurrence)\n    try {\n      // Le fichier temporaire vit dans le même dossier : le hard-link publie son inode d'un seul geste et\n      // échoue avec EEXIST au lieu d'écras