ier: WatchedFolder): void {\\n    if (dossier.paused) return\\n    // LE TROU QUI EXISTAIT ICI. Quand un fichier était ajouté pendant un envoi, cette méthode voyait le dossier\\n    // « déjà en cours » et repartait sans rien faire : l'événement était PERDU. Le nouveau fichier n'était donc\\n    // repris qu'au balayage de rattrapage, jusqu'à six heures plus tard. On note maintenant que le dossier est\\n    // sali, et il est remis en file dès que le passage courant s'achève. Rien ne se perd, et surtout on ne\\n    // relance pas un second moteur sur un dossier déjà en train d'être traité, ce qui ferait deux écrivains.\\n    if (this.enCours(dossier.id)) { this.salis.set(dossier.id, dossier); this.emit('maj'); return }\\n    const differee = this.reprisesDifferees.get(dossier.id)\\n    if (differee) { differee.dossier = dossier; this.emit('maj'); return }\\n    const position = this.file.findIndex((j) => j.id === dossier.id)\\n    if (position >= 0) { this.file[position] = { id: dossier.id, dossier }; this.emit('maj'); return }\\n    this.file.push({ id: dossier.id, dossier })\\n    this.emit('maj')\\n    this.demarrerSiLibre()\\n  }\\n\\n  /** Vrai si le dossier a bougé pendant son envoi et attend d'être repassé. */\\n  estSali(id: string): boolean { return this.salis.has(id) }\\n\\n  /** C6 — PAUSE VRAIE. « Pause » arrêtait le moteur, donc la reprise recommençait le fichier en cours : sur\\n   *  un film de sept gigaoctets, une pause de dix secondes coûtait dix minutes. SIGSTOP gèle le processus\\n   *  exactement où il est, SIGCONT le reprend à l'instruction suivante, et le fichier en cours n'est pas\\n   *  perdu. Le système d'exploitation fait ce travail depuis toujours ; il suffisait de le lui demander. */\\n  suspendre(id: string, geler: boolean): boolean {\\n    const t = this.travaux.get(id)\\n    if (!t) return false\\n    for (const e of (t.enfants || [t.enfant])) signalerArbre(e, geler ? 'SIGSTOP' : 'SIGCONT')\\n    this.pousserJournal(id, geler ? '── ge