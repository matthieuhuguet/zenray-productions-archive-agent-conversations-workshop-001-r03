carte, la couverture en premier.\nexport function coverPaths(project, own, max = 4) {\n  const first = coverPath(project, own)\n  const rest = own.filter((p) => p.endsWith('.img.json') && p !== first)\n  return (first ? [first, ...rest] : rest).slice(0, max)\n}\n\nconst isFile = (e) => !!e.contentPath && !e.hasKids\nconst under = (own, dir) => own.filter((p) => p.startsWith(`${dir}/`))\n\n// What one folder of a project shows, INSIDE ZenRay Assets: its own files, then one group per\n// sub-folder with that sub-folder's files, and deeper folders as cards that open in place.\n// FR : ce qu'un dossier montre dans ZenRay Assets, ses fichiers, puis un groupe par sous-dossier,\n// et les dossiers plus profonds en cartes qui s'ouvrent sur place, sans basculer dans Create.\nexport function folderView(dir, own) {\n  const kids = entriesOf(own, dir)\n  // 2026-09-11 A folder card shows the folder icon, never the first image inside: that image is often\n  // unrelated (the app wallpaper in an HDA history snapshot) and makes a folder look like a file.\n  // FR : une carte de dossier montre l'icône dossier, jamais la première image trouvée dedans.\n  const card = (f) => ({ dir: f.dir, name: f.name, count: under(own, f.dir).length })\n  return {\n    files: kids.filter(isFile),\n    groups: kids.filter((e) => e.hasKids).map((sub) => {\n      const k = entriesOf(own, sub.dir)\n      return { dir: sub.dir, title: sub.name, count: under(own, sub.dir).length, files: k.filter(isFile), folders: k.filter((e) => e.hasKids).map(card) }\n    }),\n  }\n}\n\n// The breadcrumb from the project folder down to the open folder. FR : le fil d'Ariane du projet.\nexport function crumbs(root, dir) {\n  if (!dir || dir === root || !dir.startsWith(`${root}/`)) return []\n  const parts = dir.slice(root.length + 1).split('/')\n  return parts.map((name, i) => ({ name, dir: `${root}/${parts.slice(0, i + 1).join('/')}` }))\n}\n\n// Project-level storage state: orange as soon as one source still sits on the