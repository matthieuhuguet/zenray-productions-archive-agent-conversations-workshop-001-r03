      { \"localPath\": \"<dir>\", \"files\": [\"<abs file>\", ...], \"target\": \"<sub-folder>\" } ] }\n//\n// Never deletes anything without --yes, never deletes a `keep` source, never trusts an upload report:\n// `free` re-lists the drive in the same run and compares names before the first unlink.\n// FR : ne supprime jamais sans --yes, jamais une source `keep`, et revérifie le drive avant de supprimer.\nimport { readFile, writeFile, readdir, stat, mkdir, rm, link, copyFile, unlink } from 'node:fs/promises'\nimport { existsSync } from 'node:fs'\nimport { spawnSync, execSync } from 'node:child_process'\nimport path from 'node:path'\n\nconst REPO = process.env.ZR_REPO || '/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress'\nconst API = process.env.ZR_API_BASE || 'http://localhost:3000'\nconst STAGING_ROOT = process.env.ZR_ASSETS_STAGING || '/Users/zenray/.claude/tmp/tmp-zenray-assets'\nconst CREATE_ROOT = 'pages/ZenRayAssets'\nconst STORE_PATH = 'pages/.zr-assets.json'\nconst NOISE = /(^|\\/)(\\.DS_Store|\\._[^/]*)$/\nconst MANIFEST_SUFFIX = /\\.(img|media|file)\\.json$/\n\nconst die = (msg) => { console.error(`✗ ${msg}`); process.exit(1) }\nconst log = (msg) => console.log(msg)\nconst today = () => new Date().toISOString().slice(0, 10)\n\n// Every regular file under a directory, relative paths, noise excluded.\nasync function walk(root, rel = '') {\n  const out = []\n  for (const e of await readdir(path.join(root, rel), { withFileTypes: true })) {\n    const r = rel ? `${rel}/${e.name}` : e.name\n    if (e.isDirectory()) out.push(...await walk(root, r))\n    else if (e.isFile() && !NOISE.test(r)) out.push(r)\n  }\n  return out\n}\n\n// The files of one source, as [{ abs, rel }] where rel is the path under the target sub-folder.\nasync function filesOfSource(s) {\n  if (!s.localPath || !s.target) die(`source incomplète : ${JSON.stringify(s)}`)\n  // A file-list source NEVER walks its directory: `files` in a plan, `paths` once recorded. Walking would\n  // sweep in every unrelated file of a shared folder like Downloads. FR : une liste ne parcourt jamais le dossier.\n  const list = Array.isArray(s.files) ? s.files : Array.isArray(s.paths) ? s.paths : null\n  if (list) {\n    for (const f of list) if (!existsSync(f)) die(`fichier introuvable : ${f}`)\n    return list.map((abs) => ({ abs, rel: path.basename(abs) }))\n  }\n  if (!existsSync(s.localPath)) die(`dossier introuvable : ${s.localPath}`)\n  return (await walk(s.localPath)).map((rel) => ({ abs: path.join(s.localPath, rel), rel }))\n}\n\nasync function bytesOf(list) {\n  let n = 0\n  for (const f of list) n += (await stat(f.abs)).size\n  return n\n}\n\n// Local API through the dev server (secret off on localhost). Reads with sha, never raw, before a write.\nasync function api(url, opts) {\n  const r = await fetch(`${API}${url}`, opts)\n  const j = await r.json().catch(() => null)\n  if (!r.ok || !j) throw new Error(`${url} -> HTTP ${r.status}`)\n  return j\n}\nasync function readStore() {\n  const j = await api(`/api/page?action=read&path=${encodeURIComponent(STORE_PATH)}`)\n  const data = j.markdown ? JSON.parse(j.markdown) : { projets: [] }\n  return { data, sha: j.sha }\n}\nasync function writeStore(data, sha) {\n  const j = await api('/api/page', { method: 'POST', headers: { 'content-type': 'application/json' },\n    body: JSON.stringify({ action: 'save', path: STORE_PATH, markdown: JSON.stringify(data, null, 1), sha }) })\n  if (j.error) throw new Error(`écriture du registre : ${j.error}`)\n}\n// The project array keeps its historical key so an older deployed build still reads it.\nconst listOf = (data) => (data.projets || data.projects || [])\nasync function updateProject(id, mutate) {\n  for (let attempt = 0; attempt < 4; attempt++) {\n    const { data, sha } = await readStore()\n    const list = listOf(data)\n    const i = list.findIndex((p) => p.id === id)\n    const next = mutate(i >= 0 ? list[i] : null)\n    if (i >= 0) list[i] = next; else list.push(next)\n    const key = data.projets ? 'projets' : 'projects'\n    try { await writeStore({ ...data, [key]: list }, sha); return next }\n    catch (e) { if (!/conflict/.test(e.message) || attempt === 3) throw e }\n  }\n}\n\n// Every manifest under a Create folder: its drive path, and the source name it stands for (suffix removed).\n// One listing serves both the 100 % check and the indexing. FR : une seule liste pour vérifier et indexer.\nasync function driveManifests(folder) {\n  const manifests = []\n  const visit = async (dir) => {\n    const j = await api(`/api/page?action=children&dir=${encodeURIComponent(dir)}`)\n    for (const e of (j.entries || [])) {\n      if (e.type === 'dir') await visit(`${dir}/${e.name}`)\n      else if (MANIFEST_SUFFIX.test(e.path)) manifests.push(e.path)\n    }\n  }\n  await visit(folder)\n  return manifests\n}\nconst namesOf = (folder, manifests) => new Set(manifests.map((p) => p.slice(folder.length + 1).replace(MANIFEST_SUFFIX, '').normalize('NFC')))\nasync function driveNames(folder) { return namesOf(folder, await driveManifests(folder)) }\n\nfunction run(cmd, args, label) {\n  log(`→ ${label}`)\n  const token = execSync('gh auth token', { encoding: 'utf8' }).trim()\n  const r = spawnSync(process.execPath, [path.join(REPO, cmd), ...args], { cwd: REPO, stdio: 'inherit', env: { ...process.env, GITHUB_TOKEN: token } })\n  if (r.status !== 0) die(`${label} a échoué (code ${r.status})`)\n}\n\nasync function indexManifests(manifests) {\n  const list = path.join(STAGING_ROOT, `.index-${Date.now()}.txt`)\n  await mkdir(STAGING_ROOT, { recursive: true })\n  await writeFile(list, manifests.join('\\n') + '\\n')\n  run('scripts/index-add-paths.mjs', [list], `indexation de ${manifests.length} fichier(s)`)\n  await rm(list, { force: true })\n}\n\nasync function add(planPath) {\n  const plan = JSON.parse(await readFile(planPath, 'utf8'))\n  for (const k of ['id', 'name', 'slug', 'sources']) if (!plan[k]) die(`plan sans « ${k} »`)\n  if (!/^tmp-[a-z0-9-]+$/.test(plan.slug)) die(`slug invalide « ${plan.slug} » : tmp-<mots-sans-accent>`)\n  const folder = `${CREATE_ROOT}/${plan.slug}`\n  const stage = path.join(STAGING_ROOT, plan.slug)\n\n  // 1. Inventory: every file of every source, and no two files landing on the same name.\n  const inventory = []\n  for (const s of plan.sources) {\n    const files = await filesOfSource(s)\n    inventory.push({ source: s, files, bytes: await bytesOf(files) })\n  }\n  const targets = new Map()\n  for (const { source, files } of inventory) for (const f of files) {\n    const dest = `${source.target}/${f.rel}`.normalize('NFC')\n    if (targets.has(dest)) die(`collision de nom : ${dest}`)\n    targets.set(dest, f.abs)\n  }\n  log(`inventaire : ${targets.size} fichier(s) dans ${plan.sources.length} source(s)`)\n\n  // 2. Staging by hard links: zero byte copied, the originals never move.\n  await rm(stage, { recursive: true, force: true })\n  for (const [dest, abs] of targets) {\n    const to = path.join(stage, dest)\n    await mkdir(path.dirname(to), { recursive: true })\n    try { await link(abs, to) } catch { await copyFile(abs, to) }\n  }\n  const staged = await walk(stage)\n  if (staged.length !== targets.size) die(`préparation incomplète : ${staged.length} sur ${targets.size}`)\n  log(`préparation : ${staged.length}/${targets.size} fichiers, liens physiques dans ${stage}`)\n\n  // 3. Archive into Create (unified routing: images / videos / audio streamable, the rest chunked), then index.\n  run('scripts/archive-folder.mjs', [stage, folder, '--skip-noise'], `archive vers ${folder}`)\n\n  // 4. Verify on the drive, in this run: every staged name must have its manifest. Then index exactly\n  //    the manifests just listed, never a stale local clone.\n  const manifests = await driveManifests(folder)\n  const online = namesOf(folder, manifests)\n  const missing = [...targets.keys()].filter((d) => !online.has(d))\n  if (missing.length) die(`${missing.length} fichier(s) absents du drive :\\n  ${missing.join('\\n  ')}`)\n  log(`vérification drive : ${targets.size}/${targets.size} fichiers présents dans Create`)\n  await indexManifests(manifests)\n\n  // 5. Record the project (English keys), keeping any legacy showcase or components of the same id.\n  //    The cover is stored as its image MANIFEST path, never the source file name.\n  const coverManifest = plan.cover ? (manifests.find((m) => m.replace(MANIFEST_SUFFIX, '') === `${folder}/${plan.cover}`) || null) : null\n  if (plan.cover && !coverManifest) log(`⚠ couverture introuvable sur le drive : ${plan.cover}`)\n  const checkedAt = new Date().toISOString()\n  const sources = inventory.map(({ source, files, bytes }) => ({\n    localPath: source.localPath, target: source.target, count: files.length, bytes,\n    ...(Array.isArray(source.files) ? { paths: source.files } : {}),\n    present: true, keep: !!source.keep, checkedAt,\n  }))\n  const saved = await updateProject(plan.id, (old) => {\n    const base = { ...(old || {}) }\n    for (const k of ['nom', 'categorie', 'resume', 'depose']) delete base[k]\n    return { ...base, id: plan.id, name: plan.name, category: plan.category || '', summary: plan.summary || '',\n      date: today(), folder, cover: coverManifest || base.cover || null, sources,\n      showcase: base.showcase || base.vitrine || undefined, components: base.components || base.composants || undefined,\n      vitrine: undefined, composants: undefined }\n  })\n  log(`registre : projet « ${saved.name} » enregistré, ${sources.length} source(s)`)\n  await rm(stage, { recursive: true, force: true })\n  log(`✓ ${plan.name} : ${targets.size} fichiers dans ${folder}`)\n}\n\nasync function status(onlyId) {\n  const { data } = await readStore()\n  for (const p of listOf(data).filter((x) => Array.isArray(x.sources) && (!onlyId || x.id === onlyId))) {\n    await updateProject(p.id, (old) => ({ ...old, sources: old.sources.map((s) => {\n      const present = Array.isArray(s.paths) ? s.paths.some((f) => existsSync(f)) : existsSync(s.localPath)\n      return { ...s, present, checkedAt: new Date().toISOString() }\n    }) }))\n    log(`${p.id} : pastilles mises à jour`)\n  }\n}\n\nasync function free(id, yes) {\n  const { data } = await readStore()\n  const p = listOf(data).find((x) => x.id === id)\n  if (!p || !p.folder) die(`projet inconnu ou sans dossier : ${id}`)\n  const online = await driveNames(p.folder)\n"},"started_at_ms":1790937795634,"completed_at_ms":1790937795634}}
