gth) return null\n  // A `keep` source is versioned elsewhere (Git): it stays on the Mac by design and never counts as\n  // space to free. FR : une source `keep` est versionnée ailleurs, elle reste sur le Mac et ne compte pas.\n  const local = sources.filter((s) => s.present && !s.keep)\n  const bytes = local.reduce((n, s) => n + (Number(s.bytes) || 0), 0)\n  return local.length\n    ? { color: UI.orange, label: `Aussi sur ce Mac${bytes ? ` · ${readableSize(bytes)}` : ''}` }\n    : { color: UI.green, label: 'Uniquement sur le cloud' }\n}\n\n// The colour and label of ONE source line. FR : couleur et libellé d'une ligne de source.\nexport function sourceState(s) {\n  if (s.keep) return { color: UI.blue, label: 'versionné, reste sur le Mac' }\n  return s.present ? { color: UI.orange, label: readableSize(s.bytes) || 'sur le Mac' } : { color: UI.green, label: 'supprimé du Mac' }\n}\n\n// A speaking thumbnail for a text file: its title and first lines, read from the file itself.\n// Markdown keeps its words without the syntax, HTML its <title> and visible text, code its first lines.\n// FR : la vignette parlante d'un fichier texte, son titre et ses premières lignes, lus dans le fichier.\nexport function excerptOf(name, text, maxLines = 9) {\n  const ext = (/\\.([a-z0-9]+)$/i.exec(name || '') || [])[1]?.toLowerCase() || ''\n  const src = String(text || '')\n  if (ext === 'md' || ext === 'markdown') {\n    const lines = src.split('\\n').map((l) => l.trim()).filter((l) => l && !/^(-{3,}|```|\\|?[-:| ]+\\|?)$/.test(l))\n    const heading = lines.find((l) => /^#{1,6}\\s/.test(l))\n    const clean = (l) => l.replace(/^#{1,6}\\s+|^>\\s?|^[-*+]\\s+|^\\d+\\.\\s+/, '').replace(/[*_`]/g, '').replace(/\\[([^\\]]*)\\]\\([^)]*\\)/g, '$1').replace(/\\|/g, ' ').trim()\n    const body = lines.filter((l) => l !== heading).map(clean).filter(Boolean)\n    return { title: heading ? clean(heading) : '', lines: body.slice(0, maxLines), mono: false }\n  }\n  if (ext === 'html' || ext === 'htm'