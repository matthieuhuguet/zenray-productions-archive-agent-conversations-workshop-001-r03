en (repo, commit). encodeURIComponent per segment (spaces, accents).\nconst rawOf = (repo, commit, p) => `https://raw.githubusercontent.com/${OWNER}/${repo}/${commit}/${String(p).split('/').map(encodeURIComponent).join('/')}`\n\n// Raw URL of the file in 'raw' (non-chunked) mode: the manifest carries repo/commit/path top-level.\nexport const rawUrl = (m, p) => rawOf(m.repo, m.commit, p)\n// Raw URL of a chunk reference { repo, commit, path }.\nexport const refUrl = (r) => rawOf(r.repo, r.commit, r.path)\n\n// chunkRefs(m) -> [{ repo, commit, path }, ...] in RECONSTRUCTION ORDER.\n//   v4 multi-shard: m.parts[] = [{repo, commit, chunks[]}] -> flatten all parts in order.\n//   v2/v3 mono-shard: no parts -> m.chunks[] with the top-level repo/commit.\nexport const chunkRefs = (m) => (Array.isArray(m.parts) && m.parts.length)\n  ? m.parts.flatMap((pt) => (pt.chunks || []).map((c) => ({ repo: pt.repo, commit: pt.commit, path: c })))\n  : (m.chunks || []).map((c) => ({ repo: m.repo, commit: m.commit, path: c }))\n\n// Total chunk count (all parts). For the \"N pieces\" display.\nexport const chunkCount = (m) => (Array.isArray(m.parts) && m.parts.length)\n  ? m.parts.reduce((n, pt) => n + (pt.chunks || []).length, 0)\n  : (m.chunks || []).length\n\n// latestVersion(m) -> index of the current (last) version when the manifest carries versions[], else null.\nexport const latestVersion = (m) => (Array.isArray(m.versions) && m.versions.length) ? m.versions.length - 1 : null\n\n// effectiveManifest(m, verIndex?) -> the EFFECTIVE manifest to read/download.\n//   If m carries versions[], switch to the requested (or last) version: its repo/commit/chunks/parts\n//   override the top-level ones. Otherwise m is returned as-is. This is exactly what FileNodeViewer\n//   (eff) and DownloadsView (effManifest) both did — factored here.\nexport function effectiveManifest(m, verIndex = null) {\n  if (!m) return m\n  const versions = (Array.isArray(m.versions) && m.versions.length) ? m.version