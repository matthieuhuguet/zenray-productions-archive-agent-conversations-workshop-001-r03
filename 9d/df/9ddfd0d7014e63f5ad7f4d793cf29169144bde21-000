),\n    dernier: new Date().toISOString(), supprime: false, depuis: r.depuis || null,\n    manifeste: `${r.rel}.file.json` })\n  for (const b of annexesBlobs) {\n    const cheminManifeste = b.path.slice(dest.length + 1)\n    depuisManifeste(cheminManifeste.replace(/\\.file\\.json$/, ''), JSON.parse(b.content), cheminManifeste)\n  }\n  let verrou = null\n  try {\n    verrou = await acquireDirectoryLock(INDEX_ETAT + '.lock', directoryLockOptions('court', 'index ZenRayCloud'))\n    // Une voie peut avoir cloné les manifestes avant que sa voisine publie les siens. On reprend donc l'index\n    // déjà écrit sous verrou, puis la voie courante remplace uniquement les fiches qu'elle connaît.\n    try {\n      const precedent = JSON.parse(await readFile(INDEX_ETAT, 'utf8'))\n      const fusion = mergePreviousStateCards(fiches, precedent.fiches,\n        (rel) => !TRANCHE || belongsToPartition(rel, TRANCHE))\n      fiches.clear()\n      for (const [rel, fiche] of fusion) fiches.set(rel, fiche)\n    } catch (error) {\n      if (error.code !== 'ENOENT') console.error(`  ⚠ index précédent illisible, reconstruction : ${error.message}`)\n    }\n    await mkdir(path.dirname(INDEX_ETAT), { recursive: true })\n    const temporaire = `${INDEX_ETAT}.tmp-${process.pid}`\n    await writeFile(temporaire, JSON.stringify({ src: SRC, dest, at: new Date().toISOString(),\n      rels: [...fiches.keys()], fiches: [...fiches.values()] }))\n    await rename(temporaire, INDEX_ETAT)\n    console.log(`  index d'état : ${fiches.size} fiche(s)`)\n  } finally { if (verrou) await verrou.release() }\n}\n// BRUIT SYSTÈME (ZenRayCloud) : `--skip-noise` écarte de l'inventaire les fichiers que macOS sème partout\n// (.DS_Store, ._AppleDouble, corbeilles, index Spotlight) et les écritures partielles (.part, .crdownload, ~$).\n// OPT-IN et jamais par défaut : les archives existantes ont été constituées sans ce filtre, et un dossier\n// archivé doit rester le miroir exact de ce qu'on lui a donné tant que personne n'a demandé le contraire.\n\n// UN SEUL ENDROIT FABRIQUE UN MANIFESTE, qu'il parte au fil de l'envoi ou à la fin. Deux fabriques auraient\n// fini par diverger d'un champ, et c'est exactement le genre d'écart qui rend une archive illisible.\nconst partsOf = (r) => r.parts.map((pt) => ({ repo: pt.shard, commit: shardCommit[pt.shard], chunks: pt.chunks }))\nfunction construireBlobManifeste(r) {\n  const parts = partsOf(r)\n  const first = parts[0] || { repo: null, commit: null, chunks: [] }\n  const cur = { ts: new Date().toISOString(), size: r.size, sha256: r.sha256, chunkSize: r.chunkSize || CHUNK,\n    parts, repo: first.repo, commit: first.commit, chunks: first.chunks }\n  const versions = [...(r.prevVersions || []), cur]\n  return {\n    path: `${DEST}/${r.rel}.file.json`,\n    content: JSON.stringify({ type: 'file', v: 4, name: path.basename(r.rel), rel: r.rel, mime: r.mime,\n      mode: 'chunked', size: cur.size, sha256: cur.sha256, chunkSize: cur.chunkSize, parts,\n      repo: cur.repo, commit: cur.commit, chunks: cur.chunks, versions }),\n  }\n}\n\n// LE VERROU DES MANIFESTES (2026-08-16, trois voies perdues dessus). Les morceaux vont dans des dépôts\n// séparés par voie, mais les MANIFESTES vont tous, par construction, dans le même `zenray-data` : six voies\n// y poussent donc en même temps, et douze rebases ne suffisent pas quand la base bouge à chaque tentative.\n// Un verrou par dossier, créé avec `mkdir` qui est atomique sur tous les systèmes de fichiers, sérialise\n// ces écritures sans rien changer au reste : chaque voie attend son tour quelques secondes plutôt que de\n// mourir au bout de douze essais. Le détenteur écrit son PID : une commande Git synchrone peut bloquer la\nexport function stateCardFromManifest(rel, manifest, manifestPath = null) {\n  const versions = Array.isArray(manifest.versions) && manifest.versions.length ? manifest.versions : []\n  const date = manifest.ts || manifest.addedAt || null\n  return {\n    rel,\n    taille: manifest.size || manifest.clearSize || 0,\n    sha: manifest.sha256 || manifest.sourceSha256 || '',\n    versions: versions.length || 1,\n    premier: versions[0]?.ts || date,\n    dernier: versions[versions.length - 1]?.ts || date,\n    supprime: !!manifest.deleted,\n    depuis: manifest.depuis || null,\n    manifeste: manifestPath,\n  }\n}\n\nexport function mergePreviousStateCards(currentCards, previousCards, ownsPath) {\n  const merged = new Map(currentCards)\n  for (const card of previousCards || []) {\n    if (!card?.rel) continue\n    // La voie courante décide seulement de sa tranche. Pour les autres, le dernier index écrit est plus frais\n    // que son clone pris au début du passage et doit donc gagner.\n    if (!ownsPath(card.rel) || !merged.has(card.rel)) merged.set(card.rel, card)\n  }\n  return merged\n}\nimport { randomUUID } from 'node:crypto'\nimport { mkdir, readFile, rename, rm, stat, writeFile } from 'node:fs/promises'\nimport path from 'node:path'\n\nconst sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms))\n\nconst PROFILES = {\n  court: { waitMs: 60_000, staleMs: 15 * 60_000, pollMs: 100 },\n  long: { waitMs: 60 * 60_000, staleMs: 15 * 60_000, pollMs: 250 },\n}\n\nexport function directoryLockOptions(profile, label) {\n  const values = PROFILES[profile]\n  if (!values) throw new Error(`profil de verrou inconnu: ${profile}`)\n  return { ...values, label }\n}\n\nfunction processIsAlive(pid) {\n  if (!Number.isInteger(pid) || pid <= 0) return false\n  try { process.kill(pid, 0); return true }\n  catch (error) { return error?.code === 'EPERM' }\n}\n\nasync function inspectLock(lockDir, staleMs) {\n  try {\n    const ownerPath = path.join(lockDir, 'owner.json')\n    let owner = null\n    let modifiedAt = (await stat(lockDir)).mtimeMs\n    try {\n      owner = JSON.parse(await readFile(ownerPath, 'utf8'))\n      modifiedAt = (await stat(ownerPath)).mtimeMs\n    } catch {}\n    const ownerIdentifie = Number.isInteger(owner?.pid) && owner.pid >