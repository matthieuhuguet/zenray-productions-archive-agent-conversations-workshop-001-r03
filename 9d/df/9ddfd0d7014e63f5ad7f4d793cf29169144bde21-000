ist of URLs to fetch to rebuild the file.\\n//   'raw' mode -> a single URL (the whole file). 'chunked' mode -> every chunk URL in order.\\n// fetchAsset.streamDownload consumes this list directly.\\nexport function downloadUrls(m) {\\n  // ZenRayShards blob-raw: parts[] = [{url,...}] (one direct blob per 95 MB part, in order). Return\\n  // the URLs as-is -> BIT-EXACT reconstruction by simple concatenation (fetchAsset).\\n  if (m && m.type === 'blob-raw' && Array.isArray(m.parts) && m.parts.length && m.parts[0] && m.parts[0].url) return m.parts.map((p) => p.url)\\n  if (m.mode === 'raw') return [rawUrl(m, m.path)]\\n  return chunkRefs(m).map(refUrl)\\n}\\nsed: Cloud/scripts/restore.mjs: No such file or directory\\nimport path from 'node:path'\\n\\nexport function sourceHashOfStreamManifest(manifest) {\\n  if (!manifest || typeof manifest !== 'object') return null\\n  let sha256 = typeof manifest.sourceSha256 === 'string' && /^[a-f0-9]{64}$/i.test(manifest.sourceSha256)\\n    ? manifest.sourceSha256.toLowerCase() : null\\n  // Les anciennes vidéos étaient remuxées avant leur découpe. Une empreinte ajoutée après coup depuis le\\n  // fichier local ne prouve donc pas que les octets distants sont ceux de la source. Seuls les nouveaux\\n  // manifestes, écrits par le rail bit à bit, portent cette preuve explicite.\\n  if (manifest.type === 'video-raw' && manifest.sourceExact !== true) sha256 = null\\n  // Pour les images historiques, le chemin de contenu porte déjà l'empreinte du clair original.\\n  if (!sha256 && manifest.type === 'image') {\\n    const premier = Array.isArray(manifest.cdnChunks) ? manifest.cdnChunks[0] : manifest.cdnPath\\n    const match = /(?:^|\\\\/)([a-f0-9]{64})(?:-\\\\d+)?(?:\\\\.[^/]*)?$/i.exec(premier || '')\\n    if (match) sha256 = match[1].toLowerCase()\\n  }\\n  return sha256\\n}\\n\\n/** Retrouve le fichier source d'un manifeste image, audio, PDF ou vidéo sans dépendre du suffixe aléatoire\\n *  des anciens `.media.json`. Les nouveaux man