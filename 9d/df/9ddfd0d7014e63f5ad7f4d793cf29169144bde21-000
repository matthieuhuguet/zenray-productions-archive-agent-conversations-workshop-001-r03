isesDifferees.values()) clearTimeout(minuterie)\\n    this.reprisesDifferees.clear()\\n    for (const id of [...this.travaux.keys()]) this.annuler(id)\\n  }\\n\\n  /** COMBIEN DE VOIES EN PARALLÈLE. Un seul flux git plafonne à ~8 Mo/s quelle que soit la ligne : c'est la\\n   *  fenêtre d'un flux unique vers GitHub qui limite, pas le réseau. Mesuré le 2026-08-16 : trois tranches\\n   *  montent à 13 Mo/s sur une ligne à 254 Mbps. Rien n'est figé ici — le nombre se déduit de la machine et du\\n   *  volume à envoyer, et un petit dossier reste sur une seule voie, où paralléliser ne rapporterait rien. */\\n  private voiesPour(src: string): number {\\n    try { if (!statSync(src).isDirectory()) return 1 } catch { return 1 }\\n    const memo = this.lireMemo()\\n    // LE PLANCHER, ET POURQUOI IL EXISTE (mesuré le 2026-08-16). La règle « sous deux mégaoctets par seconde,\\n    // une seule voie » était un PIÈGE ABSORBANT : une fois tombé à une voie, le débit ne dépasse plus jamais ce\\n    // seuil, donc rien ne fait jamais remonter. `voies.json` est resté bloqué à `{\\\"n\\\":1, \\\"debit\\\":1.5 Mo/s}`\\n    // pendant douze heures, transformant un passage de six heures en un passage de quarante-quatre, c'est-à-dire\\n    // plus long que l'intervalle entre deux crashes : le passage ne pouvait donc PLUS JAMAIS aboutir.\\n    const min = par<number>('familles.voieEnvoi.voiesMin')\\n    if (memo && memo.n >= 1) return Math.max(min, memo.n)\\n    return Math.max(min, par<number>('familles.voieEnvoi.voiesPremierEssaiMin'),\\n      Math.min(par<number>('familles.voieEnvoi.voiesPremierEssaiMax'),\\n        Math.round((cpus().length || 8) / par<number>('familles.voieEnvoi.diviseurCoeurs'))))\\n  }\\n\\n  /** Mémoire d'adaptation : combien de voies au dernier envoi, et quel débit total elles ont donné. */\\n\"}}\n{\"i\":1,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"c2848d\",\"wall_time_seconds\":0.000009166,\"exit_code\":0,\"original_token_count\":3528,\"output\":\"script