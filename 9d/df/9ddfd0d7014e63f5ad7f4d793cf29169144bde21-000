ath: '/Users/zenray/Create/Build/Productions/ZenRayShards', target: 'materials', keep: true, present: true }\n    ],\n    showcase: [],\n    components: [],\n  },\n  {\n    id: 'zenray-assets-meshes',\n    name: 'ZenRay Assets Meshes',\n    category: '3D',\n    summary: 'Bibliothèque et sauvegarde de meshes 3D (Static Meshes et Skeletal Meshes pour Unreal Engine et Houdini), avec inspecteur WebGL temps réel (Shaded, Wireframe, Normales, MatCap Clay, polycount et dimensions).',\n    date: '2026-09-19',\n    folder: 'pages/ZenRayAssets/tmp-zenray-assets-meshes',\n    cover: null,\n    sources: [\n      { localPath: '/Users/zenray/Create/Build/Productions/ZenRayShards', target: 'meshes', keep: true, present: true }\n    ],\n    showcase: [],\n    components: [],\n  },\n]\n\nexport const compareProjectsByDateDesc = (a, b) => {\n  const da = a?.date || ''\n  const db = b?.date || ''\n  if (da && db && da !== db) return db.localeCompare(da)\n  if (db && !da) return 1\n  if (da && !db) return -1\n  return 0\n}\n\n// Fusionne les projets du registre drive avec les projets par defaut indispensables,\n// et trie de maniere strictement decroissante (les plus recents en premier comme une boite mail).\nexport function mergeAssetsProjects(driveProjects) {\n  const list = Array.isArray(driveProjects) ? driveProjects.map(normalizeProject).filter(Boolean) : []\n  const knownIds = new Set(list.map((p) => p.id))\n  const missing = DEFAULT_ASSETS_PROJECTS.filter((p) => !knownIds.has(p.id))\n  const merged = [...list, ...missing]\n  return merged.sort(compareProjectsByDateDesc)\n}\n\n// Schema v2 is English. Projects written before 2026-09-11 used French keys; this single reader\n// accepts both, so no project already on the drive is lost. Writers only produce the English keys.\n// FR : le schéma v2 est en anglais ; ce lecteur unique accepte encore les anciennes clés françaises.\nexport function normalizeProject(p) {\n  if (!p || typeof p !== 'object') return null\n  return {\n    id: p.id || p.nom || p.name,\n    name: p.name ?? p.nom ?? '',\n    category: p.category ?? p.categorie ?? '',\n    summary: p.summary ?? p.resume ?? '',\n    date: p.date ?? p.depose ?? '',\n    demo: !!p.demo,\n    folder: p.folder || null,\n    cover: p.cover || null,\n    sources: Array.isArray(p.sources) ? p.sources : [],\n    showcase: (p.showcase ?? p.vitrine ?? []).map((v) => ({ image: v.image, title: v.title ?? v.titre, note: v.note })),\n    components: (p.components ?? p.composants ?? []).map((c) => ({\n      name: c.name ?? c.nom, group: c.group ?? c.groupe, short: c.short ?? c.court, engine: c.engine ?? c.moteur,\n      size: c.size ?? c.poids, date: c.date, link: c.link ?? c.lien,\n    })),\n  }\n}\n\n\n// Every leaf path under a project folder. `.DS_Store` never counts as an asset.\n// FR : tous les chemins feuilles sous le dossier d'un projet.\nexport function projectPaths(folder, paths) {\n  if (!folder) return []\n  const prefix = folder.endsWith('/') ? folder : `${folder}/`\n  return paths.filter((p) => p.startsWith(prefix) && !/(^|\\/)\\.DS_Store/.test(p))\n}\n\n// The cover of a project, always a real image MANIFEST. A plan may name the source file\n// (`carnet/IMG_7160.jpeg`) or its manifest; both resolve, and without either the first image wins.\n// FR : la couverture est toujours un manifeste d'image réel, qu'on la nomme par le fichier ou le manifeste.\nexport function coverPath(project, own) {\n  const c = project.cover\n  if (c) {\n    if (own.includes(c)) return c\n    const hit = own.find((p) => p.endsWith('.img.json') && stripLeafExt(p) === c)\n    if (hit) return hit\n  }\n  return own.find((p) => p.endsWith('.img.json')) || null\n}\n\n// 2026-09-23 : up to `max` images for a card mosaic, the chosen cover first.\n// FR : jusqu'a `max` images pour la mosaique d'une carte, la couverture en premier.\nexport function coverPaths(project, own, max = 4) {\n  const first = coverPath(project, own)\n  const rest = own.filter((p) => p.endsWith('.img.js