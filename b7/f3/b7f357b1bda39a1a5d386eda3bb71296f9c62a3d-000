sh + lit le commit SHA (pour pinner jsDelivr dans les manifestes).\n  async function flush() {\n    if (ctx.dir && existsSync(ctx.dir)) {\n      if (!await pushShard()) throw new Error('push-final img shard ' + ctx.repo)\n      ctx.commitOf[ctx.repo] = git(ctx.dir, ['rev-parse', 'HEAD']).stdout.trim()\n      ctx.log(`  ✓ ${ctx.repo} poussé (commit ${(ctx.commitOf[ctx.repo] || '').slice(0, 7)})`)\n    }\n  }\n\n  // Rollover ANTICIPÉ (compteur local, jamais de question à GitHub) si `bytes` ne tiendrait plus dans le\n  // shard courant. Exposé séparément (ctx.reserve) pour qu'une image DÉCOUPÉE EN PLUSIEURS MORCEAUX réserve\n  // la place du TOTAL avant d'écrire son premier morceau -> garantit que tous les morceaux d'UNE MÊME image\n  // atterrissent dans le MÊME repo/commit (sinon un rollover pile entre deux morceaux romprait la reconstruction,\n  // qui suppose cdnRepo/cdnCommit uniques pour toute la liste cdnChunks).\n  async function reserve(bytes) {\n    if (ctx.bytes > 0 && ctx.bytes + bytes > SHARD_CAP_BYTES) { await pushShard(); ctx.commitOf[ctx.repo] = git(ctx.dir, ['rev-parse', 'HEAD']).stdout.trim(); await openShard() }\n  }\n  // Écrit un binaire chiffré (déjà hashé) dans l'arbre du shard, à son chemin d'adresse de contenu.\n  // Rollover AVANT écriture si le shard atteint le cap. Renvoie le repo dans lequel il a atterri.\n  async function writeBinary(hashedPath, cipherBuf) {\n    await reserve(cipherBuf.length)\n    const dst = path.join(ctx.dir, hashedPath)\n    await mkdir(path.dirname(dst), { recursive: true })\n    await writeFile(dst, cipherBuf)\n    ctx.bytes += cipherBuf.length; ctx.pending += cipherBuf.length\n    // 900 Mo (2026-07-11, relevé depuis 800 Mo, demande Matthieu) : reste sous la marge <1 Go/push déjà\n    // testée (img-pipeline.mjs) — 800 comme 900 sont sûrs, seule 1900 (proposé puis écarté) l'aurait\n    // dépassée. Pour upload-img-list.mjs ce seuil est de toute façon rarement atteint : depuis le fix\n    // \"média par média\" du 