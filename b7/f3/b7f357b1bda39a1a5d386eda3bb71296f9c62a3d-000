      ctx.commitOf[ctx.repo] = git(ctx.dir, ['rev-parse', 'HEAD']).stdout.trim()\nscripts/img-ingest.mjs:126:      ctx.log(`  ✓ ${ctx.repo} poussé (commit ${(ctx.commitOf[ctx.repo] || '').slice(0, 7)})`)\nscripts/img-ingest.mjs:133:  // atterrissent dans le MÊME repo/commit (sinon un rollover pile entre deux morceaux romprait la reconstruction,\nscripts/img-ingest.mjs:136:    if (ctx.bytes > 0 && ctx.bytes + bytes > SHARD_CAP_BYTES) { await pushShard(); ctx.commitOf[ctx.repo] = git(ctx.dir, ['rev-parse', 'HEAD']).stdout.trim(); await openShard() }\nscripts/img-ingest.mjs:149:    // \"média par média\" du même jour, ctx.flush() est appelé explicitement après CHAQUE image (voir ce\nscripts/img-ingest.mjs:151:    // consommateurs de makeImgShardCtx (archive-folder.mjs, upload-img-all.mjs, regen-thumbs-oriented.mjs)\nscripts/img-ingest.mjs:152:    // qui n'appellent pas flush() par image.\nscripts/img-ingest.mjs:157:  ctx.openShard = openShard\nscripts/img-ingest.mjs:158:  ctx.flush = flush\nscripts/img-ingest.mjs:166:// { path:'<dest>/<rel>.img.json', content } à committer sur zenray-data par le bulk (avec les autres).\nscripts/img-ingest.mjs:167:// IMPORTANT : le commit SHA jsDelivr n'est connu qu'au flush() final. On renvoie donc un manifeste avec\nscripts/img-ingest.mjs:168:// un PLACEHOLDER de commit que le bulk RÉSOUT après flush (resolveImgManifests ci-dessous).\nscripts/img-ingest.mjs:170:  if (!ctx.dir) await ctx.openShard()\nscripts/img-ingest.mjs:206:  // manifeste : on connaît tout SAUF le commit SHA (rempli au flush). On stocke les morceaux et on laissera\nscripts/img-ingest.mjs:214:  return pending // résolu en blob final par resolveImgManifest() après ctx.flush()\nscripts/img-ingest.mjs:217:// Après flush() (commit SHA connus), transforme un `pending` en blob manifeste final { path, content }.\nscripts/img-ingest.mjs:220:  const commit = ctx.commitOf[pending.repo]\nscripts/img-ingest.mjs:221:  if (!commit) throw new Error('commit img shard manquant pour ' + pending.repo)\nscripts/img-ingest.mjs:225:    cdnRepo: pending.repo, cdnChunks: pending.cdnChunks, cdnCommit: commit,\nscripts/img-ingest.mjs:229:  if (pending.thumbPath) m.thumb = jsDelivrUrl(ctx.owner, pending.repo, commit, pending.thumbPath)\nscripts/img-ingest.mjs:235:// format standard 1080px/q60. thumbUrlForRegen reste : il résout juste l'URL jsDelivr après flush.\nscripts/img-ingest.mjs:236:export const thumbUrlForRegen = (ctx, repo, thumbPath) => jsDelivrUrl(ctx.owner, repo, ctx.commitOf[repo], thumbPath)\nscripts/img-ingest.mjs:286:  if (!ctx.dir) await ctx.openShard()\n  const GENV = { ...process.env, ...GIT_ENV }\n  const cloneUrl = (repo) => `https://x-access-token:${token}@github.com/${owner}/${repo}.git`\n  const git = (dir, a, timeout = 240000) => spawnSync('git', ['-C', dir, ...a], { encoding: 'utf8', env: GENV, timeout, killSignal: 'SIGKILL' })\n\n  const ctx = {\n    token, owner, work, key, log,\n    repo: null, dir: null, bytes: 0, pending: 0,\n    commitOf: {},          // repo -> commit SHA (rempli au flush ; pour pinner jsDelivr)\n    // staged[] : { repo, hashedPath, kind:'img'|'thumb' } — info de debug seulement.\n  }\n\n  // MODÈLE 2026-07-05 (décision Matthieu, même contrat que makeVidRawShardCtx) : repo NEUF par lot,\n  // nom aléatoire zenrayshards-img-<hex12>, PUBLIC (jsDelivr exige public — seule famille publique de la\n  // convention). ZÉRO clone d'un shard existant, ZÉRO check de place distant. Le découpage au sein d'un\n  // lot géant reste anticipé par compteur LOCAL (writeBinary). Ne JAMAIS recréer un ancien nom de repo :\n  // les vieux manifestes reposent sur la redirection GitHub ancien->nouveau nom (vérifiée OK le 2026-07-05\n  // sur raw.githubusercontent.com ET jsDelivr, chemins non cachés).\n  async function openShard() {\n    const { randomBytes } = await import('node:crypto')\n    ctx.repo = `zenrayshards-img-${randomBytes(6).toString('hex')}`\n    ctx.dir = path.join(work, ctx.repo)\n    await rm(ctx.dir, { recursive