: (await tree.json()).sha, parents: [headSha] }) }); if (!commit.ok) { await sleep(300 * (a + 1)); continue }\n      const upd = await ghI(token, 'git/refs/heads/main', { method: 'PATCH', body: JSON.stringify({ sha: (await commit.json()).sha, force: false }) })\n      if (upd.ok) return true\n      await sleep(300 * (a + 1)) // ref-update rejeté (non-fast-forward) -> RECOMMENCER sur un ref frais\n    } catch { await sleep(300 * (a + 1)) }\n  }\n  return false\n}\n// Ré-exportés (2026-07-14) pour scripts/index-add-paths.mjs : TOUT upload CLI en masse (upload-img-list*.mjs,\n// upload-vidraw-list.mjs, series-frame-references) doit appeler ce même appendPublicDelta après son commit\n// zenray-data, sinon les fichiers restent invisibles à la recherche jusqu'au prochain rebuild manuel — bug\n// trouvé le 2026-07-14 : AUCUN script CLI n'appelait `action=index-add` (mécanisme jusque-là réservé au drop/\n// Ctrl-V in-app via universalCapture.js). Named exports en plus du handler par défaut ; zéro changement de\n// comportement pour le serveur Vercel.\nexport { appendPublicDelta, thumbsForPaths, importMediaKeyCK }\n\n// VIGNETTE depuis un manifeste .img.json (vis-aware, MIROIR de build-search-index / ImageNodeViewer). Module-level\n// pour être réutilisée par index-add ET move/move-tree (sinon un média RENOMMÉ perd sa vignette dans l'index -> gris).\nconst _toWebp = (p) => (typeof p === 'string' ? p.replace(/\\.[^./]+$/, '.webp') : null)\nconst thumbEntryOf = (m) => {\n  if (!m || typeof m !== 'object') return null\n  // Gate élargi (2026-07-07) : accepte l'ancien schéma mono-fichier (cdnPath) ET le nouveau découpé en\n  // morceaux ≤19 Mo (cdnChunks[]) — la vignette n'est jamais chunkée, seul ce test de « manifeste public\n  // valide » doit reconnaître les deux formes, sinon une image récente perd sa vignette dans l'index.\n  const hasChunks = Array.isArray(m.cdnChunks) && m.cdnChunks.length > 0\n  if (m.vis === 'public' && m.cdnRepo && (m.cdnPath || hasChunks) && m.cdnCom