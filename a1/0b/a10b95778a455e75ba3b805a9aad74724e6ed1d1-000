EPO}/${path}`, { ...init, headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json', 'User-Agent': 'zenray-progress', ...(init.headers || {}) } })\nasync function importMediaKeyCK() { const { loadMediaKey } = await import('./media-key.js'); const raw = Uint8Array.from(Buffer.from(loadMediaKey(), 'base64')); return globalThis.crypto.subtle.importKey('raw', raw, { name: 'AES-GCM' }, false, ['encrypt', 'decrypt']) }\nasync function encSrv(key, str) { const iv = globalThis.crypto.getRandomValues(new Uint8Array(12)); const ct = new Uint8Array(await globalThis.crypto.subtle.encrypt({ name: 'AES-GCM', iv }, key, new TextEncoder().encode(str))); return { iv: Buffer.from(iv).toString('base64'), ct: Buffer.from(ct).toString('base64') } }\nasync function decSrv(key, blob) { const ct = Uint8Array.from(Buffer.from(blob.ct, 'base64')); const iv = Uint8Array.from(Buffer.from(blob.iv, 'base64')); return new TextDecoder().decode(new Uint8Array(await globalThis.crypto.subtle.decrypt({ name: 'AES-GCM', iv }, key, ct))) }\n// RETRY FAST-FORWARD (2026-07-14, même patron que commitTree ci-dessus) : à l'origine cette fonction ne\n// tentait qu'UNE fois — un appel isolé (drop/Ctrl-V in-app) ne se heurte quasiment jamais à un ref qui a\n// bougé entre-temps, donc le bug ne se voyait pas. Mais un rattrapage EN LOT (scripts/index-add-paths.mjs,\n// plusieurs dizaines d'appels séquentiels rapprochés sur le MÊME petit repo) le révèle : le taux d'échec\n// variait d'un run à l'autre sur les MÊMES lots (bug constaté 2026-07-14, ~15-25% de rejets non-fast-forward\n// à chaque run). Chaque tentative RELIT delta.json + le ref FRAIS (jamais la copie périmée d'avant) : un\n// autre écrivain concurrent ne fait donc jamais perdre de chemins, juste retarder cette tentative-ci.\nasync function appendPublicDelta(token, addPaths, addThumbs, rmPaths = [], tries = 5) {\n  for (let a = 0; a < tries; a++) {\n    try {\n      const key = await importMediaKeyCK()\n      let cur = { paths: