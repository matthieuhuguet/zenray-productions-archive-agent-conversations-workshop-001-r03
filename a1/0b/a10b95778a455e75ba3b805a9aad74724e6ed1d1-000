mage(ev, items.length > 1 ? `${items.length} éléments` : pgPretty(entry.name))\n  }\n  // Déplace PLUSIEURS nœuds vers un dossier, en parallèle borné. movePage route feuille->move / dossier->move-tree\n  // (tous deux retryés côté serveur) -> sûr en concurrence. Filtre les cibles invalides (soi-même / son sous-arbre).\n  // MULTI-DÉPLACEMENT (réécrit 2026-07-06, bugs réels signalés : « pas immédiat », « 2 échec(s) »,\n  // « médias disparus ») :\n  //  1. TOUTES les tuiles disparaissent à t=0 (avant : chacune au démarrage de SON move dans le pool).\n  //  2. Écritures SÉQUENTIELLES (avant : pool de 4 en parallèle -> 4 commits GitHub concurrents sur la\n  //     même branche = conflits de HEAD = les « échecs » aléatoires constatés). L'UI étant optimiste,\n  //     la durée réseau totale ne se voit plus ; la fiabilité prime.\n  //  3. UNE seule resynchro à la fin (movePage en mode batch ne déclenche ni loadTree ni resync d'échec) :\n  //     avant, chaque succès revalidait le dossier source EN PLEIN lot -> la vérité serveur mi-déplacée\n  //     écrasait l'état optimiste (tuiles qui réapparaissaient puis clignotaient). Sur échec(s), la\n  //     resynchro finale RAMÈNE les éléments non déplacés à leur place — jamais de fantômes.\n  const moveMany = async (paths, dir) => {\n    const list = [...new Set(paths)].filter((p) => p && p !== dir && !(dir + '/').startsWith(p + '/'))\n    if (!list.length) return\n    // entrées d'origine (pour peupler le cache destination avec les bons drapeaux/vignettes)\n    const entryOf = new Map((dirEntries || []).map((e) => [e.contentPath || e.dir, e]))\n    // 1) t=0 : retrait optimiste de TOUT le lot d'un coup (écran + cache source)\n    const bases = new Set(list.map((p) => stripLeafExt(p)))\n    optimisticDir((es) => es.filter((x) => !list.includes(x.contentPath) && !list.includes(x.dir) && !bases.has(x.dir)))\n    setSelected(new Set())\n    let okN = 0, failN = 0\n    for (const p of list) {\n      setStatus(`déplacement… ${okN + failN + 1}/${list.length}`)\n      const ok = await movePage(p, dir, { batch: true, entry: entryOf.get(p) })\n      if (ok) okN++; else failN++\n    }\n    // 3) fin de lot : une seule resynchro. Échec(s) -> cache source jeté (les éléments échoués reviennent).\n    if (failN) { dropDirCache(folder) }\n    loadDir(folder); loadPathsDebounced()\n    setStatus(failN ? `${okN} déplacé(s), ${failN} échec(s)` : 'déplacé ✓')\n    if (okN || failN) notify(failN\n      ? { icon: 'exclamationmark.triangle', tint: '#FF9F0A', label: 'Déplacement partiel', title: `${okN} déplacé(s), ${failN} échec(s)`, body: 'Les éléments non déplacés sont revenus à leur place — réessaie.' }\n      : { kind: 'success', label: 'Déplacé', title: `${okN} élément(s)`, body: `Dans ${pgPretty((dir.split('/').pop()) || 'le dossier')}.` })\n  }\n  // Liste des chemins qu'un drag depuis `entry` doit transporter (même règle multi-sélection que startDragEntry,\n  // réutilisée ici par le drag TACTILE ci-dessous — voir zrlongpressarm).\n  const dragListFor = (entry) => {\n    const group = (selected.has(entry.dir) && selected.size > 1) ? selectedItems() : [entry]\n    return group.filter((x) => x.contentPath || x.hasKids).map((x) => x.contentPath || x.dir)\n  }\n  // Drag tactile d'une tuile vers un segment du fil d'ariane (mobile, 2026-07-06). HTML5 drag-and-drop ne\n  // fonctionne pas au toucher (iOS/Android) : installLongPressContextMenu (uiPrefs.jsx) intercepte les\n  // tuiles (data-zr-dir) et émet `zrlongpressarm` après 450 ms d'immobilité au lieu du contextmenu direct.\n  // Ici on décide : si le doigt repart ensuite SANS bouger -> menu contextuel classique (inchangé) ; s'il\n  // se met à BOUGER -> on hit-teste les segments du fil d'ariane (data-crumb-path, posé sur Crumbs/Btn plus\n  // haut) sous le doigt et on relâche par un moveMany identique au drag desktop.\n  useEffect(() => {\n    const onArm = (ev) => {\n      const el = ev.target && ev.target.closest && ev.target.closest('[data-zr-dir]')\n      if (!el) return\n      const dirKey = el.getAttribute('data-zr-dir')\n      const entry = (shownRef.current || []).find((x) => x.dir === dirKey)\n      const fallbackCtx = () => el.dispatchEvent(new MouseEvent('contextmenu', { bubbles: true, cancelable: true, clientX: ev.detail.x, clientY: ev.detail.y, view: window }))\n      if (!entry || !(entry.contentPath || entry.hasKids)) { fallbackCtx(); return }\n      const list = dragListFor(entry)\n      if (!list.length) { fallbackCtx(); return }\n      let moved = false, hitPath = null\n      const move = (mv) => {\n        const t = mv.touches[0]; if (!t) return\n        if (!moved && (Math.abs(t.clientX - ev.detail.x) > 10 || Math.abs(t.clientY - ev.detail.y) > 10)) moved = true\n        if (!moved) return\n        mv.preventDefault()\n        const target = document.elementFromPoint(t.clientX, t.clientY)\n        const crumbEl = target && target.closest && target.closest('[data-crumb-path]')\n        hitPath = crumbEl ? crumbEl.getAttribute('data-crumb-path') : null\n        setCrumbDropPath(hitPath)\n      }\n      const end = () => {\n        window.removeEventListener('touchmove', move)\n        window.removeEventListener('touchend', end)\n        window.removeEventListener('touchcancel', end)\n        setCrumbDropPath(null)\n        if (moved) { if (hitPath) moveMany(list, hitPath) } else fallbackCtx()\n      }\n      window.addEventListener('touchmove', move, { passive: false })\n      window.addEventListener('touchend', end, { passive: true })\n      window.addEventListener('touchcancel', end, { passive: true })\n    }\n    window.addEventListener('zrlongpressarm', onArm)\n    return () => window.removeEventListener('zrlongpressarm', onArm)\n  }, [])\n  const copyPathsToClipboard = (explicitEntries = null) => {\n    const ps = (explicitEntries || selectedItems()).map((e) => e.contentPath || e.dir); if (!ps.length) return\n    try { navigator.clipboard.writeText(ps.join('\\n')) } catch {}\n    notify({ kind: 'info', label: 'Chemin copié', title: ps.length > 1 ? `${ps.length} chemins` : ps[0], body: 'Copié dans le presse-papier.' })\n  }\n  const markClip = (mode, explicitEntries = null) => {\n    const items = (explicitEntries || selectedItems()).map((e) => ({ dir: e.dir, contentPath: e.contentPath, name: e.name, hasKids: e.hasKids })); if (!items.length) return\n    clip.current = { mode, items }\n    notify({ kind: 'info', label: mode === 'cut' ? 'Couper' : 'Copier', title: `${items.length} élément(s)`, body: mode === 'cut' ? 'Coupé — colle (⌘V) dans un dossier.' : 'Copié — colle (⌘V) dans un dossier.' })\n  }\n  // Duplication SANS dupliquer le binaire : on recopie le(s) manifeste(s)/page(s). Les médias/images pointent\n  // vers le même blob hashé (ab/cd/<sha>), donc une \"copie\" = un nouveau manifeste, zéro octet binaire en plus.\n  // Copie réseau d'un nœud-feuille vers un chemin déjà calculé (lecture + écriture des jumeaux).\n  // Pour une image/média : le manifest .img.json/.media.json référence le binaire par HASH -> recopier le\n  // descripteur suffit, le binaire n'est JAMAIS re-téléchargé/ré-uploadé. Lancé en arrière-plan par pasteClip.\n  const copyNode = async ({ src, leaf, newBase }) => {\n    const exts = src.endsWith('.md') ? ['.md', '.blocknote.json', '.comments.json', '.props.json'] : [leaf]\n    // Les N jumeaux (.md/.blocknote.json/.comments.json/.props.json) sont indépendants entre eux (aucun\n    // n'a besoin du résultat d'un autre) -> read+save de chaque extension EN PARALLÈLE via Promise.all,\n    // au lieu d'un for...await qui attendait chaque paire avant de lancer la suivante (jusqu'à 4 allers-\n    // retours réseau séquentiels pour une seule page markdown).\n    await Promise.all(exts.map(async (ext) => {\n      const s = src.endsWith('.md') ? src.replace(/\\.md$/, ext) : src\n      const r = await fetch(`/api/page?action=read&path=${encodeURIComponent(s)}`, { cache: 'no-store' }).then((x) => x.json()).catch(() => null)\n      if (r && r.markdown != null && !r.missing) {\n        await apiPost('save', { path: newBase + ext, markdown: r.markdown })\n      }\n    }))\n  }\n  // Eagle link : unlike Finder \"Copier\", this does not duplicate a manifest.\n  // The server atomically creates one placement and registers/keeps the canonical\n  // resource; no ZenRayShards pipeline is involved.\n  const createEagleLinks = async (entries, dest) => {\n    const leaves = entries.filter((entry) => entry.contentPath && /\\.(img|media|file|canvas|embed|db)\\.json$/.test(entry.contentPath))\n    const folders = entries.filter((entry) => !entry.contentPath || entry.hasKids)\n    if (!leaves.length && !folders.length) { notify({ kind: 'info', label: 'Afficher aussi dans…', title: 'Aucun média compatible', body: 'Les liens Eagle couvrent tous les médias archivés et les dossiers d’assets.' }); return }\n    const taken = new Set((dest === folder ? (dirEntries || []) : []).map((entry) => entry.name.toLowerCase()))\n    const targetFor = (entry) => {\n      const leaf = leafExtension(entry.contentPath)\n      const root = entry.name || 'média'\n      let name = root; let n = 2\n      while (taken.has(name.toLowerCase())) { name = `${root} ${n++}` }\n      taken.add(name.toLowerCase())\n      return `${dest}/${name}${leaf}`\n    }\n    const leafPlan = leaves.map((entry) => ({ kind: 'leaf', entry, targetPath: targetFor(entry) }))\n    const folderPlan = folders.map((entry) => {\n      const root = entry.name || entry.dir.split('/').pop() || 'dossier'\n      let name = root; let n = 2\n      while (taken.has(name.toLowerCase())) name = `${root} ${n++}`\n      taken.add(name.toLowerCase())\n      return { kind: 'folder', entry, targetDir: `${dest}/${name}` }\n    })\n    const plan = [...leafPlan, ...folderPlan]\n    setStatus(`création des liens… 0/${plan.length}`)\n    const results = []\n    for (const [index, item] of plan.entries()) {\n      const result = item.kind === 'folder'\n        ? await apiPost('create-eagle