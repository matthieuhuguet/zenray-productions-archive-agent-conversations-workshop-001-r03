optimisticDir) ; une rafale = au plus 2 fetch (le vol en cours + 1 reprise), au lieu de N.\n  const loadDir = (f) => {\n    if (dirInflight.current.has(f)) { dirRerun.current.add(f); return dirInflight.current.get(f) }\n    const p = (async () => {\n      try { await loadDirOnce(f) } finally {\n        dirInflight.current.delete(f)\n        if (dirRerun.current.has(f)) { dirRerun.current.delete(f); loadDir(f) } // 1 seule reprise pour l'état final\n      }\n    })()\n    dirInflight.current.set(f, p)\n    return p\n  }\n  // PRÉCHARGEMENT AU SURVOL (2026-07-06, perf dossiers) : survoler une tuile-dossier ~150 ms lance le fetch\n  // de SON listing en fond -> le double-clic qui suit trouve le cache déjà chaud (ouverture 0,1 s même pour\n  // un dossier jamais visité). Ne touche PAS l'écran (writeDirCache seulement), dédupliqué (1 fetch par\n  // dossier max), et sauté si un cache existe déjà (le SWR normal suffit alors).\n  const prefetched = useRef(new Set())\n  const prefetchTimer = useRef(null)\n  const prefetchDir = (e) => {\n    if (!e || !(e.hasKids || !e.contentPath)) return // seuls les dossiers se préchargent\n    const f = e.dir\n    if (!f || prefetched.current.has(f) || readDirCache(f)) return\n    if (prefetchTimer.current) clearTimeout(prefetchTimer.current)\n    prefetchTimer.current = setTimeout(async () => {\n      if (prefetched.current.has(f) || readDirCache(f)) return\n      prefetched.current.add(f)\n      const j = await fetch(`/api/page?action=children&dir=${encodeURIComponent(f)}`).then((r) => r.json()).catch(() => null)\n      if (j && Array.isArray(j.entries)) writeDirCache(f, (f === 'Memory' || f.startsWith('Memory/')) ? buildMemoryEntries(j.entries, f) : buildDirEntries(j.entries, f))\n      else prefetched.current.delete(f) // échec -> re-tentable au prochain survol\n    }, 150)\n  }\n  const loadPaths = async () => {\n    const j = await fetchJSONRetry('/api/page?action=tree')\n    if (j && Array.isArray(j.paths)) {\n      // PERF : le poll 25 s (ci-dessous) rappelle ceci en continu même quand l'arbre n'a pas bougé. Si le\n      // contenu est identique à ce qu'on a déjà, on garde l'ancienne RÉFÉRENCE `paths` (pas de setPaths) ->\n      // pathNorms/nonEmptyDirs (useMemo dépendants de `paths`/`allPaths`) ne recalculent pas pour rien.\n      // pathsRef reste à jour dans tous les cas (miroir synchrone utilisé par les écritures optimistes).\n      const changed = !sameStringArray(pathsRef.current, j.paths)\n      pathsRef.current = j.paths\n      if (changed) setPaths(j.paths)\n    }\n    else setPaths((prev) => (prev && prev.length ? prev : []))\n  }\n  // loadPaths est le VRAI tueur de latence (arbre git récursif ~10 Mo). On le SORT du chemin critique :\n  // après une écriture, on rafraîchit le dossier courant tout de suite (rapide), mais l'arbre global n'est\n  // ré-aspiré qu'après 800 ms d'inactivité (debounce). Plusieurs ops rapprochées = 1 seul gros fetch.\n  const loadPathsTimer = useRef(null)\n  const loadPathsDebounced = () => {\n    if (loadPathsTimer.current) clearTimeout(loadPathsTimer.current)\n    loadPathsTimer.current = setTimeout(() => { loadPathsTimer.current = null; loadPaths() }, 800)\n  }\n  // loadTree() = rafraîchit le dossier courant (rapide, non bloquant) + l'index global (debounce, secondaire).\n  const loadTree = () => { loadDir(folder); loadPathsDebounced() }\n  // Vide TOUS les caches Create. À lancer APRÈS une migration média (les manifests changent d'URL/visibilité,\n  // sinon l'app sert les anciennes URLs en cache). Purge : listings (RAM+sessionStorage), manifests image,\n  // cache image persistant IndexedDB, index de recherche, et les caches de couverture/titre/commentaire des tuiles.\n  const clearCreateCaches = async () => {\n    setStatus('vidage du cache…')\n    clearAllDirCache(); clearManifestCache(); clearPageReadCache(); invalidateSearchIndex()\n    for (const cache of [_thumbCache, _labelCache, _commentCountCache]) {\n      for (const key of Object.keys(cache)) delete cache[key]\n    }\n    // _mediaMimeMem/_mediaPosterMem/_mediaDurMem/_fileThumbMem/_videoCardMem sont des createLruCache (pas des\n    // objets bruts) depuis leur passage en LRU borné : purge via leur propre .clear(), pas Object.keys/delete.\n    for (const cache of [_mediaMimeMem, _mediaPosterMem, _mediaDurMem, _fileThumbMem, _videoCardMem]) cache.clear()\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f7718-8139-7212-92ac-5a47b520d9a5"}}}
