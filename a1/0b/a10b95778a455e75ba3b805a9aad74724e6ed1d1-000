new Date().toISOString()\n        const idsByResource = new Map()\n        for (const item of prepared) {\n          const key = `${item.kind}:${item.kind === 'folder' ? item.sourceDir : item.canonicalPath}`\n          if (!idsByResource.has(key)) idsByResource.set(key, item.resourceId || resourceIdOf())\n          item.resourceId = idsByResource.get(key)\n        }\n        const uniqueIds = [...new Set(prepared.map((x) => x.resourceId))]\n        const registries = new Map(await Promise.all(uniqueIds.map(async (id) => [id, await rawJsonAt(token, resourcePathOf(id))])))\n        const writes = new Map()\n        const resourceRecords = new Map()\n        const putJson = (path, value) => writes.set(path, { path, mode: '100644', type: 'blob', content: JSON.stringify(value, null, 2) })\n        for (const item of prepared) {\n          let record = resourceRecords.get(item.resourceId)\n          if (!record) {\n            const previous = registries.get(item.resourceId)\n            record = { ...(previous && previous.resourceId === item.resourceId ? previous : {}), v: 1, type: 'zenray-eagle-resource/v1', resourceId: item.resourceId, createdAt: previous?.createdAt || now, placements: new Set(Array.isArray(previous?.placements) ? previous.placements : []) }\n            resourceRecords.set(item.resourceId, record)\n          }\n          if (item.kind === 'folder') {\n            record.kind = 'folder'; record.sourceDir = item.sourceDir; record.placements.add(item.sourceDir); record.placements.add(item.targetDir)\n            putJson(`${item.sourceDir}/${EAGLE_FOLDER_RESOURCE_FILE}`, { v: 1, type: 'zenray-eagle-folder-resource/v1', resourceId: item.resourceId })\n            putJson(`${item.targetDir}/${EAGLE_FOLDER_LINK_FILE}`, { v: 1, type: EAGLE_FOLDER_LINK_TYPE, resourceId: item.resourceId, title: item.title, createdAt: now })\n          } else {\n            record.kind = item.canonicalPath.match(EAGLE_LINK_RE)?.[1] || 'file'; record.sourcePath = item.canonicalPa