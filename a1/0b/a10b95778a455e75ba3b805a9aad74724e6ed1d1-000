<FadeImg key={'f' + page.img} src={page.img} alt={name} overlay={!!page.thumb} />}\n      </div>\n    )\n    else body = <div style={{ color: '#fff', opacity: 0.7 }}>image introuvable</div>\n  } else if (type === 'page') {\n    if (page === null) body = <div style={{ color: '#fff', opacity: 0.7 }}>chargement…</div>\n    else if (page.img) body = <img src={page.img} alt={name} style={{ maxWidth: '92vw', maxHeight: '82vh', objectFit: 'contain', borderRadius: RADII.md, boxShadow: '0 20px 60px rgba(0,0,0,0.5)' }} />\n    else body = <div className=\"zr-quicklook-chrome\" style={{ maxWidth: 'min(820px,90vw)', maxHeight: '82vh', overflow: 'auto', padding: '28px 34px', borderRadius: RADII.lg, color: '#ECECEA', whiteSpace: 'pre-wrap', fontSize: 15, lineHeight: 1.6 }}>{(page.md || '').slice(0, 6000)}</div>\n  } else if (type === 'file') {\n    const f = file\n    const mime = (f && f.mime) || ''\n    if (!f || (f.prog != null && !f.url)) body = <div style={{ color: '#fff', opacity: 0.7 }}>reconstitution…{f && f.prog != null ? ` ${Math.round(f.prog * 100)}%` : ''}</div>\n    else if (f.err) body = <div style={{ color: '#fff', opacity: 0.7 }}>erreur de reconstitution</div>\n    else if (f.tooBig) body = <div style={{ color: '#fff', opacity: 0.7 }}>trop volumineux pour l’aperçu — Entrée pour télécharger</div>\n    else if (f.unsupported) body = <div style={{ color: '#fff', opacity: 0.7 }}>aperçu indisponible pour ce type — Entrée pour ouvrir</div>\n    // LIB (docx/xlsx/heic/tiff/epub/3D) : décodeur dynamique lazy. AVANT le branchement image (heic a mime image/* mais exige heic2any).\n    else if (f.url && LIB_KINDS.has(f.kind)) body = <React.Suspense fallback={<div style={{ color: '#fff', opacity: 0.7 }}>décodage…</div>}><LazyLibPreview url={f.url} name={item.name} kind={f.kind} /></React.Suspense>\n    else if (f.url && mime.startsWith('image/')) body = <img src={f.url} alt={name} style={{ maxWidth: '92vw', maxHeight: '82vh', objectFit: 'contain', borderRadius: RADII.md, boxShadow: '0 20px 60px rgba(0,0,0,0.5)' }} />\n    else if (f.url && mime.startsWith('video/') && !f.playErr) body = <video src={f.url} controls autoPlay onError={() => setFile((x) => (x ? { ...x, playErr: true } : x))} style={{ maxWidth: '92vw', maxHeight: '82vh', borderRadius: RADII.md, background: '#000' }} />\n    else if (f.url && f.playErr) body = <div style={{ color: '#fff', opacity: 0.7, textAlign: 'center', lineHeight: 1.6 }}>Codec non lisible par le navigateur (.mov ProRes/HEVC).<br />Entrée pour télécharger.</div>\n    else if (f.url && mime.startsWith('audio/')) body = <audio src={f.url} controls autoPlay style={{ width: 460 }} />\n    else if (f.url && mime === 'application/pdf') body = <iframe title={name} src={f.url} style={{ width: '82vw', height: '82vh', border: 'none', borderRadius: RADII.md, background: '#fff' }} />\n    else if (f.url && f.text != null) body = <div className=\"zr-quicklook-chrome\" style={{ maxWidth: 'min(820px,90vw)', maxHeight: '82vh', overflow: 'auto', padding: '28px 34px', borderRadius: RADII.lg, color: '#ECECEA', whiteSpace: 'pre-wrap', fontFamily: 'monospace', fontSize: 13, lineHeight: 1.55 }}>{(f.text || '').slice(0, 100000)}</div>\n    else body = <div style={{ color: '#fff', opacity: 0.7 }}>aperçu indisponible</div>\n  } else if (type === 'db') {\n    body = <div className=\"zr-quicklook-chrome\" style={{ padding: '40px 56px', borderRadius: RADII.lg, color: '#fff', textAlign: 'center', display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 10 }}><Icon name=\"tablecells\" size={46} grad /><div>Table — Entrée pour ouvrir</div></div>\n  } else {\n    body = <div className=\"zr-quicklook-chrome\" style={{ padding: '40px 56px', borderRadius: RADII.lg, color: '#fff', textAlign: 'center', display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 10 }}><Icon name=\"folder\" size={46} grad /><div>Dossier — Entrée pour ouvrir</div></div>\n  }\n\n  // Provenance du média, UNIFIÉE en une liste de segments {label,color} pour image/file/media -> rendue\n  // derrière une pastille toggle (masquée par défaut depuis 2026-07-12 : le texte technique cassait le\n  // design minimaliste ; on garde l'info, accessible en un clic). [] si inconnue (ex. manifeste image pas\n  // encore chargé) -> aucune pastille affichée.\n  const srcSegs = type === 'image' ? imageSourceSegments(page && page.manifest)\n    : type === 'file' ? [{ label: 'parts raw.github', color: '#8b5cf6' }]\n    : (type === 'media' && mediaManifest && mediaManifest.type === 'youtube') ? [{ label: mediaManifest.audioOnly ? 'YouTube (audio)' : 'YouTube (vidéo)', color: '#ff0000' }]\n    : (type === 'media' && mediaManifest && mediaManifest.type === 'gmaps') ? [{ label: 'Google Maps', color: '#34a853' }]\n    : type === 'media' ? [{ label: 'flux /api (déchiffré)', color: '#34c759' }]\n    : []\n\n  return (\n    <div className=\"zr-quicklook-backdrop\" onClick={onClose} style={{ position: 'fixed', inset: 0, zIndex: 200, display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center' }}>\n      {/* nav gauche/droite */}\n      <button onClick={(e) => { e.stopPropagation(); onPrev() }} style={navBtn('left')}><Icon name=\"chevron.left\" size={24} weight={1.8} color=\"#fff\" /></button>\n      <button onClick={(e) => { e.stopPropagation(); onNext() }} style={navBtn('right')}><Icon name=\"chevron.right\" size={24} weight={1.8} color=\"#fff\" /></button>\n      <div onClick={(e) => e.stopPropagation()} style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 14 }}>\n        {body}\n        <div style={{ display: 'flex', alignItems: 'center', gap: 14, color: '#fff' }}>\n          <span style={{ fontSize: 14, fontWeight: 600, maxWidth: '70vw', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{name}</span>\n          {/* BADGE SOURCE CDN — d'où vient RÉELLEMENT le média (jsDelivr chiffré / raw.github / YouTube / …).\n              MASQUÉ par défaut (2026-07-12, demande Matthieu : le texte technique cassait le minimalisme) :\n              on n'affiche qu'une petite PASTILLE de la couleur de la source ; clic -> déplie le texte complet ;\n              re-clic -> replie. srcSegs (calculé plus haut) porte la vraie provenance, jamais figée. */}\n          {srcSegs.length > 0 && (\n            showSrc ? (\n              <span onClick={(e) => { e.stopPropagation(); setShowSrc(false) }} title=\"Masquer la source\" style={{ display: 'inline-flex', alignItems: 'center', gap: 8, fontFamily: \"'AnthropicMono', ui-monospace, monospace\", fontSize: 11, color: 'rgba(255,255,255,0.82)', background: 'rgba(255,255,255,0.12)', border: '1px solid rgba(255,255,255,0.18)', borderRadius: 999, padding: '4px 11px', cursor: 'pointer' }}>\n                {srcSegs.map((s, i) => (\n                  <React.Fragment key={i}>\n                    {i > 0 && <span style={{ opacity: 0.5 }}>·</span>}\n                    <span style={{ display: 'inline-flex', alignItems: 'center', gap: 4 }}><i style={{ width: 7, height: 7, borderRadius: '50%', background: s.color }} />{s.label}</span>\n                  </React.Fragment>\n                ))}\n              </span>\n            ) : (\n              <button onClick={(e) => { e.stopPropagation(); setShowSrc(true) }} title=\"Afficher la source du média\" aria-label=\"Afficher la source du média\" style={{ background: 'transparent', border: 'none', padding: 4, cursor: 'pointer', display: 'inline-flex', alignItems: 'center', lineHeight: 0 }}>\n                <i style={{ width: 9, height: 9, borderRadius: '50%', background: srcSegs[0].color, boxShadow: '0 0 0 3px rgba(255,255,255,0.14)' }} />\n              </button>\n            )\n          )}\n          {(type === 'image' || type === 'file') && item.contentPath && <button onClick={(e) => { e.stopPropagation(); downloadMedia(item.contentPath, item.name).catch(() => {}) }} style={{ background: 'rgba(255,255,255,0.16)', color: '#fff', border: 'none', borderRadius: RADII.sm, padding: '6px 14px', cursor: 'pointer', fontSize: 13, fontWeight: 600 }}>Télécharger</button>}\n          <button onClick={(e) => { e.stopPropagation(); onOpen() }} style={{ background: PALETTE.gradient, color: '#fff', border: 'none', borderRadius: RADII.sm, padding: '6px 16px', cursor: 'pointer', fontSize: 13, fontWeight: 600 }}>Ouvrir</button>\n        </div>\n      </div>\n      <div style={{ position: 'fixed', top: 18, right: 22, color: 'rgba(255,255,255,0.6)', fontSize: 12, fontFamily: 'monospace' }}>Espace/Échap fermer · ←/→ naviguer</div>\n    </div>\n  )\n}\nfunction navBtn(side) {\n  return { position: 'fixed', top: '50%', [side]: 24, transform: 'translateY(-50%)', background: 'rgba(255,255,255,0.14)', border: 'none', color: '#fff', width: 48, height: 48, borderRadius: 99, cursor: 'pointer', display: 'flex', alignItems: 'center', justifyContent: 'center', zIndex: 201 }\n}\n// fileKinds.js — SOURCE UNIQUE extension -> MIME -> catégorie d'aperçu. Isomorphe (aucune dépendance navigateur),\n// importé À LA FOIS par l'UPLOAD (Scripts/video-raw-lib.mjs mimeOf) ET par le VIEWER (QuickLook). Une seule vérité :\n// un futur upload et son aperçu ne peuvent JAMAIS diverger sur le type. Étendre ICI = couvrir upload + lecture d'un coup.\n\n// MIME par extension (minuscule, sans le point). Exhaustif sur les formats populaires.\nexport const MIME_BY_EXT = {\n  // audio\n  wav: 'audio/wav', wave: 'audio/wav', mp3: 'audio/mpeg', mp2: 'audio/mpeg', mp1: 'audio/mpeg',\n  m4a: 'audio/mp4', m4b: 'audio/mp4', m4p: 'audio/mp4', flac: 'audio/flac', alac: 'audio/mp4',\n  ogg: 'audio/ogg', oga: 'audio/ogg', spx: 'audio/ogg', aac: 'audio/aac', adts: 'audio/aac',\n  aiff: 'audio/aiff', aif: 'audio/aiff', aifc: 'audio/aiff', caf: 'audio/x-caf', opus: 'audio/opus',\n  wma: 'audio/x-ms-wma', weba: 'audio/webm', ape: 'audio/ape', wv: 'audio/wavpack', tta: 'audio/x-tta',\n  mka: 'audio/x-matroska', ac3: 'audio/ac3', eac3: 'audio/eac3', dts: 'audio/vnd.dts', amr: 'audio/amr',\n  '3ga': 'audio/3gpp', au: 'audio/basic', snd: 'audio/basic', ra: 'audio/vnd.rn-realaudio', ram: 'audio/vnd.rn-realaudio',\n  dsf: 'audio/dsd', dff: 'audio/dsd', mid: 'audio/midi', midi: 'audio/midi',\n  // vidéo\n  mp4: 'video/mp4', m4v: 'video/mp4', mov: 'video/quicktime', webm: 'video/webm', mkv: 'video/x-matroska',\n  avi: 'video/x-msvideo', flv: 'video/x-flv', wmv: 'video/x-ms-wmv', mpg: 'video/mpeg', mpeg: 'video/mpeg', '3gp': 'video/3gpp',\n  // image\n  jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', gif: 'image/gif', webp: 'image/webp', avif: 'image/avif',\n  bmp: 'image/bmp', svg: 'image/svg+xml', ico: 'image/x-icon', jfif: 'image/jpeg', heic: 'image/heic', heif: 'image/heif',\n  tif: 'image/tiff', tiff: 'image/tiff', dng: 'image/x-adobe-dng', psd: 'image/vnd.adobe.photoshop',\n  // documents\n  pdf: 'application/pdf', epub: 'application/epub+zip', rtf: 'application/rtf',\n  doc: 'application/msword', docx: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',\n  xls: 'application/vnd.ms-excel', xlsx: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',\n  ppt: 'application/vnd.ms-powerpoint', pptx: 'application/vnd.openxmlformats-officedocument.presentationml.presentation',\n  // texte\n  txt: 'text/plain', md: 'text/markdown', markdown: 'text/markdown', csv: 'text/csv', tsv: 'text/tab-separated-values',\n  log: 'text/plain', rtf_: 'text/plain',\n  // code (servi en text/plain pour aperçu <pre>, langage gardé à part)\n  js: 'text/javascript', mjs: 'text/javascript', cjs: 'text/javascript', ts: 'text/plain', tsx: 'text/plain', jsx: 'text/plain',\n  py: 'text/x-python', rb: 'text/x-ruby', php: 'text/x-php', java: 'text/x-java', c: 'text/x-c', h: 'text/x-c',\n  cpp: 'text/x-c++', cc: 'text/x-c++', hpp: 'text/x-c++', cs: 'text/x-csharp', go: 'text/x-go', rs: 'text/x-rust',\n  swift: 'text/x-swift', kt: 'text/x-kotlin', scala: 'text/x-scala', sh: 'text/x-sh', bash: 'text/x-sh', zsh: 'text/x-sh',\n  lua: 'text/x-lua', r: 'text/x-r', sql: 'text/x-sql', html: 'text/html', htm: 'text/html', css: 'text/css',\n  scss: 'text/x-scss', json: 'application/json', yaml: 'text/yaml', yml: 'text/yaml', toml: 'text/x-toml',\n  xml: 'text/xml', ini: 'text/plain', env: 'text/plain', conf: 'text/plain', cube: 'text/plain', vue: 'text/plain', svelte: 'text/plain',\n  dart: 'text/x-dart', graphql: 'text/plain', gql: 'text/plain', dockerfile: 'text/plain', gitignore: 'text/plain',\n  // archives / 3D / binaire\n  zip: 'application/zip', tar: 'application/x-tar', gz: 'application/gzip', '7z': 'application/x-7z-compressed', rar: 'application/x-rar',\n  glb: 'model/gltf-binary', gltf: 'model/gltf+json', obj: 'model/obj', stl: 'model/stl', fbx: 'model/fbx',\n}\n\n// Extensions traitées comme CODE/TEXTE même si le mime n'est pas text/* (aperçu <pre>).\nconst TEXTUAL_EXT = new Set(['md', 'markdown', 'txt', 'csv', 'tsv', 'log', 'json', 'yaml', 'yml', 'toml', 'xml', 'html', 'htm', 'css', 'scss',\n  'js', 'mjs', 'cjs', 'ts', 'tsx', 'jsx', 'py', 'rb', 'php', 'java', 'c', 'h', 'cpp', 'cc', 'hpp', 'cs', 'go', 'rs', 'swift', 'kt',\n  'scala', 'sh', 'bash', 'zsh', 'lua', 'r', 'sql', 'ini', 'env', 'conf', 'cube', 'vue', 'svelte', 'dart', 'graphql', 'gql', 'dockerfile', 'gitignore'])\n\nexport const extOf = (name) => (String(name || '').match(/\\.([a-z0-9]+)$/i) || [, ''])[1].toLowerCase()\nexport const mimeForName = (name) => MIME_BY_EXT[extOf(name)] || 'application/octet-stream'\n\n// Catégorie d'aperçu — pilote le rendu dans le viewer. 'lib' = besoin d'un décodeur dynamique (lazy).\nexport function kindForName(name) {\n  const e = extOf(name)\n  const mime = MIME_BY_EXT[e] || ''\n  if (mime.startsWith('audio/')) return 'audio'\n  if (mime.startsWith('video/')) return 'video'\n  // PSD exclu volontairement : LibFilePreview route image-lib vers le décodeur TIFF (UTIF), et un PSD (format\n  // Adobe propre, jamais du TIFF) échouerait SYSTÉMATIQUEMENT le décodage -> mieux vaut le message \"aperçu\n  // indisponible\" immédiat (catégorie par défaut 'binary') qu'une tentative de décodage vouée à l'échec à coup\n  // sûr. DNG reste en image-lib : beaucoup de DNG sont bâtis sur TIFF/EP et se décodent réellement via UTIF.\n  if (e === 'heic' || e === 'heif' || e === 'tif' || e === 'tiff' || e === 'dng') return 'image-lib'\n  if (mime.startsWith('image/')) return 'image'\n  if (e === 'pdf') return 'pdf'\n  if (TEXTUAL_EXT.has(e)) return 'text'\n  if (e === 'docx' || e === 'doc' || e === 'rtf') return 'doc-lib'\n  if (e === 'xlsx' || e === 'xls') return 'sheet-lib'\n  if (e === 'pptx' || e === 'ppt') return 'slides-lib'\n  if (e === 'epub') return 'epub-lib'\n  if (e === 'glb' || e === 'gltf' || e === 'obj' || e === 'stl' || e === 'fbx') return '3d-lib'\n  if (e === 'zip' || e === 'tar' || e === 'gz' || e === '7z' || e === 'rar') return 'archive'\n  return 'binary'\n}\n\n// Aperçu NATIF possible (sans dépendance) ?\nexport const isNativePreview = (name) => ['audio', 'video', 'image', 'pdf', 'text'].includes(kindForName(name))\n{\n  \"name\": \"zenray-progress\",\n  \"private\": true,\n  \"version\": \"0.1.0\",\n  \"type\": \"module\",\n  \"description\": \"ZenRayProgress — LifeOS de Matthieu Huguet : tableau de bord d'objectifs + agenda hebdomadaire, persistant.\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"vite build\",\n    \"preview\": \"vite preview\",\n    \"test\": \"vitest run\",\n    \"test:watch\": \"vitest\",\n    \"test:music\": \"vitest run src/audio src/create --passWithNoTests\",\n    \"test:e2e\": \"playwright test\",\n    \"predev\": \"node scripts/copy-ffmpeg-core.mjs\",\n    \"prebuild\": \"node scripts/copy-ffmpeg-core.mjs\"\n  },\n  \"dependencies\": {\n    \"@blocknote/core\": \"^0.51.3\",\n    \"@blocknote/mantine\": \"^0.51.3\",\n    \"@blocknote/react\": \"^0.51.3\",\n    \"@ffmpeg/core\": \"^0.12.10\",\n    \"@ffmpeg/ffmpeg\": \"^0.12.15\",\n    \"@ffmpeg/util\": \"^0.12.2\",\n    \"@upstash/redis\": \"^1.34.3\",\n    \"@vercel/analytics\":