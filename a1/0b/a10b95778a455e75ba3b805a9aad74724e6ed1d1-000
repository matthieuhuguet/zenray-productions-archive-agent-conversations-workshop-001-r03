 Payload {items:[...]} pour le multi, {path,name} pour le simple (compat drop existant).\n  const startDragEntry = (ev, entry) => {\n    const group = (selected.has(entry.dir) && selected.size > 1) ? selectedItems() : [entry]\n    const items = group.filter((x) => x.contentPath || x.hasKids).map((x) => ({ path: x.contentPath || x.dir, name: x.name }))\n    const payload = items.length > 1 ? { items } : { path: entry.contentPath || entry.dir, name: entry.name }\n    ev.dataTransfer.setData('application/zenray-page', JSON.stringify(payload))\n    ev.dataTransfer.effectAllowed = 'move'\n    setFinderDragImage(ev, items.length > 1 ? `${items.length} éléments` : pgPretty(entry.name))\n  }\n  // Déplace PLUSIEURS nœuds vers un dossier, en parallèle borné. movePage route feuille->move / dossier->move-tree\n  // (tous deux retryés côté serveur) -> sûr en concurrence. Filtre les cibles invalides (soi-même / son sous-arbre).\n  // MULTI-DÉPLACEMENT (réécrit 2026-07-06, bugs réels signalés : « pas immédiat », « 2 échec(s) »,\n  // « médias disparus ») :\n  //  1. TOUTES les tuiles disparaissent à t=0 (avant : chacune au démarrage de SON move dans le pool).\n  //  2. Écritures SÉQUENTIELLES (avant : pool de 4 en parallèle -> 4 commits GitHub concurrents sur la\n  //     même branche = conflits de HEAD = les « échecs » aléatoires constatés). L'UI étant optimiste,\n  //     la durée réseau totale ne se voit plus ; la fiabilité prime.\n  //  3. UNE seule resynchro à la fin (movePage en mode batch ne déclenche ni loadTree ni resync d'échec) :\n  //     avant, chaque succès revalidait le dossier source EN PLEIN lot -> la vérité serveur mi-déplacée\n  //     écrasait l'état optimiste (tuiles qui réapparaissaient puis clignotaient). Sur échec(s), la\n  //     resynchro finale RAMÈNE les éléments non déplacés à leur place — jamais de fantômes.\n  const moveMany = async (paths, dir) => {\n    const list = [...new Set(paths)].filter((p) => p && p !== dir && !(dir + '/').startsWith(p + '/