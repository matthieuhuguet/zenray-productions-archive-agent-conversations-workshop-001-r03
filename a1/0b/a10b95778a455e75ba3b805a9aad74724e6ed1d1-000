{"timestamp":"2026-07-18T16:17:36.289Z","ordinal":387,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f7604-d621-7e73-a9de-442f7672f54b","call_id":"call_4LEBQJ7uhEriexxD8fRtvRft","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"        // .file.json (blob-raw / archive) : descripteur JSON autonome référençant les parts par hash,\n        // exactement comme .db.json/.canvas.json/.embed.json -> même déplacement atomique (BUG trouvé\n        // 2026-07-01 : absent d'isSolo, donc tout drag-and-drop d'un fichier brut/archive échouait en\n        // 400 bad-path côté serveur, silencieusement absorbé par le catch client -> tuile qui semblait\n        // \"ne rien faire\").\n        const isFile = from.endsWith('.file.json') && to.endsWith('.file.json')\n        const isSolo = isDb || isCanvas || isEmbed || isFile\n        if (!safe(from) || !safe(to) || !(isMedia || isImg || isSolo || (from.endsWith('.md') && to.endsWith('.md')))) return res.status(400).json({ error: 'bad-path' })\n        if (from === to) return res.status(200).json({ error: 'same-path' })\n        // refuse si la cible existe déjà\n        const exists = await gh(token, `contents/${encodeURI(to)}?ref=${BRANCH}`)\n        if (exists.ok) return res.status(200).json({ error: 'exists' })\n        // ATOMIQUE : on collecte tous les fichiers a deplacer (1 descripteur pour media/image/solo ; .md + 3\n        // jumeaux pour une page), on construit les entrees d'arbre (cree a la cible en REUTILISANT le blob\n        // existant par sha + supprime la source) et on commit le TOUT en une fois avec retry. Les binaires\n        // (parts media, vignettes d'image) ne bougent jamais (references par hash absolu). Plus de noeud scinde.\n        const twin = (p, ext) => p.replace(/\\.md$/, ext)\n        const srcs = (isMedia || isImg || isSolo)\n          ? [[from, to]]\n          : [['.md'], ['.blocknote.json'], ['.comments.json'], ['.props.json']].map(([e]) => [twin(from, e), twin(to, e)])\n        // P7 (perf) : les lectures des fichiers-jumeaux sont indépendantes -> Promise.all au lieu d'une file\n        // indienne de GET (jusqu'à 4 séquentiels pour une page : .md + .blocknote/.comments/.props.json). Même\n        // pattern que move-tree juste en dessous. Comportement identique : 404 = ignoré, 1ère lecture en échec =\n        // même erreur 'github read <src>', ordre des entrées préservé (l'ordre dans un tree commit est sans effet).\n        const reads = await Promise.all(srcs.map(async ([src, dst]) => {\n          const rr = await gh(token, `contents/${encodeURI(src)}?ref=${BRANCH}`)\n          if (rr.status === 404) return { skip: true }\n          if (!rr.ok) return { error: 'read ' + src }\n          const jj = await rr.json()\n          return { src, dst, sha: jj.sha, markdown: b64d(jj.content) }\n        }))\n        const bad = reads.find((r) => r.error)\n        if (bad) return res.status(200).json({ error: 'github', detail: bad.error })\n        const entries = []\n        const moved = []\n        for (const r of reads) {\n          if (r.skip) continue\n          entries.push({ path: r.dst, mode: '100644', type: 'blob', sha: r.sha })\n          entries.push({ path: r.src, mode: '100644', type: 'blob', sha: null })\n          moved.push(r.dst)\n        }\n        // A canonical placement may be renamed/moved. Update only its registry;\n        // moving a lightweight link must not steal ownership from the real asset.\n        const primary = reads.find((r) => !r.skip && r.src === from)\n        if (primary && (isMedia || isImg || isSolo)) {\n          try {\n            const manifest = JSON.parse(primary.markdown)\n            if (!isEagleLink(manifest) && typeof manifest.resourceId === 'string') {\n              const rp = resourcePathOf(manifest.resourceId)\n              const rr = await gh(token, `contents/${encodeURI(rp)}?ref=${BRANCH}`)\n              if (rr.ok) {\n                const registry = JSON.parse(b64d((await rr.json()).content))\n                if (registry && registry.resourceId === manifest.resourceId && registry.sourcePath === from) {\n                  registry.sourcePath = to\n                  registry.updatedAt = new Date().toISOString()\n                  const rb = await jsonBlob(token, registry)\n                  if (rb) entries.push({ path: rp, mode: '100644', type: 'blob', sha: rb })\n                }\n              }\n            }\n          } catch {}\n        }\n        if (!entries.length) return res.status(200).json({ error: 'empty' })\n        const mv = await commitTree(token, entries, 'content move')\n        if (!mv.ok) return res.status(200).json({ error: 'github', detail: mv.error })\n        // Auto-index : nouveau chemin du nœud ajouté au delta, ancien chemin marqué rm (sinon recherche stale).\n        const MOVE_NODE_RE = /\\.(md|db\\.json|media\\.json|img\\.json|canvas\\.json|embed\\.json|file\\.json)$/\n        const newN = moved.filter((p) => MOVE_NODE_RE.test(p))\n        const oldN = reads.filter((r) => !r.skip && MOVE_NODE_RE.test(r.src)).map((r) => r.src)\n        // Vignettes des nœuds DÉPLACÉS/RENOMMÉS : sinon l'image renommée perd sa vignette dans l'index (gris/introuvable).\n        if (newN.length || oldN.length) { try { const th = await thumbsForPaths(token, newN); await appendPublicDelta(token, newN, th, oldN) } catch {} const g = globalThis; if (g.__zrIndex) g.__zrIndex = null }\n        return res.status(200).json({ ok: true, moved, to })\n      }\n      // Déplacement RÉCURSIF d'un DOSSIER : bouge TOUS les blobs sous `from/` vers `to/` en UN commit\n      // (Git Data API). Réécrit les références de chemin internes (.m3u8/.media.json) from->to pour ne pas\n      // casser la lecture HLS (master/keyUri pointent par chemin). Les binaires (hash) gardent leur sha.\n      if (action === 'move-tree') {\n        const { from, to } = body\n        const okDir = (p) => typeof p === 'string' && !p.includes('..') && /^(pages|build|databases|gallery|references|audio|sfx|articles|freelance|trash)(\\/|$)/.test(p)\n        if (!okDir(from) || !okDir(to) || from === to) return res.status(400).json({ error: 'bad-path' })\n        if ((to + '/').startsWith(from + '/')) return res.status(200).json({ error: 'into-self' })\n        // (HEAD/base_tree sont lus DANS commitTree, sur le HEAD frais, avec retry fast-forward.)\n        // Le git tree recursif est TRONQUÉ sur un gros repo -> on parcourt le SOUS-DOSSIER via l'API contents\n        // (borné au sous-arbre déplacé, fiable). Collecte tous les blobs {path, sha, mode}.\n        // PARALLÉLISÉ : parcours BFS niveau par niveau, tous les dossiers d'un même niveau lus EN PARALLÈLE\n        // (les listings de dossiers frères sont indépendants). Avant : un seul listing à la fois (séquentiel),\n        // le vrai goulot sur un sous-arbre profond. Borne de sécurité conservée (guard 5000).\n        const movers = []\n        let frontier = [from]\n        let guard = 0\n        while (frontier.length && guard < 5000) {\n          guard += frontier.length\n          const results = await Promise.all(frontier.map(async (d) => {\n            const r = await gh(token, `contents/${encodeURI(d)}?ref=${BRANCH}`)\n            if (!r.ok) return []\n            const arr = await r.json()\n            return Array.isArray(arr) ? arr : []\n          }))\n          const nextFrontier = []\n          for (const arr of results) {\n            for (const x of arr) {\n              if (x.type === 'dir') nextFrontier.push(x.path)\n              else if (x.type === 'file') movers.push({ path: x.path, sha: x.sha, mode: '100644' })\n            }\n          }\n          frontier = nextFrontier\n        }\n        if (!movers.length) return res.status(200).json({ error: 'empty' })\n        // PARALLÉLISÉ : la réécriture des refs (lecture blob + ré-encodage) est indépendante par fichier.\n        // Promise.all sur tous les movers -> les blobs HLS/manifestes sont traités en parallèle, pas en file.\n        const dual = await Promise.all(movers.map(async (m) => {\n          const np = to + m.path.slice(from.length)\n          let sha = m.sha\n          // Réécrire les refs de chemin dans les fichiers TEXTE qui les portent (playlists HLS + manifeste média).\n          if (/\\.(m3u8|media\\.json)$/.test(m.path)) {\n            const raw = await gh(token, `git/blobs/${m.sha}`)\n            if (raw.ok) {\n              let txt = b64d((await raw.json()).content)\n              txt = rewriteTreePaths(txt, from, to) // remplacement A FRONTIERE (jamais pages/A -> casse pages/AB)\n              const nb = await gh(token, 'git/blobs', { method: 'POST', body: JSON.stringify({ content: Buffer.from(txt, 'utf8').toString('base64'), encoding: 'base64' }) })\n              if (nb.ok) sha = (await nb.json()).sha\n            }\n          }\n          return [\n            { path: np, mode: m.mode, type: 'blob', sha },\n            { path: m.path, mode: m.mode, type: 'blob', sha: null }, // supprime l'ancien chemin\n          ]\n        }))\n        const entries = dual.flat()\n        const mt = await commitTree(token, entries, 'content move-tree')\n        if (!mt.ok) return res.status(200).json({ error: 'github', detail: mt.error })\n        // Auto-index du déplacement de dossier : nouveaux chemins de nœuds ajoutés, anciens marqués rm.\n        const MOVE_NODE_RE = /\\.(md|db\\.json|media\\.json|img\\.json|canvas\\.json|embed\\.json|file\\.json)$/\n        const newN = dual.map((d) => d[0].path).filter((p) => MOVE_NODE_RE.test(p))\n        const oldN = dual.map((d) => d[1].path).filter((p) => MOVE_NODE_RE.test(p))\n        if (newN.length || oldN.length) { try { const th = await thumbsForPaths(token, newN); await appendPublicDelta(token, newN, th, oldN) } catch {} const g = globalThis; if (g.__zrIndex) g.__zrIndex = null }\n        return res.status(200).json({ ok: true, moved: movers.length, to })\n      }\n      return res.status(400).json({ error: 'bad-action' })\n    }\n\n    res.setHeader('Allow', 'GET, POST')\n    return res.status(405).end()\n  } catch (e) {\n    return res.status(200).json({ error: 'fetch' })\n  }\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f75ff-f634-7a42-9dfa-4cd45a80df61"}}}
