!!(value && value.type === EAGLE_LINK_TYPE && typeof value.resourceId === 'string')\nconst resourcePathOf = (id) => `${EAGLE_RESOURCE_DIR}/${id}.json`\nconst resourceIdOf = () => `zr_${globalThis.crypto.randomUUID().replace(/-/g, '')}`\nconst jsonBlob = async (token, value) => {\n  const r = await gh(token, 'git/blobs', { method: 'POST', body: JSON.stringify({ content: b64e(JSON.stringify(value, null, 2)), encoding: 'base64' }) })\n  if (!r.ok) return null\n  return (await r.json()).sha\n}\nconst rawJsonAt = async (token, path) => {\n  try {\n    const r = await fetch(`https://raw.githubusercontent.com/${REPO}/${BRANCH}/${encodeURI(path)}`, { cache: 'no-store', headers: { Authorization: `Bearer ${token}`, 'User-Agent': 'zenray-progress' } })\n    if (!r.ok) return null\n    return await r.json()\n  } catch { return null }\n}\n// Resolve a logical directory through the nearest Eagle folder placement. The\n// marker points to a stable resourceId; the registry owns the movable sourceDir.\nasync function resolveEagleFolderDir(token, logicalDir) {\n  const segs = logicalDir.split('/')\n  for (let i = segs.length; i >= 2; i--) {\n    const root = segs.slice(0, i).join('/')\n    const marker = await rawJsonAt(token, `${root}/${EAGLE_FOLDER_LINK_FILE}`)\n    if (!marker || marker.type !== EAGLE_FOLDER_LINK_TYPE || typeof marker.resourceId !== 'string') continue\n    const registry = await rawJsonAt(token, resourcePathOf(marker.resourceId))\n    if (!registry || registry.resourceId !== marker.resourceId || typeof registry.sourceDir !== 'string') return { error: 'orphan-folder-link' }\n    const suffix = segs.slice(i).join('/')\n    return { logicalRoot: root, sourceRoot: registry.sourceDir, physicalDir: suffix ? `${registry.sourceDir}/${suffix}` : registry.sourceDir, resourceId: marker.resourceId }\n  }\n  return { physicalDir: logicalDir }\n}\n\n// MEMORY LIVE (2026-07-16) : vue \"Skills\" + navigation Create>Memory>… lisent EN DIRECT le repo Memory\n// (déjà auto-commit+pu