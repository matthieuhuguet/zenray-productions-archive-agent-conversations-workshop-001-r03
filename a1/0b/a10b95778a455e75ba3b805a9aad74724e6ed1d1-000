 512\nconst recordCache = new Map()\n\nconst b64url = (value) => Buffer.from(value).toString('base64').replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '')\nconst sha256 = (value) => createHash('sha256').update(String(value)).digest('hex')\nconst signatureFor = (secret, id) => b64url(createHmac('sha256', secret).update(`${PREFIX}.${id}`).digest())\nconst secretFromEnv = () => process.env.ZENRAY_SHARE_SECRET || process.env.ZENRAY_API_SECRET || process.env.GITHUB_TOKEN || ''\n\n// Un chemin de partage est une clé de contenu, jamais une URL. Le valider une seule fois\n// supprime les ambiguïtés `?`, `#`, encodage % et doubles slash entre le routeur et GitHub.\nexport const isCanonicalPagePath = (path) => {\n  if (typeof path !== 'string' || path !== path.trim() || !path.startsWith('pages/')) return false\n  if (/[\\\\?#%\\u0000-\\u001f\\u007f]/.test(path)) return false\n  const segments = path.split('/')\n  return segments.length > 1 && segments.every((segment) => segment && segment !== '.' && segment !== '..')\n}\n\nexport const isShareTarget = (kind, path) => {\n  if (!isCanonicalPagePath(path)) return false\n  if (kind === 'video') return path.endsWith('.media.json')\n  if (kind === 'image') return path.endsWith('.img.json')\n  return kind === 'folder' && path !== 'pages' && !/\\.(?:media|img)\\.json$/i.test(path)\n}\n\nexport const inferShareKind = (path) => path.endsWith('.media.json') ? 'video' : path.endsWith('.img.json') ? 'image' : 'folder'\n\nexport function decodeLegacyShare(token, allowLegacy = process.env.ZENRAY_ALLOW_LEGACY_SHARES === '1') {\n  // Les anciens jetons base64 n'étaient ni signés ni révocables. Les accepter doit être un\n  // choix de migration temporaire et explicite, jamais le comportement sécurisé par défaut.\n  if (!allowLegacy) return ''\n  try {\n    const value = Buffer.from(String(token || '').replace(/-/g, '+').replace(/_/g, '/'), 'base64').toString('utf8')\n    return isShareTarget(inferShareKind(value), value) ? value : ''\n  } catch { return '' }\n}\n\nexport function createSignedShareToken(secret = secretFromEnv(), entropy = randomBytes(24)) {\n  if (!secret) throw new Error('missing-share-secret')\n  const id = b64url(entropy)\n  return `${PREFIX}.${id}.${signatureFor(secret, id)}`\n}\n\nexport function verifySignedShareToken(token, secret = secretFromEnv()) {\n  if (!secret) return false\n  const parts = String(token || '').split('.')\n  if (parts.length !== 3 || parts[0] !== PREFIX || !/^[A-Za-z0-9_-]{24,64}$/.test(parts[1]) || !/^[A-Za-z0-9_-]{40,64}$/.test(parts[2])) return false\n  const expected = signatureFor(secret, parts[1])\n  const actual = parts[2]\n  if (actual.length !== expected.length) return false\n  try { return timingSafeEqual(Buffer.from(actual), Buffer.from(expected)) } catch { return false }\n}\n\nexport const shareRecordPath = (token) => {\n  const hash = sha256(token)\n  return `_shares/v1/${hash.slice(0, 2)}/${hash}.json`\n}\n\nasync function githubReadRecord(token, githubToken = process.env.GITHUB_TOKEN, fetchImpl = fetch) {\n  if (!githubToken) return null\n  const cached = recordCache.get(token)\n  if (cached && cached.until > Date.now()) return cached.value\n  if (cached) recordCache.delete(token)\n  const recordPath = shareRecordPath(token)\n  const response = await fetchImpl(`https://api.github.com/repos/${REPO}/contents/${recordPath}?ref=${encodeURIComponent(BRANCH)}`, {\n    cache: 'no-store',\n    headers: { Authorization: `Bearer ${githubToken}`, Accept: 'application/vnd.github+json', 'User-Agent': 'zenray-progress' },\n  })\n  if (!response.ok) return null\n  const payload = await response.json()\n  try {\n    const record = JSON.parse(Buffer.from(String(payload.content || '').replace(/\\n/g, ''), 'base64').toString('utf8'))\n    const value = { record, sha: payload.sha, recordPath }\n    recordCache.delete(token); recordCache.set(token, { value, until: Date.now() + RECORD_CACHE_MS })\n    while (recordCache.size > RECORD_CACHE_MAX) recordCache.delete(recordCache.keys().next().value)\n    return value\n  } catch { return null }\n}\n\nasync function githubWriteRecord(token, record, sha = '', githubToken = process.env.GITHUB_TOKEN, fetchImpl = fetch) {\n  if (!githubToken) throw new Error('missing-github-token')\n  const recordPath = shareRecordPath(token)\n  const response = await fetchImpl(`https://api.github.com/repos/${REPO}/contents/${recordPath}`, {\n    method: 'PUT',\n    headers: { Authorization: `Bearer ${githubToken}`, Accept: 'application/vnd.github+json', 'Content-Type': 'application/json', 'User-Agent': 'zenray-progress' },\n    body: JSON.stringify({\n      message: `share: ${record.revokedAt ? 'revoke' : 'issue'} ${record.kind}`,\n      branch: BRANCH,\n      content: Buffer.from(JSON.stringify(record, null, 2), 'utf8').toString('base64'),\n      ...(sha ? { sha } : {}),\n    }),\n  })\n  if (!response.ok) throw new Error(`github-write-${response.status}`)\n  const payload = await response.json()\n  const nextSha = (payload.content && payload.content.sha) || sha\n  const value = { record, sha: nextSha, recordPath }\n  recordCache.delete(token); recordCache.set(token, { value, until: Date.now() + RECORD_CACHE_MS })\n  while (recordCache.size > RECORD_CACHE_MAX) recordCache.delete(recordCache.keys().next().value)\n  return payload\n}\n\nconst shareFailure = (code, status = 404) => Object.assign(new Error(code), { code, status })\n\nexport async function resolveShareToken(token, {\n  expectedKind = '',\n  now = Date.now(),\n  secret = secretFromEnv(),\n  loadRecord = (value) => githubReadRecord(value),\n  allowLegacy = process.env.ZENRAY_ALLOW_LEGACY_SHARES === '1',\n} = {}) {\n  const legacyPath = decodeLegacyShare(token, allowLegacy)\n  if (legacyPath) {\n    const kind = inferShareKind(legacyPath)\n    if (expectedKind && expectedKind !== kind) throw shareFailure('share-kind-mismatch')\n    return { v: 0, legacy: true, token, kind, path: legacyPath, expiresAt: null }\n  }\n"}],"internal_chat_m