ite '/' (ou '%2F' en URL-encode), donc deplacer `pages/A` ne corrompt\n// JAMAIS `pages/AB`. Couvre le brut, l'encode-complet (?path=) et l'encode-partiel.\nfunction rewriteTreePaths(txt, from, to) {\n  const variants = [\n    [from + '/', to + '/'],\n    [encodeURIComponent(from) + '%2F', encodeURIComponent(to) + '%2F'],\n    [encodeURI(from) + '/', encodeURI(to) + '/'],\n  ]\n  for (const [a, b] of variants) if (a !== b) txt = txt.split(a).join(b)\n  return txt\n}\n\nexport default async function handler(req, res) {\n  const token = process.env.GITHUB_TOKEN\n  if (!token) return res.status(200).json({ error: 'no-token' })\n  res.setHeader('Cache-Control', 'no-store')\n\n  try {\n    if (req.method === 'GET') {\n      const action = (req.query.action || 'list').toString()\n      if (action === 'ratelimit') {\n        // Compteur de quota LIVE : l'endpoint GitHub /rate_limit NE CONSOMME PAS le quota REST -> gratuit à\n        // interroger. On renvoie le coeur (core) : restantes / plafond / heure de reset (epoch secondes).\n        const r = await fetch('https://api.github.com/rate_limit', { headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json', 'User-Agent': 'zenray-progress' } })\n        if (!r.ok) return res.status(200).json({ error: 'github' })\n        const j = await r.json()\n        const c = (j.resources && j.resources.core) || j.rate || {}\n        return res.status(200).json({ remaining: c.remaining, limit: c.limit, reset: c.reset })\n      }\n      if (action === 'list') {\n        const dir = (req.query.dir || 'pages').toString()\n        if (!['pages', 'databases', 'build'].includes(dir)) return res.status(400).json({ error: 'bad-dir' })\n        const ext = dir === 'pages' ? '.md' : '.json'\n        const r = await gh(token, `contents/${dir}?ref=${BRANCH}`)\n// Prédicat \"ce chemin est un noeud exposé au client\" pour l'endpoint action=tree de server/page.js.\n// Extrait dans un module dédié pour être testable directement (server/page.js n'exporte pas de fonctions\n// unitaires — c'est un handler HTTP monolithique).\nexport const NODE_RE = /\\.(md|db\\.json|media\\.json|img\\.json|canvas\\.json|embed\\.json|file\\.json)$/\n\n// Marqueurs de dossier (fichiers cachés qui ne sont pas des noeuds mais dont l'existence prouve un dossier)\n// qui doivent malgré tout apparaître dans `paths` :\n// - .zrfolder.json (dossier vide, 2026-07-12)\n// - .zrmusic.json (dossier \"bibliothèque musicale\", régression corrigée le 2026-07-16 : sans cette\n//   exception, musicFolderFlag.js ne voyait jamais le marqueur qu'il venait pourtant d'écrire sur GitHub,\n//   et le routage Music retombait silencieusement sur l'ancien chemin en dur pages/Music).\nconst FOLDER_MARKERS = ['.zrfolder.json', '.zrmusic.json']\n\nexport function isExposedTreeNode(path) {\n  return NODE_RE.test(path) || FOLDER_MARKERS.some((m) => path.endsWith('/' + m))\n}\n// Cache LRU partagé pour /api/page?action=read, réutilisé par SharedFolderPage.jsx (galerie /folder) et\n// QuickLookOverlay.jsx (aperçu Espace) — deux endroits qui pouvaient re-fetcher le MÊME manifeste (ex.\n// ouvrir en Quick Look un fichier déjà affiché en carte) sans jamais se voir. Clé = URL exacte (déjà\n// spécifique par appelant : share token inclus pour SharedFolderPage, absent pour QuickLookOverlay), donc\n// aucun risque de collision entre un contexte public et un contexte authentifié.\n//\n// Retourne le body JSON BRUT ({markdown, sha, ...}), jamais pré-parsé : `markdown` est parfois du texte\n// Notion brut (page), parfois un manifeste JSON à parser (media/file) selon l'appelant — même contrat que\n// l'ancien fetch() direct qu'il remplace, juste mémoïsé.\nimport { createLruCache } from '../media/lruCache.js'\n\nconst CACHE = createLruCache({ maxEntries: 512 })\nconst inFlight = new Map()\n\nexport async function readPageCached(url) {\n  if (CACHE.has(url)) return CACHE.get(url)\n  if (inFlight.has(url)) return inFlight.get(url)\n  const p = fetch(url, { cache: 'no-store' })\n    .then((r) => (r.ok ? r.json() : null))\n    .catch(() => null)\n    .then((j) => { inFlight.delete(url); if (j != null) CACHE.set(url, j); return j })\n  inFlight.set(url, p)\n  return p\n}\n\nexport function clearPageReadCache() { CACHE.clear(); inFlight.clear() }\nimport React, { useEffect, useRef, useState } from 'react'\nimport { PALETTE, RADII, SHADOWS, TRANSITIONS } from '../theme.js'\nimport { loadChunked, readManifest, downloadChunkedToDisk } from '../media/chunked.js'\nimport Icon from './Icon.jsx'\nimport { fileKind, fmtBytes } from '../lib/fileKind.js'\nimport { lazyRetry } from '../lib/lazyRetry.js'\nimport { usePlayer } from '../audio/PlayerContext.jsx'\nimport VideoViewerAdapter from './VideoViewerAdapter.jsx'\nimport { MEDIA_VIEWER, VIDEO_ENGINE, resolveMediaViewerRoute } from '../media/mediaViewerRoute.js'\nimport { notify } from './Notifications.jsx'\nconst LazyGmapsViewer = lazyRetry(() => import('./GmapsViewer.jsx')) // liens Google Maps intégrés (2026-07-04)\n\n// C202 — Barre de progression alignée sur le backbone (fond t.border, remplissage PALETTE.gradient).\nfunction ProgressBar({ t, value }) {\n  return (\n    <div style={{ width: '100%', height: 8, borderRadius: 99, background: t.border, overflow: 'hidden' }}>\n      <div style={{ width: `${Math.round((value || 0) * 100)}%`, height: '100%', background: PALETTE.gradient, transition: (TRANSITIONS && TRANSITIONS.smooth) || 'width .25s ease' }} />\n    </div>\n  )\n}\n\nexport default function MediaViewer({ t, path, title }) {\n  const player = usePlayer()\n  const [m, setM] = useState(null)\n  const [phase, setPhase] = useState('meta') // meta | ready | error\n  const [err, setErr] = useState(null)\n  // téléchargement (formats non lisibles inline : mkv, avi…) -> réassemblage Blob\n  const [dlProgress, setDlProgress] = useState(null)\n  const urlRef = useRef(null)\n  const [dlUrl, setDlUrl] = useState(null)\n  const [forceDownload, setForceDownload] = useState(false)\n  const [spotifyEmbed, setSpotifyEmbed] = useState('')\n  // VIDÉO IMMERSIVE (façon Apple TV) : par défaut on n'affiche QUE le lecteur. Titre, format et options\n  // (téléchargement ffmpeg) sont masqués et révélés par ce toggle. Réinitialisé à chaque changement de média.\n  const [optsOpen, setOptsOpen] = useState(false)\n  // AGRANDIR/CENTRER la vidéo (même feature que le markdown pageWide) : persisté, toggle icône discret.\n  // Centré = colonne lecture (980) ; élargi = 100% de l'espace (encore plus large sidebar masquée via Tab).\n  const [vidWide, setVidWide] = useState(() => { try { return localStorage.getItem('zr:create:vidwide') === '1' } catch { return false } })\n  useEffect(() => { try { localStorage.setItem('zr:create:vidwide', vidWide ? '1' : '0') } catch {} }, [vidWide])\n  useEffect(() => { setForceDownload(false); setOptsOpen(false); setSpotifyEmbed('') }, [path])\n\n  useEffect(() => {\n    let live = true\n    setPhase('meta'); setM(null); setErr(null); setDlUrl(null); setDlProgress(null)\n    readManifest(path).then((mm) => { if (live) { setM(mm); setPhase('ready') } }).catch((e) => { if (live) { setErr(String(e.message || e)); setPhase('error') } })\n    return () => { live = false }\n  }, [path])\n  useEffect(() => () => { if (urlRef.current) URL.revokeObjectURL(urlRef.current) }, [])\n\n  // Transcodage local en cours : le placeholder porte {transcoding:true}. On re-poll le manifest toutes\n  // les ~4 s ; dès que le worker l'a réécrit en mse-av (transcoding tombe), l'effet ci-dessus n'est pas\n  // rappelé (path inchangé) donc on rafraîchit ICI le manifest en place pour basculer sur le lecteur.\n  // Contrat unique manifest -> viewer. Aucun bloc JSX ne recalcule son propre `streamable` : un manifeste\n  // choisit exactement un moteur, ce qui interdit le double montage déjà rencontré avec YouTube.\n  const viewerRoute = resolveMediaViewerRoute(m, { phase, forceDownload })\n  const transcoding = viewerRoute.transcoding\n  useEffect(() => {\n    if (!transcoding) return\n    let live = true\n    const id = setInterval(() => {\n      readManifest(path).then((mm) => { if (live && mm) setM(mm) }).catch(() => {})\n    }, 4000)\n    return () => { live = false; clearInterval(id) }\n  }, [transcoding, path])\n\n  // URL de streaming Range : le <video>/<audio> lit directement par intervalles d'octets.\n  const streamUrl = `/api/stream?path=${encodeURIComponent(path)}`\n  const inline = viewerRoute.inline\n  const isVideo = viewerRoute.mediaKind === 'video'\n  const isAudio = viewerRoute.viewer === MEDIA_VIEWER.audio\n  const isImage = viewerRoute.viewer === MEDIA_VIEWER.image\n  const isPdf = viewerRoute.viewer === MEDIA_VIEWER.pdf\n  const isPlaylist = viewerRoute.viewer === MEDIA_VIEWER.playlist\n  const audioTrack = isAudio ? { source: 'local', streamPath: path, title: m.title || m.name || title, artist: m.artist || '', album: m.album || '', cover: m.cover || m.poster || '', dur: m.duration || m.probe?.duration || 0, mime: m.mime } : null\n  const artwork = (c) => !c ? '' : (/^(https?:|data:|blob:|\\/)/.test(c) ? c : `/api/img?path=${encodeURIComponent(c)}`)\n\n  // téléchargement reconstitué (pour les formats non lisibles inline)\n  // DOWNLOAD 1 CLIC : reconstitue le blob déchiffré puis déclenche l'enregistrement automatiquement\n  // (plus de 2e clic « Enregistrer »). Le fichier part directement avec son nom d'origine.\n  const download = async () => {\n    setDlProgress(0)\n    try {\n      // STREAMÉ sur disque (anti-OOM) quand l'API le permet ; repli Blob borné sinon. Évite de garder un\n      // gros média entier en RAM avant l'enregistrement (cause du crash de l'onglet sur mobile).\n      await downloadChunkedToDisk(path, (r) => setDlProgress(r))\n      setDlProgress(1)\n    } catch (e) { setDlProgress(null); setErr(String(e.message || e)) }\n  }\n\n  const isGmaps = viewerRoute.viewer === MEDIA_VIEWER.gmaps\n  // Sauvegarde du titre/auteur édités dans le manifeste .media.json (lecture sha + réécriture sûre).\n  const saveMeta = async ({ title: nt, author: na }) => {\n    try {\n      const r = await fetch(`/api/page?action=read&path=${encodeURIComponent(path)}`, { cache: 'no-store' }).then((x) => x.json())\n      const mm = JSON.parse(r.markdown); mm.title = nt; mm.author = na\n      await fetch('/api/page', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'save', path, markdown: JSON.stringify(mm, null, 2), sha: r.sha }) })\n      setM(mm)\n    } catch (e) {\n      // L'édition reste affichée (best-effort visuel), mais un échec réel de sauvegarde doit être visible —\n      // sinon un titre/auteur modifié semble persisté alors qu'il ne l'est pas, perdu au prochain reload.\n      notify({ title: 'Sauvegarde échouée', body: 'Le titre/auteur modifié n\\'a pas pu être enregistré.', kind: 'error' })\n    }\n  }\n  // Page épurée pour les moteurs déclarés immersifs (vidéo unifiée et carte).\n  const immersiveVideo = viewerRoute.immersive\n  const card = immersiveVideo\n    ? { maxWidth: vidWide ? '100%' : 980, width: '100%', margin: '0 auto', transition: 'max-width .22s ease' }\n    : { background: t.surface, border: `1px solid ${t.border}`, borderRadius: RADII.lg, boxShadow: SHADOWS.md, padding: 22, maxWidth: 900, margin: '0 auto' }\n  const button = { padding: '8px 18px', borderRadius: RADII.md, border: `1px solid ${PALETTE.primary}`, background: PALETTE.primarySoft, color: PALETTE.primary, cursor: 'pointer', fontSize: 13, fontWeight: 600, textDecoration: 'none', display: 'inline-block' }\n\n  return (\n    <div style={{ padding: immersiveVideo ? '12px 16px 24px' : 24 }}>\n      <div style={card}>\n        {/* Titre + badge : MASQUÉS en vidéo immersive (le lecteur affiche déjà le nom, façon Apple TV). */}\n        {!immersiveVideo && (\n        <div style={{ display: 'flex', alignItems: 'flex-start', justifyContent: 'space-between', gap: 12 }}>\n          <div style={{ fontFamily: \"'AnthropicSans', sans-serif\", fontSize: 24, fontWeight: 700, marginBottom: 6, color: t.textPrimary }}>{title || (m && m.name)}</div>\n          {m && (() => {\n            // onCdn = binaire sur le CDN public (HLS jsDelivr OU chunks chiffrés public cdnRepo). Sinon legacy Vercel.\n            const onCdn = m.type === 'hls' || !!m.cdnRepo\nimport React from 'react'\nimport { RADII, SHADOWS } from '../theme.js'\nimport SmartThumb from '../media/SmartThumb.jsx'\nimport { imageCache } from '../media/imageCache.js'\nimport { prefetchOne } from '../media/prefetch.js'\nimport { buildJsDelivrUrl, buildRawUrl } from '../capture/shardNaming.js'\nimport { shardApi, abToB64 } from '../capture/universalCapture.js'\nimport { makeThumbWebp } from '../capture/thumbnailer.js'\nimport { decryptToObjectUrl, decryptBytes } from '../media/crypto.js'\nimport { streamDownloadChunks, streamDownload } from '../lib/fetchAsset.js'\nimport { downloadUrls as fileDownloadUrls } from '../lib/archiveChunks.js'\nimport { fitAspectWithinSquare } from '../media/thumbGeometry.js'\nimport { createLruCache, createLruSet } from '../media/lruCache.js'\n\n// RENDERING PUBLIC ENCRYPTED IMAGES (public + encrypted + jsDelivr model, see docs/phase-upload.md).\n//\n// Plainly: on a public repo the image is encrypted gibberish. jsDelivr serves it as-is; an <img>\n// cannot display it. So the browser must: fetch the ciphertext (CDN) -> decrypt (AES-GCM, master\n// key + manifest IV) -> get a local blob: objectURL of the PLAINTEXT -> hand that to the <img>.\n//\n// DETECTION: a manifest is encrypted iff vis==='public' AND it carries an `iv` (written at upload).\n//   A public manifest WITHOUT iv (old unencrypted public) or a private/legacy one is served as-is.\n//\n// PLAINTEXT RAM CACHE: decrypt once per CDN URL and retain a wide working set. It is deliberately\n// larger than QuickLook's 96-image preload window, but bounded for tabs kept open for days.\n// Eviction revokes the plaintext objectURL; plaintext never leaves browser RAM.\n// Exported: every other view that renders an image (QuickLook, DriveThumb, refs, paste collage)\n//   must go through THIS same test and THIS same resolver so ciphertext is NEVER displayed.\nexport const isEncrypted = (m) => !!(m && m.vis === 'public' && m.iv)\n\n// RAM cache: cache key -> Promise<plaintext objectURL>. We store the PROMISE (not the final URL)\n//   so concurrent decrypts deduplicate (two tiles of the same image decrypt only once).\n//   On failure the entry is removed to allow a retry (no negative caching).\nexport const IMAGE_NODE_CACHE_LIMITS = Object.freeze({ decrypted: 384, manifests: 4096, backfills: 4096, backfillQueue: 128 })\nconst revokeDecrypted = (promise) => {\n  Promise.resolve(promise).then((url) => {\n    if (typeof url === 'string' && url.startsWith('blob:')) URL.revokeObjectURL(url)\n  }).catch(() => {})\n}\nconst _decCache = createLruCache({ maxEntries: IMAGE_NODE_CACHE_LIMITS.decrypted, onEvict: revokeDecrypted })\nfunction cachedDecrypt(key, produce) {\n  if (_decCache.has(key)) return _decCache.get(key)\n  const p = produce()\n  p.catch(() => { if (_decCache.peek(key) === p) _decCache.delete(key) })\n  _decCache.set(key, p)\n  return p\n}\n\n// Fetch ciphertext from a single CDN URL, decrypt with the given IV, return a cached plaintext objectURL.\n//   cdnUrl: jsDelivr URL of the ciphertext. iv: base64 from the manifest. mime: plaintext type for the Blob.\nasync function decryptedObjectUrl(cdnUrl, iv, mime) {\n  if (!cdnUrl || !iv) return null\n  return cachedDecrypt(cdnUrl, async () => {\n    const buf = await fetch(cdnUrl).then((r) => (r.ok ? r.arrayBuffer() : Promise.reject(new Error('cdn ' + r.status))))\n    return decryptToObjectUrl(buf, iv, mime)\n  })\n}\n\n// ── CHUNKED RECONSTRUCTION (2026-07-07) — replaces the old \"raw.github original + jsDelivr dispPath derivative\" duo ──\n// A `cdnChunks[]` image (new schema, ALWAYS present on recent uploads) is split into pieces ≤19 MB,\n// each served by jsDelivr. We fetch them ALL (par