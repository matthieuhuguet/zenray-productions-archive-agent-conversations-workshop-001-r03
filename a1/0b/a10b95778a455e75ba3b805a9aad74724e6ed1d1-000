vif',\n  bmp: 'image/bmp', svg: 'image/svg+xml', ico: 'image/x-icon', jfif: 'image/jpeg', heic: 'image/heic', heif: 'image/heif',\n  tif: 'image/tiff', tiff: 'image/tiff', dng: 'image/x-adobe-dng', psd: 'image/vnd.adobe.photoshop',\n  // documents\n  pdf: 'application/pdf', epub: 'application/epub+zip', rtf: 'application/rtf',\n  doc: 'application/msword', docx: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',\n  xls: 'application/vnd.ms-excel', xlsx: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',\n  ppt: 'application/vnd.ms-powerpoint', pptx: 'application/vnd.openxmlformats-officedocument.presentationml.presentation',\n  // texte\n  txt: 'text/plain', md: 'text/markdown', markdown: 'text/markdown', csv: 'text/csv', tsv: 'text/tab-separated-values',\n  log: 'text/plain', rtf_: 'text/plain',\n  // code (servi en text/plain pour aperçu <pre>, langage gardé à part)\n  js: 'text/javascript', mjs: 'text/javascript', cjs: 'text/javascript', ts: 'text/plain', tsx: 'text/plain', jsx: 'text/plain',\n  py: 'text/x-python', rb: 'text/x-ruby', php: 'text/x-php', java: 'text/x-java', c: 'text/x-c', h: 'text/x-c',\n  cpp: 'text/x-c++', cc: 'text/x-c++', hpp: 'text/x-c++', cs: 'text/x-csharp', go: 'text/x-go', rs: 'text/x-rust',\n  swift: 'text/x-swift', kt: 'text/x-kotlin', scala: 'text/x-scala', sh: 'text/x-sh', bash: 'text/x-sh', zsh: 'text/x-sh',\n  lua: 'text/x-lua', r: 'text/x-r', sql: 'text/x-sql', html: 'text/html', htm: 'text/html', css: 'text/css',\n  scss: 'text/x-scss', json: 'application/json', yaml: 'text/yaml', yml: 'text/yaml', toml: 'text/x-toml',\n  xml: 'text/xml', ini: 'text/plain', env: 'text/plain', conf: 'text/plain', cube: 'text/plain', vue: 'text/plain', svelte: 'text/plain',\n  dart: 'text/x-dart', graphql: 'text/plain', gql: 'text/plain', dockerfile: 'text/plain', gitignore: 'text/plain',\n  // archives / 3D / binaire\n  zip: 'application/zip', tar: 'application/x-tar', gz: 'application/gzip', '7z': 'application/x-7z-compressed', rar: 'application/x-rar',\n  glb: 'model/gltf-binary', gltf: 'model/gltf+json', obj: 'model/obj', stl: 'model/stl', fbx: 'model/fbx',\n}\n\n// Extensions traitées comme CODE/TEXTE même si le mime n'est pas text/* (aperçu <pre>).\nconst TEXTUAL_EXT = new Set(['md', 'markdown', 'txt', 'csv', 'tsv', 'log', 'json', 'yaml', 'yml', 'toml', 'xml', 'html', 'htm', 'css', 'scss',\n  'js', 'mjs', 'cjs', 'ts', 'tsx', 'jsx', 'py', 'rb', 'php', 'java', 'c', 'h', 'cpp', 'cc', 'hpp', 'cs', 'go', 'rs', 'swift', 'kt',\n  'scala', 'sh', 'bash', 'zsh', 'lua', 'r', 'sql', 'ini', 'env', 'conf', 'cube', 'vue', 'svelte', 'dart', 'graphql', 'gql', 'dockerfile', 'gitignore'])\n\nexport const extOf = (name) => (String(name || '').match(/\\.([a-z0-9]+)$/i) || [, ''])[1].toLowerCase()\nexport const mimeForName = (name) => MIME_BY_EXT[extOf(name)] || 'application/octet-stream'\n\n// Catégorie d'aperçu — pilote le rendu dans le viewer. 'lib' = besoin d'un décodeur dynamique (lazy).\nexport function kindForName(name) {\n  const e = extOf(name)\n  const mime = MIME_BY_EXT[e] || ''\n  if (mime.startsWith('audio/')) return 'audio'\n  if (mime.startsWith('video/')) return 'video'\n  // PSD exclu volontairement : LibFilePreview route image-lib vers le décodeur TIFF (UTIF), et un PSD (format\n  // Adobe propre, jamais du TIFF) échouerait SYSTÉMATIQUEMENT le décodage -> mieux vaut le message \"aperçu\n  // indisponible\" immédiat (catégorie par défaut 'binary') qu'une tentative de décodage vouée à l'échec à coup\n  // sûr. DNG reste en image-lib : beaucoup de DNG sont bâtis sur TIFF/EP et se décodent réellement via UTIF.\n  if (e === 'heic' || e === 'heif' || e === 'tif' || e === 'tiff' || e === 'dng') return 'image-lib'\n  if (mime.startsWith('image/')) return 'image'\n  if (e === 'pdf') return 'pdf'\n  if (TEXTUAL_EXT.has(e)) return 'text'\n  if (e === 'docx' || e === 'doc' || e === 'rtf') return 'doc-lib'\n  if (e === 'xlsx' || e === 'xls') return 'sheet-lib'\n  if (e === 'pptx' || e === 'ppt') return 'slides-lib'\n  if (e === 'epub') return 'epub-lib'\n  if (e === 'glb' || e === 'gltf' || e === 'obj' || e === 'stl' || e === 'fbx') return '3d-lib'\n  if (e === 'zip' || e === 'tar' || e === 'gz' || e === '7z' || e === 'rar') return 'archive'\n  return 'binary'\n}\n\n// Aperçu NATIF possible (sans dépendance) ?\nexport const isNativePreview = (name) => ['audio', 'video', 'image', 'pdf', 'text'].includes(kindForName(name))\n// LibFilePreview — aperçu des formats qui exigent un décodeur JS (chargé en IMPORT DYNAMIQUE = code-split, donc\n// AUCUN poids ajouté au bundle initial : la lib n'est téléchargée que quand on ouvre un fichier de ce type).\n// Reçoit l'URL blob DÉJÀ reconstituée (ZenRayShards bit-exact) ; décode selon la catégorie fileKinds.\n//   doc-lib (docx)   -> mammoth -> HTML\n//   sheet-lib (xlsx) -> SheetJS -> table HTML (onglets)\n//   slides-lib(pptx) -> pas de lib fiable -> message + download (déjà bit-exact)\n//   epub-lib (epub)  -> epubjs -> rendition paginée\n//   image-lib(heic/tiff) -> heic2any / UTIF -> <img>/<canvas>\n//   3d-lib (glb/obj/stl) -> three.js -> viewer WebGL orbitable\nimport React, { useEffect, useRef, useState } from 'react'\nimport { extOf } from '../lib/fileKinds.js'\n\nconst Box = ({ children }) => <div style={{ width: 'min(900px,92vw)', maxHeight: '82vh', overflow: 'auto', background: '#fff', color: '#1d1d1f', borderRadius: 14, padding: '26px 30px', boxShadow: '0 20px 60px rgba(0,0,0,0.4)' }}>{children}</div>\nconst Msg = ({ children }) => <div style={{ color: '#fff', opacity: 0.75, textAlign: 'center', lineHeight: 1.6, fontSize: 14 }}>{children}</div>\n\nexport default function LibFilePreview({ url, name, kind }) {\n  const [state, setState] = useState({ loading: true })\n  const mountRef = useRef(null)\n\n  useEffect(() => {\n    let live = true, cleanup = null\n    ;(async () => {\n      try {\n        const ext = extOf(name)\n        // ---- DOCX -> HTML (mammoth) ----\n        if (kind === 'doc-lib' && (ext === 'docx')) {\n          const mammoth = (await import('mammoth')).default || (await import('mammoth'))\n          const buf = await (await fetch(url)).arrayBuffer()\n          const { value } = await mammoth.convertToHtml({ arrayBuffer: buf })\n          if (live) setState({ html: value })\n          return\n        }\n        // ---- XLSX/XLS -> tables HTML (SheetJS) ----\n        if (kind === 'sheet-lib') {\n          const XLSX = await import('xlsx')\n          const buf = await (await fetch(url)).arrayBuffer()\n          const wb = XLSX.read(buf, { type: 'array' })\n          const sheets = wb.SheetNames.map((n) => ({ n, html: XLSX.utils.sheet_to_html(wb.Sheets[n]) }))\n          if (live) setState({ sheets })\n          return\n        }\n        // ---- HEIC/HEIF -> JPEG (heic2any) ; TIFF -> canvas (UTIF) ----\n        if (kind === 'image-lib') {\n          if (ext === 'heic' || ext === 'heif') {\n            const heic2any = (await import('heic2any')).default\n            const blob = await (await fetch(url)).blob()\n            const out = await heic2any({ blob, toType: 'image/jpeg', quality: 0.9 })\n            const u = URL.createObjectURL(Array.isArray(out) ? out[0] : out)\n            cleanup = () => URL.revokeObjectURL(u)\n            if (live) setState({ img: u }); return\n          }\n          // TIFF / DNG\n          const UTIF = (await import('utif')).default\n          const buf = await (await fetch(url)).arrayBuffer()\n          const ifds = UTIF.decode(buf); UTIF.decodeImage(buf, ifds[0])\n          const rgba = UTIF.toRGBA8(ifds[0])\n          const cv = document.createElement('canvas'); cv.width = ifds[0].width; cv.height = ifds[0].height\n          const ctx = cv.getContext('2d'); const id = ctx.createImageData(cv.width, cv.height); id.data.set(rgba); ctx.putImageData(id, 0, 0)\n          if (live) setState({ img: cv.toDataURL('image/png') }); return\n        }\n        // ---- EPUB (epubjs) ----\n        if (kind === 'epub-lib') {\n          const ePub = (await import('epubjs')).default\n          const buf = await (await fetch(url)).arrayBuffer()\n          if (live) setState({ epub: buf, epubLib: ePub }); return\n        }\n        // ---- 3D glb/gltf/obj/stl (three.js) ----\n        if (kind === '3d-lib') {\n          if (live) setState({ three: true }); return\n        }\n        // pptx & co -> pas d'aperçu fiable\n        if (live) setState({ unsupported: true })\n      } catch (e) { if (live) setState({ err: (e && e.message) || 'décodage impossible' }) }\n    })()\n    return () => { live = false; if (cleanup) cleanup() }\n  }, [url, name, kind])\n\n  // EPUB : rendu dans un conteneur (après que le buffer soit prêt)\n  useEffect(() => {\n    if (!state.epub || !mountRef.current) return\n    let rendition = null\n    try {\n      const book = state.epubLib(state.epub)\n      rendition = book.renderTo(mountRef.current, { width: '100%', height: '74vh', spread: 'auto' })\n      rendition.display()\n    } catch {}\n    return () => { try { rendition && rendition.destroy() } catch {} }\n  }, [state.epub])\n\n  // 3D : scène three.js orbitable\n  useEffect(() => {\n    if (!state.three || !mountRef.current) return\n    let raf = 0, renderer = null, controls = null, disposed = false\n    ;(async () => {\n      const THREE = await import('three')\n      const ext = extOf(name)\n      const { OrbitControls } = await import('three/examples/jsm/controls/OrbitControls.js')\n      const el = mountRef.current; if (!el || disposed) return\n      const W = Math.min(900, window.innerWidth * 0.9), H = window.innerHeight * 0.74\n      const scene = new THREE.Scene(); scene.background = new THREE.Color(0x101013)\n      const cam = new THREE.PerspectiveCamera(50, W / H, 0.01, 5000); cam.position.set(2, 1.5, 3)\n      renderer = new THREE.WebGLRenderer({ antialias: true }); renderer.setSize(W, H); renderer.setPixelRatio(window.devicePixelRatio)\n      el.appendChild(renderer.domElement)\n      scene.add(new THREE.HemisphereLight(0xffffff, 0x223344, 1.1)); const d = new THREE.DirectionalLight(0xffffff, 1.4); d.position.set(3, 5, 2); scene.add(d)\n      controls = new OrbitControls(cam, renderer.domElement); controls.enableDamping = true\n      const fit = (obj) => { const box = new THREE.Box3().setFromObject(obj); const s = box.getSize(new THREE.Vector3()).length() || 1; const c = box.getCenter(new THREE.Vector3()); obj.position.sub(c); cam.position.set(0, s * 0.3, s * 1.4); cam.near = s / 100; cam.far = s * 100; cam.updateProjectionMatrix(); controls.target.set(0, 0, 0) }\n      try {\n        if (ext === 'glb' || ext === 'gltf') { const { GLTFLoader } = await import('three/examples/jsm/loaders/GLTFLoader.js'); const g = await new GLTFLoader().loadAsync(url); scene.add(g.scene); fit(g.scene) }\n        else if (ext === 'obj') { const { OBJLoader } = await import('three/examples/jsm/loaders/OBJLoader.js'); const o = await new OBJLoader().loadAsync(url); scene.add(o); fit(o) }\n        else if (ext === 'stl') { const { STLLoader } = await import('three/examples/jsm/loaders/STLLoader.js'); const geo = await new STLLoader().loadAsync(url); const mesh = new THREE.Mesh(geo, new THREE.MeshStandardMaterial({ color: 0x9aa0a6, metalness: 0.1, roughness: 0.7 })); scene.add(mesh); fit(mesh) }\n      } catch {}\n      const loop = () => { if (disposed) return; raf = requestAnimationFrame(loop); controls.update(); renderer.render(scene, cam) }\n      loop()\n    })()\n    return () => { disposed = true; cancelAnimationFrame(raf); try { controls && controls.dispose(); renderer && renderer.dispose(); renderer && renderer.domElement.remove() } catch {} }\n  }, [state.three, name, url])\n\n  if (state.loading && !state.html && !state.sheets && !state.img && !state.epub && !state.three) {\n    if (state.err) return <Msg>Aperçu impossible : {state.err}. Entrée pour télécharger.</Msg>\n    if (state.unsupported) return <Msg>Aperçu indisponible pour ce type — Entrée pour télécharger (fichier intact).</Msg>\n    return <Msg>Décodage…</Msg>\n  }\n  if (state.err) return <Msg>Aperçu impossible : {state.err}. Entrée pour télécharger.</Msg>\n  if (state.html != null) return <Box><div dangerouslySetInnerHTML={{ __html: state.html }} /></Box>\n  if (state.sheets) return <Box><div className=\"zr-xlsx\">{state.sheets.map((s, i) => (<div key={i} style={{ marginBottom: 22 }}><div style={{ fontWeight: 700, marginBottom: 8 }}>{s.n}</div><div style={{ overflow: 'auto' }} dangerouslySetInnerHTML={{ __html: s.html }} /></div>))}<style>{'.zr-xlsx table{border-collapse:collapse}.zr-xlsx td,.zr-xlsx th{border:1px solid #ddd;padding:3px 7px;font-size:13px}'}</style></div></Box>\n  if (state.img) return <img src={state.img} alt={name} style={{ maxWidth: '92vw', maxHeight: '82vh', objectFit: 'contain', borderRadius: 12, boxShadow: '0 20px 60px rgba(0,0,0,0.5)' }} />\n  if (state.epub) return <div ref={mountRef} style={{ width: 'min(900px,92vw)', height: '74vh', background: '#fff', borderRadius: 12, overflow: 'hidden' }} />\n  if (state.three) return <div ref={mountRef} style={{ borderRadius: 12, overflow: 'hidden', lineHeight: 0 }} />\n  return <Msg>Aperçu indisponible — Entrée pour télécharger.</Msg>\n}\nsrc/components/LibFilePreview.jsx:97:      const { OrbitControls } = await import('three/examples/jsm/controls/OrbitControls.js')\nsrc/components/LibFilePreview.jsx:108:        if (ext === 'glb' || ext === 'gltf') { const { GLTFLoader } = await import('three/examples/jsm/loaders/GLTFLoader.js'); const g = await new GLTFLoader().loadAsync(url); scene.add(g.scene); fit(g.scene) }\nsrc/components/LibFilePreview.jsx:109:        else if (ext === 'obj') { const { OBJLoader } = await import('three/examples/jsm/loaders/OBJLoader.js'); const o = await new OBJLoader().loadAsync(url); scene.add(o); fit(o) }\nsrc/components/LibFilePreview.jsx:110:        else if (ext === 'stl') { const { STLLoader } = await import('three/examples/jsm/loaders/STLLoader.js'); const geo = await new STLLoader().loadAsync(url); const mesh = new THREE.Mesh(geo, new THREE.MeshStandardMaterial({ color: 0x9aa0a6, metalness: 0.1, roughness: 0.7 })); scene.add(mesh); fit(mesh) }\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f75ff-f634-7a42-9dfa-4cd45a80df61"}}}
