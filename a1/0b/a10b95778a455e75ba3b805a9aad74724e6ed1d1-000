usic|\\\\.zreagle-folder)\\\\.json$/, ''))\\n+        }\\n+        const reserveLeaf = (requested) => {\\n+          const ext = requested.match(EAGLE_LINK_RE)?.[0] || ''\\n+          const base = ext ? requested.slice(0, -ext.length) : requested\\n+          let n = 1; let candidateBase = base\\n+          while (files.has(candidateBase + ext) || occupiedBases.has(candidateBase)) candidateBase = `${base} ${++n}`\\n+          files.add(candidateBase + ext); occupiedBases.add(candidateBase)\\n+          return candidateBase + ext\\n+        }\\n+        const reserveFolder = (requested) => {\\n+          let n = 1; let candidate = requested\\n+          while (occupiedBases.has(candidate) || [...files].some((p) => p.startsWith(candidate + '/'))) candidate = `${requested} ${++n}`\\n+          occupiedBases.add(candidate); files.add(`${candidate}/${EAGLE_FOLDER_LINK_FILE}`)\\n+          return candidate\\n+        }\\n+        const planned = []\\n+        for (let index = 0; index < requestedItems.length; index++) {\\n+          const item = requestedItems[index] || {}\\n+          if (item.kind === 'leaf') {\\n+            const sourcePath = String(item.sourcePath || '')\\n+            const requestedTarget = String(item.targetPath || '')\\n+            const sourceExt = sourcePath.match(EAGLE_LINK_RE)?.[0]\\n+            if (!safe(sourcePath) || !safe(requestedTarget) || !sourceExt || sourceExt !== requestedTarget.match(EAGLE_LINK_RE)?.[0] || sourcePath === requestedTarget) return res.status(200).json({ error: 'preflight', results: requestedItems.map((_, i) => ({ index: i, ok: false, error: i === index ? 'bad-path' : 'batch-aborted' })) })\\n+            planned.push({ index, kind: 'leaf', sourcePath, targetPath: reserveLeaf(requestedTarget), title: typeof item.title === 'string' ? item.title.slice(0, 240) : null })\\n+          } else if (item.kind === 'folder') {\\n+            const sourceDir = cleanDir(item.sourceDir)\\n+            const requestedTarget = clean