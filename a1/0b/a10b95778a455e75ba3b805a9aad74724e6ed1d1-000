s de référence, il ne casse pas\n  // la mémoïsation des tuiles, tout en appelant toujours les handlers à jour via tileApi.current.\n  const tileApi = useRef({})\n  const tileH = useMemo(() => ({\n    click: (e, ev) => tileApi.current.clickEntry(e, ev),\n    open: (e) => tileApi.current.openEntry(e),\n    hover: (e) => tileApi.current.prefetchDir && tileApi.current.prefetchDir(e), // précharge le listing d'un dossier survolé\n    ctx: (e, ev) => { const a = tileApi.current; if (!a.selected.has(e.dir)) a.setSelected(new Set([e.dir])); a.onCtx(ev, e) },\n    dragStart: (ev, entry) => tileApi.current.startDragEntry(ev, entry),\n    dragOver: (ev, dir) => { const ty = [...ev.dataTransfer.types]; if (ty.includes('application/zenray-page') || ty.includes('Files')) { ev.preventDefault(); ev.dataTransfer.dropEffect = ty.includes('Files') ? 'copy' : 'move'; tileApi.current.setDropDir(dir) } },\n    dragLeave: (dir) => tileApi.current.setDropDir((d) => d === dir ? null : d),\n    drop: (ev, dir) => {\n      tileApi.current.setDropDir(null)\n      if ([...ev.dataTransfer.types].includes('Files') && ev.dataTransfer.files && ev.dataTransfer.files.length) {\n        ev.preventDefault(); ev.stopPropagation(); tileApi.current.dragDepth.current = 0; tileApi.current.setDragging(false); tileApi.current.runCapture(ev.dataTransfer.files, dir); return\n      }\n      const d = ev.dataTransfer.getData('application/zenray-page'); if (!d) return; ev.preventDefault(); try { const p = JSON.parse(d); const list = p.items ? p.items.map((it) => it.path) : (p.path ? [p.path] : []); tileApi.current.moveMany(list, dir) } catch {}\n    },\n    // GROUPEMENT PAR DROP (item non-dossier survolé/lâché par un autre item non-dossier -> crée un dossier qui\n    // les réunit). dragover ne peut PAS lire dataTransfer.getData (restriction navigateur, seul `types` est\n    // lisible avant le drop) -> on ne peut pas encore vérifier \"même niveau / pas soi-même\" à ce stade ; on se\n    // contente d'un highlight optimiste (retiré/annulé proprement au drop si la cible s'avère invalide, aucun\n    // état incohérent possible car createFolderFromDrop revalide tout avant d'agir). Seul un drag INTERNE\n    // (application/zenray-page) déclenche ce mode ; un drop de vrais fichiers reste capturé normalement.\n    dragOverLeaf: (ev, dir) => { const ty = [...ev.dataTransfer.types]; if (ty.includes('application/zenray-page')) { ev.preventDefault(); ev.dataTransfer.dropEffect = 'move'; tileApi.current.setGroupOverDir(dir) } },\n    dragLeaveLeaf: (dir) => tileApi.current.setGroupOverDir((d) => d === dir ? null : d),\n    dropLeaf: (ev, entry) => {\n      tileApi.current.setGroupOverDir(null)\n      const d = ev.dataTransfer.getData('application/zenray-page'); if (!d) return\n      ev.preventDefault(); ev.stopPropagation()\n      try {\n  // partir d'un nombre de lignes) reste exact, ligne après ligne, quel que soit le contenu.\n  const renderListRow = (e) => isSkillsFolder ? renderSkillCard(e) : renderFinderRow(e)\n  // Carte \"Skills\" (2026-07-16) : capsule arrondie titre + icône SF Symbol + description 2 lignes.\n  // Composant à part plutôt qu'une branche de plus dans la ligne Finder standard (renderFinderRow un peu\n  // plus bas, inchangée) — zéro risque de régression sur la navigation Create normale, qu'utilisent TOUTES\n  // les autres vues. Un skill = un DOSSIER Memory (contient SKILL.md un niveau plus bas) : ouvrir la carte\n  // doit afficher ce contenu directement, pas descendre dans le dossier (openEntry ferait ça vu hasKids=true).\n  const renderSkillCard = (e) => <SkillCardRow key={e.dir} e={e} t={t} onOpen={() => openPage(e.dir + '/SKILL.md')} />\n  const renderFinderRow = (e) => {\n    const isFolder = e.hasKids && !e.contentPath\n    const selOn = selected.has(e.dir), dropOn = dropDir === e.dir, groupOn = groupOverDir === e.dir || groupingDir === e.dir\n    return (\n      <button key={e.dir} data-zr-dir={e.dir} onClick={(ev) => clickEntry(e, ev)} onDoubleClick={(