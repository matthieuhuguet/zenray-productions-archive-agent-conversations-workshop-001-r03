2 → 2026-07-04) : 3 modales \"colle un lien par\n  // ligne\" qui dupliquaient chacune le même quintuplet useState + la même fonction submit async — état et\n  // logique de soumission maintenant portés par useLinkImportModal (src/create/useLinkImportModal.js),\n  // instanciés plus bas (ytVideoImport/ytAudioImport/gmapsImport, juste après loadDir/folderLabelOf dont\n  // leur ctx a besoin).\n  const countsBtnRef = useRef(null) // ancre du widget \"N éléments\" (portail vers #zr-topcluster, dropdown positionné depuis sa rect)\n  const renameCancel = useRef(false) // Échap pendant un renommage = annuler (le onBlur ne doit PAS sauver)\n  // Visibilité EFFECTIVE (héritée) du dossier Create courant : 'public' (CDN jsDelivr) | 'private' (proxy).\n  // Sert au bouton toolbar (cadenas vs globe) ET au défaut de la modale. visNonce force la re-résolution\n  // après un toggle (le cache module a été invalidé, on doit relire + repeindre les badges).\n  const [folderVis, setFolderVis_] = useState('public')\n  const [visNonce, setVisNonce] = useState(0)\n  const [visTick, setVisTick] = useState(0) // repeint les badges une fois le cache de visibilité rempli\n  const [marquee, setMarquee] = useState(null) // rectangle de sélection (rubber-band) : {l,t,w,h} en coords viewport\n  // Upload vidéo (sens entrée, miroir du download) : capture le fichier (file picker) + le dossier Create courant,\n  // copie une commande Terminal qui transcode en HLS local (ffmpeg) puis pousse sur jsDelivr DANS ce dossier.\n  const uploadVideoCmd = async (file, destArg) => {\n    if (!file) return\n    const destF = destArg || folder || 'pages'\n    try {\n      const r = await fetch(`/api/upload-cmd?dest=${encodeURIComponent(destF)}&name=${encodeURIComponent(file.name)}`).then((x) => x.json()).catch(() => null)\n      if (!r || !r.ok) { setStatus('upload : ' + ((r && r.error) || 'erreur')); return }\n      // Presse-papiers : plus de repli document.execCommand('copy') (API dépréciée, retirée des navigateurs).\n      // Si l'écriture moderne échoue (permission refusée hors contexte utilisateur direct, etc.), message\n      // d'échec explicite au lieu d'une copie silencieuse qui peut ne pas marcher — commande loguée en console.\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f7718-8139-7212-92ac-5a47b520d9a5"}}}
