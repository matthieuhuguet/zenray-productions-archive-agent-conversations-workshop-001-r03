{"timestamp":"2026-07-18T21:26:55.889Z","ordinal":681,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f7720-0890-7d70-8990-3838f1299ada","call_id":"call_4Iaag6J7k5QPBNfH0WDSGy9c","output":[{"type":"input_text","text":"Script completed\nWall time 4.7 seconds\nOutput:\n"},{"type":"input_text","text":"// INDEX DE RECHERCHE CÔTÉ CLIENT — chargé UNE fois, gardé en local, scoré sans réseau.\n//\n// EN CLAIR POUR TOUS : avant, chaque lettre tapée dans la recherche partait demander au serveur\n// la liste des fichiers qui matchent. Lent, et ça spammait le réseau. Maintenant on télécharge\n// la grande liste de tous les chemins UNE seule fois, on la range dans une petite base locale du\n// navigateur (IndexedDB) qui survit au reload, et on cherche en mémoire instantanément. On ne\n// re-télécharge que si le serveur dit que la liste a changé (champ builtAt).\n//\n// TECHNIQUE : IndexedDB store clé->valeur. Une seule clé 'pages' stocke { builtAt, paths }.\n// Tout est best-effort : si IndexedDB est indispo (navigation privée, quota), on retombe sur un\n// chargement réseau simple sans persistance. Jamais d'exception qui casse la recherche.\n\nimport { decryptBytes } from '../media/crypto.js'\n\nconst DB_NAME = 'zr-search-index'\nconst STORE = 'idx'\nconst KEY = 'pages'\nlet dbPromise = null\n\n// INDEX SHARDÉ CHIFFRÉ servi par CDN (raw.githubusercontent, hors quota API REST). head.json (clair, dossiers\n// hachés) liste les shards ; chaque shard `s/<h>-<part>.json` = { iv, ct } AES-GCM (clé maître, même que les\n// médias). On lit head + tous les shards via raw@main (~5 min de cache, 0 appel API GitHub), on déchiffre et on\n// fusionne en { paths, thumbs, content }. Scalable (pas de mur 50 Mo) et privacy gardée (ciphertext public).\nconst IDX_BASE = 'https://raw.githubusercontent.com/matthieuhuguet/zenray-index-public/main'\nconst bytesFromB64 = (b64) => Uint8Array.from(atob(b64), (c) => c.charCodeAt(0))\n\nasync function fetchHead() {\n  try { const h = await fetch(`${IDX_BASE}/head.json`, { cache: 'no-store' }).then((r) => r.ok ? r.json() : null); return (h && Array.isArray(h.shards) && h.shards.length) ? h : null } catch { return null }\n}\nasync function loadFromCDN(head) {\n  head = head || await fetchHead()\n  if (!head) return null\n  const parts = await Promise.all(head.shards.map(async (s) => {\n    const fn = s.part != null ? `${s.h}-${s.part}.json` : `${s.h}.json`\n    try {\n      const blob = await fetch(`${IDX_BASE}/s/${fn}`).then((r) => r.ok ? r.json() : null)\n      if (!blob || !blob.ct) return null\n      const clear = await decryptBytes(bytesFromB64(blob.ct), blob.iv)\n      return JSON.parse(new TextDecoder().decode(new Uint8Array(clear)))\n    } catch { return null }\n  }))\n  const merged = { builtAt: null, paths: [], thumbs: {}, content: {}, sizes: {}, mimes: {} }\n  for (const r of parts) { if (!r) continue; if (Array.isArray(r.paths)) merged.paths.push(...r.paths); Object.assign(merged.thumbs, r.thumbs || {}); Object.assign(merged.content, r.content || {}); Object.assign(merged.sizes, r.sizes || {}); Object.assign(merged.mimes, r.mimes || {}) }\n  // DELTA : ajouts récents (drop/archive/push/HLS) pas encore repliés dans les shards. Petit, chiffré, fusionné.\n  let deltaAt = ''\n  try {\n    const dr = await fetch(`${IDX_BASE}/delta.json`, { cache: 'no-store' }).then((r) => r.ok ? r.json() : null)\n    if (dr && dr.ct) {\n      deltaAt = dr.builtAt || ''\n      const d = JSON.parse(new TextDecoder().decode(new Uint8Array(await decryptBytes(bytesFromB64(dr.ct), dr.iv))))\n      if (Array.isArray(d.paths)) { const seen = new Set(merged.paths); for (const p of d.paths) if (!seen.has(p)) merged.paths.push(p); Object.assign(merged.thumbs, d.thumbs || {}); Object.assign(merged.content, d.content || {}); Object.assign(merged.sizes, d.sizes || {}); Object.assign(merged.mimes, d.mimes || {}) }\n      // rm = chemins déplacés/supprimés : on les ôte des chemins issus des shards (sinon résultats périmés -> 404).\n      if (Array.isArray(d.rm) && d.rm.length) { const rm = new Set(d.rm); merged.paths = merged.paths.filter((p) => !rm.has(p)); for (const p of d.rm) { delete merged.thumbs[p]; delete merged.content[p] } }\n    }\n  } catch {}\n  merged.builtAt = `${head.builtAt || ''}|${deltaAt}` // jeton combiné : change si shards OU delta changent\n  return merged.paths.length ? merged : null\n}\n\nfunction openDB() {\n  if (dbPromise) return dbPromise\n  dbPromise = new Promise((resolve) => {\n    try {\n      if (typeof indexedDB === 'undefined') return resolve(null)\n      const req = indexedDB.open(DB_NAME, 1)\n      req.onupgradeneeded = () => {\n        try { const db = req.result; if (!db.objectStoreNames.contains(STORE)) db.createObjectStore(STORE) } catch {}\n      }\n      req.onsuccess = () => resolve(req.result)\n      req.onerror = () => resolve(null)\n    } catch { resolve(null) }\n  })\n  return dbPromise\n}\n\nfunction idbReadIndex() {\n  return openDB().then((db) => {\n    if (!db) return null\n    return new Promise((resolve) => {\n      try {\n        const rq = db.transaction(STORE, 'readonly').objectStore(STORE).get(KEY)\n        rq.onsuccess = () => resolve(rq.result && Array.isArray(rq.result.paths) ? rq.result : null)\n        rq.onerror = () => resolve(null)\n      } catch { resolve(null) }\n    })\n  }).catch(() => null)\n}\n\nfunction idbWriteIndex(rec) {\n  openDB().then((db) => {\n    if (!db) return\n    try { db.transaction(STORE, 'readwrite').objectStore(STORE).put(rec, KEY) } catch {}\n  }).catch(() => {})\n}\n\n// État mémoire (vivant tant que l'onglet est ouvert) : évite même le coût IndexedDB par frappe.\n// E (vignette dans l'index v2) : le record porte AUSSI `thumbs` (carte chemin->{u}|{r,p}) pour\n// que la recherche affiche les vignettes sans relire un .img.json par image. thumbs absent\n// (cache v1) -> traité comme {} -> fallback lecture manifeste (comportement actuel inchangé).\nlet mem = null // { builtAt, paths, thumbs }\nlet inflight = null\n\n// Charge l'index, en privilégiant le cache local. Vérifie le builtAt serveur (action=index est léger\n// à appeler côté GitHub car le serveur garde un cache mémoire 120 s). Si builtAt identique au cache\n// local, on garde la copie locale. Sinon on prend la liste fraîche renvoyée et on la persiste.\nexport async function loadSearchIndex() {\n  if (mem) {\n    // Rafraîchissement opportuniste en arrière-plan (ne bloque pas l'appelant).\n    if (!inflight) refresh().catch(() => {})\n    return mem\n  }\n  if (inflight) return inflight\n  inflight = (async () => {\n    const local = await idbReadIndex()\n    if (local) { mem = { builtAt: local.builtAt || null, paths: local.paths, thumbs: (local.thumbs && typeof local.thumbs === 'object') ? local.thumbs : {}, content: (local.content && typeof local.content === 'object') ? local.content : {} } }\n    // 1) Source PRIMAIRE : index shardé chiffré servi par CDN (0 quota API GitHub).\n    try {\n      const fresh = await loadFromCDN()\n      if (fresh && fresh.paths.length && (!mem || mem.builtAt !== fresh.builtAt)) { mem = fresh; idbWriteIndex(fresh) }\n    } catch {}\n    // 2) FALLBACK : ancien index privé via l'API (si le CDN est indispo ou pas encore peuplé).\n    if (!mem || !mem.paths || !mem.paths.length) {\n      try {\n        const j = await fetch('/api/page?action=index', { cache: 'no-store' }).then((r) => r.json())\n        if (j && Array.isArray(j.paths) && j.paths.length) {\n          const fresh = { builtAt: j.builtAt || null, paths: j.paths, thumbs: (j.thumbs && typeof j.thumbs === 'object') ? j.thumbs : {}, content: (j.content && typeof j.content === 'object') ? j.content : {} }\n          if (!mem || mem.builtAt !== fresh.builtAt) { mem = fresh; idbWriteIndex(fresh) }\n        }\n      } catch {}\n    }\n    inflight = null\n    return mem\n  })()\n  return inflight\n}\n\n// Vérifie en arrière-plan si l'index a changé ; met à jour mem + IndexedDB le cas échéant.\n// search-6 : on demande d'abord la TÊTE (head=1, quelques octets) pour comparer builtAt. On ne\n// re-télécharge le corps complet (~11-28 Mo) QUE si le serveur annonce un builtAt différent. Évite\n// de transférer tout l'index à chaque rafraîchissement opportuniste alors qu'il n'a pas changé.\nasync function refresh() {\n  try {\n    // head.json + delta.json sont minuscules (raw, ~5 min de cache, 0 API). On ne recharge les shards que si le\n    // jeton combiné (shards|delta) a changé -> capte aussi bien un rebuild complet qu'un simple ajout récent.\n    const head = await fetchHead(); if (!head) return\n    let deltaAt = ''\n    try { const dr = await fetch(`${IDX_BASE}/delta.json`, { cache: 'no-store' }).then((r) => r.ok ? r.json() : null); if (dr) deltaAt = dr.builtAt || '' } catch {}\n    if (`${head.builtAt || ''}|${deltaAt}` === (mem ? mem.builtAt : null)) return\n    const fresh = await loadFromCDN(head)\n    if (fresh && fresh.paths.length && (!mem || mem.builtAt !== fresh.builtAt)) { mem = fresh; idbWriteIndex(fresh) }\n  } catch {}\n}\n\n// Invalide le cache mémoire (à appeler après un ajout de nœud pour forcer un rechargement frais).\nexport function invalidateSearchIndex() { mem = null; inflight = null }\n\n// Carte chemin -> contenu plein-texte normalisé issue de l'index SERVEUR (v3). Vide tant que l'index n'a pas\n// été régénéré avec contenu. La recherche la fusionne avec le contenu LOCAL (contentIndex.js, auto-indexé).\nexport function getIndexContent() { return (mem && mem.content) || {} }\n\n// Taille d'un nœud (octets) depuis l'index -> affichée dans l'app SANS aucun appel API. null si inconnue.\nexport function getNodeSize(path) { const s = mem && mem.sizes; return (s && Number.isFinite(s[path])) ? s[path] : null }\nexport function getNodeMime(path) { const m = mem && mem.mimes; return (m && m[path]) ? m[path] : null }\n// Liste COMPLÈTE des chemins indexés (100k+) — source FIABLE, non tronquée (contrairement à action=tree). Utilisée\n// par la vue Archives pour énumérer les .file.json sans dépendre de l'arbre git récursif qui tronque.\nexport function getIndexPaths() { return (mem && Array.isArray(mem.paths)) ? mem.paths : [] }\n// Vignette d'image depuis l'index (URL/objet {u,iv}) — sert d'aperçu direct sans réassembler l'original.\nexport function getNodeThumb(path) { const t = mem && mem.thumbs; return (t && t[path]) || null }\n\n// Méta de l'index chargé (pour l'indicateur bas de Create, à la place du quota API). builtAt = jeton combiné\n// \"shards|delta\" -> on n'en montre que la partie shards (date du dernier rebuild complet). source = CDN si on a\n// chargé depuis le repo public chiffré, sinon null.\nexport function getIndexMeta() {\n  if (!mem || !mem.paths) return null\n  const at = typeof mem.builtAt === 'string' ? mem.builtAt.split('|')[0] : null\n  return { count: mem.paths.length, builtAt: at || null, source: 'CDN' }\n}\n\n// SCORING T6 : préfixe > nom > segment de chemin > contenu/sous-chaîne.\n// CONTRAT DE NORMALISATION (verrouillé, search-3) : nq, normPath et normName DOIVENT avoir été\n// passés par la MÊME normalisation que App.jsx `norm` -> minuscules, accents retirés (NFD),\n// séparateurs `/ - _ .` remplacés par des espaces, espaces compactés. La détection de \"segment de\n// chemin\" ci-dessous repose sur ce contrat (les segments sont délimités par des espaces, pas par `/`).\n// Si l'appelant change sa normalisation, ce contrat doit rester tenu sous peine de casser le score 1.\n// Plus le score est BAS, meilleur c'est (on trie ascendant).\n//   0  = le nom commence par la requête (préfixe exact du nom)        -> meilleur\n//   1  = un segment du chemin commence par la requête\n//   2  = le nom contient la requête (pas en préfixe)\n//   3  = le chemin contient la requête (contenu / sous-chaîne ailleurs)\n//   -1 = pas de match\nexport function scoreMatch(normPath, normName, nq) {\n  if (!nq) return 3\n  if (normName.startsWith(nq)) return 0\n  // Segment de chemin commençant par la requête (ex: \"build/cal\" matche segment \"calendar\").\n  // split(/\\s+/) (tout blanc) plutôt qu'un espace littéral : robuste même si la normalisation laisse\n  // un double espace, sans rien changer au comportement nominal.\n  const segs = normPath.split(/\\s+/)\n  for (const s of segs) { if (s.startsWith(nq)) return 1 }\n  if (normName.includes(nq)) return 2\n  if (normPath.includes(nq)) return 3\n  return -1\n}\n    // puis on lance les copies réseau EN PARALLÈLE et EN ARRIÈRE-PLAN (aucune attente bloquante).\n    // Nommage façon Finder : \"X copie\", puis \"X copie 2\", \"X copie 3\"… On DÉDUPLIQUE contre les noms déjà\n    // présents (et on retire un éventuel suffixe \" copie\"/\" copie N\" pour ne PAS empiler les suffixes au re-collage).\n    const taken = new Set((dirEntries || []).map((e) => (e.name || '').toLowerCase()))\n    const nextName = (raw) => {\n      const root = raw.replace(/ copie( \\d+)?$/i, '').trim() || 'copie'\n      let cand = `${root} copie`, n = 1\n      while (taken.has(cand.toLowerCase())) { n++; cand = `${root} copie ${n}` }\n      taken.add(cand.toLowerCase())\n      return cand\n    }\n    const plan = leaves.map((it) => {\n      const cp = it.contentPath\n      const leaf = leafExtension(cp)\n      const baseName = cp.split('/').pop().slice(0, -leaf.length) || 'copie'\n      const newBase = `${dest}/${nextName(baseName)}`\n      return { src: cp, leaf, newPath: newBase + leaf, newBase, isImg: leaf === '.img.json' }\n    })\n    // VIGNETTE INSTANTANÉE : une copie d'image pointe sur le MÊME binaire haché que la source -> même vignette.\n    // On résout la thumbUrl de la source (manifest déjà en cache si la tuile source a été affichée -> 0 fetch)\n    // et on l'attache à la tuile optimiste. Plus d'attente, plus de gris, plus de course de cache.\n    // Vignette source réutilisée (même hash) + MÉMORISÉE par dir cible : elle survivra à la revalidation\n    // du dossier (loadDir reconstruit sans thumbUrl) -> jamais de re-lecture, jamais de regénération, jamais gris.\n    // CHIFFRÉ : resolveThumbUrl renvoie un objectURL du CLAIR déchiffré (jamais le ciphertext) ; sinon URL directe.\n    await Promise.all(plan.map(async (p) => { if (!p.isImg) return; try { const m = await readImgManifestCached(p.src); p.thumbUrl = (await resolveThumbUrl(m)) || null; if (p.thumbUrl) copiedThumbRef.current[stripLeafExt(p.newPath)] = p.thumbUrl } catch {} }))\n    const byDir = new Map(plan.map((p) => [stripLeafExt(p.newPath), p]))\n    optimisticDir((es) => {\n      const add = entriesOfNodes(plan.map((p) => p.newPath), dest).map((x) => { const p = byDir.get(x.dir); return (p && p.thumbUrl) ? { ...x, thumbUrl: p.thumbUrl } : x })\n      const have = new Set(es.map((x) => x.dir))\n      return es.concat(add.filter((x) => !have.has(x.dir)))\n    })\n    setSelected(new Set())\n    // ANIMATION de copie dans la notif : barre qui avance à chaque fichier écrit, puis « Copié ✓ ».\n    // Écritures BORNÉES (concurrence 4) : 100 copies = 100 commits GitHub ; tout lancer d'un coup sature et\n    // fait échouer des écritures (manifests manquants au reload). On pompe par lots de 4.\n    const prog = notifyProgress({ icon: 'doc.text', tint: PALETTE.primary, label: 'Copie', title: `${leaves.length} élément(s)`, body: `Vers ${dest}…` })\n    let doneN = 0\n    const queue = plan.slice()\n    const worker = async () => {\n      while (queue.length) {\n        const p = queue.shift()\n        try { await copyNode(p) } catch {}\n        doneN++; prog.set({ progress: doneN / plan.length, body: `${doneN}/${plan.length} copié(s) vers ${dest}` })\n        invalidateManifest(p.newPath); window.dispatchEvent(new CustomEvent('zr-manifest-refresh', { detail: { path: p.newPath } }))\n      }\n    }\n    Promise.all(Array.from({ length: Math.min(4, plan.length) }, worker)).then(() => { prog.done({ title: 'Copié ✓', body: `${plan.length} élément(s) dans ${dest}` }); setStatus('copié ✓'); loadPathsDebounced() })\n  }\n  shownRef.current = shownEntries\n\n  // Navigation Finder par lettre : une frappe alphabétique sélectionne le PREMIER dossier/média dont le\n  // nom commence par cette lettre et l'amène au centre de la vue. Le scroll natif `behavior:smooth` ne permet\n  // ni de fixer 300 ms ni la courbe : animation rAF exacte EaseOutExpo, valable en icônes/listes/galerie et\n  // même quand la tuile cible n'est pas encore montée par la grille virtuelle.\n  useEffect(() => () => { if (letterScrollRaf.current) cancelAnimationFrame(letterScrollRaf.current) }, [])\n  useEffect(() => {\n    const normalizeInitial = (s) => String(s || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').trim().toLocaleLowerCase('fr')\n    const animateTo = (index, dir) => {\n      const scroller = gridScrollRef.current\n      if (!scroller) return\n      const finish = () => {\n        const safeDir = (window.CSS && CSS.escape) ? CSS.escape(dir) : dir.replace(/\"/g, '\\\\\"')\n        const mounted = scroller.querySelector(`[data-zr-dir=\"${safeDir}\"]`)\n        let target\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f7718-8139-7212-92ac-5a47b520d9a5"}}}
