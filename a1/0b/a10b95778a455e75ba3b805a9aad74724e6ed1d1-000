'\nimport spotifySearchHandler from '../server/spotify-search.js'\nimport youtubeSearchHandler from '../server/youtube-search.js'\nimport youtubeSearchV3Handler from '../server/youtube-search-v3.js'\nimport docHandler from '../server/doc.js'\nimport treeHandler from '../server/tree.js'\nimport videoCommentHandler from '../server/video-comment.js'\nimport sharedMediaHandler from '../server/shared-media.js'\nimport shareOgHandler from '../server/share-og.js'\nimport shareTokenHandler, { authorizeShareAccess, inferShareKind, isShareTarget } from '../server/share-token.js'\nimport { timingSafeEqual } from 'node:crypto'\n\n// GATE APPLICATIF (sécurité, audit famille A). Quand ZENRAY_API_SECRET est défini (prod), chaque appel /api/*\n// SENSIBLE doit porter le header `x-zr-auth: <secret>` (sinon 401). Ça remplace la dépendance au seul toggle\n// Vercel : la clé maître (media-key), les écritures (page/upload-*/publish/state) et la gestion de repos sont\n// fermées par défaut. EXEMPTÉS : les endpoints servis comme src DOM (<img>/<video>/hls.js) qui NE PEUVENT PAS\n// porter de header custom — leur contenu est chiffré sur CDN public ou derrière la protection de déploiement.\n// Si ZENRAY_API_SECRET est ABSENT (dev local, serveur loopback) -> gate DÉSACTIVÉ, rien ne change.\nconst API_SECRET = process.env.ZENRAY_API_SECRET || ''\n// raw-proxy est EXEMPTÉ du gate (servi comme src DOM <img>, ne peut pas porter x-zr-auth) : il ne sert que\n// des binaires pinnés par commit du compte owner (posters), pas de secret. raw-token, lui, RESTE gated\n// (même surface que media-key : servi au client authentifié uniquement quand le gate est actif).\n// Une balise DOM ne peut pas envoyer x-zr-auth, mais elle ne demande jamais une écriture.\n// Les routes publiques sont donc explicitement limitées à GET/HEAD. En particulier, `media`\n// n'est jamais ici : ses trois actions écrivent des blobs ou un manifeste GitHub.\nconst PUBLIC_READ_ROUTES = new Set(['img', 'stream', 'shard', 'hls', 'hls-key', 'hls-download-info', 'hls-cli', 'hls-download-script', 'shared-media', 'share-og', 'raw-proxy', 'spotify-search', 'youtube-search', 'youtube-search-v3'])\nexport const isPublicReadRoute = (req, name) => ['GET', 'HEAD'].includes(String(req.method || 'GET').toUpperCase()) && PUBLIC_READ_ROUTES.has(name)\n\nexport async function authOk(req, name) {\n  if (!API_SECRET) return true\n  if (isPublicReadRoute(req, name)) return true\n  // La résolution d'un jeton de partage est publique. Son émission et sa révocation restent protégées par\n  // x-zr-auth, comme toutes les écritures de l'app.\n  if (name === 'share-token' && (req.method || 'GET').toUpperCase() === 'GET') return true\n  // COMMENTAIRES VIDÉO : lecture ET écriture publiques (un visiteur d'un lien /watch commente sans le code\n  // du drive). Le contenu écrit est borné à { videoPath, name, text } sous pages/_comments/, rien de sensible.\n  if (name === 'video-comment') return true\n  const h = (req.headers && req.headers['x-zr-auth']) || (req.query && req.query.auth) || ''\n  if (typeof h === 'string' && h.length === API_SECRET.length) {\n    try { if (timingSafeEqual(Buffer.from(h), Buffer.from(API_SECRET))) return true } catch {}\n  }\n\n  // PARTAGE PUBLIC : une lecture page/tree anonyme doit désormais prouver qu'un partage a réellement été émis.\n  // Les anciens liens base64 restent acceptés uniquement quand leur cible correspond exactement au path demandé.\n  const method = (req.method || 'GET').toUpperCase()\n  if (name === 'page' && method === 'GET') {\n    const q = req.query || {}\n    const action = (q.action || '').toString()\n    const path = (q.path || '').toString()\n    const dir = (q.dir || '').toString()\n    const requested = action === 'read' && isShareTarget(inferShareKind(path), path) ? path\n      : action === 'tree' && isShareTarget('folder', dir) ? dir\n        : ''\n    if (requested) return authorizeShareAccess((q.share || '').toString(), requested)\n  }\n  return false\n}\n\nconst routes = {\n  page: pageHandler,\n  img: imgHandler,\n  media: mediaHandler,\n  stream: streamHandler,\n  shard: shardHandler,\n  repos: reposHandler,\n  'upload-shard': uploadShardHandler,\n  publish: publishHandler,\n  state: stateHandler,\n  unfurl: unfurlHandler,\n  upload: uploadHandler,\n  hls: hlsHandler,\n  'hls-key': hlsKeyHandler,\n  'hls-download-info': hlsDownloadInfoHandler,\n  'hls-cli': hlsCliHandler,\n  'hls-download-script': hlsDownloadScriptHandler,\n  'upload-cmd': uploadCmdHandler,\n  'upload-vid': uploadVidHandler,\n  cmdlog: cmdlogHandler,\n  'media-key': mediaKeyHandler,\n  'raw-token': rawTokenHandler, // token de LECTURE des repos privés zenrayshards-* (SW vidéo + download) — gated comme media-key\n  'raw-proxy': rawProxyHandler, // <img> des posters privés (une balise img ne peut pas porter de header) — servi comme src DOM\n  'shelf-img': shelfImgHandler,   // télécharge une image et la stocke en repo public (jsDelivr)\n  'shelf-search': shelfSearchHandler, // recherche de posters via API média (RAWG/TMDB/AniList)\n  'spotify-search': spotifySearchHandler, // recherche catalogue Spotify (Client Credentials, app-only) pour ZenRay Audio\n  'youtube-search': youtubeSearchHandler, // recherche YouTube sans clé Google Cloud (endpoint innertube public)\n  'youtube-search-v3': youtubeSearchV3Handler, // recherche YouTube API officielle Data v3 (feature sidebar -> Create, clé requise)\n  doc: docHandler,                // lecture live read-only d'un .md (repo Memory/.claude) — Documents\n  tree: treeHandler,              // liste les .md d'un repo perso — mode « parcourir tout »\n  'video-comment': videoCommentHandler, // commentaires publics sous une vidéo (lecteur + page /watch)\n  'shared-media': sharedMediaHandler,   // déchiffre côté serveur une image publique+chiffrée -> octets clairs (fix partage image + source OG)\n  'share-og': shareOgHandler,           // sert dist/index.html avec les balises Open Graph du média partagé (WhatsApp/Notion/iMessage)\n  'share-token': shareTokenHandler,     // émet/résout/révoque les jetons opaques de partage v1\n}\n\n// Vercel n'applique `export const config` que sur le fichier de fonction réellement déployé\n// (= ce routeur). media.js et upload-shard.js déclaraient un bodyParser à 8mb ; on relève donc\n// la limite ici à 8mb pour TOUT le routeur, sinon les uploads chunkés (parts 3 Mo) seraient\n// rejetés en 413. ATTENTION : la plateforme impose malgré tout un plafond effectif proche de 4,5 Mo ;\n// SharedFolderPage.jsx — PAGE PUBLIQUE « galerie / dossier partagé » (lien /folder?d=<token>).\n//\n// Même principe que ShareVideoPage : on n'affiche QUE le contenu du dossier (vignettes + ouverture), sans\n// sidebar, sans drive, sans auth. Le token v1 est opaque, signé, expirant et révocable ; les anciens tokens\n// base64 restent lisibles. On navigue dans les sous-dossiers en restant SOUS la racine partagée.\n//\n// Données : l'arbre global (/api/page?action=tree) donne les chemins ; chaque manifeste (.media.json/.img.json)\n// est lu pour la vignette/titre/durée. Vidéos = posters publics (clair). Images = vignette déchiffrée côté\n// serveur par /api/shared-media : le visiteur ne reçoit jamais la clé du drive.\nimport React, { useEffect, useState, useMemo, useRef } from 'react'\nimport { THEMES, PALETTE } from '../theme.js'\nimport { appendShareCredential, resolveShareToken, SHARE_KIND } from '../lib/shareLinks.js'\nimport { useT } from '../i18n/useT.js'\nimport { downloadFolderAsZip, resolveSharedEntryBytes, downloadSharedVideo } from '../lib/bulkZip.js'\nimport { lazyRetry } from '../lib/lazyRetry.js'\nimport Icon from './Icon.jsx'\nimport { useInView } from '../media/useImageThumb.js'\nimport { isEncrypted, shardThumbUrl } from './ImageNodeViewer.jsx'\nimport { readPageCached } from '../lib/manifestReadCache.js'\nconst LazyVideoPlayer2 = lazyRetry(() => import('./VideoPlayer2.jsx'))\n\nconst FONTS = { sans: \"'AnthropicSans', system-ui, sans-serif\", serif: \"'AnthropicSerif', Georgia, serif\" }\nconst fmtDur = (s) => s ? `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}` : ''\nconst baseName = (p) => { const n = p.split('/').pop(); return n.replace(/\\.(mp4|mov|m4v|avi|mkv)\\.media\\.json$/i, '').replace(/\\.[^.]+\\.(img|media|file)\\.json$/i, '').replace(/\\.[^.]+$/, '') }\nconst isSidecar = (p) => /\\.(m3u8|mpd)$/i.test(p) || p.endsWith('.hlskey.bin')\n\n// Carte média : résout sa vignette + titre + durée à l'affichage.\n// Un clic sélectionne (Finder), un double-clic ouvre ; la touche Espace ouvre la photo sélectionnée.\nfunction MediaCard({ node, t, onOpen, selectMode, selected, focused, onSelect, shareToken }) {\n  const [thumb, setThumb] = useState(null)\n  const [meta, setMeta] = useState(null)\n  const [imageReady, setImageReady] = useState(false)\n  const { ref, inView } = useInView()\n  useEffect(() => {\n    if (!inView) return\n    let dead = false\n    setThumb(null); setMeta(null); setImageReady(false)\n    ;(async () => {\n      try {\n        const j = await readPageCached(appendShareCredential(`/api/page?action=read&path=${encodeURIComponent(node.path)}`, shareToken))\n        if (!j) throw new Error('manifest')\n        const m = JSON.parse(j.markdown); if (dead) return\n        setMeta(m)\n        if (node.kind === 'video' && m.poster) setThumb(m.poster)\n        // FIX (2026-07-01) : décrypter côté client exigeait fetch('/api/media-key'), gaté -> 401 pour tout\n        // visiteur anonyme du lien /folder = vignettes qui restaient blanches. /api/shared-media déchiffre\n        // CÔTÉ SERVEUR (public, sans exposer la clé) -> une simple <img src> suffit, marche pour n'importe qui.\n        // Comme ShareImagePage.jsx : seules les images RÉELLEMENT chiffrées (isEncrypted) ont besoin de ce\n        // détour serveur — une image publique non chiffrée sert sa vignette directement depuis le CDN.\n        else if (node.kind === 'image') setThumb(isEncrypted(m) ? appendShareCredential(`/api/shared-media?path=${encodeURIComponent(node.path)}&kind=thumb`, shareToken) : shardThumbUrl(m))\n      } catch {}\n    })()\n    return () => { dead = true }\n  }, [node.path, inView, shareToken])\n  const dur = (meta && (meta.duration || (meta.probe && meta.probe.duration))) || 0\n  const title = (meta && meta.title) || node.name\n  const width = Number(meta && meta.w)\n  const height = Number(meta && meta.h)\n  const ratio = width > 0 && height > 0 ? `${width} / ${height}` : '16 / 9'\n  return (\n    <button ref={ref} data-shared-path={node.path} onPointerDown={(ev) => ev.stopPropagation()} onClick={() => onSelect(node, meta)} onDoubleClick={() => onOpen(node, meta)} aria-pressed={selectMode ? selected : undefined}\n      style={{ position: 'relative', display: 'flex', flexDirection: 'column', gap: 9, padding: 0, border: 'none', background: 'transparent', cursor: 'pointer', textAlign: 'center', minWidth: 0, borderRadius: 9 }}>\n      <div style={{ position: 'relative', width: '100%', aspectRatio: ratio, borderRadius: 9, overflow: 'hidden', background: 'rgba(128,128,128,0.10)', boxShadow: selected ? `0 0 0 2px ${PALETTE.primary}` : '0 1px 2px rgba(0,0,0,0.08)' }}>\n        {/* pas de placeholder « … » (2026-07-13) : la case reste un simple fond neutre, l'image fond dedans */}\n        {thumb && <img src={thumb} alt=\"\" draggable={false} onLoad={() => setImageReady(true)} style={{ width: '100%', height: '100%', objectFit: 'cover', opacity: imageReady ? 1 : 0, transition: 'opacity 200ms ease' }} />}\n        {node.kind === 'video' && (\n          <span style={{ position: 'absolute', inset: 0, display: 'grid', placeItems: 'center' }}>\n            <span style={{ width: 46, height: 46, borderRadius: 99, background: 'rgba(0,0,0,0.45)', backdropFilter: 'blur(4px)', display: 'grid', placeItems: 'center' }}>\n              <span style={{ width: 0, height: 0, borderTop: '8px solid transparent', borderBottom: '8px solid transparent', borderLeft: '13px solid #fff', marginLeft: 3 }} />\n            </span>\n          </span>\n        )}\n        {node.kind === 'video' && dur > 0 && <span style={{ position: 'absolute', right: 6, bottom: 6, background: 'rgba(0,0,0,0.82)', color: '#fff', fontSize: 11, fontWeight: 600, padding: '2px 5px', borderRadius: 4 }}>{fmtDur(dur)}</span>}\n      </div>\n      <div title={title} style={{ width: '100%', fontFamily: FONTS.sans, fontSize: 12.5, fontWeight: 500, lineHeight: 1.3, color: t.textPrimary, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap', padding: '0 2px', boxSizing: 'border-box' }}>{title}</div>\n    </button>\n  )\n}\n\nexport default function SharedFolderPage() {\n  const t = THEMES.light\n  const i18nT = useT()\n  const [root, setRoot] = useState(null)\n  const [shareToken] = useState(() => new URLSearchParams(window.location.search).get('d') || '')\n  const [sub, setSub] = useState('')                 // sous-chemin relatif sous la racine (navigation interne)\n  const folder = root && sub ? `${root}/${sub}` : (root || '')\n  const [paths, setPaths] = useState(null)\n  const [err, setErr] = useState(null)\n  const [open, setOpen] = useState(null)             // { node, meta } ouvert en overlay\n\n        </div>\n      )}\n    </div>\n  )\n}\n\n// Image plein écran. FIX (2026-07-01) : déchiffrement CÔTÉ SERVEUR via /api/shared-media (public, la clé ne\n// quitte jamais le serveur) au lieu du fetch('/api/media-key') client qui échouait (401) pour tout visiteur\n// anonyme du lien -> l'image plein écran restait invisible pour le destinataire du /folder partagé.\nfunction SharedImage({ node, meta, t, shareToken }) {\n  const i18nT = useT()\n  const [manifest, setManifest] = useState(meta || null)\n  const [thumbReady, setThumbReady] = useState(false)\n  const [thumbSettled, setThumbSettled] = useState(false)\n  const [fullReady, setFullReady] = useState(false)\n  const [fullFailed, setFullFailed] = useState(false)\n  const [viewport, setViewport] = useState(() => ({ w: typeof window === 'undefined' ? 1200 : window.innerWidth, h: typeof window === 'undefined' ? 800 : window.innerHeight }))\n\n  useEffect(() => {\n    let dead = false\n    setManifest(meta || null); setThumbReady(false); setThumbSettled(false); setFullReady(false); setFullFailed(false)\n    if (meta) return () => { dead = true }\n    if (!node || !node.path) return () => { dead = true }\n    fetch(appendShareCredential(`/api/page?action=read&path=${encodeURIComponent(node.path)}`, shareToken), { cache: 'no-store' })\n      .then((r) => r.json())\n      .then((j) => { const m = JSON.parse(j.markdown); if (!dead) setManifest(m) })\n      .catch(() => { if (!dead) setFullFailed(true) })\n    return () => { dead = true }\n  }, [node && node.path, meta, shareToken])\n\n  useEffect(() => {\n    const onResize = () => setViewport({ w: window.innerWidth, h: window.innerHeight })\n    window.addEventListener('resize', onResize)\n    return () => window.removeEventListener('resize', onResize)\n  }, [])\n\n  if (!node || !node.path) return <div style={{ color: '#fff', padding: 40, textAlign: 'center' }}>{i18nT('folder.loadingImage')}</div>\n  const width = Number(manifest && manifest.w) || 16\n  const height = Number(manifest && manifest.h) || 9\n  const ratio = width / height\n  const frameWidth = Math.max(1, Math.min(1400, viewport.w * 0.94, viewport.h * 0.88 * ratio))\n  const thumbUrl = appendShareCredential(`/api/shared-media?path=${encodeURIComponent(node.path)}&kind=thumb`, shareToken)\n  const fullUrl = appendShareCredential(`/api/shared-media?path=${encodeURIComponent(node.path)}&kind=full`, shareToken)\n\n  // PLUS DE FLOU, PLUS DE SPINNER (2026-07-13, demande Matthieu — même décision que QuickLookOverlay.jsx) :\n  // la vignette 1080p s'affiche nette en simple fondu, le plein format se superpose en douceur quand il est\n  // prêt. Aucun indicateur de chargement : l'utilisateur voit juste l'image s'affiner, jamais de saccade.\n  return <div style={{ position: 'relative', width: frameWidth, maxWidth: '100%', aspectRatio: `${width} / ${height}`, overflow: 'hidden', borderRadius: 14, background: 'rgba(0,0,0,0.30)', boxShadow: '0 18px 60px rgba(0,0,0,0.28)' }}>\n    <img src={thumbUrl} alt=\"\" onLoad={() => { setThumbReady(true); setThumbSettled(true) }} onError={() => setThumbSettled(true)}\n      style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', objectFit: 'contain', opacity: thumbReady ? 1 : 0, transition: 'opacity 160ms ease' }} />\n    {thumbSettled && <img src={fullUrl} alt=\"\" onLoad={() => setFullReady(true)} onError={() => setFullFailed(true)}\n      style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', objectFit: 'contain', opacity: fullReady ? 1 : 0, transition: 'opacity 180ms ease' }} />}\n  </div>\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f760f-3707-7e32-9422-c315b4778481"}}}
