{"timestamp":"2026-07-18T21:42:56.856Z","ordinal":933,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f772e-b258-72f3-bf4b-63f734292718","call_id":"call_kEVDv7u8I6nr9Pv76H7QdF9F","output":[{"type":"input_text","text":"Script completed\nWall time 3.3 seconds\nOutput:\n"},{"type":"input_text","text":"2:// Env Vercel : GITHUB_TOKEN (scope repo). CONTENT_REPO (defaut matthieuhuguet/zenray-data), CONTENT_BRANCH (main).\n247:  const token = process.env.GITHUB_TOKEN\n\nexport default async function handler(req, res) {\n  const token = process.env.GITHUB_TOKEN\n  if (!token) return res.status(200).json({ error: 'no-token' })\n  res.setHeader('Cache-Control', 'no-store')\n\n  try {\n    if (req.method === 'GET') {\n      const action = (req.query.action || 'list').toString()\n      if (action === 'ratelimit') {\n        // Compteur de quota LIVE : l'endpoint GitHub /rate_limit NE CONSOMME PAS le quota REST -> gratuit à\n        // interroger. On renvoie le coeur (core) : restantes / plafond / heure de reset (epoch secondes).\n        const r = await fetch('https://api.github.com/rate_limit', { headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json', 'User-Agent': 'zenray-progress' } })\n        if (!r.ok) return res.status(200).json({ error: 'github' })\n        const j = await r.json()\n        const c = (j.resources && j.resources.core) || j.rate || {}\n        return res.status(200).json({ remaining: c.remaining, limit: c.limit, reset: c.reset })\n      }\n      if (action === 'list') {\n        const dir = (req.query.dir || 'pages').toString()\n        if (!['pages', 'databases', 'build'].includes(dir)) return res.status(400).json({ error: 'bad-dir' })\n        const ext = dir === 'pages' ? '.md' : '.json'\n        const r = await gh(token, `contents/${dir}?ref=${BRANCH}`)\n        if (r.status === 404) return res.status(200).json({ pages: [], items: [] })\n        if (!r.ok) return res.status(200).json({ pages: [], items: [], error: 'github', ...rlInfo(r) })\n        const arr = await r.json()\n        const items = (Array.isArray(arr) ? arr : []).filter((x) => x.type === 'file' && x.name.endsWith(ext) && x.name !== '.keep.md' && x.name !== '.keep')\n          .map((x) => ({ path: x.path, name: x.name.slice(0, -ext.length), sha: x.sha }))\n        return res.status(200).json({ pages: items, items })\n      }\n      // Enfants DIRECTS d'un dossier. FIX 1000 (2026-06-11) : l'API Contents PLAFONNE à 1000 entrées par dossier\n      // (limite GitHub dure, non paginable) -> les gros dossiers tronquaient et les vidéos (noms en fin de tri)\n      // disparaissaient. On passe par git/trees NON récursif sur le tree-ish `branche:chemin` : TOUTES les entrées\n      // du dossier (limite ~100k/dossier). Fallback Contents conservé si le tree-ish échoue.\n      if (action === 'children') {\n        const dir = (req.query.dir || 'pages').toString().replace(/\\/+$/, '')\n        // Memory (dossier LIVE, repo distinct, lecture seule) : arbre filesystem PLAT, aucun filtre\n        // d'extension (contrairement à NODE_RE ci-dessous, pensé pour les nœuds Notion de zenray-data) —\n        // Memory contient des fichiers de toute nature (.md/.py/.pdf/.json/sans extension…), tous affichés tels quels.\n        if (dir === 'Memory' || dir.startsWith('Memory/')) {\n          if (dir.includes('..')) return res.status(400).json({ error: 'bad-dir' })\n// Journal des operations Git/drive (ecritures GitHub API) — en memoire, anneau borne.\n// But : tracer chaque ecriture distante (PUT/POST/DELETE contents, git/blobs, git/trees,\n// git/commits, git/refs, pulls...) pour un panneau \"Repo Commands\" dans l'UI.\n//\n// CONTRAINTE P0 (anti-fuite) : JAMAIS de nom de media humain dans `command`/`detail`.\n// Les chemins exposes sont anonymises : on garde la structure (repo, type de ressource,\n// dossier de tete) mais le segment terminal (basename, qui peut contenir un titre humain\n// sous pages/) est remplace par un hash court non reversible. Les chemins deja haches\n// (ab/cd/<sha>) passent tels quels — ils ne portent aucun nom humain.\n//\n// Stockage en memoire process : suffisant en local (node scripts/local-server.mjs) et\n// acceptable en serverless (le log se vide entre cold starts, ce n'est qu'un fil d'activite\n// recent, pas une source de verite). Aucune persistance disque/repo voulue.\n\nimport crypto from 'crypto'\n\nconst MAX = 300\n/** @type {Array<object>} anneau : on push en fin, on shift en tete au-dela de MAX */\nconst ring = []\nlet seq = 0\n\n// --- Anonymisation des chemins ----------------------------------------------\n// Un segment \"haché\" = uniquement [A-Za-z0-9] et long (>= 16), ou un sha hex >= 7.\nconst isHashy = (s) => /^[A-Fa-f0-9]{7,}$/.test(s) || (/^[A-Za-z0-9._-]+$/.test(s) && s.replace(/[._-]/g, '').length >= 24)\n\nfunction shortHash(s) {\n  return crypto.createHash('sha1').update(String(s)).digest('hex').slice(0, 8)\n}\n\n// Anonymise un chemin de contenu : garde les segments structurels (dossiers connus,\n// segments deja haches) et masque tout segment \"humain\" (titre de page, nom de fichier\n// lisible) en `~<hash8>` + extension preservee.\nexport function anonPath(p) {\n  if (typeof p !== 'string' || !p) return p\n  // git refs / endpoints non-contents : pas de nom humain, laisser tel quel\n  if (!p.includes('/')) return p\n  let path = p\n  let query = ''\n  const q = path.indexOf('?')\n  if (q >= 0) { query = path.slice(q); path = path.slice(0, q) }\n  try { path = decodeURI(path) } catch {}\n  const segs = path.split('/')\n  const out = segs.map((seg, i) => {\n    if (!seg) return seg\n    // 1er segment = dossier de tete structurel (pages, media, build, ab/cd hash...) -> garder s'il est court & connu\n    if (isHashy(seg)) return seg\n    if (i < segs.length - 1) {\n      // segment intermediaire : si court & sans espace, c'est structurel (dossier) -> garder\n      if (seg.length <= 12 && !/\\s/.test(seg) && /^[A-Za-z0-9._-]+$/.test(seg)) return seg\n      return `~${shortHash(seg)}`\n    }\n    // dernier segment (basename) : preserver l'extension, masquer le nom\n    const dot = seg.lastIndexOf('.')\n    const ext = dot > 0 ? seg.slice(dot) : ''\n    const base = dot > 0 ? seg.slice(0, dot) : seg\n    if (isHashy(base)) return seg\n    return `~${shortHash(base)}${ext}`\n  })\n  return out.join('/') + query\n}\n\n// Construit la representation lisible d'une commande : \"<METHOD> <ressource anonymisee>\".\nexport function describeCommand(method, resourcePath) {\n  const m = (method || 'GET').toUpperCase()\n  // git/* et user/* et pulls : endpoints structurels, pas de chemin contenu -> brut\n  if (/^(git\\/|pulls$|pulls\\b|user\\/|repos$)/.test(resourcePath) || !resourcePath.includes('contents/')) {\n    return `${m} ${resourcePath.split('?')[0]}`\n  }\n  // contents/<path> -> anonymiser la partie <path>\n  const idx = resourcePath.indexOf('contents/')\n  const head = resourcePath.slice(0, idx + 'contents/'.length)\n  const tail = resourcePath.slice(idx + 'contents/'.length)\n  return `${m} ${head}${anonPath(tail)}`\n}\n\n// Enregistre une operation au statut \"pending\". Retourne un handle id.\nexport function logStart({ repo, dir, action, command }) {\n  const id = ++seq\n  const entry = {\n    id,\n    ts: Date.now(),\n    repo: repo || null,\n    dir: dir ? anonPath(dir) : null,\n    action: action || null,\n    command: command || null,\n    status: 'pending',\n    httpStatus: null,\n    detail: null,\n  }\n  ring.push(entry)\n  while (ring.length > MAX) ring.shift()\n  return id\n}\n\n// Cloture une operation (success/failed). detail = court extrait lisible (jamais de nom humain).\nexport function logEnd(id, { status, httpStatus, detail } = {}) {\n  const e = ring.find((x) => x.id === id)\n  if (!e) return\n  e.status = status || (httpStatus && httpStatus < 400 ? 'success' : 'failed')\n  if (httpStatus != null) e.httpStatus = httpStatus\n  if (detail != null) e.detail = String(detail).slice(0, 400)\n}\n\n// Enveloppe un wrapper fetch existant (ex: gh(token, path, init)) pour journaliser\n// AUTOMATIQUEMENT toute ecriture (PUT/POST/DELETE). Les lectures (GET) ne sont pas loggees.\n//   raw  : la fonction fetch d'origine\n//   meta : { repoOf(args) -> string, pathOf(args) -> string, initOf(args) -> init }\n// Retourne une fonction de meme signature qui logge puis delegue.\nexport function instrument(raw, meta) {\n  return async function (...args) {\n    let id = null\n    let path = ''\n    let method = 'GET'\n    try {\n      path = meta.pathOf(args) || ''\n      const init = meta.initOf ? meta.initOf(args) : (args.find((a) => a && a.method) || {})\n      method = (init && init.method) || 'GET'\n      if (method !== 'GET' && method !== 'HEAD') {\n        const repo = meta.repoOf ? meta.repoOf(args) : null\n        const dir = path.includes('contents/') ? path.slice(path.indexOf('contents/') + 9) : path\n        id = logStart({ repo, dir, action: method.toLowerCase(), command: describeCommand(method, path) })\n      }\n    } catch {}\n    try {\n      const res = await raw(...args)\n      if (id != null) {\n        let detail = null\n        if (res && res.status >= 400) {\n          try { detail = (await res.clone().text()).slice(0, 300) } catch {}\n        }\n        logEnd(id, { httpStatus: res ? res.status : null, detail })\n      }\n      return res\n    } catch (err) {\n      if (id != null) logEnd(id, { status: 'failed', detail: err && err.message })\n      throw err\n    }\n  }\n}\n\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f7718-8139-7212-92ac-5a47b520d9a5"}}}
