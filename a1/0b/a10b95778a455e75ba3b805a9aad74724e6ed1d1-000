aders.get('x-ratelimit-reset')\n  const resetAt = reset ? Number(reset) * 1000 : (Date.now() + 60000)\n  return { rateLimited: true, resetAt }\n}\n// .md/.json partout (existant) + parts de média : media/<id>/NNN.bin (branche dédiée, reste strict ailleurs).\nconst safe = (p) => typeof p === 'string' && !p.includes('..') && (\n  ((p.startsWith('pages/') || p.startsWith('build/') || p.startsWith('databases/') || p.startsWith('gallery/') || p.startsWith('references/') || p.startsWith('audio/') || p.startsWith('sfx/') || p.startsWith('articles/') || p.startsWith('freelance/') || p.startsWith('shelf/') || p.startsWith('trash/') || p.startsWith('media/')) && /\\.(md|json)$/.test(p))\n  || /^media\\/[A-Za-z0-9._-]+\\/\\d{3}\\.bin$/.test(p)\n  // Fichiers auxiliaires HLS (playlist + clé AES) écrits par le pipeline vidéo sous pages/ : autorisés en\n  // lecture/suppression pour permettre la purge définitive d'une vidéo (master.m3u8, stream_*.m3u8, .hlskey.bin).\n  || ((p.startsWith('pages/') || p.startsWith('trash/')) && /\\.(m3u8)$/.test(p))\n  || ((p.startsWith('pages/') || p.startsWith('trash/')) && /\\.hlskey\\.bin$/.test(p))\n)\n\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms))\n\n// COMMIT ATOMIQUE d'un jeu d'entrees d'arbre (add: {path,mode,type,sha} / remove: sha=null) avec RETRY\n// FAST-FORWARD. On (re)lit HEAD, on pose l'arbre sur le base_tree FRAIS, on commit, on met a jour la ref en\n// fast-forward (force:false). Si HEAD a bouge entre-temps (non-fast-forward), on RECOMMENCE sur le HEAD frais.\n// Les entrees referencent des blobs par sha (content-addressed) -> rejouables sans risque. Empeche la perte\n// silencieuse de commits concurrents ET garantit l'atomicite (move/move-tree en UN commit, jamais a moitie).\nasync function commitTree(token, entries, message, tries = 5) {\n  let last = 'fail'\n  for (let i = 0; i < tries; i++) {\n    const refR = await gh(token, `git/ref/heads/${BRANCH}`); if (!refR.ok) { last = 'ref'; await sleep(200 * (i + 1)); continue }\n    const headSha = (await refR.json()).object.sha\n    const cR = await gh(token, `git/commits/${headSha}`); if (!cR.ok) { last = 'commit-read'; await sleep(200 * (i + 1)); continue }\n    const baseTree = (await cR.json()).tree.sha\n    const ntR = await gh(token, 'git/trees', { method: 'POST', body: JSON.stringify({ base_tree: baseTree, tree: entries }) })\n    if (!ntR.ok) { last = 'newtree ' + (await ntR.text()).slice(0, 100); if (ntR.status >= 500) { await sleep(300 * (i + 1)); continue } break }\n    const newTree = (await ntR.json()).sha\n    const ncR = await gh(token, 'git/commits', { method: 'POST', body: JSON.stringify({ message, tree: newTree, parents: [headSha] }) })\n    if (!ncR.ok) { last = 'newcommit'; if (ncR.status >= 500) { await sleep(300 * (i + 1)); continue } break }\n    const newCommit = (await ncR.json()).sha\n    const pr = await gh(token, `git/refs/heads/${BRANCH}`, { method: 'PATCH', body: JSON.stringify({ sha: newCommit, force: false }) })\n    if (pr.ok) return { ok: true, commit: newCommit }\n    last = 'ref-update ' + pr.status\n    if (pr.status === 422 || pr.status === 409 || pr.status >= 500) { await sleep(300 * (i + 1)); continue } // non-fast-forward -> on rejoue sur le HEAD frais\n    break\n  }\n  return { ok: false, error: last }\n}\n\n// Reecriture des refs de chemin (from->to) dans les fichiers texte (playlists HLS, manifeste media), AVEC garde\n// de FRONTIERE : on ne remplace qu'a la limite '/' (ou '%2F' en URL-encode), donc deplacer `pages/A` ne corrompt\n// JAMAIS `pages/AB`. Couvre le brut, l'encode-complet (?path=) et l'encode-partiel.\nfunction rewriteTreePaths(txt, from, to) {\n  const variants = [\n    [from + '/', to + '/'],\n    [encodeURIComponent(from) + '%2F', encodeURIComponent(to) + '%2F'],\n    [encodeURI(from) + '/', encodeURI(to) + '/'],\n        if (path === 'Memory' || path.startsWith('Memory/')) {\n          if (path.includes('..')) return res.status(400).json({ error: 'bad-path' })\n          const sub = path.slice('Memory/'.length)\n          try {\n            const rr = await fetch(`https://raw.githubusercontent.com/${MEMORY_REPO}/main/${encodeURI(sub)}`, { headers: { Authorization: `Bearer ${token}`, 'User-Agent': 'zenray-progress' } })\n            if (rr.status === 404) return res.status(200).json({ markdown: '', sha: null, missing: true })\n            if (rr.ok) return res.status(200).json({ markdown: await rr.text(), sha: null, path, raw: true })\n            return res.status(200).json({ error: 'github' })\n          } catch { return res.status(200).json({ error: 'github' }) }\n        }\n        if (!safe(path)) return res.status(400).json({ error: 'bad-path' })\n        // LECTURE D'AFFICHAGE HORS QUOTA (raw=1) : pour les lectures qui n'ont PAS besoin du sha (manifests\n        // .img.json des vignettes, .props/.comments en lecture seule, .md pour détecter une couverture), on sert\n        // via raw.githubusercontent.com qui NE COMPTE PAS dans la limite REST 5000/h. C'est le gros volume (1 par\n        // image affichée) -> parcourir des milliers d'images ne consomme plus le quota. Repli API contents si raw KO.\n        // Les lectures D'ÉDITION (qui sauvegardent ensuite) n'envoient PAS raw=1 et gardent le sha via l'API.\n        if (req.query.raw) {\n          try {\n            const rr = await fetch(`https://raw.githubusercontent.com/${REPO}/${BRANCH}/${encodeURI(path)}`, { headers: { Authorization: `Bearer ${token}`, 'User-Agent': 'zenray-progress' } })\n            if (rr.status === 404) return res.status(200).json({ markdown: '', sha: null, missing: true })\n            if (rr.ok) return res.status(200).json({ markdown: await rr.text(), sha: null, path, raw: true })\n          } catch {}\n          // raw KO (rare) -> on retombe sur l'API contents ci-dessous.\n        }\n        const r = await gh(token, `contents/${encodeURI(path)}?ref=${BRANCH}`)\n        if (r.status === 404) return res.status(200).json({ markdown: '', sha: null, missing: true })\n        if (!r.ok) return res.status(200).json({ error: 'github', ...rlInfo(r) })\n        const j = await r.json()\n        return res.status(200).json({ markdown: b64d(j.content), sha: j.sha, path })\n      }\n      // Resolve an Eagle placement once, before any viewer is chosen.  Links are\n      // flattened at creation, but the bounded loop also keeps old/corrupt data\n      // harmless instead of allowing a recursive viewer fetch.\n      if (action === 'resolve-link') {\n        const requeste…2265 tokens truncated…rimé = 409, ou sha absent sur un fichier qui existe déjà = 422) : on ne laisse JAMAIS\n        // l'écriture se perdre en silence. On renvoie le sha + le contenu COURANT du drive pour que le client\n        // ré-applique son intention (read-modify-write) puis re-save. Voir saveJsonWithRetry côté client.\n        if (r.status === 409 || r.status === 422) {\n          let cur = null\n          try { const g = await gh(token, `contents/${encodeURI(path)}?ref=${BRANCH}`); if (g.ok) { const cj = await g.json(); cur = { sha: cj.sha, markdown: b64d(cj.content) } } } catch {}\n          return res.status(200).json({ error: 'conflict', conflict: true, ...(cur || {}) })\n        }\n        if (!r.ok) { const t = await r.text(); return res.status(200).json({ error: 'github', detail: t.slice(0, 160) }) }\n        const j = await r.json()\n        return res.status(200).json({ ok: true, sha: j.content && j.content.sha, path })\n      }\n\n      // Mise à jour INCRÉMENTALE de l'index de recherche après un ajout de nœud (drop / Ctrl-V).\n      // Sans ça, l'index complet (pages/.zr-search-index.json) ne se reconstruisait qu'à la main\n      // via scripts/build-search-index.mjs : les fichiers fraîchement déposés restaient introuvables\n      // par la recherche jusqu'au prochain rebuild. Ici on AJOUTE seulement les chemins manquants\n      // (jamais de suppression), via la Git Data API (blob + tree base_tree + commit + ref force:false),\n      // exactement comme l'importeur, donc aucun risque d'effacer les autres nœuds. Best-effort,\n      // déclenché en arrière-plan par universalCapture : un échec ne bloque jamais l'upload.\n      // AUTO-INDEXATION UNIVERSELLE (drop/Ctrl-V, archive clonée, push Claude, vidéo HLS...) : tout nouveau nœud\n      // est appendé au DELTA public chiffré -> cherchable immédiatement, sans réécrire le gros index, sans quota.\n      if (action === 'index-add') {\n        const add = (Array.isArray(body.paths) ? body.paths : [])\n          .filter((p) => typeof p === 'string' && p && !p.includes('..') && !p.endsWith('.zr-search-index.json'))\n        if (!add.length) return res.status(200).json({ ok: true, added: 0 })\n        const newThumbs = await thumbsForPaths(token, add)\n        const ok = await appendPublicDelta(token, add, newThumbs)\n        const g = globalThis; if (g.__zrIndex) g.__zrIndex = null\n        return res.status(200).json({ ok: true, added: add.length, delta: ok })\n      }\n\n      if (action === 'delete') {\n        const { path, sha } = body\n        if (!safe(path) || !sha) return res.status(400).json({ error: 'bad-path' })\n        // Média chunké : purger d'abord toutes les parts du dossier, puis le manifest.\n        if (path.endsWith('.media.json')) {\n          let dir = null\n          try { const mr = await gh(token, `contents/${encodeURI(path)}?ref=${BRANCH}`); if (mr.ok) dir = JSON.parse(b64d((await mr.json()).content)).dir } catch {}\n          if (dir && /^media\\/[A-Za-z0-9._-]+$/.test(dir)) {\n            const tr = await gh(token, `git/trees/${BRANCH}?recursive=1`)\n            if (tr.ok) {\n              const tree = (await tr.json()).tree || []\n              for (const x of tree) {\n                if (x.type === 'blob' && x.path.startsWith(dir + '/')) {\n                  await gh(token, `contents/${encodeURI(x.path)}`, { method: 'DELETE', body: JSON.stringify({ message: 'content delete part', sha: x.sha, branch: BRANCH }) })\n                }\n              }\n            }\n          }\n        }\n        const r = await gh(token, `contents/${encodeURI(path)}`, { method: 'DELETE', body: JSON.stringify({ message: 'content delete', sha, branch: BRANCH }) })\n        if (!r.ok) return res.status(200).json({ error: 'github' })\n        return res.status(200).json({ ok: true })\n      }\n\n      // Déplacement SÛR d'une page-feuille (re-parenter). Ordre : lire -> créer à la cible -> vérifier -> supprimer la source.\n      // Gère les 3 jumeaux (.md, .blocknote.json, .comments.json). Refuse si la cible .md existe déjà. Aucune perte si interrompu.\n      if (action === 'move') {\n        const { from, to } = body\n        const isDb = from.endsWith('.db.json') && to.endsWith('.db.json')\n        const isMedia = from.endsWith('.media.json') && to.endsWith('.media.json')\n        const isImg = from.endsWith('.img.json') && to.endsWith('.img.json')\n        // Ref (plan §6 Phase 0 task 3) : board .canvas.json et carte .embed.json sont des fichiers JSON AUTONOMES\n        // (aucun jumeau, aucun binaire externe à suivre) -> même déplacement atomique que .db.json : on bouge\n        // juste le descripteur. Non destructif : créer la cible PUIS supprimer la source.\nimport { describe, it, expect } from 'vitest'\nimport { isExposedTreeNode } from './nodeTreeFilter.js'\n\ndescribe('isExposedTreeNode', () => {\n  it('expose les extensions de noeud connues', () => {\n    expect(isExposedTreeNode('pages/A.md')).toBe(true)\n    expect(isExposedTreeNode('pages/A.db.json')).toBe(true)\n    expect(isExposedTreeNode('pages/A.img.json')).toBe(true)\n  })\n\n  it('expose le marqueur .zrfolder.json (régression 2026-07-12)', () => {\n    expect(isExposedTreeNode('pages/A/.zrfolder.json')).toBe(true)\n  })\n\n  it('expose le marqueur .zrmusic.json (régression 2026-07-16 : dead code sinon)', () => {\n    expect(isExposedTreeNode('pages/Music/.zrmusic.json')).toBe(true)\n  })\n\n  it('rejette un fichier interne jumeau 