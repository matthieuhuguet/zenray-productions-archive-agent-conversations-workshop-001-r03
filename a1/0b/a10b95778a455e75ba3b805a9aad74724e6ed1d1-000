{"timestamp":"2026-07-18T16:29:25.834Z","ordinal":488,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f760f-a9ca-7db0-aea5-1a287a205337","call_id":"call_aG7YKUSPekwMZdTpQsv6iEkg","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"}\n\n// Vercel n'applique `export const config` que sur le fichier de fonction réellement déployé\n// (= ce routeur). media.js et upload-shard.js déclaraient un bodyParser à 8mb ; on relève donc\n// la limite ici à 8mb pour TOUT le routeur, sinon les uploads chunkés (parts 3 Mo) seraient\n// rejetés en 413. ATTENTION : la plateforme impose malgré tout un plafond effectif proche de 4,5 Mo ;\n// universalCapture conserve donc des parts de 3 Mo. Ne jamais relever CHUNK_SIZE en se fiant au « 8mb ».\n// Les autres routes ne sont pas impactées par une limite déclarative plus haute.\nexport const config = { api: { bodyParser: { sizeLimit: '8mb' } } }\n\nexport default async function handler(req, res) {\n  // Le segment dynamique est nommé `route` (fichier [...route].js) et NON `path`, pour ne PAS écraser\n  // le paramètre de requête ?path= utilisé par les handlers (img/shard/hls/stream/page read).\n  // Vercel expose le segment catch-all sous la clé \"...route\" (avec les 3 points), PAS \"route\".\n  // local-server.mjs, lui, injecte req.query.route. On lit donc les deux pour marcher des deux côtés.\n  let parts = req.query.route ?? req.query['...route']\n  if (typeof parts === 'string') parts = parts.split('/')\n  const name = Array.isArray(parts) ? parts[0] : parts\n  const target = name && routes[name]\n  if (!target) return res.status(404).json({ error: 'not-found', route: name || null })\n  if (!(await authOk(req, name))) return res.status(401).json({ error: 'unauthorized' })\n  return target(req, res)\n}\n  }\n  if (!verifySignedShareToken(token, secret)) throw shareFailure('invalid-share')\n  const loaded = await loadRecord(token)\n  const record = loaded && (loaded.record || loaded)\n  if (!record || record.v !== VERSION || record.tokenHash !== sha256(token) || !isShareTarget(record.kind, record.path)) throw shareFailure('invalid-share')\n  if (expectedKind && record.kind !== expectedKind) throw shareFailure('share-kind-mismatch')\n  if (record.revokedAt) throw shareFailure('share-revoked', 410)\n  const expires = Date.parse(record.expiresAt || '')\n  if (!Number.isFinite(expires) || expires <= now) throw shareFailure('share-expired', 410)\n  return { ...record, token, legacy: false }\n}\n\nexport async function authorizeShareAccess(token, requestedPath, options = {}) {\n  if (!token || !isCanonicalPagePath(requestedPath)) return false\n  try {\n    const share = await resolveShareToken(token, options)\n    return share.kind === 'folder'\n      ? requestedPath === share.path || requestedPath.startsWith(`${share.path}/`)\n      : requestedPath === share.path\n  } catch { return false }\n}\n\nconst bodyOf = (req) => {\n  if (req.body && typeof req.body === 'object') return req.body\n  try { return JSON.parse(req.body || '{}') } catch { return {} }\n}\n\nexport default async function handler(req, res) {\n  res.setHeader('Cache-Control', 'no-store')\n  const method = String(req.method || 'GET').toUpperCase()\n  const githubToken = process.env.GITHUB_TOKEN\n  const secret = secretFromEnv()\n  if (!githubToken || !secret) return res.status(503).json({ error: 'share-service-unavailable' })\n\n  try {\n    if (method === 'GET') {\n      const token = String((req.query && req.query.token) || '')\n      const expectedKind = String((req.query && req.query.kind) || '')\n      const share = await resolveShareToken(token, { expectedKind, secret })\n      return res.status(200).json({ kind: share.kind, path: share.path, expiresAt: share.expiresAt, legacy: share.legacy })\n    }\n    if (method !== 'POST') { res.setHeader('Allow', 'GET, POST'); return res.status(405).json({ error: 'method-not-allowed' }) }\n\n    const body = bodyOf(req)\n    if (body.action === 'revoke') {\n      const token = String(body.token || '')\n      if (!verifySignedShareToken(token, secret)) return res.status(400).json({ error: 'invalid-share' })\n      const loaded = await githubReadRecord(token, githubToken)\n      if (!loaded || !loaded.record) return res.status(404).json({ error: 'invalid-share' })\n      const revokedAt = new Date().toISOString()\n      await githubWriteRecord(token, { ...loaded.record, revokedAt }, loaded.sha, githubToken)\n      return res.status(200).json({ ok: true, revokedAt })\n    }\n\n    const kind = String(body.kind || '')\n    const path = String(body.path || '')\n    if (!isShareTarget(kind, path)) return res.status(400).json({ error: 'invalid-target' })\n    const requestedTtl = Number(body.expiresInSeconds)\n    const ttl = Number.isFinite(requestedTtl)\n      ? Math.min(MAX_TTL_SECONDS, Math.max(MIN_TTL_SECONDS, Math.round(requestedTtl)))\n      : DEFAULT_TTL_SECONDS\n    const token = createSignedShareToken(secret)\n    const createdAt = new Date().toISOString()\n    const expiresAt = new Date(Date.now() + ttl * 1000).toISOString()\n    const record = { v: VERSION, tokenHash: sha256(token), kind, path, createdAt, expiresAt, revokedAt: null }\n    await githubWriteRecord(token, record, '', githubToken)\n    return res.status(201).json({ token, kind, expiresAt })\n  } catch (error) {\n    const status = Number(error && error.status) || 500\n    return res.status(status).json({ error: (error && error.code) || 'share-service-error' })\n  }\n}\n// /api/shared-media — SERVER-SIDE DECRYPTION PROXY, public (no x-zr-auth), for encrypted images.\n//\n// WHY THIS FILE EXISTS (bug found 2026-07-01): /api/media-key is GATED (x-zr-auth required in prod).\n// Image sharing (/view) and shared-gallery thumbnails (/folder) used to decrypt CLIENT-SIDE,\n// starting with `fetch('/api/media-key')` — for an anonymous visitor (without the drive code) that\n// call returns 401 and the image stays white/broken. Verified in prod: `curl /api/media-key` -> 401.\n// Image sharing therefore NEVER actually worked for an external recipient.\n//\n// FIX: this endpoint decrypts SERVER-SIDE (the key never leaves the server, unlike /api/media-key\n// which sends it to the client in clear) and streams the DECRYPTED BYTES directly with the right\n// Content-Type. The client (or a WhatsApp/Notion crawler that cannot run JS) no longer needs to\n// know the key or do any crypto: a plain <img src=\"/api/shared-media?path=...&kind=thumb&share=...\"> is\n// enough. Also serves as the image source for Open Graph meta tags (server/share-og.js).\n//\n// SECURITY: la route HTTP reste publique (une balise img ne sait pas envoyer x-zr-auth), mais le handler\n// exige un jeton de partage valide pour cette image ou un dossier parent. Il n'expose jamais la clé, seulement\n// les octets déchiffrés d'une cible explicitement partagée.\nimport { loadMediaKey } from './media-key.js'\nimport { createDecipheriv } from 'node:crypto'\nimport { authorizeShareAccess } from './share-token.js'\n\nconst REPO = process.env.CONTENT_REPO || 'matthieuhuguet/zenray-data'\nconst BRANCH = process.env.CONTENT_BRANCH || 'main'\n\n// AES-GCM: same algo as client-side media/crypto.js (12-byte IV, 16-byte tag at the end of the ciphertext).\nfunction decryptAesGcm(cipherBuf, ivB64, keyB64) {\n  const key = Buffer.from(keyB64, 'base64')\n  const iv = Buffer.from(ivB64, 'base64')\n  const tag = cipherBuf.subarray(cipherBuf.length - 16)\n  const data = cipherBuf.subarray(0, cipherBuf.length - 16)\n  const decipher = createDecipheriv('aes-256-gcm', key, iv)\n  decipher.setAuthTag(tag)\n  return Buffer.concat([decipher.update(data), decipher.final()])\n}\n\nconst mimeForExt = (ext) => ({\n  jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp', gif: 'image/gif',\n  avif: 'image/avif', heic: 'image/heic', bmp: 'image/bmp', tif: 'image/tiff', tiff: 'image/tiff',\n}[ext] || 'application/octet-stream')\n\nexport default async function handler(req, res) {\n  if (req.method !== 'GET') { res.setHeader('Allow', 'GET'); return res.status(405).end() }\n  const token = process.env.GITHUB_TOKEN\n  const path = (req.query.path || '').toString()\n  const kind = (req.query.kind || 'full').toString() // 'thumb' | 'full'\n  const share = (req.query.share || '').toString()\n  if (!token || !path || !/\\.img\\.json$/.test(path)) return res.status(400).end('bad-request')\n  // Le proxy livre des octets DÉCHIFFRÉS : un path deviné ne suffit plus. Le jeton doit viser cette image\n  // exactement, ou un dossier parent explicitement partagé. Les anciens liens base64 restent vérifiés ici.\n  if (!(await authorizeShareAccess(share, path))) return res.status(403).end('invalid-share')\n  try {\n    const r = await fetch(`https://raw.githubusercontent.com/${REPO}/${BRANCH}/${encodeURI(path)}`, { headers: { Authorization: `Bearer ${token}`, 'User-Agent': 'zenray-progress' } })\n    if (!r.ok) return res.status(404).end('manifest-not-found')\n    const m = await r.json()\n    if (m.vis !== 'public' || !m.cdnRepo || !m.cdnCommit) return res.status(404).end('not-shareable')\n\n    // thumb: m.thumb is already the full jsDelivr URL of the encrypted .webp, never chunked.\n    // full: NEW schema (cdnChunks[], 2026-07-07) -> concatenate jsDelivr chunks in order before\n    // decrypting (bit-exact). OLD schema (cdnPath, never migrated) -> raw.github, UNCHANGED.\n    let iv = null\n    let cipherBuf = null\n    if (kind === 'thumb' && m.thumb && m.thumbIv) {\n      const cr = await fetch(m.thumb)\n      if (!cr.ok) return res.status(404).end('cdn-not-found')\n      cipherBuf = Buffer.from(await cr.arrayBuffer())\n      iv = m.thumbIv\n    } else if (Array.isArray(m.cdnChunks) && m.cdnChunks.length) {\n      iv = m.iv\n      const bufs = await Promise.all(m.cdnChunks.map((p) =>\n        fetch(`https://cdn.jsdelivr.net/gh/matthieuhuguet/${m.cdnRepo}@${m.cdnCommit}/${p}`).then((x) => (x.ok ? x.arrayBuffer() : Promise.reject(new Error('chunk ' + x.status))))))\n      cipherBuf = Buffer.concat(bufs.map((b) => Buffer.from(b)))\n    } else {\n      iv = m.iv\n      const cdnUrl = `https://raw.githubusercontent.com/matthieuhuguet/${m.cdnRepo}/${m.cdnCommit}/${m.cdnPath}`\n      const cr = await fetch(cdnUrl)\n      if (!cr.ok) return res.status(404).end('cdn-not-found')\n      cipherBuf = Buffer.from(await cr.arrayBuffer())\n    }\n    if (!cipherBuf || !iv) return res.status(404).end('no-thumb')\n\n    const key = loadMediaKey()\n    const plain = decryptAesGcm(cipherBuf, iv, key)\n\n    const ext = kind === 'thumb' ? 'webp' : (m.ext || 'jpg').toLowerCase()\n    res.setHeader('Content-Type', mimeForExt(ext))\n    // Hash-addressed content (immutable CDN path) -> long cache is safe.\n    res.setHeader('Cache-Control', 'public, max-age=604800, immutable')\n    return res.status(200).end(plain)\n  } catch (e) {\n    return res.status(500).end('decrypt-error: ' + String((e && e.message) || e).slice(0, 120))\n  }\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f760f-3707-7e32-9422-c315b4778481"}}}
