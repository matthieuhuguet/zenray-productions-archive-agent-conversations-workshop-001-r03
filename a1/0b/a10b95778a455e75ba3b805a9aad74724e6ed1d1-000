es pour énumérer les .file.json sans dépendre de l'arbre git récursif qui tronque.\nexport function getIndexPaths() { return (mem && Array.isArray(mem.paths)) ? mem.paths : [] }\n// Vignette d'image depuis l'index (URL/objet {u,iv}) — sert d'aperçu direct sans réassembler l'original.\nexport function getNodeThumb(path) { const t = mem && mem.thumbs; return (t && t[path]) || null }\n\n// Méta de l'index chargé (pour l'indicateur bas de Create, à la place du quota API). builtAt = jeton combiné\n// \"shards|delta\" -> on n'en montre que la partie shards (date du dernier rebuild complet). source = CDN si on a\n// chargé depuis le repo public chiffré, sinon null.\nexport function getIndexMeta() {\n  if (!mem || !mem.paths) return null\n  const at = typeof mem.builtAt === 'string' ? mem.builtAt.split('|')[0] : null\n  return { count: mem.paths.length, builtAt: at || null, source: 'CDN' }\n}\n\n// SCORING T6 : préfixe > nom > segment de chemin > contenu/sous-chaîne.\n// CONTRAT DE NORMALISATION (verrouillé, search-3) : nq, normPath et normName DOIVENT avoir été\n  const [localCtReady, setLocalCtReady] = useState(false)\n  useEffect(() => { loadLocalContent().then(() => setLocalCtReady(true)).catch(() => {}) }, [])\n  // COMPTEUR D'ÉLÉMENTS (bas-droite) : total de nœuds dans Create + ventilation par type, calculé une fois\n  // depuis l'index complet (idx.paths, chaque chemin porte son extension de type). Toggle pour le détail.\n  const [nodeCounts, setNodeCounts] = useState(null)\n  const [idxMeta, setIdxMeta] = useState(null) // méta de l'index chargé (CDN chiffré) -> pied de l'indicateur\n  const [completeIndexPaths, setCompleteIndexPaths] = useState(null)\n  const [countsOpen, setCountsOpen] = useState(false)\n  const [namePrompt, setNamePrompt] = useState(null) // widget liquid glass de saisie de nom (remplace window.prompt)\n  useEffect(() => {\n    let alive = true\n    loadSearchIndex().then((idx) => {\n      if (!alive || !idx || !Array.isArray(idx.paths)) return\n      setCompleteIndexPaths(idx.paths)\n      const c = { total: 0, images: 0, videos: 0, tables: 0, markdown: 0, autres: 0 }\n      for (const p of idx.paths) {\n        c.total++\n        if (p.endsWith('.img.json')) c.images++\n        else if (p.endsWith('.media.json')) c.videos++\n        else if (p.endsWith('.db.json')) c.tables++\n        else if (p.endsWith('.md') || !p.includes('.')) c.markdown++\n        else c.autres++\n      }\n      setNodeCounts(c)\n      setIdxMeta(getIndexMeta())\n    }).catch(() => {})\n  }, [searchIndexReady])\n  // `action=tree` est frais mais peut être tronqué par GitHub ; l'index CDN est\n  // exhaustif mais peut avoir quelques secondes de retard. Leur union est la seule\n  // source autorisée pour les fonctions globales (sous-pages, dossiers non vides,\n  // relations et navigation). Le listing visible reste piloté par action=children.\n  const allPaths = useMemo(() => completeIndexPaths\n    ? [...new Set([...(paths || []), ...completeIndexPaths])]\n    : (paths || []), [paths, completeIndexPaths])\n  // Requête débouncée : pilote le filtre LOURD. L'input reste contrôlé par `q` (instantané, jamais de lag).\n  // On découple la frappe du recalcul : taper ne fait que mettre à jour `q` (léger) ; le gros travail attend 140 ms de stabilité.\n  const [qDebounced, setQDebounced] = useState('')\n  useEffect(() => { const h = setTimeout(() => setQDebounced(q.trim()), 140); return () => clearTimeout(h) }, [q])\n  // Normalisation recherche : minuscules, sans accents, tirets/underscores/points/slashs -> espaces. Ainsi \"30 mai 2026\"\n  // matche le fichier \"30-mai-2026-lwia.md\" (avant : échec car espaces vs tirets). On matche aussi le titre éditable (_labelCache).\n  const norm = (s) => (s || '').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/[-_./]+/g, ' ').replace(/\\s+/g, ' ').trim()\n  // T6 RECHERCHE : index complet chargé UNE fois (cache IndexedDB), scoré EN LOCAL à chaque frappe.\n  // Plus aucun alle