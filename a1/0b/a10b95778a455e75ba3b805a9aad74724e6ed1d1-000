\n//   epub-lib (epub)  -> epubjs -> rendition paginée\n//   image-lib(heic/tiff) -> heic2any / UTIF -> <img>/<canvas>\n//   3d-lib (glb/obj/stl/fbx) -> three.js -> viewer WebGL orbitable\nimport React, { useEffect, useRef, useState } from 'react'\nimport { extOf } from '../lib/fileKinds.js'\n\nconst Box = ({ children }) => <div style={{ width: 'min(900px,92vw)', maxHeight: '82vh', overflow: 'auto', background: '#fff', color: '#1d1d1f', borderRadius: 14, padding: '26px 30px', boxShadow: '0 20px 60px rgba(0,0,0,0.4)' }}>{children}</div>\nconst Msg = ({ children }) => <div style={{ color: '#fff', opacity: 0.75, textAlign: 'center', lineHeight: 1.6, fontSize: 14 }}>{children}</div>\n\nexport default function LibFilePreview({ url, name, kind }) {\n  const [state, setState] = useState({ loading: true })\n  const mountRef = useRef(null)\n\n  useEffect(() => {\n    let live = true, cleanup = null\n    ;(async () => {\n      try {\n        const ext = extOf(name)\n        // ---- DOCX -> HTML (mammoth) ----\n        if (kind === 'doc-lib' && (ext === 'docx')) {\n          const mammoth = (await import('mammoth')).default || (await import('mammoth'))\n          const buf = await (await fetch(url)).arrayBuffer()\n          const { value } = await mammoth.convertToHtml({ arrayBuffer: buf })\n          if (live) setState({ html: value })\n          return\n        }\n        // ---- XLSX/XLS -> tables HTML (SheetJS) ----\n        if (kind === 'sheet-lib') {\n          const XLSX = await import('xlsx')\n          const buf = await (await fetch(url)).arrayBuffer()\n          const wb = XLSX.read(buf, { type: 'array' })\n          const sheets = wb.SheetNames.map((n) => ({ n, html: XLSX.utils.sheet_to_html(wb.Sheets[n]) }))\n          if (live) setState({ sheets })\n          return\n        }\n        // ---- HEIC/HEIF -> JPEG (heic2any) ; TIFF -> canvas (UTIF) ----\n        if (kind === 'image-lib') {\n          if (ext === 'heic' || ext === 'heif') {\n            const heic2any