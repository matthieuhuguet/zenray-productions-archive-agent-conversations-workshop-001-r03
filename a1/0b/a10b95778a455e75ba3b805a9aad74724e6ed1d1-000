de le cache SWR du dossier de destination.\n// @param ctx.loadDir        recharge le dossier de destination depuis le serveur.\n// @param ctx.onImported(okList, failList)  appelé après le refresh optimiste — l'appelant y construit sa\n//   propre notify() (icône/tint/libellé diffèrent par type de lien).\nexport function useLinkImportModal(createBatchFn, ctx = {}) {\n  const { folder, pathsRef, setPaths, dropDirCache, loadDir, onImported } = ctx\n  const [open, setOpen] = useState(false)\n  const [text, setText] = useState('')\n  const [busy, setBusy] = useState(false)\n  const [progress, setProgress] = useState(0)\n\n  const submit = async () => {\n    const value = text.trim()\n    if (!value || busy) return\n    setBusy(true); setProgress(0)\n    try {\n      const results = await createBatchFn(value, folder, setProgress)\n      const okList = results.filter((r) => r.ok)\n      const failList = results.filter((r) => !r.ok)\n      setOpen(false); setText('')\n      if (okList.length) {\n        const newPaths = okList.map((r) => r.nodePath)\n        const merged = Array.from(new Set([...(pathsRef.current || []), ...newPaths]))\n        pathsRef.current = merged\n        setPaths(merged)\n        dropDirCache(folder)\n        loadDir(folder)\n      }\n      if (onImported) onImported(okList, failList)\n    } finally { setBusy(false); setProgress(0) }\n  }\n\n  return { open, setOpen, text, setText, busy, progress, submit }\n}\nimport { createPortal } from 'react-dom'\nimport { SHADOWS } from '../theme.js'\nimport Icon from '../components/Icon.jsx'\n\n// Rendu partagé des modales « colle un lien par ligne » (Liens YouTube, Liens audio YouTube, Liens Google\n// Maps). AVANT cette extraction, App.jsx rendait 3 blocs JSX quasi identiques (même overlay, même carte,\n// même textarea, mêmes boutons Annuler/Ajouter avec le même badge de progression) — seuls l'icône/couleur/\n// texte d'intro/placeholder changeaient. `modal` vient de useLinkImportModal (état + submit) ; ce composant\n// ne fait QUE le rendu, câblé sur cet état.\nexport default function LinkImportModal({ modal, icon, color = '#d97757', label, body, placeholder, t, fonts }) {\n  const { open, setOpen, text, setText, busy, progress, submit } = modal\n  if (!open) return null\n  return createPortal(\n    <div onClick={() => !busy && setOpen(false)} style={{ position: 'fixed', inset: 0, zIndex: 9999, background: 'rgba(0,0,0,0.45)', display: 'grid', placeItems: 'center', padding: 16 }}>\n      <div onClick={(e) => e.stopPropagation()} style={{ width: 520, maxWidth: '92vw', background: t.cardBg, border: `1px solid ${t.border}`, borderRadius: 16, padding: 20, boxShadow: SHADOWS.lg }}>\n        <div style={{ fontFamily: fonts.sans, fontSize: 16, fontWeight: 700, color: t.textPrimary, marginBottom: 6, display: 'flex', alignItems: 'center', gap: 8 }}>\n          <Icon name={icon} size={17} color={color} />{label}\n        </div>\n        <div style={{ fontFamily: fonts.sans, fontSize: 12.5, color: t.textSecondary, marginBottom: 12, lineHeight: 1.5 }}>{body}</div>\n        <textarea value={text} onChange={(e) => setText(e.target.value)} rows={6} autoFocus disabled={busy}\n          placeholder={placeholder}\n          style={{ width: '100%', boxSizing: 'border-box', fontFamily: fonts.mono, fontSize: 12.5, color: t.textPrimary, background: 'transparent', border: `1.5px solid ${t.textPrimary}`, borderRadius: 10, padding: 10, outline: 'none', resize: 'vertical' }} />\n        <div style={{ display: 'flex', justifyContent: 'flex-end', gap: 8, marginTop: 14 }}>\n          <button onClick={() => setOpen(false)} disabled={busy} style={{ background: 'transparent', color: t.textPrimary, border: `1.5px solid ${t.textPrimary}`, borderRadius: 8, padding: '7px 16px', cursor: 'pointer', fontSize: 13, fontWeight: 600 }}>Annuler</button>\n          <button onClick={submit} disabled={busy || !text.trim()} style={{ background: t.textPrimary, color: t.cardBg, border: 'none', borderRadius: 8, padding: '7px 16px', cursor: 'pointer', fontSize: 13, fontWeight: 600, opacity: (busy || !text.trim()) ? 0.4 : 1 }}>\n            {busy ? `${Math.round(progress * 100)}%` : 'Ajouter'}\n          </button>\n        </div>\n      </div>\n    </div>, document.body\n  )\n}\n// Classe une URL pour l'insertion (mode Embed). Réutilise l'allowlist YouTube STRICTE de la feature Ref.\n// Jamais d'iframe arbitraire : seuls image directe + YouTube sont reconnus, le reste retombe sur Bookmark.\nimport { parseYouTube } from '../../ref/embed.js'\n\nexport function sanitizeUrl(raw) {\n  if (typeof raw !== 'string') return null\n  const s = raw.trim()\n  try { const u = new URL(s); return /^https?:$/.test(u.protocol) ? u.href : null } catch { return null }\n}\n\nexport function isImageUrl(u) {\n  return /\\.(png|jpe?g|gif|webp|avif|svg)(\\?|#|$)/i.test(u || '')\n}\n\n// Renvoie { kind:'image' } | { kind:'youtube', providerId, embedUrl, start } | { kind:'unknown' }\nexport function classifyUrl(url) {\n  if (isImageUrl(url)) return { kind: 'image' }\n  const yt = parseYouTube(url)\n  if (yt) {\n    const base = `https://www.youtube-nocookie.com/embed/${yt.providerId}`\n    return { kind: 'youtube', providerId: yt.providerId, start: yt.start || 0, embedUrl: yt.start ? `${base}?start=${yt.start}` : base }\n  }\n  return { kind: 'unknown' }\n}\n// C46 — déplie une URL (OpenGraph) pour les bookmarks. GET ?url=... -> { title, description, image, favicon, url }.\n// Sécurité SSRF : on bloque les hôtes privés/loopback/métadonnées cloud, ET on suit les redirections\n// À LA MAIN en revalidant chaque saut (un hôte public peut sinon rediriger vers une IP interne).\nconst PRIVATE = /^(localhost|.*\\.(internal|local|localhost)|127\\.|10\\.|192\\.168\\.|172\\.(1[6-9]|2\\d|3[01])\\.|0\\.|169\\.254\\.|\\[?::1\\]?|\\[?::ffff:)/i\n\n// Suit jusqu'à 5 redirections, en refusant tout saut vers un hôte privé. Renvoie {res, finalUrl} ou null.\nasync function safeFetch(startUrl, headers) {\n  let cur = startUrl\n  for (let i = 0; i < 5; i++) {\n    let u; try { u = new URL(cur) } catch { return null }\n    if (!/^https?:$/.test(u.protocol) || PRIVATE.test(u.hostname)) return null\n    const ctrl = new AbortController(); const to = setTimeout(() => ctrl.abort(), 5000)\n    const r = await fetch(cur, { signal: ctrl.signal, redirect: 'manual', headers }).catch(() => null)\n    clearTimeout(to)\n    if (!r) return null\n    if (r.status >= 300 && r.status < 400 && r.headers.get('location')) {\n      try { cur = new URL(r.headers.get('location'), cur).href } catch { return null }\n      continue\n    }\n    return { res: r, finalUrl: cur }\n  }\n  return null\n}\n\nconst pick = (html, res) => { const re = res.find((r) => r.test(html)); const m = re && html.match(re); return m && m[1] ? m[1].trim() : null }\nfunction metaContent(html, keys) {\n  for (const k of keys) {\n    let m = html.match(new RegExp(`<meta[^>]+(?:property|name)=[\"']${k}[\"'][^>]*content=[\"']([^\"']*)[\"']`, 'i'))\n    if (!m) m = html.match(new RegExp(`<meta[^>]+content=[\"']([^\"']*)[\"'][^>]*(?:property|name)=[\"']${k}[\"']`, 'i'))\n    if (m && m[1].trim()) return m[1].trim()\n  }\n  return null\n}\n\nexport default async function handler(req, res) {\n  const url = (req.query.url || '').toString()\n  try {\n    const u = new URL(url)\n    if (!/^https?:$/.test(u.protocol) || PRIVATE.test(u.hostname)) return res.status(400).json({ error: 'bad-url' })\n    const fetched = await safeFetch(url, { 'User-Agent': 'Mozilla/5.0 ZenRayBot', Accept: 'text/html' })\n    const r = fetched && fetched.res\n    if (!r || !r.ok) return res.status(200).json({ url, title: u.hostname, error: 'fetch' })\n    const html = (await r.text()).slice(0, 200000)\n    const title = metaContent(html, ['og:title', 'twitter:title']) || pick(html, [/<title[^>]*>([^<]+)<\\/title>/i]) || u.hostname\n    const description = metaContent(html, ['og:description', 'twitter:description', 'description'])\n    const abs = (v) => { if (!v) return v; try { return new URL(v, u.origin).href } catch { return v } }\n    let image = abs(metaContent(html, ['og:image', 'twitter:image', 'og:image:url']))\n    let favicon = pick(html, [/<link[^>]+rel=[\"'][^\"']*icon[^\"']*[\"'][^>]*href=[\"']([^\"']+)[\"']/i])\n    favicon = favicon ? abs(favicon) : u.origin + '/favicon.ico'\n    const siteName = metaContent(html, ['og:site_name']) || u.hostname.replace(/^www\\./, '')\n    res.setHeader('Cache-Control', 'public, s-maxage=86400')\n    // finalUrl (2026-07-04) : l'URL RÉELLE après redirections (safeFetch les suit déjà à la main). Utile pour\n    // résoudre des liens raccourcis (ex. maps.app.goo.gl) vers leur URL canonique exploitable côté client\n    // (extraction de coordonnées/nom de lieu pour l'intégration Google Maps).\n    return res.status(200).json({ url, finalUrl: fetched.finalUrl, title, description, image, favicon, siteName, hostname: u.hostname.replace(/^www\\./, '') })\n  } catch {\n    return res.status(400).json({ error: 'bad-url' })\n  }\n}\n// A2 — Viewer d'un nœud .file.json (archive universelle « zenray-productions-archive »).\n// Le manifeste décrit UN fichier archivé sur un shard GitHub PUBLIC :\n//   { type:'file', name, size, mime, sha256, mode:'raw'|'chunked', repo, commit, path | chunks[], chunkSize }\n// - mode raw     : le fichier est tel quel sur le repo -> aperçu direct (img/audio/vidéo/texte) + download direct.\n// - mode chunked : >95 Mo, découpé en chunks de 19 Mo -> download = re-concaténation streaming côté client,\n//   identique bit à bit (le sha256 du manifeste est la preuve d'intégrité affichée).\n// UI : carte liquid glass tinted (langage du projet), texte regular/medium uniquement (jamais de gras).\nimport React, { useEffect, useState } from 'react'\nimport { PALETTE, RADII, SHADOWS } from '../theme.js'\nimport Icon from './Icon.jsx'\nimport { chunkCount, downloadUrls } from '../lib/archiveChunks.js'\nimport { streamDownload } from '../lib/fetchAsset.js'\n\nconst FONTS = { sans: \"'AnthropicSans', sans-serif\", mono: \"'AnthropicMono', ui-monospace, monospace\" }\nconst fmtSize = (n) => n >= 1e9 ? `${(n / 1e9).toFixed(2)} Go` : n >= 1e6 ? `${(n / 1e6).toFixed(1)} Mo` : `${Math.max(1, Math.round(n / 1024))} Ko`\n\n// Téléchargement : résolution des URLs via archiveChunks.js (source unique, v2/v3/v4 multi-shards), puis\n// download STREAMÉ via fetchAsset.js (écrit sur disque chunk par chunk quand l'API le permet -> zéro pic RAM\n// sur mobile/gros fichiers ; repli Blob borné sinon). Identique bit à bit, le sha256 du manifeste fait foi.\nasync function downloadFile(m, onProgress) {\n  await streamDownload({ urls: downloadUrls(m), name: m.name, mime: m.mime || 'application/octet-stream', onProgress })\n}\n\nexport default function FileNodeViewer({ t, path, title }) {\n  const [m, setM] = useState(null)\n  const [err, setErr] = useState(null)\n  const [dlProg, setDlProg] = useState(null) // null = repos ; 0..1 = en cours\n  const [text, setText] = useState(null)     // aperçu texte (petits fichiers text/*)\n  const [verSel, setVerSel] = useState(null) // index de version choisie (null = dernière). Versionning archive.\n  useEffect(() => {\n    let live = true\n    fetch(`/api/page?action=read&path=${encodeURIComponent(path)}`, { cache: 'no-store' })\n      .then((r) => r.json())\n      .then((j) => { if (!live) return; if (j && j.markdown) { try { setM(JSON.parse(j.markdown)) } catch { setErr('manifeste illisible') } } else setErr('introuvable') })\n      .catch(() => live && setErr('réseau'))\n    return () => { live = false }\n  }, [path])\n  useEffect(() => {\n    if (!m || m.mode !== 'raw' || !(m.mime || '').startsWith('text/') || m.size > 2 * 1024 * 1024) return\n    let live = true\n    fetch(rawUrl(m, m.path)).then((r) => r.text()).then((s) => live && setText(s)).catch(() => {})\n    return () => { live = false }\n  }, [m])\n\n  const dark = t.textPrimary === PALETTE.textPrimaryDark\n  const g = t.glass || {}\n  const card = { maxWidth: 860, margin: '0 auto', padding: 22, borderRadius: 18, fontFamily: FONTS.sans, fontWeight: 400, color: t.textPrimary,\n    background: `linear-gradient(150deg, ${PALETTE.primary}14, ${PALETTE.primary}07 65%), ${g.bgStrong || 'rgba(253,253,252,.84)'}`,\n    backdropFilter: g.filterThick || 'blur(44px) saturate(210%)', WebkitBackdropFilter: g.filterThick || 'blur(44px) saturate(210%)',\n    boxShadow: `inset 1.5px 1.5px 1px rgba(255,255,255,${dark ? 0.18 : 0.58}), inset 0 0 0 0.5px rgba(255,255,255,${dark ? 0.1 : 0.4}), 0 22px 60px -24px rgba(20,30,70,.45)` }\n\n  if (err) return <div style={{ ...card, color: PALETTE.red }}>Fichier d'archive : {err}</div>\n  if (!m) return <div style={{ ...card, color: t.textSecondary }}>chargement du manifeste…</div>\n\n  const mime = m.mime || ''\n  // VERSIONNING : si le manifeste porte versions[], on construit le manifeste EFFECTIF depuis la version choisie\n  // (dernière par défaut). Tout (aperçu/téléchargement/provenance) s'appuie sur `eff`, jamais sur la brute.\n  const versions = (Array.isArray(m.versions) && m.versions.length) ? m.versions : null\n  const vi = versions ? ((verSel != null && verSel >= 0 && verSel < versions.length) ? verSel : versions.length - 1) : null\n  const vv = versions ? versions[vi] : null\n  const eff = vv ? { ...m, repo: vv.repo, commit: vv.commit, chunks: vv.chunks, parts: vv.parts, size: vv.size, sha256: vv.sha256, chunkSize: vv.chunkSize || m.chunkSize, mode: 'chunked' } : m\n  const direct = eff.mode === 'raw' ? rawUrl(eff, eff.path) : null\n  const fmtDate = (s) => { try { return new Date(s).toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: '2-digit', hour: '2-digit', minute: '2-digit' }) } catch { return s } }\n  return (\n    <div style={card}>\n      {/* en-tête : icône type + nom + méta */}\n      <div style={{ display: 'flex', alignItems: 'center', gap: 12, marginBottom: 16 }}>\n        <span style={{ display: 'inline-flex', width: 38, height: 38, borderRadius: 11, alignItems: 'center', justifyContent: 'center', background: PALETTE.primarySoft, color: PALETTE.primary }}>\n          <Icon name={mime.startsWith('image/') ? 'photo' : mime.startsWith('video/') ? 'film' : mime.startsWith('audio/') ? 'music.note' : 'doc'} size={19} weight={1.5} />\n        </span>\n        <div style={{ minWidth: 0 }}>\n          <div style={{ fontSize: 16, fontWeight: 500, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{m.name || title}</div>\n          <div style={{ fontSize: 12.5, color: t.textSecondary, fontFamily: FONTS.mono }}>{fmtSize(eff.size)} · {mime}{eff.mode === 'chunked' ? ` · ${chunkCount(eff)} morceaux` : ''}{versions ? ` · v${vi + 1}/${versions.length}` : ''}</div>\n        </div>\n        <button onClick={() => { setDlProg(0); downloadFile(eff, setDlProg).then(() => setDlProg(null)).catch(() => setDlProg(null)) }}\n          disabled={dlProg !== null && dlProg < 1}\n          style={{ marginLeft: 'auto', display: 'inline-flex', alignItems: 'center', gap: 7, padding: '9px 18px', borderRadius: 11, border: 'none', cursor: 'pointer', background: PALETTE.primary, color: '#fff', fontFamily: FONTS.sans, fontSize: 13.5, fontWeight: 500, boxShadow: `0 6px 16px -4px ${PALETTE.primary}99` }}>\n          <Icon name=\"arrow.down.right\" size={14} color=\"#fff\" weight={1.8} />\n          {dlProg !== null && dlProg < 1 ? `Téléchargement ${Math.round(dlProg * 100)}%` : 'Télécharger'}\n        </button>\n      </div>\n\n      {/* SÉLECTEUR DE VERSION (archive versionnée) : choisir une version antérieure -> aperçu/téléchargement de CELLE-ci. */}\n      {versions && versions.length > 1 && (\n        <div style={{ display: 'flex', alignItems: 'center', gap: 8, flexWrap: 'wrap', marginBottom: 14, padding: '10px 12px', borderRadius: 12, background: dark ? 'rgba(255,255,255,.05)' : 'rgba(255,255,255,.5)' }}>\n          <span style={{ fontSize: 12, color: t.textSecondary, fontFamily: FONTS.sans }}>Versions :</span>\n          {versions.map((v, i) => {\n            const on = i === vi\n            return (\n              <button key={i} onClick={() => setVerSel(i)} className=\"zr-tap\"\n                style={{ display: 'inline-flex', alignItems: 'center', gap: 5, padding: '4px 10px', borderRadius: 8, border: 'none', cursor: 'pointer', fontFamily: FONTS.sans, fontSize: 12,\n                  background: on ? PALETTE.primary : (dark ? 'rgba(255,255,255,.08)' : 'rgba(0,0,0,.05)'), color: on ? '#fff' : t.textPrimary }}>\n                v{i + 1}{i === versions.length - 1 ? ' (actuelle)' : ''} · {v.ts ? fmtDate(v.ts) : '—'} · {fmtSize(v.size)}\n              </button>\n            )\n          })}\n        </div>\n      )}\n\n      {/* aperçu selon le type (raw uniquement : un chunked n'est pas consultable en flux, seulement re-téléchargeable) */}\n      {direct && mime.startsWith('image/') && <img src={direct} alt={m.name} style={{ maxWidth: '100%', borderRadius: 12, display: 'block', margin: '0 auto' }} />}\n      {direct && mime.startsWith('video/') && <video src={direct} controls playsInline style={{ width: '100%', borderRadius: 12, background: '#1C1C1E' }} />}\n      {direct && mime.startsWith('audio/') && <audio src={direct} controls style={{ width: '100%' }} />}\n      {direct && text != null && <pre style={{ maxHeight: 480, overflow: 'auto', padding: 14, borderRadius: 12, background: dark ? 'rgba(255,255,255,.05)' : 'rgba(255,255,255,.55)', fontFamily: FONTS.mono, fontSize: 12, lineHeight: 1.5, whiteSpace: 'pre-wrap' }}>{text}</pre>}\n      {eff.mode === 'chunked' && (\n        <div style={{ padding: '14px 16px', borderRadius: 12, background: dark ? 'rgba(255,255,255,.05)' : 'rgba(255,255,255,.5)', fontSize: 13, color: t.textSecondary }}>\n          Fichier découpé en {chunkCount(eff)} morceaux de 19 Mo. « Télécharger » le reconstitue à l'identique\n          (intégrité : sha256 <span style={{ fontFamily: FONTS.mono, fontSize: 11 }}>{(eff.sha256 || '').slice(0, 16)}…</span>).\n        </div>\n      )}\n\n      {/* méta basse : provenance (de la version choisie) */}\n      <div style={{ display: 'flex', alignItems: 'center', gap: 6, marginTop: 14, paddingTop: 12, borderTop: `1px solid ${PALETTE.primary}1f`, fontSize: 11.5, color: t.textSecondary, fontFamily: FONTS.mono }}>\n        <span style={{ width: 6, height: 6, borderRadius: '50%', background: '#34c759' }} />\n        GitHub · {eff.repo} @ {(eff.commit || '').slice(0, 7)}\n      </div>\n    </div>\n  )\n}\n// LibFilePreview — aperçu des formats qui exigent un décodeur JS (chargé en IMPORT DYNAMIQUE = code-split, donc\n// AUCUN po…40030 tokens truncated…ranscripts.md:47738:I'll start by reading PROGRESS.md as required, then dig into the image pipeline.\ndocs/AUDIT-2026-06-06-transcripts.md:47741:- 06-01 04:10 LOT CODE livré (commit local 0b903a2) : fix master.m3u8 vide pour vidéos wasm, seuil navigateur 1 Go, toggle upload navigateur/terminal.\ndocs/AUDIT-2026-06-06-transcripts.md:47747:Ma tâche actuelle = LOT IMAGES (perf Eagle). Lecture des fichiers existants.\ndocs/AUDIT-2026-06-06-transcripts.md:47751:I now have a clear picture. The plan: build reusable modules under `src/media/`, then improve `Gallery.jsx` and `ImageNodeViewer.jsx` to use them, without touching `App.jsx`.\ndocs/AUDIT-2026-06-06-transcripts.md:47755:Now the prioritized prefetch queue (bounded concurrency, first-image priority) and an IntersectionObserver-based hook.\ndocs/AUDIT-2026-06-06-transcripts.md:47757:Now the React hooks: a robust shared IntersectionObserver and a `useThumb` hook that drives instant thumbnails from cache + lazy decode.\ndocs/AUDIT-2026-06-06-transcripts.md:47759:Now a reusable `<SmartThumb>` component that ties it together (blur-up via background, instant cache hit, fade-in) plus full-image prefetch on hover/space.\ndocs/AUDIT-2026-06-06-transcripts.md:47770:Maintenant Lot A. Je lis les fichiers concernés.\ndocs/AUDIT-2026-06-06-transcripts.md:47780:Now `WEB_NATIVE_VIDEO` and `TRANSCODE_OVER_BYTES` are unuse