{"timestamp":"2026-07-18T21:44:57.902Z","ordinal":968,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019f7730-8b2e-7750-8d04-cc1f2bb4e70f","call_id":"call_jfz91ILueuPhMJcIKz3uCCja","output":[{"type":"input_text","text":"Script completed\nWall time 3.3 seconds\nOutput:\n"},{"type":"input_text","text":"// Localhost-with-token : sert le build dist/ + route /api/* vers les handlers Vercel-style, avec le token\n// GITHUB_TOKEN en env. Permet de voir l'app RÉELLE (drive GitHub) en local. Lecture/écriture sur le vrai drive.\n// Usage : GITHUB_TOKEN=$(gh auth token) node scripts/local-server.mjs [port]\nimport http from 'node:http'\nimport { readFile, stat, mkdir, rm } from 'node:fs/promises'\nimport { createWriteStream, createReadStream, readFileSync, existsSync } from 'node:fs'\nimport { spawn } from 'node:child_process'\nimport { randomUUID } from 'node:crypto'\nimport path from 'node:path'\nimport { fileURLToPath } from 'node:url'\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')\n\n// SECRETS LOCAUX : on charge .env.local (gitignored) pour les variables NON déjà fournies par le shell. Pratique\n// pour poser ZENRAY_API_SECRET (mot de passe du gate /api) et ZENRAY_MEDIA_KEY (clé de déchiffrement) une fois,\n// hors historique de terminal. On N'ÉCRASE JAMAIS une variable déjà présente dans l'env (le shell reste prioritaire).\ntry {\n  const envFile = path.join(ROOT, '.env.local')\n  if (existsSync(envFile)) {\n    for (const line of readFileSync(envFile, 'utf8').split('\\n')) {\n      const m = line.match(/^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*=\\s*(.*)\\s*$/)\n      if (m && process.env[m[1]] === undefined) process.env[m[1]] = m[2].replace(/^[\"']|[\"']$/g, '')\n    }\n  }\n} catch {}\nconst DIST = path.join(ROOT, 'dist')\nconst PORT = parseInt(process.argv[2] || '3000', 10)\nconst MIME = { '.html': 'text/html', '.js': 'text/javascript', '.css': 'text/css', '.json': 'application/json', '.svg': 'image/svg+xml', '.png': 'image/png', '.webp': 'image/webp', '.avif': 'image/avif', '.woff2': 'font/woff2', '.ico': 'image/x-icon' }\n\nconst adaptRes = (res) => {\n  res.status = (c) => { res.statusCode = c; return res }\n  res.json = (o) => { res.setHeader('content-type', 'application/json'); res.end(JSON.stringify(o)); return res }\n  res.send = (d) => { res.end(d); return res }\n  return res\n}\n\n// ─── TRANSCODAGE VIDÉO NATIF (Phase 3) ────────────────────────────────────────────────────────────────\n// Drag-drop d'une vidéo dans l'app -> le navigateur STREAME les octets ici -> on écrit dans /tmp -> on spawn\n// le ffmpeg NATIF (rapide, Phase 2) via scripts/video-hls.mjs --push --emit-progress -> progression LIVE\n// poussée au navigateur en SSE. Plus de Terminal, plus de ffmpeg.wasm. UN seul ffmpeg à la fois (file série,\n// le GPU/CPU sature sinon). Le token vient de l'env du serveur (déjà présent), pas d'un sous-shell `gh`.\nconst jobs = new Map() // jobId -> { jobId, name, dest, srcPath, status, progress, stage, error, nodePath, listeners:Set }\nconst snapshot = (j) => ({ jobId: j.jobId, status: j.status, progress: j.progress, stage: j.stage, name: j.name, error: j.error || null, nodePath: j.nodePath || null })\nconst sseSend = (res, obj) => { try { res.write(`data: ${JSON.stringify(obj)}\\n\\n`) } catch {} }\nconst update = (job, patch) => { Object.assign(job, patch); for (const r of job.listeners) sseSend(r, snapshot(job)) }\nconst queue = []\nlet running = false\nconst pump = () => {\n  if (running) return\n  const job = queue.shift(); if (!job) return\n  running = true\n  runJob(job).catch(() => {}).finally(() => { running = false; pump() })\n}\nasync function runJob(job) {\n  update(job, { status: 'running', stage: 'transcodage', progress: 1 })\n  const proc = spawn('node', [path.join(ROOT, 'scripts/video-hls.mjs'), job.srcPath, '--push', '--dest', job.dest, '--api', `http://localhost:${PORT}`, '--emit-progress'], { cwd: ROOT, env: process.env })\n  let buf = ''\n  const onLine = (line) => {\n    let m = line.match(/^@@P (\\d+) (\\S+)/); if (m) { update(job, { progress: Number(m[1]), stage: m[2] }); return }\n    m = line.match(/^@@DONE (.+)/); if (m) { job.nodePath = m[1].trim(); return }\n    if (/^échec |Error|fatal/.test(line)) job.error = line.slice(0, 200)\n  }\n  proc.stdout.on('data', (d) => { buf += d; let i; while ((i = buf.indexOf('\\n')) >= 0) { onLine(buf.slice(0, i)); buf = buf.slice(i + 1) } })\n  proc.stderr.on('data', (d) => { const s = String(d); if (/Error|fatal|échec/.test(s)) job.error = s.slice(0, 200) })\n  const ok = await new Promise((resolve) => proc.on('close', (code) => {\n    if (job.nodePath) { update(job, { status: 'done', progress: 100, stage: 'terminé' }); resolve(true) }\n    else { update(job, { status: 'error', error: job.error || `ffmpeg code ${code}` }); resolve(false) }\n    for (const r of job.listeners) { try { r.end() } catch {} }\n  }))\n  // On ne supprime la source uploadee QUE sur SUCCES. Sur echec, on la CONSERVE pour permettre un retry sans\n  // re-uploader (et on log le chemin). Sinon un echec reseau effacait le fichier -> il fallait tout re-glisser.\n  if (ok) { try { await rm(path.dirname(job.srcPath), { recursive: true, force: true }) } catch {} }\n  else { job.srcKept = job.srcPath; console.error(`[transcode echoue] source conservee: ${job.srcPath} (job ${job.jobId})`) }\n  setTimeout(() => jobs.delete(job.jobId), 600000) // purge la trace après 10 min\n}\n\nconst server = http.createServer(async (req, res) => {\n  adaptRes(res)\n  const url = new URL(req.url, `http://localhost:${PORT}`)\n\n  // POST /api/transcode-local?dest=&name= : reçoit le fichier vidéo brut (stream), lance le job, renvoie {jobId}.\n  if (url.pathname === '/api/transcode-local' && req.method === 'POST') {\n    try {\n      const jobId = randomUUID().slice(0, 8)\n      const name = (url.searchParams.get('name') || 'video.mp4').replace(/[/\\\\]/g, '_')\n      // dest BORNÉ sous pages/ (pas de .. ni d'absolu) : l'endpoint spawn ffmpeg + pousse sur le drive, donc une\n      // dest arbitraire serait une injection de chemin. Defaut pages/Videos.\n      let dest = (url.searchParams.get('dest') || 'pages/Videos').replace(/\\/+$/, '')\n      if (!/^pages\\//.test(dest) || dest.includes('..')) dest = 'pages/Videos'\n      const dir = path.join('/tmp/zr_in', jobId); await mkdir(dir, { recursive: true })\nscripts/local-server.mjs:14:// SECRETS LOCAUX : on charge .env.local (gitignored) pour les variables NON déjà fournies par le shell. Pratique\nscripts/local-server.mjs:18:  const envFile = path.join(ROOT, '.env.local')\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f7718-8139-7212-92ac-5a47b520d9a5"}}}
