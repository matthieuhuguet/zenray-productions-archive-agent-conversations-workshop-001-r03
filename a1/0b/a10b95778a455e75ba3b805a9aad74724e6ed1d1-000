return result(MEDIA_VIEWER.invalid, { ...base, mediaKind: 'video' }, { reason: 'Manifeste mse-av incomplet' })\n    }\n    return result(MEDIA_VIEWER.video, { ...base, mediaKind: 'video' }, { engine: VIDEO_ENGINE.mse })\n  }\n\n  if (mediaKind === 'video') {\n    if (forceDownload) return result(MEDIA_VIEWER.download, base)\n    return result(MEDIA_VIEWER.video, base, { engine: inline ? VIDEO_ENGINE.native : VIDEO_ENGINE.legacyWasm })\n  }\n  if (mediaKind === 'audio' && inline) return result(MEDIA_VIEWER.audio, base)\n  if (mediaKind === 'image' && inline) return result(MEDIA_VIEWER.image, base)\n  if (mediaKind === 'pdf') return result(MEDIA_VIEWER.pdf, base)\n  return result(MEDIA_VIEWER.download, base)\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f75dc-dba6-7cb3-8def-0835dcbe4428"}}}
