         const sourcePath = String(item.sourcePath || '')\n            const requestedTarget = String(item.targetPath || '')\n            const sourceExt = sourcePath.match(EAGLE_LINK_RE)?.[0]\n            if (!safe(sourcePath) || !safe(requestedTarget) || !sourceExt || sourceExt !== requestedTarget.match(EAGLE_LINK_RE)?.[0] || sourcePath === requestedTarget) return res.status(200).json({ error: 'preflight', results: requestedItems.map((_, i) => ({ index: i, ok: false, error: i === index ? 'bad-path' : 'batch-aborted' })) })\n            planned.push({ index, kind: 'leaf', sourcePath, targetPath: reserveEagleLeafTarget(requestedTarget, sourceExt, files, occupiedBases), title: typeof item.title === 'string' ? item.title.slice(0, 240) : null })\n          } else if (item.kind === 'folder') {\n            const sourceDir = cleanDir(item.sourceDir)\n            const requestedTarget = cleanDir(item.targetDir)\n            if (!validDir(sourceDir) || !validDir(requestedTarget) || sourceDir === requestedTarget || requestedTarget.startsWith(sourceDir + '/')) return res.status(200).json({ error: 'preflight', results: requestedItems.map((_, i) => ({ index: i, ok: false, error: i === index ? 'bad-dir' : 'batch-aborted' })) })\n            planned.push({ index, kind: 'folder', sourceDir, targetDir: reserveEagleFolderTarget(requestedTarget, files, occupiedBases, EAGLE_FOLDER_LINK_FILE), title: typeof item.title === 'string' ? item.title.slice(0, 240) : null })\n          } else return res.status(200).json({ error: 'preflight', results: requestedItems.map((_, i) => ({ index: i, ok: false, error: i === index ? 'bad-kind' : 'batch-aborted' })) })\n        }\n\n        // Resolve every source before writing anything. Any orphan/invalid item\n        // aborts the entire batch, so the UI never receives a false partial success.\n        const prepared = await Promise.all(planned.map(async (item) => {\n          const targetParent = (item.kind === 'folder' ? item.targetDir : item.targ