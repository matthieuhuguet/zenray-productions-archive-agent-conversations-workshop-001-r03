sidebar (860) pour supprimer la zone bâtarde 760-860 où la sidebar flottait\n  // déjà mais le Finder gardait ses colonnes inline dans un espace serré.\n  const [narrowFinder, setNarrowFinder] = useState(typeof window !== 'undefined' ? window.innerWidth < 860 : false)\n  const [drawer, setDrawer] = useState(null) // 'fav' | 'inspect' | null\n  const [cmdOpen, setCmdOpen] = useState(false) // panneau \"Repo Commands\" : journal des écritures GitHub (lecture seule)\n  useEffect(() => {\n    const onR = () => { const n = window.innerWidth < 860; setNarrowFinder(n); if (!n) setDrawer(null) }\n    window.addEventListener('resize', onR); return () => window.removeEventListener('resize', onR)\n  }, [])\n\n  const [tags, setTags] = useState({})       // { 'pages/x.md': 'red' } — tags couleur façon Finder\n  const [tagFilter, setTagFilter] = useState(null)\n  const [eagleView, setEagleView] = useState(null) // C211h vue système Eagle: 'untagged'|'recent-added'|'random'\n  const tagSha = useRef(null)\n  const TAGS_PATH = 'pages/.zr-tags.json'\n\n  // C27 — favoris : épingler n'importe quelle page OU dossier (y compris sous-pages) dans la barre latérale. Stocké localStorage.\n  const [favorites, setFavorites] = usePersistedState('zr:favorites', [], { json: true })\n  const isFav = (dir) => favorites.some((f) => f.dir === dir)\n  const toggleFav = (e) => setFavorites((fs) => fs.some((f) => f.dir === e.dir)\n    ? fs.filter((f) => f.dir !== e.dir)\n    : [...fs, { dir: e.dir, name: e.name, contentPath: e.contentPath || null, hasKids: !!e.hasKids }])\n\n  // CHARGEMENT PARESSEUX (lazy) du Finder : on ne liste QUE les enfants du dossier courant (action 'children',\n  // Contents API non récursive) -> jamais tronqué, scalable à 45k+ nœuds. `paths` (arbre global, action 'tree')\n  // reste chargé en SECONDAIRE pour la recherche et les sélecteurs de relation (best-effort, peut être tronqué).\n  const [dirEntries, setDirEntries] = useState(null) // entrées du dossier courant (source navigation)\n  // finder-core-5 : dirEntries=[] est ambigu (dossier réellement vide vs échec réseau sans cache). On distingue\n  // via un drapeau tri-valué : true = chargement a échoué (réseau/quota) ET aucun cache à servir ; false = le\n  // serveur a répondu (même entries:[] = dossier vraiment vide). Le bandeau d'erreur rouge se branche dessus\n  // (pour TOUT dossier), et \"Dossier vide.\" s'affiche sur !dirError.\n  const [dirError, setDirError] = useState(false)\n  // D — 403 GRACIEUX. rateLimitUntil = timestamp (ms) jusqu'auquel le quota GitHub est épuisé (0 = OK).\n3787:function MoveToDialog({ t, items, paths, currentFolder, onClose, onCreateFolder, onConfirm }) {\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f75ff-f634-7a42-9dfa-4cd45a80df61"}}}
