tPath ? { ...x, name: nn, dir: newDir, contentPath: to } : x))\n    const j = await apiPost('move', { from: entry.contentPath, to }).catch(() => null)\n    if (j && j.ok) {\n      // editor-8 — un renommage déplace le fichier : on purge les caches d'affichage module-level sous\n      // l'ANCIEN chemin (label, compteur de commentaires, vignette) sinon une nouvelle page réutilisant\n      // ce chemin pourrait afficher un label périmé.\n      delete _labelCache[entry.contentPath]; delete _commentCountCache[entry.contentPath]; delete _thumbCache[entry.contentPath]\n      remapTags(entry.contentPath, to, false) // finder-core-1 : le tag couleur suit le nouveau chemin\n      if (cur && cur.path === entry.contentPath) setCur({ path: to }); setStatus('renommée ✓'); loadTree()\n    } else {\n      // finder-core-3 : le serveur renvoie { error:'exists' } si la cible existe déjà (le garde-fou local sur\n      // `paths` peut être incomplet/tronqué sur gros repo). On traduit en message clair, comme le garde-fou local.\n      setStatus(j && j.error === 'exists' ? 'nom déjà pris' : 'erreur ' + ((j && j.error) || '')); dropDirCache(folder); loadDir(folder)\n    }\n  }\n  const startRename = (entry) => { setRenaming(entry.dir); setRenameVal(pgPretty(entry.name)) }\n  const onCtx = (event, entry) => {\n    event.preventDefault()\n    event.stopPropagation()\n    // Fige la cible de cette session. Une mise à jour React de `selected` est asynchrone :\n    // toutes les actions du menu utilisent donc ce snapshot explicite et ne peuvent jamais\n    // copier/taguer/supprimer une ancienne sélection par accident.\n    const selectionDirs = entry\n      ? (selected.has(entry.dir) ? [...selected] : [entry.dir])\n      : []\n    setSelected(new Set(selectionDirs))\n    setCtx({ x: event.clientX, y: event.clientY, entry, selectionDirs })\n  }\n  // Télécharge les originaux de TOUTES les images sélectionnées (batch). Séquentiel : déchiffre + reconstruit\n  // chaque image puis déclenche son download, sans saturer le réseau ni le CPU (un AES-GCM à la fois).\n  const selectedImagePaths = (entries = null) => (entries || [...selected].map((d) => (shownRef.current || []).find((x) => x.dir === d)))\n    .map((entry) => entry?.contentPath)\n    .filter((path) => path && /\\.img\\.json$/.test(path))\n  const downloadSelectedImages = async (entries = null) => { for (const path of selectedImagePaths(entries)) { try { await downloadMedia(path) } catch {} } }\n\n  const del = async () => {\n    if (!cur || !window.confirm('Mettre cette page à la corbeille ?')) return\n    const p = cur.path\n    setStatus('→ corbeille…'); await trashPath(p)\n    setCur(null); setStatus('en corbeille ✓'); loadTree()\n    notify({ big: true, icon: 'trash', tint: '#FF9F0A', label: 'Corbeille', title: 'Votre contenu a été déplacé dans Trash', body: 'La page est récupérable. Rien n\\'a été supprimé du drive.', actions: trashActions([p]) })\n  }\n  const baseName = (p) => p.split('/').pop().replace(/\\.media\\.json$/, '').replace(/\\.db\\.json$/, '').replace(/\\.file\\.json$/, '').replace(/\\.md$/, '')\n  // RECHERCHE (index complet chargé UNE fois, scoré EN LOCAL) : l'index global de tous les chemins est\n  // téléchargé une seule fois via /api/page?action=index (cache IndexedDB, cf searchIndexClient.js), puis\n  // chaque frappe est scorée en mémoire par scoreMatch (préfixe>nom>segment>contenu), zéro réseau par\n  // caractère, debounce 140 ms. Le filtre local de `paths` (dossier courant + titres éditables _labelCache\n  // pas encore réindexés) vient COMPLÉTER les hits de l'index en queue, et l'union est capée à 500.\n  // searchHits = chemins issus de l'index complet, DÉJÀ TRIÉS par score, ou null hors recherche.\n  // L'ordre porte le scoring : les meilleurs matchs (nom qui commence par la requête) sortent en premier.\n  const [searchHits, setSearchHits] = useState(null) // string[] ordonné par pertinence, ou null\n  // E (vignette dans l'index v2) : carte chemin -> {u}|{r,p} porté