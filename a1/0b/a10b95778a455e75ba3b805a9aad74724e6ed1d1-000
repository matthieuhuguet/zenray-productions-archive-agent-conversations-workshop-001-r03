|| (e.contentPath && e.contentPath.endsWith('.img.json'))) ? <ImgNodeThumb path={e.contentPath} thumbUrl={e.thumbUrl || copiedThumbRef.current[e.dir]} size={22} radius={5} /> : e.isMedia ? <MediaIcon s={20} path={e.contentPath} /> : (e.contentPath && e.contentPath.endsWith('.file.json')) ? <FileNodeThumb s={22} path={e.contentPath} /> : e.isDb ? <DbIcon s={20} /> : e.type === 'file' ? <DocIcon s={20} /> : <PageThumb path={e.contentPath} size={20} fallback={<DocIcon s={20} />} />}\n          {renaming === e.dir\n            ? <input autoFocus value={renameVal} onFocus={(ev) => ev.target.select()} onMouseDown={(ev) => ev.stopPropagation()} onClick={(ev) => ev.stopPropagation()} onChange={(ev) => setRenameVal(ev.target.value)} onBlur={() => { if (renameCancel.current) { renameCancel.current = false; return } renamePage(e, renameVal) }} onKeyDown={(ev) => { if (ev.key === 'Enter') { ev.preventDefault(); ev.currentTarget.blur() } else if (ev.key === 'Escape') { renameCancel.current = true; setRenaming(null) } }} style={{ flex: 1, fontSize: 13.5, border: `1px solid ${PALETTE.primary}`, borderRadius: 4, padding: '1px 4px', outline: 'none', fontFamily: FONTS.sans }} />\n            : <span style={{ fontSize: 13.5, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis', color: t.textPrimary }}>{e.contentPath && e.contentPath.endsWith('.md') ? <PageLabel path={e.contentPath} name={e.name} /> : pgPretty(e.name)}</span>}\n          {e.contentPath && tags[e.contentPath] && <span style={{ width: 9, height: 9, borderRadius: 99, background: tagHex(tags[e.contentPath]), flex: '0 0 9px' }} />}\n        </span>\n        <span style={{ fontSize: 12, color: t.textSecondary }}>{isFolder ? 'Dossier' : (e.isImage || (e.contentPath && e.contentPath.endsWith('.img.json'))) ? 'Image' : e.isMedia ? 'Média' : e.isDb ? 'Table' : e.type === 'file' ? 'Fichier' : (e.hasKids ? 'Page · dossier' : 'Page')}</span>\n        <span style={{ fontFamily: FONTS.mono, fontSize: 11, color: t.textSecondary, textAlign: 'right' }}>—</span>\n    }\n    window.addEventListener('keydown', h); return () => window.removeEventListener('keydown', h)\n  }, [selected, cur, folder, folderEagleSource])\n\n  // P4 : à chaque render, on republie les dernières closures que <IconTile> appellera via tileH (toujours à jour).\n  tileApi.current = { clickEntry, openEntry, onCtx, selected, setSelected, setDropDir, runCapture, movePage, setDragging, dragDepth, renamePage, setRenaming, setRenameVal, renameCancel, setFinderDragImage, startDragEntry, moveMany, selectedItems, setGroupOverDir, createFolderFromDrop, prefetchDir }\n\n  return (\n    <div style={{ fontFamily: FONTS.sans, color: t.textPrimary, display: split ? 'flex' : 'block' }}>\n      {/* E8 — bouton flottant d'upload mobile : visible sur téléphone en navigation de dossier. Branché sur\n          runCapture -> classify (image -> .img.json, vidéo -> HLS, jamais un chunk binaire). */}\n      {isPhone && !cur && <MobileUploadButton t={t} onUpload={(files) => runCapture(files)} />}\n      {/* WIDGET de saisie de nom — liquid glass tinted minimaliste, remplace window.prompt (création page/sous-page/table).\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f7718-8139-7212-92ac-5a47b520d9a5"}}}
