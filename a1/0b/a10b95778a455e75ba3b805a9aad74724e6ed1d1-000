= ({ c, last }) => {\n      // Une capsule n'est jamais rognée à mi-largeur. Si son libellé ne peut pas\n      // raisonnablement tenir dans la toolbar, on affiche un ellipsis entier ; la flèche\n      // As Columns voisine reste l'unique accès au chemin complet.\n      const labelLimit = pageMobile ? 10 : (last ? 24 : 20)\n      const compactLabel = c.label.length > labelLimit ? '…' : c.label\n      return (\n      <button data-crumb-path={last ? undefined : c.path} onMouseDown={(e) => { e.preventDefault(); e.stopPropagation() }} onClick={(e) => { e.stopPropagation(); onPick(c.path) }} className=\"zr-treeitem\"\n        onDragOver={last ? undefined : (ev) => { if ([...ev.dataTransfer.types].includes('application/zenray-page')) { ev.preventDefault(); ev.stopPropagation(); ev.dataTransfer.dropEffect = 'move'; setCrumbDropPath(c.path) } }}\n        onDragLeave={last ? undefined : () => setCrumbDropPath((p) => p === c.path ? null : p)}\n        onDrop={last ? undefined : (ev) => {\n          setCrumbDropPath(null)\n          const d = ev.dataTransfer.getData('application/zenray-page'); if (!d) return\n          ev.preventDefault(); ev.stopPropagation()\n          try { const p = JSON.parse(d); const list = p.items ? p.items.map((it) => it.path) : (p.path ? [p.path] : []); if (list.length) moveMany(list, c.path) } catch {}\n        }}\n        style={{ position: 'relative', zIndex: 1, pointerEvents: 'auto', background: crumbDropPath === c.path && !last ? PALETTE.primarySoft : (last ? PALETTE.primarySoft : 'transparent'), border: 'none', cursor: 'pointer', color: last ? PALETTE.primary : t.textSecondary, fontFamily: FONTS.sans, fontSize: 13.5, fontWeight: last ? 500 : 400, padding: '3px 9px', borderRadius: 999, whiteSpace: 'nowrap', maxWidth: 'none', minWidth: compactLabel === '…' ? 34 : (last ? 28 : 0), overflow: 'visible', flexShrink: 0, outline: crumbDropPath === c.path && !last ? `2px solid ${PALETTE.primary}` : 'none', transition: 'outline .12s ease, background .12s