erRef = useRef(null)\n  const [internalAnchor, setInternalAnchor] = useState(null)\n  const [chain, setChain] = useState([])\n  const isControlled = typeof controlledOpen === 'boolean' || (controlledAnchor != null && trigger == null)\n  const isOpen = isControlled ? (controlledOpen ?? Boolean(controlledAnchor)) : Boolean(internalAnchor)\n  const anchor = controlledAnchor || internalAnchor || { left: 12, top: 12, triggerTop: 12 }\n\n  const close = useCallback(() => {\n    if (!isControlled) setInternalAnchor(null)\n    setChain([])\n    onOpenChange?.(false)\n    onClose?.()\n  }, [isControlled, onClose, onOpenChange])\n\n  const toggle = useCallback((event) => {\n    if (disabled) return\n    if (isOpen) {\n      close()\n      return\n    }\n    const element = event?.currentTarget || triggerRef.current\n    const rect = element?.getBoundingClientRect?.()\n    const nextAnchor = rect\n      ? {\n          left: align === 'right' ? rect.right - columnWidth : rect.left,\n          top: rect.bottom + 6,\n          triggerTop: rect.top,\n        }\n      : { left: 12, top: 12, triggerTop: 12 }\n    if (!isControlled) setInternalAnchor(nextAnchor)\n    onOpenChange?.(true, nextAnchor)\n  }, [align, close, columnWidth, disabled, isControlled, isOpen, onOpenChange])\n\n  // Un nouveau popover contextuel constitue une nouvelle session de navigation.\n  const anchorKey = `${Number(anchor?.left || 0)}:${Number(anchor?.top || 0)}`\n  useEffect(() => {\n    if (!isOpen) setChain([])\n  }, [isOpen])\n  useEffect(() => {\n    if (isControlled && isOpen) setChain([])\n  }, [anchorKey, isControlled, isOpen])\n\n  // Si l'arbre vivant change, conserve seulement la partie du chemin qui\n  // existe encore. Cela évite une colonne fantôme après une mutation externe.\n  useEffect(() => {\n    setChain((current) => {\n      const next = []\n      let candidates = Array.isArray(nodes) ? nodes : []\n      for (const selected of current) {\n        const match = candidates.find((candidate