\n  className = '',\n}) {\n  const ref = useRef(null)\n  const scrollRef = useRef(null)\n  const reducedMotion = useReducedMotion()\n  const [viewport, setViewport] = useState(viewportSize)\n  const count = Math.max(1, React.Children.count(columns))\n\n  useEffect(() => {\n    if (typeof window === 'undefined') return undefined\n    const update = () => setViewport(viewportSize())\n    window.addEventListener('resize', update, { passive: true })\n    window.visualViewport?.addEventListener?.('resize', update, { passive: true })\n    return () => {\n      window.removeEventListener('resize', update)\n      window.visualViewport?.removeEventListener?.('resize', update)\n    }\n  }, [])\n\n  useEffect(() => {\n    const onPointer = (event) => {\n      if (ref.current?.contains(event.target)) return\n      if (triggerRef?.current?.contains?.(event.target)) return\n      if (triggerSelector && event.target?.closest?.(triggerSelector)) return\n      onClose?.()\n    }\n    const onKey = (event) => { if (event.key === 'Escape') onClose?.() }\n    document.addEventListener('pointerdown', onPointer)\n    document.addEventListener('keydown', onKey)\n    return () => {\n      document.removeEventListener('pointerdown', onPointer)\n      document.removeEventListener('keydown', onKey)\n    }\n  }, [onClose, triggerRef, triggerSelector])\n\n  const layout = useMemo(() => {\n    const vw = viewport.width\n    const vh = viewport.height\n    const rawLeft = Number(anchor?.left ?? 0)\n    const firstColumnWidth = Math.min(columnWidth, Math.max(1, vw - MARGIN * 2))\n    // La position de la première colonne ne dépend JAMAIS du nombre de colonnes.\n    // Quand la cascade grandit, seule la largeur de la coque puis son scroller évoluent.\n    const left = Math.max(MARGIN, Math.min(rawLeft, vw - firstColumnWidth - MARGIN))\n    const desiredWidth = count * columnWidth\n    const width = Math.max(1, Math.min(desiredWidth, vw - left - MARGIN))\n    const requestedTop = Number(anchor?.top ?? ((anchor?.bottom ?? MARGIN) + 8))\n    const belowTop = Math.max(MARGIN, Math.min(requestedTop, vh - MARGIN))\n    const triggerTop = Math.max(MARGIN, Math.min(Number(anchor?.triggerTop ?? anchor?.top ?? MARGIN), vh - MARGIN))\n    const below = Math.max(0, vh - belowTop - MARGIN)\n    const above = Math.max(0, triggerTop - MARGIN * 2)\n    const openAbove = below < minHeight && above > below\n    const height = Math.max(1, Math.min(maxHeight, openAbove ? above : below))\n    return { left, width, height, openAbove, belowTop, bottom: Math.max(MARGIN, vh - triggerTop + 8) }\n  }, [anchor, columnWidth, count, maxHeight, minHeight, viewport])\n\n  // Finder : à l'ajout d'une colonne, révéler la nouvelle destination sans déplacer\n  // la coque. Reduced motion conserve le résultat mais supprime le mouvement.\n  useLayoutEffect(() => {\n    const scroller = scrollRef.current\n    if (!scroller || count < 2) return undefined\n    const frame = window.requestAnimationFrame(() => {\n      const left = Math.max(0, scroller.scrollWidth - scroller.clientWidth)\n      if (typeof scroller.scrollTo === 'function') {\n        scroller.scrollTo({ left, behavior: reducedMotion ? 'auto' : 'smooth' })\n      } else {\n        scroller.scrollLeft = left\n      }\n    })\n    return () => window.cancelAnimationFrame(frame)\n  }, [count, layout.width, reducedMotion])\n\n  if (typeof document === 'undefined') return null\n\n  return createPortal(\n    <div\n      id={id}\n      ref={ref}\n      role=\"menu\"\n      aria-label={ariaLabel}\n      className={`zr-liquid-normal ${className}`.trim()}\n      style={{\n        position: 'fixed',\n        left: layout.left,\n        ...(layout.openAbove ? { bottom: layout.bottom } : { top: layout.belowTop }),\n        zIndex: 500,\n        width: layout.width,\n        maxWidth: `calc(100vw - ${MARGIN * 2}px)`,\n        height: layout.height,\n        maxHeight: layout.height,\n        boxSizing: 'border-box',\n        overflow: 'hidden',\n        borderRadius: 22,\n        ...liquidGlassNormal(t),\n      }}\n    >\n      <div\n        ref={scrollRef}\n        data-zr-column-scroll\n        style={{ display: 'flex', width: '100%', height: '100%', overflowX: 'auto', overflowY: 'hidden', scrollbarWidth: 'none', overscrollBehavior: 'contain' }}\n      >\n        {columns}\n      </div>\n    </div>,\n    document.body,\n  )\n}\n\nexport function ColumnMenuColumn({ t, children, width = 238, label, index = 0 }) {\n  const dark = t?.textPrimary === PALETTE.textPrimaryDark\n  const divider = dark ? 'rgba(0,0,0,.54)' : 'rgba(60,60,67,.18)'\n  return (\n    <div\n      role=\"group\"\n      aria-label={label}\n      style={{\n        width,\n        flex: `0 0 ${width}px`,\n        height: '100%',\n        overflowY: 'auto',\n        padding: '8px 7px',\n        boxSizing: 'border-box',\n        background: 'transparent',\n        borderLeft: index > 0 ? `1px solid ${divider}` : 'none',\n        boxShadow: index > 0 ? 'inset 1px 0 rgba(255,255,255,.12)' : 'none',\n        display: 'flex',\n        flexDirection: 'column',\n        gap: 1,\n      }}\n    >\n      {children}\n    </div>\n  )\n}\n\nexport function ColumnMenuItem({\n  t,\n  children,\n  icon,\n  trailing,\n  selected = false,\n  current = false,\n  danger = false,\n  disabled = false,\n  onClick,\n  title,\n}) {\n  const dark = t?.textPrimary === PALETTE.textPrimaryDark\n  const reducedMotion = useReducedMotion()\n  const normalText = dark ? 'rgba(255,255,255,.90)' : 'rgba(24,24,27,.88)'\n  const muted = dark ? 'rgba(255,255,255,.48)' : 'rgba(60,60,67,.54)'\n  const color = selected ? '#fff' : danger ? PALETTE.red : normalText\n  return (\n    <button\n      type=\"button\"\n      role=\"menuitem\"\n      aria-current={current ? 'page' : undefined}\n      disabled={disabled}\n      title={title}\n      onClick={onClick}\n      style={{\n        display: 'flex',\n        alignItems: 'center',\n        gap: 8,\n        width: '100%',\n        minHeight: 30,\n        padding: '4px 10px',\n        border: 'none',\n        borderRadius: 8,\n        background: selected ? PALETTE.primaryDark : 'transparent',\n        color,\n        cursor: disabled ? 'default' : 'pointer',\n        opacity: disabled ? .45 : 1,\n        textAlign: 'left',\n        fontFamily: FONT,\n        fontSize: 15,\n        fontWeight: 400,\n        transition: reducedMotion ? 'none' : TRANSITIONS.micro,\n      }}\n      onPointerEnter={(event) => { if (!selected && !disabled) event.currentTarget.style.background = dark ? 'rgba(255,255,255,.08)' : 'rgba(0,0,0,.055)' }}\n      onPointerLeave={(event) => { if (!selected) event.currentTarget.style.background = 'transparent' }}\n    >\n      {icon && <span aria-hidden=\"true\" style={{ width: 18, display: 'inline-flex', justifyContent: 'center', flexShrink: 0 }}>{icon}</span>}\n      <span style={{ minWidth: 0, flex: 1, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{children}</span>\n      {trailing && <span aria-hidden=\"true\" style={{ display: 'inline-flex', color: selected ? '#fff' : muted, flexShrink: 0 }}>{trailing}</span>}\n    </button>\n  )\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f66b9-3a9e-7fe1-8c1a-cf99b04a211f"}}}
